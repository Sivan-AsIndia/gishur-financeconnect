@page "/ProductList";
@using FinanceConnect.Client.Services
@using static FinanceConnect.Client.Pages.Product_List
@inject IJSRuntime JS
@inject ProductService ProductService
@inject NavigationManager Nav

<style>
	.dropdown-toggle::after{
		transform: rotate(1deg);
		margin-top: -9px;
	}
</style>
<div class="content">
	<div class="page-header">
		<div class="add-item d-flex">
			<div class="page-title">
				<h4 class="fw-bold">Product List</h4>
				<h6>Manage your products</h6>
			</div>
		</div>
		<ul class="table-top-head">
			<li>
				<a href="javascript:void(0);"
				   data-bs-toggle="tooltip"
				   data-bs-placement="top"
				   title="Refresh"
				   @onclick="OnRefresh">
					<i class="ti ti-refresh"></i>
				</a>
			</li>
		</ul>
		<div class="page-btn">
			<a href="/AddProduct" class="btn btn-primary"><i class="ti ti-circle-plus me-1"></i>Add Product</a>
		</div>
		@* <div class="page-btn import">
			<a href="#" class="btn btn-secondary color" data-bs-toggle="modal" data-bs-target="#view-notes"><i data-feather="download" class="me-1"></i>Import Product</a>
		</div> *@
	</div>

	<!-- /product list -->
	<div class="card">
		<div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
			<div class="search-set">
				<div class="search-input">
					<span class="btn-searchset">
						<i class="ti ti-search fs-14 feather-search"></i>
					</span>

					<input type="search"
						   class="form-control form-control-sm"
						   placeholder="Search" @bind="searchText"
						   @oninput="OnSearch" />
				</div>

			</div>
			<div class="d-flex table-dropdown my-xl-auto right-content align-items-center flex-wrap row-gap-3">
				<div class="dropdown me-2">
					<a href="javascript:void(0);" class="dropdown-toggle btn btn-white btn-md d-inline-flex align-items-center" data-bs-toggle="dropdown">
						@SelectedCategory
					</a>
					<ul class="dropdown-menu dropdown-menu-end p-3">
						@foreach (var category in Categories)
						{
							<li>
								<a href="javascript:void(0);"
								   class="dropdown-item rounded-1"
								   @onclick="() => OnCategorySelect(category)">
									@category
								</a>
							</li>
						}
					</ul>
				</div>
				<div class="dropdown">
					<a href="javascript:void(0);" class="dropdown-toggle btn btn-white btn-md d-inline-flex align-items-center" data-bs-toggle="dropdown">
						@SelectedBrand
					</a>
					<ul class="dropdown-menu dropdown-menu-end p-3">
						@foreach (var brand in Brands)
						{
							<li>
								<a href="javascript:void(0);"
								   class="dropdown-item rounded-1"
								   @onclick="() => OnBrandSelect(brand)">
									@brand
								</a>
							</li>
						}
					</ul>
				</div>
			</div>
		</div>
		<div class="card-body p-0">
			<div class="table-responsive">
				<table class="table datatable">
					<thead class="thead-light">
						<tr>
							<th class="no-sort">
								<label class="checkboxs">
									<input type="checkbox" @onchange="SelectAll">
									<span class="checkmarks"></span>
								</label>
							</th>
							<th>SKU</th>
							<th>Product Name</th>
							<th>Category</th>
							<th>Brand</th>
							<th>Price</th>
							<th>Unit</th>
							<th>Qty</th>
							<th>Created By</th>
							<th class="no-sort">Action</th>
						</tr>
					</thead>

					<tbody>
						@if (PagedProducts.Any())
						{
							@foreach (var item in PagedProducts)
							{
								<tr>
									<td>
										<label class="checkboxs">
											<input type="checkbox" @bind="item.IsSelected">
											<span class="checkmarks"></span>
										</label>
									</td>

									<td>@item.SKU</td>

									<td>
										<div class="d-flex align-items-center">
											<a href="javascript:void(0);" class="avatar avatar-md me-2">
												<img src="@item.ProductImage" alt="product">
											</a>
											<a href="javascript:void(0);">@item.ProductName</a>
										</div>
									</td>

									<td>@item.Category</td>
									<td>@item.Brand</td>
									<td>@item.Price</td>
									<td>@item.Unit</td>
									<td>@item.Qty</td>

									<td>
										<div class="d-flex align-items-center">
											<a href="javascript:void(0);" class="avatar avatar-sm me-2">
												<img src="@item.UserImage" alt="user">
											</a>
											<a href="javascript:void(0);">@item.CreatedBy</a>
										</div>
									</td>

									<td class="action-table-data">
										<div class="edit-delete-action">
											<a class="me-2 edit-icon p-2" @onclick='() => Nav.NavigateTo($"/ProductDetails/{item.SKU}")'>
												<i data-feather="eye"></i>
											</a>
											<a class="me-2 p-2"   @onclick='() => Nav.NavigateTo($"/EditDetails/{item.SKU}")'>
												<i data-feather="edit"></i>
											</a>
											<a class="p-2" data-bs-toggle="modal" data-bs-target="#delete-modal" @onclick="() => ConfirmDelete(item)">
												<i data-feather="trash-2"></i>
											</a>
										</div>
									</td>
								</tr>
							}
						}
						else
						{
							<tr>
								<td colspan="10" class="text-center text-muted py-4">
									No data found
								</td>
							</tr>
						}
					</tbody>

				</table>
		
				<div class="d-flex justify-content-between align-items-center p-3">

    <!-- Rows per page -->
    <div class="d-flex align-items-center">
        <span class="me-2">Row Per Page</span>

        <select class="form-select form-select-sm w-auto"
                @onchange="OnPageSizeChange">
            <option value="5">5</option>
            <option value="10" selected>10</option>
            <option value="25">25</option>
            <option value="50">50</option>
        </select>

        <span class="ms-2">Entries</span>
    </div>

    <!-- Pagination -->
    <nav>
        <ul class="pagination pagination-sm mb-0">

            <!-- Previous -->
            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="javascript:void(0);"
								   @onclick="PreviousPage" style="border-radius: 50%;">
                    <i class="ti ti-chevron-left"></i>
                </a>
            </li>

            @for (int i = 1; i <= TotalPages; i++)
            {
                <li class="page-item @(i == CurrentPage ? "active" : "")">
                    <a class="page-link" href="javascript:void(0);"
									   @onclick="() => GoToPage(i)" style="border-radius: 50%;">
                        @i
                    </a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                <a class="page-link" href="javascript:void(0);"
                   @onclick="NextPage">
                    <i class="ti ti-chevron-right"></i>
                </a>
            </li>

        </ul>
    </nav>
</div>


			</div>
		</div>
	</div>
	<!-- /product list -->
</div>
<div class="footer d-sm-flex align-items-center justify-content-between border-top bg-white p-3">
	<p class="mb-0 text-gray-9">2014 - 2025 © DreamsPOS. All Right Reserved</p>
	<p>Designed & Developed by <a href="javascript:void(0);" class="text-primary">Dreams</a></p>
</div>




