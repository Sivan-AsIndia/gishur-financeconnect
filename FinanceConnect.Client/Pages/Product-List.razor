<!-- delete modal -->
<div class="modal fade" id="delete-modal">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="page-wrapper-new p-0">
				<div class="p-5 px-3 text-center">
					<span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
					<h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Product</h4>
					<p class="text-gray-6 mb-0 fs-16">Do you want to delete product?</p>
					<div class="modal-footer-btn mt-3 d-flex justify-content-center">
						<button type="button" class="btn me-2 btn-secondary fs-13 fw-medium p-2 px-3 shadow-none" data-bs-dismiss="modal">Cancel</button>
						<button type="submit" class="btn btn-primary fs-13 fw-medium p-2 px-3" @onclick="DeleteProduct">Yes Delete</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@code {
	List<Product> Products = new();
	List<Product> FilteredProducts = new();
	string SelectedCategory = "Category";
	string SelectedBrand = "Brand";
	string searchText = "";
	int PageSize =10;
	int CurrentPage = 1;
	int TotalPages =>
		FilteredProducts == null || FilteredProducts.Count == 0
			? 1
			: (int)Math.Ceiling((double)FilteredProducts.Count / PageSize);

	List<Product> PagedProducts
	{
		get
		{
			if (FilteredProducts == null || !FilteredProducts.Any())
				return new List<Product>();

			var page = CurrentPage;

			if (page < 1)
				page = 1;

			if (page > TotalPages)
				page = TotalPages;

			return FilteredProducts
				.Skip((page - 1) * PageSize)
				.Take(PageSize)
				.ToList();
		}
	}
	private Product? SelectedProduct;

	private void ConfirmDelete(Product product)
	{
		SelectedProduct = product;
	}
	async Task DeleteProduct()
	{
		if (SelectedProduct == null)
			return;
		FilteredProducts.Remove(SelectedProduct);
		Products.Remove(SelectedProduct);
		ProductService.Products.Remove(SelectedProduct);
		SelectedProduct = null;
		await JS.InvokeVoidAsync("closeDeleteModal");
	}



// Pagination
	void GoToPage(int page)
	{
		if (page < 1 || page > TotalPages)
			return;

		CurrentPage = page;
	}


	void PreviousPage()
	{
		if (CurrentPage > 1)
			CurrentPage--;
	}

	void NextPage()
	{
		if (CurrentPage < TotalPages)
			CurrentPage++;
	}

	void OnPageSizeChange(ChangeEventArgs e)
	{
		PageSize = int.Parse(e.Value.ToString());
		CurrentPage = 1; // reset page
	}

	List<string> Categories = new()
	{
		"Computers","Electronics","Shoe","Cosmetics","Groceries",
		"Furniture","Bags","Phone"
	};

	List<string> Brands = new()
	{
		"Lenovo","Beats","Nike","Apple","Amazon","Woodmart"
	};
	protected override void OnInitialized()
	{
		Products = new List<Product>
		{
			new Product
			{
				SKU = "PT001",ProductName = "Lenovo IdeaPad 3",Category = "Computers",
				Brand = "Lenovo",Price = 600,Unit = "Pc",Qty = 100,CreatedBy = "James Kirwin",
				ProductImage = "assets/images/stock-img-01.png",UserImage = "assets/images/user-30.jpg"
			},
			new Product
			{
				SKU = "PT002",ProductName = "Dell Inspiron",Category = "Shoes",Brand = "Dell",
				Price = 750,Unit = "Pc",Qty = 50,CreatedBy = "Robert",ProductImage = "assets/images/stock-img-02.png",
				UserImage = "assets/images/user-30.jpg"
			},
			new Product
			{
				SKU = "PT003",ProductName = "Dell Inspiron",Category = "Shoes",Brand = "Dell",
				Price = 750,Unit = "Pc",Qty = 50,CreatedBy = "Robert",ProductImage = "assets/images/stock-img-02.png",
				UserImage = "assets/images/user-30.jpg"
			},
			new Product
			{
				SKU = "PT004",ProductName = "Dell Inspiron",Category = "Shoes",Brand = "Dell",
				Price = 750,Unit = "Pc",Qty = 50,CreatedBy = "Robert",ProductImage = "assets/images/stock-img-02.png",
				UserImage = "assets/images/user-30.jpg"
			},
			new Product
			{
				SKU = "PT005",ProductName = "Dell Inspiron",Category = "Shoes",Brand = "Dell",
				Price = 750,Unit = "Pc",Qty = 50,CreatedBy = "Robert",ProductImage = "assets/images/stock-img-02.png",
				UserImage = "assets/images/user-30.jpg"
			},
			new Product
			{
				SKU = "PT006",ProductName = "Dell Inspiron",Category = "Shoes",Brand = "Dell",
				Price = 750,Unit = "Pc",Qty = 50,CreatedBy = "Robert",ProductImage = "assets/images/stock-img-02.png",
				UserImage = "assets/images/user-30.jpg"
			}
		};
		// 2️⃣ Service empty-aa irundha mattum push pannunga
		if (!ProductService.Products.Any())
		{
			ProductService.Products.AddRange(Products);
		}

		// 3️⃣ UI-ku bind panna
		FilteredProducts = ProductService.Products.ToList();
	}

	void SelectAll(ChangeEventArgs e)
	{
		bool isChecked = (bool)e.Value;
		foreach (var item in Products)
		{
			item.IsSelected = isChecked;
		}
	}



	void OnSearch(ChangeEventArgs e)
	{
		 searchText = e.Value?.ToString();

		if (string.IsNullOrWhiteSpace(searchText))
		{
			FilteredProducts = Products;
		}
		else
		{
			FilteredProducts = Products.Where(p =>
				p.SKU.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
				p.ProductName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
				p.Category.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
				p.Brand.Contains(searchText, StringComparison.OrdinalIgnoreCase)
			).ToList();

		}
		CurrentPage = 1;
	}

	void OnCategorySelect(string category)
	{
		SelectedCategory = category;
		ApplyFilters();
	}

	void OnBrandSelect(string brand)
	{
		SelectedBrand = brand;
		ApplyFilters();
	}
	void ApplyFilters()
	{
		FilteredProducts = Products.Where(p =>
			(SelectedCategory == "Category" || p.Category == SelectedCategory) &&
			(SelectedBrand == "Brand" || p.Brand == SelectedBrand)
		).ToList();
		CurrentPage = 1;
	}
	void OnRefresh()
	{
		// 🔹 Search clear
		searchText = string.Empty;

		// 🔹 Dropdown reset
		SelectedCategory = "Category";
		SelectedBrand = "Brand";

		// 🔹 Checkbox reset (optional)
		foreach (var item in Products)
		{
			item.IsSelected = false;
		}

		// 🔹 Table data reset
		FilteredProducts = Products;

		StateHasChanged();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		await Task.Delay(10);
		await JS.InvokeVoidAsync("initFeatherIcons");
	}

	public class Product
	{
		public bool IsSelected { get; set; }
		public string SKU { get; set; }
		public string ProductName { get; set; }
		public string Category { get; set; }
		public string Brand { get; set; }
		public decimal Price { get; set; }
		public string Unit { get; set; }
		public int Qty { get; set; }
		public string CreatedBy { get; set; }
		public string ProductImage { get; set; }
		public string UserImage { get; set; }
	}

}