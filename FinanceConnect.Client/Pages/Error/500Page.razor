@page "/500page"

<style>

    .watermark {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 340px;
        font-weight: 900;
        color: color-mix(in srgb, var(--primary) 10%, white);
        letter-spacing: -20px;
        user-select: none;
        pointer-events: none;
        white-space: nowrap;
    }

    .scene-wrap {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        animation: fadeUp .8s cubic-bezier(.22,1,.36,1) both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .scene-svg {
        width: 560px;
        max-width: 96vw;
        animation: gentleFloat 5s ease-in-out infinite;
    }

    @@keyframes gentleFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    .text-block {
        text-align: center;
        margin-top: -10px;
    }

    .oops-title {
        font-size: 26px;
        font-weight: 800;
        color: #2c2011;
        margin-bottom: 10px;
    }

    .oops-sub {
        font-size: 14px;
        color: #9d8e82;
        line-height: 1.7;
        margin-bottom: 28px;
        max-width: 400px;
    }

    .btn-dash {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--primary);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        padding: 13px 32px;
        border-radius: 40px;
        border: none;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 8px 28px rgba(249,115,22,0.38);
        transition: all .25s;
    }

        .btn-dash:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 36px rgba(249,115,22,0.48);
        }

    .footer-note {
        margin-top: 40px;
        font-size: 12px;
        color: #c4b8ae;
    }

    /* Spinning gear animation */
    @@keyframes spinGear {
        from {
            transform-origin: 313px 172px;
            transform: rotate(0deg);
        }

        to {
            transform-origin: 313px 172px;
            transform: rotate(360deg);
        }
    }

    @@keyframes spinGearReverse {
        from {
            transform-origin: 278px 207px;
            transform: rotate(0deg);
        }

        to {
            transform-origin: 278px 207px;
            transform: rotate(-360deg);
        }
    }

    .gear-big {
        animation: spinGear 6s linear infinite;
    }

    .gear-small {
        animation: spinGearReverse 3s linear infinite;
    }

    /* Steam puffs */
    @@keyframes steamRise {
        0% {
            opacity: 0;
            transform: translateY(0) scaleX(1);
        }

        30% {
            opacity: 0.7;
        }

        100% {
            opacity: 0;
            transform: translateY(-38px) scaleX(1.4);
        }
    }

    .steam1 {
        animation: steamRise 2.2s ease-out infinite;
    }

    .steam2 {
        animation: steamRise 2.2s ease-out .7s infinite;
    }

    .steam3 {
        animation: steamRise 2.2s ease-out 1.4s infinite;
    }

    /* Warning flash */
    @@keyframes warningFlash {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.3;
        }
    }

    .warning-icon {
        animation: warningFlash 1.2s ease-in-out infinite;
    }

</style>

<div class="content">
<div class="watermark">500</div>

<div class="scene-wrap mb-4">

    <svg class="scene-svg" viewBox="0 0 560 440" fill="none" xmlns="http://www.w3.org/2000/svg">

        <!-- ── Ground shadow ellipses ── -->
        <ellipse cx="280" cy="422" rx="220" ry="14" fill="rgba(200,180,160,0.25)" />
        <ellipse cx="175" cy="418" rx="60" ry="8" fill="rgba(200,180,160,0.2)" />

        <!-- ══════════════════════════════════════
             SERVER / MONITOR with smoking gears
        ══════════════════════════════════════ -->
        <!-- Monitor tilt group -->
        <g transform="rotate(-8, 310, 200)">
            <!-- Monitor stand -->
            <rect x="295" y="278" width="36" height="22" rx="4" fill="#8b9ab0" />
            <rect x="275" y="298" width="76" height="10" rx="5" fill="#6b7a8d" />

            <!-- Monitor shadow -->
            <rect x="192" y="92" width="242" height="185" rx="10" fill="rgba(0,0,0,0.08)" transform="translate(7,7)" />
            <!-- Monitor body -->
            <rect x="192" y="92" width="242" height="185" rx="10" fill="#ffffff" stroke="var(--primary)" stroke-width="7" />
            <!-- Screen bezel inner -->
            <rect x="206" y="106" width="214" height="157" rx="6" fill="#fff8f2" stroke="var(--primary)" stroke-width="2.5" stroke-dasharray="6 4" />

            <!-- Screen red tint overlay -->
            <rect x="208" y="108" width="210" height="153" rx="5" fill="color-mix(in srgb, var(--primary) 10%, white)" />

            <!-- SERVER ERROR label -->
            <text x="313" y="148" font-family="Sora, sans-serif" font-size="13" font-weight="900" fill="var(--primary)" text-anchor="middle" letter-spacing="5">SERVER ERROR</text>

            <!-- 500 text -->
            <text x="313" y="218" font-family="Sora, sans-serif" font-size="72" font-weight="900" fill="var(--primary)" text-anchor="middle" letter-spacing="-3">500</text>

            <!-- Spinning big gear (centered on monitor) -->
            <g class="gear-big">
                <!-- gear body -->
                <circle cx="313" cy="172" r="0" fill="none" />
                <!-- draw gear using path: 8-tooth gear centered 313,172 r=22 -->
                <path d="
                  M313,150 L317,143 L322,150
                  L330,148 L332,155 L326,158
                  L335,163 L334,170 L326,170
                  L328,178 L322,181 L317,174
                  L313,181 L309,174 L304,181
                  L298,178 L300,170 L292,170
                  L291,163 L300,158
                  L294,155 L296,148 L304,150 Z
                " fill="var(--primary)" opacity="0.18" />
                <circle cx="313" cy="165" r="7" fill="var(--primary)" opacity="0.25" />
            </g>

            <!-- Spinning small gear -->
            <g class="gear-small">
                <path d="
                  M278,196 L281,190 L285,196
                  L291,194 L293,199 L288,202
                  L295,206 L294,212 L288,211
                  L289,217 L284,219 L280,213
                  L276,219 L271,217 L272,211
                  L266,212 L265,206 L272,202
                  L267,199 L269,194 L275,196 Z
                " fill="var(--primary)" opacity="0.22" />
                <circle cx="280" cy="204" r="5" fill="var(--primary)" opacity="0.28" />
            </g>

            <!-- Power LED red blinking dot -->
            <circle cx="397" cy="268" r="5" fill="#ff3b30" class="warning-icon" />

            <!-- small decorative lines (terminal style) -->
            <rect x="218" y="240" width="60" height="4" rx="2" fill="var(--primary)" opacity="0.12" />
            <rect x="218" y="250" width="40" height="4" rx="2" fill="var(--primary)" opacity="0.08" />
            <rect x="218" y="260" width="50" height="4" rx="2" fill="var(--primary)" opacity="0.10" />
        </g>

        <!-- ══════════════════════════════════════
             STEAM / SMOKE PUFFS above monitor
        ══════════════════════════════════════ -->
        <g class="steam1">
            <ellipse cx="288" cy="88" rx="9" ry="6" fill="rgba(180,160,140,0.45)" />
        </g>
        <g class="steam2">
            <ellipse cx="308" cy="80" rx="7" ry="5" fill="rgba(180,160,140,0.35)" />
        </g>
        <g class="steam3">
            <ellipse cx="328" cy="85" rx="10" ry="6" fill="rgba(180,160,140,0.40)" />
        </g>

        <!-- ══════════════════════════════════════
             LADDER + TECHNICIAN (right side)
        ══════════════════════════════════════ -->
        <!-- left rail -->
        <rect x="390" y="155" width="12" height="255" rx="6" fill="#8b9ab0" />
        <!-- right rail -->
        <rect x="435" y="170" width="12" height="250" rx="6" fill="#8b9ab0" />
        <!-- rungs -->
        <rect x="390" y="200" width="57" height="9" rx="4" fill="#6b7a8d" />
        <rect x="390" y="235" width="57" height="9" rx="4" fill="#6b7a8d" />
        <rect x="390" y="270" width="57" height="9" rx="4" fill="#6b7a8d" />
        <rect x="390" y="305" width="57" height="9" rx="4" fill="#6b7a8d" />
        <rect x="390" y="340" width="57" height="9" rx="4" fill="#6b7a8d" />
        <rect x="390" y="375" width="57" height="9" rx="4" fill="#6b7a8d" />
        <!-- legs -->
        <rect x="403" y="330" width="14" height="50" rx="7" fill="#3d4f6e" />
        <rect x="423" y="330" width="14" height="50" rx="7" fill="#3d4f6e" />
        <!-- shoes -->
        <ellipse cx="410" cy="382" rx="10" ry="6" fill="#2c3a52" />
        <ellipse cx="430" cy="382" rx="10" ry="6" fill="#2c3a52" />
        <!-- torso / shirt (orange) -->
        <rect x="397" y="270" width="46" height="65" rx="12" fill="var(--primary)" />
        <!-- tool belt -->
        <rect x="397" y="328" width="46" height="7" rx="3" fill="#c75e0a" />
        <!-- wrench in hand (left arm reaching toward monitor) -->
        <path d="M397 285 Q365 272 340 265" stroke="#f5c4a0" stroke-width="13" stroke-linecap="round" fill="none" />
        <!-- wrench icon at hand tip -->
        <g transform="translate(324,254) rotate(-35)">
            <rect x="0" y="-4" width="22" height="8" rx="4" fill="#6b7a8d" />
            <rect x="-3" y="-7" width="8" height="14" rx="3" fill="#8b9ab0" />
        </g>
        <!-- right arm (holding ladder) -->
        <path d="M443 290 Q455 285 447 270" stroke="#f5c4a0" stroke-width="13" stroke-linecap="round" fill="none" />
        <!-- neck -->
        <rect x="410" y="255" width="18" height="18" rx="9" fill="#f5c4a0" />
        <!-- head -->
        <circle cx="419" cy="242" r="26" fill="#f5c4a0" />
        <!-- hard hat -->
        <path d="M394 237 Q396 210 419 208 Q442 210 444 237 Q435 224 419 226 Q403 224 394 237Z" fill="#f5a623" />
        <rect x="389" y="235" width="60" height="8" rx="4" fill="#e09020" />
        <!-- ear -->
        <ellipse cx="393" cy="243" rx="5" ry="7" fill="#e8b08a" />
        <!-- eye left -->
        <ellipse cx="410" cy="242" rx="3" ry="3.5" fill="#2c2011" />
        <!-- eye right -->
        <ellipse cx="428" cy="242" rx="3" ry="3.5" fill="#2c2011" />
        <!-- focused eyebrows -->
        <path d="M406 234 Q410 230 415 234" stroke="#2c2011" stroke-width="2.5" stroke-linecap="round" fill="none" />
        <path d="M424 234 Q428 230 432 234" stroke="#2c2011" stroke-width="2.5" stroke-linecap="round" fill="none" />
        <!-- determined mouth -->
        <path d="M411 253 Q419 256 427 253" stroke="#b07040" stroke-width="2" stroke-linecap="round" fill="none" />

        <!-- ══════════════════════════════════════
             SITTING PERSON (left side, panicked)
        ══════════════════════════════════════ -->
        <ellipse cx="155" cy="416" rx="52" ry="9" fill="rgba(180,150,120,0.25)" />
        <!-- legs stretched -->
        <path d="M140 390 Q130 408 112 412" stroke="#f5c4a0" stroke-width="14" stroke-linecap="round" fill="none" />
        <path d="M160 388 Q174 408 192 413" stroke="#f5c4a0" stroke-width="14" stroke-linecap="round" fill="none" />
        <!-- shoes -->
        <ellipse cx="109" cy="413" rx="13" ry="7" fill="#2c3a52" />
        <ellipse cx="195" cy="414" rx="13" ry="7" fill="#2c3a52" />
        <!-- body -->
        <ellipse cx="150" cy="368" rx="28" ry="34" fill="#fde8c8" />
        <!-- shirt -->
        <path d="M122 373 Q127 348 150 346 Q173 348 178 373 Q165 358 150 360 Q135 358 122 373Z" fill="var(--primary)" />
        <!-- left arm raised (hands on head) -->
        <path d="M124 360 Q110 340 122 318" stroke="#f5c4a0" stroke-width="12" stroke-linecap="round" fill="none" />
        <!-- right arm raised (hands on head) -->
        <path d="M176 360 Q190 340 178 318" stroke="#f5c4a0" stroke-width="12" stroke-linecap="round" fill="none" />
        <!-- hands on head -->
        <ellipse cx="122" cy="315" rx="9" ry="7" fill="#f5c4a0" />
        <ellipse cx="178" cy="315" rx="9" ry="7" fill="#f5c4a0" />
        <!-- head tilted back -->
        <circle cx="150" cy="302" r="28" fill="#f5c4a0" />
        <!-- hair -->
        <path d="M124 294 Q127 270 150 268 Q173 270 176 294 Q167 280 150 282 Q133 280 124 294Z" fill="#2c2011" />
        <!-- beard -->
        <path d="M134 320 Q150 332 166 320 Q161 330 150 332 Q139 330 134 320Z" fill="#8a6040" />
        <!-- eyes wide (panic) -->
        <ellipse cx="141" cy="300" rx="4" ry="5" fill="#2c2011" />
        <ellipse cx="159" cy="300" rx="4" ry="5" fill="#2c2011" />
        <!-- white of panic eyes -->
        <ellipse cx="141" cy="298" rx="2" ry="2" fill="#ffffff" opacity="0.5" />
        <ellipse cx="159" cy="298" rx="2" ry="2" fill="#ffffff" opacity="0.5" />
        <!-- sweat drops -->
        <ellipse cx="130" cy="292" rx="3" ry="5" fill="#b0d0f0" opacity="0.7" transform="rotate(-20,130,292)" />
        <ellipse cx="170" cy="290" rx="2.5" ry="4" fill="#b0d0f0" opacity="0.6" transform="rotate(15,170,290)" />
        <!-- mouth open wide (panic) -->
        <ellipse cx="150" cy="315" rx="8" ry="6" fill="#c07050" />
        <!-- teeth -->
        <rect x="144" y="311" width="12" height="5" rx="2" fill="color-mix(in srgb, var(--primary) 10%, white)" />

        <!-- ── Speech bubble "Help!!" ── -->
        <g>
            <rect x="178" y="268" width="82" height="34" rx="14" fill="#fff8f0" stroke="var(--primary)" stroke-width="2" />
            <polygon points="185,302 176,316 198,302" fill="color-mix(in srgb, var(--primary) 10%, white)" stroke="var(--primary)" stroke-width="2" stroke-linejoin="round" />
            <rect x="180" y="302" width="16" height="4" fill="#fff8f0" />
            <text x="219" y="291" font-family="Nunito, sans-serif" font-size="14" font-weight="700" fill="var(--primary)" text-anchor="middle">Help!!</text>
        </g>

        <!-- ══════════════════════════════════════
             WARNING TRIANGLE (floating top-right)
        ══════════════════════════════════════ -->
        <g class="warning-icon" transform="translate(470, 60)">
            <polygon points="30,0 60,52 0,52" fill="#fff8f0" stroke="var(--primary)" stroke-width="4" stroke-linejoin="round" />
            <text x="30" y="44" font-family="Sora, sans-serif" font-size="28" font-weight="900" fill="var(--primary)" text-anchor="middle">!</text>
        </g>

        <!-- ══════════════════════════════════════
             PLANT (bottom-left, wilting)
        ══════════════════════════════════════ -->
        <!-- pot -->
        <path d="M52 390 Q50 415 77 418 Q104 415 102 390Z" fill="#c8813a" />
        <rect x="47" y="384" width="60" height="12" rx="6" fill="#e09050" />
        <!-- soil -->
        <ellipse cx="77" cy="390" rx="28" ry="7" fill="#7a5230" />
        <!-- wilting stems (drooping more than 404 page) -->
        <path d="M77 388 Q65 360 45 325" stroke="#4a7a3a" stroke-width="5" stroke-linecap="round" fill="none" />
        <path d="M77 388 Q82 355 78 315" stroke="#4a7a3a" stroke-width="5" stroke-linecap="round" fill="none" />
        <path d="M77 388 Q95 368 115 348" stroke="#4a7a3a" stroke-width="4" stroke-linecap="round" fill="none" />
        <!-- leaves (wilted / drooping) -->
        <ellipse cx="43" cy="318" rx="14" ry="22" fill="#3a8a2a" transform="rotate(-50,43,318)" />
        <ellipse cx="78" cy="306" rx="13" ry="20" fill="#4aaa38" transform="rotate(5,78,306)" />
        <ellipse cx="118" cy="345" rx="12" ry="18" fill="#2d7a22" transform="rotate(35,118,345)" />
        <!-- leaf veins -->
        <path d="M43 332 Q41 318 35 304" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" fill="none" />
        <path d="M78 322 Q78 310 78 298" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" fill="none" />

    </svg>

    <!-- TEXT BLOCK -->
    <div class="text-block">
        <div class="oops-title">Oops, something broke on our end</div>
        <p class="oops-sub">Error 500 — Internal Server Error. Our team has been notified and is working hard to fix it. Please try again in a moment.</p>
        <a href="/Dashboard" class="btn btn-primary"><i class="bi bi-house-door-fill"></i> Back to Dashboard</a>
    </div>
</div>
</div>