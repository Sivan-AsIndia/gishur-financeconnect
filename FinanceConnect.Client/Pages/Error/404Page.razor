@page "/404page"


<style>

    .watermark {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 340px;
        font-weight: 900;
        color: color-mix(in srgb, var(--primary) 10%, white);
        letter-spacing: -20px;
        user-select: none;
        pointer-events: none;
        white-space: nowrap;
    }

    .scene-wrap {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        animation: fadeUp .8s cubic-bezier(.22,1,.36,1) both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .scene-svg {
        width: 560px;
        max-width: 96vw;
        animation: gentleFloat 5s ease-in-out infinite;
    }

    @@keyframes gentleFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    .text-block {
        text-align: center;
        margin-top: -10px;
    }

    .oops-title {
        font-size: 26px;
        font-weight: 800;
        color: #2c2011;
        margin-bottom: 10px;
    }

    .oops-sub {
        font-size: 14px;
        color: #9d8e82;
        line-height: 1.7;
        margin-bottom: 28px;
        max-width: 400px;
    }

    .btn-dash {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--primary);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        padding: 13px 32px;
        border-radius: 40px;
        border: none;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 8px 28px rgba(249,115,22,0.38);
        transition: all .25s;
    }

        .btn-dash:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 36px rgba(249,115,22,0.48);
        }

    .footer-note {
        margin-top: 40px;
        font-size: 12px;
        color: #c4b8ae;
    }
</style>


<div class="content">
<div class="watermark">404</div>

<div class="scene-wrap mb-4">

    <svg class="scene-svg" viewBox="0 0 560 440" fill="none" xmlns="http://www.w3.org/2000/svg">

        <!-- ── Ground shadow ellipses ── -->
        <ellipse cx="280" cy="420" rx="220" ry="14" fill="rgba(200,180,160,0.25)" />
        <ellipse cx="175" cy="418" rx="60" ry="8" fill="rgba(200,180,160,0.2)" />
        <g transform="rotate(-10, 310, 230)">
            <!-- shadow behind board -->
            <rect x="198" y="88" width="230" height="170" rx="6" fill="rgba(0,0,0,0.07)" transform="translate(6,6)" />
            <!-- white board background -->
            <rect x="198" y="88" width="230" height="170" rx="6" fill="#ffffff" stroke="var(--primary)" stroke-width="7" />
            <!-- orange dashed border inner -->
            <rect x="210" y="100" width="206" height="146" rx="4" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-dasharray="6 4" />
            <!-- ERROR text -->
            <text x="313" y="155" font-family="Sora, sans-serif" font-size="36" font-weight="900" fill="var(--primary)" text-anchor="middle" letter-spacing="4">ERROR</text>
            <!-- 404 text -->
            <text x="313" y="225" font-family="Sora, sans-serif" font-size="68" font-weight="900" fill="var(--primary)" text-anchor="middle" letter-spacing="-2">404</text>
        </g>
        <!-- left rail -->
        <rect x="355" y="155" width="12" height="255" rx="6" fill="#8b9ab0" />
        <!-- right rail -->
        <rect x="400" y="170" width="12" height="250" rx="6" fill="#8b9ab0" />
        <!-- rungs -->
        <rect x="355" y="200" width="57" height="9" rx="4" fill="#6b7a8d" />
        <rect x="355" y="235" width="57" height="9" rx="4" fill="#6b7a8d" />
        <rect x="355" y="270" width="57" height="9" rx="4" fill="#6b7a8d" />
        <rect x="355" y="305" width="57" height="9" rx="4" fill="#6b7a8d" />
        <rect x="355" y="340" width="57" height="9" rx="4" fill="#6b7a8d" />
        <rect x="355" y="375" width="57" height="9" rx="4" fill="#6b7a8d" />
        <!-- legs -->
        <rect x="368" y="330" width="14" height="50" rx="7" fill="#3d4f6e" />
        <rect x="388" y="330" width="14" height="50" rx="7" fill="#3d4f6e" />
        <!-- shoes -->
        <ellipse cx="375" cy="382" rx="10" ry="6" fill="#2c3a52" />
        <ellipse cx="395" cy="382" rx="10" ry="6" fill="#2c3a52" />
        <!-- torso / shirt -->
        <rect x="362" y="270" width="46" height="65" rx="12" fill="var(--primary)" />
        <!-- belt -->
        <rect x="362" y="328" width="46" height="7" rx="3" fill="#c75e0a" />
        <!-- left arm (reaching toward sign) -->
        <path d="M362 285 Q330 275 308 268" stroke="#f5c4a0" stroke-width="13" stroke-linecap="round" fill="none" />
        <!-- right arm (holding ladder) -->
        <path d="M408 290 Q420 285 412 270" stroke="#f5c4a0" stroke-width="13" stroke-linecap="round" fill="none" />
        <!-- neck -->
        <rect x="375" y="255" width="18" height="18" rx="9" fill="#f5c4a0" />
        <!-- head -->
        <circle cx="384" cy="242" r="26" fill="#f5c4a0" />
        <!-- hair -->
        <path d="M360 232 Q362 210 384 208 Q406 210 408 232 Q400 220 384 222 Q368 220 360 232Z" fill="#2c2011" />
        <!-- ear -->
        <ellipse cx="358" cy="243" rx="5" ry="7" fill="#e8b08a" />
        <!-- eye left -->
        <ellipse cx="375" cy="242" rx="3" ry="3.5" fill="#2c2011" />
        <!-- eye right -->
        <ellipse cx="393" cy="242" rx="3" ry="3.5" fill="#2c2011" />
        <!-- smile -->
        <path d="M376 252 Q384 258 392 252" stroke="#b07040" stroke-width="2" stroke-linecap="round" fill="none" />

        <!-- shadow -->
        <ellipse cx="175" cy="416" rx="52" ry="9" fill="rgba(180,150,120,0.25)" />
        <!-- legs stretched -->
        <path d="M158 390 Q148 408 130 412" stroke="#f5c4a0" stroke-width="14" stroke-linecap="round" fill="none" />
        <path d="M178 388 Q192 408 210 413" stroke="#f5c4a0" stroke-width="14" stroke-linecap="round" fill="none" />
        <!-- shoes -->
        <ellipse cx="127" cy="413" rx="13" ry="7" fill="#2c3a52" />
        <ellipse cx="213" cy="414" rx="13" ry="7" fill="#2c3a52" />
        <!-- body -->
        <ellipse cx="168" cy="370" rx="28" ry="34" fill="#fde8c8" />
        <!-- shirt -->
        <path d="M140 375 Q145 350 168 348 Q191 350 196 375 Q183 360 168 362 Q153 360 140 375Z" fill="var(--primary)" />
        <!-- left arm -->
        <path d="M142 365 Q128 360 122 350" stroke="#f5c4a0" stroke-width="12" stroke-linecap="round" fill="none" />
        <!-- right arm -->
        <path d="M194 365 Q208 360 214 350" stroke="#f5c4a0" stroke-width="12" stroke-linecap="round" fill="none" />
        <!-- head tilted up -->
        <circle cx="168" cy="316" r="28" fill="#f5c4a0" />
        <!-- hair -->
        <path d="M142 308 Q145 284 168 282 Q191 284 194 308 Q185 294 168 296 Q151 294 142 308Z" fill="#2c2011" />
        <!-- beard -->
        <path d="M150 328 Q168 340 186 328 Q180 338 168 340 Q156 338 150 328Z" fill="#8a6040" />
        <!-- eye left -->
        <ellipse cx="158" cy="314" rx="3" ry="2.5" fill="#2c2011" transform="rotate(-15,158,314)" />
        <!-- eye right -->
        <ellipse cx="178" cy="312" rx="3" ry="2.5" fill="#2c2011" transform="rotate(-15,178,312)" />
        <!-- eyebrows raised (surprised) -->
        <path d="M153 306 Q158 302 163 306" stroke="#2c2011" stroke-width="2" stroke-linecap="round" fill="none" />
        <path d="M173 304 Q178 300 183 304" stroke="#2c2011" stroke-width="2" stroke-linecap="round" fill="none" />
        <!-- mouth open (oops) -->
        <ellipse cx="168" cy="326" rx="6" ry="4" fill="#c07050" />

        <!-- Speech bubble "Oops!" -->
        <g>
            <rect x="196" y="278" width="80" height="34" rx="14" fill="#fff8f0" stroke="var(--primary)" stroke-width="2" />
            <polygon points="200,312 192,326 210,312" fill="#fff8f0" stroke="var(--primary)" stroke-width="2" stroke-linejoin="round" />
            <!-- cover stroke seam inside bubble -->
            <rect x="198" y="312" width="14" height="4" fill="#fff8f0" />
            <text x="236" y="301" font-family="Nunito, sans-serif" font-size="14" font-weight="700" fill="var(--primary)" text-anchor="middle">Oops!</text>
        </g>
        <!-- pot -->
        <path d="M70 390 Q68 415 95 418 Q122 415 120 390Z" fill="#c8813a" />
        <rect x="65" y="384" width="60" height="12" rx="6" fill="#e09050" />
        <!-- soil -->
        <ellipse cx="95" cy="390" rx="28" ry="7" fill="#7a5230" />
        <!-- stems -->
        <path d="M95 388 Q88 360 78 330" stroke="#4a7a3a" stroke-width="5" stroke-linecap="round" fill="none" />
        <path d="M95 388 Q100 355 105 320" stroke="#4a7a3a" stroke-width="5" stroke-linecap="round" fill="none" />
        <path d="M95 388 Q80 365 70 340" stroke="#4a7a3a" stroke-width="4" stroke-linecap="round" fill="none" />
        <!-- leaves -->
        <ellipse cx="74" cy="322" rx="14" ry="22" fill="#3a8a2a" transform="rotate(-25,74,322)" />
        <ellipse cx="108" cy="312" rx="13" ry="20" fill="#4aaa38" transform="rotate(20,108,312)" />
        <ellipse cx="64" cy="338" rx="12" ry="18" fill="#2d7a22" transform="rotate(-40,64,338)" />
        <!-- leaf veins -->
        <path d="M74 336 Q72 322 70 308" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" fill="none" />
        <path d="M108 328 Q108 316 108 304" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" fill="none" />

    </svg>

    <!-- TEXT -->
    <div class="text-block">
        <div class="oops-title">Oops, something went wrong</div>
        <p class="oops-sub">Error 404 Page not found. Sorry the page you looking for doesn't exist or has been moved</p>
        <a href="/Dashboard" class="btn btn-primary"><i class="bi bi-house-door-fill"></i> Back to Dashboard</a>
    </div>
</div>
</div>