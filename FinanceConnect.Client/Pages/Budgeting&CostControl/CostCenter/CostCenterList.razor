@page "/cost-centers"
@inject NavigationManager NavigationManager
@inject BranchService BranchService
@inject ToastService ToastService
<style>
    @@media(max-width:635px) {
        .responsivefilter {
            flex-wrap: wrap;
        }
    }
</style>
<div class="content List-view">

    <!-- Page Header -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Cost Centers</h4>
                <h6>Manage responsibility and accountability units</h6>
            </div>
        </div>

        <ul class="table-top-head me-2">
            <li>
                <a title="Refresh" @onclick="Reload">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>

        <div class="page-btn">
            <a href="/cost-centers/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i>
                Create
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset">
                        <i class="ti ti-search fs-14"></i>
                    </span>
                    <input type="search"
                           class="form-control form-control-sm"
                           placeholder="Search code or name..."
                           @bind="SearchText"
                           @oninput="OnSearch" />
                </div>
            </div>

            <div style="display:flex;gap:10px;" class="responsivefilter">

                <select class="form-select form-select-sm" style="min-width:150px"
                        @bind="SelectedType" @bind:after="ApplyFilters">
                    <option value="">All Types</option>
                    @foreach (var t in AvailableTypes)
                    {
                        <option value="@t">@t</option>
                    }
                </select>

                <select class="form-select form-select-sm" style="min-width:150px"
                        @bind="SelectedBranchId" @bind:after="ApplyFilters">
                    <option value="">All Branches</option>
                    @foreach (var b in BranchesList)
                    {
                        <option value="@b.Id">@b.BranchName</option>
                    }
                </select>

                <select class="form-select form-select-sm" style="min-width:130px"
                        @bind="SelectedStatus" @bind:after="ApplyFilters">
                    <option value="">All Status</option>
                    @foreach (var s in AvailableStatuses)
                    {
                        <option value="@s">@s</option>
                    }
                </select>

            </div>
        </div>

        <!-- Table -->
        <div class="card-body p-0">
            <table class="table align-middle w-100 table-fixed">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xxl-none" style="width:40px"></th>
                        @* <th>Code</th> *@
                        <th>Name</th>
                        <th class="d-none d-xl-table-cell">Type</th>
                        <th class="d-none d-lg-table-cell">Branch</th>
                        <th class="d-none d-xl-table-cell">Owner</th>
                        <th class="d-none d-xxl-table-cell text-center">Control Mode</th>
                        <th class="d-none d-xl-table-cell text-center">Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedCenters.Any())
                    {
                        @foreach (var cc in PagedCenters)
                        {
                            <tr>
                                <!-- Responsive expand -->
                                <td class="d-xxl-none text-center" style="padding:0;padding-left:15px;">
                                    <a href="javascript:void(0);" class="TablePlus"
                                       data-bs-toggle="modal"
                                       data-bs-target="#rowDetailsModal"
                                       @onclick="() => OpenRowDetails(cc)">
                                        <i class="ti ti-plus"></i>
                                    </a>
                                </td>

                                <!-- Code -->
                                <td >
                                    <span class="fw-medium" data-bs-toggle="tooltip"
                                          data-bs-placement="top"
                                          title="@cc.CostCenterCode details">
                                        <span class="PopupIcon">⧉</span>
                                        <a @onclick="() => ViewCostCenter(cc)"
                                           class="text-decoration-none link-View">
                                            @cc.CostCenterName
                                        </a>
                                    </span>
                                </td>

                                @* <td class="d-none d-md-table-cell">@cc.CostCenterName</td> *@

                                <td class="d-none d-xl-table-cell">
                                    <span class="badge @GetTypeBadge(cc.CostCenterType)">
                                        @cc.CostCenterType
                                    </span>
                                </td>

                                <td class="d-none d-lg-table-cell">@cc.BranchName</td>

                                <td class="d-none d-xl-table-cell">@cc.CostCenterOwnerName</td>

                                <td class="d-none d-xxl-table-cell text-center">
                                    <span class="badge @GetControlModeBadge(cc.BudgetControlMode)">
                                        @cc.BudgetControlMode
                                    </span>
                                </td>

                                <td class="d-none d-xl-table-cell">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <div class="ActiveDot @GetStatusDotBadge(cc.CostCenterStatus)"></div>
                                        <span>@cc.CostCenterStatus</span>
                                    </div>
                                </td>

                                <!-- Actions -->
                                <td class="action-table-data">
                                    <div class="edit-delete-action">

                                        <a class="me-2 view-icon p-1" title="View"
                                           @onclick="() => ViewCostCenter(cc)">
                                            <i class="ti ti-eye"></i>
                                        </a>

                                        <a class="me-2 edit-icon p-1" title="Edit"
                                           @onclick='() => NavigationManager.NavigateTo($"/cost-centers/edit/{cc.CostCenterCode}")'>
                                            <i data-feather="edit"></i>
                                        </a>

                                        @if (!cc.IsLocked)
                                        {
                                            <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon"
                                               href="javascript:void(0);"
                                               title="Lock Cost Center"
                                               data-bs-toggle="modal"
                                               data-bs-target="#view-Lock-modal"
                                               @onclick="() => OpenLockModal(cc)">
                                                <i class="ti ti-lock-open"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="me-2 p-1 Toggle-icon action-icon activate-icon"
                                               href="javascript:void(0);"
                                               title="Unlock Cost Center"
                                               data-bs-toggle="modal"
                                               data-bs-target="#view-Lock-modal"
                                               @onclick="() => OpenLockModal(cc)">
                                                <i class="ti ti-lock"></i>
                                            </a>
                                        }

                                        <a class="me-2 p-1 delete-icon" href="javascript:void(0);"
                                           title="Delete"
                                           @onclick="() => ConfirmDelete(cc)"
                                           data-bs-toggle="modal"
                                           data-bs-target="#delete-modal">
                                            <i data-feather="trash-2"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@VisibleColumnCount" class="text-center py-4 text-muted">
                                No cost centers found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            @if (PagedCenters.Any())
            {
                <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                    <div class="d-flex align-items-center">
                        <span class="me-2">Rows per page:</span>
                        <select class="form-select form-select-sm" style="width:auto" @onchange="OnPageSizeChange">
                            <option value="5" selected="@(PageSize == 5)">5</option>
                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                        <span class="ms-3 text-muted">Entries</span>
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                    <i class="ti ti-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = StartPage; i <= EndPage; i++)
                            {
                                int pageNum = i;
                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                    <i class="ti ti-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>


<!-- Lock / Unlock Modal -->
<div class="modal fade" id="view-Lock-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 mb-2"
                          style="background-color:@(SelectedCenter?.IsLocked == false ? "#fff3cd" : "#d1ecf1");">
                        <i class="ti @(SelectedCenter?.IsLocked == false ? "ti-lock text-warning" : "ti-lock-open text-success") fs-24"></i>
                    </span>

                    <h4 class="fs-20 fw-bold">
                        @(SelectedCenter?.IsLocked == false ? "Lock Cost Center" : "Unlock Cost Center")
                    </h4>

                    <p>
                        Are you sure you want to
                        <strong>@(SelectedCenter?.IsLocked == false ? "lock" : "unlock")</strong>
                        the cost center <strong>@SelectedCenter?.CostCenterName</strong>?
                    </p>

                    @if (SelectedCenter?.IsLocked == false)
                    {
                        <div class="px-3 mb-3 text-start">
                            <label class="form-label">Lock Reason <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="LockReason" placeholder="Reason for locking..." maxlength="200" />
                        </div>
                    }

                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal">
                            <i class="ti ti-x"></i> Cancel
                        </button>
                        <button type="button"
                                class="btn @(SelectedCenter?.IsLocked == false ? "btn-warning" : "btn-success") fs-13 fw-medium p-2 px-4"
                                data-bs-dismiss="modal"
                                @onclick="ConfirmToggleLock">
                            <i class="ti @(SelectedCenter?.IsLocked == false ? "ti-lock" : "ti-lock-open")"></i>
                            Yes, @(SelectedCenter?.IsLocked == false ? "Lock" : "Unlock")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Delete Modal -->
<div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                        <i class="ti ti-trash fs-24 text-danger"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Cost Center</h4>
                    <p class="text-gray-6 mb-0 fs-16">
                        Are you sure you want to delete
                        <strong>@SelectedCenter?.CostCenterName</strong>?
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal">
                            <i class="ti ti-x"></i> Cancel
                        </button>
                        <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"
                                @onclick="DeleteCostCenter">
                            <i class="ti ti-trash"></i> Yes, Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- View Offcanvas -->
<div class="offcanvas offcanvas-end offcanvas-view"
     tabindex="-1"
     id="viewCostCenterOffcanvas"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    @if (SelectedViewCenter != null)
    {
        <!-- Header -->
        <div class="offcanvas-header">
            <div class="oc-avatar">
                <i class="ti ti-chart-donut"></i>
            </div>
            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@SelectedViewCenter.CostCenterName</h5>
                    <span class="oc-status-pill @(SelectedViewCenter.CostCenterStatus == "Active" ? "active" : "inactive")">
                        <span class="oc-status-dot"></span>
                        @SelectedViewCenter.CostCenterStatus
                    </span>
                </div>
                <p class="oc-header-sub">Code : @SelectedViewCenter.CostCenterCode</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>

        <div class="offcanvas-body">

            <!-- Summary Cards -->
            <div class="oc-summary-row">
                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value">@(SelectedViewCenter.CostCenterType ?? "—")</div>
                    <div class="oc-summary-label">Type</div>
                </div>
                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value">@(SelectedViewCenter.ControlNature ?? "—")</div>
                    <div class="oc-summary-label">Control Nature</div>
                </div>
                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value">@(SelectedViewCenter.BudgetControlMode ?? "—")</div>
                    <div class="oc-summary-label">Budget Control</div>
                </div>
            </div>

            <!-- General Info -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-info-circle"></i>
                    <h6 class="oc-card-title">General Information</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-grid">
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Short Name</div>
                            <div class="oc-field-value">@(SelectedViewCenter.ShortName ?? "—")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Usage Mode</div>
                            <div class="oc-field-value">@(SelectedViewCenter.UsageMode ?? "—")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Reporting Group</div>
                            <div class="oc-field-value">@(SelectedViewCenter.ReportingGroupCode ?? "—")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Hierarchy Level</div>
                            <div class="oc-field-value">@SelectedViewCenter.HierarchyLevel</div>
                        </div>
                        @if (!string.IsNullOrEmpty(SelectedViewCenter.Description))
                        {
                            <div class="oc-grid-item" style="grid-column:1/-1">
                                <div class="oc-field-label">Description</div>
                                <div class="oc-field-value">@SelectedViewCenter.Description</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Organization -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-sitemap"></i>
                    <h6 class="oc-card-title">Organization & Hierarchy</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-grid">
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Parent Cost Center</div>
                            <div class="oc-field-value">@(SelectedViewCenter.ParentCostCenterName ?? "— (Root)")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Branch</div>
                            <div class="oc-field-value">@(SelectedViewCenter.BranchName ?? "—")</div>
                        </div>
                        @if (!string.IsNullOrEmpty(SelectedViewCenter.DepartmentName))
                        {
                            <div class="oc-grid-item">
                                <div class="oc-field-label">Department</div>
                                <div class="oc-field-value">@SelectedViewCenter.DepartmentName</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(SelectedViewCenter.RegionCode))
                        {
                            <div class="oc-grid-item">
                                <div class="oc-field-label">Region</div>
                                <div class="oc-field-value">@SelectedViewCenter.RegionCode</div>
                            </div>
                        }
                        <div class="oc-grid-item" style="grid-column:1/-1">
                            <div class="oc-field-label">Hierarchy Path</div>
                            <div class="oc-field-value" style="font-family:monospace;font-size:12px">
                                @(SelectedViewCenter.HierarchyPath ?? "—")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ownership -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-user-check"></i>
                    <h6 class="oc-card-title">Ownership</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-grid">
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Cost Center Owner</div>
                            <div class="oc-field-value">@(SelectedViewCenter.CostCenterOwnerName ?? "—")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Responsible Manager</div>
                            <div class="oc-field-value">@(SelectedViewCenter.ResponsibleManagerName ?? "—")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Finance Reviewer</div>
                            <div class="oc-field-value">@(SelectedViewCenter.FinanceReviewerName ?? "—")</div>
                        </div>
                        @if (!string.IsNullOrEmpty(SelectedViewCenter.ApprovalRoleCode))
                        {
                            <div class="oc-grid-item">
                                <div class="oc-field-label">Approval Role</div>
                                <div class="oc-field-value">@SelectedViewCenter.ApprovalRoleCode</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Financial Control -->
            <div class="oc-card">
                <div class="oc-card-header hdr-purple">
                    <i class="ti ti-shield-check"></i>
                    <h6 class="oc-card-title">Financial Control</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">Currency</span>
                            <span class="oc-list-value">@(SelectedViewCenter.DefaultCurrencyCode ?? "—")</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Budget Control Mode</span>
                            <span class="oc-list-value">
                                <span class="badge @GetControlModeBadge(SelectedViewCenter.BudgetControlMode)">
                                    @SelectedViewCenter.BudgetControlMode
                                </span>
                            </span>
                        </div>
                        @if (SelectedViewCenter.TolerancePercent.HasValue)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Tolerance %</span>
                                <span class="oc-list-value">@SelectedViewCenter.TolerancePercent %</span>
                            </div>
                        }
                        @if (SelectedViewCenter.ToleranceAmount.HasValue)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Tolerance Amount</span>
                                <span class="oc-list-value">@SelectedViewCenter.ToleranceAmount?.ToString("N2")</span>
                            </div>
                        }
                        <div class="oc-list-row">
                            <span class="oc-list-label">Capex Allowed</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedViewCenter.IsCapexAllowed ? "db-green" : "db-red")">
                                    <span class="dot"></span>@(SelectedViewCenter.IsCapexAllowed ? "Yes" : "No")
                                </span>
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Opex Allowed</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedViewCenter.IsOpexAllowed ? "db-green" : "db-red")">
                                    <span class="dot"></span>@(SelectedViewCenter.IsOpexAllowed ? "Yes" : "No")
                                </span>
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Allow Negative Balance</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedViewCenter.AllowNegativeBalance ? "db-green" : "db-red")">
                                    <span class="dot"></span>@(SelectedViewCenter.AllowNegativeBalance ? "Yes" : "No")
                                </span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Allocation -->
            <div class="oc-card">
                <div class="oc-card-header hdr-indigo">
                    <i class="ti ti-layers-linked"></i>
                    <h6 class="oc-card-title">Allocation Settings</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">Shared Service Center</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedViewCenter.IsSharedServiceCenter ? "db-green" : "db-red")">
                                    <span class="dot"></span>@(SelectedViewCenter.IsSharedServiceCenter ? "Yes" : "No")
                                </span>
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Can Receive Shared Cost</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedViewCenter.CanReceiveSharedCost ? "db-green" : "db-red")">
                                    <span class="dot"></span>@(SelectedViewCenter.CanReceiveSharedCost ? "Yes" : "No")
                                </span>
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Can Distribute Shared Cost</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedViewCenter.CanDistributeSharedCost ? "db-green" : "db-red")">
                                    <span class="dot"></span>@(SelectedViewCenter.CanDistributeSharedCost ? "Yes" : "No")
                                </span>
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(SelectedViewCenter.AllocationBaseType) && SelectedViewCenter.AllocationBaseType != "None")
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Allocation Base</span>
                                <span class="oc-list-value">@SelectedViewCenter.AllocationBaseType</span>
                            </div>
                        }
                        @if (SelectedViewCenter.DefaultAllocationDriverValue.HasValue)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Driver Value</span>
                                <span class="oc-list-value">@SelectedViewCenter.DefaultAllocationDriverValue</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Governance -->
            <div class="oc-card">
                <div class="oc-card-header hdr-teal">
                    <i class="ti ti-calendar-check"></i>
                    <h6 class="oc-card-title">Governance</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-grid">
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Effective From</div>
                            <div class="oc-field-value">@SelectedViewCenter.EffectiveFrom.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Effective To</div>
                            <div class="oc-field-value">@(SelectedViewCenter.EffectiveTo?.ToString("dd MMM yyyy") ?? "—")</div>
                        </div>
                        @if (SelectedViewCenter.IsLocked)
                        {
                            <div class="oc-grid-item">
                                <div class="oc-field-label">Locked By</div>
                                <div class="oc-field-value">@(SelectedViewCenter.LockedByName ?? "—")</div>
                            </div>
                            <div class="oc-grid-item">
                                <div class="oc-field-label">Locked On</div>
                                <div class="oc-field-value">@(SelectedViewCenter.LockedOn?.ToString("dd MMM yyyy") ?? "—")</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(SelectedViewCenter.ClosureReason))
                        {
                            <div class="oc-grid-item" style="grid-column:1/-1">
                                <div class="oc-field-label">Closure Reason</div>
                                <div class="oc-field-value">@SelectedViewCenter.ClosureReason</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(SelectedViewCenter.ReplacedByCostCenterName))
                        {
                            <div class="oc-grid-item" style="grid-column:1/-1">
                                <div class="oc-field-label">Replaced By</div>
                                <div class="oc-field-value">@SelectedViewCenter.ReplacedByCostCenterName</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    }
</div>


<!-- Responsive Row Details Modal -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cost Center Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0;right:22px;position:absolute;transform:none"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2 d-flex gap-3">
                    <strong>Name:</strong>
                    <div>@(SelectedViewCenter?.CostCenterName ?? "-")</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Type:</strong>
                    <div>@(SelectedViewCenter?.CostCenterType ?? "-")</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Branch:</strong>
                    <div>@(SelectedViewCenter?.BranchName ?? "-")</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Owner:</strong>
                    <div>@(SelectedViewCenter?.CostCenterOwnerName ?? "-")</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Control Mode:</strong>
                    <div>@(SelectedViewCenter?.BudgetControlMode ?? "-")</div>
                </div>
                <div class="mb-2 gap-3 d-md-none">
                    <strong>Status:</strong>
                    @if (!string.IsNullOrEmpty(SelectedViewCenter?.CostCenterStatus))
                    {
                        <span class="badge @GetStatusBadge(SelectedViewCenter.CostCenterStatus)">
                            @SelectedViewCenter.CostCenterStatus
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
