@page "/budget-lines"
@using static FinanceConnect.Client.ViewModels.BudgetLineViewModel

<style>
    @@media(max-width:635px){ .responsivefilter{ flex-wrap:wrap; } }
    .table-fixed { table-layout: fixed; }
    /* .bl-col-name { width: 22%; }
    .bl-col-type { width: 10%; }
    .bl-col-cat  { width: 12%; }
    .bl-col-cc   { width: 12%; }
    .bl-col-plan { width: 12%; }
    .bl-col-act  { width: 12%; }
    .bl-col-stat { width: 10%; }
    .bl-col-action { width: 8%; } */
    .cell-wrap { word-break: break-word; overflow-wrap: break-word; }
</style>

<div class="content List-view">
    <div class="page-header">
        <div class="add-item d-flex"><div class="page-title"><h4 class="fw-bold">Budget Line List</h4><h6>Manage detailed budget planning lines</h6></div></div>
        <ul class="table-top-head me-2"><li><a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync"><i class="ti ti-refresh"></i></a></li></ul>
        <div class="page-btn"><a href="/budget-lines/create" class="btn btn-primary"><i class="ti ti-circle-plus me-1"></i> Create</a></div>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
            <div class="search-set"><div class="search-input"><span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                <input type="search" class="form-control form-control-sm" placeholder="Search code, name, category..." @bind="searchText" @oninput="OnSearch" />
            </div></div>
            <div style="display:flex; gap:15px;" class="responsivefilter">
                <select class="form-select form-select-sm" style="min-width:160px" @bind="SelectedStatus" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Status</option>
                    @foreach (var s in Enum.GetValues<LineStatusEnum>()) { <option value="@((int)s)">@s</option> }
                </select>
                <select class="form-select form-select-sm" style="min-width:160px" @bind="SelectedType" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Types</option>
                    @foreach (var t in Enum.GetValues<LineTypeEnum>()) { <option value="@((int)t)">@t</option> }
                </select>
            </div>
        </div>

        <div class="card-body p-0">
            <table class="table align-middle w-100 table-fixed">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xxl-none" style="width:40px"></th>
                        <th class="bl-col-name" style="width: 253px;">Line Name</th>
                        <th class="d-none d-md-table-cell bl-col-type">Type</th>
                        <th class="d-none d-md-table-cell bl-col-cat">Category</th>
                        <th class="d-none d-xl-table-cell bl-col-cc">Cost Center</th>
                        <th class="d-none d-xxl-table-cell bl-col-plan text-end">Planned</th>
                        <th class="d-none d-xxl-table-cell bl-col-act text-end">Actual</th>
                        <th class="d-none d-xxl-table-cell bl-col-stat">Status</th>
                        <th class="bl-col-action">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedItems.Any())
                    {
                        @foreach (var l in PagedItems)
                        {
                            <tr>
                                <td class="d-xxl-none text-center" style="padding:0;padding-left:15px;">
                                    <a href="javascript:void(0);" class="TablePlus" data-bs-toggle="modal" data-bs-target="#rowDetailsModal" @onclick="() => SelectedItem = l"><i class="ti ti-plus"></i></a>
                                </td>
                                <td>
                                    <span class="fw-medium">
                                        <i class="ti ti-external-link me-2 PopupIcon"></i>
                                        <a href="/budget-lines/@l.BudgetLineId/view" class="link-View text-decoration-none"
                                           data-bs-toggle="tooltip" data-bs-placement="top"
                                           title="@l.LineCode details">@l.LineName</a>
                                    </span>
                                    @if (!string.IsNullOrEmpty(l.LineCode)) { <div class="text-muted small">@l.LineCode</div> }
                                    @if (l.IsLocked) { <span class="badge bg-danger-transparent ms-1" style="font-size:10px;"><i class="ti ti-lock me-1" style="font-size:9px;"></i>Locked</span> }
                                    @if (l.IsOverBudget) { <span class="badge bg-warning-transparent ms-1" style="font-size:10px;"><i class="ti ti-alert-triangle me-1" style="font-size:9px;"></i>Over Budget</span> }
                                </td>
                                <td class="d-none d-md-table-cell cell-wrap"><span class="badge @GetTypeBadge(l.LineType)">@l.LineType</span></td>
                                <td class="d-none d-md-table-cell cell-wrap">@l.BudgetCategoryCode</td>
                                <td class="d-none d-xl-table-cell cell-wrap">@(l.CostCenterName ?? "–")</td>
                                <td class="d-none d-xxl-table-cell text-end fw-medium">@l.OriginalPlannedAmount.ToString("N2")</td>
                                <td class="d-none d-xxl-table-cell text-end @(l.IsOverBudget ? "text-danger fw-bold" : "")">@l.ActualConsumedAmount.ToString("N2")</td>
                                <td class="d-none d-xxl-table-cell">
                                    <div class="d-flex align-items-center gap-2"><div class="ActiveDot @GetStatusDot(l.LineStatus)"></div><span>@l.LineStatus</span></div>
                                </td>
                                <td class="action-table-data">
                                    <div class="edit-delete-action">
                                        @if (!l.IsLocked && l.LineStatus != LineStatusEnum.Closed) {
                                            <a class="me-2 p-1 edit-icon" href="/budget-lines/edit/@l.BudgetLineId" title="Edit"><i data-feather="edit"></i></a>
                                        } else {
                                            <a class="me-2 p-1 text-muted" style="cursor:not-allowed;opacity:0.4;" title="@(l.IsLocked ? "Locked" : "Closed")"><i data-feather="edit"></i></a>
                                        }
                                        @if (!l.IsLocked && l.LineStatus != LineStatusEnum.Closed && l.LineStatus != LineStatusEnum.Archived) {
                                            <a class="me-2 p-1 action-icon" href="javascript:void(0);" title="Delete" data-bs-toggle="modal" data-bs-target="#delete-modal" @onclick="() => SelectedItem = l"><i data-feather="trash-2"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else { <tr><td colspan="9" class="text-center text-muted py-4">No budget lines found.</td></tr> }
                </tbody>
            </table>
        </div>

        <!-- ═══ PAGINATION ═══ -->
        @if (FilteredItems.Count > 0)
        {
            <div class="d-flex align-items-center justify-content-between p-3">
                <div class="d-flex align-items-center fs-13">
                    <span class="me-2">Rows per page</span>
                    <select class="form-select form-select-sm" style="width:80px" @onchange="OnPageSizeChange">
                        <option value="5"  selected="@(PageSize == 5)">5</option>
                        <option value="10" selected="@(PageSize == 10)">10</option>
                        <option value="25" selected="@(PageSize == 25)">25</option>
                        <option value="50" selected="@(PageSize == 50)">50</option>
                    </select>
                    <span class="ms-2">Entries</span>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage"><i class="ti ti-chevron-left"></i></a>
                        </li>
                        @for (int i = StartPage; i <= EndPage; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="NextPage"><i class="ti ti-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- ═══ DELETE MODAL ═══ -->
<div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                        <i class="ti ti-trash fs-24 text-danger"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Budget Line</h4>
                    <p class="text-gray-6 mb-0 fs-16">
                        Are you sure you want to delete
                        <strong>@SelectedItem?.LineCode</strong> — @SelectedItem?.LineName?
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal">
                            <i class="ti ti-x me-1"></i>Cancel
                        </button>
                        <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4"
                                @onclick="() => ConfirmDelete(SelectedItem!.BudgetLineId)" data-bs-dismiss="modal">
                            <i class="ti ti-trash me-1"></i>Yes, Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ RESPONSIVE ROW DETAILS MODAL ═══ -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Budget Line Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0;right:22px;position:absolute;transform:none"></button>
            </div>
            <div class="modal-body">
                @if (SelectedItem != null)
                {
                    <div class="mb-2 d-flex gap-3"><strong>Code:</strong><div>@(SelectedItem.LineCode ?? "–")</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Name:</strong><div>@SelectedItem.LineName</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Type:</strong><div>@SelectedItem.LineType</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Category:</strong><div>@SelectedItem.BudgetCategoryCode</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Cost Center:</strong><div>@(SelectedItem.CostCenterName ?? "–")</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Planned:</strong><div>@SelectedItem.OriginalPlannedAmount.ToString("N2")</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Actual:</strong><div>@SelectedItem.ActualConsumedAmount.ToString("N2")</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Status:</strong><div>@SelectedItem.LineStatus</div></div>
                }
            </div>
        </div>
    </div>
</div>
