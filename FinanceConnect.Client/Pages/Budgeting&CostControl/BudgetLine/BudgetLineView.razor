@page "/budget-lines/{Id:guid}/view"
@using FinanceConnect.Client.ViewModels
@using static FinanceConnect.Client.ViewModels.BudgetLineViewModel

@if (!isInitialized)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else if (Item == null)
{
    <div class="vb-root"><div class="content">
        <div class="alert alert-danger"><i class="ti ti-alert-circle me-2"></i>Budget line not found. <a href="/budget-lines" class="alert-link ms-2">Return to list</a></div>
    </div></div>
}
else
{
    <div class="vb-root"><div class="content">

        <!-- ═══ HEADER ═══ -->
        <div class="vb-header-card">
            <div class="vb-cover"><div class="vb-cover-orb vb-orb-1"></div><div class="vb-cover-orb vb-orb-2"></div><div class="vb-cover-orb vb-orb-3"></div></div>
            <div class="vb-header-body">
                <div class="vb-avatar">@(Item.LineCode?.Substring(0, Math.Min(2, Item.LineCode?.Length ?? 0)).ToUpper() ?? "BL")</div>
                <div class="vb-header-meta">
                    <div>
                        <p class="vb-bill-number">@(Item.LineCode ?? $"Line #{Item.LineNumber}") – @Item.LineName</p>
                        <p class="vb-bill-sub">@Item.LineType · @Item.BudgetCategoryCode · @(Item.CostCenterName ?? "No Cost Center")</p>
                        <div class="vb-badges">
                            <span class="badge @GetStatusBadge(Item.LineStatus)">@Item.LineStatus</span>
                            <span class="badge @GetTypeBadgeColor(Item.LineType)">@Item.LineType</span>
                            @if (Item.IsLocked) { <span class="badge badge-red">🔒 Locked</span> }
                            @if (Item.IsCapexFlag) { <span class="badge bg-warning-transparent">CAPEX</span> }
                            @if (Item.IsOverBudget) { <span class="badge bg-warning-transparent">⚠ Over Budget</span> }
                        </div>
                    </div>
                    <div class="vb-header-actions">
                        @if (!Item.IsLocked && Item.LineStatus != LineStatusEnum.Closed) { <a href="/budget-lines/edit/@Item.BudgetLineId" class="btn btn-primary"><i class="ti ti-pencil me-1"></i> Edit</a> }
                            <a href="/budget-lines" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i> Back</a>

                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ SUMMARY TILES ═══ -->
        <div class="vb-summary-grid mb-4 mt-2" style="background:transparent;border:none;box-shadow:none;">
            <div class="vb-tile"><div class="vb-tile-label">Original Planned</div><div class="vb-tile-value primary">@Item.OriginalPlannedAmount.ToString("N2")</div></div>
            <div class="vb-tile"><div class="vb-tile-label">Effective Budget</div><div class="vb-tile-value primary">@Item.EffectiveBudgetAmount.ToString("N2")</div></div>
            <div class="vb-tile"><div class="vb-tile-label">Actual Consumed</div><div class="vb-tile-value @(Item.IsOverBudget ? "text-danger" : "")">@Item.ActualConsumedAmount.ToString("N2")</div></div>
            <div class="vb-tile"><div class="vb-tile-label">Available Balance</div><div class="vb-tile-value @(Item.AvailableBalanceAmount < 0 ? "text-danger" : "text-success")">@Item.AvailableBalanceAmount.ToString("N2")</div></div>
            <div class="vb-tile"><div class="vb-tile-label">Utilization %</div><div class="vb-tile-value">@Item.UtilizationPercent.ToString("N2")%</div></div>
            <div class="vb-tile"><div class="vb-tile-label">Over Budget</div><div class="vb-tile-value @(Item.IsOverBudget ? "text-danger" : "")">@Item.OverBudgetAmount.ToString("N2")</div></div>
        </div>

        <!-- ═══ TWO-COLUMN BODY ═══ -->
        <div class="ac-layout mb-5">

            <!-- ══ LEFT SIDEBAR ══ -->
            <div class="ac-left">

                <!-- Line Classification -->
                <div class="vb-card">
                    <div class="vb-card-header"><h6><i class="ti ti-category me-1"></i> Line Classification</h6></div>
                    <div class="vb-card-body">
                        <div class="vb-row"><span class="vb-label">Line Type</span><span class="vb-val"><span class="badge @GetTypeBadgeColor(Item.LineType)">@Item.LineType</span></span></div>
                        <div class="vb-row"><span class="vb-label">Budget Category</span><span class="vb-val">@Item.BudgetCategoryCode</span></div>
                        <div class="vb-row"><span class="vb-label">GL Account</span><span class="vb-val">@(Item.GLAccountName ?? (Item.GLAccountId?.ToString() ?? "–"))</span></div>
                        <div class="vb-row"><span class="vb-label">GL Account Group</span><span class="vb-val">@(Item.GLAccountGroupName ?? (Item.GLAccountGroupId?.ToString() ?? "–"))</span></div>
                        <div class="vb-row"><span class="vb-label">Expense Nature</span><span class="vb-val">@(Item.ExpenseNature ?? "–")</span></div>
                        <div class="vb-row"><span class="vb-label">Is Capex</span><span class="vb-val">@BoolBadge(Item.IsCapexFlag)</span></div>
                    </div>
                </div>

                <!-- Ownership & Dimensions -->
                <div class="vb-card">
                    <div class="vb-card-header"><h6><i class="ti ti-building me-1"></i> Ownership & Dimensions</h6></div>
                    <div class="vb-card-body">
                        <div class="vb-row"><span class="vb-label">Cost Center</span><span class="vb-val">@(Item.CostCenterName ?? "–")</span></div>
                        <div class="vb-row"><span class="vb-label">Department</span><span class="vb-val">@(Item.DepartmentName ?? "–")</span></div>
                        <div class="vb-row"><span class="vb-label">Branch</span><span class="vb-val">@(Item.BranchName ?? "–")</span></div>
                        <div class="vb-row"><span class="vb-label">Project</span><span class="vb-val">@(Item.ProjectName ?? "–")</span></div>
                        <div class="vb-row"><span class="vb-label">Owner</span><span class="vb-val">@(Item.OwnerUserName ?? "–")</span></div>
                        <div class="vb-row"><span class="vb-label">Responsibility</span><span class="vb-val">@(Item.ResponsibilityType?.ToString() ?? "–")</span></div>
                        @if (!string.IsNullOrWhiteSpace(Item.DimensionScopeJson))
                        {
                            <div class="vb-row"><span class="vb-label">Dimension Scope</span><span class="vb-val small text-muted" style="word-break:break-all;">@Item.DimensionScopeJson</span></div>
                        }
                    </div>
                </div>

                <!-- Status & Controls -->
                <div class="vb-card">
                    <div class="vb-card-header"><h6><i class="ti ti-toggle-right me-1"></i> Status & Controls</h6></div>
                    <div class="vb-card-body">
                        <div class="vb-row"><span class="vb-label">Line Status</span><span class="vb-val"><span class="badge @GetStatusBadge(Item.LineStatus)">@Item.LineStatus</span></span></div>
                        <div class="vb-row"><span class="vb-label">Locked</span><span class="vb-val">@BoolBadge(Item.IsLocked)</span></div>
                        <div class="vb-row"><span class="vb-label">Over Budget</span><span class="vb-val">@BoolBadge(Item.IsOverBudget)</span></div>
                        <div class="vb-row"><span class="vb-label">Under Utilized</span><span class="vb-val">@BoolBadge(Item.IsUnderUtilized)</span></div>
                        <div class="vb-row"><span class="vb-label">Attachment Count</span><span class="vb-val">@Item.AttachmentCount</span></div>
                    </div>
                </div>

            </div>
            <!-- ══ END LEFT ══ -->

            <!-- ══ RIGHT MAIN ══ -->
            <div class="ac-right">

                <!-- Planned & Actual Amounts -->
                <div class="vb-card">
                    <div class="vb-card-header"><h6><i class="ti ti-currency-dollar me-1"></i> Planned & Actual Amounts</h6></div>
                    <div class="vb-card-body">
                        <div class="ac-2col">
                            <div class="vb-row"><span class="vb-label">Original Planned</span><span class="vb-val">@Item.OriginalPlannedAmount.ToString("N2")</span></div>
                            <div class="vb-row"><span class="vb-label">Revised Amount</span><span class="vb-val">@(Item.RevisedAmount?.ToString("N2") ?? "–")</span></div>
                            <div class="vb-row"><span class="vb-label">Effective Budget</span><span class="vb-val fw-bold">@Item.EffectiveBudgetAmount.ToString("N2")</span></div>
                            <div class="vb-row"><span class="vb-label">Released Amount</span><span class="vb-val">@(Item.ReleasedAmount?.ToString("N2") ?? "–")</span></div>
                            <div class="vb-row"><span class="vb-label">Reserved Amount</span><span class="vb-val">@(Item.ReservedAmount?.ToString("N2") ?? "–")</span></div>
                            <div class="vb-row"><span class="vb-label">Adjustment Amount</span><span class="vb-val">@(Item.AdjustmentAmount?.ToString("N2") ?? "–")</span></div>
                            <div class="vb-row"><span class="vb-label">Actual Consumed</span><span class="vb-val @(Item.IsOverBudget ? "text-danger fw-bold" : "")">@Item.ActualConsumedAmount.ToString("N2")</span></div>
                            <div class="vb-row"><span class="vb-label">Committed Amount</span><span class="vb-val">@(Item.CommittedAmount?.ToString("N2") ?? "–")</span></div>
                            <div class="vb-row"><span class="vb-label">Available Balance</span><span class="vb-val @(Item.AvailableBalanceAmount < 0 ? "text-danger" : "text-success")">@Item.AvailableBalanceAmount.ToString("N2")</span></div>
                            <div class="vb-row"><span class="vb-label">Utilization %</span><span class="vb-val">@Item.UtilizationPercent.ToString("N2")%</span></div>
                            <div class="vb-row"><span class="vb-label">Variance To Date</span><span class="vb-val">@(Item.VarianceToDateAmount?.ToString("N2") ?? "–")</span></div>
                            <div class="vb-row"><span class="vb-label">Over Budget Amount</span><span class="vb-val @(Item.IsOverBudget ? "text-danger" : "")">@Item.OverBudgetAmount.ToString("N2")</span></div>
                        </div>
                    </div>
                </div>

                <!-- Period Distribution & Matching -->
                <div class="vb-card">
                    <div class="vb-card-header"><h6><i class="ti ti-calendar-stats me-1"></i> Period Distribution & Matching</h6></div>
                    <div class="vb-card-body">
                        <div class="ac-2col">
                            <div class="vb-row"><span class="vb-label">Distribution Mode</span><span class="vb-val">@Item.DistributionMode</span></div>
                            <div class="vb-row"><span class="vb-label">Has Period Distribution</span><span class="vb-val">@BoolBadge(Item.HasPeriodDistribution)</span></div>
                            <div class="vb-row"><span class="vb-label">Distribution Template</span><span class="vb-val">@(Item.DistributionTemplateCode ?? "–")</span></div>
                            <div class="vb-row"><span class="vb-label">Line Period Total Check</span><span class="vb-val">@(Item.LinePeriodTotalCheck?.ToString("N2") ?? "–")</span></div>
                            @if (!string.IsNullOrWhiteSpace(Item.PeriodDistributionJson))
                            {
                                <div class="vb-row"><span class="vb-label">Period Distribution</span><span class="vb-val small text-muted" style="word-break:break-all;">@Item.PeriodDistributionJson</span></div>
                            }
                            <div class="vb-row"><span class="vb-label">Actual Match Mode</span><span class="vb-val">@Item.ActualMatchMode</span></div>
                            @if (!string.IsNullOrWhiteSpace(Item.ActualMatchRuleJson))
                            {
                                <div class="vb-row"><span class="vb-label">Match Rule JSON</span><span class="vb-val small text-muted" style="word-break:break-all;">@Item.ActualMatchRuleJson</span></div>
                            }
                            <div class="vb-row"><span class="vb-label">Actual Source Scope</span><span class="vb-val">@Item.ActualSourceScope</span></div>
                            <div class="vb-row"><span class="vb-label">Include Allocated Actuals</span><span class="vb-val">@BoolBadge(Item.IncludeAllocatedActuals)</span></div>
                            <div class="vb-row"><span class="vb-label">Include Tax in Actuals</span><span class="vb-val">@BoolBadge(Item.IncludeTaxInActuals)</span></div>
                        </div>
                    </div>
                </div>

                <!-- Revision -->
                @if (!string.IsNullOrWhiteSpace(Item.RevisionReason))
                {
                    <div class="vb-card">
                        <div class="vb-card-header"><h6><i class="ti ti-edit me-1"></i> Revision</h6></div>
                        <div class="vb-card-body">
                            <div class="vb-row" style="flex-direction:column;gap:4px;"><span class="vb-label">Revision Reason</span><span class="vb-val" style="font-style:italic;color:var(--gray-600);">@Item.RevisionReason</span></div>
                        </div>
                    </div>
                }

                <!-- Notes & Assumptions -->
                @if (!string.IsNullOrWhiteSpace(Item.PlanningAssumptionText) || !string.IsNullOrWhiteSpace(Item.Notes) || !string.IsNullOrWhiteSpace(Item.Description))
                {
                    <div class="vb-card">
                        <div class="vb-card-header"><h6><i class="ti ti-notes me-1"></i> Notes & Assumptions</h6></div>
                        <div class="vb-card-body">
                            @if (!string.IsNullOrWhiteSpace(Item.Description))
                            {
                                <div class="vb-row" style="flex-direction:column;gap:4px;"><span class="vb-label">Description</span><span class="vb-val" style="font-style:italic;color:var(--gray-600);">@Item.Description</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Item.PlanningAssumptionText))
                            {
                                <div class="vb-row" style="flex-direction:column;gap:4px;"><span class="vb-label">Planning Assumptions</span><span class="vb-val" style="font-style:italic;color:var(--gray-600);">@Item.PlanningAssumptionText</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Item.Notes))
                            {
                                <div class="vb-row" style="flex-direction:column;gap:4px;"><span class="vb-label">Notes</span><span class="vb-val" style="font-style:italic;color:var(--gray-600);">@Item.Notes</span></div>
                            }
                        </div>
                    </div>
                }

                <!-- Audit Trail -->
                <div class="vb-card">
                    <div class="vb-card-header"><h6><i class="ti ti-history me-1"></i> Audit Trail</h6></div>
                    <div class="vb-card-body">
                        <div class="ac-2col">
                            <div class="vb-row"><span class="vb-label">Locked On</span><span class="vb-val">@(Item.LockedOn?.ToString("dd MMM yyyy HH:mm") ?? "–")</span></div>
                            <div class="vb-row"><span class="vb-label">Locked By</span><span class="vb-val">@(Item.LockedBy?.ToString() ?? "–")</span></div>
                            <div class="vb-row"><span class="vb-label">Closed On</span><span class="vb-val">@(Item.ClosedOn?.ToString("dd MMM yyyy HH:mm") ?? "–")</span></div>
                            <div class="vb-row"><span class="vb-label">Closed By</span><span class="vb-val">@(Item.ClosedBy?.ToString() ?? "–")</span></div>
                            <div class="vb-row"><span class="vb-label">Created At</span><span class="vb-val">@Item.CreatedAt.ToString("dd MMM yyyy HH:mm")</span></div>
                            <div class="vb-row"><span class="vb-label">Updated At</span><span class="vb-val">@(Item.UpdatedAt?.ToString("dd MMM yyyy HH:mm") ?? "–")</span></div>
                        </div>
                    </div>
                </div>

            </div>
            <!-- ══ END RIGHT ══ -->

        </div>

    </div></div>
}

<style>
    .ac-layout { display: grid; grid-template-columns: 300px 1fr; gap: 16px; align-items: start; }
    .ac-left, .ac-right { display: flex; flex-direction: column; gap: 16px; }
    .ac-2col {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(283px, 1fr));
        gap: 0 32px;
    }
    @@media (max-width: 900px) { .ac-layout { grid-template-columns: 1fr; } .ac-2col { grid-template-columns: 1fr; } }
</style>
