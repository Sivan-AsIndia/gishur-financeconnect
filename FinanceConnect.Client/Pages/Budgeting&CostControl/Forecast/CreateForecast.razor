@page "/forecasts/create"
@page "/forecasts/edit/{Id:guid}"
@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services
@using static FinanceConnect.Client.ViewModels.ForecastViewModel

<style>.validation-message{color:#dc3545;font-size:12px;}.form-check-label{font-size:13px;}</style>

<div class="content flat-form">
    <div class="page-header">
        <div class="page-title"><h4 class="fw-bold">@(IsEdit?"Edit Forecast":"Create Forecast")</h4><h6>Define forecast scope, methodology, and projections</h6></div>
        <div class="page-btn"><a href="/forecasts" class="btn btn-outline-secondary"><i class="ti ti-arrow-left"></i> Back</a></div>
    </div>

    <EditForm EditContext="_editContext" OnSubmit="Save">
        <DataAnnotationsValidator />

        <!-- SECTION 1: CORE IDENTITY -->
        <div class="card mt-4"><div class="card-body">
                <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-id me-2" style="font-size: 22px;"></i> Core Identity</h6>
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label">Forecast Code <span class="text-danger">*</span></label>
                    @if (IsEdit)
                    {
                        <div class="fw-semibold fs-14 mt-1">@Model.ForecastCode</div>
                    }
                    else
                    {
                        <InputText class="form-control text-uppercase" @bind-Value="Model.ForecastCode" placeholder="e.g. FCST-2026-Q1-001" title="Unique forecast identifier" /><ValidationMessage For="@(()=>Model.ForecastCode)" />
                    }
                </div>
                <div class="col-md-5"><label class="form-label">Forecast Name <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="Model.ForecastName" placeholder="e.g. Revised FY 2026 Operating Forecast" title="Descriptive forecast name" /><ValidationMessage For="@(()=>Model.ForecastName)" /></div>
                <div class="col-md-4"><label class="form-label">Status</label>
                    <InputSelect class="form-select" @bind-Value="Model.ForecastStatus">@foreach(var s in Enum.GetValues<ForecastStatusEnum>()){<option value="@s">@s</option>}</InputSelect></div>
                <div class="col-md-12"><label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="Model.Description" placeholder="Optional description..." title="Detailed description of forecast scope and purpose" /></div>
            </div>
        </div></div>

        <!-- SECTION 2: FORECAST CLASSIFICATION -->
        <div class="card mt-4"><div class="card-body">
                <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-category me-2" style="font-size: 22px;"></i> Forecast Classification</h6>
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label">Forecast Type <span class="text-danger">*</span></label>
                    <InputSelect class="form-select" @bind-Value="Model.ForecastType" title="Type of forecast"><option value="">-- Select --</option>@foreach(var v in Enum.GetValues<ForecastTypeEnum>()){<option value="@v">@v</option>}</InputSelect><ValidationMessage For="@(()=>Model.ForecastType)" /></div>
                <div class="col-md-3"><label class="form-label">Scenario <span class="text-danger">*</span></label>
                    <InputSelect class="form-select" @bind-Value="Model.ScenarioType" title="Scenario classification"><option value="">-- Select --</option>@foreach(var v in Enum.GetValues<ScenarioTypeEnum>()){<option value="@v">@v</option>}</InputSelect><ValidationMessage For="@(()=>Model.ScenarioType)" /></div>
                <div class="col-md-3"><label class="form-label">Scope Level <span class="text-danger">*</span></label>
                    <InputSelect class="form-select" @bind-Value="Model.ForecastLevel" title="Forecast granularity level"><option value="">-- Select --</option>@foreach(var v in Enum.GetValues<ForecastLevelEnum>()){<option value="@v">@v</option>}</InputSelect><ValidationMessage For="@(()=>Model.ForecastLevel)" /></div>
                <div class="col-md-3"><label class="form-label">Nature <span class="text-danger">*</span></label>
                    <InputSelect class="form-select" @bind-Value="Model.ForecastNature" title="Revenue/Expense/Mixed"><option value="">-- Select --</option>@foreach(var v in Enum.GetValues<ForecastNatureEnum>()){<option value="@v">@v</option>}</InputSelect><ValidationMessage For="@(()=>Model.ForecastNature)" /></div>
            </div>
        </div></div>

        <!-- SECTION 3: HORIZON & PERIOD SCOPE -->
        <div class="card mt-4"><div class="card-body">
                <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-calendar me-2" style="font-size: 22px;"></i> Horizon & Period</h6>
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label">Start Date <span class="text-danger">*</span></label>
                    <InputDate class="form-control" @bind-Value="Model.FromDate" title="Forecast start date" /><ValidationMessage For="@(()=>Model.FromDate)" /></div>
                <div class="col-md-3"><label class="form-label">End Date <span class="text-danger">*</span></label>
                    <InputDate class="form-control" @bind-Value="Model.ToDate" title="Forecast end date" /><ValidationMessage For="@(()=>Model.ToDate)" /></div>
                <div class="col-md-3"><label class="form-label">Time Mode <span class="text-danger">*</span></label>
                    <InputSelect class="form-select" @bind-Value="Model.ForecastTimeMode" title="Time scope of the forecast"><option value="">-- Select --</option>@foreach(var v in Enum.GetValues<ForecastTimeModeEnum>()){<option value="@v">@v</option>}</InputSelect><ValidationMessage For="@(()=>Model.ForecastTimeMode)" /></div>
                <div class="col-md-3"><label class="form-label">Actual As-Of Date</label>
                    <InputDate class="form-control" @bind-Value="Model.ActualAsOfDate" title="Cutoff date for actuals used in the forecast" /></div>
            </div>
        </div></div>

        <!-- SECTION 4: BASELINE & METHODOLOGY -->
        <div class="card mt-4"><div class="card-body">
                <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-chart-line me-2" style="font-size: 22px;"></i> Baseline & Methodology</h6>
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label">Baseline Type <span class="text-danger">*</span></label>
                    <InputSelect class="form-select" @bind-Value="Model.BaselineReferenceType" title="Reference baseline for comparison"><option value="">-- Select --</option>@foreach(var v in Enum.GetValues<BaselineReferenceTypeEnum>()){<option value="@v">@v</option>}</InputSelect><ValidationMessage For="@(()=>Model.BaselineReferenceType)" /></div>
                <div class="col-md-3"><label class="form-label">Forecast Method <span class="text-danger">*</span></label>
                    <InputSelect class="form-select" @bind-Value="Model.ForecastMethod" title="Method used to generate forecast values"><option value="">-- Select --</option>@foreach(var v in Enum.GetValues<ForecastMethodEnum>()){<option value="@v">@v</option>}</InputSelect><ValidationMessage For="@(()=>Model.ForecastMethod)" /></div>
                <div class="col-md-3"><label class="form-label">Confidence Level</label>
                    <InputSelect class="form-select" @bind-Value="Model.ConfidenceLevel" title="Overall confidence in this forecast"><option value="">-- Select --</option>@foreach(var v in Enum.GetValues<ConfidenceLevelEnum>()){<option value="@v">@v</option>}</InputSelect></div>
                <div class="col-md-3 d-flex flex-column gap-2 mt-4">
                    <div class="d-flex align-items-center gap-2"><InputCheckbox class="form-check-input" @bind-Value="Model.UseAllocatedValues" /><label class="form-check-label" title="Include allocated values in forecast">Use Allocated Values</label></div>
                    <div class="d-flex align-items-center gap-2"><InputCheckbox class="form-check-input" @bind-Value="Model.UseCommittedAmounts" /><label class="form-check-label" title="Include committed amounts">Use Committed Amounts</label></div>
                    <div class="d-flex align-items-center gap-2"><InputCheckbox class="form-check-input" @bind-Value="Model.IncludeTaxInForecast" /><label class="form-check-label" title="Include tax in forecast amounts">Include Tax</label></div>
                </div>
            </div>
        </div></div>

        <!-- SECTION 5: ASSUMPTIONS & NOTES -->
        <div class="card mt-4"><div class="card-body">
                <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-notes me-2" style="font-size: 22px;"></i> Assumptions & Notes</h6>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Forecast Assumption Summary</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="Model.ForecastAssumptionSummary" placeholder="Key assumptions..." title="Summary of assumptions driving this forecast" /></div>
                <div class="col-md-6"><label class="form-label">Key Risk Summary</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="Model.KeyRiskSummary" placeholder="Risk factors..." title="Key risks that could affect forecast accuracy" /></div>
                <div class="col-md-6"><label class="form-label">Key Opportunity Summary</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="Model.KeyOpportunitySummary" placeholder="Opportunities..." title="Potential upside opportunities" /></div>
                <div class="col-md-6"><label class="form-label">Notes</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="Model.Notes" placeholder="Additional notes..." title="General notes for the forecast" /></div>
            </div>
        </div></div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-end mt-4 mb-5 gap-2">
            <button type="button" class="btn btn-outline-secondary"
                    @onclick='() => Nav.NavigateTo("/forecasts")'>
                <i class="ti ti-x"></i> Cancel
            </button>
            <button type="submit" class="btn btn-primary">
                <i class="ti ti-device-floppy"></i>
                @(IsEdit ? "Update" : "Create")
            </button>
        </div>
    </EditForm>
</div>
