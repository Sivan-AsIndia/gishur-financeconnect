@page "/variance-analysis"
@using static FinanceConnect.Client.ViewModels.VarianceAnalysisViewModel

<style>
    @@media(max-width:442px) {
        .responsivefilter { flex-wrap: wrap; }
    }
    .table-fixed { table-layout: fixed; }
    /* .va-col-name { width: 30%; }
    .va-col-mode { width: 18%; }
    .va-col-period { width: 18%; white-space: nowrap; }
    .va-col-variance { width: 14%; }
    .va-col-status { width: 12%; }
    .va-col-action { width: 8%; } */
</style>

<div class="content List-view">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Variance Analysis List</h4>
                <h6>Manage Variance Analyses</h6>
            </div>
        </div>
        <ul class="table-top-head me-2">
            <li>
                <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>
        <div class="page-btn">
            <a href="/variance-analysis/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i> Create
            </a>
        </div>
    </div>

    <div class="card">

        <!-- FILTERS -->
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                    <input type="search" class="form-control form-control-sm"
                           placeholder="Search code, name..."
                           @bind="searchText" @oninput="OnSearch" />
                </div>
            </div>
            <div style="display:flex; gap:15px;" class="responsivefilter">
                <select class="form-select form-select-sm" style="min-width:180px"
                        @bind="SelectedMode" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Modes</option>
                    <option value="1">Budget vs Actual</option>
                    <option value="2">Budget vs Forecast</option>
                    <option value="3">Actual vs Forecast</option>
                    <option value="4">Budget vs Committed</option>
                    <option value="5">Revised Budget vs Actual</option>
                </select>
                <select class="form-select form-select-sm" style="min-width:180px"
                        @bind="SelectedStatus" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Status</option>
                    <option value="1">Draft</option>
                    <option value="2">Generated</option>
                    <option value="3">Under Review</option>
                    <option value="4">Reviewed</option>
                    <option value="5">Approved</option>
                    <option value="6">Locked</option>
                    <option value="7">Archived</option>
                </select>
            </div>
        </div>

        <!-- TABLE -->
        <div class="card-body p-0">
            <table class="table align-middle w-100 table-fixed">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xxl-none" style="width:40px"></th>
                        <th class="va-col-name" style="width: 300px;">Name</th>
                        <th class="d-none d-md-table-cell va-col-mode">Comparison Mode</th>
                        <th class="d-none d-xl-table-cell va-col-period">Period</th>
                        <th class="d-none d-xxl-table-cell va-col-variance">Variance</th>
                        <th class="d-none d-xxl-table-cell va-col-status">Status</th>
                        <th class="va-col-action">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedItems.Any())
                    {
                        @foreach (var item in PagedItems)
                        {
                            <tr>
                                <td class="d-xxl-none text-center" style="padding:0;padding-left:15px;">
                                    <a href="javascript:void(0);" class="TablePlus"
                                       data-bs-toggle="modal" data-bs-target="#rowDetailsModal"
                                       @onclick="() => SelectedItem = item">
                                        <i class="ti ti-plus"></i>
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-medium">
                                        <i class="ti ti-external-link me-2 PopupIcon"></i>
                                        <a href="/variance-analysis/@item.VarianceAnalysisId/view"
                                           class="link-View text-decoration-none"
                                           data-bs-toggle="tooltip" data-bs-placement="top"
                                           title="@item.AnalysisCode details">
                                            @item.AnalysisName
                                        </a>
                                    </span>
                                    @if (item.IsLocked)
                                    {
                                        <span class="badge bg-danger-transparent ms-1">
                                            <i class="ti ti-lock me-1" style="font-size:10px;"></i>Locked
                                        </span>
                                    }
                                </td>
                                <td class="d-none d-md-table-cell">@GetModeLabel(item.ComparisonMode)</td>
                                <td class="d-none d-xl-table-cell">
                                    <div>@(item.FromDate?.ToString("dd MMM yyyy") ?? "–") –</div>
                                    <div>@(item.ToDate?.ToString("dd MMM yyyy") ?? "–")</div>
                                </td>
                                <td class="d-none d-xxl-table-cell">
                                    @if (item.TotalVarianceAmount != 0)
                                    {
                                        <span class="@(item.TotalVarianceAmount > 0 ? "text-danger" : "text-success")">
                                            @item.TotalVarianceAmount.ToString("N2")
                                        </span>
                                    }
                                    else { <span>–</span> }
                                </td>
                                <td class="d-none d-xxl-table-cell">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="ActiveDot @GetStatusDot(item.AnalysisStatus)"></div>
                                        <span>@item.AnalysisStatus</span>
                                    </div>
                                </td>
                                <td class="action-table-data">
                                    <div class="edit-delete-action">
                                        @if (!item.IsLocked)
                                        {
                                            <a class="me-2 p-1 edit-icon" href="/variance-analysis/edit/@item.VarianceAnalysisId" title="Edit">
                                                <i data-feather="edit"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="me-2 p-1 text-muted" style="cursor:not-allowed;opacity:0.4;" title="Locked">
                                                <i data-feather="edit"></i>
                                            </a>
                                        }

                                        @if (!item.IsLocked && item.AnalysisStatus != AnalysisStatusEnum.Archived)
                                        {
                                            <a class="me-2 p-1 action-icon" href="javascript:void(0);" title="Delete"
                                               data-bs-toggle="modal" data-bs-target="#delete-modal"
                                               @onclick="() => SelectedItem = item">
                                                <i data-feather="trash-2"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No variance analyses found.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ═══ PAGINATION ═══ -->
        @if (FilteredItems.Count > 0)
        {
            <div class="d-flex align-items-center justify-content-between p-3">
                <div class="d-flex align-items-center fs-13">
                    <span class="me-2">Rows per page</span>
                    <select class="form-select form-select-sm" style="width:80px" @onchange="OnPageSizeChange">
                        <option value="5"  selected="@(PageSize == 5)">5</option>
                        <option value="10" selected="@(PageSize == 10)">10</option>
                        <option value="25" selected="@(PageSize == 25)">25</option>
                        <option value="50" selected="@(PageSize == 50)">50</option>
                    </select>
                    <span class="ms-2">Entries</span>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                <i class="ti ti-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = StartPage; i <= EndPage; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                <a class="page-link" href="javascript:void(0);"
                                   @onclick="() => GoToPage(pageNum)">@pageNum</a>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                <i class="ti ti-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }

    </div><!-- END card -->

    <!-- ═══ RESPONSIVE ROW DETAILS MODAL ═══ -->
    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Variance Analysis Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            style="padding:0;right:22px;position:absolute;transform:none"></button>
                </div>
                <div class="modal-body">
                    @if (SelectedItem != null)
                    {
                        <div class="mb-2 d-flex gap-3">
                            <strong>Code:</strong>
                            <div>@SelectedItem.AnalysisCode</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Name:</strong>
                            <div>@SelectedItem.AnalysisName</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Mode:</strong>
                            <div>@GetModeLabel(SelectedItem.ComparisonMode)</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Period:</strong>
                            <div>@(SelectedItem.FromDate?.ToString("dd MMM yyyy")) – @(SelectedItem.ToDate?.ToString("dd MMM yyyy"))</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Variance:</strong>
                            <div>@SelectedItem.TotalVarianceAmount.ToString("N2")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Status:</strong>
                            <div>@SelectedItem.AnalysisStatus</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ DELETE MODAL ═══ -->
    <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Variance Analysis</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Are you sure you want to delete
                            <strong>@SelectedItem?.AnalysisCode</strong>?
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button"
                                    class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4"
                                    data-bs-dismiss="modal">
                                <i class="ti ti-x me-1"></i>Cancel
                            </button>
                            <button type="button"
                                    class="btn btn-danger fs-13 fw-medium p-2 px-4"
                                    @onclick="() => ConfirmDelete(SelectedItem!.VarianceAnalysisId)"
                                    data-bs-dismiss="modal">
                                <i class="ti ti-trash me-1"></i>Yes, Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
