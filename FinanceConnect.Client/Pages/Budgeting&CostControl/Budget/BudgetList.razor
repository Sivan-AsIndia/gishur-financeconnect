@page "/budgets"

@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services

@inject BudgetService BudgetService
@inject ToastService ToastService
@inject IJSRuntime JS
@inject NavigationManager Nav
<style>
    @@media(max-width:635px) {
        .responsivefilter {
            flex-wrap: wrap;
        }
    }

    .modal .btn-close::before{
        background:white
    }
</style>
@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- HEADER -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Budgets</h4>
                    <h6>Manage financial planning budgets</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/budgets/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- CARD -->
        <div class="card">

            <!-- FILTER -->
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset">
                            <i class="ti ti-search fs-14"></i>
                        </span>
                        <input type="search"
                               class="form-control form-control-sm"
                               placeholder="Search budget"
                               @bind="searchText"
                               @oninput="OnSearch" />
                    </div>
                </div>
                <div style="display:flex;gap:10px" class="responsivefilter">
                    <!-- Company Filter -->
                    <div>
                        <select class="form-select form-select-sm"
                                style="min-width: 180px"
                                @bind="SelectedCompany">
                            <option value="">All Companies</option>
                            @foreach (var c in Companies)
                            {
                                <option value="@c.Id">@c.LegalName</option>
                            }
                        </select>
                    </div>

                    <!-- Status Filter -->
                <select class="form-select form-select-sm"
                        style="width:150px"
                        @bind="SelectedStatus">
                    <option value="">All Status</option>
                    <option>Draft</option>
                    <option>Submitted</option>
                    <option>Approved</option>
                    <option>Locked</option>
                </select>

                </div>

            </div>

            <!-- TABLE -->
            <div class="card-body p-0">

                <div>
                    <table class="table align-middle table-fixed w-100">

                        <thead class="thead-light">
                        <tr>
                            <th class="d-xl-none" style="width:40px"></th>
                                <th style="width:345px">Name</th>
                                <th class="d-none d-md-table-cell">Period</th>
                                <th class="text-end d-none d-md-table-cell">Amount</th>
                                <th class="d-none d-xl-table-cell">Version</th>
                                <th class="d-none d-xl-table-cell">Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (PagedBudgets.Any())
                        {
                            @foreach (var b in PagedBudgets)
                            {
                                <tr>

                                        <!-- PLUS ICON -->
                                        <td class="d-xl-none text-center" style="padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#rowDetailsModal"
                                                   @onclick="() => openBudget(b)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td>
                                            <span class="fw-medium">
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a @onclick="() => ViewBudget(b)"
                                                       class="text-decoration-none link-View"
                                                       title="@b.BudgetName details">
                                                    @b.BudgetName
                                                </a>
                                            </span>
                                        </td>


                                        <td class="d-none d-md-table-cell">
                                        @b.StartDate?.ToString("dd MMM yyyy")
                                        -
                                        @b.EndDate?.ToString("dd MMM yyyy")
                                    </td>

                                        <td class="text-end d-none d-md-table-cell">
                                        ₹@b.TotalBudgetAmount.ToString("N2")
                                    </td>
                                        <td class="d-none d-xl-table-cell">
                                        @b.VersionNumber
                                    </td>

                                        <td class="d-none d-xl-table-cell">
                                        <span class="badge @GetStatusBadge(b.Status)">
                                            @b.Status
                                        </span>
                                    </td>

                                    <td class="action-table-data">
                                        <div class="edit-delete-action">

                                            @if (b.IsDraft)
                                            {
                                                    <a class="me-2 edit-icon p-1"
                                                           title="Submit" @onclick="() => Submit(b)">
                                                    <i class="ti ti-send"></i>
                                                </a>
                                            }

                                            @if (b.IsSubmitted)
                                            {
                                                    <a class="me-2 edit-icon p-1"
                                                           title="Approve" @onclick="() => Approve(b)">
                                                    <i class="ti ti-check"></i>
                                                </a>
                                            }

                                            @if (b.IsApproved)
                                            {
                                                    <a class="me-2 edit-icon p-1"
                                                           title="Lock" @onclick="() => Lock(b)">
                                                    <i class="ti ti-lock"></i>
                                                </a>
                                            }

                                                @if (b.IsLocked && !b.IsArchived)
                                                {
                                                    <a class="me-2 p-1 action-icon archive"
                                                           href="javascript:void(0);"
                                                           title="Archive Category"
                                                           data-bs-toggle="modal"
                                                           data-bs-target="#archive-modal"
                                                           @onclick="() => ArchivePopupOpen(b)">
                                                        <i class="ti ti-archive"></i>
                                                    </a>
                                                }

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center py-4">
                                        <div class="text-muted">
                                            <i class="ti ti-file-off fs-1"></i>
                                            <p class="mt-2">No budgets found</p>
                                        </div>
                                    </td>
                                </tr>
                        }

                    </tbody>

                </table>

                <!-- PAGINATION -->
                    @if (PagedBudgets.Any())
                    {
                        <!-- Pagination -->
                        <div class="d-flex justify-content-between align-items-center p-3">

                            <div class="d-flex align-items-center fs-13">
                                <span class="me-2">Rows Per Page</span>
                                <select class="form-select form-select-sm w-auto"
                                        @onchange="OnPageSizeChange">
                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                </select>
                                <span class="ms-2">Entries</span>
                            </div>

                            <nav>
                                <ul class="pagination pagination-sm mb-0">

                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                               @onclick="PreviousPage"
                                               @onclick:preventDefault>
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>

                                    @foreach (var pageNumber in VisiblePages)
                                    {
                                        <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                            <button class="page-link"
                                                    @onclick="() => GoToPage(pageNumber)">
                                                @pageNumber
                                            </button>
                                        </li>
                                    }

                                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                               @onclick="NextPage"
                                               @onclick:preventDefault>
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>

                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>

        </div>

    </div>


    <!-- ROW DETAILS MODAL -->
    <div class="modal fade" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="ti ti-wallet me-2"></i>
                        Budget Details
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal" style="    padding: 0;
        transform: none;
        right: 21px;
        top: 19px;">
                    </button>
                </div>

                <div class="modal-body">

                    @if (SelectedBudget != null)
                    {
                        <div class="row g-3">

                            <!-- Budget Code -->
                            <div class="col-md-6">
                                <div class="detail-box">
                                    <span class="label">Budget Code: </span>
                                    <span class="value">@SelectedBudget.BudgetCode</span>
                                </div>
                            </div>

                            <!-- Budget Name -->
                            <div class="col-md-6">
                                <div class="detail-box">
                                    <span class="label">Budget Name: </span>
                                    <span class="value">@SelectedBudget.BudgetName</span>
                                </div>
                            </div>

                            <!-- Budget Type -->
                            <div class="col-md-6">
                                <div class="detail-box">
                                    <span class="label">Budget Type: </span>
                                    <span class="value">@SelectedBudget.BudgetType</span>
                                </div>
                            </div>

                            <!-- Planning Level -->
                            <div class="col-md-6">
                                <div class="detail-box">
                                    <span class="label">Planning Level: </span>
                                    <span class="value">@SelectedBudget.PlanningLevel</span>
                                </div>
                            </div>

                            <!-- Period -->
                            <div class="col-md-6">
                                <div class="detail-box">
                                    <span class="label">Period: </span>
                                    <span class="value">
                                        @SelectedBudget.StartDate?.ToString("dd MMM yyyy")
                                        -
                                        @SelectedBudget.EndDate?.ToString("dd MMM yyyy")
                                    </span>
                                </div>
                            </div>

                            <!-- Fiscal Year -->
                            <div class="col-md-6">
                                <div class="detail-box">
                                    <span class="label">Fiscal Year: </span>
                                    <span class="value">@SelectedBudget.FiscalYearId</span>
                                </div>
                            </div>

                            <!-- Amount -->
                            <div class="col-md-4">
                                <div class="detail-box">
                                    <span class="label">Total Amount: </span>
                                    <span class="value">
                                        ₹@SelectedBudget.TotalBudgetAmount.ToString("N2")
                                    </span>
                                </div>
                            </div>

                            <!-- Consumed -->
                            <div class="col-md-4">
                                <div class="detail-box">
                                    <span class="label">Consumed: </span>
                                    <span class="value">
                                        ₹@SelectedBudget.ConsumedActualAmount.ToString("N2")
                                    </span>
                                </div>
                            </div>

                            <!-- Available -->
                            <div class="col-md-4">
                                <div class="detail-box">
                                    <span class="label">Available: </span>
                                    <span class="value">
                                        ₹@SelectedBudget.AvailableBalanceAmount.ToString("N2")
                                    </span>
                                </div>
                            </div>

                            <!-- Owner -->
                            <div class="col-md-6">
                                <div class="detail-box">
                                    <span class="label">Owner: </span>
                                    <span class="value">@SelectedBudget.BudgetOwnerUserId</span>
                                </div>
                            </div>

                            <!-- Currency -->
                            <div class="col-md-6">
                                <div class="detail-box">
                                    <span class="label">Currency: </span>
                                    <span class="value">@SelectedBudget.CurrencyId</span>
                                </div>
                            </div>

                            <!-- Status -->
                            <div class="col-md-12">
                                <div class="detail-box">
                                    <span class="label">Status: </span>

                                    <span class="badge @GetStatusBadge(SelectedBudget.Status)">
                                        @SelectedBudget.Status
                                    </span>
                                </div>
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>
    </div>

    <!-- ═══ ✅ ARCHIVE MODAL ═══ -->
    <div class="modal fade" id="archive-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 mb-2"
                              style="background:#ede9fe;">
                            <i class="ti ti-archive fs-24" style="color:#6366f1;"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Archive Budget</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Archive <strong>@SelectedBudget?.BudgetName</strong>?
                            Archived Budget cannot be used.
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button"
                                    class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4"
                                    data-bs-dismiss="modal">
                                <i class="ti ti-x me-1"></i>Cancel
                            </button>
                            <button type="button"
                                    class="btn fs-13 fw-medium p-2 px-4"
                                    style="background:#6366f1;color:white;"
                                    @onclick="ConfirmArchive"
                                    data-bs-dismiss="modal">
                                <i class="ti ti-archive me-1"></i>Yes, Archive
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}