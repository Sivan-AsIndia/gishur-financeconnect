@page "/cost-allocations"
@using static FinanceConnect.Client.ViewModels.CostAllocationViewModel

<style>
    @@media(max-width:635px) {
        .responsivefilter {
            flex-wrap: wrap;
        }
    }

    .modal .btn-close::before{
        background:white
    }
</style>

<div class="content List-view">
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Cost Allocation List</h4>
                <h6>Manage Shared Cost & Overhead Distributions</h6>
            </div>
        </div>
        <ul class="table-top-head me-2">
            <li><a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync"><i class="ti ti-refresh"></i></a></li>
        </ul>
        <div class="page-btn">
            <a href="/cost-allocations/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i> Create
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                    <input type="search" class="form-control form-control-sm"
                           placeholder="Search code, name..."
                           @bind="searchText" @oninput="OnSearch" />
                </div>
            </div>
            <div style="display:flex; gap:15px;" class="responsivefilter">
                <select class="form-select form-select-sm" style="min-width:175px"
                        @bind="SelectedStatus" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Status</option>
                    @foreach (var s in Enum.GetValues<AllocationStatus>())
                    {
                        <option value="@((int)s)">@s</option>
                    }
                </select>
                <select class="form-select form-select-sm" style="min-width:200px"
                        @bind="SelectedType" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Types</option>
                    @foreach (var t in Enum.GetValues<AllocationType>())
                    {
                        <option value="@((int)t)">@t</option>
                    }
                </select>
                <select class="form-select form-select-sm" style="min-width:190px"
                        @bind="SelectedMethod" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Methods</option>
                    @foreach (var m in Enum.GetValues<AllocationMethod>())
                    {
                        <option value="@((int)m)">@m</option>
                    }
                </select>
            </div>
        </div>

        <div class="card-body p-0">
            <table class="table align-middle w-100 table-fixed">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xxl-none" style="width:40px"></th>
                        @* <th>Allocation Code</th> *@
                        <th style="width: 321px;">Allocation Name</th>
                        @* <th class="d-none d-md-table-cell">Type</th> *@
                        <th class="d-none d-md-table-cell">Method</th>
                        <th class="d-none d-xl-table-cell">Source Amount</th>
                        <th class="d-none d-xxl-table-cell">Allocated</th>
                        <th class="d-none d-xxl-table-cell">Date</th>
                        <th class="d-none d-xl-table-cell">Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedItems.Any())
                    {
                        @foreach (var a in PagedItems)
                        {
                            <tr>
                                <td class="d-xxl-none text-center" style="padding:0;padding-left:15px;">
                                    <a href="javascript:void(0);" class="TablePlus"
                                       data-bs-toggle="modal" data-bs-target="#rowDetailsModal"
                                       @onclick="() => SelectedItem = a">
                                        <i class="ti ti-plus"></i>
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-medium">
                                        <i class="ti ti-external-link me-2 PopupIcon"></i>
                                        <a href="/cost-allocations/@a.CostAllocationId/view"
                                           class="link-View text-decoration-none" data-bs-toggle="tooltip"
                                           data-bs-placement="top"
                                           title="@a.AllocationCode details">@a.AllocationName</a>
                                    </span>
                                    @if (a.IsLocked)
                                    {
                                        <span class="badge bg-danger-transparent ms-1">
                                            <i class="ti ti-lock me-1" style="font-size:10px;"></i>Locked
                                        </span>
                                    }
                                    @if (!a.IsFullyAllocated)
                                    {
                                        <span class="badge bg-warning-transparent ms-1">Partial</span>
                                    }
                                </td>
                                @* <td>@a.AllocationName</td> *@
                                @* <td class="d-none d-md-table-cell">
                                    <span class="badge bg-info-transparent">@a.AllocationType</span>
                                </td> *@
                                <td class="d-none d-md-table-cell">@a.AllocationMethod</td>
                                <td class="d-none d-xl-table-cell">@a.SourceAmount.ToString("N0")</td>
                                <td class="d-none d-xxl-table-cell">
                                    @a.TotalAllocatedAmount.ToString("N0")
                                    <small class="text-muted ms-1">(@a.TotalTargetCount tgts)</small>
                                </td>
                                <td class="d-none d-xxl-table-cell">
                                    @a.AllocationDate.ToString("dd MMM yyyy")
                                </td>
                                <td class="d-none d-xl-table-cell">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="ActiveDot @GetStatusDot(a.AllocationStatus)"></div>
                                        <span>@a.AllocationStatus</span>
                                    </div>
                                </td>
                                <td class="action-table-data">
                                    <div class="edit-delete-action">
                                        @if (!a.IsLocked && a.AllocationStatus == AllocationStatus.Draft)
                                        {
                                            <a class="me-2 p-1 edit-icon"
                                               href="/cost-allocations/edit/@a.CostAllocationId"
                                               title="Edit">
                                                <i data-feather="edit"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="me-2 p-1 text-muted"
                                               style="cursor:not-allowed;opacity:0.4;" title="Locked">
                                                <i data-feather="edit"></i>
                                            </a>
                                        }
                                        @if (!a.IsLocked && a.AllocationStatus == AllocationStatus.Draft)
                                        {
                                            <a class="me-2 p-1 action-icon" href="javascript:void(0);"
                                               title="Delete"
                                               data-bs-toggle="modal" data-bs-target="#delete-modal"
                                               @onclick="() => SelectedItem = a">
                                                <i data-feather="trash-2"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                No cost allocations found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (PagedItems.Any())
            {
                <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                    <div class="d-flex align-items-center">
                        <span class="me-2">Rows per page:</span>
                        <select class="form-select form-select-sm" style="width:auto" @onchange="OnPageSizeChange">
                            <option value="5" selected="@(PageSize == 5)">5</option>
                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                        <span class="ms-3 text-muted">Entries</span>
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                    <i class="ti ti-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = StartPage; i <= EndPage; i++)
                            {
                                int pageNum = i;
                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                    <i class="ti ti-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>

    </div>
</div>



<!-- Delete Modal -->
<div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                        <i class="ti ti-trash fs-24 text-danger"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Cost Allocation?</h4>
                    <p class="text-muted">
                        Are you sure you want to delete <strong>@SelectedItem?.AllocationCode</strong>?
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal">
                            <i class="ti ti-x"></i> Cancel
                        </button>
                        <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"
                                @onclick="() => ConfirmDelete(SelectedItem!.CostAllocationId)">
                            <i class="ti ti-trash"></i> Yes, Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- ROW DETAILS MODAL -->
<div class="modal fade" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Allocation Details</h5>
                <button class="btn-close" data-bs-dismiss="modal" style="padding: 0;
    right: 22px;
    position: absolute;
    transform: none;"></button>
            </div>
            <div class="modal-body p-0">
                @if (SelectedItem != null)
                {

                    <div class="modal-body">
                        <div class="mb-2 d-flex gap-3">
                            <strong>Code:</strong>
                            <div> @SelectedItem.AllocationCode</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Name:</strong>
                            <div>@SelectedItem.AllocationName</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Type:</strong>
                            <div>@SelectedItem.AllocationType</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Method:</strong>
                            <div>@SelectedItem.AllocationMethod</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Source Amount:</strong>
                            <div>@SelectedItem.SourceAmount.ToString("N2")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Targets:</strong>
                            <div>@SelectedItem.TotalTargetCount</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Targets:</strong>
                            <div>@SelectedItem.TotalTargetCount</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Status:</strong>
                            <div>@SelectedItem.AllocationStatus</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Fully Allocated:</strong>
                            <div>@(SelectedItem.IsFullyAllocated ? "Yes" : "No")</div>
                        </div>
                        <div class="mb-2 gap-3 d-md-none">
                            <strong>Total Allocated:</strong>
                            <div>@SelectedItem.TotalAllocatedAmount.ToString("N2")</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
