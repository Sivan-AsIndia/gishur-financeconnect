@page "/account-groups/create"
@page "/account-groups/{Id:guid}"
@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services

<style>
    .form-select option:checked {
        color: white;
        background-color: var(--primary);
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }

    .form-select.is-invalid {
        border-color: #dc3545;
    }

    .field-validation-error {
        color: #dc3545;
        font-size: 12px;
        display: block;
        margin-top: 4px;
    }
</style>

@if (isLoading)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else
{
    <div class="content Accordion-form">

        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">@PageTitle</h4>
                    <h6>@PageSubTitle</h6>
                </div>
            </div>

            <div class="page-btn mt-0">
                <a href="/account-groups" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <EditForm Model="@Model" OnSubmit="@HandleSubmit">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="ti ti-alert-circle me-2"></i>@errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            <div class="add-product" style="background:#f4f7fb; padding:24px 14px;">
                <div class="tl-accordion">

                    <!--  LEFT PANEL  -->
                    <div class="tl-left-panel">

                        <!-- Identity -->
                        <div class="tl-label @(ShowIdentity ? "active accent-orange" : "")"
                             @onclick="@(() => ToggleAccordion("identity"))">
                            <div class="tl-label-icon ico-orange"><i data-feather="folder"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Group Identity</div>
                                <div class="tl-label-sub">Basic group identification</div>
                            </div>
                            <span class="tl-label-chevron @(ShowIdentity ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <!-- Classification -->
                        <div class="tl-label @(ShowClassification ? "active accent-blue" : "")"
                             @onclick="@(() => ToggleAccordion("classification"))">
                            <div class="tl-label-icon ico-blue"><i data-feather="tag"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Classification</div>
                                <div class="tl-label-sub">Nature and statement type</div>
                            </div>
                            <span class="tl-label-chevron @(ShowClassification ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <!--Default Behavior -->
                        <div class="tl-label @(ShowDefaultBehavior ? "active accent-purple" : "")"
                             @onclick="@(() => ToggleAccordion("defaultBehavior"))">
                            <div class="tl-label-icon ico-purple"><i data-feather="settings"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Default Behavior</div>
                                <div class="tl-label-sub">Default account settings</div>
                            </div>
                            <span class="tl-label-chevron @(ShowDefaultBehavior ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <!-- Status -->
                        <div class="tl-label @(ShowStatus ? "active accent-teal" : "")"
                             @onclick="@(() => ToggleAccordion("status"))">
                            <div class="tl-label-icon ico-teal"><i data-feather="check-circle"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Status</div>
                                <div class="tl-label-sub">Group lifecycle status</div>
                            </div>
                            <span class="tl-label-chevron @(ShowStatus ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                    </div>


                    <!--  RIGHT TIMELINE -->
                    <div class="tl-right-area">

                        <!-- GROUP IDENTITY -->
                        <div class="tl-card-row @(ShowIdentity ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("identity"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowIdentity ? "card-active border-orange" : "")">

                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("identity"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-orange">01</span>
                                            Group Identity
                                        </div>
                                        <span class="tl-card-toggle @(ShowIdentity ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>

                                    <div class="tl-collapse @(ShowIdentity ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(IdentityTouched ? "touched" : "")">

                                                <div class="row">

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Group Code <span class="text-danger ms-1">*</span></label>
                                                        <InputText class=@($"form-control text-uppercase {(codeError != null ? "is-invalid" : "")}")
                                                                   @bind-Value="CodeWrapper"
                                                                   @bind-Value:after="OnCodeChanged"
                                                                   disabled="@(IsEditMode)"
                                                                   placeholder="e.g., AST"
                                                                   maxlength="20" />
                                                        @if (codeError != null)
                                                        {
                                                            <span class="field-validation-error">@codeError</span>
                                                        }
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Group Name <span class="text-danger ms-1">*</span></label>
                                                        <InputText class=@($"form-control {(nameError != null ? "is-invalid" : "")}")
                                                                   @bind-Value="NameWrapper"
                                                                   @bind-Value:after="OnNameChanged"
                                                                   placeholder="Enter group name"
                                                                   maxlength="200" />
                                                        @if (nameError != null)
                                                        {
                                                            <span class="field-validation-error">@nameError</span>
                                                        }
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Chart of Accounts <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select @(chartError != null ? "is-invalid" : "")"
                                                                value="@ChartIdWrapper"
                                                                @onchange="OnChartChanged"
                                                                disabled="@(IsEditMode && hasAccounts)">
                                                            <option value="">--Select Chart of Accounts--</option>
                                                            @foreach (var chart in ChartOfAccountsList)
                                                            {
                                                                <option value="@chart.Id">@chart.ChartName</option>
                                                            }
                                                        </select>
                                                        @if (chartError != null)
                                                        {
                                                            <span class="field-validation-error">@chartError</span>
                                                        }
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Parent Group</label>
                                                        <select class="form-select"
                                                                value="@ParentIdWrapper"
                                                                @onchange="OnParentChanged"
                                                                disabled="@(Model.ChartOfAccountsId == Guid.Empty)">
                                                            <option value="">-- None (Top Level) --</option>
                                                            @foreach (var group in ParentGroups)
                                                            {
                                                                <option value="@group.Id">@group.GroupName (@group.AccountNature)</option>
                                                            }
                                                        </select>
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Display Order</label>
                                                        <InputNumber class="form-control"
                                                                     @bind-Value="Model.DisplayOrder"
                                                                     placeholder="0"
                                                                     min="0" />
                                                    </div>
                                                    @* maxlength="500" *@

                                                    <div class="col-12 mb-3">
                                                        <label class="form-label">Description</label>
                                                        <RichTextEditor @ref="_descriptionEditor"
                                                                        Value="@Model.Description"
                                                                        MaxHeight="200" MinHeight="80"
                                                                        placeholder="Group description (optional)" />
                                                    </div>

                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--  CLASSIFICATION -->
                        <div class="tl-card-row @(ShowClassification ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("classification"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowClassification ? "card-active border-blue" : "")">

                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("classification"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-blue">02</span>
                                            Classification
                                        </div>
                                        <span class="tl-card-toggle @(ShowClassification ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>

                                    <div class="tl-collapse @(ShowClassification ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(ClassificationTouched ? "touched" : "")">

                                                <div class="row">

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Account Nature <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select @(natureError != null ? "is-invalid" : "")"
                                                                value="@Model.AccountNature"
                                                                @onchange="OnNatureChanged"
                                                                disabled="@(IsEditMode && hasAccounts)">
                                                            <option value="">--Select Account Nature--</option>
                                                            @foreach (var nature in AccountNatures.All)
                                                            {
                                                                <option value="@nature">@nature</option>
                                                            }
                                                        </select>
                                                        @if (natureError != null)
                                                        {
                                                            <span class="field-validation-error">@natureError</span>
                                                        }
                                                        @if (IsEditMode && hasAccounts)
                                                        {
                                                            <small class="text-muted">Cannot change - group has accounts</small>
                                                        }
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Statement Type</label>
                                                        <input type="text"
                                                               class="form-control bg-light"
                                                               value="@GetStatementType()"
                                                               readonly />
                                                        <small class="text-muted">Auto-determined from Account Nature</small>
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Normal Balance Type <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select @(balanceBehaviorError != null ? "is-invalid" : "")"
                                                                value="@Model.BalanceBehavior"
                                                                @onchange="OnBalanceBehaviorChanged">
                                                            <option value="">--Select Normal Balance Type--</option>
                                                            @foreach (var behavior in BalanceBehaviors.All)
                                                            {
                                                                <option value="@behavior">@behavior</option>
                                                            }
                                                        </select>
                                                        @if (balanceBehaviorError != null)
                                                        {
                                                            <span class="field-validation-error">@balanceBehaviorError</span>
                                                        }
                                                        <small class="text-muted">Auto-set from Nature; override for rare cases</small>
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <div class="form-check form-switch mt-3">
                                                            <InputCheckbox class="form-check-input"
                                                                           id="isControlGroup"
                                                                           @bind-Value="Model.IsControlGroup" />
                                                            <label class="form-check-label" for="isControlGroup">
                                                                <strong>Control Group (Subledger Controlled)</strong>
                                                                <br />
                                                                <small class="text-muted">
                                                                    Accounts controlled by subledger modules (e.g., AR/AP)
                                                                </small>
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Reporting Category</label>
                                                        <select class="form-select"
                                                                value="@(Model.ReportingCategory ?? "")"
                                                                @onchange="OnReportingCategoryChanged">
                                                            <option value="">-- None --</option>
                                                            @foreach (var cat in ReportingCategories.All)
                                                            {
                                                                <option value="@cat">
                                                                    @ReportingCategories.GetDisplayName(cat)
                                                                </option>
                                                            }
                                                        </select>
                                                        <small class="text-muted">P&L presentation grouping</small>
                                                    </div>

                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- DEFAULT BEHAVIOR -->
                        <div class="tl-card-row @(ShowDefaultBehavior ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("defaultBehavior"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowDefaultBehavior ? "card-active border-purple" : "")">

                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("defaultBehavior"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-purple">03</span>
                                            Default Behavior
                                        </div>
                                        <span class="tl-card-toggle @(ShowDefaultBehavior ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>

                                    <div class="tl-collapse @(ShowDefaultBehavior ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(DefaultBehaviorTouched ? "touched" : "")">

                                                <div class="row">

                                                    <div class="col-md-3 mb-3">
                                                        <div class="form-check form-switch">
                                                            <InputCheckbox class="form-check-input"
                                                                           id="defaultPostable"
                                                                           @bind-Value="Model.DefaultIsPostable" />
                                                            <label class="form-check-label" for="defaultPostable">
                                                                <strong>Default Postable</strong><br />
                                                                <small class="text-muted">
                                                                    New accounts can receive transactions
                                                                </small>
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 mb-3">
                                                        <div class="form-check form-switch">
                                                            <InputCheckbox class="form-check-input"
                                                                           id="defaultRequiresBranch"
                                                                           @bind-Value="Model.DefaultRequiresBranch" />
                                                            <label class="form-check-label" for="defaultRequiresBranch">
                                                                <strong>Default Requires Branch</strong><br />
                                                                <small class="text-muted">
                                                                    Branch mandatory for posting
                                                                </small>
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 mb-3">
                                                        <div class="form-check form-switch">
                                                            <InputCheckbox class="form-check-input"
                                                                           id="defaultRequiresCostCenter"
                                                                           @bind-Value="Model.DefaultRequiresCostCenter" />
                                                            <label class="form-check-label" for="defaultRequiresCostCenter">
                                                                <strong>Default Cost Center Required</strong><br />
                                                                <small class="text-muted">
                                                                    Cost center tracking enforcement
                                                                </small>
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 mb-3">
                                                        <div class="form-check form-switch">
                                                            <InputCheckbox class="form-check-input"
                                                                           id="defaultAllowManual"
                                                                           @bind-Value="Model.DefaultAllowManualJournal" />
                                                            <label class="form-check-label" for="defaultAllowManual">
                                                                <strong>Allow Manual Journal</strong><br />
                                                                <small class="text-muted">
                                                                    Allow manual journal entries
                                                                </small>
                                                            </label>
                                                        </div>
                                                    </div>

                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- STATUS -->
                        <div class="tl-card-row @(ShowStatus ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("status"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowStatus ? "card-active border-teal" : "")">

                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("status"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-teal">04</span>
                                            Status
                                        </div>
                                        <span class="tl-card-toggle @(ShowStatus ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>

                                    <div class="tl-collapse @(ShowStatus ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(StatusTouched ? "touched" : "")">

                                                <div class="row">

                                                    <div class="col-sm-6 col-md-3 mb-3">
                                                        <label class="form-label">Status <span class="text-danger ms-1">*</span></label>
                                                        <InputSelect class=@($"form-select {(statusError != null ? "is-invalid" : "")}")
                                                                     @bind-Value="Model.Status"
                                                                     @bind-Value:after="OnStatusChanged2">
                                                            <option value="">--Select Status--</option>
                                                            @foreach (var status in GroupStatuses.All)
                                                            {
                                                                <option value="@status">@status</option>
                                                            }
                                                        </InputSelect>
                                                        @if (statusError != null)
                                                        {
                                                            <span class="field-validation-error">@statusError</span>
                                                        }
                                                    </div>

                                                    @if (Model.Status == GroupStatuses.Inactive)
                                                    {
                                                        <div class="col-sm-6 col-md-6 mb-3">
                                                            <label class="form-label">
                                                                Inactivation Reason
                                                                <span class="text-danger ms-1">*</span>
                                                            </label>
                                                            <textarea class="form-control @(lockReasonError != null ? "is-invalid" : "")"
                                                                      @bind="Model.LockReason"
                                                                      @bind:event="oninput"
                                                                      @bind:after="OnLockReasonChanged"
                                                                      rows="2"
                                                                      placeholder="Reason for inactivation..."
                                                                      maxlength="300"></textarea>
                                                            @if (lockReasonError != null)
                                                            {
                                                                <span class="field-validation-error">@lockReasonError</span>
                                                            }
                                                        </div>
                                                    }

                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            <div class="d-flex justify-content-end mb-4">
                <a href="/account-groups" class="btn btn-outline-secondary me-2"><i class="ti ti-x"></i> Cancel</a>
                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="ti ti-device-floppy"></i> @(IsEditMode ? "Update" : "Save")
                </button>
            </div>

        </EditForm>

    </div>
}
