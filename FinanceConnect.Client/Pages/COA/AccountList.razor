@page "/gl-accounts"

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">GL Accounts</h4>
                    <h6>Manage GL accounts</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/gl-accounts/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Account List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search accounts..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display:flex;flex-wrap:wrap;gap:10px">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 220px" @bind="SelectedChartId">
                            <option value="">All Charts</option>
                            @foreach (var chart in Accounts.Where(a => a.ChartOfAccountsId.HasValue).Select(a => new { a.ChartOfAccountsId, a.ChartOfAccountsCode, a.ChartOfAccountsName }).DistinctBy(c => c.ChartOfAccountsId).OrderBy(c => c.ChartOfAccountsCode))
                            {
                                <option value="@chart.ChartOfAccountsId">@chart.ChartOfAccountsCode - @chart.ChartOfAccountsName</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedGroupId">
                            <option value="">All Groups</option>
                            @{
                                var groupSource = string.IsNullOrEmpty(_selectedChartId) || !Guid.TryParse(_selectedChartId, out var filterChartId)
                                    ? Accounts
                                    : Accounts.Where(a => a.ChartOfAccountsId == filterChartId);
                            }
                            @foreach (var group in groupSource.Where(a => a.AccountGroupId != Guid.Empty).Select(a => new { a.AccountGroupId, a.AccountGroupCode, a.AccountGroupName }).DistinctBy(g => g.AccountGroupId).OrderBy(g => g.AccountGroupCode))
                            {
                                <option value="@group.AccountGroupId">@group.AccountGroupCode - @group.AccountGroupName</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 120px" @bind="SelectedNature">
                            <option value="">All Natures</option>
                            @foreach (var nature in Accounts.Select(a => a.AccountNature).Where(n => !string.IsNullOrEmpty(n)).Distinct().OrderBy(n => n))
                            {
                                <option value="@nature">@nature</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 110px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in Accounts.Select(a => a.Status).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s))
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th class="td-width">Code</th>
                                <th class="d-none d-md-table-cell">Name</th>
                                <th class="d-none d-lg-table-cell">Group</th>
                                <th class="d-none d-md-table-cell">Nature</th>
                                @* <th class="d-none d-xxl-table-cell">Postable</th> *@
                                @* <th class="d-none d-xxl-table-cell">Bank</th> *@
                                @* <th class="d-none d-xxl-table-cell">Cash</th> *@
                                <th class="d-none d-xl-table-cell">Status</th>
                                <th class="no-sort" style="width:115px">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedAccounts.Any())
                            {
                                @foreach (var account in PagedAccounts)
                                {
                                    <tr>
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(account)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td>
                                            <span class="fw-medium">
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a @onclick="async () => await ViewAccount(account)" class="text-decoration-none link-View"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title="@account.AccountCode Details">
                                                    @account.AccountCode
                                                </a>
                                            </span>
                                        </td>
                                        <td class="d-none d-md-table-cell" title="@account.AccountName">

                                           <div class="d-flex flex-column gap-1">
                                                <span>@account.AccountName</span>
                                            <span  data-bs-toggle="tooltip"
                                                      data-bs-placement="top" title="Postable">
                                                @if (account.IsPostable)
                                            {
                                                <span class="badge bg-success-transparent text-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-transparent text-secondary">No</span>
                                            }</span>
                                           </div>
                                            
                                            </td>
                                        <td class="d-none d-lg-table-cell" >@(account.AccountGroupName ?? "-")</td>
                                        <td class="d-none d-md-table-cell">
                                            <span class="badge @GetNatureBadgeClass(account.AccountNature)">
                                                @account.AccountNature
                                            </span>
                                        </td>
                                        @* <td class="d-none d-xxl-table-cell">
                                            @if (account.IsPostable)
                                            {
                                                <span class="badge bg-success-transparent text-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-transparent text-secondary">No</span>
                                            }
                                        </td> *@
                                        @* <td class="d-none d-xxl-table-cell">
                                            @if (account.IsBankAccount)
                                            {
                                                <span class="badge bg-info-transparent text-info">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-transparent text-secondary">No</span>
                                            }
                                        </td>
                                        <td class="d-none d-xxl-table-cell">
                                            @if (account.IsCashAccount)
                                            {
                                                <span class="badge bg-info-transparent text-info">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-transparent text-secondary">No</span>
                                            }
                                        </td> *@
                                        @* <td class="d-none d-xl-table-cell">
                                            <span class="badge @GetStatusBadgeClass(account.Status)">
                                                @account.Status
                                            </span>
                                        </td> *@

                                        <td class="d-none d-xl-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @GetStatusDotBadgeClass(account.Status)">
                                                </div>
                                                <span> @account.Status</span>
                                            </div>
                                        </td>
                                        <td class="action-table-data">
                                            <div class="edit-delete-action">
                                                @* <a class="me-2 view-icon p-1" href="javascript:void(0);" title="View"
                                                   @onclick="async () => await ViewAccount(account)">
                                                    <i data-feather="eye"></i>
                                                </a> *@
                                                <a class="me-2 edit-icon p-1" href="/gl-accounts/@account.Id" title="Edit">
                                                    <i data-feather="edit"></i>
                                                </a>
                                                @if (account.Status == AccountStatuses.Active)
                                                {
                                                    <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon" href="javascript:void(0);"
                                                       title="Deactivate" data-bs-toggle="modal" data-bs-target="#deactivate-modal"
                                                       @onclick="() => ConfirmDeactivate(account)">
                                                        <i class="ti ti-toggle-right"></i>
                                                    </a>
                                                }
                                                else if (account.Status == AccountStatuses.Inactive || account.Status == AccountStatuses.Suspended)
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Activate" data-bs-toggle="modal" data-bs-target="#activate-modal"
                                                       @onclick="() => ConfirmActivate(account)">
                                                        <i class="ti ti-toggle-left"></i>
                                                    </a>
                                                }
                                                <a class="p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                                   data-bs-toggle="modal" data-bs-target="#delete-modal"
                                                   @onclick="() => ConfirmDelete(account)">
                                                    <i data-feather="trash-2"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center text-muted py-4">No accounts found</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center p-3">
                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto" @bind="RowsPerPage">
                                <option value="5">5</option>
                                <option value="10">10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = StartPage; i <= EndPage; i++)
                                {
                                    var pageNum = i;
                                    <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNum)">
                                            @pageNum
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row Details Modal (for mobile) -->
        <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Account Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                style="padding:0; right:22px; position:absolute;transform:none"></button>
                    </div>
                    @if (SelectedAccount != null)
                    {
                        <div class="modal-body">
                            <div class="mb-2 d-flex gap-3">
                                <strong>Code:</strong>
                                <div>@SelectedAccount.AccountCode</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Name:</strong>
                                <div>@SelectedAccount.AccountName</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Group:</strong>
                                <div>@(SelectedAccount.AccountGroupName ?? "-")</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Nature:</strong>
                                <div>
                                    <span class="badge @GetNatureBadgeClass(SelectedAccount.AccountNature)">@SelectedAccount.AccountNature</span>
                                </div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Postable:</strong>
                                <div>
                                    @if (SelectedAccount.IsPostable)
                                    {
                                        <span class="badge bg-success-transparent text-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-transparent text-secondary">No</span>
                                    }
                                </div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Bank Account:</strong>
                                <div>
                                    @if (SelectedAccount.IsBankAccount)
                                    {
                                        <span class="badge bg-info-transparent text-info">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-transparent text-secondary">No</span>
                                    }
                                </div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Cash Account:</strong>
                                <div>
                                    @if (SelectedAccount.IsCashAccount)
                                    {
                                        <span class="badge bg-info-transparent text-info">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-transparent text-secondary">No</span>
                                    }
                                </div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Status:</strong>
                                <div>
                                    <span class="badge @GetStatusBadgeClass(SelectedAccount.Status)">@SelectedAccount.Status</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Activate Modal -->
        <div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-toggle-right fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Account</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to activate <strong>@SelectedAccount?.AccountName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateAccount" data-bs-dismiss="modal"><i class="ti ti-toggle-right me-1"></i>Yes, Activate</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deactivate Modal -->
        <div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                                <i class="ti ti-toggle-left fs-24 text-warning"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate Account</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to deactivate <strong>@SelectedAccount?.AccountName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateAccount" data-bs-dismiss="modal"><i class="ti ti-toggle-left me-1"></i>Yes, Deactivate</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                <i class="ti ti-trash fs-24 text-danger"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Account</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!CanDeleteAccount)
                                {
                                    <span class="text-danger">Cannot delete! Account has transactions or is currently active.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to delete <strong>@SelectedAccount?.AccountName</strong>?</span>
                                }
                            </p>
                            @if (CanDeleteAccount)
                            {
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                            }
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (CanDeleteAccount)
                                {
                                    <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteAccount" data-bs-dismiss="modal"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

}
