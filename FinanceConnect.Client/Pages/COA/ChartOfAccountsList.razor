@page "/chart-of-accounts"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject COADataService COADataService
@inject ToastService ToastService

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Chart of Accounts</h4>
                    <h6>Manage charts of accounts</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/chart-of-accounts/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Chart List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search charts..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display:flex;flex-wrap:wrap;gap:10px">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 280px" @bind="SelectedCompanyId">
                            <option value="">All Companies</option>
                            @foreach (var company in Charts.Where(c => c.CompanyId.HasValue).Select(c => new { c.CompanyId, c.CompanyCode, c.CompanyName }).DistinctBy(c => c.CompanyId))
                            {
                                <option value="@company.CompanyId">@company.CompanyCode - @company.CompanyName</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedType">
                            <option value="">All Types</option>
                            @foreach (var type in Charts.Select(c => c.ChartType).Where(t => !string.IsNullOrEmpty(t)).Distinct().OrderBy(t => t))
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 120px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in Charts.Select(c => c.Status).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s))
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th style="width: 250px;">Code</th>
                                <th class="d-none d-md-table-cell">Name</th>
                                <th class="d-none d-md-table-cell">Company</th>
                                <th class="d-none d-xxl-table-cell" style="width: 100px;">Type</th>
                                @* <th class="d-none d-xl-table-cell">Default</th> *@
                                @* <th class="d-none d-xxl-table-cell">Groups</th> *@
                                <th class="d-none d-xl-table-cell" style="width: 115px;">Status</th>
                                <th class="no-sort" style="width: 115px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedCharts.Any())
                            {
                                @foreach (var chart in PagedCharts)
                                {
                                    <tr>
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(chart)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td>
                                            <span class="fw-medium">
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a @onclick="async () => await ViewChart(chart)" class="text-decoration-none link-View"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title="@chart.ChartCode Details">
                                                    @chart.ChartCode
                                                </a>
                                            </span>
                                        </td>
                                        <td class="d-none d-md-table-cell">
                                           <div class="d-flex flex-column gap-1">
                                                <span style="color: black;">@chart.ChartName</span>
                                                <span  data-bs-toggle="tooltip"
                                                      data-bs-placement="top" title="Default For Company">
                                                    @if (chart.IsDefaultForCompany)
                                                    {
                                                        <span class="badge bg-success-transparent text-success">Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-transparent text-secondary">No</span>
                                                    }
                                                </span>
                                           </div>
                                        </td>
                                        <td class="d-none d-md-table-cell">@(chart.CompanyName ?? "-")</td>
                                        <td class="d-none d-xxl-table-cell">
                                            <span class="badge @GetTypeBadgeClass(chart.ChartType)">
                                                @chart.ChartType
                                            </span>
                                        </td>
                                      
                                        @* <td class="d-none d-xxl-table-cell">@chart.AccountGroupCount</td> *@
                                        @* <td class="d-none d-xl-table-cell">
                                            <span class="badge @GetStatusBadgeClass(chart.Status)">
                                                @chart.Status
                                            </span>
                                        </td> *@
                                        <td class="d-none d-xl-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @GetStatusDotBadgeClass(chart.Status)">
                                                </div>
                                                <span> @chart.Status</span>
                                            </div>
                                        </td>
                                        <td class="action-table-data">
                                            <div class="edit-delete-action">
                                                @* <a class="me-2 view-icon p-1" href="javascript:void(0);" title="View"
                                                   @onclick="async () => await ViewChart(chart)">
                                                    <i data-feather="eye"></i>
                                                </a> *@
                                                <a class="me-2 edit-icon p-1" href="/chart-of-accounts/@chart.Id" title="Edit">
                                                    <i data-feather="edit"></i>
                                                </a>
                                                @if (chart.Status == COAStatuses.Active)
                                                {
                                                    <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon" href="javascript:void(0);"
                                                       title="Lock" data-bs-toggle="modal" data-bs-target="#lock-modal"
                                                       @onclick="() => ConfirmLock(chart)">
                                                        <i class="ti ti-lock"></i>
                                                    </a>
                                                }
                                                else if (chart.Status == COAStatuses.Locked)
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Unlock" data-bs-toggle="modal" data-bs-target="#unlock-modal"
                                                       @onclick="() => ConfirmUnlock(chart)">
                                                        <i class="ti ti-lock-open"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Activate" data-bs-toggle="modal" data-bs-target="#activate-modal"
                                                       @onclick="() => ConfirmActivate(chart)">
                                                        <i class="ti ti-toggle-left"></i>
                                                    </a>
                                                }
                                                <a class="p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                                   data-bs-toggle="modal" data-bs-target="#delete-modal"
                                                   @onclick="() => ConfirmDelete(chart)">
                                                    <i data-feather="trash-2"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center text-muted py-4">
                                        No charts found
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center p-3">
                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = StartPage; i <= EndPage; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row Details Modal (Mobile) -->
        <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Chart Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                style="padding:0; right:22px; position:absolute;transform:none"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2 d-flex gap-3">
                            <strong>Name:</strong>
                            <div>@(SelectedChart?.ChartName ?? "-")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Company:</strong>
                            <div>@(SelectedChart?.CompanyName ?? "-")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Type:</strong>
                            <div>
                                <span class="badge @(SelectedChart != null ? GetTypeBadgeClass(SelectedChart.ChartType) : "")">
                                    @(SelectedChart?.ChartType ?? "-")
                                </span>
                            </div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Default:</strong>
                            <div>
                                @if (SelectedChart?.IsDefaultForCompany == true)
                                {
                                    <span class="badge bg-success-transparent text-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-transparent text-secondary">No</span>
                                }
                            </div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Groups:</strong>
                            <div>@(SelectedChart?.AccountGroupCount ?? 0)</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Status:</strong>
                            <div>
                                <span class="badge @(SelectedChart != null ? GetStatusBadgeClass(SelectedChart.Status) : "")">
                                    @(SelectedChart?.Status ?? "-")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activate Modal -->
        <div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-toggle-right fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Chart</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Do you want to proceed with activating the <strong>@SelectedChart?.ChartName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-right me-1"></i>Yes, Activate</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lock Modal -->
        <div class="modal fade" id="lock-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                                <i class="ti ti-lock fs-24 text-warning"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Lock Chart</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to lock the <strong>@SelectedChart?.ChartName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="LockConfirmed" data-bs-dismiss="modal"><i class="ti ti-lock me-1"></i>Yes, Lock</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Unlock Modal -->
        <div class="modal fade" id="unlock-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-lock-open fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Unlock Chart</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to unlock the <strong>@SelectedChart?.ChartName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="UnlockConfirmed" data-bs-dismiss="modal"><i class="ti ti-lock-open me-1"></i>Yes, Unlock</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                <i class="ti ti-trash fs-24 text-danger"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Chart</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDelete)
                                {
                                    <span class="text-danger">Cannot delete! Chart has account groups or accounts.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to delete <strong>@SelectedChart?.ChartName</strong>?</span>
                                }
                            </p>
                            @if (canDelete)
                            {
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                            }
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDelete)
                                {
                                    <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteConfirmed" data-bs-dismiss="modal"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

}
