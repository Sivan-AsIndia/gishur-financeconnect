@page "/account-groups"

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Account Groups</h4>
                    <h6>Manage account groups</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/account-groups/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Account Group List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search groups..."
                               @bind="searchTerm" @oninput="OnSearchChanged" />
                    </div>
                </div>

                <div style="display:flex;flex-wrap:wrap;gap:10px">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 220px" @onchange="OnChartFilterChanged">
                            <option value="">All Charts</option>
                            @foreach (var chart in AllItems.Where(g => g.ChartOfAccountsId != Guid.Empty).Select(g => new { g.ChartOfAccountsId, g.ChartOfAccountsName }).DistinctBy(c => c.ChartOfAccountsId).OrderBy(c => c.ChartOfAccountsName))
                            {
                                <option value="@chart.ChartOfAccountsId">@chart.ChartOfAccountsName</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 130px" @onchange="OnNatureFilterChanged">
                            <option value="">All Natures</option>
                            @foreach (var nature in AllItems.Select(g => g.AccountNature).Where(n => !string.IsNullOrEmpty(n)).Distinct().OrderBy(n => n))
                            {
                                <option value="@nature">@nature</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 120px" @onchange="OnStatusFilterChanged">
                            <option value="">All Status</option>
                            @foreach (var status in AllItems.Select(g => g.Status).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s))
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xxl-none" style="width:40px"></th>
                                <th style="width: 245px;">Code</th>
                                <th class="d-none d-md-table-cell" style="width: 270px;">Name</th>
                                <th class="d-none d-lg-table-cell" style="width: 330px;">Chart</th>
                                <th class="td-xxxl">Nature</th>
                                <th class="d-none d-xxl-table-cell">Parent</th>
                                @* <th class="d-none d-xxl-table-cell">Level</th> *@
                                @* <th class="d-none d-xxl-table-cell">Accounts</th> *@
                                <th class="d-none d-xl-table-cell">Status</th>
                                <th class="no-sort" style="width: 115px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedItems.Any())
                            {
                                @foreach (var item in PagedItems)
                                {
                                    <tr>
                                        <td class="d-xxl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(item)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td>
                                            <span class="fw-medium">
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a @onclick="async () => await ViewGroup(item)" class="text-decoration-none link-View"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title="@item.GroupCode details">
                                                    @item.GroupCode
                                                </a>
                                            </span>
                                        </td>
                                        <td class="d-none d-md-table-cell">@item.GroupName</td>
                                        <td class="d-none d-lg-table-cell">@item.ChartOfAccountsName</td>
                                        <td class="td-xxxl">
                                            <span class="badge @GetNatureBadgeClass(item.AccountNature)">
                                                @item.AccountNature
                                            </span>
                                        </td>
                                        <td class="d-none d-xxl-table-cell">@(item.ParentGroupName ?? "-")</td>
                                        @* <td class="d-none d-xxl-table-cell text-center">@item.HierarchyLevel</td> *@
                                        @* <td class="d-none d-xxl-table-cell text-center">@item.AccountCount</td> *@
                                        
                                        <td class="d-none d-xl-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @GetStatusDotBadgeClass(item.Status)">
                                                </div>
                                                <span> @item.Status</span>
                                            </div>
                                        </td>
                                        <td class="action-table-data">
                                            <div class="edit-delete-action">
                                                @* <a class="me-2 view-icon p-1" href="javascript:void(0);" title="View"
                                                   @onclick="async () => await ViewGroup(item)">
                                                    <i data-feather="eye"></i>
                                                </a> *@
                                                <a class="me-2 edit-icon p-1" href="/account-groups/@item.Id" title="Edit">
                                                    <i data-feather="edit"></i>
                                                </a>
                                                @if (item.Status == GroupStatuses.Active)
                                                {
                                                    <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon" href="javascript:void(0);"
                                                       title="Deactivate" data-bs-toggle="modal" data-bs-target="#deactivate-modal"
                                                       @onclick="() => ConfirmDeactivate(item)">
                                                        <i class="ti ti-toggle-right"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Activate" data-bs-toggle="modal" data-bs-target="#activate-modal"
                                                       @onclick="() => ConfirmActivate(item)">
                                                        <i class="ti ti-toggle-left"></i>
                                                    </a>
                                                }
                                                <a class="p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                                   data-bs-toggle="modal" data-bs-target="#delete-modal"
                                                   @onclick="() => ConfirmDelete(item)">
                                                    <i data-feather="trash-2"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center text-muted py-4">
                                        No account groups found
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center p-3">
                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChanged">
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @foreach (var pageItem in GetPageNumbers())
                                {
                                    <li class="page-item @(pageItem == currentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageItem)">
                                            @pageItem
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row Details Modal (Mobile) -->
        <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Account Group Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                style="padding:0; right:22px; position:absolute;transform:none"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2 d-flex gap-3">
                            <strong>Name:</strong>
                            <div>@(SelectedItem?.GroupName ?? "-")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Chart:</strong>
                            <div>@(SelectedItem?.ChartOfAccountsName ?? "-")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Nature:</strong>
                            <div>
                                <span class="badge @(SelectedItem != null ? GetNatureBadgeClass(SelectedItem.AccountNature) : "")">
                                    @(SelectedItem?.AccountNature ?? "-")
                                </span>
                            </div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Parent:</strong>
                            <div>@(SelectedItem?.ParentGroupName ?? "None (Top Level)")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Level:</strong>
                            <div>@(SelectedItem?.HierarchyLevel ?? 0)</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Accounts:</strong>
                            <div>@(SelectedItem?.AccountCount ?? 0)</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Status:</strong>
                            <div>
                                <span class="badge @(SelectedItem != null ? GetStatusBadgeClass(SelectedItem.Status) : "")">
                                    @(SelectedItem?.Status ?? "-")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activate Modal -->
        <div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-toggle-right fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Group</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to activate <strong>@SelectedItem?.GroupName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-right me-1"></i>Yes, Activate</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deactivate Modal -->
        <div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                                <i class="ti ti-toggle-left fs-24 text-warning"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate Group</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to deactivate <strong>@SelectedItem?.GroupName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-left me-1"></i>Yes, Deactivate</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                <i class="ti ti-trash fs-24 text-danger"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Group</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDelete)
                                {
                                    <span class="text-danger">Cannot delete! Group has accounts or child groups.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to delete <strong>@SelectedItem?.GroupName</strong>?</span>
                                }
                            </p>
                            @if (canDelete)
                            {
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                            }
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDelete)
                                {
                                    <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteConfirmed" data-bs-dismiss="modal"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>


}
