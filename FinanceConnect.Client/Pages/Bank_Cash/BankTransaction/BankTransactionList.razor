@page "/bank-transactions"

@inject NavigationManager NavigationManager
@inject ToastService ToastService


<div class="content List-view">

    <!-- Page Header -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Bank Transaction</h4>
                <h6>Manage bank & cash movements</h6>
            </div>
        </div>

        <ul class="table-top-head me-2">
            <li>
                <a title="Refresh" @onclick="Reload">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>

        <div class="page-btn">
            <a href="/bank-transactions/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i>
                Create
            </a>
        </div>
    </div>

    <!-- Filters -->


    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset">
                        <i class="ti ti-search fs-14"></i>
                    </span>
                    <input type="search"
                           class="form-control form-control-sm"
                           placeholder="Search code or name..."
                           @bind="SearchText"
                           @oninput="OnSearch" />
                </div>
            </div>

            <div style="display:flex;gap:10px;">

                <select value="@SelectedStatus" class="form-select form-select-sm" @onchange="OnStatusChanged">
                    <option value="">All Status</option>
                    @foreach (var status in AvailableStatuses)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
        </div>

        <div class="card-body p-0">
            <table class="table align-middle w-100 table-fixed">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xl-none" style="width:40px"></th>
                        <th>Txn. No</th>
                        <th class="d-none d-xl-table-cell">Type</th>
                        <th class="d-none d-md-table-cell">Method</th>
                        <th class="d-none d-md-table-cell">Date</th>
                        <th class="d-none d-xl-table-cell">Amount</th>
                        <th class="d-none d-xl-table-cell">Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var acc in PagedAccounts)
                    {
                        <tr>
                              <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
      <a href="javascript:void(0);" class="TablePlus"
         data-bs-toggle="modal"
                                    data-bs-target="#rowDetailsModal"
         @onclick="() => OpenRowDetails(acc)">
          <i class="ti ti-plus"></i>
      </a>
  </td>

                            <td class="">
                                <span class="PopupIcon">⧉</span>
                                <span class="fw-medium" data-bs-toggle="tooltip"
                                      data-bs-placement="top"
                                      title="@acc.TransactionNumber Details">
                                    <a @onclick="async () => await ViewTransactionpopup(acc)" class="text-decoration-none link-View">
                                        @acc.TransactionNumber
                                    </a>
                                </span>
                            </td>

                            <td class="d-none d-xl-table-cell">
                                @acc.TransactionType
                                <div class="small text-muted">@acc.Direction</div>
                            </td>

                            <td class="d-none d-md-table-cell">@acc.PaymentMethod</td>
                            <td class="d-none d-md-table-cell">
                               
                                @acc.TransactionDate.ToString("dd-MMM-yy")
                            </td>

                            <td class="d-none d-xl-table-cell">
                                @* @acc.Amount.ToStsring("N2") *@
                                @IndianNumberFormatter.Format(@acc.Amount)
                                </td>


                            <td class="d-none d-xl-table-cell">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="ActiveDot @GetStatusDotBadge(@acc.TransactionStatus)">
                                    </div>
                                    <span> @acc.TransactionStatus</span>
                                </div>
                            </td>

                             <td class="action-table-data">
                                    <div class="edit-delete-action">
                                <a class="me-2 view-icon p-1"
                                  
                                       @onclick="() => ViewTransaction(acc)">
                                    <i class="ti ti-eye"></i>
                                </a>

                                    <a class="me-2 edit-icon p-1"
                                       title="Edit" @onclick="() => EditTransaction(acc.Id)">
                                        <i data-feather="edit"></i>
                                    </a>


                                <a class="me-2 delete-icon p-1"
                                   data-bs-toggle="modal"
                                   data-bs-target="#delete-modal"
                                   @onclick="() => ConfirmDelete(acc)">
                                    <i class="ti ti-trash"></i>
                                </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>


            <!-- Pagination -->
            @if (PagedAccounts.Any())
            {
                <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                    <div class="d-flex align-items-center">
                        <span class="me-2">Rows per page:</span>
                        <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                            <option value="5" selected="@(PageSize == 5)">5</option>
                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                        <span class="ms-3 text-muted">
                            Entries
                        </span>
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                    <i class="ti ti-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = StartPage; i <= EndPage; i++)
                            {
                                int pageNum = i;
                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                    <i class="ti ti-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>


</div>



<!-- Delete Modal -->
<div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                        <i class="ti ti-trash fs-24 text-danger"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Transaction</h4>
                    <p class="text-gray-6 mb-0 fs-16">

                        <span>Are you sure you want to delete ?</span>

                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal">
                            <i class="ti ti-x"></i> Cancel
                        </button>

                        <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal" @onclick="DeleteTransaction"><i class="ti ti-trash"></i> Yes, Delete</button>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@* View Transaction Offcanvas *@
<div class="offcanvas offcanvas-end offcanvas-view"
     tabindex="-1"
     id="viewTransactionOffcanvas"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    @if (SelectedTransaction != null)
    {
        <!-- Header -->
        <div class="offcanvas-header">
            <div class="oc-avatar bg-primary-soft">
                <i class="ti ti-file-invoice"></i>
            </div>

            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@SelectedTransaction.TransactionNumber</h5>

                    <span class="oc-status-pill @GetStatusBadge(SelectedTransaction.TransactionStatus)">
                        <span class="oc-status-dot"></span>
                        @SelectedTransaction.TransactionStatus
                    </span>
                </div>

                <p class="oc-header-sub">
                    @SelectedTransaction.AccountKind • @SelectedTransaction.CurrencyCode
                </p>
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas">
            </button>
        </div>

        <!-- Body -->
        <div class="offcanvas-body">

            <!-- Summary Row -->
            <div class="oc-summary-row">
                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value">
                        @SelectedTransaction.Amount.ToString("N2")
                    </div>
                    <div class="oc-summary-label">Amount</div>
                </div>

                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value">
                        @(SelectedTransaction.BaseAmount?.ToString("N2") ?? "—")
                    </div>
                    <div class="oc-summary-label">Base Amount</div>
                </div>

                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value">
                        @SelectedTransaction.Direction
                    </div>
                    <div class="oc-summary-label">Direction</div>
                </div>
            </div>

            <!-- General Info -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-info-circle"></i>
                    <h6 class="oc-card-title">General Information</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Branch</div>
                            <div class="oc-field-value">
                                @(SelectedTransaction.BranchName ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Source Module</div>
                            <div class="oc-field-value">
                                @(SelectedTransaction.SourceModule ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Source Document</div>
                            <div class="oc-field-value">
                                @(SelectedTransaction.SourceDocumentType ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Transaction Type</div>
                            <div class="oc-field-value">
                                @SelectedTransaction.TransactionType
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Date & Currency -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-calendar-event"></i>
                    <h6 class="oc-card-title">Date & Currency</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <div class="oc-list-row">
                            <span class="oc-list-label">Transaction Date</span>
                            <span class="oc-list-value">
                                @SelectedTransaction.TransactionDate.ToString("dd-MMM-yyyy")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Value Date</span>
                            <span class="oc-list-value">
                                @(SelectedTransaction.ValueDate?.ToString("dd-MMM-yyyy") ?? "—")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Posting Date</span>
                            <span class="oc-list-value">
                                @(SelectedTransaction.PostingDate?.ToString("dd-MMM-yyyy") ?? "—")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Exchange Rate</span>
                            <span class="oc-list-value">
                                @SelectedTransaction.ExchangeRate
                            </span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Counterparty & Reference -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-users"></i>
                    <h6 class="oc-card-title">Counterparty & References</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <div class="oc-list-row">
                            <span class="oc-list-label">Counterparty</span>
                            <span class="oc-list-value">
                                @(SelectedTransaction.CounterpartyNameSnapshot ?? "—")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Payment Method</span>
                            <span class="oc-list-value">
                                @SelectedTransaction.PaymentMethod
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Reference No</span>
                            <span class="oc-list-value">
                                @(SelectedTransaction.ReferenceNumber ?? "—")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">UTR Number</span>
                            <span class="oc-list-value">
                                @(SelectedTransaction.UTRNumber ?? "—")
                            </span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Narration -->
            <div class="oc-card">
                <div class="oc-card-header hdr-purple">
                    <i class="ti ti-note"></i>
                    <h6 class="oc-card-title">Narration</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-field-value ql-editor">
                        @(new MarkupString(SelectedTransaction?.Narration ?? "-"))
                    </div>
                </div>
            </div>

        </div>
    }
</div>



@* Responsive view Model *@

<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Transaction Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>

            <div class="modal-body">
                <div class="mb-2 d-flex gap-3">
                    <strong>Txn No:</strong>
                    <div>@SelectedTransaction?.TransactionNumber</div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Type :</strong>
                    <div>
                        @SelectedTransaction?.TransactionType </div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Direction :</strong>
                    <div>@SelectedTransaction?.Direction</div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Amount :</strong>
                    <div>@SelectedTransaction?.Amount.ToString("N2")</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Payment Method :</strong>
                    <div>@SelectedTransaction?.PaymentMethod</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Date :</strong>
                    <div>@SelectedTransaction?.TransactionDate</div>
                </div>

                <div class="mb-2 gap-3">
                    <strong>Status:</strong>
                    @if (!string.IsNullOrEmpty(SelectedTransaction?.TransactionStatus))
                    {
                        <span class="badge @GetStatusBadge(SelectedTransaction.TransactionStatus)">
                            @SelectedTransaction.TransactionStatus
                        </span>
                    }

                </div>


            </div>

        </div>
    </div>
</div>
