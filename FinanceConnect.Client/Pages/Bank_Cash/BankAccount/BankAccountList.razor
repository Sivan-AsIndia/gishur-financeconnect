
@page "/bank-accounts"
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject NavigationManager Nav
@inject BranchService BranchService
@inject ToastService ToastService


<div class="content List-view">

    <!-- Page Header -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Bank Accounts</h4>
                <h6>Manage branch-wise cash holdings</h6>
            </div>
        </div>

        <ul class="table-top-head me-2">
            <li>
                <a title="Refresh" @onclick="Reload">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>

        <div class="page-btn">
            <a href="/bank-accounts/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i>
                Create
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset">
                        <i class="ti ti-search fs-14"></i>
                    </span>
                    <input type="search"
                           class="form-control form-control-sm"
                           placeholder="Search code or name..."
                           @bind="SearchText"
                           @oninput="OnSearch" />
                </div>
            </div>

            <div style="display:flex;gap:10px;">
                <select class="form-select form-select-sm" style="min-width:160px"
                        @bind="SelectedBranchId">
                    <option value="">All Branches</option>
                    @foreach (var branch in BranchesList)
                    {
                        <option value="@branch.Id">@branch.BranchName</option>
                    }
                </select>

                <select @bind="SelectedStatus" class="form-select form-select-sm">
                    <option value="">All Status</option>
                    @foreach (var status in AvailableStatuses)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
        </div>

        <!-- Table -->
        <div class="card-body p-0">
            <table class="table align-middle w-100 table-fixed">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xxl-none" style="width:40px"></th>

                        <th>Code</th>
                        <th class="d-none d-md-table-cell">Name</th>
                        <th class="d-none d-xl-table-cell">Bank</th>
                        @* <th class="d-none d-lg-table-cell">IFSC</th> *@
                        <th class="d-none d-md-table-cell">Branch</th>
                        @* <th class="d-none d-xl-table-cell">Currency</th> *@
                        @* <th class="d-none d-xxl-table-cell">Type</th> *@
                        @* <th class="d-none d-xxl-table-cell">Bank GL</th> *@
                        <th class="d-none d-xl-table-cell text-center">Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (PagedAccounts.Any())
                    {
                        @foreach (var acc in PagedAccounts)
                        {
                            <tr>
                                <td class="d-xxl-none text-center" style="padding: 0;padding-left: 15px;">
                                    <a href="javascript:void(0);" class="TablePlus"
                                       data-bs-toggle="modal"
                                       data-bs-target="#rowDetailsModal"
                                       @onclick="() => OpenRowDetails(acc)">
                                        <i class="ti ti-plus"></i>
                                    </a>
                                </td>

                                <td>
                                    <span class="fw-medium" data-bs-toggle="tooltip"
                                          data-bs-placement="top"
                                          title="@acc.BankAccountCode Bank details">
                                        <span class="PopupIcon">⧉</span>
                                        <a @onclick="() => ViewBankAccount(acc)"
                                            class="text-decoration-none link-View">
                                            @acc.BankAccountCode
                                        </a>
                                    </span>
                                </td>
                                <td class="d-none d-md-table-cell">@acc.BankAccountName</td>
                                <td  class="d-none d-xl-table-cell">@acc.BankName</td>
                                @* <td class="d-none d-lg-table-cell">@acc.IFSCCode</td> *@
                                <td class="d-none d-md-table-cell">@acc.BranchName</td>
                                @* <td class="d-none d-xl-table-cell">@acc.CurrencyCode</td> *@
                                @* <td title="@acc.BankAccountType" class="d-none d-xxl-table-cell">@acc.BankAccountType</td> *@
                                @* <td class="d-none d-xxl-table-cell">@acc.BankGLAccountCode</td> *@
                              
                                <td class="d-none d-xl-table-cell">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <div class="ActiveDot @GetStatusDotBadge(acc.BankAccountStatus)">
                                        </div>
                                        <span>@acc.BankAccountStatus</span>
                                    </div>
                                </td>

                                <td class="action-table-data">
                                    <div class="edit-delete-action">
                                        <a class="me-2 view-icon p-1"
                                           title="View" @onclick="() => ViewBankAccount(acc)">
                                            <i class="ti ti-eye"></i>
                                        </a>

                                        <a class="me-2 edit-icon p-1"
                                           title="Edit"
                                           @onclick='() => NavigationManager.NavigateTo($"/bank-accounts/edit/{acc.BankAccountCode}")'>
                                            <i data-feather="edit"></i>
                                        </a>




                                        @* @onclick='() => NavigationManager.NavigateTo($"/cash-accounts/edit/{acc.Code}")' *@



                                        @if (!acc.IsLockedForTransactions)
                                        {
                                            <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon"
                                               href="javascript:void(0);"
                                               title="Lock Sequence"
                                               data-bs-toggle="modal"
                                               data-bs-target="#view-Lock-modal"
                                               @onclick="() => OpenLockModal(acc)">
                                                <i class="ti ti-lock-open"></i>
                                                
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="me-2 p-1 Toggle-icon action-icon activate-icon"
                                               href="javascript:void(0);"
                                               title="Unlock Sequence"
                                               data-bs-toggle="modal"
                                               data-bs-target="#view-Lock-modal"
                                               @onclick="() => OpenLockModal(acc)">
                                                <i class="ti ti-lock"></i>
                                            </a>
                                        }

                                        <a class="me-2 p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                           @onclick="() => ConfirmDelete(acc)" data-bs-toggle="modal" data-bs-target="#delete-modal">
                                            <i data-feather="trash-2"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@VisibleColumnCount" class="text-center py-4 text-muted">
                                No cash accounts found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            @if (PagedAccounts.Any())
            {
                <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                    <div class="d-flex align-items-center">
                        <span class="me-2">Rows per page:</span>
                        <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                            <option value="5" selected="@(PageSize == 5)">5</option>
                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                        <span class="ms-3 text-muted">
                            Entries
                        </span>
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                    <i class="ti ti-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = StartPage; i <= EndPage; i++)
                            {
                                int pageNum = i;
                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                    <i class="ti ti-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }

        </div>
    </div>
</div>



<!-- Lock/Unlock Modal -->
<div class="modal fade" id="view-Lock-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 mb-2"
                          style="background-color:@(SelectedAccount?.IsLockedForTransactions == false ? "#fff3cd" : "#d1ecf1");">
                        <i class="ti @(SelectedAccount?.IsLockedForTransactions == false
                                   ? "ti-lock text-warning"
                                                              : "ti-lock-open text-success") fs-24"></i>
                    </span>

                    <h4 class="fs-20 fw-bold">
                        @(SelectedAccount?.IsLockedForTransactions == false
                                                ? "Lock Bank Account"
                                                : "Unlock Bank Account")
                    </h4>

                    <p>
                        Are you sure you want to  @(SelectedAccount?.IsLockedForTransactions == false ? "lock" : "unlock") the
                        @(SelectedAccount?.IsLockedForTransactions == false ? "lock" : "unlock")
                        <strong>@SelectedAccount?.BankAccountName</strong>?
                    </p>


                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal">
                            <i class="ti ti-x"></i> Cancel
                        </button>

                        <button type="button"
                                class="btn @(SelectedAccount?.IsLockedForTransactions == false ? "btn-warning" : "btn-success")
               fs-13 fw-medium p-2 px-4"
                                data-bs-dismiss="modal"
                                @onclick="ConfirmToggleLock">

                            <i class="ti @(SelectedAccount?.IsLockedForTransactions == false
                                            ? "ti-lock": "ti-lock-open")"></i>  
                            Yes, @(SelectedAccount?.IsLockedForTransactions == false ? "Lock" : "Unlock")

                        </button>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>



<!-- Delete Modal -->
<div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                        <i class="ti ti-trash fs-24 text-danger"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Cash Account</h4>
                    <p class="text-gray-6 mb-0 fs-16">

                        <span>Are you sure you want to delete <strong>Cash</strong>?</span>

                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x"></i> Cancel</button>

                        <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal" @onclick="DeleteAccount"><i class="ti ti-trash"></i> Yes, Delete</button>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- View Bank Account Offcanvas -->
<div class="offcanvas offcanvas-end offcanvas-view"
     tabindex="-1"
     id="viewBankOffcanvas"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    @if (SelectedCashAccount != null)
    {
        <!-- Header -->
        <div class="offcanvas-header">
            <div class="oc-avatar">
                <i class="ti ti-building-bank"></i>
            </div>

            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@SelectedCashAccount.BankAccountName</h5>

                    <span class="oc-status-pill @(SelectedCashAccount.BankAccountStatus == "Active" ? "active" : "inactive")">
                        <span class="oc-status-dot"></span>
                        @SelectedCashAccount.BankAccountStatus
                    </span>
                </div>

                <p class="oc-header-sub">
                    Code : @SelectedCashAccount.BankAccountCode
                </p>
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas">
            </button>
        </div>

        <div class="offcanvas-body">

            <!-- Summary Cards -->
            <div class="oc-summary-row">

                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value">
                        @(SelectedCashAccount.CurrencyCode ?? "—")
                    </div>
                    <div class="oc-summary-label">Currency</div>
                </div>

                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value">
                        @(SelectedCashAccount.MinimumBalanceAmount?.ToString("N2") ?? "—")
                    </div>
                    <div class="oc-summary-label">Min Balance</div>
                </div>

                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value">
                        @(SelectedCashAccount.IsOverdraftAllowed ? "Yes" : "No")
                    </div>
                    <div class="oc-summary-label">Overdraft</div>
                </div>

            </div>

            <!-- General Information -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-info-circle"></i>
                    <h6 class="oc-card-title">General Information</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Company</div>
                            <div class="oc-field-value">
                                @(SelectedCashAccount.CompanyName ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Branch</div>
                            <div class="oc-field-value">
                                @(SelectedCashAccount.BranchName ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Account Type</div>
                            <div class="oc-field-value">
                                @(SelectedCashAccount.BankAccountType ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Primary Operating</div>
                            <div class="oc-field-value">
                                <span class="oc-dot-badge @(SelectedCashAccount.IsPrimaryOperatingAccount ? "db-green" : "db-red")">
                                    <span class="dot"></span>
                                    @(SelectedCashAccount.IsPrimaryOperatingAccount ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Bank Details -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-building-bank"></i>
                    <h6 class="oc-card-title">Bank Details</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Bank Name</div>
                            <div class="oc-field-value">@SelectedCashAccount.BankName</div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Branch</div>
                            <div class="oc-field-value">
                                @(SelectedCashAccount.BankBranchName ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">IFSC</div>
                            <div class="oc-field-value">
                                @(SelectedCashAccount.IFSCCode ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Account Number</div>
                            <div class="oc-field-value">
                                ****@(SelectedCashAccount.BankAccountNumberLast4 ?? "—")
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(SelectedCashAccount.UPIId))
                        {
                            <div class="oc-grid-item">
                                <div class="oc-field-label">UPI</div>
                                <div class="oc-field-value">@SelectedCashAccount.UPIId</div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(SelectedCashAccount.SWIFTCode))
                        {
                            <div class="oc-grid-item">
                                <div class="oc-field-label">SWIFT</div>
                                <div class="oc-field-value">@SelectedCashAccount.SWIFTCode</div>
                            </div>
                        }

                    </div>
                </div>
            </div>

            <!-- Controls -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-shield-check"></i>
                    <h6 class="oc-card-title">Controls & Limits</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <div class="oc-list-row">
                            <span class="oc-list-label">Overdraft Allowed</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedCashAccount.IsOverdraftAllowed ? "db-green" : "db-red")">
                                    <span class="dot"></span>
                                    @(SelectedCashAccount.IsOverdraftAllowed ? "Yes" : "No")
                                </span>
                            </span>
                        </div>

                        @if (SelectedCashAccount.IsOverdraftAllowed)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Overdraft Limit</span>
                                <span class="oc-list-value">
                                    @(SelectedCashAccount.OverdraftLimitAmount?.ToString("N2") ?? "—")
                                </span>
                            </div>
                        }

                        <div class="oc-list-row">
                            <span class="oc-list-label">Locked</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedCashAccount.IsLockedForTransactions ? "db-red" : "db-green")">
                                    <span class="dot"></span>
                                    @(SelectedCashAccount.IsLockedForTransactions ? "Locked" : "Unlocked")
                                </span>
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Blocked</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedCashAccount.IsBlocked ? "db-red" : "db-green")">
                                    <span class="dot"></span>
                                    @(SelectedCashAccount.IsBlocked ? "Blocked" : "No")
                                </span>
                            </span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Accounting -->
            <div class="oc-card">
                <div class="oc-card-header hdr-purple">
                    <i class="ti ti-book"></i>
                    <h6 class="oc-card-title">Accounting Mapping</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Bank GL</div>
                            <div class="oc-field-value">
                                @(SelectedCashAccount.BankGLAccountCode ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Clearing GL</div>
                            <div class="oc-field-value">
                                @(SelectedCashAccount.ClearingGLAccountCode ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Charges GL</div>
                            <div class="oc-field-value">
                                @(SelectedCashAccount.BankChargesExpenseGLCode ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Interest GL</div>
                            <div class="oc-field-value">
                                @(SelectedCashAccount.InterestIncomeGLCode ?? "—")
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <!-- Statement & Reconciliation -->
            <div class="oc-card">
                <div class="oc-card-header hdr-indigo">
                    <i class="ti ti-layers-linked"></i>
                    <h6 class="oc-card-title">Statement & Reconciliation</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <!-- Statement Import -->
                        <div class="oc-list-row">
                            <span class="oc-list-label">Statement Import</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedCashAccount.IsStatementImportEnabled ? "db-green" : "db-red")">
                                    <span class="dot"></span>
                                    @(SelectedCashAccount.IsStatementImportEnabled ? "Enabled" : "Disabled")
                                </span>
                            </span>
                        </div>

                        @if (SelectedCashAccount.IsStatementImportEnabled &&
                                            !string.IsNullOrEmpty(SelectedCashAccount.StatementProfile))
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Statement Profile</span>
                                <span class="oc-list-value">
                                    @SelectedCashAccount.StatementProfile
                                </span>
                            </div>
                        }

                        <!-- Reconciliation Mandatory -->
                        <div class="oc-list-row">
                            <span class="oc-list-label">Reconciliation Mandatory</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedCashAccount.IsBankReconciliationMandatory ? "db-green" : "db-red")">
                                    <span class="dot"></span>
                                    @(SelectedCashAccount.IsBankReconciliationMandatory ? "Yes" : "No")
                                </span>
                            </span>
                        </div>

                        <!-- Auto Match -->
                        <div class="oc-list-row">
                            <span class="oc-list-label">Auto Match</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedCashAccount.AutoMatchEnabled ? "db-green" : "db-red")">
                                    <span class="dot"></span>
                                    @(SelectedCashAccount.AutoMatchEnabled ? "Enabled" : "Disabled")
                                </span>
                            </span>
                        </div>

                        @if (SelectedCashAccount.AutoMatchEnabled)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Match Date Window (Days)</span>
                                <span class="oc-list-value">
                                    @SelectedCashAccount.AutoMatchDateWindowDays
                                </span>
                            </div>

                            <div class="oc-list-row">
                                <span class="oc-list-label">Match Amount Tolerance</span>
                                <span class="oc-list-value">
                                    @SelectedCashAccount.AutoMatchAmountTolerance.ToString("N2")
                                </span>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    }
</div>


@* Responsive View  *@

<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Bank Account Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>

            <div class="modal-body">

                <div class="mb-2 d-flex gap-3">
                    <strong>Bank Name:</strong>
                    <div>@(SelectedCashAccount?.BankName ?? "-")</div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Branch Name:</strong>
                    <div>@SelectedCashAccount?.BranchName</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Type:</strong>
                    <div>@SelectedCashAccount?.BankAccountType</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                        <strong>Bank GLAccount Code:</strong>
                    <div>@SelectedCashAccount?.BankGLAccountCode</div>
                </div>

                 <div class="mb-2 gap-3 d-md-none">
                    <strong>Status:</strong>
                    @if (!string.IsNullOrEmpty(SelectedCashAccount?.BankAccountStatus))
                    {
                        <span class="badge @GetStatusBadge(SelectedCashAccount.BankAccountStatus)">
                            @SelectedCashAccount.BankAccountStatus
                        </span>
                    }


                </div> 


            </div>

        </div>
    </div>
</div>

