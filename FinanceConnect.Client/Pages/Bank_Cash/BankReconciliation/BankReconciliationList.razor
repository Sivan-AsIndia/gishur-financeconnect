@page "/bank-reconciliations"

@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services
@inject BankReconciliationService ReconService
@inject NavigationManager Nav
@inject ToastService Toast
@inject IJSRuntime JS

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
    <div class="content List-view">

        <!-- PAGE HEADER -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Bank Reconciliations</h4>
                    <h6>Reconciliation runs & audit working papers</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <button class="btn btn-primary"
                @onclick="CreateNewRun">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </button>
            </div>
        </div>

        <!-- Statistics Cards -->

        <div class="row mb-0">
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="    background: linear-gradient(135deg, #009ac8, #00bfc1);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Total</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.TotalReconciliation</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-white rounded-circle p-2" style="background: #ffffff47;width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;">
                                <i class="ti ti-file-invoice" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #092c4c, #00396e);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Draft</h6>
                                <h5 class="mb-0 fw-bold text-secondary text-white">@Statistics.DraftReconciliation</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-secondary rounded-circle p-2" style="background: #ffffff47;width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;">
                                <i class="ti ti-file-text text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #155eef, #002e8b);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Inprogress</h6>
                                <h5 class="mb-0 fw-bold text-info text-white">@Statistics.InprogressReconciliation</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-info rounded-circle p-2" style="background: #ffffff47;width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;">
                                <i class="ti ti-send text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(343deg, #b73e3e, #ff8d21);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Completed</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.CompletedReconciliation</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-success rounded-circle p-2" style="background: #ffffff47;width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;">
                                <i class="ti ti-check text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #3eb780, #008146);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Finalized</h6>
                                <h5 class="mb-0 fw-bold text-danger text-white">@Statistics.FinalizedReconciliation</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-danger rounded-circle p-2" style="background: #ffffff47;width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;">
                                <i class="ti ti-circle-check text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="    background: linear-gradient(135deg, #ffca1f, #e8b200);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">
                                    Reopened
                                </h6>
                                <h5 class="mb-0 fw-bold text-warning text-white" style="font-size: 14px;">@Statistics.ReopenedReconciliation</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-warning rounded-circle p-2" style="background: #ffffff47;width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;">
                                <i class="ti ti-currency-rupee text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- LIST CARD -->
        <div class="card">

            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3" id="RowsPerPageContent">

                <!-- SEARCH -->
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset">
                            <i class="ti ti-search fs-14"></i>
                        </span>
                        <input type="search"
                        class="form-control form-control-sm"
                        placeholder="Search recon no / bank / account"
                        @bind="SearchText"
                        @oninput="OnSearch" />
                    </div>
                </div>

                <!-- STATUS FILTER -->
                <div>
                    <InputSelect class="form-select form-select-sm"
                    @bind-Value="SelectedStatus"
                    @onchange="OnStatusChanged">

                        <option value="">--Select Status--</option>

                        @foreach (var s in AvailableStatuses)
                        {
                            <option value="@s">@s</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <!-- TABLE -->
            <div class="card-body p-0">
                <table class="table align-middle w-100 table-fixed">
                    <thead class="thead-light">
                        <tr>
                            <th class="d-xxl-none" style="width:40px"></th>
                            <th >Recon No</th>
                            <th class="d-none d-md-table-cell" title="Bank Account">Bank Account</th>
                            @* <th class="d-none d-lg-table-cell">Scope</th> *@
                            <th class="d-none d-xxl-table-cell">Period</th>
                            <th class="d-none d-xl-table-cell" style="width: 122px;">Difference</th>
                            <th class="text-center">Status</th>
                            @* <th class="d-none d-xl-table-cell" title="Prepared By">Prepared By</th>
                        <th class="d-none d-xl-table-cell" title="Prepared On">Prepared On</th> *@
                            <th style="width: 122px;">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (PagedRuns.Any())
                        {
                            @foreach (var r in PagedRuns)
                            {
                                <tr>           
                                    <!-- PLUS ICON -->
                                    <td class="d-xxl-none text-center" style="padding: 0;padding-left: 15px;">
                                        <a href="javascript:void(0);" class="TablePlus"
                                        data-bs-toggle="modal"
                                        data-bs-target="#rowDetailsModal"
                                        @onclick="() => SelectedData(r)">
                                            <i class="ti ti-plus"></i>
                                        </a>
                                    </td>

                                    <!-- RECON NUMBER -->
                                    <td>
                                        <span>
                                            <i class="ti ti-external-link me-2 PopupIcon"></i>
                                            <a href="javascript:void(0);" data-bs-toggle="tooltip"
                                            data-bs-placement="top" title="@r.ReconciliationNumber Details"
                                            class="fw-medium link-View"
                                            @onclick="() => OpenRun(r)">
                                                @r.ReconciliationNumber
                                            </a>
                                        </span>
                                    </td>

                                    <!-- BANK ACCOUNT -->
                                    <td class="d-none d-md-table-cell">
                                        <div class="d-flex flex-column gap2">
                                            <span>@GetBankAccountName(r.BankAccountId)</span>
                                            <span class="badge @GetScopeBadgeClass(r.ScopeType)" style=" width: max-content;">
                                                @r.ScopeType
                                            </span>
                                        </div>



                                    </td>

                                    <!-- SCOPE -->
                                    @* <td class="d-none d-lg-table-cell" title=" @r.ScopeType">
                                    <span class="badge bg-soft-info text-info">
                                        @r.ScopeType
                                    </span>
                                </td> *@

                                    <!-- PERIOD -->
                                    <td class="d-none d-xxl-table-cell">
                                        @if (r.ScopeType == ScopeType.PeriodRange)
                                        {
                                            <span>
                                                @r.FromDate?.ToString("dd MMM yy")
                                                –
                                                @r.ToDate?.ToString("dd MMM yy")
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                As of @r.AsOfDate?.ToString("dd MMM yyyy")
                                            </span>
                                        }
                                    </td>

                                    <!-- DIFFERENCE -->
                                    <td class="d-none d-xl-table-cell">
                                        @if (r.DifferenceAmount == 0)
                                        {
                                            <span class="text-success fw-medium">
                                                ₹0.00
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-medium">
                                                @* ₹@r.DifferenceAmount.ToString("N2") *@
                                                ₹@IndianNumberFormatter.Format(@r.DifferenceAmount)

                                            </span>
                                        }
                                    </td>

                                    <!-- STATUS -->
                                    <td class="text-center">
                                        <span class="badge @GetStatusBadge(r.ReconciliationStatus)"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        title="@r.ReconciliationStatus.ToString()">

                                            <i class="@GetStatusIcon(r.ReconciliationStatus)"></i>
                                        </span>
                                    </td>

                                    <!-- PREPARED BY -->
                                    @* <td class="d-none d-xl-table-cell" title="@r.PreparedBy">
                                    @r.PreparedBy
                                </td>

                                <!-- PREPARED ON -->
                                <td class="d-none d-xl-table-cell" title="@r.PreparedOn.ToString("dd MMM yyyy HH:mm")">
                                    @r.PreparedOn.ToString("dd MMM yyyy HH:mm")
                                </td> *@

                                    <!-- ACTIONS -->
                                    <td class="action-table-data">
                                        <div class="edit-delete-action">

                                            <!-- FINALIZE -->
                                            @if (r.ReconciliationStatus == ReconciliationStatus.Completed)
                                            {
                                                <a class="me-2 Toggle-icon p-1 action-icon Clear"
                                                title="Finalize"
                                                href="javascript:void(0);"
                                                @onclick="() => Finalize(r)">
                                                    <i class="ti ti-check"></i>
                                                </a>
                                            }

                                            <!-- REOPEN -->
                                            @if (r.ReconciliationStatus == ReconciliationStatus.Finalized)
                                            {
                                                <a class="me-2 Toggle-icon p-1 action-icon refresh"
                                                title="Reopen"
                                                href="javascript:void(0);"
                                                data-bs-toggle="modal" data-bs-target="#reopenModal"
                                                @onclick="() => OpenReopenModal(r)">
                                                    <i class="ti ti-refresh"></i>
                                                </a>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@VisibleColumnCount" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                        No Reconciliation Runs Found
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- PAGINATION -->
                @if (PagedRuns.Any())
                {
                    <div class="d-flex justify-content-between align-items-center p-3" id="RowsPerPageContent">

                        <div class="d-flex align-items-center">
                            <span class="me-2">Rows per page</span>
                            <select class="form-select form-select-sm w-auto"
                            @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">

                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                    href="#"
                                    @onclick="PreviousPage"
                                    @onclick:preventDefault>
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>

                                @foreach (var p in VisiblePages)
                                {
                                    <li class="page-item @(p == CurrentPage ? "active" : "")">
                                        <button class="page-link"
                                        @onclick="() => GoToPage(p)">
                                            @p
                                        </button>
                                    </li>
                                }

                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                    href="#"
                                    @onclick="NextPage"
                                    @onclick:preventDefault>
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
}
<!-- Reopen Confirmation Modal -->
<div class="modal fade" id="reopenModal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                        <i class="ti ti-refresh fs-24 text-warning"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Reopen Reconciliation</h4>
                    <p class="text-gray-6 mb-0 fs-16">
                        Are you sure you want reopen <strong>@ReopenTarget?.ReconciliationNumber</strong>?
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal">
                            <i class="ti ti-x me-1"></i> Cancel
                        </button>
                        <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="ConfirmReopen" data-bs-dismiss="modal">
                            <i class="ti ti-refresh me-1"></i> Yes, Reopen
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ================= ROW DETAILS MODAL ================= -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">
                <h5 class="modal-title">
                    Bank Reconciliation Details
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute; transform:none">
                </button>
            </div>

            @if (SelectedReconciliaton != null)
            {
                <div class="modal-body">

                    <!-- Recon Number -->
                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Recon No:</strong>
                        <div>@SelectedReconciliaton.ReconciliationNumber</div>
                    </div>

                    <!-- Bank Account -->
                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Bank Account:</strong>
                        <div>@SelectedReconciliaton.BankAccountId</div>
                    </div>

                    <!-- Scope -->
                    <div class="mb-2 d-flex gap-3">
                        <strong>Scope:</strong>
                        <div>
                            <span class="badge bg-soft-info text-info">
                                @SelectedReconciliaton.ScopeType
                            </span>
                        </div>
                    </div>

                    <!-- Period -->
                    <div class="mb-2 d-flex gap-3">
                        <strong>Period:</strong>
                        <div>
                            @if (SelectedReconciliaton.ScopeType == ScopeType.PeriodRange)
                            {
                                <span>
                                    @SelectedReconciliaton.FromDate?.ToString("dd MMM yyyy")
                                    –
                                    @SelectedReconciliaton.ToDate?.ToString("dd MMM yyyy")
                                </span>
                            }
                            else
                            {
                                <span>
                                    As of @SelectedReconciliaton.AsOfDate?.ToString("dd MMM yyyy")
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Difference -->
                    <div class="mb-2 d-flex gap-3">
                        <strong>Difference:</strong>
                        <div>
                            <span class="@(SelectedReconciliaton.DifferenceAmount == 0
                                                                              ? "text-success fw-medium" 
                                                                              : "text-danger fw-medium")">
                                ₹@SelectedReconciliaton.DifferenceAmount.ToString("N2")
                            </span>
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="mb-2 d-flex gap-3 d-none d-md-none">
                        <strong>Status:</strong>
                        <span class="badge @GetStatusBadge(SelectedReconciliaton.ReconciliationStatus)">
                            @SelectedReconciliaton.ReconciliationStatus
                        </span>
                    </div>

                    <!-- Prepared By -->
                    <div class="mb-2 d-flex gap-3">
                        <strong>Prepared By:</strong>
                        <div>@SelectedReconciliaton.PreparedBy</div>
                    </div>

                    <!-- Prepared On -->
                    <div class="mb-2 d-flex gap-3">
                        <strong>Prepared On:</strong>
                        <div>
                            @SelectedReconciliaton.PreparedOn.ToString("dd MMM yyyy HH:mm")
                        </div>
                    </div>

                </div>
            }

        </div>
    </div>
</div>
