@page "/bank-statements/import"

@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services
@using Microsoft.AspNetCore.Components.Forms

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    <div class="content form-wizard">

        <!-- HEADER -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Import Bank Statement</h4>
                    <h6>External Bank Evidence → Reconciliation Source</h6>
                </div>
            </div>

            <div class="page-btn mt-0">
                <a href="/bank-statements" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <EditForm EditContext="_editContext" OnSubmit="Save">
           <DataAnnotationsValidator />
            <div class="wizard-overlay">
                <div class="wizard-modal">

                    <!-- LEFT STEPPER -->
                    <div class="wizard-steps">
                        <div class="timeline-line"></div>
                        <div class="timeline-indicator @(IsCurrentStepValid(CurrentStep) ? "success" : "error")" style="top:@IndicatorToppx"></div>

                        @for (int i = 1; i <= Steps.Count; i++)
                        {
                            <div class="wizard-step @StepClass(i)">
                                <div class="dot">
                                    @if (i < CurrentStep)
                                    {
                                        <i class="ti ti-check text-white fs-20"></i>
                                    }
                                    else
                                    {
                                        <i class="@Steps[i - 1].Icon"></i>
                                    }
                                </div>
                                <div class="label">
                                    <b>@Steps[i - 1].Title</b>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- RIGHT CONTENT -->
                    <div class="wizard-content" style="padding-left: 65px;">
                        <h5>@Steps[CurrentStep - 1].Title</h5>

                        <!-- STEP 1: IDENTITY -->
                        @if (CurrentStep == 1)
                        {
                            <div class="row mt-3">

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Bank Account <span class="text-danger">*</span></label>
                                    <select class="@($"form-select {(ShowFieldError(1, nameof(Statement.BankAccountId)) ? "is-invalid" : "")}")"
                                                 value="@SelectedBankAccount" @onchange="ChangeBankAccount">
                                        <option value="">--Select Bank Account--</option>
                                        @foreach (var acc in BankAccounts)
                                        {
                                            <option value="@acc.Id">
                                                @acc.BankAccountName (@acc.BankAccountCode)
                                            </option>
                                        }
                                    </select>
                                    @if (ShowFieldError(1, "BankAccountId"))
                                    {
                                        <small class="text-danger">BankAccount is required</small>
                                    }
                                </div>



                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Company <span class="text-danger">*</span></label>
                                    <input class="form-control" placeholder="Select Bank Account" disabled value="@Statement.CompanyName" />
                                     <ValidationMessage For="@(() => Statement.CompanyName)" />
                                </div>
                                <div class="col-md-12 mb-3">
                                    <label class="form-label">Branch <span class="text-danger">*</span></label>
                                    <input class="form-control" placeholder="Select Bank Account" disabled value="@Statement.BranchName" />
                                    <ValidationMessage For="@(() => Statement.BranchName)" />
                                </div>

                            </div>
                        }

                        <!-- STEP 2:  File Metadata -->
                        @if (CurrentStep == 2)
                        {
                            <div class="row mt-3">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label">Import Source <span class="text-danger">*</span></label>

                                    <InputSelect class="form-select"
                                                 @bind-Value="Statement.ImportSource">
                                        <option value="">--Select Import Source--</option>

                                        @foreach (ImportSourceType source in Enum.GetValues(typeof(ImportSourceType)))
                                        {
                                            <option value="@source">@source</option>
                                        }

                                    </InputSelect>
                                    <ValidationMessage For="@(() => Statement.ImportSource)" />
                                </div>

                                <div class="col-md-12 mb-3">
                                    <label class="form-label">
                                        Upload Statement File <span class="text-danger">*</span>
                                    </label>
                                    <InputFile OnChange="HandleFile" class="@($"form-control {(ShowFieldError(2, nameof(Statement.FileNameOriginal)) ? "is-invalid" : "")}")" />
                                    @if (ShowFieldError(2, "FileNameOriginal"))
                                    {
                                        <small class="text-danger">File is required</small>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Statement.FileNameOriginal))
                                {
                                    <div class="col-md-4 mb-3">
                                        <label class="text-muted small">File Name</label>
                                        <div>@Statement.FileNameOriginal</div>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="text-muted small">File Type</label>
                                        <div>@Statement.FileType</div>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="text-muted small">File Size</label>
                                        <div>@Statement.FileSizeBytes bytes</div>
                                    </div>

                                    @* <div class="col-md-12 mb-3">
                                        <label class="text-muted small">Hash (Preview)</label>
                                        <div class="text-truncate text-monospace">
                                            Will be generated and locked on import
                                        </div>
                                    </div> *@
                                }
                            </div>

                        @if (ShowPreview && PreviewLines.Any())
                        {
                            <hr class="mt-4" />

                            <h6 class="text-primary mb-2">
                                <i class="ti ti-eye me-1"></i> Statement Preview (First 10 Lines)
                            </h6>

                            <div class="table-responsive">
                                <table class="table table-bordered table-sm">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>#</th>
                                            <th>Date</th>
                                                <th class="d-none d-md-table-cell">Narration</th>
                                            <th class="text-end">Debit</th>
                                            <th class="text-end">Credit</th>
                                            <th class="text-end">Balance</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < PreviewLines.Count; i++)
                                        {
                                            var l = PreviewLines[i];
                                            <tr>
                                                <td>@(i + 1)</td>
                                                <td>@l.Date</td>
                                                    <td class="d-none d-md-table-cell">@l.Narration</td>
                                                <td class="text-end">@l.Debit</td>
                                                <td class="text-end">@l.Credit</td>
                                                <td class="text-end">@l.Balance</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        }


                        <!-- STEP 3: PARSING PROFILE -->
                        @if (CurrentStep == 3)
                        {
                            <div class="row mt-3">

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Statement Profile <span class="text-danger">*</span>
                                    </label>

                                    <InputSelect class="@($"form-select {(ShowFieldError(3, nameof(Statement.StatementProfile)) ? "is-invalid" : "")}")"
                                                 @bind-Value="Statement.StatementProfile">
                                                 <option value="">--Select Statement Profile--</option>
                                        @foreach (StatementProfileType profile in
                                                                        Enum.GetValues(typeof(StatementProfileType)))
                                        {
                                            <option value="@profile">@profile</option>
                                        }

                                    </InputSelect>
                                    @if (ShowFieldError(3, "StatementProfile"))
                                    {
                                        <small class="text-danger">Statement Profile is required</small>
                                    }
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Profile Version <span class="text-danger">*</span></label>
                                    <InputText class="@($"form-control {(ShowFieldError(3, nameof(Statement.ProfileVersion)) ? "is-invalid" : "")}")"
                                               @bind-Value="Statement.ProfileVersion" maxlength="20"
                                               placeholder="v1.0" />
                                    @if (ShowFieldError(3, "ProfileVersion"))
                                    {
                                        <small class="text-danger">Profile Version is required</small>
                                    }
                                </div>



                            </div>
                        }


                        <!-- FOOTER -->
                        <div class="d-flex justify-content-end gap-2 mt-4 mb-4">

                            @if(CurrentStep != 1){

                       
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    @onclick="Back"
                                    disabled="@(CurrentStep == 1)">
                                    <i class="ti ti-chevron-left"></i> Previous
                            </button>
                                 }

                            @if (CurrentStep < Steps.Count)
                            {
                                <button type="button"
                                        class="btn btn-primary"
                                        @onclick="Next">
                                    Next <i class="ti ti-chevron-right"></i>
                                </button>
                            }
                            else
                            {
                                <button type="submit"
                                        class="btn btn-primary">
                                    <i class="ti ti-device-floppy"></i> Import
                                </button>
                            }
                        </div>




                    </div>
              

                    <aside class="summary p-3 rounded d-none d-xl-flex" style="height: auto;
                                    background: white;
                                        border: none;    display: flex;
                                        padding-left: 32px !important;
                                    padding-top: 42px !important;">
                        <div class="timeline-line1"></div>

                        <div class="timeline-indicator1"></div>
                        <div style="padding-left: 15px;
                                    width: 262px;">
                            <h3 class="text-warning mb-3" style="font-size: 17px;">Live Summary</h3>

                            <div class="row">
    @if (CurrentStep == 1)
    {
                                                           <div class="col-md-12 mb-3">
                                        <span>Bank Account: </span><b>@SelectedBankAccountName </b>
                                </div>
                                <div class="col-md-12 mb-3">
                                    <span>Company : </span><b>@(Statement.CompanyName??"-")</b>
                                </div>
                                <div class="col-md-12 mb-3">
                                    <span>Branch: </span><b>@Statement.BranchName</b>
                                </div>
                                }
                                 @if (CurrentStep == 2)
                                    {
                                <div class="col-md-12 mb-3">
                                    <span>Import Source : </span><b>@Statement.ImportSource</b>
                                </div>
                                <div class="col-md-12 mb-3">
                                        <span>Upload Statement File : </span><b>@Statement.FileNameOriginal</b>
                                </div>
                                    }
                                 @if (CurrentStep == 3)
                                    {
                                <div class="col-md-12 mb-3">
                                        <span>Statement Profile : </span><b>@Statement.StatementProfile</b>
                                </div>
                                <div class="col-md-12 mb-3">
                                        <span>Profile Version  : </span><b>@Statement.ProfileVersion</b>
                                </div>
                                    }
                            </div>
                        </div>
                    </aside>


                </div>
            </div>

        </EditForm>


    </div>
}
