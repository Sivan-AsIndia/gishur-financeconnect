@page "/bank-statements"
@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
    <div class="content List-view">

        <!-- PAGE HEADER -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Bank Statements</h4>
                    <h6>External bank evidence & import registry</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a class="btn btn-primary"
                href="javascript:void(0);"
                @onclick="ImportStatement">
                    <i class="ti ti-upload me-1"></i>
                    Import Statement
                </a>
            </div>
        </div>

        <!-- Statistics Cards -->

        <div class="row mb-0">
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="    background: linear-gradient(135deg, #009ac8, #00bfc1) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Total</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.TotalStatements</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-white rounded-circle p-2" style="background: #ffffff47;width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;">
                                <i class="ti ti-file-invoice" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #092c4c, #00396e) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Uploaded</h6>
                                <h5 class="mb-0 fw-bold text-secondary text-white">@Statistics.UploadedStatements</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-secondary rounded-circle p-2" style="background: #ffffff47;width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;">
                                <i class="ti ti-file-text text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #155eef, #002e8b) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Reconciliation</h6>
                                <h5 class="mb-0 fw-bold text-info text-white">@Statistics.ReadyForReconciliationStatements</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-info rounded-circle p-2" style="background: #ffffff47;width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;">
                                <i class="ti ti-send text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(343deg, #b73e3e, #ff8d21) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Locked</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.LockedStatements</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-success rounded-circle p-2" style="background: #ffffff47;width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;">
                                <i class="ti ti-check text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #3eb780, #008146) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Archived</h6>
                                <h5 class="mb-0 fw-bold text-danger text-white">@Statistics.ArchivedStatements</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-danger rounded-circle p-2" style="background: #ffffff47;width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;">
                                <i class="ti ti-circle-check text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="    background: linear-gradient(135deg, #ffca1f, #e8b200) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">
                                    Superseded
                                </h6>
                                <h5 class="mb-0 fw-bold text-warning text-white" style="font-size: 14px;">@Statistics.SupersededStatements</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-warning rounded-circle p-2" style="background: #ffffff47;width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;">
                                <i class="ti ti-currency-rupee text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- STATEMENT LIST -->
        <div class="card">

            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

                <!-- Search -->
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset">
                            <i class="ti ti-search fs-14"></i>
                        </span>
                        <input type="search"
                        class="form-control form-control-sm"
                        placeholder="Search statement no / bank / file name"
                        @bind="searchText"
                        @oninput="OnSearch" />
                    </div>
                </div>

                <!-- Status Filter -->
                <div>
                    <select class="form-select form-select-sm"
                    @bind="SelectedStatus">
                        <option value="">--Select Status--</option>
                        @foreach (var s in AvailableStatuses)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
            </div>

            <div class="card-body p-0">
                <table class="table align-middle w-100 table-fixed">
                    <thead class="thead-light">
                        <tr>
                            <th class="d-xl-none" style="width:40px"></th>
                            <th title="Statement No">Statement No</th>
                            <th class="d-none d-md-table-cell">Bank Account</th>
                            <th class="d-none d-md-table-cell">Period</th>
                            <th class="d-none d-xxl-table-cell" style="width: 147px;">Credits</th>
                            <th class="d-none d-xxl-table-cell" style="width: 147px;">Debits</th>
                            <th class="d-none d-xxl-table-cell" style="width: 147px;">Lines</th>
                            @* <th class="d-none d-xxl-table-cell">Profile</th> *@
                            <th class="d-lg-none d-md-none" title="Status" style="width: 82px;">Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (PagedStatements.Any())
                        {
                            @foreach (var s in PagedStatements)
                            {
                                <tr>
                                    <!-- PLUS ICON -->
                                    <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                        <a href="javascript:void(0);" class="TablePlus"
                                        data-bs-toggle="modal"
                                        data-bs-target="#rowDetailsModal"
                                        @onclick="() => SelectStatement(s)">
                                            <i class="ti ti-plus"></i>
                                        </a>
                                    </td>
                                    <td>
                                        <span>
                                            <i class="ti ti-external-link me-2 PopupIcon"></i>
                                            <a href="javascript:void(0);" data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            class="fw-medium link-View" title="@s.StatementNumber Details"
                                            @onclick="() => ViewStatement(s)">
                                                @s.StatementNumber
                                            </a>
                                        </span>
                                    </td>

                                    <td class="d-none d-md-table-cell">@s.BankAccountName</td>

                                    <td class="d-none d-md-table-cell" >
                                        @s.StatementFromDate.ToShortDateString()-
                                        @s.StatementToDate.ToShortDateString()
                                    </td>

                                    <td class="d-none d-xxl-table-cell">
                                        <span class="text-success fw-medium">

                                            ₹@IndianNumberFormatter.Format(@s.TotalCreditsAmount)

                                        </span>
                                    </td>

                                    <td class="d-none d-xxl-table-cell">
                                        <span class="text-danger fw-medium">
                                            @* ₹@s.TotalDebitsAmount *@
                                            ₹@IndianNumberFormatter.Format(@s.TotalDebitsAmount)

                                        </span>
                                    </td>

                                    <td class="d-none d-xxl-table-cell">
                                        @s.TotalLineCount
                                    </td>

                                    @* <td class="d-none d-xxl-table-cell">
                                        <span class="badge bg-soft-info text-info">
                                            @s.StatementProfile
                                        </span>
                                    </td> *@

                                    <td class="d-lg-none d-md-none">
                                        <span class="badge @GetStatusBadgeClass(s.StatementStatus)"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        title="@s.StatementStatus.ToString()">

                                            <i class="@GetStatusIconClass(s.StatementStatus) "></i>

                                        </span>
                                    </td>


                                    <td class="action-table-data">
                                        <div class="edit-delete-action">


                                            @if (s.StatementStatus == StatementStatusType.ReadyForReconciliation)
                                            {
                                                <a class="me-2 Toggle-icon p-1 action-icon lock"
                                                title="Lock"
                                                data-bs-toggle="modal"
                                                data-bs-target="#lock-modal"
                                                @onclick="() => SelectStatement(s)">
                                                    <i class="ti ti-lock"></i>
                                                </a>
                                            }

                                            @if (s.StatementStatus != StatementStatusType.Locked)
                                            {
                                                <a class="me-2 Toggle-icon p-1 action-icon Supersede"
                                                title="Supersede"
                                                data-bs-toggle="modal"
                                                data-bs-target="#supersede-modal"
                                                @onclick="() => SelectStatement(s)">
                                                    <i class="ti ti-repeat"></i>
                                                </a>
                                            }
                                            @if (s.StatementStatus == StatementStatusType.Locked)
                                            {
                                                <a class="me-2 Toggle-icon p-1 action-icon"
                                                title="Archive"
                                                data-bs-toggle="modal"
                                                data-bs-target="#archive-modal"
                                                @onclick="() => SelectStatement(s)">
                                                    <i class="ti ti-archive"></i>
                                                </a>
                                            }
                                            @if (s.StatementStatus != StatementStatusType.Locked && s.StatementStatus != StatementStatusType.Archived)
                                            {
                                                <a class="p-1 delete-icon" title="Delete" data-bs-toggle="modal" data-bs-target="#delete-modal" @onclick="() => SelectStatement(s)">
                                                    <i data-feather="trash-2"></i>
                                                </a>                                            
                                            }
                                        </div>
                                    </td> 
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@VisibleColumnCount" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                        No Bank Statements found
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (PagedStatements.Any())
                {
                    <!-- PAGINATION -->
                    <div class="d-flex justify-content-between align-items-center p-3" id="RowsPerPageContent">

                        <div class="d-flex align-items-center">
                            <span class="me-2">Row Per Page</span>
                            <select class="form-select form-select-sm w-auto"
                            @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">

                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                    @onclick="PreviousPage"
                                    @onclick:preventDefault>
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>

                                @foreach (var p in VisiblePages)
                                {
                                    <li class="page-item @(p == CurrentPage ? "active" : "")">
                                        <button class="page-link"
                                        @onclick="() => GoToPage(p)">
                                            @p
                                        </button>
                                    </li>
                                }

                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                    @onclick="NextPage"
                                    @onclick:preventDefault>
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
}
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Bank Statement Details</h5>
                    <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    style="padding:0; right:22px; position:absolute; transform:none">
                    </button>
                </div>

                @if (SelectedStatement != null)
                {
                    <div class="modal-body">

                        <!-- Statement Ref -->
                        <div class="mb-2 d-flex gap-3 d-md-none">
                            <strong>Statement:</strong>
                            <div>@SelectedStatement.StatementNumber</div>
                        </div>

                        <!-- Bank Account -->
                        <div class="mb-2 d-flex gap-3 d-md-none">
                            <strong>Bank:</strong>
                            <div>@SelectedStatement.BankAccountName</div>
                        </div>

                        <!-- Period -->
                        <div class="mb-2 d-flex gap-3">
                            <strong>Period:</strong>
                            <div>
                                @SelectedStatement.StatementFromDate.ToString("dd MMM yyyy")
                                –
                                @SelectedStatement.StatementToDate.ToString("dd MMM yyyy")
                            </div>
                        </div>

                        <!-- Totals -->
                        <div class="mb-2 d-flex gap-3">
                            <strong>Credits:</strong>
                            <div class="text-success fw-medium">
                                ₹@SelectedStatement.TotalCreditsAmount.ToString("N2")
                            </div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Debits:</strong>
                            <div class="text-danger fw-medium">
                                ₹@SelectedStatement.TotalDebitsAmount.ToString("N2")
                            </div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Net Movement:</strong>
                            <div class="fw-medium">
                                ₹@SelectedStatement.NetMovementAmount.ToString("N2")
                            </div>
                        </div>

                        <!-- Balance Check -->
                        <div class="mb-2 gap-3">
                            <strong>Balance Check:</strong>
                            <span class="badge @(SelectedStatement.BalanceCheckStatus == BalanceCheckStatusType.Matched
                                                                            ? "bg-success-transparent text-success"
                                                                            : "bg-warning-transparent text-warning")">
                                @SelectedStatement.BalanceCheckStatus
                            </span>
                        </div>

                        <!-- Profile -->
                        <div class="mb-2 d-flex gap-3">
                            <strong>Profile:</strong>
                            <div>
                                @SelectedStatement.StatementProfile
                                (@SelectedStatement.ProfileVersion)
                            </div>
                        </div>

                        <!-- File Evidence -->
                        <hr />
                        <div class="mb-2 d-flex gap-3">
                            <strong>File:</strong>
                            <div class="text-truncate"
                            style="max-width: 95%;"
                            title="@SelectedStatement.FileNameOriginal">
                                @SelectedStatement.FileNameOriginal
                            </div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Type:</strong>
                            <div>@SelectedStatement.FileType</div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Size:</strong>
                            <div>@SelectedStatement.FileSizeBytes bytes</div>
                        </div>

                        <!-- Governance -->
                        <hr />
                        <div class="mb-2 gap-3">
                            <strong>Status:</strong>
                            <span class="badge @GetStatusBadgeClass(SelectedStatement.StatementStatus)">
                                @SelectedStatement.StatementStatus
                            </span>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Imported By:</strong>
                            <div>@SelectedStatement.FileUploadedBy</div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Imported At:</strong>
                            <div>
                                @SelectedStatement.FileUploadedAt.ToString("dd MMM yyyy HH:mm")
                            </div>
                        </div>

                        @if (SelectedStatement.StatementStatus == StatementStatusType.Locked)
                        {
                            <div class="mb-2 d-flex gap-3">
                                <strong>Locked By:</strong>
                                <div>@SelectedStatement.LockedBy</div>
                            </div>

                            <div class="mb-2 d-flex gap-3">
                                <strong>Locked On:</strong>
                                <div>
                                    @SelectedStatement.LockedOn?.ToString("dd MMM yyyy HH:mm")
                                </div>
                            </div>
                        }

                    </div>
                }
            </div>
        </div>
    </div>


    <div class="modal fade" id="lock-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                        <i class="ti ti-lock fs-24 text-warning"></i>
                    </span>

                    <h4 class="fs-20 fw-bold mb-2 mt-1">Lock Bank Statement</h4>

                    <p class="text-gray-6 mb-3">
                    Are you sure you want to lock the
                        <strong>@SelectedStatement?.StatementNumber</strong>.
                        <br />
                        Once locked, this statement cannot be reprocessed or deleted.
                    </p>

                    <div class="modal-footer-btn d-flex justify-content-center">
                        <button class="btn btn-outline-secondary me-2"
                        data-bs-dismiss="modal">
                        <i class="ti ti-x"></i>  Cancel
                        </button>

                        <button class="btn btn-warning" data-bs-dismiss="modal"
                        @onclick="LockConfirmed">
                        <i class="ti ti-lock"></i> Yes, Lock
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>


    <div class="modal fade" id="supersede-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="p-4">

                    <h5 class="fw-bold mb-2">
                        <i class="ti ti-repeat me-2 text-warning"></i>
                        Supersede Statement
                    </h5>

                    <p class="text-muted">
                    Are you sure you want to mark 
                        <strong>@SelectedStatement?.StatementNumber</strong>
                    as superseded and import a corrected statement file?
                    </p>

                    <div class="mb-3">
                        <label class="form-label">
                            Supersede Reason <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control"
                        rows="3"
                        placeholder="Explain why this statement is being replaced..."
                        @bind="SupersedeReason"></textarea>
                    </div>

                    <div class="modal-footer-btn d-flex justify-content-end">
                        <button class="btn btn-outline-secondary me-2"
                        data-bs-dismiss="modal">
                        <i class="ti ti-x"></i> Cancel
                        </button>

                        <button class="btn btn-warning" data-bs-dismiss="modal"
                        disabled="@string.IsNullOrWhiteSpace(SupersedeReason)"
                        @onclick="SupersedeConfirmed">
                        <i class="ti ti-repeat me-2"></i> Supersede
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>


    <div class="modal fade" id="archive-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-info-transparent mb-2">
                        <i class="ti ti-archive fs-24 text-info"></i>
                    </span>

                    <h4 class="fs-20 fw-bold mb-2 mt-1">
                        Archive Statement
                    </h4>

                    <p class="text-gray-6 mb-3">
                        You are archiving
                        <strong>@SelectedStatement?.StatementNumber</strong>.
                        <br />
                        Archived statements remain as audit evidence and cannot be used in reconciliation.
                    </p>

                    <div class="modal-footer-btn d-flex justify-content-center">
                        <button class="btn btn-secondary me-2"
                        data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button class="btn btn-info" data-bs-dismiss="modal"
                        @onclick="ArchiveConfirmed">
                            Yes, Archive
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>



    <!-- delete modal -->
    <div class="modal fade" id="delete-modal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Journal Entry</h4>
                        <p class="text-gray-6 mb-0 fs-16">Are you sure you want to delete <strong>@SelectedStatement?.StatementNumber</strong>?</p>
                        <div class="modal-footer-btn mt-3 d-flex justify-content-center">
                            <button type="button" class="btn me-2 btn-outline-secondary fs-13 fw-medium p-2 px-3 shadow-none" data-bs-dismiss="modal"><i class="ti ti-x"></i> Cancel</button>
                            <button type="submit" class="btn btn-danger fs-13 fw-medium p-2 px-3" data-bs-dismiss="modal" @onclick="DeleteConfirmed"><i class="ti ti-trash"></i> Yes Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>