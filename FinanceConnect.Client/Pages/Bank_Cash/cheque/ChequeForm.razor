@page "/cheques/create"
@page "/cheques/edit/{Id:guid}"

@inject ChequeService Service
@inject BranchService BranchService
@inject BankAccountService backAccount
@inject NavigationManager Nav

<style>
    .form-select option:checked {
        color: #fff;
        background: var(--primary);
    }

    .form-select:focus {
        border-color: var(--primary);
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }

    .form-select.is-invalid {
        border-color: #dc3545;
    }

    .field-validation-error {
        color: #dc3545;
        font-size: 12px;
        display: block;
        margin-top: 4px;
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else
{
    <div class="content Accordion-form">

        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">@PageTitle</h4>
                    <h6>@PageSubTitle</h6>
                </div>
            </div>

            <div class="page-btn mt-0">
                <button type="button" class="btn btn-outline-secondary" @onclick="GoBackToList">
                    <i class="ti ti-arrow-left me-1"></i> Back
                </button>
            </div>
        </div>

        <EditForm EditContext="_editcontext" OnSubmit="Save">
            <DataAnnotationsValidator />

            <div class="add-product" style="background:#f4f7fb; padding:24px 14px;">
                <div class="tl-accordion">

                    @* ══════ LEFT PANEL – Fixed sidebar ══════ *@
                    <div class="tl-left-panel">

                        <div class="tl-label @(ShowCore ? "active accent-orange" : "")"
                             @onclick="@(() => ToggleAccordion("core"))">
                            <div class="tl-label-icon ico-orange"><i data-feather="file-text"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Core</div>
                                <div class="tl-label-sub">Branch, direction & cheque number</div>
                            </div>
                            <span class="tl-label-chevron @(ShowCore ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowInstrument ? "active accent-blue" : "")"
                             @onclick="@(() => ToggleAccordion("instrument"))">
                            <div class="tl-label-icon ico-blue"><i data-feather="credit-card"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Instrument Details</div>
                                <div class="tl-label-sub">Date, amount, payee & crossing</div>
                            </div>
                            <span class="tl-label-chevron @(ShowInstrument ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowCounterparty ? "active accent-purple" : "")"
                             @onclick="@(() => ToggleAccordion("counterparty"))">
                            <div class="tl-label-icon ico-purple"><i data-feather="users"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Counterparty & Bank</div>
                                <div class="tl-label-sub">Counterparty details and bank info</div>
                            </div>
                            <span class="tl-label-chevron @(ShowCounterparty ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowLinkage ? "active accent-teal" : "")"
                             @onclick="@(() => ToggleAccordion("linkage"))">
                            <div class="tl-label-icon ico-teal"><i data-feather="link"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Linkage & Notes</div>
                                <div class="tl-label-sub">Source, bounce details & narration</div>
                            </div>
                            <span class="tl-label-chevron @(ShowLinkage ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowLifecycle ? "active accent-orange" : "")"
                             @onclick="@(() => ToggleAccordion("lifecycle"))">
                            <div class="tl-label-icon ico-orange"><i data-feather="git-branch"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Lifecycle</div>
                                <div class="tl-label-sub">Lifecycle dates and timestamps</div>
                            </div>
                            <span class="tl-label-chevron @(ShowLifecycle ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                    </div>

                    @* ══════ RIGHT AREA – Timeline dots + Expanding Cards ══════ *@
                    <div class="tl-right-area">

                        @* ── 1. Core ── *@
                        <div class="tl-card-row @(ShowCore ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("core"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowCore ? "card-active border-orange" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("core"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-orange">01</span>
                                            Core
                                        </div>
                                        <span class="tl-card-toggle @(ShowCore ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>
                                    <div class="tl-collapse @(ShowCore ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(CoreTouched ? "touched" : "")">
                                                <div class="row">

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Branch <span class="text-danger ms-1">*</span></label>
                                                        <select class="@($"form-select {(HasBranchError() ? "is-invalid" : "")}")"
                                                                value="@model.BranchId"
                                                                @onchange="OnBranchChanged">
                                                            <option value="">-- Select Branch --</option>
                                                            @foreach (var b in Branches)
                                                            {
                                                                <option value="@b.Id">@b.BranchCode - @b.BranchName</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="() => model.BranchId" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Direction <span class="text-danger ms-1">*</span></label>
                                                        <div class="d-flex gap-3 mt-2">
                                                            <InputRadioGroup @bind-Value="model.Direction" Name="direction">
                                                                <div class="form-check">
                                                                    <InputRadio class="form-check-input" Value="ChequeDirection.Outgoing" disabled="@isEdit" />
                                                                    <label class="form-check-label">Outgoing</label>
                                                                </div>
                                                                <div class="form-check">
                                                                    <InputRadio class="form-check-input" Value="ChequeDirection.Incoming" disabled="@isEdit" />
                                                                    <label class="form-check-label">Incoming</label>
                                                                </div>
                                                            </InputRadioGroup>
                                                        </div>
                                                        <ValidationMessage For="() => model.Direction" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Status</label>
                                                        <div class="mt-2">
                                                            <span class="badge @GetStatusBadge(model.Status)">
                                                                <i class="@GetStatusIcon(model.Status) me-1"></i>
                                                                @model.Status
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Cheque No <span class="text-danger ms-1">*</span></label>
                                                        <InputText class="@($"form-control {GetValidationClass(() => model.ChequeNumber)}")"
                                                                   @bind-Value="model.ChequeNumber"
                                                                   disabled="@isLocked" />
                                                        <ValidationMessage For="() => model.ChequeNumber" />
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* ── 2. Instrument Details ── *@
                        <div class="tl-card-row @(ShowInstrument ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("instrument"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowInstrument ? "card-active border-blue" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("instrument"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-blue">02</span>
                                            Instrument Details
                                        </div>
                                        <span class="tl-card-toggle @(ShowInstrument ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>
                                    <div class="tl-collapse @(ShowInstrument ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(InstrumentTouched ? "touched" : "")">
                                                <div class="row">

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Cheque Date <span class="text-danger ms-1">*</span></label>
                                                        <InputDate class="form-control" @bind-Value="model.ChequeDate" disabled="@isLocked" />
                                                        <ValidationMessage For="() => model.ChequeDate" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Cheque Amount <span class="text-danger ms-1">*</span></label>
                                                        <InputNumber class="@($"form-control {GetValidationClass(() => model.Amount)}")"
                                                                     @bind-Value="model.Amount" disabled="@isLocked" />
                                                        <ValidationMessage For="() => model.Amount" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Currency</label>
                                                        <InputText class="form-control" @bind-Value="model.Currency" disabled />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">
                                                            Payee Name <span class="text-danger" hidden="@(model.Direction != ChequeDirection.Outgoing)">*</span>
                                                        </label>
                                                        <InputText class="@($"form-control {GetValidationClass(() => model.PayeeName)}")"
                                                                   @bind-Value="model.PayeeName" maxlength="200" />
                                                        @if (model.Direction == ChequeDirection.Outgoing)
                                                        {
                                                            <ValidationMessage For="() => model.PayeeName" />
                                                        }
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Crossing Type</label>
                                                        <InputSelect class="form-select" @bind-Value="model.CrossingType">
                                                            <option value="">-- Select Crossing Type --</option>
                                                            <option>None</option>
                                                            <option>A/C Payee</option>
                                                            <option>Crossed</option>
                                                            <option>Bearer</option>
                                                            <option>Self</option>
                                                        </InputSelect>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* ── 3. Counterparty & Bank ── *@
                        <div class="tl-card-row @(ShowCounterparty ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("counterparty"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowCounterparty ? "card-active border-purple" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("counterparty"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-purple">03</span>
                                            Counterparty & Bank
                                        </div>
                                        <span class="tl-card-toggle @(ShowCounterparty ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>
                                    <div class="tl-collapse @(ShowCounterparty ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(CounterpartyTouched ? "touched" : "")">

                                                <!-- Counterparty Section -->
                                                <h6 class="text-primary mb-3"><i class="ti ti-users me-2"></i>Counterparty</h6>
                                                <div class="row mb-4">
                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Counterparty Type <span class="text-danger ms-1">*</span></label>
                                                        <InputSelect class="@($"form-select {GetValidationClass(() => model.CounterpartyType)}")" @bind-Value="model.CounterpartyType">
                                                            <option value="">-- Select Counterparty Type --</option>
                                                            <option>Vendor</option>
                                                            <option>Customer</option>
                                                            <option>Employee</option>
                                                            <option>Other</option>
                                                        </InputSelect>
                                                        <ValidationMessage For="() => model.CounterpartyType" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Counterparty</label>
                                                        <InputText class="form-control" @bind-Value="model.CounterpartyName"
                                                                   disabled="@isLocked" maxlength="200" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Counterparty Contact</label>
                                                        <InputText class="form-control" @bind-Value="model.CounterpartyContact"
                                                                   placeholder="Optional" maxlength="200" />
                                                    </div>
                                                </div>

                                                <!-- Bank Section -->
                                                <h6 class="text-primary mb-3"><i class="ti ti-building-bank me-2"></i>Bank</h6>
                                                <div class="row">
                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Our Bank Account <span class="text-danger ms-1">*</span></label>
                                                        <InputSelect class="@($"form-select {GetValidationClass(() => model.OurBankAccountId)}")"
                                                                     @bind-Value="model.OurBankAccountId" disabled="@isLocked">
                                                            <option value="">-- Select Bank Account --</option>
                                                            @foreach (var account in BankAccounts)
                                                            {
                                                                <option value="@account.Id">@account.BankAccountName</option>
                                                            }
                                                        </InputSelect>
                                                        <ValidationMessage For="() => model.OurBankAccountId" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Drawer Bank</label>
                                                        <InputText class="form-control" @bind-Value="model.DrawerBankName"
                                                                   maxlength="150" placeholder="Optional – Auto-extracted for incoming"
                                                                   disabled="@isLocked" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Drawer Bank Branch</label>
                                                        <InputText class="form-control" @bind-Value="model.DrawerBankBranch"
                                                                   maxlength="150" placeholder="Optional – branch name"
                                                                   disabled="@isLocked" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Drawer Account (Masked)</label>
                                                        <InputText class="form-control" @bind-Value="model.DrawerAccountMasked"
                                                                   maxlength="30" placeholder="Optional – masked only"
                                                                   disabled="@isLocked" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">MICR / IFSC</label>
                                                        <InputText class="form-control" @bind-Value="model.MICR_IFSC"
                                                                   maxlength="20" placeholder="Optional – future-ready"
                                                                   disabled="@isLocked" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 d-flex align-items-center mt-3 mb-3">
                                                        <div class="form-check form-switch">
                                                            <InputCheckbox class="form-check-input" @bind-Value="model.IsCTSCompliant"
                                                                           disabled="@isLocked" />
                                                            <label class="form-check-label">CTS Compliant</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* ── 4. Linkage & Notes ── *@
                        <div class="tl-card-row @(ShowLinkage ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("linkage"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowLinkage ? "card-active border-teal" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("linkage"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-teal">04</span>
                                            Linkage & Notes
                                        </div>
                                        <span class="tl-card-toggle @(ShowLinkage ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>
                                    <div class="tl-collapse @(ShowLinkage ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(LinkageTouched ? "touched" : "")">

                                                <!-- Linkage -->
                                                <h6 class="text-primary mb-3"><i class="ti ti-link me-2"></i>Linkage</h6>
                                                <div class="row mb-4">
                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Source Module</label>
                                                        <InputSelect class="form-select" @bind-Value="model.SourceModule">
                                                            <option value="">-- Select Source Module --</option>
                                                            <option value="AP">AP</option>
                                                            <option value="AR">AR</option>
                                                            <option value="CashBank">CashBank</option>
                                                            <option value="System">System</option>
                                                        </InputSelect>
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Source Document Type</label>
                                                        <InputSelect class="form-select" @bind-Value="model.SourceDocumentType">
                                                            <option value="">-- Select Source Document Type --</option>
                                                            <option value="VendorPayment">Vendor Payment</option>
                                                            <option value="CustomerPayment">Customer Payment</option>
                                                            <option value="ManualCheque">Manual Cheque</option>
                                                        </InputSelect>
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Source Document No</label>
                                                        <input class="form-control" value="@model.SourceDocumentNo" disabled />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Bank Transaction</label>
                                                        <input class="form-control" value="@model.BankTransactionId" disabled />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Reconciliation</label>
                                                        <input class="form-control" value="@model.ReconciliationId" disabled />
                                                    </div>
                                                </div>

                                                <!-- Bounce / Charges -->
                                                <h6 class="text-primary mb-3"><i class="ti ti-alert-triangle me-2"></i>Bounce / Charges</h6>
                                                <div class="row mb-4">
                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Bounce Reason Code</label>
                                                        <InputSelect class="form-select" @bind-Value="model.BounceReason">
                                                            <option value="">-- Select Bounce Reason Code --</option>
                                                            <option value="InsufficientFunds">Insufficient Funds</option>
                                                            <option value="SignatureMismatch">Signature Mismatch</option>
                                                            <option value="StaleCheque">Stale Cheque</option>
                                                            <option value="StopPayment">Stop Payment</option>
                                                            <option value="AccountClosed">Account Closed</option>
                                                            <option value="Other">Other</option>
                                                        </InputSelect>
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Bounce Reason Details</label>
                                                        <InputText class="form-control" @bind-Value="model.BounceReasonText"
                                                                   placeholder="Additional details..." maxlength="500" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Bounce Charges Amount</label>
                                                        <InputNumber class="form-control" @bind-Value="model.BounceCharges" min="0" />
                                                    </div>
                                                </div>

                                                <!-- Notes & Narration -->
                                                <h6 class="text-primary mb-3"><i class="ti ti-notes me-2"></i>Notes & Narration</h6>
                                                <div class="row">
                                                    <div class="col-12 mb-3">
                                                        <label class="form-label">Narration</label>
                                                        <RichTextEditor @ref="_narrationEditor"
                                                                        Value="@model.Narration"
                                                                        Placeholder="Transaction narration..."
                                                                        MinHeight="80"
                                                                        MaxHeight="200" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* ── 5. Lifecycle ── *@
                            <div class="tl-card-row @(ShowLifecycle ? "row-active" : "")">
                                <div class="tl-dot-col">
                                    <div class="tl-dot" @onclick="@(() => ToggleAccordion("lifecycle"))"></div>
                                </div>
                                <div class="tl-card-col">
                                    <div class="tl-card @(ShowLifecycle ? "card-active border-orange" : "")">
                                        <div class="tl-card-header" @onclick="@(() => ToggleAccordion("lifecycle"))">
                                            <div class="tl-card-header-title">
                                                <span class="tl-card-step step-orange">05</span>
                                                Lifecycle
                                            </div>
                                            <span class="tl-card-toggle @(ShowLifecycle ? "toggle-open" : "")">
                                                <i data-feather="chevron-down"></i>
                                            </span>
                                        </div>
                                        <div class="tl-collapse @(ShowLifecycle ? "tl-open" : "")">
                                            <div class="tl-card-body">
                                                <div class="tl-card-body-inner">
                                                    <div class="row">

                                                        <div class="col-sm-6 col-md-4 mb-3">
                                                            <label class="form-label">Prepared On</label>
                                                            <InputDate class="form-control" @bind-Value="model.PreparedOn" />
                                                        </div>
                                                        <div class="col-sm-6 col-md-4 mb-3">
                                                            <label class="form-label">Printed On</label>
                                                            <InputDate class="form-control" @bind-Value="model.PrintedOn" />
                                                        </div>
                                                        <div class="col-sm-6 col-md-4 mb-3">
                                                            <label class="form-label">Issued/Received On</label>
                                                            <InputDate class="form-control" @bind-Value="model.IssuedOrReceivedOn" />
                                                        </div>
                                                        <div class="col-sm-6 col-md-4 mb-3">
                                                            <label class="form-label">Deposited On</label>
                                                            <InputDate class="form-control" @bind-Value="model.DepositedOn" />
                                                        </div>
                                                        <div class="col-sm-6 col-md-4 mb-3">
                                                            <label class="form-label">Presented On</label>
                                                            <InputDate class="form-control" @bind-Value="model.PresentedOn" />
                                                        </div>
                                                        <div class="col-sm-6 col-md-4 mb-3">
                                                            <label class="form-label">Cleared On</label>
                                                            <InputDate class="form-control" @bind-Value="model.ClearedOn" />
                                                        </div>
                                                        <div class="col-sm-6 col-md-4 mb-3">
                                                            <label class="form-label">Bounced On</label>
                                                            <InputDate class="form-control" @bind-Value="model.BouncedOn" />
                                                        </div>
                                                        <div class="col-sm-6 col-md-4 mb-3">
                                                            <label class="form-label">Stopped On</label>
                                                            <InputDate class="form-control" @bind-Value="model.StoppedOn" />
                                                        </div>
                                                        <div class="col-sm-6 col-md-4 mb-3">
                                                            <label class="form-label">Cancelled On</label>
                                                            <InputDate class="form-control" @bind-Value="model.CancelledOn" />
                                                        </div>
                                                        <div class="col-sm-6 col-md-4 mb-3">
                                                            <label class="form-label">Stale On</label>
                                                            <InputDate class="form-control" @bind-Value="model.StaleOn" />
                                                        </div>
                                                        <div class="col-sm-6 col-md-4 mb-3">
                                                            <label class="form-label">Expected Clear By</label>
                                                            <InputDate class="form-control" @bind-Value="model.ExpectedClearBy" />
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                    </div>

                </div>
            </div>

            <div class="page-btn d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary" @onclick="GoBackToList">
                    <i class="ti ti-x me-1"></i> Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i> @(isEdit ? "Update" : "Save")
                </button>
            </div>

        </EditForm>

    </div>
}
