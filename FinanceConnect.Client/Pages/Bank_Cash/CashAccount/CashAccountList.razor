@page "/cash-accounts"
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject ToastService ToastService



<div class="content List-view">

    <!-- Page Header -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Cash Accounts</h4>
                <h6>Manage cash holding points</h6>
            </div>
        </div>

        <ul class="table-top-head me-2">
            <li>
                <a title="Refresh" @onclick="Reload">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>

        <div class="page-btn">
            <a href="/cash-accounts/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i>
                Create
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset">
                        <i class="ti ti-search fs-14"></i>
                    </span>
                    <input type="search"
                           class="form-control form-control-sm"
                           placeholder="Search code or name..."
                           @bind="SearchText"
                           @oninput="OnSearch" />
                </div>
            </div>

            <div style="display:flex;gap:10px;">
                <select class="form-select" style="min-width:160px"
                        @bind="SelectedBranchId">

                    <option value="">All Branches</option>

                    @foreach (var branch in Branches)
                    {
                        <option value="@branch.Id">@branch.BranchCode - @branch.BranchName</option>
                    }
                </select>

                <select class="form-select form-select-sm" style="min-width:140px"
                        @bind="SelectedStatus">
                    <option value="">All Status</option>
                    @foreach (var status in DistinctStatuses)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
        </div>

        <!-- Table -->
        <div class="card-body p-0">
            <table class="table align-middle w-100 table-fixed">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xl-none" style="width:40px"></th>

                        <th>Code</th>
                        <th>Name</th>
                        <th class="d-none d-md-table-cell">Branch</th>
                        @* <th class="d-none d-xl-table-cell">Custodian</th> *@
                        @* <th class="d-none d-xxl-table-cell">Currency</th> *@
                        @* <th class="d-none d-xxl-table-cell">GL Account</th> *@
                        <th class="d-none d-md-table-cell text-end">Max Limit</th>
                        <th class="d-none d-md-table-cell text-center">Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (PagedAccounts.Any())
                    {
                        @foreach (var acc in PagedAccounts)
                        {
                            <tr>
                                <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                    <a href="javascript:void(0);" class="TablePlus"
                                       data-bs-toggle="modal"
                                       data-bs-target="#rowDetailsModal"
                                       @onclick="() => OpenRowDetails(acc)">
                                        <i class="ti ti-plus"></i>
                                    </a>
                                </td>

                                <td>
                                    <span class="fw-medium" data-bs-toggle="tooltip"
                                          data-bs-placement="top"
                                          title="@acc.Code details popup">
                                        <span class="PopupIcon">⧉</span>
                                        <a @onclick="() => ViewCashAccount(acc)" class="text-decoration-none link-View"
                                        >
                                            @acc.Code
                                        </a>
                                    </span>
                                </td>
                                <td>@acc.Name</td>
                                <td class="d-none d-md-table-cell">@acc.BranchName</td>
                                @* <td class="d-none d-xl-table-cell">@acc.CustodianName</td> *@
                                @* <td class="d-none d-xxl-table-cell" title="@acc.CurrencyCode">@acc.CurrencyCode</td> *@
                                @* <td class="d-none d-xxl-table-cell">@acc.CashGlAccount</td> *@
                                <td class="d-none d-md-table-cell text-end" style="color: #004dd5;font-weight: 600;">
                                    @IndianNumberFormatter.Format(@acc.MaxCashLimit)

                                </td>
                              

                                <td class="d-none d-md-table-cell">
                                    <div class="d-flex align-items-center gap-2 justify-content-center">
                                        <div class="ActiveDot @GetStatusDotBadge(acc.Status)">
                                        </div>
                                        <span> @acc.Status</span>
                                    </div>
                                </td>



                                <td class="action-table-data">
                                    <div class="edit-delete-action">
                                        <a class="me-2 view-icon p-1"
                                           href="javascript:void(0);"
                                           title="View" 
                                           @onclick="() => ViewCashAccount(acc)">
                                            <i class="ti ti-eye"></i>
                                        </a>

                                        <a class="me-2 edit-icon p-1"
                                           title="Edit"
                                           @onclick='() => NavigationManager.NavigateTo($"/cash-accounts/edit/{acc.Code}")'>
                                            <i data-feather="edit"></i>
                                        </a>





                                        <a class="me-2 p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                           @onclick="() => ConfirmDelete(acc)" data-bs-toggle="modal" data-bs-target="#delete-modal">
                                            <i data-feather="trash-2"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@VisibleColumnCount" class="text-center py-4 text-muted">
                                No cash accounts found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            @if (PagedAccounts.Any())
            {
                <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                    <div class="d-flex align-items-center">
                        <span class="me-2">Rows per page:</span>
                        <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                            <option value="5" selected="@(PageSize == 5)">5</option>
                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                        <span class="ms-3 text-muted">
                            Entries
                        </span>
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                    <i class="ti ti-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = StartPage; i <= EndPage; i++)
                            {
                                int pageNum = i;
                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                    <i class="ti ti-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }

        </div>
    </div>


</div>



<!-- Delete Modal -->
<div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                        <i class="ti ti-trash fs-24 text-danger"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Cash Account</h4>
                    <p class="text-gray-6 mb-0 fs-16">

                        <span>Are you sure you want to delete <strong>Cash</strong>?</span>

                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x"></i> Cancel</button>

                        <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal" @onclick="DeleteAccount"><i class="ti ti-trash"></i> Yes, Delete</button>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@* OffCanvas Popup  *@
<div class="offcanvas offcanvas-end offcanvas-view"
     tabindex="-1"
     id="viewCashOffcanvas"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    @if (SelectedCashAccount != null)
    {
        <!-- Header -->
        <div class="offcanvas-header">
            <div class="oc-avatar">
                <i class="ti ti-currency-dollar"></i>
            </div>

            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@SelectedCashAccount.Name</h5>

                    <span class="oc-status-pill @(SelectedCashAccount.Status == "Active" ? "active" : "inactive")">
                        <span class="oc-status-dot"></span>
                        @SelectedCashAccount.Status
                    </span>
                </div>

                <p class="oc-header-sub">
                    Code : @SelectedCashAccount.Code
                </p>
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas">
            </button>
        </div>

        <!-- Body -->
        <div class="offcanvas-body">

            <!-- Summary Cards -->
            <div class="oc-summary-row">
                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value">
                        @SelectedCashAccount.CurrencyCode
                    </div>
                    <div class="oc-summary-label">Currency</div>
                </div>

                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value">
                        @(SelectedCashAccount.MaxCashLimit?.ToString("N2") ?? "—")
                    </div>
                    <div class="oc-summary-label">Max Limit</div>
                </div>

                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value">
                        @(SelectedCashAccount.IsNegativeBalanceAllowed ? "Yes" : "No")
                    </div>
                    <div class="oc-summary-label">Negative Allowed</div>
                </div>
            </div>

            <!-- General Information -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-info-circle"></i>
                    <h6 class="oc-card-title">General Information</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Branch</div>
                            <div class="oc-field-value">
                                @SelectedCashAccount.BranchName
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">GL Account</div>
                            <div class="oc-field-value">
                                @SelectedCashAccount.CashGlAccount
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Description</div>
                            <div class="oc-field-value">
                                @(SelectedCashAccount.Description ?? "—")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Custody Details -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-user-shield"></i>
                    <h6 class="oc-card-title">Ownership & Custody</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">Custodian</span>
                            <span class="oc-list-value">
                                @(SelectedCashAccount.CustodianName ?? "—")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Start Date</span>
                            <span class="oc-list-value">
                                @(SelectedCashAccount.CustodyStartDate?.ToString("dd-MMM-yyyy") ?? "—")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Notes</span>
                            <span class="oc-list-value">
                                @(SelectedCashAccount.CustodyNotes ?? "—")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Controls & Limits -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-shield-check"></i>
                    <h6 class="oc-card-title">Controls & Limits</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <div class="oc-list-row">
                            <span class="oc-list-label">Require Attachment Above</span>
                            <span class="oc-list-value">
                                @(SelectedCashAccount.RequireAttachmentAboveAmount?.ToString("N2") ?? "—")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Require Reason Exceeding</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedCashAccount.RequireReasonWhenExceedingLimit ? "db-green" : "db-red")">
                                    <span class="dot"></span>
                                    @(SelectedCashAccount.RequireReasonWhenExceedingLimit ? "Yes" : "No")
                                </span>
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Locked for Transactions</span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedCashAccount.IsLockedForTransactions ? "db-red" : "db-green")">
                                    <span class="dot"></span>
                                    @(SelectedCashAccount.IsLockedForTransactions ? "Locked" : "Unlocked")
                                </span>
                            </span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Close Reason (If Closed) -->
            @if (SelectedCashAccount.Status == "Closed")
            {
                <div class="oc-card">
                    <div class="oc-card-header hdr-purple">
                        <i class="ti ti-lock"></i>
                        <h6 class="oc-card-title">Closure Details</h6>
                    </div>

                    <div class="oc-card-body">
                        <div class="oc-field-value">
                            @(SelectedCashAccount.CloseReason ?? "—")
                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>




<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Country Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>

            <div class="modal-body">
                <div class="mb-2 d-flex gap-3">
                    <strong>Branch Name:</strong>
                    <div>@SelectedCashAccount?.BranchName</div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Custodian Name :</strong>
                    <div>@(SelectedCashAccount?.CustodianName ?? "-")</div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>GL Account:</strong>
                    <div>@(SelectedCashAccount?.CashGlAccount ?? "-")</div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Max Limit:</strong>
                    <div>@(SelectedCashAccount?.MaxCashLimit?.ToString("N2") ?? "-")</div>
                </div>

                <div class="mb-2 gap-3 d-md-none">
                    <strong>Status:</strong>
                    @if (!string.IsNullOrEmpty(SelectedCashAccount?.Status))
                    {
                        <span class="badge @GetStatusBadge(SelectedCashAccount.Status)">
                            @SelectedCashAccount.Status
                        </span>
                    }

                </div>


            </div>

        </div>
    </div>
</div>
