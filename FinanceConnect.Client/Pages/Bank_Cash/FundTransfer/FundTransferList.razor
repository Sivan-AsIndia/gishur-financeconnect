@page "/fund-transfers"

<div class="content List-view">

    <!-- Page Header -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Fund Transfer</h4>
                <h6>Manage Fund transfer details</h6>
            </div>
        </div>

        <ul class="table-top-head me-2">
            <li>
                <a title="Refresh" @onclick="Reload">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>

        <div class="page-btn">
            <a href="/fund-transfers/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i>
                Create
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset">
                        <i class="ti ti-search fs-14"></i>
                    </span>
                    <input type="search"
                           class="form-control form-control-sm"
                           placeholder="Search code or account..."
                           @bind="SearchText"
                           @oninput="OnSearch" />
                </div>
            </div>

            <div style="display:flex;gap:10px;">
                <select class="form-select form-select-sm" @bind="selectedStatus" style="min-width:140px">
                    <option value="">--Select Status--</option>
                    @foreach (var s in AvailableStatuses)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
        </div>

        <!-- Table -->
        <div class="card-body p-0">
            <table class="table align-middle w-100 table-fixed">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xxl-none" style="width:40px"></th>
                        <th title="Transfer No">Transfer No</th>
                        <th class="d-none d-md-table-cell">Date</th>
                        <th class="d-xxl-none d-xl-table-cell">From Cash</th>
                        @* <th class="d-xl-none d-xl-table-cell">To Cash</th> *@
                        <th title="Amount" class="d-none d-xxl-table-cell">Amount</th>
                        <th class="d-none d-xxl-table-cell">Branch</th>
                        <th class="d-none d-md-table-cell text-center">Status</th>
                        <th style="width: 147px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedAccounts == null)
                    {
                        <tr>
                            <td colspan="@VisibleColumnCount">Loading...</td>
                        </tr>
                    }
                    else if (!PagedAccounts.Any())
                    {
                        <tr class="text-center">
                            <td colspan="@VisibleColumnCount">No records found</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in PagedAccounts)
                        {
                            <tr>
                                <td class="d-xxl-none text-center" style="padding-left: 15px;">
                                    <a href="javascript:void(0);" class="TablePlus"
                                       data-bs-toggle="modal" data-bs-target="#rowDetailsModal"
                                       @onclick="() => OpenRowDetails(item)">
                                        <i class="ti ti-plus"></i>
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-medium" data-bs-toggle="tooltip" title=" @item.FundTransferNumber details">
                                        <i class="ti ti-external-link me-2 PopupIcon"></i>
                                        <a @onclick="() => ViewTransfer(item)" class="text-decoration-none link-View">
                                            @item.FundTransferNumber
                                        </a>
                                    </span>
                                </td>
                                <td class="d-none d-md-table-cell">@item.TransferDate.ToString("dd-MM-yyyy")</td>
                                <td class="d-xxl-none d-xl-table-cell">@item.SourceBankAccount</td>
                        @*         <td class="d-xl-none d-xl-table-cell">
                                    @IndianNumberFormatter.Format(
                                    decimal.TryParse(item.DestinationBankAccount, out var value) ? value : null
                                                        )

                        </td>  *@
                        <td class="text-end d-none d-xxl-table-cell">
                                    <div style="width: 87px;display: flex;justify-content: end;">
                                        @item.Amount.ToString("N2")
                                    </div>
                        </td>
                        <td title="@item.Branch" class="d-none d-xxl-table-cell">@item.Branch</td>
                                <td class="d-none d-md-table-cell text-center" style="text-overflow: inherit;">
                            <span class="badge @GetStatusBadge(item.Status)"
                                  data-bs-toggle="tooltip"
                                  data-bs-placement="top"
                                  title="@item.Status">

                                <i class="@GetFundTransferStatusIcon(item.Status)"></i>
                            </span>

                        </td>

                        @* <td title="@item.TransferMethod" class="d-none d-xxl-table-cell">@item.TransferMethod</td> *@
                        @* <td title="@item.UTRNumber" class="d-none d-xxl-table-cell">@(item.UTRNumber ?? "-")</td> *@
                        @* <td class="d-none d-xxl-table-cell">@item.Currency</td> *@
                        <td class="action-table-data">
                            <div class="edit-delete-action">
                                <a class="me-2 view-icon p-1"
                                   href="javascript:void(0);"
                                   title="View"
                                   @onclick="() => ViewTransfer(item)">
                                    <i class="ti ti-eye"></i>
                                </a>
                                <a class="me-2 edit-icon p-1"
                                   title="Edit"
                                   @onclick="() => EditItem(item.FundTransferId)">
                                    <i data-feather="edit"></i>
                                </a>
                                <a class="me-2 p-1 delete-icon"
                                   href="javascript:void(0);"
                                   title="Delete"
                                   data-bs-toggle="modal"
                                   data-bs-target="#delete-modal"
                                   @onclick="() => ConfirmDelete(item)">
                                    <i data-feather="trash-2"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                                        }
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            @if (PagedAccounts.Any())
            {
                <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                    <div class="d-flex align-items-center">
                        <span class="me-2">Rows per page:</span>
                        <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                            <option value="5" selected="@(PageSize == 5)">5</option>
                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                        <span class="ms-3 text-muted">Entries</span>
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                    <i class="ti ti-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = StartPage; i <= EndPage; i++)
                            {
                                int pageNum = i;
                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                    <i class="ti ti-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                        <i class="ti ti-trash fs-24 text-danger"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Fund Transfer</h4>
                    <p class="text-gray-6 mb-0 fs-16">
                        Are you sure you want to delete <strong>@selectdata</strong>?
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x"></i> Cancel</button>
                        <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal" @onclick="DeleteAccount"><i class="ti ti-trash"></i> Yes, Delete</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Responsive View Modal -->


<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Fund Transfer Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>

            <div class="modal-body">
                <div class="mb-2 d-flex gap-3">
                    <strong>From Cash:</strong>
                    <div>@SelectedTransfer?.SourceBankAccount</div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>To Cash:</strong>
                    <div>@SelectedTransfer?.DestinationBankAccount</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Amount:</strong>
                    <div>@SelectedTransfer?.Amount</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>UTR:</strong>
                    <div>@SelectedTransfer?.UTRNumber</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Date:</strong>
                    <div>@SelectedTransfer?.TransferDate.ToString("dd-MM-yyyy")</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Branch:</strong>
                    <div>@SelectedTransfer?.Branch</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Transfer Method:</strong>
                    <div>@SelectedTransfer?.TransferMethod</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Currency:</strong>
                    <div>@SelectedTransfer?.Currency</div>
                </div>

                @if (SelectedTransfer != null)
                {
                    <div class="mb-2 gap-3 d-md-none">
                        <strong>Status:</strong>
                        <span class="badge @GetStatusBadge(SelectedTransfer.Status)">
                            @SelectedTransfer.Status
                        </span>
                    </div>
                }
            </div>

        </div>
    </div>
</div>