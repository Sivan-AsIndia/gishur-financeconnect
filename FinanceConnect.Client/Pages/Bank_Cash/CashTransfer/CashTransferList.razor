@page "/cash-transfers";

@inject CashTransferService service
@inject IJSRuntime JS
@inject CashTransferService CashTransferService
@inject NavigationManager NavigationManager
@inject ToastService ToastService

<div class="content List-view">

    <!-- Page Header -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Cash Tranfer</h4>
                <h6>Manage cash transfer details</h6>
            </div>
        </div>

        <ul class="table-top-head me-2">
            <li>
                <a title="Refresh" @onclick="Reload">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>

        <div class="page-btn">
            <a href="/cash-transfers/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i>
                Create
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset">
                        <i class="ti ti-search fs-14"></i>
                    </span>
                    <input type="search"
                           class="form-control form-control-sm"
                           placeholder="Search code or name..."
                           @bind="SearchText"
                           @oninput="OnSearch" />
                </div>
            </div>

            <div style="display:flex;gap:10px;">
                <select class="form-select form-select-sm" @bind="selectedStatus" style="min-width:140px">
                    <option value="" selected>All Status</option>
                    @foreach (var s in AvailableStatuses)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
        </div>

        <!-- Table -->
        <div class="card-body p-0">
            <table class="table align-middle w-100" style="table-layout:fixed;">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xxl-none" style="width:40px"></th>

                        <th>Transfer No</th>
                        <th class="d-none d-md-table-cell">Date</th>
                        <th class="d-none d-xl-table-cell">From Cash</th>
                        <th class="d-none d-xxl-table-cell">To Cash</th>
                        <th class="d-none d-xxl-table-cell">Amount</th>
                        @* <th class="d-none d-md-table-cell" title="Branch">Branch</th> *@
                        <th class="d-none d-md-table-cell">Status</th>
                        @* <th class="d-none d-xxl-table-cell">Currency</th> *@
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (PagedAccounts == null)
                    {
                        <tr>
                            <td colspan="9">Loading...</td>
                        </tr>
                    }
                    else if (!PagedAccounts.Any())
                    {
                        <tr class="text-center">
                            <td colspan="@VisibleColumnCount">No records found</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in PagedAccounts)
                        {
                            <tr>
                                <td class="d-xxl-none text-center" style="padding: 0;padding-left: 15px;">
                                    <a href="javascript:void(0);" class="TablePlus"
                                        data-bs-toggle="modal"
                                        data-bs-target="#rowDetailsModal"
                                       @onclick="() => OpenRowDetails(item)">
                                        <i class="ti ti-plus"></i>
                                    </a>
                                </td>

                                <td style="white-space:nowrap;">
                                    <span class="fw-medium" data-bs-toggle="tooltip"
                                          data-bs-placement="top"
                                          title="@item.CashTransferNumber details">
                                        <span class="PopupIcon">⧉</span>
                                        <a @onclick="() => ViewTransfer(item)" class="text-decoration-none link-View"
                                        >
                                            @item.CashTransferNumber
                                        </a>
                                    </span>
                                </td>
                                <td class="d-none d-md-table-cell">@item.TransferDate?.ToString("dd-MMM-yy")</td>
                                <td  class="d-none d-xl-table-cell">@item.SourceCashAccountName</td>
                                <td class="d-none d-xxl-table-cell">@item.DestinationCashAccountName</td>
                                <td class="text-end d-none d-xxl-table-cell" style="white-space:nowrap;">
                                    <div style="width:80px"> @IndianNumberFormatter.Format(@item.Amount)</div>
                                </td>
                                @* <td class="d-none d-md-table-cell" title="@item.BranchName">@item.BranchName</td> *@
                                <td class="d-none d-md-table-cell">
                               
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="ActiveDot @GetStatusDotBadge(item.CashTransferStatus.ToString())">
                                        </div>
                                        <span> @item.CashTransferStatus</span>
                                    </div>
                                </td>



                                @* <td class="d-none d-xxl-table-cell">@item.CurrencyCode</td> *@

                                <td class="action-table-data">
                                    <div class="edit-delete-action">
                                        <a class="me-2 view-icon p-1"
                                           href="javascript:void(0);"
                                           title="View"
                                           @onclick="() => ViewTransfer(item)">
                                            <i class="ti ti-eye"></i>
                                        </a>


                                        <a class="me-2 edit-icon p-1"
                                           title="Edit"
                                           @onclick="() => EditItem(item.CashTransferId)">
                                            <i data-feather="edit"></i>
                                        </a>

                                        <a class="me-2 p-1 delete-icon"
                                           href="javascript:void(0);"
                                           title="Delete"
                                           data-bs-toggle="modal"
                                           data-bs-target="#delete-modal"
                                           @onclick="() => ConfirmDelete(item)">
                                            <i data-feather="trash-2"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>

            <!-- Pagination -->
            @if (PagedAccounts.Any())
            {
                <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                    <div class="d-flex align-items-center">
                        <span class="me-2">Rows per page:</span>
                        <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                            <option value="5" selected="@(PageSize == 5)">5</option>
                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                        <span class="ms-3 text-muted">
                            Entries
                        </span>
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                    <i class="ti ti-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = StartPage; i <= EndPage; i++)
                            {
                                int pageNum = i;
                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                    <i class="ti ti-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }


        </div>
    </div>


</div>


<!-- Delete Modal -->
<div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                        <i class="ti ti-trash fs-24 text-danger"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Cash Transfer</h4>
                    <p class="text-gray-6 mb-0 fs-16">

                        <span>Are you sure you want to delete <strong>@selectdata</strong>?</span>

                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x"></i> Cancel</button>

                        <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal" @onclick="DeleteAccount"><i class="ti ti-trash"></i> Yes, Delete</button>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@* View Model *@

<div class="modal fade list-Popup" id="view-transfer-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ti ti-file-text me-2 text-primary"></i> View Transfer Details

                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding: 0;
    right: 26px;
    top: 27px;
    position: absolute;
    transform: none;"></button>
            </div>
            <div class="modal-body">
                @if (SelectedTransfer != null)
                {
                    <div class="row g-3">

                        <div class="col-12">
                            <h6 class="text-primary"> <i class="ti ti-cash me-2"></i> Transfer Details</h6>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Transfer No</label>
                            <div class="fw-medium">@SelectedTransfer.CashTransferNumber</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Date</label>
                            <div>@SelectedTransfer.TransferDate?.ToString("dd-MM-yyyy")</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Source Account</label>
                            <div>@SelectedTransfer.SourceCashAccountName</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Destination Account</label>
                            <div>@SelectedTransfer.DestinationCashAccountName</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Branch</label>
                            <div>@SelectedTransfer.BranchName</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Amount</label>
                            <div>@SelectedTransfer.Amount</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Status</label>
                            <div>
                                <span class="badge @GetStatusBadge(SelectedTransfer.CashTransferStatus.ToString())">
                                    @SelectedTransfer.CashTransferStatus
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Currency</label>
                            <div>
                                @SelectedTransfer.CurrencyCode
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="text-muted small">Reason</label>
                            <div>
                                @(SelectedTransfer?.ReasonCode?.ToString() ?? "-")
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Purpose / Notes</label>
                            <div>
                                @(string.IsNullOrWhiteSpace(SelectedTransfer?.Narration) ? "-" : SelectedTransfer.Narration)
                            </div>
                        </div>
                        <div class="col-12">
                            <h6 class="text-primary">
                                <i class="ti ti-arrows-exchange me-2"></i>
                                HandOver & Transit
                            </h6>
                        </div>
                        <div class="col-md-3">
                            <label class="text-muted small">Handed Over On</label>
                            <div>
                                @(SelectedTransfer?.HandedOverOn?.ToString("dd-MM-yyyy") ?? "-")
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="text-muted small">Transit Method</label>
                            <div>
                                @(SelectedTransfer?.TransitMethod?.ToString() ?? "-")
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="text-muted small">Handed Over By</label>
                            <div>
                                @(SelectedTransfer?.HandedOverByUserName ?? "-")
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="text-muted small">Transit Reference</label>
                            <div>
                                @(string.IsNullOrWhiteSpace(SelectedTransfer?.TransitReference) ? "-" : SelectedTransfer.TransitReference)
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Transit Notes</label>
                            <div>
                                @(string.IsNullOrWhiteSpace(SelectedTransfer?.TransitNotes) ? "-" : SelectedTransfer.TransitNotes)
                            </div>
                        </div>

                        <div class="col-12">
                            <h6 class="text-primary">
                                <i class="ti ti-check me-2"></i>
                                Receive Confirmation
                            </h6>
                        </div>
                        <div class="col-md-3">
                            <label class="text-muted small">Received On</label>
                            <div>
                                @(SelectedTransfer?.ReceivedOn?.ToString("dd-MM-yyyy") ?? "-")
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="text-muted small">Received Amount</label>
                            <div>
                                @(SelectedTransfer != null ? SelectedTransfer.ReceivedAmount.ToString("N2") : "-")
                            </div>

                        </div>
                        <div class="col-md-3">
                            <label class="text-muted small">Received By</label>
                            <div>
                                @(SelectedTransfer?.ReceivedByUserName ?? "-")
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Acknowledgement Note</label>
                            <div>
                                @(string.IsNullOrWhiteSpace(SelectedTransfer?.ReceiptAcknowledgementNote) ? "-" : SelectedTransfer.ReceiptAcknowledgementNote)
                            </div>
                        </div>
                    </div>
                }

            </div>
            @* <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div> *@
        </div>
    </div>
</div>


@* View Transfer Offcanvas *@
<div class="offcanvas offcanvas-end offcanvas-view"
     tabindex="-1"
     id="viewTransferOffcanvas"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    @if (SelectedTransfer != null)
    {
        <!-- Header -->
        <div class="offcanvas-header">
            <div class="oc-avatar bg-primary-soft">
                <i class="ti ti-arrows-exchange"></i>
            </div>

            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@SelectedTransfer.CashTransferNumber</h5>

                    <span class="oc-status-pill @GetStatusBadge(SelectedTransfer.CashTransferStatus.ToString())">
                        <span class="oc-status-dot"></span>
                        @SelectedTransfer.CashTransferStatus
                    </span>
                </div>

                <p class="oc-header-sub">
                    @SelectedTransfer.SourceCashAccountName
                    →
                    @SelectedTransfer.DestinationCashAccountName
                </p>
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas">
            </button>
        </div>

        <!-- Body -->
        <div class="offcanvas-body">

            <!-- Summary Cards -->
            <div class="oc-summary-row">

                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value">
                        @SelectedTransfer.Amount.ToString("N2")
                    </div>
                    <div class="oc-summary-label">Transfer Amount</div>
                </div>

                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value">
                        @SelectedTransfer.CurrencyCode
                    </div>
                    <div class="oc-summary-label">Currency</div>
                </div>

                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value">
                        @SelectedTransfer.TransferDate?.ToString("dd-MMM-yyyy")
                    </div>
                    <div class="oc-summary-label">Transfer Date</div>
                </div>

            </div>

            <!-- Transfer Details -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-cash"></i>
                    <h6 class="oc-card-title">Transfer Details</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid gap-4">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Branch</div>
                            <div class="oc-field-value">
                                @SelectedTransfer.BranchName
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Reason</div>
                            <div class="oc-field-value">
                                @(SelectedTransfer?.ReasonCode?.ToString() ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Status</div>
                            <div class="oc-field-value">
                                @SelectedTransfer.CashTransferStatus
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Purpose / Notes</div>
                            <div class="oc-list-value text-truncate ql-editor" style="max-width:200px;" title="@GetPlainText(SelectedTransfer?.Narration)">
                                @(new MarkupString(SelectedTransfer?.Narration ?? "-"))
                            </div>
                        </div>

                    </div>


                </div>
            </div>

            <!-- HandOver & Transit -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-truck-delivery"></i>
                    <h6 class="oc-card-title">HandOver & Transit</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <div class="oc-list-row">
                            <span class="oc-list-label">Handed Over On</span>
                            <span class="oc-list-value">
                                @(SelectedTransfer?.HandedOverOn?.ToString("dd-MMM-yyyy") ?? "—")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Handed Over By</span>
                            <span class="oc-list-value">
                                @(SelectedTransfer?.HandedOverByUserName ?? "—")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Transit Method</span>
                            <span class="oc-list-value">
                                @(SelectedTransfer?.TransitMethod?.ToString() ?? "—")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Transit Reference</span>
                            <span class="oc-list-value">
                                @(string.IsNullOrWhiteSpace(SelectedTransfer?.TransitReference) ? "—" : SelectedTransfer.TransitReference)
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Transit Notes</span>
                            <span class="oc-list-value">
                                @(string.IsNullOrWhiteSpace(SelectedTransfer?.TransitNotes) ? "—" : SelectedTransfer.TransitNotes)
                            </span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Receive Confirmation -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-check"></i>
                    <h6 class="oc-card-title">Receive Confirmation</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <div class="oc-list-row">
                            <span class="oc-list-label">Received On</span>
                            <span class="oc-list-value">
                                @(SelectedTransfer?.ReceivedOn?.ToString("dd-MMM-yyyy") ?? "—")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Received Amount</span>
                            <span class="oc-list-value">
                                @(SelectedTransfer != null ? SelectedTransfer.ReceivedAmount.ToString("N2") : "—")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Received By</span>
                            <span class="oc-list-value">
                                @(SelectedTransfer?.ReceivedByUserName ?? "—")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Acknowledgement Note</span>
                            <span class="oc-list-value text-truncate ql-editor" style="max-width:200px;" title="@GetPlainText(SelectedTransfer?.ReceiptAcknowledgementNote)">
                                @(new MarkupString(SelectedTransfer?.ReceiptAcknowledgementNote ?? "-"))
                            </span>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    }
</div>

@* Responsive View popup  *@

<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Cash Transfer Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none;color:white"></button>
            </div>

            <div class="modal-body">
                <div class="mb-2 d-flex gap-3">
                    <strong>From Cash:</strong>
                    <div>@SelectedTransfer?.SourceCashAccountName</div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>To Cash:</strong>
                    <div>@SelectedTransfer?.DestinationCashAccountName</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Amount:</strong>
                    <div>@SelectedTransfer?.Amount</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Currency:</strong>
                    <div>@SelectedTransfer?.CurrencyCode</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Branch Name:</strong>
                    <div>@SelectedTransfer?.BranchName</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Date:</strong>
                    <div>@SelectedTransfer?.TransferDate?.ToString("dd-MM-yyyy")"</div>
                </div>

                @if (SelectedTransfer != null)
                {
                    <div class="mb-2 gap-3 d-md-none">
                        <strong>Status:</strong>
                        <span class="badge @GetStatusBadge(SelectedTransfer.CashTransferStatus.ToString())">
                            @SelectedTransfer.CashTransferStatus
                        </span>
                    </div>
                }



            </div>

        </div>
    </div>
</div>