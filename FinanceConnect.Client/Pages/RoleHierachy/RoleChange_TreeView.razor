@code {
    private Dictionary<int, int> siblingOrder = new();

    private bool IsSibling(int idA, int idB)
    {
        if (idA == 0 || idB == 0 || idA == idB) return false;
        var a = Services.People.FirstOrDefault(p => p.Id == idA);
        var b = Services.People.FirstOrDefault(p => p.Id == idB);
        return a != null && b != null && a.ManagerId == b.ManagerId;
    }

    private bool IsDropLeft(int draggingNodeId, int targetId)
    {
        int orderA = siblingOrder.ContainsKey(draggingNodeId) ? siblingOrder[draggingNodeId] : draggingNodeId;
        int orderB = siblingOrder.ContainsKey(targetId) ? siblingOrder[targetId] : targetId;
        return orderA < orderB;
    }

    private void SwapSiblingOrder(int idA, int idB)
    {
        var siblings = Services.People
            .Where(p => { var a = Services.People.FirstOrDefault(x => x.Id == idA); return p.ManagerId == a?.ManagerId; })
            .OrderBy(p => siblingOrder.ContainsKey(p.Id) ? siblingOrder[p.Id] : p.Id)
            .ToList();
        for (int i = 0; i < siblings.Count; i++)
            if (!siblingOrder.ContainsKey(siblings[i].Id))
                siblingOrder[siblings[i].Id] = i;
        int tmp = siblingOrder[idA];
        siblingOrder[idA] = siblingOrder[idB];
        siblingOrder[idB] = tmp;
    }

    private HashSet<int> collapsedIds = new();
    private bool allExpanded = true;

    private void ToggleNode(int id)
    {
        if (collapsedIds.Contains(id)) collapsedIds.Remove(id);
        else collapsedIds.Add(id);
        allExpanded = collapsedIds.Count == 0;
        StateHasChanged();
    }

    private void ToggleExpandAll()
    {
        if (allExpanded)
        {
            foreach (var p in Services.People.Where(x => Services.People.Any(c => c.ManagerId == x.Id)))
                collapsedIds.Add(p.Id);
            allExpanded = false;
        }
        else { collapsedIds.Clear(); allExpanded = true; }
        StateHasChanged();
    }

    private int draggingId = 0;
    private int dragOverId = 0;

    private void OnDragStart(int id) { draggingId = id; StateHasChanged(); }
    private void OnDragLeave() { dragOverId = 0; StateHasChanged(); }
    private void OnDragEnd() { draggingId = 0; dragOverId = 0; StateHasChanged(); }
    private void OnDragOver(int id) { if (id != draggingId) { dragOverId = id; StateHasChanged(); } }

    private void HandleDrop(int targetId)
    {
        dragOverId = 0;
        if (draggingId == 0 || draggingId == targetId) { draggingId = 0; StateHasChanged(); return; }
        var moving = Services.People.FirstOrDefault(p => p.Id == draggingId);
        var target = Services.People.FirstOrDefault(p => p.Id == targetId);
        if (moving == null || target == null) { draggingId = 0; StateHasChanged(); return; }
        if (moving.ManagerId == target.ManagerId)
        {
            SwapSiblingOrder(draggingId, targetId);
            ShowToast($"↔ Reordered: {moving.FullName} ⟷ {target.FullName}", "t1");
            draggingId = 0; StateHasChanged(); return;
        }
        if (IsDescendant(draggingId, targetId))
        {
            ShowToast("Cannot place a parent under its own child", "t3");
            draggingId = 0; StateHasChanged(); return;
        }
        Services.ReassignManager(draggingId, targetId);
        siblingOrder.Remove(draggingId);
        ShowToast($"✓ {moving.FullName} → {target.FullName}", "t1");
        draggingId = 0; StateHasChanged();
    }

    private bool IsDescendant(int ancestorId, int checkId)
    {
        var cur = Services.People.FirstOrDefault(p => p.Id == checkId);
        var visited = new HashSet<int>();
        while (cur?.ManagerId != null)
        {
            if (visited.Contains(cur.Id)) break;
            visited.Add(cur.Id);
            if (cur.ManagerId == ancestorId) return true;
            cur = Services.People.FirstOrDefault(p => p.Id == cur.ManagerId);
        }
        return false;
    }

    private int? modalPersonId;
    private bool isOcOpen = false;

    private async Task OpenModal(int id)
    { modalPersonId = id; StateHasChanged(); await Task.Delay(30); isOcOpen = true; StateHasChanged(); }

    private async Task CloseModal()
    { isOcOpen = false; StateHasChanged(); await Task.Delay(320); modalPersonId = null; StateHasChanged(); }

    private async Task NavigateToMember(int id)
    { isOcOpen = false; StateHasChanged(); await Task.Delay(180); modalPersonId = id; StateHasChanged(); await Task.Delay(30); isOcOpen = true; StateHasChanged(); }

    private void PromoteTeam()
    {
        if (!modalPersonId.HasValue) return;
        var person = Services.People.FirstOrDefault(p => p.Id == modalPersonId.Value);
        if (person == null) return;
        var toChange = Services.GetTeam(person).Count(m => m.Role != person.Role);
        if (toChange == 0) { ShowToast($"All already {RoleChangingService.Roles[person.Role].Label}", "t3"); return; }
        Services.PromoteTeam(modalPersonId.Value);
        ShowToast($"↑ {toChange} promoted to {RoleChangingService.Roles[person.Role].Label}", "t1");
        StateHasChanged();
    }

    private async Task RemovePerson()
    {
        if (!modalPersonId.HasValue) return;
        var p = Services.People.FirstOrDefault(x => x.Id == modalPersonId.Value);
        if (p == null) return;
        var name = p.FullName;
        siblingOrder.Remove(modalPersonId.Value);
        Services.RemovePerson(modalPersonId.Value);
        await CloseModal();
        ShowToast($"{name} removed", "t2");
    }

    private bool showAdd = false;
    private string addFirst = "", addLast = "", addTitle = "", addDept = "";
    private RoleType addRole = RoleType.TeamLeader;
    private StatusType addStatus = StatusType.Online;
    private int addManagerId = 0;

    private void ConfirmAdd()
    {
        if (string.IsNullOrWhiteSpace(addFirst) || string.IsNullOrWhiteSpace(addLast))
        { ShowToast("Enter first & last name", "t3"); return; }
        var person = Services.AddPerson(
            addFirst.Trim(), addLast.Trim(),
            string.IsNullOrWhiteSpace(addTitle) ? "Team Member" : addTitle.Trim(),
            string.IsNullOrWhiteSpace(addDept) ? "General" : addDept.Trim(),
            addRole, addStatus, addManagerId > 0 ? addManagerId : null);
        CloseAddModal();
        ShowToast($"{person.FullName} joined as {RoleChangingService.Roles[person.Role].Label}", "t1");
    }

    private void CloseAddModal()
    {
        showAdd = false;
        addFirst = ""; addLast = ""; addTitle = ""; addDept = "";
        addRole = RoleType.TeamLeader;
        addStatus = StatusType.Online;
        addManagerId = 0;
    }

    private string toastMsg = "", toastType = "t2";
    private bool toastVisible = false;
    private System.Timers.Timer? toastTimer;

    protected override void OnInitialized()
    {
        Services.OnChange += StateHasChanged;
        toastTimer = new System.Timers.Timer(3000) { AutoReset = false };
        toastTimer.Elapsed += (_, _) => { toastVisible = false; InvokeAsync(StateHasChanged); };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Scroll so the Director (root) node is centered horizontally
            await JS.InvokeVoidAsync("eval", @"
            var w = document.querySelector('.ht-canvas-wrap');
            if (w) {
                w.scrollTop = 0;
                // Center the root: canvas total width minus viewport width, divided by 2
                var canvas = w.querySelector('.ht-canvas');
                if (canvas) {
                    var canvasW = canvas.offsetWidth;
                    var viewW = w.clientWidth;
                    w.scrollLeft = Math.max(0, (canvasW - viewW) / 2);
                }
            }
        ");
        }
    }

    public void Dispose() { Services.OnChange -= StateHasChanged; toastTimer?.Dispose(); }

    private void ShowToast(string msg, string type = "t2")
    { toastMsg = msg; toastType = type; toastVisible = true; toastTimer?.Stop(); toastTimer?.Start(); StateHasChanged(); }
}
