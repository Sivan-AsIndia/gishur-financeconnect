                            {
                                <i class="ti ti-info-circle" style="color:var(--A);flex-shrink:0;"></i>
                                <span><b>@tns.Count</b> member@(tns.Count > 1 ? "s" : "") on different roles</span>
                            }
                            else
                            {
                                <i class="ti ti-circle-check" style="color:#22c55e;flex-shrink:0;"></i>
                                <span>All <b>@team.Count</b> are <b style="color:@r.Color;">@r.Label</b></span>
                            }
                        </div>
                        @foreach (var member in team)
                        {
                            var mr = RoleChangingService.Roles[member.Role];
                            var same = member.Role == p.Role;
                            <div class="oc-mem" @onclick="() => NavigateToMember(member.Id)" style="border-left:3px solid @mr.Color">

                                
                                <div class="oc-mav" style="background:linear-gradient(135deg,@mr.Color,@(mr.Color)88);">
                                    <img class="av-img"
                                         src="@member.AvatarUrl"
                                         alt="@member.Initials"
                                         onerror="this.style.display='none';this.nextElementSibling.style.opacity='1'" />
                                    <span class="av-fallback">@member.Initials</span>
                                </div>

                                <div style="flex:1;min-width:0;">
                                    <div class="oc-mn">@member.FullName</div>
                                    <div class="oc-ms">@member.Title</div>
                                </div>
                                <div style="display:flex;align-items:center;gap:4px;flex-shrink:0;">
                                    @if (same)
                                    {
                                        <span class="badge oc-chip" style="background:@(mr.Color)15;color:@mr.Color;border-color:@(mr.Color)33;">✓ @mr.Label</span>
                                    }
                                    else
                                    {
                                        <span class="badge oc-chip" style="background:@(mr.Color)15;color:@mr.Color;border-color:@(mr.Color)33;">@mr.Label</span>
                                        <i class="ti ti-arrow-right" style="color:black;font-size:10px;"></i>
                                        <span class="badge oc-chip" style="background:@(r.Color)15;color:@r.Color;border-color:@(r.Color)33;">@r.Label</span>
                                    }
                                    <i class="ti ti-chevron-right" style="color:black;font-size:11px;margin-left:2px;"></i>
                                </div>
                            </div>
                        }
                        <button class="badge bg-primary-transparent oc-promo"
                                disabled="@(!tns.Any())"
                                style="@(tns.Any()
                                    ? "background:var(--A-lt);border-color:var(--A-mid);color:var(--A);"
                                    : "background:var(--ink3);border-color:var(--bd);color:black;")"
                                @onclick="PromoteTeam">
                            @if (!tns.Any())
                            {
                                <i class="ti ti-circle-check"></i>
                                <span>All are @r.Label</span>
                            }
                            else
                            {
                                <i class="ti ti-rocket"></i>
                                <span>Promote all @tns.Count → @r.Label</span>
                            }
                        </button>
                    </div>
                }

                @if (p.History.Any())
                {
                    <div>
                        <div class="oc-lbl">Role History</div>
                        @foreach (var h in p.History)
                        {
                            var fr = RoleChangingService.Roles[h.From];
                            var tr = RoleChangingService.Roles[h.To];
                            var up = fr.Level > tr.Level;
                            <div class="oc-hist">
                                <div class="oc-hi"
                                     style="background:@(up ? "rgba(34,197,94,.12)" : "rgba(239,68,68,.10)");
                                            color:@(up ? "#4ade80" : "#f87171");">
                                    <i class="ti @(up ? "ti-trending-up" : "ti-trending-down")"></i>
                                </div>
                                <div style="display:flex;align-items:center;gap:5px;flex:1;flex-wrap:wrap;">
                                    <span class="badge" style="background:@(fr.Color)15;color:@fr.Color;border-color:@(fr.Color)33;">@fr.Icon @fr.Label</span>
                                    <i class="ti ti-arrow-right" style="color:black;font-size:10px;"></i>
                                    <span class="badge" style="background:@(tr.Color)15;color:@tr.Color;border-color:@(tr.Color)33;">@tr.Icon @tr.Label</span>
                                </div>
                                <div class="oc-ht"><i class="ti ti-clock me-1"></i>@RoleChangingService.TimeAgo(h.Timestamp)</div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="oc-foot">
                <button class="btn btn-outline-secondary w-100" @onclick="RemovePerson">
                    <i class="ti ti-trash me-1"></i> Remove
                </button>
                <button class="btn btn-primary w-100" @onclick="CloseModal">
                    <i class="ti ti-check me-1"></i> Done
                </button>
            </div>
        }
    }
</div>

@if (isOcOpen)
{
    <div class="oc-overlay" @onclick="CloseModal"></div>
