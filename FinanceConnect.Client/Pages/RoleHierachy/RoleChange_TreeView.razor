<div class="oc-panel @(isOcOpen ? "open" : "")">
    @if (modalPersonId.HasValue)
    {
        var p = Services.People.FirstOrDefault(x => x.Id == modalPersonId.Value);
        @if (p != null)
        {
            var r = RoleChangingService.Roles[p.Role];
            var team = Services.GetTeam(p);
            var tns = team.Where(m => m.Role != p.Role).ToList();
            var dir = Services.People.Where(x => x.ManagerId == p.Id).ToList();
            var sc = RoleChangingService.StatusColor(p.Status);

