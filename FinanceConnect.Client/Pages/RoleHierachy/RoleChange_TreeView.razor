                <div class="oc-av" style="background:linear-gradient(135deg,@r.Color,@(r.Color)88);">
                    <img class="av-img"
                         src="@p.AvatarUrl"
                         alt="@p.Initials"
                         onerror="this.style.display='none';this.nextElementSibling.style.opacity='1'" />
                    <span class="av-fallback">@p.Initials</span>
                    <span class="oc-av-dot" style="background:@sc;"></span>
                </div>

                <div style="flex:1;min-width:0;">
                    <div class="oc-nm">@p.FullName</div>
                    <div class="oc-jt">@p.Title</div>
                    <div class="oc-bdg">
                        <span class="badge" style="background:@(r.Color)18;color:@r.Color;border-color:@(r.Color)40;">@r.Icon @r.Label</span>
                        <span class="badge bg-primary-transparent">@p.Dept</span>
                    </div>
                </div>
                <button class="oc-cls" @onclick="CloseModal"><i class="ti ti-x"></i></button>
            </div>

            <div class="oc-stats">
                <div class="oc-st"><div class="oc-sn" style="color:var(--primary);">@dir.Count</div><div class="oc-sl">Direct</div></div>
                <div class="oc-st"><div class="oc-sn" style="color:var(--primary);">@team.Count</div><div class="oc-sl">Full Team</div></div>
                <div class="oc-st"><div class="oc-sn" style="color:var(--primary);">@p.History.Count</div><div class="oc-sl">Changes</div></div>
            </div>

            <div class="oc-body">
                @if (team.Any())
                {
                    <div class="mb-4">
                        <div class="oc-lbl">Team Members</div>
