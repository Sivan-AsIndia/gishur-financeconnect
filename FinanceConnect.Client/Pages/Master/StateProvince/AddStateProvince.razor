@page "/states/create"
@page "/states/{Id:guid}"
@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels

<style>
    .form-select option:checked {
        color: white;
        background-color: var(--primary);
    }

   
    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }

    .form-select.is-invalid {
        border-color: #dc3545;
    }

    .field-validation-error {
        color: #dc3545;
        font-size: 12px;
        display: block;
        margin-top: 4px;
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    <div class="content Accordion-form">
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">@PageTitle</h4>
                    <h6>@PageSubTitle</h6>
                </div>
            </div>

            <div class="page-btn mt-0">
                <a href="/states" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <EditForm EditContext="_editContext" OnSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="add-product" style="background:#f4f7fb; padding:24px 14px;">
                <div class="tl-accordion">

                    <div class="tl-left-panel">

                        <div class="tl-label @(ShowIdentity ? "active accent-orange" : "")"
                             @onclick="@(() => ToggleAccordion("stateIdentity"))">
                            <div class="tl-label-icon ico-orange"><i class="ti ti-map"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">State / Province Identity</div>
                                <div class="tl-label-sub">Basic state/province information</div>
                            </div>
                            <span class="tl-label-chevron @(ShowIdentity ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowCountry ? "active accent-blue" : "")"
                             @onclick="@(() => ToggleAccordion("countryLinkage"))">
                            <div class="tl-label-icon ico-blue"><i class="ti ti-flag"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Country & Jurisdiction</div>
                                <div class="tl-label-sub">Country linkage settings</div>
                            </div>
                            <span class="tl-label-chevron @(ShowCountry ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowCompliance ? "active accent-purple" : "")"
                             @onclick="@(() => ToggleAccordion("compliance"))">
                            <div class="tl-label-icon ico-purple"><i class="ti ti-file-certificate"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Compliance & Tax Codes</div>
                                <div class="tl-label-sub">Tax jurisdiction settings</div>
                            </div>
                            <span class="tl-label-chevron @(ShowCompliance ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowAddressRules ? "active accent-green" : "")"
                             @onclick="@(() => ToggleAccordion("addressRules"))">
                            <div class="tl-label-icon ico-green"><i class="ti ti-map-pin"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Address & Postal Rules</div>
                                <div class="tl-label-sub">Postal & format settings</div>
                            </div>
                            <span class="tl-label-chevron @(ShowAddressRules ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowStatus ? "active accent-teal" : "")"
                             @onclick="@(() => ToggleAccordion("statusGovernance"))">
                            <div class="tl-label-icon ico-teal"><i class="ti ti-settings"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Status & Governance</div>
                                <div class="tl-label-sub">Status and settings</div>
                            </div>
                            <span class="tl-label-chevron @(ShowStatus ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                    </div>

                    <div class="tl-right-area">

                        <!--Identity-->
                        <div class="tl-card-row @(ShowIdentity ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("stateIdentity"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowIdentity ? "card-active border-orange" : "")">

                                    <div class="tl-card-header"
                                         @onclick="@(() => ToggleAccordion("stateIdentity"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-orange">01</span>
                                            State / Province Identity
                                        </div>
                                        <span class="tl-card-toggle @(ShowIdentity ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>

                                    <div class="tl-collapse @(ShowIdentity ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(StateTouched ? "touched" : "")">

                                                <div class="row">
                                                    <div class="col-md-3 mb-3">
                                                        <label class="form-label">
                                                            Code <span class="text-danger">*</span>
                                                        </label>
                                                        <input type="text"
                                                               class="form-control text-uppercase @(StateProvinceCodeValidationError != null ? "is-invalid" : "")"
                                                               @bind="StateProvince.StateProvinceCode"
                                                               @bind:event="oninput"
                                                               @bind:after="OnStateProvinceCodeChanged"
                                                               disabled="@IsEdit"
                                                               placeholder="e.g., TN, KA"
                                                               maxlength="10" />
                                                        @if (StateProvinceCodeValidationError != null)
                                                        {
                                                            <span class="field-validation-error">@StateProvinceCodeValidationError</span>
                                                        }
                                                    </div>

                                                    <div class="col-md-5 mb-3">
                                                        <label class="form-label">
                                                            Name <span class="text-danger">*</span>
                                                        </label>
                                                        <input type="text"
                                                               class="form-control @(StateProvinceNameValidationError != null ? "is-invalid" : "")"
                                                               @bind="StateProvince.StateProvinceName"
                                                               @bind:event="oninput"
                                                               @bind:after="OnStateProvinceNameChanged"
                                                               @onblur="OnStateNameChangedTrim"
                                                               placeholder="e.g., Tamil Nadu"
                                                               maxlength="150" />
                                                        @if (StateProvinceNameValidationError != null)
                                                        {
                                                            <span class="field-validation-error">@StateProvinceNameValidationError</span>
                                                        }
                                                    </div>

                                                    <div class="col-md-4 mb-3">
                                                        <label class="form-label">Display Name</label>
                                                        <InputText class="form-control"
                                                                   @bind-Value="StateProvince.DisplayName"
                                                                   @bind-Value:after="OnDisplayNameChanged"
                                                                   maxlength="200" placeholder="e.g., Tamil Nadu (TN)"
                                                                   @oninput="TouchState" />
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--Country Linkage-->
                        <div class="tl-card-row @(ShowCountry ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("countryLinkage"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowCountry ? "card-active border-blue" : "")">

                                    <div class="tl-card-header"
                                         @onclick="@(() => ToggleAccordion("countryLinkage"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-blue">02</span>
                                            Country & Jurisdiction
                                        </div>
                                        <span class="tl-card-toggle @(ShowCountry ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>

                                    <div class="tl-collapse @(ShowCountry ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(AddressTouched ? "touched" : "")">

                                                <div class="row">
                                                    <div class="col-md-4 mb-3">
                                                        <label class="form-label">
                                                            Country <span class="text-danger">*</span>
                                                        </label>
                                                        <select class="form-select @(CountryValidationError != null ? "is-invalid" : "")"
                                                                @bind="SelectedCountryId"
                                                                @bind:after="OnCountryChanged"
                                                                disabled="@IsEdit">
                                                            <option value="">--Select Country--</option>
                                                            @foreach (var country in Countries)
                                                            {
                                                                <option value="@country.Id">
                                                                    @country.CountryName (@country.CountryCode)
                                                                </option>
                                                            }
                                                        </select>
                                                    </div>

                                                    <div class="col-md-4 mb-3">
                                                        <label class="form-label">
                                                            Jurisdiction Type <span class="text-danger">*</span>
                                                        </label>
                                                        <select class="form-select @(JurisdictionTypeValidationError != null ? "is-invalid" : "")"
                                                                @bind="SelectedJurisdictionType"
                                                                @bind:after="OnJurisdictionTypeChanged">
                                                            <option value="">--Select Jurisdiction Type--</option>
                                                            @foreach (var type in JurisdictionTypes.All)
                                                            {
                                                                <option value="@type">@type</option>
                                                            }
                                                        </select>
                                                    </div>

                                                    <div class="col-md-4 mt-4">
                                                        <div class="form-check">
                                                            <InputCheckbox class="form-check-input"
                                                                           @bind-Value="StateProvince.IsFederalJurisdiction"
                                                                           id="isFederal"
                                                                           @oninput="TouchAddress" />
                                                            <label class="form-check-label" for="isFederal">
                                                                Federal Jurisdiction
                                                            </label>
                                                        </div>
                                                        <small class="text-muted">
                                                            Informational – reporting/compliance
                                                        </small>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--Compliance-->
                        <div class="tl-card-row @(ShowCompliance ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("compliance"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowCompliance ? "card-active border-purple" : "")">

                                    <div class="tl-card-header"
                                         @onclick="@(() => ToggleAccordion("compliance"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-purple">03</span>
                                            Compliance & Tax Codes
                                        </div>
                                        <span class="tl-card-toggle @(ShowCompliance ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>

                                    <div class="tl-collapse @(ShowCompliance ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(ContactTouched ? "touched" : "")">

                                                <div class="row">
                                                    <div class="col-md-3 mb-3">
                                                        <label class="form-label">
                                                            GST State Code
                                                            @if (IsIndiaSelected)
                                                            {
                                                                <span class="text-danger">*</span>
                                                            }
                                                        </label>
                                                        <input type="text"
                                                               class="form-control @(GSTStateCodeValidationError != null ? "is-invalid" : "")"
                                                               @bind="StateProvince.GSTStateCode"
                                                               @bind:event="oninput" placeholder="e.g., 33"
                                                               maxlength="2" />
                                                    </div>

                                                    <div class="col-md-4 mb-3">
                                                        <label class="form-label">State Tax Jurisdiction Code</label>
                                                        <InputText class="form-control"
                                                                   @bind-Value="StateProvince.StateTaxJurisdictionCode"
                                                                   maxlength="30" placeholder="For countries with state tax systems"
                                                                   @oninput="TouchContact" />
                                                    </div>

                                                    <div class="col-md-5 mb-3">
                                                        <label class="form-label">Default Time Zone</label>
                                                        <InputSelect class="form-select"
                                                                     @bind-Value="StateProvince.DefaultTimeZoneId">
                                                            <option value="">--Select Time Zone--</option>
                                                            @foreach (var tz in TimeZones)
                                                            {
                                                                <option value="@tz.Id">@tz.DisplayName</option>
                                                            }
                                                        </InputSelect>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--Address Rules-->
                        <div class="tl-card-row @(ShowAddressRules ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("addressRules"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowAddressRules ? "card-active border-green" : "")">

                                    <div class="tl-card-header"
                                         @onclick="@(() => ToggleAccordion("addressRules"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-green">04</span>
                                            Address & Postal Rules
                                        </div>
                                        <span class="tl-card-toggle @(ShowAddressRules ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>

                                    <div class="tl-collapse @(ShowAddressRules ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(FinanceTouched ? "touched" : "")">

                                                <div class="row">
                                                    <div class="col-md-5 mb-3">
                                                        <label class="form-label">Postal Code Validation Pattern</label>
                                                        <InputText class="form-control"
                                                                   @bind-Value="StateProvince.PostalCodePattern"
                                                                   maxlength="100" placeholder="e.g., 600001"
                                                                   @oninput="TouchFinance" />
                                                    </div>

                                                    <div class="col-md-7 mb-3">
                                                        <label class="form-label">Address Format Hint</label>
                                                        <InputText class="form-control"
                                                                   @bind-Value="StateProvince.AddressFormatHint"
                                                                   maxlength="200" placeholder="Country/state-specific address patterns"
                                                                   @oninput="TouchFinance" />
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--Status & Governance-->
                        <div class="tl-card-row @(ShowStatus ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("statusGovernance"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowStatus ? "card-active border-teal" : "")">

                                    <div class="tl-card-header"
                                         @onclick="@(() => ToggleAccordion("statusGovernance"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-teal">05</span>
                                            Status & Governance
                                        </div>
                                        <span class="tl-card-toggle @(ShowStatus ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>

                                    <div class="tl-collapse @(ShowStatus ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(ReportTouched ? "touched" : "")">

                                                <div class="row">
                                                    <div class="col-md-3 mb-3">
                                                        <label class="form-label">Status <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select @(StatusValidationError != null ? "is-invalid" : "")"
                                                                @bind="SelectedStateProvinceStatus"
                                                                @bind:after="OnStatusChanged">
                                                            <option value="">--Select Status--</option>
                                                            @foreach (var status in StateProvinceStatus.All)
                                                            {
                                                                <option value="@status">@status</option>
                                                            }
                                                        </select>
                                                    </div>

                                                    <div class="col-md-3 mb-3">
                                                        <label class="form-label">Sort Order</label>
                                                        <InputNumber class="form-control"
                                                                     @bind-Value="StateProvince.SortOrder"
                                                                     min="0"
                                                                     @oninput="TouchReport" />
                                                    </div>
                                                    @* maxlength="500" *@
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Notes</label>
                                                        <RichTextEditor @ref="_notesEditor"
                                                                    Value="@StateProvince.Notes"
                                                                    MaxHeight="200" MinHeight="80"
                                                                    placeholder="Additional notes..." />
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            <div class="d-flex justify-content-end mb-4">
                <button type="button" class="btn btn-outline-secondary me-2" @onclick='() => Nav.NavigateTo("/states")'>
                    <i class="ti ti-x"></i> Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy"></i> @(IsEdit ? "Update" : "Save")
                </button>
            </div>

        </EditForm>
    </div>

}
