@page "/states"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MasterDataService MasterDataService
@inject ToastService ToastService

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">State</h4>
                    <h6>Manage your Details</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/states/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- State/Province List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search state/province"
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display: flex;
                flex-wrap: wrap;
                gap: 5px;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 160px" @bind="SelectedCountryId">
                            <option value="">All Countries</option>
                            @foreach (var country in TableCountries)
                            {
                                <option value="@country.Id">@country.CountryName</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 160px" @bind="SelectedJurisdictionType">
                            <option value="">All Jurisdictions</option>
                            @foreach (var type in TableJurisdictionTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            <option value="Draft">Draft</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th class="d-none d-md-table-cell">Code</th>
                                <th>Name</th>
                                <th class="d-none d-xl-table-cell">Country</th>
                                <th class="d-none d-xxl-table-cell">Jurisdiction</th>
                                <th class="d-none d-xxl-table-cell">GST Code</th>
                                <th class="d-none d-md-table-cell">Status</th>
                                <th class="no-sort">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedStates.Any())
                            {
                                @foreach (var s in PagedStates)
                                {
                                    <tr>
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(s)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td class="d-none d-md-table-cell">
                                            <span class="fw-medium" data-bs-toggle="tooltip"
                                                  data-bs-placement="top"
                                                  title="@s.StateProvinceCode Details">
                                                  <span class="PopupIcon me-1">⧉</span>
                                                <a @onclick="async () => await ViewState(s)" class="text-decoration-none link-View">
                                                    @s.StateProvinceCode
                                                </a>
                                            </span>
                                        </td>
                                        <td>@s.StateProvinceName</td>
                                        <td class="d-none d-xl-table-cell" title="CountryName ">@(s.CountryName ?? "-")</td>
                                        <td class="d-none d-xxl-table-cell">
                                            <span class="badge bg-info-transparent text-info">@s.JurisdictionType</span>
                                        </td>
                                        <td class="d-none d-xxl-table-cell">@(s.GSTStateCode ?? "-")</td>
                                        

                                        <td class="d-none d-md-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @GetStatusDotBadge(s.Status)">
                                                </div>
                                                <span>@s.Status</span>
                                            </div>
                                        </td>


                                        <td class="action-table-data">
                                            <div class="edit-delete-action">
                                                @* <a class="me-2 view-icon p-1" href="javascript:void(0);" title="View"
                                                   data-bs-toggle="modal" data-bs-target="#view-state-modal"
                                                   @onclick="async () => await ViewState(s)">
                                                    <i data-feather="eye"></i>
                                                </a> *@
                                                <a class="me-2 p-1 edit-icon" href="/states/@s.Id">
                                                    <i data-feather="edit"></i>
                                                </a>
                                                @if (s.IsActive)
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon deactivate-icon" href="javascript:void(0);"
                                                       title="Deactivate" data-bs-toggle="modal" data-bs-target="#deactivate-modal"
                                                       @onclick="() => ConfirmDeactivate(s)">
                                                        <i class="ti ti-toggle-right"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Activate" data-bs-toggle="modal" data-bs-target="#activate-modal"
                                                       @onclick="() => ConfirmActivate(s)">
                                                        <i class="ti ti-toggle-left"></i>
                                                    </a>
                                                }
                                                <a class="me-2 p-1 Toggle-icon action-icon delete-icon" href="javascript:void(0);"
                                                   title="Delete" data-bs-toggle="modal" data-bs-target="#delete-modal"
                                                   @onclick="() => ConfirmDelete(s)">
                                                    <i class="ti ti-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center py-4">
                                        <div class="text-muted">
                                            <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                            No states/provinces found
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (FilteredStates.Any())
                {
                    <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4">
                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows per page</span>
                            <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                                <option value="5" selected="@(PageSize == 5)">5</option>

                                <option value="10" selected="@(PageSize == 10)">10</option>
                                <option value="25" selected="@(PageSize == 25)">25</option>
                                <option value="50" selected="@(PageSize == 50)">50</option>
                            </select>
                            <span class="ms-3 text-muted">
                                Entries
                            </span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = StartPage; i <= EndPage; i++)
                                {
                                    int pageNum = i;
                                    <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                        <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>




        <!-- Activate Modal -->
        <div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-toggle-right fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate State/Province</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to activate <strong>@SelectedState?.StateProvinceName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-right me-1"></i>Yes, Activate</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deactivate Modal -->
        <div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                                <i class="ti ti-toggle-left fs-24 text-warning"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate State/Province</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDeactivate)
                                {
                                    <span class="text-danger">Cannot deactivate! Please deactivate all cities under this state first.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to deactivate <strong>@SelectedState?.StateProvinceName</strong>?</span>
                                }
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDeactivate)
                                {
                                    <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-left me-1"></i>Yes, Deactivate</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                <i class="ti ti-trash fs-24 text-danger"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete State/Province</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDelete)
                                {
                                    <span class="text-danger">Cannot delete! Please delete all cities under this state first.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to delete <strong>@SelectedState?.StateProvinceName</strong>?</span>
                                }
                            </p>
                            @if (canDelete)
                            {
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                            }
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDelete)
                                {
                                    <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteConfirmed" data-bs-dismiss="modal"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
}




<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Company Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>

            <div class="modal-body">
                <div class="mb-2 d-flex gap-3">
                    <strong>Country Name:</strong>
                    <div>@(SelectedCompany?.CountryName ?? "-")</div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Jurisdiction Type:</strong>
                    <div>@SelectedCompany?.JurisdictionType</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>GSTState Code:</strong>
                    <div>@(SelectedCompany?.GSTStateCode ?? "-")</div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Status:</strong>
                    <div>
                        <span class="badge @GetStatusBadge(SelectedCompany?.Status)">
                            @(SelectedCompany?.Status ?? "-")
                        </span>
                    </div>

                </div>


            </div>

        </div>
    </div>
</div>




<!-- View State Offcanvas -->
<div class="offcanvas offcanvas-end offcanvas-view"
     tabindex="-1"
     id="viewStateOffcanvas"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    @if (SelectedState != null)
    {
        <!-- Header -->
        <div class="offcanvas-header">
            <div class="oc-avatar">
                @SelectedState.StateProvinceCode
            </div>

            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@SelectedState.StateProvinceName</h5>

                    <span class="oc-status-pill @(SelectedState.Status == "Active" ? "active" : "inactive")">
                        <span class="oc-status-dot"></span>
                        @SelectedState.Status
                    </span>
                </div>

                <p class="oc-header-sub">
                    @(SelectedState.DisplayName ?? SelectedState.StateProvinceName)
                </p>
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close"></button>
        </div>


        <!-- Body -->
        <div class="offcanvas-body">

            <!-- Summary Cards -->
            <div class="oc-summary-row">

                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value">
                        @SelectedState.StateProvinceCode
                    </div>
                    <div class="oc-summary-label">Code</div>
                </div>

                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value">
                        @(SelectedState.CountryName ?? "—")
                    </div>
                    <div class="oc-summary-label">Country</div>
                </div>

                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value">
                        @SelectedState.SortOrder
                    </div>
                    <div class="oc-summary-label">Sort Order</div>
                </div>

            </div>


            <!-- State Identity -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-map"></i>
                    <h6 class="oc-card-title">State / Province Identity</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-tag"></i> Code
                            </div>
                            <div class="oc-field-value">
                                @SelectedState.StateProvinceCode
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-writing"></i> Name
                            </div>
                            <div class="oc-field-value">
                                @SelectedState.StateProvinceName
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-id"></i> Display Name
                            </div>
                            <div class="oc-field-value">
                                @(SelectedState.DisplayName ?? "—")
                            </div>
                        </div>

                    </div>
                </div>
            </div>


            <!-- Country & Jurisdiction -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-flag"></i>
                    <h6 class="oc-card-title">Country & Jurisdiction</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-world"></i> Country
                            </div>
                            <div class="oc-field-value">
                                @(SelectedState.CountryName ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-shield"></i> Jurisdiction Type
                            </div>
                            <div class="oc-field-value">
                                <span class="badge bg-info-transparent text-info">
                                    @SelectedState.JurisdictionType
                                </span>
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-building-community"></i> Federal Jurisdiction
                            </div>
                            <div class="oc-field-value">
                                <span class="oc-dot-badge @(SelectedState.IsFederalJurisdiction ? "db-green" : "db-red")">
                                    <span class="dot"></span>
                                    @(SelectedState.IsFederalJurisdiction ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>


            <!-- Compliance & Tax -->
            <div class="oc-card">
                <div class="oc-card-header hdr-purple">
                    <i class="ti ti-file-certificate"></i>
                    <h6 class="oc-card-title">Compliance & Tax Codes</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-receipt"></i> GST State Code
                            </div>
                            <div class="oc-field-value">
                                @(SelectedState.GSTStateCode ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-code"></i> State Tax Code
                            </div>
                            <div class="oc-field-value">
                                @(SelectedState.StateTaxJurisdictionCode ?? "—")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-clock"></i> Default Time Zone
                            </div>
                            <div class="oc-field-value">
                                @(GetTimeZoneName(SelectedState.DefaultTimeZoneId) ?? "—")
                            </div>
                        </div>

                    </div>
                </div>
            </div>


            <!-- Address & Postal Rules -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-map-pin"></i>
                    <h6 class="oc-card-title">Address & Postal Rules</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-mail"></i> Postal Code Pattern
                            </span>
                            <span class="oc-list-value">
                                <code>@(SelectedState.PostalCodePattern ?? "—")</code>
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-align-left"></i> Address Format Hint
                            </span>
                            <span class="oc-list-value">
                                @(SelectedState.AddressFormatHint ?? "—")
                            </span>
                        </div>

                    </div>
                </div>
            </div>


            <!-- Status & Audit -->
            <div class="oc-card">
                <div class="oc-card-header hdr-teal">
                    <i class="ti ti-settings"></i>
                    <h6 class="oc-card-title">Status & Governance</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-toggle-right"></i> Status
                            </span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedState.Status == "Active" ? "db-green" : "db-red")">
                                    <span class="dot"></span>
                                    @SelectedState.Status
                                </span>
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-sort-ascending"></i> Sort Order
                            </span>
                            <span class="oc-list-value">
                                @SelectedState.SortOrder
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-calendar-plus"></i> Created
                            </span>
                            <span class="oc-list-value">
                                @SelectedState.CreatedAt.ToString("dd-MMM-yyyy")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-user"></i> Created By
                            </span>
                            <span class="oc-list-value">
                                @(SelectedState.CreatedBy ?? "—")
                            </span>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    }
</div>
