@page "/branches/create"
@page "/branches/{Id:guid}"
@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels
@inject IJSRuntime JS
@inject ToastService ToastService

<style>
    .form-select option:checked {
        color: white;
        background-color: var(--primary);
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }
</style>

<div class="content Accordion-form">
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">@PageTitle</h4>
                <h6>@PageSubTitle</h6>
            </div>
        </div>
        <div class="page-btn mt-0">
            <button type="button" class="btn btn-outline-secondary" @onclick="BackToList">
                <i class="ti ti-arrow-left"></i> Back
            </button>
        </div>
    </div>

    <EditForm EditContext="_editContext" OnSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="add-product" style="background:#f4f7fb; padding:24px 14px;">
            <div class="tl-accordion">

               <!---- LEFT PANEL – Fixed sidebar (never expands) ------>
                <div class="tl-left-panel">

                    <div class="tl-label @(ShowIdentity ? "active accent-orange" : "")"
                         @onclick="@(() => ToggleAccordion("branchIdentity"))">
                        <div class="tl-label-icon ico-orange"><i data-feather="info"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Branch Identity</div>
                            <div class="tl-label-sub">Basic branch information</div>
                        </div>
                        <span class="tl-label-chevron @(ShowIdentity ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowAddress ? "active accent-blue" : "")"
                         @onclick="@(() => ToggleAccordion("branchAddress"))">
                        <div class="tl-label-icon ico-blue"><i data-feather="map-pin"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Location & Address</div>
                            <div class="tl-label-sub">Official branch location</div>
                        </div>
                        <span class="tl-label-chevron @(ShowAddress ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowContact ? "active accent-purple" : "")"
                         @onclick="@(() => ToggleAccordion("branchContact"))">
                        <div class="tl-label-icon ico-purple"><i data-feather="phone"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Contact & Operations</div>
                            <div class="tl-label-sub">Phone, email & hours</div>
                        </div>
                        <span class="tl-label-chevron @(ShowContact ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowFinance ? "active accent-green" : "")"
                         @onclick="@(() => ToggleAccordion("branchFinance"))">
                        <div class="tl-label-icon ico-green"><i data-feather="lock"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Financial Controls</div>
                            <div class="tl-label-sub">Posting dates & lock period</div>
                        </div>
                        <span class="tl-label-chevron @(ShowFinance ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowReport ? "active accent-rose" : "")"
                         @onclick="@(() => ToggleAccordion("branchReport"))">
                        <div class="tl-label-icon ico-rose"><i data-feather="bar-chart-2"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Reporting & Visibility</div>
                            <div class="tl-label-sub">Report inclusion & visibility</div>
                        </div>
                        <span class="tl-label-chevron @(ShowReport ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowStatus ? "active accent-teal" : "")"
                         @onclick="@(() => ToggleAccordion("branchStatus"))">
                        <div class="tl-label-icon ico-teal"><i data-feather="check-circle"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Status & Notes</div>
                            <div class="tl-label-sub">Branch status & comments</div>
                        </div>
                        <span class="tl-label-chevron @(ShowStatus ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                </div>

                <!---- RIGHT AREA – Timeline dots + Expanding Cards --->
                <div class="tl-right-area">

                    <!---- Branch Identity ------->
                    <div class="tl-card-row @(ShowIdentity ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("branchIdentity"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowIdentity ? "card-active border-orange" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("branchIdentity"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-orange">01</span>
                                        Branch Identity
                                    </div>
                                    <span class="tl-card-toggle @(ShowIdentity ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>
                                <div class="tl-collapse @(ShowIdentity ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(IdentityTouched ? "touched" : "")">
                                            <div class="row">
                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Branch Code <span class="text-danger ms-1">*</span></label>
                                                    <input class="form-control text-uppercase @GetValidationClass(() => branch.BranchCode)"
                                                           @bind="BranchCodeInput"
                                                           disabled="@IsEdit" placeholder="E.G., ASC001" maxlength="10" @oninput="TouchIdentity" />
                                                    <ValidationMessage For="@(() => branch.BranchCode)" />
                                                </div>
                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Branch Name <span class="text-danger ms-1">*</span></label>
                                                    <input class="form-control @GetValidationClass(() => branch.BranchName)"
                                                           @bind="branch.BranchName" @bind:after="OnBranchNameInput" placeholder="e.g., Ascending Tirunelveli" maxlength="200" @oninput="TouchIdentity" />
                                                    <ValidationMessage For="@(() => branch.BranchName)" />
                                                </div>
                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Company <span class="text-danger ms-1">*</span></label>
                                                    <select class="form-select @GetValidationClass(() => branch.Company)"
                                                            @bind="branch.CompanyId" @bind:after="OnChangeCompany" @oninput="TouchIdentity">
                                                        <option value="@Guid.Empty">-- Select Company --</option>
                                                        @foreach (var c in Companies)
                                                        {
                                                            <option value="@c.Id">@c.LegalName</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => branch.Company)" />
                                                </div>
                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Branch Type <span class="text-danger ms-1">*</span></label>
                                                    <select class="form-select @GetValidationClass(() => branch.BranchType)"
                                                            @bind="SelectedBranchType" @oninput="TouchIdentity">
                                                        <option value="">-- Select Branch Type --</option>
                                                        @foreach (var type in BranchTypeList)
                                                        {
                                                            <option value="@type">@type</option>
                                                        }
                                                        <option value="__OTHER__">Other</option>
                                                    </select>
                                                    <ValidationMessage For="@(() => branch.BranchType)" />
                                                </div>
                                                @if (ShowOtherBranchType)
                                                {
                                                    <div class="col-sm-6 mb-3">
                                                        <label class="form-label">Specify Branch Type <span class="text-danger ms-1">*</span></label>
                                                        <input class="form-control"
                                                               @bind="branch.BranchType"
                                                               placeholder="Enter branch type" maxlength="10" @oninput="TouchIdentity" />
                                                    </div>
                                                }
                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Parent Branch</label>
                                                    <select class="form-select"
                                                            @bind="branch.ParentBranchId" @oninput="TouchIdentity">
                                                        <option value="">None</option>
                                                        @foreach (var b in ParentBranches)
                                                        {
                                                            <option value="@b.Id">@b.BranchCode - @b.BranchName</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-sm-6 d-flex align-items-center">
                                                    <div class="form-check form-switch mt-3">
                                                        <input class="form-check-input" type="checkbox" id="defaultBranchChk"
                                                               @bind="branch.IsDefaultBranch" @oninput="TouchIdentity" />
                                                        <label class="form-check-label" for="defaultBranchChk">Default Branch</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!---- Location & Address ------>
                    <div class="tl-card-row @(ShowAddress ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("branchAddress"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowAddress ? "card-active border-blue" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("branchAddress"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-blue">02</span>
                                        Location & Address
                                    </div>
                                    <span class="tl-card-toggle @(ShowAddress ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>
                                <div class="tl-collapse @(ShowAddress ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(AddressTouched ? "touched" : "")">
                                            <div class="row">
                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Address Line 1 <span class="text-danger ms-1">*</span></label>
                                                    <input class="form-control @GetValidationClass(() => branch.AddressLine1)"
                                                           @bind="branch.AddressLine1" placeholder="e.g., D20,'C'' colony" maxlength="200" @oninput="TouchAddress" />
                                                    <ValidationMessage For="@(() => branch.AddressLine1)" />
                                                </div>
                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Address Line 2</label>
                                                    <input class="form-control"
                                                           @bind="branch.AddressLine2" placeholder="e.g., Perumalpuram" maxlength="200" @oninput="TouchAddress" />
                                                </div>
                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Country <span class="text-danger ms-1">*</span></label>
                                                    <select class="form-select @GetValidationClass(() => branch.CountryId)"
                                                            @bind="SelectedCountry" @oninput="TouchAddress">
                                                        <option value="@Guid.Empty">-- Select Country --</option>
                                                        @foreach (var ct in Countries)
                                                        {
                                                            <option value="@ct.Id">@ct.CountryName</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => branch.CountryId)" />
                                                </div>
                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">State <span class="text-danger ms-1">*</span></label>
                                                    <select class="form-select @GetValidationClass(() => branch.StateId)"
                                                            @bind="SelectedState" @oninput="TouchAddress">
                                                        <option value="@Guid.Empty">-- Select State --</option>
                                                        @foreach (var s in States)
                                                        {
                                                            <option value="@s.Id">@s.StateProvinceName</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => branch.StateId)" />
                                                </div>
                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">City <span class="text-danger ms-1">*</span></label>
                                                    <select class="form-select @GetValidationClass(() => branch.CityId)"
                                                            @bind="branch.CityId" disabled="@(!Cities.Any())" @oninput="TouchAddress">
                                                        <option value="@Guid.Empty">-- Select City --</option>
                                                        @foreach (var ci in Cities)
                                                        {
                                                            <option value="@ci.Id">@ci.CityName</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => branch.CityId)" />
                                                </div>
                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Postal Code <span class="text-danger ms-1">*</span></label>
                                                    <input class="form-control @GetValidationClass(() => branch.PostalCode)"
                                                           value="@branch.PostalCode" placeholder="e.g., 627002" maxlength="10"
                                                           @oninput="OnPostalCodeInput" @oninput="TouchAddress" />
                                                    <ValidationMessage For="@(() => branch.PostalCode)" />
                                                </div>
                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Time Zone</label>
                                                    <select class="form-select"
                                                            @bind="branch.TimeZoneId" @oninput="TouchAddress">
                                                        <option value="">Inherit Company</option>
                                                        @foreach (var tz in TimeZones)
                                                        {
                                                            <option value="@tz.Id">@tz.DisplayName</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!---- Contact & Operations ------->
                    <div class="tl-card-row @(ShowContact ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("branchContact"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowContact ? "card-active border-purple" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("branchContact"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-purple">03</span>
                                        Contact & Operational Settings
                                    </div>
                                    <span class="tl-card-toggle @(ShowContact ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>
                                <div class="tl-collapse @(ShowContact ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(ContactTouched ? "touched" : "")">
                                            <div class="row">
                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Branch Manager Name</label>
                                                    <input class="form-control"
                                                           @bind="branch.BranchManagerName" placeholder="e.g., Rajesh Kumar" maxlength="100" @oninput="TouchContact" />
                                                </div>
                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Branch Email</label>
                                                    <input type="email" class="form-control" placeholder="e.g., contact@company.com" maxlength="150"
                                                           @bind="branch.BranchEmail" @oninput="TouchContact" />
                                                    <ValidationMessage For="@(() => branch.BranchEmail)" />
                                                </div>
                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Branch Phone</label>
                                                    <input class="form-control" inputmode="tel"
                                                           pattern="[\+0-9\s\-\(\)]*"
                                                           title="Digits, +, -, spaces and parentheses only"
                                                           placeholder="e.g., +91-44-12345678" maxlength="30"
                                                           @bind="branch.BranchPhone" @oninput="TouchContact" />
                                                    <ValidationMessage For="@(() => branch.BranchPhone)" />
                                                </div>
                                                <div class="col-sm-12 mb-3">
                                                    <label class="form-label">Operating Hours / Notes</label>
                                                     <RichTextEditor @ref="_hoursNotesEditor"
                                                                    Value="@branch.OperatingHoursNote"
                                                                    Placeholder="Additional notes..."
                                                                    MinHeight="80"
                                                                    MaxHeight="200" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!---- Financial Controls ---->
                    <div class="tl-card-row @(ShowFinance ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("branchFinance"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowFinance ? "card-active border-green" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("branchFinance"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-green">04</span>
                                        Financial & Posting Controls
                                    </div>
                                    <span class="tl-card-toggle @(ShowFinance ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>
                                <div class="tl-collapse @(ShowFinance ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(FinanceTouched ? "touched" : "")">
                                            <div class="row">
                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Books Start Date</label>
                                                    <input type="date" class="form-control"
                                                           @bind="branch.BooksStartDate" min="@CompanyMinDate" @oninput="TouchFinance" />
                                                </div>
                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Allow Posting From</label>
                                                    <input type="date" class="form-control"
                                                           @bind="branch.AllowPostingFrom"
                                                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                                           @oninput="TouchFinance" />
                                                </div>
                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Allow Posting To</label>
                                                    <input type="date" class="form-control"
                                                           @bind="branch.AllowPostingTo"
                                                           min="@(branch.AllowPostingFrom?.ToString("yyyy-MM-dd"))"
                                                           @oninput="TouchFinance" />
                                                </div>
                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Backdated Posting Allowed (Days)</label>
                                                    <input type="number" min="0" class="form-control" placeholder="e.g., 0"
                                                           @bind="branch.BackdatedPostingDaysAllowed" @oninput="TouchFinance" />
                                                    <ValidationMessage For="@(() => branch.BackdatedPostingDaysAllowed)" />
                                                </div>
                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Future Posting Allowed (Days)</label>
                                                    <input type="number" min="0" class="form-control" placeholder="e.g., 0"
                                                           @bind="branch.FuturePostingDaysAllowed" @oninput="TouchFinance" />
                                                    <ValidationMessage For="@(() => branch.FuturePostingDaysAllowed)" />
                                                </div>
                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox" id="lockBased"
                                                               @bind="branch.LockBackDatedPosting" @oninput="TouchFinance" />
                                                        <label class="form-check-label" for="lockBased">Lock Back-Dated Posting</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                   <!---- Reporting & Visibility ----->
                    <div class="tl-card-row @(ShowReport ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("branchReport"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowReport ? "card-active border-rose" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("branchReport"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-rose">05</span>
                                        Reporting & Visibility Controls
                                    </div>
                                    <span class="tl-card-toggle @(ShowReport ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>
                                <div class="tl-collapse @(ShowReport ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(ReportTouched ? "touched" : "")">
                                            <div class="row">
                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Report Sort Order</label>
                                                    <input type="number" min="0" class="form-control" placeholder="e.g., 0"
                                                           @bind="branch.ReportSortOrder" @oninput="TouchReport" />
                                                    <ValidationMessage For="@(() => branch.ReportSortOrder)" />
                                                </div>
                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Branch Color Tag</label>
                                                    <select class="form-select"
                                                            @bind="branch.BranchColorTag" @oninput="TouchReport">
                                                        <option value="">Select</option>
                                                        <option>Blue</option>
                                                        <option>Green</option>
                                                        <option>Orange</option>
                                                        <option>Purple</option>
                                                    </select>
                                                </div>
                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox" id="BranchReport"
                                                               @bind="branch.IsReportingEnabled" @oninput="TouchReport" />
                                                        <label class="form-check-label" for="BranchReport">Include Branch in Reports</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!---- Status & Notes ----->
                    <div class="tl-card-row @(ShowStatus ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("branchStatus"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowStatus ? "card-active border-teal" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("branchStatus"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-teal">06</span>
                                        Status & Notes
                                    </div>
                                    <span class="tl-card-toggle @(ShowStatus ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>
                                <div class="tl-collapse @(ShowStatus ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(StatusTouched ? "touched" : "")">
                                            <div class="row">
                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Branch Status <span class="text-danger ms-1">*</span></label>
                                                    <select class="form-select"
                                                            @bind="branch.Status" @oninput="TouchStatus">
                                                        <option>Draft</option>
                                                        <option>Active</option>
                                                        <option>Inactive</option>
                                                    </select>
                                                    <ValidationMessage For="@(() => branch.Status)" />
                                                </div>
                                                <div class="col-sm-8 mb-3">
                                                    <label class="form-label">Internal Notes</label>
                                                    <RichTextEditor @ref="_notesEditor"
                                                                    Value="@branch.Notes"
                                                                    Placeholder="Enter internal notes..."
                                                                    MinHeight="80"
                                                                    MaxHeight="200" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <div class="page-btn d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary" @onclick="BackToList">
                    <i class="ti ti-x"></i> Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy"></i> @(IsEdit ? "Update" : "Save")
                </button>
            </div>
        </div>
    </EditForm>
</div>

<!-- Global Confirmation Modal -->
<div class="modal fade" id="confirm-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2
                        @(ConfirmType == "danger" ? "bg-danger-transparent" : "bg-warning-transparent") mb-2">
                        <i class="ti @(ConfirmType == "danger" ? "ti-trash text-danger" : "ti-alert-circle text-warning") fs-24"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">@ConfirmTitle</h4>
                    <p class="text-gray-6 mb-0 fs-16">@ConfirmMessage</p>
                    <div class="modal-footer-btn mt-3 d-flex justify-content-center" style="column-gap: 20px">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-3 shadow-none"
                                data-bs-dismiss="modal">
                            <i class="ti ti-x me-1"></i>Cancel
                        </button>
                        @if (ConfirmAction != null)
                        {
                            <button type="button" class="btn btn-primary fs-13 fw-medium p-2 px-3"
                                    @onclick="ConfirmYes"><i class="ti ti-check me-1"></i>Yes, Continue</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
