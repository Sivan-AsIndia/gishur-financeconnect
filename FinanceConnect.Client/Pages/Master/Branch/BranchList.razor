@page "/branches"
@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject BranchService BranchService
@inject ToastService ToastService
<style>
    .form-select option:checked {
        color: #fff;
        background: #FE9F43;
    }

    .form-select:focus {
        border-color: #FE9F43;
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
<div class="content List-view">

    <!-- Page Header -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Branch List</h4>
                <h6>Manage your branches</h6>
            </div>
        </div>

        <ul class="table-top-head">
            <li>
                <a href="javascript:void(0);"
                   title="Refresh"
                       @onclick="OnRefreshAsync">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>

        <div class="page-btn">
            <a href="/branches/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i>
                Create
            </a>
        </div>
    </div>

    <!-- Branch List -->
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

            <!-- Search -->
            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset">
                        <i class="ti ti-search fs-14"></i>
                    </span>
                    <input type="search"
                           class="form-control form-control-sm"
                           placeholder="Search branch"
                           @bind="searchText"
                           @oninput="OnSearch" />
                </div>
            </div>
            <div style="display:flex">
                <!-- Company Filter -->
                <div>
                    <select class="form-select form-select-sm"
                            style="min-width: 180px"
                            @bind="SelectedCompany">
                        <option value="">All Companies</option>
                        @foreach (var c in Companies)
                        {
                            <option value="@c.Id">@c.LegalName</option>
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="ms-2">
                    <select class="form-select form-select-sm"
                            style="min-width: 140px"
                            @bind="SelectedStatus">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Draft">Draft</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>

        </div>

        <div class="card-body p-0">
            <div class="">
                <div>
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th style="width:165px" title="Branch Code">Code</th>
                                <th class="d-none d-md-table-cell" title="Branch Name">Name</th>
                                <th class="d-none d-md-table-cell">Company</th>
                                @* <th class="d-none d-lg-table-cell">Country</th> *@
                                <th class="d-none d-xl-table-cell" style="width: 140px;">City</th>
                                <th class="d-none d-xxl-table-cell" style="width: 117px;">Status</th>
                                <th class="no-sort" style="width: 140px;">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (PagedBranches.Any())
                            {
                                @foreach (var b in PagedBranches)
                                {
                                    <tr>
                                        <!-- PLUS ICON -->
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(b)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-start flex-column gap-2">

                                                <span class="fw-medium ">
                                                    <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                    <a @onclick="() => ViewBranch(b)" class="link-View text-decoration-none link-View"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       title="@b.BranchCode details">
                                                        @b.BranchCode
                                                    </a>
                                                </span>

                                                @if (b.IsDefaultBranch)
                                                {
                                                    <span class="badge bg-warning-transparent text-warning"
                                                          title="Default Branch">
                                                        Default
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td class="d-none d-md-table-cell">@b.BranchName</td>
                                        <td class="d-none d-md-table-cell">@BranchService.GetCompanyNameById(b.CompanyId)</td>
                                        @* <td class="d-none d-lg-table-cell" title="@BranchService.GetCountryNameById(b.CountryId)">@BranchService.GetCountryNameById(b.CountryId)</td> *@
                                        <td class="d-none d-xl-table-cell">@BranchService.GetCityNameById(b.CityId)</td>

                                        <td class="d-none d-xxl-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @GetStatusBadge(b.Status)">
                                                </div>
                                                <span>@b.Status</span>
                                            </div>
                                        </td>


                                        <td class="action-table-data">
                                            <div class="edit-delete-action">
                                                @* <a class="me-2 view-icon p-1" title="View Branch"
                                                   href="javascript:void(0);"
                                                   @onclick="() => ViewBranch(b)">
                                                    <i data-feather="eye"></i>
                                                </a> *@

                                                <a class="me-2 edit-icon p-1" title="Edit Branch" @onclick='() => Nav.NavigateTo($"/branches/{b.Id}")'>
                                                    <i data-feather="edit"></i>
                                                </a>
                                                @if (b.Status == "Active")
                                                {
                                                    <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon" href="javascript:void(0);"
                                                       title="Deactivate" data-bs-toggle="modal" data-bs-target="#deactivate-modal"
                                                       @onclick="() => ConfirmDeactivate(b)">
                                                        <i class="ti ti-toggle-right"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Activate" data-bs-toggle="modal" data-bs-target="#activate-modal"
                                                       @onclick="() => ConfirmActivate(b)">
                                                        <i class="ti ti-toggle-left"></i>
                                                    </a>
                                                }
                                                <a class="p-1 delete-icon" title="Delete Branch" data-bs-toggle="modal" data-bs-target="#delete-modal" @onclick="() => ConfirmDelete(b)">
                                                    <i data-feather="trash-2"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else if (!PagedBranches.Any())
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center py-4">
                                        <div class="text-muted">
                                            <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                            No branches found
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (PagedBranches.Any())
                {
                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center p-3">

                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto"
                                    @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">

                                <!-- Prev -->
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                       @onclick="PreviousPage"
                                       @onclick:preventDefault>
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>

                                <!-- Pages -->
                                @foreach (var pageNumber in VisiblePages)
                                {
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button"
                                                class="page-link"
                                                @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }

                                <!-- Next -->
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                       @onclick="NextPage"
                                       @onclick:preventDefault>
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>



    <!-- Activate Modal -->
    <div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                            <i class="ti ti-toggle-right fs-24 text-success"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Branch</h4>
                        <p class="text-gray-6 mb-0 fs-16" style="max-width: 95%;" title="@SelectedBranch?.BranchName">
                            Are you sure you want to activate <strong>@SelectedBranch?.BranchName</strong>?
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal">
                                <i class="ti ti-toggle-right me-1"></i>Yes, Activate
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Deactivate Modal -->
    <div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                            <i class="ti ti-toggle-left fs-24 text-warning"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate Branch</h4>
                        <p class="text-gray-6 mb-0 fs-16" style="max-width: 95%;" title="@SelectedBranch?.BranchName">
                            @if (!canDeactivate)
                            {
                                <span class="text-danger">Cannot deactivate! Branch has active references.</span>
                            }
                            else
                            {
                                <span>Are you sure you want to deactivate <strong>@SelectedBranch?.BranchName</strong>?</span>
                            }
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            @if (canDeactivate)
                            {
                                <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal">
                                    <i class="ti ti-toggle-left me-1"></i>Yes, Deactivate
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- delete modal -->
    <div class="modal fade" id="delete-modal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Branch</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            @if (!canDelete)
                            {
                                <span class="text-danger">Cannot delete this branch. Postings exist for this branch.</span>
                            }
                            else
                            {
                                <span>Are you sure you want to delete <strong title="@SelectedBranch?.BranchName">@SelectedBranch?.BranchName</strong>?</span>
                            }
                        </p>

                             @if (canDelete)
                            {
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                            }
                        <div class="modal-footer-btn mt-3 d-flex justify-content-center">
                            <button type="button" class="btn me-2 btn-outline-secondary fs-13 fw-medium p-2 px-3 shadow-none" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            @if (canDelete)
                            {
                                <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteConfirmed" data-bs-dismiss="modal">
                                    <i class="ti ti-trash me-1"></i>Yes, Delete
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


</div>
}

<!-- View Branch Modal -->
<div class="modal fade" id="view-branch-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ti ti-building me-2 text-primary"></i>View Branch Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding: 0; right: 20px; top: 20px; position: absolute;">
                </button>
            </div>

            <div class="modal-body">
                @if (SelectedBranch != null)
                {
                    <div class="row g-3">

                        <!-- ================= Branch Identity ================= -->
                        <div class="col-12">
                            <h6 class="text-primary">
                                <i class="ti ti-id me-2"></i>Branch Identity
                            </h6>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Branch Code</label>
                            <div class="fw-medium">@SelectedBranch.BranchCode</div>
                        </div>

                        <div class="col-md-5">
                            <label class="text-muted small">Branch Name</label>
                            <div class="fw-medium text-truncate" style="max-width: 95%;" title="@SelectedBranch.BranchName">
                                @SelectedBranch.BranchName
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Company</label>
                            <div>@SelectedBranch.Company</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Branch Type</label>
                            <div>@SelectedBranch.BranchType</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Default Branch</label>
                            <div>
                                @if (SelectedBranch.IsDefaultBranch)
                                {
                                    <span class="badge bg-success-transparent text-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-transparent text-secondary">No</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Status</label>
                            <div>
                                <span class="badge @GetStatusBadge(SelectedBranch.Status)">
                                    @SelectedBranch.Status
                                </span>
                            </div>
                        </div>

                        <!-- ================= Location & Address ================= -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary">
                                <i class="ti ti-map-pin me-2"></i>Location & Address
                            </h6>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small">Address Line 1</label>
                            <div class="text-truncate" style="max-width: 95%;" title="@SelectedBranch?.AddressLine1">
                                @SelectedBranch?.AddressLine1
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small">Address Line 2</label>
                            <div class="text-truncate" style="max-width: 95%;" title="@SelectedBranch?.AddressLine2">
                                @(SelectedBranch?.AddressLine2 ?? "-")
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Country</label>
                            <div>@BranchService.GetCountryNameById(SelectedBranch.CountryId)</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">State</label>
                            <div>@BranchService.GetStateNameById(SelectedBranch.StateId)</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">City</label>
                            <div>@BranchService.GetCityNameById(SelectedBranch.CityId)</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Postal Code</label>
                            <div>@SelectedBranch.PostalCode</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Time Zone</label>
                            <div>@BranchService.GetTZNameById(SelectedBranch.TimeZoneId)</div>
                        </div>

                        <!-- ================= Contact & Operations ================= -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary">
                                <i class="ti ti-phone me-2"></i>Contact & Operations
                            </h6>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Branch Manager</label>
                            <div>@(SelectedBranch.BranchManagerName ?? "-")</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Phone</label>
                            <div>@(SelectedBranch.BranchPhone ?? "-")</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Email</label>
                            <div>@(SelectedBranch.BranchEmail ?? "-")</div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small">Operating Notes</label>
                            <div class="text-truncate" style="max-width: 95%;" title="@SelectedBranch?.OperatingHoursNote">
                                @(SelectedBranch?.OperatingHoursNote ?? "-")
                            </div>
                        </div>

                        <!-- ================= Reporting & Visibility ================= -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary">
                                <i class="ti ti-chart-bar me-2"></i>Reporting & Visibility
                            </h6>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Reporting Enabled</label>
                            <div>
                                @if (SelectedBranch.IsReportingEnabled)
                                {
                                    <span class="badge bg-success-transparent text-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-transparent text-secondary">Disabled</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Report Sort Order</label>
                            <div>@SelectedBranch.ReportSortOrder</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Branch Color Tag</label>
                            <div>@(SelectedBranch.BranchColorTag ?? "-")</div>
                        </div>

                    </div>
                }
            </div>

        </div>
    </div>
</div>

<!-- Responsive modal -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Branch Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>
            @if (SelectedBranch != null)
            {
                <div class="modal-body">

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Branch:</strong>
                        <div class="text-truncate" style="max-width: 95%;" title="@SelectedBranch.BranchName">
                            @SelectedBranch.BranchName
                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Company:</strong>
                        <div>@SelectedBranch.Company</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Country:</strong>
                        <div>@BranchService.GetCountryNameById(SelectedBranch.CountryId)</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>City:</strong>
                        <div>@BranchService.GetCityNameById(SelectedBranch.CityId)</div>
                    </div>

                    <div class="mb-2 gap-3">
                        <strong>Status:</strong>
                        <span class="badge @GetStatusBadge(SelectedBranch.Status)">
                            @(SelectedBranch.Status ?? "-")
                        </span>

                    </div>


                </div>
            }
        </div>
    </div>
</div>

