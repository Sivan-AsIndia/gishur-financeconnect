@page "/timezones"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MasterDataService MasterDataService
@inject ToastService ToastService

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Time Zone List</h4>
                    <h6>Manage your time zones</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/timezones/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Time Zone List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search time zone"
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display:flex">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedDST">
                            <option value="">All DST</option>
                            <option value="yes">Supports DST</option>
                            <option value="no">No DST</option>
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            <option value="Draft">Draft</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th class="td-width">ID</th>
                                <th class="d-none d-md-table-cell">Name</th>
                                @* <th class="d-none d-xxl-table-cell">Short Name</th> *@
                                <th class="d-none d-xl-table-cell td-offset-width">UTC Offset</th>
                                <th class="td-xxxl td-offset-width">Offset (Minutes)</th>
                                <th class="d-none d-md-table-cell" style="width: 150px;">Status</th>
                                <th class="no-sort" style="width: 115px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedTimeZones.Any())
                            {
                                @foreach (var t in PagedTimeZones)
                                {
                                    <tr>
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(t)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td>
                                            <span class="fw-medium" data-bs-toggle="tooltip"
                                                  data-bs-placement="top"
                                                  title="@t.TimeZoneKey Details">
                                                <span class="PopupIcon">⧉</span>
                                                <a @onclick="async () => await ViewTimeZone(t)" class="text-decoration-none link-View">
                                                    @t.TimeZoneKey
                                                </a>
                                            </span>
                                        </td>
                                        <td class="d-none d-md-table-cell">
                                            <div class="d-flex flex-column gap-1">
                                                <span>@t.DisplayName</span>
                                                <span title="DST">
                                                    @if (t.SupportsDST)
                                                    {
                                                        <span class="badge bg-info-transparent text-info">Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-transparent text-secondary">No</span>
                                                    }
                                                </span>
                                            </div>
                                         
                                        </td>
                                        @* <td class="d-none d-xxl-table-cell" title="@t.ShortName ">@(t.ShortName ?? "-")</td> *@
                                        <td class="d-none d-xl-table-cell">@FormatOffset(t.StandardUtcOffsetMinutes)</td>
                                        <td class="td-xxxl">@t.StandardUtcOffsetMinutes</td>
                                        @* <td class="d-none d-xl-table-cell">
                                            @if (t.SupportsDST)
                                            {
                                                <span class="badge bg-info-transparent text-info">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-transparent text-secondary">No</span>
                                            }
                                        </td> *@
                                       
                                        <td class="d-none d-md-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @GetStatusDotBadge(t.Status)">
                                                </div>
                                                <span> @t.Status</span>
                                            </div>
                                        </td>

                                        <td class="action-table-data">
                                            <div class="edit-delete-action">
                                                @* <a class="me-2 view-icon p-1" href="javascript:void(0);" title="View"
                                                   data-bs-toggle="modal" data-bs-target="#view-timezone-modal"
                                                   @onclick="async () => await ViewTimeZone(t)">
                                                    <i data-feather="eye"></i>
                                                </a> *@
                                                <a class="me-2 p-1 edit-icon" href="/timezones/@t.Id">
                                                    <i data-feather="edit"></i>
                                                </a>
                                                @if (t.IsActive)
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon deactivate-icon" href="javascript:void(0);"
                                                       title="Deactivate" data-bs-toggle="modal" data-bs-target="#deactivate-modal"
                                                       @onclick="() => ConfirmDeactivate(t)">
                                                        <i class="ti ti-toggle-right"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Activate" data-bs-toggle="modal" data-bs-target="#activate-modal"
                                                       @onclick="() => ConfirmActivate(t)">
                                                        <i class="ti ti-toggle-left"></i>
                                                    </a>
                                                }
                                                <a class="me-2 p-1 delete-icon action-icon delete-icon" href="javascript:void(0);"
                                                   title="Delete" data-bs-toggle="modal" data-bs-target="#delete-modal"
                                                   @onclick="() => ConfirmDelete(t)">
                                                    <i class="ti ti-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        <div class="text-muted">
                                            <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                            No time zones found
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (FilteredTimeZones.Any())
                {
                    <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4">
                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows per page</span>
                            <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                                <option value="5" selected="@(PageSize == 5)">5</option>
                                <option value="10" selected="@(PageSize == 10)">10</option>
                                <option value="25" selected="@(PageSize == 25)">25</option>
                                <option value="50" selected="@(PageSize == 50)">50</option>
                            </select>
                            <span class="ms-3 text-muted">
                                Entries
                            </span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = StartPage; i <= EndPage; i++)
                                {
                                    int pageNum = i;
                                    <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                        <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>

        <!-- Activate Modal -->
        <div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-toggle-right fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Time Zone</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to activate <strong>@SelectedTimeZone?.DisplayName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-right me-1"></i>Yes, Activate</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deactivate Modal -->
        <div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                                <i class="ti ti-toggle-left fs-24 text-warning"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate Time Zone</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDeactivate)
                                {
                                    <span class="text-danger">Cannot deactivate! Time zone is being used by companies or branches.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to deactivate <strong>@SelectedTimeZone?.DisplayName</strong>?</span>
                                }
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDeactivate)
                                {
                                    <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-left me-1"></i>Yes, Deactivate</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                <i class="ti ti-trash fs-24 text-danger"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Time Zone</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDelete)
                                {
                                    <span class="text-danger">Cannot delete! Time zone is being used by companies or branches.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to delete <strong>@SelectedTimeZone?.DisplayName</strong>?</span>
                                }
                            </p>
                            
                            @if (canDelete)
                            {
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                            }
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDelete)
                                {
                                    <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteConfirmed" data-bs-dismiss="modal">
                                        <i class="ti ti-trash me-1"></i>Yes, Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

}






<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">TimeZone Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>

            <div class="modal-body">
                <div class="mb-2 d-flex gap-3">
                    <strong>Short Name:</strong>
                    <div>@(SelectedCompany?.ShortName ?? "-")</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Time Zone ID:</strong>
                    <div>@(SelectedCompany?.TimeZoneKey ?? "-")</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Supports DST:</strong>
                    <div>
                        @if (SelectedCompany?.SupportsDST == true)
                        {
                            <span class="badge bg-info-transparent text-info">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-transparent text-secondary">No</span>
                        }

                    </div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>UTC Offset:</strong>
                    <div>@FormatOffset(SelectedCompany?.StandardUtcOffsetMinutes)</div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Status:</strong>
                    <div>
                        <span class="badge @GetStatusBadge(SelectedCompany?.Status)">
                            @SelectedCompany?.Status
                        </span>
                    </div>
                </div>




            </div>

        </div>
    </div>
</div>



<!-- View Time Zone offcanvas -->
<div class="offcanvas offcanvas-end offcanvas-view"
     tabindex="-1"
     id="viewTimeZoneOffcanvas"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    @if (SelectedTimeZone != null)
    {
        <!-- Header -->
        <div class="offcanvas-header">

            <div class="oc-avatar">
                <i class="ti ti-world"></i>
            </div>

            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@SelectedTimeZone.DisplayName</h5>

                    <span class="oc-status-pill @(SelectedTimeZone.Status == "Active" ? "active" : "inactive")">
                        <span class="oc-status-dot"></span>
                        @SelectedTimeZone.Status
                    </span>
                </div>

                <p class="oc-header-sub">
                    @SelectedTimeZone.TimeZoneKey
                </p>
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close"></button>
        </div>


        <!-- Body -->
        <div class="offcanvas-body">

            <!-- Summary Cards -->
            <div class="oc-summary-row">

                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value">
                        @FormatOffset(SelectedTimeZone.StandardUtcOffsetMinutes)
                    </div>
                    <div class="oc-summary-label">UTC Offset</div>
                </div>

                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value">
                        @(SelectedTimeZone.CountryName ?? "—")
                    </div>
                    <div class="oc-summary-label">Country</div>
                </div>

                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value">
                        @(SelectedTimeZone.SupportsDST ? "Yes" : "No")
                    </div>
                    <div class="oc-summary-label">Supports DST</div>
                </div>

            </div>


            <!-- Time Zone Identity -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-clock"></i>
                    <h6 class="oc-card-title">Time Zone Identity</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-id"></i> IANA Key
                            </div>
                            <div class="oc-field-value">
                                @SelectedTimeZone.TimeZoneKey
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-layout"></i> Display Name
                            </div>
                            <div class="oc-field-value">
                                @SelectedTimeZone.DisplayName
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-letter-case"></i> Short Name
                            </div>
                            <div class="oc-field-value">
                                @(SelectedTimeZone.ShortName ?? "—")
                            </div>
                        </div>

                    </div>
                </div>
            </div>


            <!-- Country Linkage -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-flag"></i>
                    <h6 class="oc-card-title">Country Linkage</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-world"></i> Associated Country
                            </span>
                            <span class="oc-list-value">
                                @(SelectedTimeZone.CountryName ?? "—")
                            </span>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Offset & DST -->
            <div class="oc-card">
                <div class="oc-card-header hdr-purple">
                    <i class="ti ti-sun"></i>
                    <h6 class="oc-card-title">Offset & DST Metadata</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-world"></i> Standard UTC Offset
                            </div>
                            <div class="oc-field-value">
                                @FormatOffset(SelectedTimeZone.StandardUtcOffsetMinutes)
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-number"></i> Offset (Minutes)
                            </div>
                            <div class="oc-field-value">
                                @SelectedTimeZone.StandardUtcOffsetMinutes
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-adjustments"></i> Supports DST
                            </div>
                            <div class="oc-field-value">
                                <span class="oc-dot-badge @(SelectedTimeZone.SupportsDST ? "db-green" : "db-red")">
                                    <span class="dot"></span>
                                    @(SelectedTimeZone.SupportsDST ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-note"></i> DST Rule Note
                            </div>
                            <div class="oc-field-value">
                                @(SelectedTimeZone.DSTRuleNote ?? "—")
                            </div>
                        </div>

                    </div>
                </div>
            </div>


            <!-- Display & Formatting -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-layout-grid"></i>
                    <h6 class="oc-card-title">Display & Formatting</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-sort-ascending"></i> Sort Order
                            </span>
                            <span class="oc-list-value">
                                @SelectedTimeZone.SortOrder
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-star"></i> Recommended Default
                            </span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedTimeZone.IsDefaultRecommended ? "db-green" : "db-red")">
                                    <span class="dot"></span>
                                    @(SelectedTimeZone.IsDefaultRecommended ? "Yes" : "No")
                                </span>
                            </span>
                        </div>

                    </div>
                </div>
            </div>


            <!-- Status & Audit -->
            <div class="oc-card">
                <div class="oc-card-header hdr-teal">
                    <i class="ti ti-settings"></i>
                    <h6 class="oc-card-title">Status & Usage</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-toggle-right"></i> Status
                            </span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedTimeZone.Status == "Active" ? "db-green" : "db-red")">
                                    <span class="dot"></span>
                                    @SelectedTimeZone.Status
                                </span>
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-note"></i> Notes
                            </span>
                            <span class="oc-list-value text-truncate ql-editor" style="max-width:200px;" title="@GetPlainText(SelectedTimeZone?.Notes)">
                                @(new MarkupString(SelectedTimeZone?.Notes ?? "-"))
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-calendar-plus"></i> Created
                            </span>
                            <span class="oc-list-value">
                                @SelectedTimeZone.CreatedAt.ToString("dd-MMM-yyyy")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-user"></i> Created By
                            </span>
                            <span class="oc-list-value">
                                @(SelectedTimeZone.CreatedBy ?? "—")
                            </span>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    }
</div>
