@page "/exchange-rates"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MasterDataService MasterDataService
@inject ToastService ToastService

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Exchange Rate List</h4>
                    <h6>Manage your exchange rates</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/exchange-rates/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Exchange Rate List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search rates"
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="    display: flex;
            flex-wrap: wrap;
            gap: 10px;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedCurrencyId">
                            <option value="">All Currencies</option>
                            @foreach (var currency in ExchangeRates.SelectMany(r => new[] { new { r.BaseCurrencyId, Code = r.BaseCurrencyCode }, new { BaseCurrencyId = r.QuoteCurrencyId, Code = r.QuoteCurrencyCode } }).Where(c => !string.IsNullOrEmpty(c.Code)).DistinctBy(c => c.BaseCurrencyId))
                            {
                                <option value="@currency.BaseCurrencyId">@currency.Code</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedRateType">
                            <option value="">All Types</option>
                            @foreach (var type in ExchangeRates.Select(r => r.RateType).Where(t => !string.IsNullOrEmpty(t)).Distinct().OrderBy(t => t))
                            {
                                <option value="@type">@RateTypes.GetDisplayName(type)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in ExchangeRates.Select(r => r.Status).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s))
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th class="d-none d-md-table-cell">Currency Pair</th>
                                <th>Date</th>
                                <th class="d-none d-xxl-table-cell">Rate</th>
                                <th class="d-none d-xl-table-cell">Type</th>
                                <th class="d-none d-xxl-table-cell">Company</th>
                                @* <th class="d-none d-xxl-table-cell">Source</th> *@
                                <th class="d-none d-md-table-cell" style="width: 129px;">Status</th>
                                <th class="no-sort">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedRates.Any())
                            {
                                @foreach (var rate in PagedRates)
                                {
                                    <tr>
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(rate)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td class="d-none d-md-table-cell link-View">
                                            <a @onclick="() => ViewRate(rate.Id)" class="text-decoration-none link-View">

                                                <span class="badge bg-primary me-1" style="min-width: 49px;">@(rate.BaseCurrencyCode ?? "?")</span>
                                                <i class="ti ti-arrow-right text-muted"></i>
                                                <span class="badge bg-success ms-1" style="min-width: 49px;">@(rate.QuoteCurrencyCode ?? "?")</span>
                                            </a>

                                        </td>
                                        <td >@rate.RateDate.ToString("dd MMM yyyy")</td>
                                        <td class="d-none d-xxl-table-cell"><span class="fw-medium">@rate.Rate.ToString("N6")</span></td>
                                        <td class="d-none d-xl-table-cell" style="text-overflow:inherit">
                                            <span class="badge bg-info-transparent text-info">@RateTypes.GetDisplayName(rate.RateType)</span>
                                        </td>
                                        <td class="d-none d-xxl-table-cell" title="@rate.CompanyCode">@(rate.CompanyCode ?? "All (Default)")</td>
                                        @* <td class="d-none d-xxl-table-cell" title="@SourceTypes.GetDisplayName(rate.SourceType)">@SourceTypes.GetDisplayName(rate.SourceType)</td> *@
                                      

                                        <td class="d-none d-md-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @GetStatusBadge(rate.Status)">
                                                </div>
                                                <span> @rate.Status</span>
                                            </div>
                                        </td>

                                        <td class="action-table-data">
                                            <div class="edit-delete-action">

                                                @* <a class="me-2 view-icon p-1" href="javascript:void(0);"
                                                 
                                                   @onclick="() => ViewRate(rate.Id)">
                                                    <i data-feather="eye"></i>
                                                </a> *@

                                                <!-- Live Rate Icon -->
                                                <a class="me-2 p-1 chartLine @(IsLiveRateDisplayed(rate.Id) ? "text-success" : "")"
                                                   href="javascript:void(0);"
                                                   title="Check Live Rate"
                                                   @onclick="() => ToggleLiveRateDisplay(rate)">
                                                    @if (IsRowFetchingLiveRate(rate.Id))
                                                    {
                                                        <div class="spinner-border spinner-border-sm" role="status">
                                                            <span class="visually-hidden">Loading...</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <i class="ti ti-chart-line @(IsLiveRateDisplayed(rate.Id) ? "text-success" : "")"></i>
                                                    }
                                                </a>

                                                @* <a href="javascript:void(0);" class="me-2 p-2" title="View"
                                                   data-bs-toggle="modal" data-bs-target="#viewRateModal"
                                                   @onclick="() => ViewRate(rate)">
                                                    <i class="ti ti-eye text-info"></i>
                                                </a> *@
                                                @if (rate.Status != "Posted")
                                                {
                                                    <a class="me-2 p-1 edit-icon" href="/exchange-rates/@rate.Id" title="Edit">
                                                        <i data-feather="edit"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="me-2 p-1 edit-icon disabled" href="javascript:void(0);"
                                                       title="Cannot edit Posted rates"
                                                       style="opacity: 0.5; cursor: not-allowed;">
                                                        <i data-feather="lock"></i>
                                                    </a>
                                                }

                                                @* <a href="/create-exchange-rate/@rate.Id" class="me-2 p-2" title="Edit">
                                                    <i class="ti ti-pencil text-primary"></i>
                                                </a> *@
                                                @if (rate.Status == "Draft")
                                                {
                                                    @* <a href="javascript:void(0);" class="me-2 p-2" title="Activate"
                                                       data-bs-toggle="modal" data-bs-target="#activateRateModal"
                                                       @onclick="() => ConfirmActivate(rate)">
                                                        <i class="ti ti-check text-success"></i>
                                                    </a> *@

                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Activate" data-bs-toggle="modal" data-bs-target="#activateRateModal"
                                                       @onclick="() => ConfirmActivate(rate)">
                                                        <i class="ti ti-toggle-left"></i>
                                                    </a>

                                                }
                                                else if (rate.Status == "Active")
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon deactivate-icon" href="javascript:void(0);"
                                                       title="Deactivate" data-bs-toggle="modal" data-bs-target="#deactivateRateModal"
                                                       @onclick="() => ConfirmDeactivate(rate)">
                                                        <i class="ti ti-toggle-right"></i>
                                                    </a>


                                                    @*   <a href="javascript:void(0);" class="me-2 p-2" title="Deactivate"
                                                       data-bs-toggle="modal" data-bs-target="#deactivateRateModal"
                                                       @onclick="() => ConfirmDeactivate(rate)">
                                                        <i class="ti ti-ban text-warning"></i>
                                                    </a> *@
                                                }
                                                else
                                                {
                                                    @* <a href="javascript:void(0);" class="me-2 p-2" title="Activate"
                                                       data-bs-toggle="modal" data-bs-target="#activateRateModal"
                                                       @onclick="() => ConfirmActivate(rate)">
                                                        <i class="ti ti-check text-success"></i>
                                                    </a> *@
                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Activate" data-bs-toggle="modal" data-bs-target="#activateRateModal"
                                                       @onclick="() => ConfirmActivate(rate)">
                                                        <i class="ti ti-toggle-left"></i>
                                                    </a>

                                                }
                                                <a class="me-2 p-1 delete-icon action-icon delete-icon" href="javascript:void(0);"
                                                   title="Delete" data-bs-toggle="modal" data-bs-target="#deleteRateModal"
                                                   @onclick="() => ConfirmDelete(rate)">
                                                    <i class="ti ti-trash"></i>
                                                </a>
                                                @* <a href="javascript:void(0);" class="p-2" title="Delete"
                                                   data-bs-toggle="modal" data-bs-target="#deleteRateModal"
                                                   @onclick="() => ConfirmDelete(rate)">
                                                    <i class="ti ti-trash text-danger"></i>
                                                </a> *@
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center py-4">
                                        <i class="ti ti-alert-circle fs-2 text-muted"></i>
                                        <p class="text-muted mt-2 mb-0">No exchange rates found</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            <div class="p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center fs-13">
                        <span class="me-2">Rows per page</span>
                        <select class="form-select form-select-sm" style="width:auto" @onchange="OnPageSizeChange">
                            <option value="5" selected="@(PageSize == 5)">5</option>

                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                        <span class="ms-2">Entries</span>
                    </div>

                    <div class="d-flex align-items-center">

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = StartPage; i <= EndPage; i++)
                                {
                                    var pageNum = i;
                                    <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                        <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage"><i class="ti ti-chevron-right"></i></a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Exchange Rate Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            style="padding:0; right:22px; position:absolute;transform:none"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-2 d-flex gap-3">
                        <strong>Type:</strong>
                        <div>@(SelectedCompany != null ? RateTypes.GetDisplayName(SelectedCompany.RateType) : "-")</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Currency Pair:</strong>
                        <div>
                            <span class="badge bg-primary me-1">@(SelectedCompany?.BaseCurrencyCode ?? "?")</span>
                            <i class="ti ti-arrow-right text-muted"></i>
                            <span class="badge bg-success ms-1">@(SelectedCompany?.QuoteCurrencyCode ?? "?")</span>
                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Company:</strong>
                        <div>@(SelectedCompany?.CompanyCode ?? "All (Default)")</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Rate:</strong>
                        <div>@(SelectedCompany != null && SelectedCompany.RateDate != null ? SelectedCompany.RateDate.ToString("dd MMM yyyy") : "-")</div>
                    </div>

                    <div class="mb-2 gap-3 d-md-none">
                        <strong>Status:</strong>
                        <span class="badge @(SelectedCompany != null ? GetStatusBadge(SelectedCompany.Status) : "")">
                            @(SelectedCompany?.Status ?? "-")
                        </span>
                    </div>

                </div>


            </div>
        </div>
    </div>




    <!-- VIEW EXCHANGE RATE MODAL -->
    <div class="modal fade list-Popup" id="viewRateModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="ti ti-arrows-exchange me-2 text-primary"></i>
                        Exchange Rate Details
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            style="padding:0; right:22px; position:absolute;transform:none"></button>
                </div>
                @if (SelectedRate != null)
                {
                    <div class="modal-body">
                        <!-- Rate Identity -->
                        <div class="mb-3">
                            <div class="card-header py-2">
                                <h6 class="mb-0 text-primary"><i class="ti ti-arrows-exchange me-2"></i>Rate Identity</h6>
                            </div>
                            <div class="card-body py-2">
                                <div class="row">
                                    <div class="col-md-4 mb-2">
                                        <small class="text-muted">Base Currency</small>
                                        <div><span class="badge bg-primary fs-12">@(SelectedRate.BaseCurrencyCode ?? "-")</span> @SelectedRate.BaseCurrencyName</div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <small class="text-muted">Quote Currency</small>
                                        <div><span class="badge bg-success fs-12">@(SelectedRate.QuoteCurrencyCode ?? "-")</span> @SelectedRate.QuoteCurrencyName</div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <small class="text-muted">Rate Date</small>
                                        <div class="fw-medium">@SelectedRate.RateDate.ToString("dd MMM yyyy")</div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <small class="text-muted">Rate Type</small>
                                        <div><span class="badge bg-info">@RateTypes.GetDisplayName(SelectedRate.RateType)</span></div>
                                    </div>
                                    <div class="col-md-8 mb-2">
                                        <small class="text-muted">Company Scope</small>
                                        <div class="fw-medium">@(SelectedRate.CompanyId.HasValue ? $"{SelectedRate.CompanyCode} - {SelectedRate.CompanyName}" : "Tenant Default (All Companies)")</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Rate Value -->
                        <div class=" mb-3">
                            <div class="card-header py-2">
                                <h6 class="mb-0 text-primary"><i class="ti ti-calculator me-2"></i>Rate Value & Precision</h6>
                            </div>
                            <div class="card-body py-2">
                                <div class="row">
                                    <div class="col-12 mb-3">
                                        <div class="p-3 bg-light rounded text-center">
                                            <div class="fs-4 fw-bold text-primary">
                                                1 @(SelectedRate.BaseCurrencyCode ?? "?") = @SelectedRate.Rate.ToString("N8") @(SelectedRate.QuoteCurrencyCode ?? "?")
                                            </div>
                                            <small class="text-muted">Inverse: 1 @(SelectedRate.QuoteCurrencyCode ?? "?") = @SelectedRate.InverseRate.ToString("N8") @(SelectedRate.BaseCurrencyCode ?? "?")</small>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <small class="text-muted">Exchange Rate</small>
                                        <div class="fw-medium">@SelectedRate.Rate.ToString("N8")</div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <small class="text-muted">Inverse Rate</small>
                                        <div class="fw-medium">@SelectedRate.InverseRate.ToString("N8")</div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <small class="text-muted">Version</small>
                                        <div class="fw-medium">@SelectedRate.VersionNo</div>
                                    </div>
                                    @if (SelectedRate.IsTriangulated)
                                    {
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Triangulated</small>
                                            <div><span class="badge bg-warning">Yes</span></div>
                                        </div>
                                        <div class="col-md-8 mb-2">
                                            <small class="text-muted">Intermediate Currency</small>
                                            <div class="fw-medium">@(SelectedRate.TriangulationCurrencyCode ?? "-")</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Rate Source & Evidence -->
                        <div class="mb-3">
                            <div class="card-header py-2">
                                <h6 class="mb-0 text-primary"><i class="ti ti-file-search me-2"></i>Source & Evidence</h6>
                            </div>
                            <div class="card-body py-2">
                                <div class="row">
                                    <div class="col-md-4 mb-2">
                                        <small class="text-muted">Source Type</small>
                                        <div class="fw-medium">@SourceTypes.GetDisplayName(SelectedRate.SourceType)</div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <small class="text-muted">Source Name</small>
                                        <div class="fw-medium">@(SelectedRate.SourceName ?? "-")</div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <small class="text-muted">Evidence Document</small>
                                        <div class="fw-medium">@(SelectedRate.EvidenceFileName ?? "-")</div>
                                    </div>
                                    <div class="col-12 mb-2">
                                        <small class="text-muted">Notes</small>
                                        <div class="fw-medium">@(string.IsNullOrWhiteSpace(SelectedRate.Notes) ? "-" : SelectedRate.Notes)</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Status & Audit -->
                        <div class="mb-0">
                            <div class="card-header py-2">
                                <h6 class="mb-0 text-primary"><i class="ti ti-settings me-2"></i>Status & Audit</h6>
                            </div>
                            <div class="card-body py-2">
                                <div class="row">
                                    <div class="col-md-3 mb-2">
                                        <small class="text-muted">Created At</small>
                                        <div class="fw-medium">@SelectedRate.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <small class="text-muted">Created By</small>
                                        <div class="fw-medium">@(SelectedRate.CreatedBy ?? "-")</div>
                                    </div>
                                    @if (SelectedRate.UpdatedAt.HasValue)
                                    {
                                        <div class="col-md-3 mb-2">
                                            <small class="text-muted">Last Updated</small>
                                            <div class="fw-medium">@SelectedRate.UpdatedAt?.ToString("dd MMM yyyy HH:mm")</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @* <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <a href="/create-exchange-rate/@SelectedRate?.Id" class="btn btn-primary">
                        <i class="ti ti-pencil me-1"></i>Edit
                    </a>
                </div> *@
            </div>
        </div>
    </div>



    <!-- ACTIVATE CURRENCY MODAL -->
    <div class="modal fade" id="activateRateModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                @* <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div> *@
                <div class="modal-body text-center py-4">
                    <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                        <i class="ti ti-toggle-right fs-24 text-success"></i>

                    </span>
                    <h5 class="modal-title mt-3">Activate Exchange Rate</h5>
                    <p class="mb-0">Are you sure you want to activate?</p>
                    <p class="fw-medium">@SelectedRate?.CurrencyPair on @SelectedRate?.RateDate.ToString("dd MMM yyyy")</p>
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button type="button" class="btn btn-success" data-bs-dismiss="modal" @onclick="ActivateConfirmed"><i class="ti ti-toggle-right me-1"></i>Yes,Activate</button>
                    </div>
                </div>

            </div>
        </div>
    </div>




    <!-- DEACTIVATE CURRENCY MODAL -->
    <div class="modal fade" id="deactivateRateModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-body text-center py-4">
                    @if (canDeactivate)
                    {
                        <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                            <i class="ti ti-toggle-left fs-24 text-warning"></i>

                        </span>
                        <h5 class="modal-title mb-2">Deactivate Exchange Rate</h5>
                        <p class="mb-0">Are you sure you want to deactivate?</p>
                        <p class="fw-medium">@SelectedRate?.CurrencyPair on @SelectedRate?.RateDate.ToString("dd MMM yyyy")</p>
                        <div class="info alert-info mt-3 text-start small p-3">
                            <i class="ti ti-info-circle me-2"></i>
                            This rate will not be available for new transactions.
                        </div>
                    }
                    else
                    {
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-toggle-left fs-24 text-danger"></i>
                        </span>

                        <p class="mb-0">Cannot deactivate this rate</p>
                        <div class="info alert-info mt-3 text-start small">
                            <i class="ti ti-info-triangle me-2"></i>
                            This rate has been used in posted transactions.
                        </div>
                    }
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        @if (canDeactivate)
                        {
                            <button type="button" class="btn btn-warning" data-bs-dismiss="modal" @onclick="DeactivateConfirmed"><i class="ti ti-toggle-left me-1"></i>Yes,Deactivate</button>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>



    <div class="modal fade" id="deleteRateModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                @* <div class="modal-header">
                    <h5 class="modal-title">Delete Currency</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div> *@
                <div class="modal-body text-center py-4">
                    @if (canDelete)
                    {
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h5 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Exchange Rate</h5>
                        <p class="mb-0">Are you sure you want to delete?</p>
                        <p class="fw-medium">@SelectedRate?.CurrencyPair on @SelectedRate?.RateDate.ToString("dd MMM yyyy")</p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This action cannot be undone.
                        </div>
                    }
                    else
                    {
                        <i class="ti ti-alert-triangle fs-1 text-danger mb-3"></i>

                        <h5 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Currency</h5>
                        <p class="mb-0">Cannot delete this rate</p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This rate has been used in posted transactions.
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-center gap-2 mb-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"> <i class="ti ti-x me-1"></i>Cancel</button>
                    @if (canDelete)
                    {
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="DeleteConfirmed">
                            <i class="ti ti-trash me-1"></i>Yes,Delete
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>


}

<!-- Live Rate Side Panel - Always rendered, visibility controlled by CSS -->
@{
    var isPanelVisible = currentLiveRateId != null;
    var selectedRate = isPanelVisible ? PagedRates.FirstOrDefault(r => r.Id == currentLiveRateId) : null;
    var liveRate = isPanelVisible && currentLiveRateId.HasValue ? GetRowLiveRate(currentLiveRateId.Value) : null;
}

<!-- Overlay -->
<div class="modal-backdrop fade @(isPanelVisible ? "show" : "")"
     style="z-index: 1040; display: @(isPanelVisible ? "block" : "none");"
     @onclick="CloseLiveRateDisplay"></div>

<!-- Side Panel -->
<div class="offcanvas offcanvas-end offcanvas-view @(isPanelVisible ? "show" : "")"
     tabindex="-1"
     style="visibility:@(isPanelVisible ? "visible" : "hidden"); z-index:1045; width:500px;">

    @if (isPanelVisible)
    {
        <div class="offcanvas-header">

            <div class="oc-avatar">
                @liveRate?.BaseCurrency
            </div>

            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>Live Exchange Rate</h5>

                    <span class="oc-status-pill active">
                        <span class="oc-status-dot"></span>
                        Real-Time
                    </span>
                </div>

                @if (liveRate != null)
                {
                    <p class="oc-header-sub">
                        @liveRate.BaseCurrency / @liveRate.QuoteCurrency
                    </p>
                }
            </div>

            <button type="button" class="btn-close" @onclick="CloseLiveRateDisplay"></button>
        </div>


        <div class="offcanvas-body">

            @* LOADING *@
            @if (currentLiveRateId.HasValue && IsRowFetchingLiveRate(currentLiveRateId.Value))
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" style="width:3rem;height:3rem;"></div>
                    <p class="mt-3 text-muted">Fetching live rate from API...</p>
                </div>
            }

            @* SUCCESS *@
            else if (liveRate != null && liveRate.Success && selectedRate != null)
            {
                decimal variance = ((liveRate.Rate - selectedRate.Rate) / selectedRate.Rate) * 100;
                string varianceClass = variance > 0 ? "success" : variance < 0 ? "danger" : "secondary";
                string varianceIcon = variance > 0 ? "trending-up" : variance < 0 ? "trending-down" : "minus";

                <!-- SUMMARY CARDS -->
                <div class="oc-summary-row">

                    <div class="oc-summary-card card-green">
                        <div class="oc-summary-value">
                            @liveRate.Rate.ToString("N6")
                        </div>
                        <div class="oc-summary-label">Live Rate</div>
                    </div>

                    <div class="oc-summary-card card-blue">
                        <div class="oc-summary-value">
                            @selectedRate.Rate.ToString("N6")
                        </div>
                        <div class="oc-summary-label">Stored Rate</div>
                    </div>

                    <div class="oc-summary-card card-orange">
                        <div class="oc-summary-value">
                            @(variance >= 0 ? "+" : "")@variance.ToString("N2")%
                        </div>
                        <div class="oc-summary-label">Variance</div>
                    </div>

                </div>


                <!-- RATE DETAILS -->
                <div class="oc-card">
                    <div class="oc-card-header hdr-blue">
                        <i class="ti ti-arrows-exchange"></i>
                        <h6 class="oc-card-title">Rate Details</h6>
                    </div>

                    <div class="oc-card-body">
                        <div class="oc-grid">

                            <div class="oc-grid-item">
                                <div class="oc-field-label">
                                    <i class="ti ti-trending-up"></i> Live Rate
                                </div>
                                <div class="oc-field-value text-success fw-bold">
                                    @liveRate.Rate.ToString("N6")
                                </div>
                            </div>

                            <div class="oc-grid-item">
                                <div class="oc-field-label">
                                    <i class="ti ti-database"></i> Stored Rate
                                </div>
                                <div class="oc-field-value text-primary fw-bold">
                                    @selectedRate.Rate.ToString("N6")
                                </div>
                            </div>

                            <div class="oc-grid-item">
                                <div class="oc-field-label">
                                    <i class="ti ti-calculator"></i> Absolute Difference
                                </div>
                                <div class="oc-field-value">
                                    @Math.Abs(liveRate.Rate - selectedRate.Rate).ToString("N6")
                                </div>
                            </div>

                        </div>
                    </div>
                </div>


                <!-- VARIANCE ANALYSIS -->
                <div class="oc-card">
                    <div class="oc-card-header hdr-purple">
                        <i class="ti ti-chart-line"></i>
                        <h6 class="oc-card-title">Variance Analysis</h6>
                    </div>

                    <div class="oc-card-body">

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-@varianceIcon text-@varianceClass"></i>
                                Variance %
                            </span>
                            <span class="oc-list-value text-@varianceClass fw-bold">
                                @(variance >= 0 ? "+" : "")@variance.ToString("N2")%
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">Interpretation</span>
                            <span class="oc-list-value">
                                @if (Math.Abs(variance) < 0.1m)
                                {
                                    <span class="text-success">Very close to live rate</span>
                                }
                                else if (Math.Abs(variance) < 1.0m)
                                {
                                    <span class="text-warning">Minor variance detected</span>
                                }
                                else
                                {
                                    <span class="text-danger">Significant variance – consider updating</span>
                                }
                            </span>
                        </div>

                    </div>
                </div>


                <!-- METADATA -->
                <div class="oc-card">
                    <div class="oc-card-header hdr-teal">
                        <i class="ti ti-info-circle"></i>
                        <h6 class="oc-card-title">Metadata</h6>
                    </div>

                    <div class="oc-card-body">
                        <div class="oc-list">

                            <div class="oc-list-row">
                                <span class="oc-list-label">Last Updated</span>
                                <span class="oc-list-value">
                                    @liveRate.LastUpdated.ToString("dd-MMM-yyyy HH:mm:ss")
                                </span>
                            </div>

                            <div class="oc-list-row">
                                <span class="oc-list-label">Provider</span>
                                <span class="oc-list-value">
                                    <span class="badge bg-info-transparent text-info">
                                        @liveRate.Provider
                                    </span>
                                </span>
                            </div>

                            <div class="oc-list-row">
                                <span class="oc-list-label">Rate Type</span>
                                <span class="oc-list-value">
                                    @RateTypes.GetDisplayName(selectedRate.RateType)
                                </span>
                            </div>

                            <div class="oc-list-row">
                                <span class="oc-list-label">Source</span>
                                <span class="oc-list-value">
                                    @SourceTypes.GetDisplayName(selectedRate.SourceType)
                                </span>
                            </div>

                        </div>
                    </div>
                </div>


                //-------------- ACTION ------------//
                @if (selectedRate.Status != "Posted")
                {
                    <div class="mt-3">
                        <a href="/exchange-rates/@selectedRate.Id" class="btn btn-primary w-100">
                            <i class="ti ti-pencil me-2"></i>
                            Update Exchange Rate
                        </a>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mt-3">
                        <i class="ti ti-lock me-2"></i>
                        <strong>Rate is Posted</strong>
                        <p class="mb-0 small">
                            Posted rates cannot be edited. Create a new rate if changes are required.
                        </p>
                    </div>
                }
            }

            //--------------- ERROR -------------//
            else if (liveRate != null && !liveRate.Success)
            {
                <div class="alert alert-danger">
                    <i class="ti ti-alert-circle me-2"></i>
                    <strong>Failed to fetch live rate</strong>
                    <p class="mb-0 mt-2">@liveRate.ErrorMessage</p>

                    @if (selectedRate != null)
                    {
                        <button class="btn btn-sm btn-outline-danger mt-3"
                                @onclick="() => FetchRowLiveRateAsync(selectedRate)">
                            <i class="ti ti-refresh me-1"></i>
                            Retry
                        </button>
                    }
                </div>
            }

        </div>
    }
</div>

