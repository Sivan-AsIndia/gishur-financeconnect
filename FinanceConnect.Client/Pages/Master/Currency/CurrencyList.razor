@page "/currencies"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MasterDataService MasterDataService
@inject ToastService ToastService

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Currency List</h4>
                    <h6>Manage your currencies</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/currencies/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Currency List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search currency"
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display:flex">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedType">
                            <option value="">All Types</option>
                            @foreach (var type in Currencies.Select(c => c.CurrencyType).Where(t => !string.IsNullOrEmpty(t)).Distinct().OrderBy(t => t))
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in Currencies.Select(c => c.IsActive ? "active" : "inactive").Distinct().OrderBy(s => s))
                            {
                                <option value="@status">@(status == "active" ? "Active" : "Inactive")</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th>Code</th>
                                <th class="d-none d-md-table-cell" title="Name">Name</th>
                                @* <th class="d-none d-xl-table-cell">Type</th> *@
                                <th class="d-none d-md-table-cell">Symbol</th>
                                @* <th class="d-none d-xl-table-cell">Decimals</th> *@
                                <th class="d-none d-xxl-table-cell">Rounding</th>
                                <th class="d-none d-md-table-cell">Status</th>
                                <th class="no-sort">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedCurrencies.Any())
                            {
                                @foreach (var c in PagedCurrencies)
                                {
                                    <tr>
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(c)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td>
                                            <span class="fw-medium tooltip-hide-on-click" data-bs-toggle="tooltip"
                                                  data-bs-placement="top"
                                                  title="@c.CurrencyCode Details">
                                                <span class="PopupIcon">⧉</span>
                                                <a @onclick="() => ViewCurrency(c)" class="text-decoration-none link-View"
                                                   data-bs-toggle="modal" data-bs-target="#viewCurrencyModal">
                                                    @c.CurrencyCode
                                                </a>
                                            </span>
                                        </td>
                                        <td class="d-none d-md-table-cell" >
                                            <div class="d-flex flex-column gap-1 align-items-start">
                                                <span>@c.CurrencyName</span>
                                                <span class="badge bg-info-transparent" title="@c.CurrencyType">@c.CurrencyType</span>
                                            </div>
                                            </td>
                                        @* <td class="d-none d-xl-table-cell"><span class="badge bg-info">@c.CurrencyType</span></td> *@
                                        <td class="d-none d-md-table-cell">@(c.Symbol ?? "-")</td>
                                        @* <td class="d-none d-xl-table-cell" title="@c.DecimalPlaces">@c.DecimalPlaces</td> *@
                                        <td class="d-none d-xxl-table-cell">@c.RoundingMode</td>
                                        @* <td class="d-none d-md-table-cell">
                                            <span class="badge @(c.IsActive ? "bg-success-transparent text-success" : "bg-danger-transparent text-danger")">
                                                @(c.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td> *@

                                        <td class="d-none d-md-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @(c.IsActive ? "bg-success" : "bg-danger")">
                                                </div>
                                                <span>@(c.IsActive ? "Active" : "Inactive")</span>
                                            </div>
                                        </td>

                                        <td class="action-table-data">
                                            <div class="edit-delete-action">
                                                @* <a class="me-2 view-icon p-1" href="javascript:void(0);" title="View"
                                                   data-bs-toggle="modal" data-bs-target="#viewCurrencyModal"
                                                   @onclick="() => ViewCurrency(c)">
                                                    <i data-feather="eye"></i>
                                                </a> *@

                                                @* <a href="javascript:void(0);" class="me-2 p-2" title="View"
                                                   data-bs-toggle="modal" data-bs-target="#viewCurrencyModal"
                                                   @onclick="() => ViewCurrency(c)">
                                                    <i class="ti ti-eye text-info"></i>
                                                </a> *@
                                                @* <a href="/create-currency/@c.Id" class="me-2 p-2" title="Edit">
                                                    <i class="ti ti-pencil text-primary"></i>
                                                </a> *@
                                                <a class="me-2 p-1 edit-icon" href="/currencies/@c.Id">
                                                    <i data-feather="edit"></i>
                                                </a>

                                                @if (c.IsActive)
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon deactivate-icon" href="javascript:void(0);"
                                                       title="Deactivate" data-bs-toggle="modal" data-bs-target="#deactivateCurrencyModal"
                                                       @onclick="() => ConfirmDeactivate(c)">
                                                        <i class="ti ti-toggle-right"></i>
                                                    </a>


                                                    @* <a href="javascript:void(0);" class="me-2 p-2" title="Deactivate"
                                                       data-bs-toggle="modal" data-bs-target="#deactivateCurrencyModal"
                                                       @onclick="() => ConfirmDeactivate(c)">
                                                        <i class="ti ti-ban text-warning"></i>
                                                    </a> *@
                                                }
                                                else
                                                {
                                                    @* <a href="javascript:void(0);" class="me-2 p-2" title="Activate"
                                                       data-bs-toggle="modal" data-bs-target="#activateCurrencyModal"
                                                       @onclick="() => ConfirmActivate(c)">
                                                        <i class="ti ti-check text-success"></i>
                                                    </a> *@


                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Activate" data-bs-toggle="modal" data-bs-target="#activateCurrencyModal"
                                                       @onclick="() => ConfirmActivate(c)">
                                                        <i class="ti ti-toggle-left"></i>
                                                    </a>

                                                }
                                                @* <a href="javascript:void(0);" class="p-2" title="Delete"
                                                   data-bs-toggle="modal" data-bs-target="#deleteCurrencyModal"
                                                   @onclick="() => ConfirmDelete(c)">
                                                    <i class="ti ti-trash text-danger"></i>
                                                </a> *@

                                                <a class="me-2 p-1 delete-icon action-icon delete-icon" href="javascript:void(0);"
                                                   title="Delete" data-bs-toggle="modal" data-bs-target="#deleteCurrencyModal"
                                                   @onclick="() => ConfirmDelete(c)">
                                                    <i class="ti ti-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center py-4">
                                        <i class="ti ti-alert-circle fs-2 text-muted"></i>
                                        <p class="text-muted mt-2 mb-0">No currencies found</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            <div class="card-footer">
                <div class="d-flex align-items-center justify-content-between mt-3">
                    <div class="d-flex align-items-center fs-13">
                        <span class="me-2">
                            Rows per page
                        </span>
                        <select class="form-select form-select-sm" style="width:auto" @onchange="OnPageSizeChange">
                            <option value="5" selected="@(PageSize == 5)">5</option>

                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                        <span class="ms-2">Entries</span>
                    </div>

                    <div class="d-flex align-items-center">
                        @* <span class="me-3">
                            Showing @((CurrentPage - 1) * PageSize + 1) to @(Math.Min(CurrentPage * PageSize, FilteredCurrencies.Count)) of @FilteredCurrencies.Count entries
                        </span> *@
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage"> <i class="ti ti-chevron-left"></i></a>
                                </li>
                                @for (int i = StartPage; i <= EndPage; i++)
                                {
                                    var pageNum = i;
                                    <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                        <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">   <i class="ti ti-chevron-right"></i></a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>


    </div>



    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Currency Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            style="padding:0; right:22px; position:absolute;transform:none"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-2 d-flex gap-3">
                        <strong>Trade Name:</strong>
                        <div>@SelectedCompany?.DecimalPlaces</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Currency Name:</strong>
                        <div>@SelectedCompany?.CurrencyName</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Type:</strong>
                        <div>@SelectedCompany?.CurrencyType</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Symbol:</strong>
                        <div>@(SelectedCompany?.Symbol ?? "-")</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Legal Structure:</strong>
                        <div>@SelectedCompany?.RoundingMode</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Status:</strong>
                        <div>
                            <span class="badge @((SelectedCompany?.IsActive ?? false) ? "bg-success" : "bg-danger")">
                                @((SelectedCompany?.IsActive ?? false) ? "Active" : "Inactive")
                            </span>

                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>



    <!-- VIEW CURRENCY MODAL -->
    <div class="modal fade list-Popup" id="viewCurrencyModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="ti ti-currency-dollar me-2 text-primary"></i>
                        Currency Details
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            style="padding:0; right:22px; position:absolute;transform:none"></button>
                </div>
                @if (SelectedCurrency != null)
                {
                    <div class="modal-body">
                        <!-- Currency Identity -->
                        <div class="mb-1">
                            <div class="card-header py-2">
                                <h6 class="mb-0 text-primary"><i class="ti ti-currency-dollar me-2"></i>Currency Identity</h6>
                            </div>
                            <div class="card-body py-2">
                                <div class="row">
                                    <div class="ms-4 row ps-0">

                                    <div class="col-md-3 mb-2">
                                        <small class="text-muted">Currency Code</small>
                                        <div class="fw-medium">@SelectedCurrency.CurrencyCode</div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <small class="text-muted">Currency Name</small>
                                        <div class="fw-medium">@SelectedCurrency.CurrencyName</div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <small class="text-muted">Numeric Code</small>
                                        <div class="fw-medium">@(SelectedCurrency.NumericCode?.ToString() ?? "-")</div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <small class="text-muted">Type</small>
                                        <div><span class="badge bg-info">@SelectedCurrency.CurrencyType</span></div>
                                    </div>
                                </div>
                                </div>
                            </div>
                        </div>

                        <!-- Symbol & Formatting -->
                        <div class="mb-1">
                            <div class="card-header py-2">
                                <h6 class="mb-0 text-primary"><i class="ti ti-typography me-2"></i>Symbol & Formatting</h6>
                            </div>
                            <div class="card-body py-2">
                                <div class="row">
                                    <div class="ms-4 row ps-0">
                                    <div class="col-md-3 mb-2">
                                        <small class="text-muted">Symbol</small>
                                        <div class="fw-medium fs-5">@(SelectedCurrency.Symbol ?? "-")</div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <small class="text-muted">Symbol Position</small>
                                        <div class="fw-medium">@SelectedCurrency.SymbolPosition</div>
                                    </div>
                                    </div>
                                    @* <div class="col-md-3 mb-2">
                                        <small class="text-muted">Display Format</small>
                                        <div class="fw-medium"><code>@(SelectedCurrency.DisplayFormat ?? "-")</code></div>
                                    </div> *@
                                </div>
                            </div>
                        </div>

                        <!-- Decimal / Rounding Behavior -->
                        <div class=" mb-1">
                            <div class="card-header py-2">
                                <h6 class="mb-0 text-primary"><i class="ti ti-calculator me-2"></i>Decimal / Rounding</h6>
                            </div>
                            <div class="card-body py-2">
                                <div class="row">
                                    <div class="ms-4 row ps-0">
                                    <div class="col-md-3 mb-2">
                                        <small class="text-muted">Decimal Places</small>
                                        <div class="fw-medium">@SelectedCurrency.DecimalPlaces</div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <small class="text-muted">Minor Unit Name</small>
                                        <div class="fw-medium">@(SelectedCurrency.MinorUnitName ?? "-")</div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <small class="text-muted">Rounding Mode</small>
                                        <div class="fw-medium">@SelectedCurrency.RoundingMode</div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <small class="text-muted">Rounding Step</small>
                                        <div class="fw-medium">@(SelectedCurrency.RoundingStep?.ToString("F2") ?? "-")</div>
                                    </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Status & Notes -->
                        <div class="mb-1">
                            <div class="card-header py-2">
                                <h6 class="mb-0 text-primary"><i class="ti ti-settings me-2"></i>Status & Notes</h6>
                            </div>
                            <div class="card-body py-2">
                                <div class="row">
                                    <div class="ms-4 row ps-0">
                                        <div class="col-md-3 mb-2">
                                            <small class="text-muted">Status</small>
                                            <div>
                                                <span class="badge @(SelectedCurrency.IsActive ? "bg-success" : "bg-danger")">
                                                    @(SelectedCurrency.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-md-9 mb-2">
                                            <small class="text-muted">Notes</small>
                                            <div class="fw-medium text-truncate ql-editor">@(new MarkupString(SelectedCurrency?.Notes ?? "-"))</div>
                                        </div>
                                    </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                }
                @* <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <a href="/create-currency/@SelectedCurrency?.Id" class="btn btn-primary">
                        <i class="ti ti-pencil me-1"></i>Edit
                    </a>
                </div> *@
            </div>
        </div>
    </div>

    <!-- ACTIVATE CURRENCY MODAL -->
    <div class="modal fade" id="activateCurrencyModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                @* <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div> *@
                <div class="modal-body text-center py-4">
                    <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                        <i class="ti ti-toggle-right fs-24 text-success"></i>

                    </span>
                    <h5 class="modal-title mt-3">Activate Currency</h5>

                    <p class="mb-0">Are you sure you want to activate <strong>@SelectedCurrency?.CurrencyName</strong>?</p>
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button type="button" class="btn btn-success" data-bs-dismiss="modal" @onclick="ActivateConfirmed"><i class="ti ti-toggle-right me-1"></i>Yes,Activate</button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- DEACTIVATE CURRENCY MODAL -->
    <div class="modal fade" id="deactivateCurrencyModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-body text-center py-4">
                    @if (canDeactivate)
                    {
                        <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                            <i class="ti ti-toggle-left fs-24 text-warning"></i>

                        </span>
                        <h5 class="modal-title mb-2">Deactivate Currency</h5>

                        <p class="mb-0 mt-2 fs-16">Are you sure you want to deactivate <strong>@SelectedCurrency?.CurrencyName</strong>?</p>
                        <div class="info alert-info mt-3 text-start small p-3">
                            <i class="ti ti-info-circle me-2"></i>
                            This currency will not be available for new transactions.
                        </div>
                    }
                    else
                    {
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-toggle-left fs-24 text-danger"></i>
                        </span>

                        <p class="mb-0 mt-2">Cannot deactivate <strong>@SelectedCurrency?.CurrencyName</strong></p>
                        <div class="info alert-info mt-3 text-start small p-3">
                            <i class="ti ti-info-circle me-2"></i>
                            This currency is in use by companies or exchange rates.
                        </div>
                    }
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        @if (canDeactivate)
                        {
                            <button type="button" class="btn btn-warning" data-bs-dismiss="modal" @onclick="DeactivateConfirmed"><i class="ti ti-toggle-left me-1"></i>Yes,Deactivate</button>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- DELETE CURRENCY MODAL -->
    <div class="modal fade" id="deleteCurrencyModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                @* <div class="modal-header">
                    <h5 class="modal-title">Delete Currency</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div> *@
                <div class="modal-body text-center py-4">
                    @if (canDelete)
                    {
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h5 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Currency</h5>

                        <p class=" text-gray-6 mb-0 fs-16">Are you sure you want to delete <strong>@SelectedCurrency?.CurrencyName</strong>?</p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This action cannot be undone.
                        </div>
                    }
                    else
                    {
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-alert-triangle fs-1 text-danger mb-3"></i>
                        </span>
                        <h5 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Currency</h5>

                        <p class="text-gray-6 mb-0 fs-16">Cannot delete <strong>@SelectedCurrency?.CurrencyName</strong></p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This currency is referenced by other records.
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-center gap-2 mb-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                    @if (canDelete)
                    {
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="DeleteConfirmed">
                            <i class="ti ti-trash me-1"></i>Yes,Delete
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}
