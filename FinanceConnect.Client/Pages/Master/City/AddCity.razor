@page "/cities/create"
@page "/cities/{Id:guid}"

<style>
    .form-select option:checked {
        color: white;
        background-color: var(--primary);
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }

    .form-select.is-invalid {
        border-color: #dc3545;
    }

    .field-validation-error {
        color: #dc3545;
        font-size: 12px;
        display: block;
        margin-top: 4px;
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    <div class="content flat-form">
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">@PageTitle</h4>
                    <h6>@PageSubTitle</h6>
                </div>
            </div>

            <div class="page-btn mt-0">
                <a href="/cities" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <EditForm EditContext="_editContext" OnSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="mt-4">
                <div class="card">
                    @* <div class="card-header text-white" style="border-bottom: 1px solid #80808036;">
                        <h5>
                            <i class="ti @(IsEdit ? "ti-edit" : "ti-plus") me-2"></i>
                            @(IsEdit ? "Edit City" : "Add City")
                        </h5>
                    </div> *@

                    <div class="card-body">

                        <!-- ================= COA IDENTITY ================= -->
                        <h6 class="text-primary mb-3 mt-3">
                            <i class="ti ti-building text-primary me-2"></i>City Identity
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">
                                    City Code <span class="text-danger ms-1">*</span>
                                </label>

                                <InputText class="@($"form-control text-uppercase {GetValidationClass(() => City.CityCode)}")"
                                           @bind-Value="City.CityCode"
                                           disabled="@IsEdit"
                                           placeholder="e.g., CBE, CHN, BLR"
                                           maxlength="15" />

                                <ValidationMessage For="@(() => City.CityCode)" />

                                <small class="text-muted">
                                    Short, report-friendly identifier
                                </small>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">
                                    City Name <span class="text-danger ms-1">*</span>
                                </label>

                                <InputText class="@($"form-control {GetValidationClass(() => City.CityName)}")"
                                           @bind-Value="City.CityName" @bind-Value:after="OnCityNameInput"
                                           oninput="this.value=this.value.replace(/[0-9]/g,'');"
                                           placeholder="e.g., Coimbatore, Chennai"
                                           maxlength="150" />

                                <ValidationMessage For="@(() => City.CityName)" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Display Name</label>
                                <InputText class="form-control" @bind-Value="City.DisplayName"
                                           placeholder="e.g., Coimbatore (CBE)" maxlength="200" />
                                <small class="text-muted">For dropdown display</small>
                            </div>
                        </div>
                        <!-- ================= COA IDENTITY ================= -->
                        <h6 class="text-primary mb-3 mt-3"> <i class="ti ti-map text-primary me-2"></i> Location Hierarchy</h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Country <span class="text-danger ms-1">*</span></label>
                                <select class="form-select @(CountryValidationError != null ? "is-invalid" : "")" value="@City.CountryId" @onchange="OnCountryChange" disabled="@IsEdit">
                                    <option value="@Guid.Empty">--Select Country--</option>
                                    @foreach (var country in Countries)
                                    {
                                        <option value="@country.Id">@country.CountryName (@country.CountryCode)</option>
                                    }
                                </select>
                                @if (CountryValidationError != null)
                                {
                                    <span class="field-validation-error">@CountryValidationError</span>
                                }
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">State/Province <span class="text-danger ms-1">*</span></label>
                                <select class="form-select @(StateValidationError != null ? "is-invalid" : "")" value="@City.StateProvinceId" @onchange="OnStateChange" disabled="@IsEdit">
                                    <option value="@Guid.Empty">--Select State/Province--</option>
                                    @foreach (var state in FilteredStates)
                                    {
                                        <option value="@state.Id">@state.StateProvinceName (@state.StateProvinceCode)</option>
                                    }
                                </select>
                                @if (StateValidationError != null)
                                {
                                    <span class="field-validation-error">@StateValidationError</span>
                                }
                                <small class="text-muted">Filtered by selected country</small>
                            </div>

                        </div>
                        <!-- =================Address & Postal Rules ================= -->
                        <h6 class="text-primary mb-3 mt-3">  <i class="ti ti-map-pin text-primary me-2"></i> Postal & Operational Hints</h6>
                        <div class="row g-3">

                            <div class="col-md-3">
                                <label class="form-label">Postal Code Pattern</label>
                                <InputText class="form-control" @bind-Value="City.DefaultPostalCodePattern"
                                           placeholder="e.g., 600001" maxlength="100" />
                                <small class="text-muted">City-level override for validation</small>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Latitude</label>
                                <InputNumber class="form-control" @bind-Value="City.Latitude"
                                             placeholder="e.g., 11.0168" TValue="decimal?" />
                                <small class="text-muted">Optional - for geo features</small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Longitude</label>
                                <InputNumber class="form-control" @bind-Value="City.Longitude"
                                             placeholder="e.g., 76.9558" TValue="decimal?" />
                                <small class="text-muted">Optional - for geo features</small>
                            </div>

                            <div class="col-md-3">
                                <div class="form-check mt-4">
                                    <InputCheckbox class="form-check-input" @bind-Value="City.IsMetro" id="isMetro" />
                                    <label class="form-check-label" for="isMetro">Metro City</label>
                                </div>
                                <small class="text-muted">For analytics</small>
                            </div>
                        </div>
                        <!-- =================Status & Usage Controls ================= -->
                        <h6 class="text-primary mb-3 mt-3"> <i class="ti ti-settings text-primary me-2"></i> Status & Governance</h6>
                        <div class="row g-3">


                            <div class="col-md-3">
                                <label class="form-label">Status <span class="text-danger ms-1">*</span></label>
                                <select class="form-select @(StatusValidationError != null ? "is-invalid" : "")"
                                        @bind="SelectedCityStatus"
                                        @bind:after="OnStatusChanged">
                                    <option value="">--Select Status--</option>
                                    @foreach (var status in CityStatus.All)
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </select>
                                @if (StatusValidationError != null)
                                {
                                    <span class="field-validation-error">@StatusValidationError</span>
                                }
                            </div>
                            @* maxlength="500" *@
                            <div class="col-md-6">
                                <label class="form-label">Notes</label>
                                 <RichTextEditor @ref="_notesEditor"
                                    Value="@City.Notes"
                                    MaxHeight="200" MinHeight="80"
                                    placeholder="Additional notes..." />

                            </div>
                        </div>

                    </div>

                </div>


                <div class="d-flex justify-content-end mb-4">
                    <button type="button" class="btn btn-outline-secondary me-2" @onclick='() => Nav.NavigateTo("/cities")'>
                        <i class="ti ti-x"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy"></i> @(IsEdit ? "Update" : "Save")
                    </button>
                </div>
            </div>
        </EditForm>
    </div>

}
