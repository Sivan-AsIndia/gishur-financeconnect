@page "/cities"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MasterDataService MasterDataService
@inject ToastService ToastService


@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">City List</h4>
                    <h6>Manage your cities</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/cities/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- City List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search city"
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="    display: flex;
                flex-wrap: wrap;
                gap: 17px;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 180px" @bind="SelectedCountryId">
                            <option value="">All Countries</option>
                            @foreach (var country in TableCountries)
                            {
                                <option value="@country.Id">@country.CountryName</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 180px" @bind="SelectedStateId">
                            <option value="">All States</option>
                            @foreach (var state in TableStatesForDropdown)
                            {
                                <option value="@state.Id">@state.StateProvinceName</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            <option value="Draft">Draft</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th>Code</th>
                                <th class="d-none d-md-table-cell">Name</th>
                                <th class="d-none d-xl-table-cell">Country</th>
                                <th class="d-none d-xxl-table-cell">State</th>
                                @* <th class="d-none d-xxl-table-cell">Metro</th> *@
                                <th class="d-none d-md-table-cell">Status</th>
                                <th class="no-sort">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedCities.Any())
                            {
                                @foreach (var c in PagedCities)
                                {
                                    <tr>
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(c)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td>
                                            <span class="fw-medium" data-bs-toggle="tooltip"
                                                  data-bs-placement="top"
                                                  title="@c.CityCode Details">
                                                <span class="PopupIcon">⧉</span>
                                                <a @onclick="async () => await ViewCity(c)" class="text-decoration-none link-View">
                                                    @c.CityCode
                                                </a>
                                            </span>
                                        </td>
                                        <td class="d-none d-md-table-cell">
                                            <div class="d-flex flex-column gap-1">
                                                <span>@c.CityName</span>
                                                <span title="Metro">
                                                    @if (c.IsMetro)
                                                    {
                                                        <span class="badge bg-info-transparent text-info">Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-transparent text-secondary">No</span>
                                                    }
                                                </span>
                                            </div>
                                        
                                        </td>
                                        <td class="d-none d-xl-table-cell" title="@c.CountryName ">
                                            @(c.CountryName ?? "-")
                                        </td>
                                        <td class="d-none d-xxl-table-cell" title="@c.StateProvinceName ">@(c.StateProvinceName ?? "-")</td>
                                        @* <td class="d-none d-xxl-table-cell">
                                         
                                        </td> *@
                                        @* <td class="d-none d-md-table-cell">
                                            <span class="badge @GetStatusBadgeClass(c.Status)">@c.Status</span>
                                        </td> *@
                                        <td class="d-none d-xl-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @GetStatusDotBadge(c.Status)">
                                                </div>
                                                <span> @c.Status</span>
                                            </div>
                                        </td>


                                        <td class="action-table-data">
                                            <div class="edit-delete-action">
                                                @* <a class="me-2 view-icon p-1" href="javascript:void(0);" title="View"
                                                   data-bs-toggle="modal" data-bs-target="#view-city-modal"
                                                   @onclick="async () => await ViewCity(c)">
                                                    <i data-feather="eye"></i>
                                                </a> *@
                                                <a class="me-2 p-1 edit-icon" href="cities/@c.Id">
                                                    <i data-feather="edit"></i>
                                                </a>
                                                @if (c.IsActive)
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon deactivate-icon" href="javascript:void(0);"
                                                       title="Deactivate" data-bs-toggle="modal" data-bs-target="#deactivate-modal"
                                                       @onclick="() => ConfirmDeactivate(c)">
                                                        <i class="ti ti-toggle-right"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Activate" data-bs-toggle="modal" data-bs-target="#activate-modal"
                                                       @onclick="() => ConfirmActivate(c)">
                                                        <i class="ti ti-toggle-left"></i>
                                                    </a>
                                                }
                                                <a class="me-2 p-1 delete-icon action-icon delete-icon" href="javascript:void(0);"
                                                   title="Delete" data-bs-toggle="modal" data-bs-target="#delete-modal"
                                                   @onclick="() => ConfirmDelete(c)">
                                                    <i class="ti ti-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center py-4">
                                        <div class="text-muted">No cities found</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            @if (FilteredCities.Count > 0)
            {
                <div class="d-flex align-items-center justify-content-between p-3">
                    <div class="d-flex align-items-center fs-13">
                        <span class="me-2">Rows per page</span>
                        <select class="form-select form-select-sm" style="width: 80px" @onchange="OnPageSizeChange">
                            <option value="5" selected="@(PageSize == 5)">5</option>

                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                        <span class="ms-2">Entries</span>
                    </div>


                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                    <i class="ti ti-chevron-left"></i>

                                </a>
                            </li>
                            @for (int i = StartPage; i <= EndPage; i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="NextPage">    <i class="ti ti-chevron-right"></i></a>
                            </li>
                        </ul>
                    </nav>
              
                </div>
            }
        </div>




        <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">City Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                style="padding:0; right:22px; position:absolute;transform:none"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-2 d-flex gap-3">
                            <strong>Country Name:</strong>
                            <div>@(SelectedCompany?.CountryName ?? "-")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>City Name:</strong>
                            <div>@(SelectedCompany?.CityName ?? "-")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Country Name:</strong>
                            <div>@(SelectedCompany?.StateProvinceName ?? "-")</div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>IsMetro:</strong>
                            <div>
                                @if (SelectedCompany?.IsMetro == true)
                                {
                                    <span class="badge bg-info-transparent text-info">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-transparent text-secondary">No</span>
                                }

                            </div>
                        </div>

                        <div class="mb-2 gap-3 d-md-none">
                            <strong>Status:</strong>
                            <span class="badge @GetStatusBadgeClass(SelectedCompany?.Status)">
                                @(SelectedCompany?.Status ?? "-")
                            </span>


                        </div>


                    </div>

                </div>
            </div>
        </div>



        <!-- View City offcanvas -->
        <div class="offcanvas offcanvas-end offcanvas-view"
             tabindex="-1"
             id="viewCityOffcanvas"
             data-bs-backdrop="true"
             data-bs-scroll="false">

            @if (SelectedCity != null)
            {
                <!-- Header -->
                <div class="offcanvas-header">

                    <div class="oc-avatar">
                        @SelectedCity.CityCode
                    </div>

                    <div class="oc-header-info">
                        <div class="oc-header-top">
                            <h5>@SelectedCity.CityName</h5>

                            <span class="oc-status-pill @(SelectedCity.Status == "Active" ? "active" : "inactive")">
                                <span class="oc-status-dot"></span>
                                @SelectedCity.Status
                            </span>
                        </div>

                        <p class="oc-header-sub">
                            @(SelectedCity.DisplayName ?? SelectedCity.CityName)
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="offcanvas"
                            aria-label="Close"></button>
                </div>


                <!-- Body -->
                <div class="offcanvas-body">

                    <!-- Summary Cards -->
                    <div class="oc-summary-row">

                        <div class="oc-summary-card card-orange">
                            <div class="oc-summary-value">
                                @SelectedCity.CityCode
                            </div>
                            <div class="oc-summary-label">City Code</div>
                        </div>

                        <div class="oc-summary-card card-blue">
                            <div class="oc-summary-value">
                                @(SelectedCity.StateProvinceName ?? "—")
                            </div>
                            <div class="oc-summary-label">State / Province</div>
                        </div>

                        <div class="oc-summary-card card-green">
                            <div class="oc-summary-value">
                                @(SelectedCity.IsMetro ? "Yes" : "No")
                            </div>
                            <div class="oc-summary-label">Metro City</div>
                        </div>

                    </div>


                    <!-- City Identity -->
                    <div class="oc-card">
                        <div class="oc-card-header hdr-orange">
                            <i class="ti ti-building"></i>
                            <h6 class="oc-card-title">City Identity</h6>
                        </div>

                        <div class="oc-card-body">
                            <div class="oc-grid">

                                <div class="oc-grid-item">
                                    <div class="oc-field-label">
                                        <i class="ti ti-tag"></i> City Code
                                    </div>
                                    <div class="oc-field-value">
                                        @SelectedCity.CityCode
                                    </div>
                                </div>

                                <div class="oc-grid-item">
                                    <div class="oc-field-label">
                                        <i class="ti ti-building-community"></i> City Name
                                    </div>
                                    <div class="oc-field-value">
                                        @SelectedCity.CityName
                                    </div>
                                </div>

                                <div class="oc-grid-item">
                                    <div class="oc-field-label">
                                        <i class="ti ti-id"></i> Display Name
                                    </div>
                                    <div class="oc-field-value">
                                        @(SelectedCity.DisplayName ?? "—")
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>


                    <!-- Location Hierarchy -->
                    <div class="oc-card">
                        <div class="oc-card-header hdr-blue">
                            <i class="ti ti-map-2"></i>
                            <h6 class="oc-card-title">Location Hierarchy</h6>
                        </div>

                        <div class="oc-card-body">
                            <div class="oc-grid">

                                <div class="oc-grid-item">
                                    <div class="oc-field-label">
                                        <i class="ti ti-world"></i> Country
                                    </div>
                                    <div class="oc-field-value">
                                        @(SelectedCity.CountryName ?? "—")
                                    </div>
                                </div>

                                <div class="oc-grid-item">
                                    <div class="oc-field-label">
                                        <i class="ti ti-map"></i> State / Province
                                    </div>
                                    <div class="oc-field-value">
                                        @(SelectedCity.StateProvinceName ?? "—")
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>


                    <!-- Postal & Operational -->
                    <div class="oc-card">
                        <div class="oc-card-header hdr-purple">
                            <i class="ti ti-mail"></i>
                            <h6 class="oc-card-title">Postal & Operational Hints</h6>
                        </div>

                        <div class="oc-card-body">
                            <div class="oc-grid">

                                <div class="oc-grid-item">
                                    <div class="oc-field-label">
                                        <i class="ti ti-mailbox"></i> Postal Pattern
                                    </div>
                                    <div class="oc-field-value">
                                        <code>@(SelectedCity.DefaultPostalCodePattern ?? "—")</code>
                                    </div>
                                </div>

                                <div class="oc-grid-item">
                                    <div class="oc-field-label">
                                        <i class="ti ti-building-skyscraper"></i> Is Metro
                                    </div>
                                    <div class="oc-field-value">
                                        <span class="oc-dot-badge @(SelectedCity.IsMetro ? "db-green" : "db-red")">
                                            <span class="dot"></span>
                                            @(SelectedCity.IsMetro ? "Yes" : "No")
                                        </span>
                                    </div>
                                </div>

                                <div class="oc-grid-item">
                                    <div class="oc-field-label">
                                        <i class="ti ti-map-pin"></i> Latitude
                                    </div>
                                    <div class="oc-field-value">
                                        @(SelectedCity.Latitude?.ToString("F6") ?? "—")
                                    </div>
                                </div>

                                <div class="oc-grid-item">
                                    <div class="oc-field-label">
                                        <i class="ti ti-map-pin"></i> Longitude
                                    </div>
                                    <div class="oc-field-value">
                                        @(SelectedCity.Longitude?.ToString("F6") ?? "—")
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>


                    <!-- Status & Governance -->
                    <div class="oc-card">
                        <div class="oc-card-header hdr-green">
                            <i class="ti ti-settings"></i>
                            <h6 class="oc-card-title">Status & Governance</h6>
                        </div>

                        <div class="oc-card-body">
                            <div class="oc-list">

                                <div class="oc-list-row">
                                    <span class="oc-list-label">
                                        <i class="ti ti-toggle-right"></i> Status
                                    </span>
                                    <span class="oc-list-value">
                                        <span class="oc-dot-badge @(SelectedCity.Status == "Active" ? "db-green" : "db-red")">
                                            <span class="dot"></span>
                                            @SelectedCity.Status
                                        </span>
                                    </span>
                                </div>

                                <div class="oc-list-row">
                                    <span class="oc-list-label">
                                        <i class="ti ti-note"></i> Notes
                                    </span>
                                    <span class="oc-list-value text-truncate ql-editor" style="max-width:200px;" title="@GetPlainText(SelectedCity?.Notes)">
                                        @(new MarkupString(SelectedCity?.Notes ?? "-"))
                                    </span>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Audit Information -->
                    <div class="oc-card">
                        <div class="oc-card-header hdr-teal">
                            <i class="ti ti-history"></i>
                            <h6 class="oc-card-title">Audit Information</h6>
                        </div>

                        <div class="oc-card-body">
                            <div class="oc-list">

                                <div class="oc-list-row">
                                    <span class="oc-list-label">
                                        <i class="ti ti-calendar-plus"></i> Created At
                                    </span>
                                    <span class="oc-list-value">
                                        @SelectedCity.CreatedAt.ToString("dd-MMM-yyyy HH:mm")
                                    </span>
                                </div>

                                <div class="oc-list-row">
                                    <span class="oc-list-label">
                                        <i class="ti ti-user"></i> Created By
                                    </span>
                                    <span class="oc-list-value">
                                        @(SelectedCity.CreatedBy ?? "—")
                                    </span>
                                </div>

                                <div class="oc-list-row">
                                    <span class="oc-list-label">
                                        <i class="ti ti-calendar-event"></i> Updated At
                                    </span>
                                    <span class="oc-list-value">
                                        @(SelectedCity.UpdatedAt?.ToString("dd-MMM-yyyy HH:mm") ?? "—")
                                    </span>
                                </div>

                                <div class="oc-list-row">
                                    <span class="oc-list-label">
                                        <i class="ti ti-user-edit"></i> Updated By
                                    </span>
                                    <span class="oc-list-value">
                                        @(SelectedCity.UpdatedBy ?? "—")
                                    </span>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            }
        </div>

        <!-- Activate Modal -->
        <div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-toggle-right fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate City</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to activate <strong>@SelectedCity?.CityName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal">
                                    <i class="ti ti-toggle-right me-1"></i>Yes, Activate
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deactivate Modal -->
        <div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                                <i class="ti ti-toggle-left fs-24 text-warning"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate City</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDeactivate)
                                {
                                    <span class="text-danger">Cannot deactivate! This city is referenced by other records.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to deactivate <strong>@SelectedCity?.CityName</strong>?</span>
                                }
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDeactivate)
                                {
                                    <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal">
                                        <i class="ti ti-toggle-left me-1"></i>Yes, Deactivate
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                <i class="ti ti-trash fs-24 text-danger"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete City</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDelete)
                                {
                                    <span class="text-danger">Cannot delete! This city is referenced by other records.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to delete <strong>@SelectedCity?.CityName</strong>?</span>
                                }
                            </p>
                            
                            @if (canDelete)
                            {
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                            }
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDelete)
                                {
                                    <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteConfirmed" data-bs-dismiss="modal">
                                        <i class="ti ti-trash me-1"></i>Yes, Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

}
