@page "/companies"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MasterDataService MasterDataService
@inject BranchService BranchService
@inject ToastService ToastService



@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title" id="CompanyPageTitle">
                    <h4 class="fw-bold">Company List</h4>
                    <h6>Manage your companies</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);"  title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/companies/create" id="CreateButton" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                   Create
                </a>
            </div>
        </div>
        <!-- Company List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3" id="FilterCompany">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search company..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="    display: flex;
            flex-wrap: wrap;
            gap: 10px;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 180px" @bind="SelectedCountryId">
                            <option value="">All Countries</option>
                            @foreach (var country in Countries)
                            {
                                <option value="@country.Id">@country.CountryName</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 160px" @bind="SelectedLegalStructure">
                            <option value="">All Structures</option>
                            @foreach (var structure in LegalStructures.All)
                            {
                                <option value="@structure">@structure</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            <option value="Draft">Draft</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <div>
                        <table class="table align-middle w-100 table-fixed">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xl-none" style="width:40px"></th>

                                    <th style="width:165px" title="Company Code">Code</th>
                                    <th class="d-none d-md-table-cell" style="width: 400px;">Legal Name</th>

                                    @* <th class="d-none d-md-table-cell">Trade Name</th> *@
                                    <th class="d-none d-xl-table-cell" title="Legal Structure">Legal Structure</th>
                                    @* <th class="d-none d-xl-table-cell">Country</th> *@
                                    <th class="d-none d-xxl-table-cell">City</th>
                                    @* <th class="d-none d-xxl-table-cell">Base Currency</th> *@

                                    <th class="d-none d-xl-table-cell" style="width: 106px;">Status</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedCompanies.Any())
                                {
                                    @foreach (var c in PagedCompanies)
                                    {
                                        <tr>
                                            <!-- PLUS ICON -->
                                            <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#rowDetailsModal"
                                                   @onclick="() => OpenRowDetails(c)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td class="fw-medium">
                                                <div class="d-flex align-items-center">
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a @onclick="async () => await ViewCompany(c)" class="text-decoration-none link-View"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"  data-tooltip-class="bg-success text-white"
                                                   title="@c.CompanyCode details page">
                                                    @c.CompanyCode
                                                </a>
                                                </div>
                                            </td>


                                            <td class="d-none d-md-table-cell">
                                                <div style="color: black;" class="TableNameColumn">
                                                    @c.LegalName
                                                </div>
                                                <div title="TradeName" style="color: #808080a6;">@c.TradeName</div>
                                            </td>


                                            @* <td class="d-none d-md-table-cell" title="@c.TradeName">
                                                @(c.TradeName ?? "-")
                                            </td> *@

                                            <td class="d-none d-xl-table-cell" style="text-overflow:inherit">
                                                <span class="badge bg-info-transparent text-info">
                                                    @c.LegalStructure
                                                </span>
                                            </td>

                                            @* <td class="d-none d-xl-table-cell" title="@c.CountryName ">
                                                @(c.CountryName ?? "-")
                                            </td> *@

                                            <td class="d-none d-xxl-table-cell">
                                                @(c.CityName ?? "-")
                                            </td>

                                            @* <td class="d-none d-xxl-table-cell">
                                                @(c.BaseCurrencyName ?? "-")
                                            </td> *@

                                            <td class="d-none d-xl-table-cell">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="ActiveDot @GetStatusBadge(c.Status)">
                                                    </div>
                                                    <span> @c.Status</span>
                                              </div>
                                            </td>

                                            <td class="action-table-data">
                                                <div class="edit-delete-action" style="justify-content: center;">
                                                    @* <a class="me-2 view-icon p-1" href="javascript:void(0);" title="View"
                                                       @onclick="async () => await ViewCompany(c)">
                                                        <i data-feather="eye"></i>
                                                    </a> *@
                                                    <a class="me-2 edit-icon p-1" href="/companies/@c.Id" title="Edit">
                                                        <i data-feather="edit"></i>
                                                    </a>
                                                    @if (c.IsActive)
                                                    {
                                                        <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon" href="javascript:void(0);"
                                                           title="Deactivate" data-bs-toggle="modal" data-bs-target="#deactivate-modal"
                                                           @onclick="() => ConfirmDeactivate(c)">
                                                            <i class="ti ti-toggle-right"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                           title="Activate" data-bs-toggle="modal" data-bs-target="#activate-modal"
                                                           @onclick="() => ConfirmActivate(c)">
                                                            <i class="ti ti-toggle-left"></i>
                                                        </a>
                                                    }
                                                    <a class="p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                                       data-bs-toggle="modal" data-bs-target="#delete-modal"
                                                       @onclick="() => ConfirmDelete(c)">
                                                        <i data-feather="trash-2"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@VisibleColumnCount" class="text-center text-muted py-4">
                                            No companies found
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center p-3">
                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = 1; i <= TotalPages; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
              
                </div>

            </div>
        </div>



        <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Company Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                style="padding:0; right:22px; position:absolute;transform:none"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-2 d-flex gap-3">
                            <strong>Trade Name:</strong>
                            <div>@SelectedCompany?.TradeName</div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Legal Structure:</strong>
                            <div>@SelectedCompany?.LegalStructure</div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Country:</strong>
                            <div>@SelectedCompany?.CountryName</div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>City:</strong>
                            <div>@SelectedCompany?.CityName</div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Base Currency:</strong>
                            <div>@SelectedCompany?.BaseCurrencyName</div>
                        </div>

                        <div class="mb-2 gap-3">
                            <strong>Status:</strong>
                            <span class="badge @GetStatusBadge(SelectedCompany?.Status)">
                                @(SelectedCompany?.Status ?? "-")
                            </span>

                        </div>


                    </div>

                </div>
            </div>
        </div>



        <!-- Activate Modal -->
        <div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-toggle-right fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Company</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to activate <strong style="white-space: normal;word-break: break-word;">@SelectedCompany?.LegalName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal">
                                    <i class="ti ti-toggle-right me-1"></i>Yes, Activate
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deactivate Modal -->
        <div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                                <i class="ti ti-toggle-left fs-24 text-warning"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate Company</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDeactivate)
                                {
                                    <span class="text-danger">Cannot deactivate! Company has active references.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to deactivate <strong>@SelectedCompany?.LegalName</strong>?</span>
                                }
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDeactivate)
                                {
                                    <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal">
                                        <i class="ti ti-toggle-left me-1"></i>Yes, Deactivate
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                <i class="ti ti-trash fs-24 text-danger"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Company</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDelete)
                                {
                                    <span class="text-danger">Cannot delete! This company has branches mapped to it. Please remove all branches for this company first and then delete.</span>
                                }
                                else
                                {
                                    <span>
                                        Are you sure you want to delete <strong style="white-space: normal;word-break: break-word;">@SelectedCompany?.LegalName</strong>?
                                    </span>
                                }
                            </p>

                            @if (canDelete)
                            {
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                            }
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDelete)
                                {
                                    <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteConfirmed" data-bs-dismiss="modal">
                                        <i class="ti ti-trash me-1"></i>Yes, Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

}





<!-- View Company Modal -->
<div class="modal fade list-Popup" id="view-company-modal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="position: relative; overflow: visible;">
            <button type="button" class="btn btn-danger btn-sm rounded-circle position-absolute"
                    data-bs-dismiss="modal" aria-label="Close"
                    style="top: -12px; right: -12px; width: 32px; height: 32px; z-index: 1055; padding: 0; display: flex; align-items: center; justify-content: center;">
                <i class="ti ti-x fs-16"></i>
            </button>
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-building me-2"></i>Company Details</h5>
            </div>
            <div class="modal-body">
                @if (SelectedCompany != null)
                {
                    <!-- Company Identity -->
                    <div class="card mb-3">
                        <div class="card-header py-2 bg-light">
                            <h6 class="mb-0"><i class="ti ti-id me-2"></i>Company Identity</h6>
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Company Code</small>
                                    <div class="fw-medium">@SelectedCompany.CompanyCode</div>
                                </div>
                                <div class="col-md-5 mb-2">
                                    <small class="text-muted">Legal Name</small>
                                    <div class="fw-medium">@SelectedCompany.LegalName</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Trade Name</small>
                                    <div>@(SelectedCompany.TradeName ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Short Name</small>
                                    <div>@(SelectedCompany.ShortName ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Legal Structure</small>
                                    <div><span class="badge bg-info">@SelectedCompany.LegalStructure</span></div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Incorporation Date</small>
                                    <div>@(SelectedCompany.IncorporationDate?.ToString("dd MMM yyyy") ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Status</small>
                                    <div><span class="badge @GetStatusBadge(SelectedCompany.Status)">@SelectedCompany.Status</span></div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Parent Company</small>
                                    <div>@(SelectedCompany.ParentCompanyName ?? "-")</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Default Branch</small>
                                    <div>@(SelectedCompany.DefaultBranchName ?? "-")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Registration & Compliance -->
                    <div class="card mb-3">
                        <div class="card-header py-2 bg-light">
                            <h6 class="mb-0"><i class="ti ti-file-certificate me-2"></i>Registration & Compliance</h6>
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Registration Number / CIN</small>
                                    <div>@(SelectedCompany.RegistrationNumber ?? "-")</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">PAN Number</small>
                                    <div class="fw-medium">@(SelectedCompany.PANNumber ?? "-")</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">GSTIN</small>
                                    <div class="fw-medium">@(SelectedCompany.GSTIN ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">TAN Number</small>
                                    <div>@(SelectedCompany.TANNumber ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Other Tax ID</small>
                                    <div>@(SelectedCompany.OtherTaxId ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">GST Registered</small>
                                    <div><span class="badge @(SelectedCompany.IsGSTRegistered ? "bg-success" : "bg-secondary")">@(SelectedCompany.IsGSTRegistered ? "Yes" : "No")</span></div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Registration Country</small>
                                    <div>@(SelectedCompany.RegistrationCountryName ?? "-")</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Registration State</small>
                                    <div>@(SelectedCompany.RegistrationStateProvinceName ?? "-")</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Registration City</small>
                                    <div>@(SelectedCompany.RegistrationCityName ?? "-")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Registered Address -->
                    <div class="card mb-3">
                        <div class="card-header py-2 bg-light">
                            <h6 class="mb-0"><i class="ti ti-map-pin me-2"></i>Registered Address</h6>
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted">Address Line 1</small>
                                    <div>@SelectedCompany.AddressLine1</div>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted">Address Line 2</small>
                                    <div>@(SelectedCompany.AddressLine2 ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Country</small>
                                    <div>@(SelectedCompany.CountryName ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">State/Province</small>
                                    <div>@(SelectedCompany.StateProvinceName ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">City</small>
                                    <div>@(SelectedCompany.CityName ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Postal Code</small>
                                    <div class="fw-medium">@SelectedCompany.PostalCode</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Time Zone</small>
                                    <div>@(SelectedCompany.TimeZoneName ?? "-")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contact & Branding -->
                    <div class="card mb-3">
                        <div class="card-header py-2 bg-light">
                            <h6 class="mb-0"><i class="ti ti-phone me-2"></i>Contact & Branding</h6>
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Primary Contact</small>
                                    <div>@(SelectedCompany.PrimaryContactName ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Email</small>
                                    <div>@(SelectedCompany.PrimaryEmail ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Phone</small>
                                    <div>@(SelectedCompany.PrimaryPhone ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Website</small>
                                    <div>@(SelectedCompany.WebsiteUrl ?? "-")</div>
                                </div>
                                @if (!string.IsNullOrEmpty(SelectedCompany.LogoBase64))
                                {
                                    <div class="col-md-12 mt-2">
                                        <small class="text-muted">Company Logo</small>
                                        <div class="mt-1">
                                            <img src="data:@(SelectedCompany.LogoContentType ?? "image/png");base64,@(SelectedCompany.LogoBase64)"
                                                 alt="Company Logo" style="max-height: 80px; max-width: 200px; object-fit: contain;"
                                                 class="border rounded p-1 bg-white" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Financial Settings -->
                    <div class="card mb-3">
                        <div class="card-header py-2 bg-light">
                            <h6 class="mb-0"><i class="ti ti-currency-dollar me-2"></i>Financial Settings</h6>
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Base Currency</small>
                                    <div class="fw-medium">@(SelectedCompany.BaseCurrencyName ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Reporting Currency</small>
                                    <div>@(SelectedCompany.ReportingCurrencyName ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Fiscal Year Start</small>
                                    <div class="fw-medium">@GetMonthName(SelectedCompany.FiscalYearStartMonth)</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Books Start Date</small>
                                    <div class="fw-medium">@SelectedCompany.BooksStartDate.ToString("dd MMM yyyy")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Multi-Currency</small>
                                    <div><span class="badge @(SelectedCompany.EnableMultiCurrency ? "bg-success" : "bg-secondary")">@(SelectedCompany.EnableMultiCurrency ? "Enabled" : "Disabled")</span></div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Rounding Precision</small>
                                    <div>@SelectedCompany.RoundingPrecision decimals</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Rounding Mode</small>
                                    <div>@SelectedCompany.RoundingMode</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Posting Controls -->
                    <div class="card mb-3">
                        <div class="card-header py-2 bg-light">
                            <h6 class="mb-0"><i class="ti ti-lock me-2"></i>System & Posting Controls</h6>
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Allow Posting From</small>
                                    <div>@(SelectedCompany.AllowPostingFromDate?.ToString("dd MMM yyyy") ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Allow Posting To</small>
                                    <div>@(SelectedCompany.AllowPostingToDate?.ToString("dd MMM yyyy") ?? "-")</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Lock Back-Dated Posting</small>
                                    <div><span class="badge @(SelectedCompany.LockBackDatedPosting ? "bg-warning" : "bg-secondary")">@(SelectedCompany.LockBackDatedPosting ? "Locked" : "Unlocked")</span></div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Backdated Days Allowed</small>
                                    <div>@SelectedCompany.BackdatedPostingDaysAllowed days</div>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <small class="text-muted">Future Days Allowed</small>
                                    <div>@SelectedCompany.FuturePostingDaysAllowed days</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Notes -->
                    @if (!string.IsNullOrWhiteSpace(SelectedCompany.Notes))
                    {
                        <div class="card mb-0">
                            <div class="card-header py-2 bg-light">
                                <h6 class="mb-0"><i class="ti ti-notes me-2"></i>Notes</h6>
                            </div>
                            <div class="card-body py-2">
                                <div>@SelectedCompany.Notes</div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a href="/create-company/@SelectedCompany?.Id" class="btn btn-primary">
                    <i class="ti ti-pencil me-1"></i>Edit
                </a>
            </div>
        </div>
    </div>
</div>

