@page "/deliverychallans"

@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels

@inject NavigationManager Nav
@inject IJSRuntime JS

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- PAGE HEADER -->

        <div class="page-header">

            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Delivery Challan List</h4>
                    <h6>Manage delivery challans</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/deliverychallans/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>Create
                </a>
            </div>

        </div>

        <!-- CARD -->

        <div class="card">

            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

                <!-- SEARCH -->

                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset">
                            <i class="ti ti-search"></i>
                        </span>

                        <input type="search"
                               class="form-control form-control-sm"
                               placeholder="Search challan"
                               @bind="searchText"
                               @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display:flex" class="gap-2">

                    <!-- COMPANY -->

                    <select class="form-select form-select-sm"
                            style="min-width:180px"
                            @bind="SelectedCompany">

                        <option value="">All Companies</option>

                        @foreach (var c in Companies)
                        {
                            <option value="@c.Id">@c.LegalName</option>
                        }

                    </select>

                    <!-- CUSTOMER -->

                    <select class="form-select form-select-sm"
                            style="min-width:180px"
                            @bind="SelectedCustomer">

                        <option value="">All Customers</option>

                        @foreach (var c in Customers)
                        {
                            <option value="@c.Id">@c.CustomerName</option>
                        }

                    </select>

                </div>

            </div>


            <!-- TABLE -->

            <div class="card-body p-0">

                <table class="table align-middle w-100 table-fixed">

                    <thead class="thead-light">

                        <tr>
                            <th class="d-xl-none" style="width:40px"></th>
                            <th style="width:180px">Challan #</th>
                            <th class="d-none d-md-table-cell">Customer</th>
                            <th class="d-none d-md-table-cell">PO Number</th>
                            <th class="d-none d-lg-table-cell">Date</th>
                            <th class="d-none d-xl-table-cell">Shipping Date</th>
                            <th class="d-none d-xl-table-cell">Amount</th>

                            <th style="width:140px">Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (PagedChallans.Any())
                        {
                            @foreach (var c in PagedChallans)
                            {

                                <tr>
                                    <!-- Mobile plus -->
                                    <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                        <a class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(c)">
                                            <i class="ti ti-plus"></i>
                                        </a>
                                    </td>
                                    <td class="fw-medium">
                                        <span>
                                            <i class="ti ti-external-link me-2 PopupIcon"></i>
                                            <a @onclick="() => ViewChallan(c)" class="text-decoration-none link-View"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title="@c.ChallanNumber details">
                                                @c.ChallanNumber
                                            </a>
                                        </span>

                                    </td>

                                    <td class="d-none d-md-table-cell">
                                        @getCustomerName(c.CustomerId)
                                    </td>

                                    <td class="d-none d-md-table-cell">
                                        @c.PONumber
                                    </td>

                                    <td class="d-none d-lg-table-cell">
                                        @c.ChallanDate?.ToString("dd-MMM-yyyy")
                                    </td>

                                    <td class="d-none d-xl-table-cell">
                                        @c.ShippingDate?.ToString("dd-MMM-yyyy")
                                    </td>

                                    <td class="d-none d-xl-table-cell">
                                        ₹@c.SubTotal.ToString("N0")
                                    </td>


                                    <td class="action-table-data">

                                        <div class="edit-delete-action">

                                            <a class="me-2 edit-icon p-1"
                                                   @onclick='() => Nav.NavigateTo($"/deliverychallans/{c.Id}")'>

                                                <i data-feather="edit"></i>

                                            </a>

                                            <a class="p-1 delete-icon"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#delete-modal"
                                                   @onclick="() => ConfirmDelete(c)">

                                                <i data-feather="trash-2"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                            }
                        }

                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">

                                    <div class="text-muted">
                                        <i class="ti ti-database-off fs-32"></i>
                                        <div>No delivery challans found</div>
                                    </div>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>


                <!-- PAGINATION -->
                @if (PagedChallans.Any())
                {
                    <div class="d-flex justify-content-between align-items-center p-3">

                        <div class="d-flex align-items-center fs-13">

                            <span class="me-2">Rows Per Page</span>

                            <select class="form-select form-select-sm w-auto"
                                    @onchange="OnPageSizeChange">

                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>

                            </select>

                        </div>


                        <nav>

                            <ul class="pagination pagination-sm mb-0">

                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">

                                    <a class="page-link"
                                           href="#"
                                           @onclick="PreviousPage">

                                        <i class="ti ti-chevron-left"></i>

                                    </a>

                                </li>


                                @foreach (var p in VisiblePages)
                                {
                                    <li class="page-item @(p == CurrentPage ? "active" : "")">

                                        <button class="page-link"
                                                @onclick="() => GoToPage(p)">
                                            @p
                                        </button>

                                    </li>
                                }


                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">

                                    <a class="page-link"
                                           href="#"
                                           @onclick="NextPage">

                                        <i class="ti ti-chevron-right"></i>

                                    </a>

                                </li>

                            </ul>

                        </nav>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- DELETE MODAL -->

    <div class="modal fade" id="delete-modal">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="p-4 text-center">

                    <h4 class="fw-bold mb-2">Delete Delivery Challan</h4>

                    <p>

                        Are you sure you want to delete

                        <strong>@SelectedChallan?.ChallanNumber</strong> ?

                    </p>

                    <div class="mt-3 d-flex justify-content-center gap-2">

                        <button class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button class="btn btn-danger"
                                @onclick="DeleteConfirmed"
                                data-bs-dismiss="modal">

                            Delete

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Responsive modal -->

    <div class="modal fade list-Popup" id="rowDetailsModal">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">Delivery Challan Details</h5>

                    <button class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    @if (SelectedChallan != null)
                    {

                        <div class="mb-2 d-flex gap-3">
                            <strong>Challan #:</strong>
                            <span>@SelectedChallan.ChallanNumber</span>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Customer:</strong>
                            <span>@getCustomerName(SelectedChallan.CustomerId)</span>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>PO Number:</strong>
                            <span>@SelectedChallan.PONumber</span>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Challan Date:</strong>
                            <span>@SelectedChallan.ChallanDate?.ToString("dd-MMM-yyyy")</span>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Shipping Date:</strong>
                            <span>@SelectedChallan.ShippingDate?.ToString("dd-MMM-yyyy")</span>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Total Amount:</strong>
                            <span>₹@SelectedChallan.GrandTotal.ToString("N0")</span>
                        </div>

                    }

                </div>

            </div>

        </div>

    </div>
}