@page "/quotations/{Id:guid}"
@page "/quotations/create"


@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    <div class="content">

        <!-- Page Header -->
        <div class="page-header">
            <div class="page-title">

                <div style="display:ruby">

                    <h4 class="fw-bold">
                        Quotation
                    </h4>

                    <span class="badge @GetStatusBadge(Model.Status)">
                        @Model.Status.GetDisplayName()
                    </span>

                </div>

                <span class="badge bg-secondary-transparent text-dark">@Model.QuotationNumber</span>

            </div>

            <div class="page-btn mt-0">
                <a href="/quotations" type="button" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>

        <!-- QUOTATION INFO -->
        <div class="card">
            <div class="card-body">

                <div class="row mb-4">

                    <div class="col-12">
                        <h6 class="fw-semibold text-primary border-bottom pb-2 mb-3">
                            <i class="ti ti-file-text me-1"></i> Quotation Information
                        </h6>
                    </div>

                  @*   <div class="col-md-3 mb-3">
                        <label class="form-label">Quotation #</label>
                        <input class="form-control"
                        value="@Model.QuotationNumber"
                        readonly />
                    </div> *@

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Company <span class="text-danger ms-1">*</span></label>

                        <select class="@($"form-select {(ShowFieldError("CompanyId") ? "is-invalid" : "")}")"
                                @bind="SelectedCompany">

                            <option value="">--Select Company--</option>

                            @foreach (var c in Companies)
                            {
                                <option value="@c.Id">@c.LegalName</option>
                            }

                        </select>
                        @if (ShowFieldError("CompanyId"))
                        {
                            <div class="text-danger small mt-1">Company is required</div>
                        }
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Customer <span class="text-danger ms-1">*</span></label>

                        <select class="@($"form-select {(ShowFieldError("CustomerId") ? "is-invalid" : "")}")"
                        @bind="Model.CustomerId">

                            <option value="">--Select Customer--</option>

                            @foreach (var c in Customers)
                            {
                                <option value="@c.Id">@c.CustomerName</option>
                            }

                        </select>
                        @if (ShowFieldError("CustomerId"))
                        {
                            <div class="text-danger small mt-1">Customer is required</div>
                        }
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Quotation Owner</label>

                        <input class="form-control"
                        value="@OwnerName"
                        readonly />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Quotation Date <span class="text-danger ms-1">*</span></label>

                        <input type="date"
                               class="@($"form-control {(ShowFieldError("QuotationDate") ? "is-invalid" : "")}")"
                        @bind="Model.QuotationDate" />
                        @if (ShowFieldError("QuotationDate"))
                        {
                            <div class="text-danger small mt-1">Quotation Date is required</div>
                        }
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Expiry Date <span class="text-danger ms-1">*</span></label>

                        <input type="date"
                               class="@($"form-control {(ShowFieldError("ExpiryDate") ? "is-invalid" : "")}")"
                               min="@(Model.QuotationDate?.ToString("yyyy-MM-dd"))"
                        @bind="Model.ExpiryDate" />
                        @if (ShowFieldError("ExpiryDate"))
                        {
                            <div class="text-danger small mt-1">Expiry Date is required</div>
                        }
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Subject <span class="text-danger ms-1">*</span></label>

                        <input class="@($"form-control {(ShowFieldError("Subject") ? "is-invalid" : "")}")"
                        placeholder="Enter the subject..."
                        @bind="Model.Subject" />
                        @if (ShowFieldError("Subject"))
                        {
                            <div class="text-danger small mt-1">Subject is required</div>
                        }
                    </div>

                </div>

            </div>
        </div>


        <!-- PRODUCT LINES -->
        <div class="card mt-4">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">

                    <h6 class="fw-semibold text-primary mb-0">
                        <i class="ti ti-list me-1"></i> Quotation Items
                    </h6>

                    <button class="btn btn-sm btn-outline-primary"
                    @onclick="AddLine">
                        <i class="ti ti-plus me-1"></i> Add Item
                    </button>

                </div>

                <!-- DESKTOP GRID -->

                <div class="desktop-only table-responsive">

                    <table class="table align-middle w-100 table-fixed">

                        <thead class="thead-light">
                            <tr>

                                <th width="20">#</th>
                                <th width="240">Item Name</th>
                                <th width="140">Unit</th>
                                <th width="100" class="text-end">Qty</th>
                                <th width="120" class="text-end">Rate</th>
                                <th width="100" class="text-end">Tax%</th>
                                <th width="110" class="text-end">Amount</th>
                                <th width="90" class="text-center">Action</th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var line in Model.Items)
                            {
                                <tr>

                                    <td class="text-center">
                                        @(Model.Items.IndexOf(line) + 1)
                                    </td>

                                    <td>

                                        <select class="form-select form-select-sm"
                                                @bind="line.ItemId" @bind:after="() => OnItemChanged(line)">
                                                
                                            <option value="">--Select Product--</option> 

                                            @foreach (var item in Items)
                                            {
                                                <option value="@item.Id">
                                                    @item.ItemCode - @item.ItemName
                                                </option>
                                            }

                                        </select>


                                    </td>

                                    <td>
                                        <select class="form-select form-select-sm"
                                                @bind="line.UnitId">

                                            <option value="">--Select Unit--</option>

                                            @foreach (var u in Units)
                                            {
                                                <option value="@u.Id">
                                                    @u.UnitName (@u.Symbol)
                                                </option>
                                            }

                                        </select>

                                    </td>

                                    
                                    <td>

                                        <input class="form-control form-control-sm text-end"
                                               @bind="line.Quantity" type="number" min="1"
                                               @oninput="Recalculate" />

                                    </td>

                                    <td>

                                        <input class="form-control form-control-sm text-end"
                                               @bind="line.Rate" type="number" min="0"
                                        @oninput="Recalculate" />

                                    </td>


                                    <td>
                                        <select class="form-select form-select-sm"
                                                @bind="line.TaxPercentage">

                                            <option value="">--Select Tax%--</option>

                                            @foreach (var t in Taxes)
                                            {
                                                <option value="@t.Percentage">
                                                    @t.DisplayName
                                                </option>
                                            }

                                        </select>

                                    </td>

                                    <td class="text-end">

                                        @line.TotalAmount.ToString("N2")

                                    </td>

                                    <td class="text-center">

                                        <button class="btn btn-sm btn-outline-secondary me-1"
                                        @onclick="() => Duplicate(line)">
                                            <i class="ti ti-copy"></i>
                                        </button>

                                        <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => Delete(line)">
                                            <i class="ti ti-trash"></i>
                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <!-- MOBILE VIEW -->

                <div class="mobile-only">

                    @foreach (var line in Model.Items)
                    {
                        <div class="mobile-card">

                            <!-- LINE NUMBER -->
                            <div class="mobile-row">
                                <div class="mobile-label">Line</div>
                                <div class="mobile-value fw-semibold">
                                    #@(Model.Items.IndexOf(line) + 1)
                                </div>
                            </div>

                            <!-- ITEM -->
                            <div class="mobile-row">
                                <div class="mobile-label">Item</div>
                                <div class="mobile-value">

                                    <select class="form-select form-select-sm"
                                            @bind="line.ItemId"
                                            @bind:after="() => OnItemChanged(line)">

                                        <option value="">--Select Product--</option>

                                        @foreach (var item in Items)
                                        {
                                            <option value="@item.Id">
                                                @item.ItemCode - @item.ItemName
                                            </option>
                                        }

                                    </select>

                                </div>
                            </div>

                            <!-- UNIT -->
                            <div class="mobile-row">
                                <div class="mobile-label">Unit</div>
                                <div class="mobile-value">

                                    <select class="form-select form-select-sm"
                                            @bind="line.UnitId">

                                        <option value="">--Select Unit--</option>

                                        @foreach (var u in Units)
                                        {
                                            <option value="@u.Id">
                                                @u.UnitName (@u.Symbol)
                                            </option>
                                        }

                                    </select>

                                </div>
                            </div>

                            <!-- QUANTITY -->
                            <div class="mobile-row">
                                <div class="mobile-label">Quantity</div>
                                <div class="mobile-value">

                                    <input class="form-control form-control-sm text-end"
                                           type="number"
                                           min="1"
                                           @bind="line.Quantity"
                                           @oninput="Recalculate" />

                                </div>
                            </div>

                            <!-- RATE -->
                            <div class="mobile-row">
                                <div class="mobile-label">Rate</div>
                                <div class="mobile-value">

                                    <input class="form-control form-control-sm text-end"
                                           type="number"
                                           min="0"
                                           @bind="line.Rate"
                                           @oninput="Recalculate" />

                                </div>
                            </div>

                            <!-- TAX -->
                            <div class="mobile-row">
                                <div class="mobile-label">Tax %</div>
                                <div class="mobile-value">

                                    <select class="form-select form-select-sm"
                                            @bind="line.TaxPercentage"
                                            @bind:after="Recalculate">

                                        <option value="">--Select Tax%--</option>

                                        @foreach (var t in Taxes)
                                        {
                                            <option value="@t.Percentage">
                                                @t.DisplayName
                                            </option>
                                        }

                                    </select>

                                </div>
                            </div>

                            <!-- AMOUNT -->
                            <div class="mobile-row">
                                <div class="mobile-label">Amount</div>
                                <div class="mobile-value fw-semibold text-end">
                                    @line.TotalAmount.ToString("N2")
                                </div>
                            </div>

                            <!-- ACTIONS -->
                            <div class="mobile-actions">

                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => Duplicate(line)">
                                    <i class="ti ti-copy"></i>
                                </button>

                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => Delete(line)">
                                    <i class="ti ti-trash"></i>
                                </button>

                            </div>

                        </div>
                    }

                </div>
            </div>

        </div>

        <!-- GLOBAL DISCOUNT -->

        <div class="card mt-3">

            <div class="card-body">

                <div class="form-check mb-3">

                    <input class="form-check-input"
                           type="checkbox"
                           id="applyDiscount"
                           @bind="Model.ApplyDiscount"
                           @bind:after="OnDiscountToggle" />

                    <label class="form-check-label fw-semibold"
                           for="applyDiscount">

                        Add discount to all items

                    </label>

                </div>

                @if (Model.ApplyDiscount)
                {
                    <div class="row">

                        <div class="col-md-3">

                            <label class="form-label">
                                Discount Percentage (%)
                            </label>

                            <input type="number"
                                   class="form-control"
                                   min="0"
                                   max="100"
                                   step="0.01"
                                   @bind="Model.Discount"
                                   @oninput="OnDiscountChanged" />

                        </div>

                    </div>
                }

            </div>

        </div>
        <!-- TOTALS BAR -->

        <div class="card mt-3">

            <div class="card-body d-flex justify-content-between align-items-center totals-bar">

                <div class="totals-left">

                    <span class="me-4">
                        Subtotal:
                        <b>@Model.SubTotal.ToString("N2")</b>
                    </span>

                    <span class="me-4">
                        Tax:
                        <b>@Model.TaxAmount.ToString("N2")</b>
                    </span>

                    <span class="me-4">
                        Discount:
                        <b>@Model.DiscountAmount.ToString("N2")</b>
                    </span>

                    <span class="badge bg-success-transparent text-success fs-12 px-3 py-2">
                        Total: @Model.GrandTotal.ToString("N2")
                    </span>

                </div>

                <div class="totals-actions">

                    <button class="btn btn-primary"
                    @onclick="SaveQuotation">

                        <i class="ti ti-device-floppy"></i> Save

                    </button>

                </div>

            </div>

        </div>

    </div>
}