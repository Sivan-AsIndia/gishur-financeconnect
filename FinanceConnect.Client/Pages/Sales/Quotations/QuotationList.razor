@page "/quotations"
@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Quotation List</h4>
                    <h6>Manage your quotations</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/quotations/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>Create
                </a>
            </div>
        </div>

        <!-- Card -->
        <div class="card">

            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

                <!-- Search -->
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset">
                            <i class="ti ti-search"></i>
                        </span>

                        <input type="search"
                               class="form-control form-control-sm"
                               placeholder="Search quotation"
                               @bind="searchText"
                               @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display:flex" class="gap-2">

                    <!-- Company Filter -->
                    <div>
                        <select class="form-select form-select-sm"
                                style="min-width: 180px"
                                @bind="SelectedCompany">
                            <option value="">All Companies</option>
                            @foreach (var c in Companies)
                            {
                                <option value="@c.Id">@c.LegalName</option>
                            }
                        </select>
                    </div>

                    <!-- Client Filter -->
                    <div>
                        <select class="form-select form-select-sm"
                                style="min-width:180px"
                                @bind="SelectedCustomers">
                            <option value="">All Customers</option>

                            @foreach (var c in Customers)
                            {
                                <option value="@c.Id">@c.CustomerName</option>
                            }
                        </select>
                    </div>

                    <!-- Status Filter -->
                    <div>
                        <select class="form-select form-select-sm"
                                style="min-width:140px"
                                @bind="SelectedStatus">

                            <option value="">All Status</option>

                            @foreach (var status in Enum.GetValues<QuotationStatus>())
                            {
                                <option value="@status">@status</option>
                            }

                        </select>
                    </div>


                </div>

            </div>

            <!-- TABLE -->
            <div class="card-body p-0">
                <div class="">
                    <div>
                        <table class="table align-middle w-100 table-fixed">

                            <thead class="thead-light">
                                <tr>

                                    <th class="d-xl-none" style="width:40px"></th>

                                    <th style="width:180px">Quote #</th>
                                    <th class="d-none d-md-table-cell">Subject</th>
                                    <th class="d-none d-md-table-cell">Client</th>
                                    <th class="d-none d-lg-table-cell">Quote Date</th>
                                    <th class="d-none d-xl-table-cell">Valid Until</th>
                                    <th class="d-none d-xl-table-cell">Amount</th>
                                    @* <th style="width:115px" class="d-none d-xxl-table-cell">Status</th> *@

                                    <th style="width:140px">Action</th>

                                </tr>
                            </thead>

                            <tbody>

                                @if (PagedQuotations.Any())
                                {
                                    @foreach (var q in PagedQuotations)
                                    {
                                        <tr>

                                            <!-- Mobile plus -->
                                            <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a class="TablePlus"
                                                       data-bs-toggle="modal"
                                                       data-bs-target="#rowDetailsModal"
                                                       @onclick="() => OpenRowDetails(q)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>

                                            <td class="fw-medium">
                                                <span>
                                                    <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                    <a @onclick="() => ViewQuotation(q)" class="text-decoration-none link-View"
                                                           data-bs-toggle="tooltip"
                                                           data-bs-placement="top"
                                                           title="@q.QuotationNumber details">
                                                        @q.QuotationNumber
                                                    </a>
                                                </span>
                                            </td>

                                            <td class="d-none d-md-table-cell">
                                                @q.Subject
                                            </td>

                                            <td class="d-none d-md-table-cell">
                                                @getCustomerName(q.CustomerId)
                                            </td>

                                            <td class="d-none d-lg-table-cell">
                                                @q.QuotationDate?.ToString("dd-MMM-yyyy")
                                            </td>

                                            <td class="d-none d-xl-table-cell">
                                                @q.ExpiryDate?.ToString("dd-MMM-yyyy")
                                            </td>

                                            <td class="d-none d-xl-table-cell">
                                                ₹@q.GrandTotal.ToString("N0")
                                            </td>

                                            @* <td class="d-none d-xxl-table-cell">
                                    <span class="badge @GetStatusBadge(q.Status)">
                                        @q.Status.GetDisplayName()
                                    </span>
                                </td> *@

                                            <!-- ACTION -->
                                            <td class="action-table-data">

                                                <div class="edit-delete-action">

                                                    <a class="me-2 edit-icon p-1" title="Edit Quote"
                                                           @onclick='() => Nav.NavigateTo($"/quotations/{q.Id}")'>
                                                        <i data-feather="edit"></i>
                                                    </a>

                                                    <a class="p-1 delete-icon"
                                                           title="Delete Quote"
                                                           data-bs-toggle="modal"
                                                           data-bs-target="#delete-modal"
                                                           @onclick="() => ConfirmDelete(q)">
                                                        <i data-feather="trash-2"></i>
                                                    </a>

                                                </div>

                                            </td>

                                        </tr>
                                    }
                                }

                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-4">

                                            <div class="text-muted">
                                                <i class="ti ti-database-off fs-32"></i>
                                                <div>No quotations found</div>
                                            </div>

                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>
                    </div>
                    <!-- Pagination -->
                    @if (PagedQuotations.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center p-3">

                            <div class="d-flex align-items-center fs-13">

                                <span class="me-2">Rows Per Page</span>

                                <select class="form-select form-select-sm w-auto"
                                        @onchange="OnPageSizeChange">

                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>

                                </select>

                            </div>

                            <nav>

                                <ul class="pagination pagination-sm mb-0">

                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link"
                                               href="#"
                                               @onclick="PreviousPage">
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>

                                    @foreach (var p in VisiblePages)
                                    {
                                        <li class="page-item @(p == CurrentPage ? "active" : "")">
                                            <button class="page-link"
                                                    @onclick="() => GoToPage(p)">
                                                @p
                                            </button>
                                        </li>
                                    }

                                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                        <a class="page-link"
                                               href="#"
                                               @onclick="NextPage">
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>

                                </ul>

                            </nav>

                        </div>
                    }

                </div>
            </div>
        </div>

        <!-- delete modal -->
        <div class="modal fade" id="delete-modal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Branch</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDelete)
                                {
                                    <span class="text-danger">Cannot delete this Quote. Postings exist for this branch.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to delete <strong title="@SelectedQuotation?.QuotationNumber">@SelectedQuotation?.QuotationNumber</strong>?</span>
                                }
                            </p>

                            @if (canDelete)
                            {
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                            }
                            <div class="modal-footer-btn mt-3 d-flex justify-content-center">
                                <button type="button" class="btn me-2 btn-outline-secondary fs-13 fw-medium p-2 px-3 shadow-none" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDelete)
                                {
                                    <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteConfirmed" data-bs-dismiss="modal">
                                        <i class="ti ti-trash me-1"></i>Yes, Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Responsive modal -->
        <div class="modal fade list-Popup" id="rowDetailsModal">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title">Quotation Details</h5>

                        <button class="btn-close"
                                data-bs-dismiss="modal"></button>

                    </div>

                    <div class="modal-body">

                        @if (SelectedQuotation != null)
                        {
                            <div class="mb-2 d-flex gap-3">
                                <strong>Subject:</strong>
                                <span>@SelectedQuotation.Subject</span>
                            </div>

                            <div class="mb-2 d-flex gap-3">
                                <strong>Client:</strong>
                                <span>@getCustomerName(SelectedQuotation.CustomerId)</span>
                            </div>

                            <div class="mb-2 d-flex gap-3">
                                <strong>Total:</strong>
                                <span>₹@SelectedQuotation.GrandTotal</span>
                            </div>

                            <div class="mb-2 d-flex gap-3">
                                <strong>Status:</strong>
                                <span class="badge @GetStatusBadge(SelectedQuotation.Status)">
                                    @SelectedQuotation.Status
                                </span>
                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>
    </div>
}
