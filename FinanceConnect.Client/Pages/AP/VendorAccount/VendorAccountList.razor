@page "/vendor-accounts"

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Vendor Account List</h4>
                    <h6>View AP vendor account balances and status</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh Data" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Summary Cards -->
        <div class="row mb-0">
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card  text-white" style="    background: linear-gradient(135deg, #4b2c82, #7b2ff7);">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="mb-1 text-white" style="color: #ffffffcf !important;">Total Payable</h6>
                                <h4 class="mb-0 text-white">@SummaryStats.TotalOutstandingPayable.ToString("N2")</h4>
                            </div>
                            <div class="avatar avatar-lg bg-opacity-25 rounded">
                                <i class="ti ti-currency-rupee fs-24 text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card text-white" style="background: linear-gradient(135deg, #8a2387, #e94057);
        ">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="mb-1 text-white-50" style="color: #ffffffcf !important;">Active Accounts</h6>
                                <h4 class="mb-0 text-white">@SummaryStats.ActiveAccounts</h4>
                            </div>
                            <div class="avatar avatar-lg bg-opacity-25 rounded">
                                <i class="ti ti-users fs-24 text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card text-white" style="background: linear-gradient(135deg, #0f5f6b, #00bcd4);
        ">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="mb-1 text-white-50" style="color: #ffffffcf !important;">Total Advances</h6>
                                <h4 class="mb-0 text-white">@SummaryStats.TotalAdvancePaid.ToString("N2")</h4>
                            </div>
                            <div class="avatar avatar-lg bg-opacity-25 rounded">
                                <i class="ti ti-wallet fs-24 text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card bg-danger text-white" style="background: linear-gradient(135deg, #047857, #34d399);
        ">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="mb-1 text-white-50" style="color: #ffffffcf !important;">Blocked/Frozen</h6>
                                <h4 class="mb-0 text-white">@(SummaryStats.FrozenAccounts + SummaryStats.PaymentBlockedAccounts)</h4>
                            </div>
                            <div class="avatar avatar-lg bg-opacity-25 rounded">
                                <i class="ti ti-lock fs-24 text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vendor Account List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search by vendor code or name..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in AvailableStatuses)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 160px" @bind="SelectedBlockFilter">
                            <option value="">All Accounts</option>
                            <option value="paymentblocked">Payment Blocked</option>
                            <option value="postingblocked">Posting Blocked</option>
                            <option value="notblocked">No Blocks</option>
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 160px" @bind="SelectedBalanceFilter">
                            <option value="">All Balances</option>
                            <option value="outstanding">Has Outstanding</option>
                            <option value="advance">Has Advance</option>
                            <option value="zero">Zero Balance</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <div>
                        <table class="table align-middle w-100 table-fixed">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xl-none" style="width:40px"></th>
                                    <th >Vendor Code</th>
                                    <th class="d-none d-md-table-cell">Vendor Name</th>
                                    @* <th class="d-none d-lg-table-cell" style="width:80px">Currency</th> *@
                                    <th class="d-none d-xl-table-cell text-end" style="width:140px">Payable</th>
                                    <th class="d-none d-xl-table-cell text-end" style="width:140px">Advance</th>
                                    <th class="d-none d-xxl-table-cell text-end" style="width:150px">Net Exposure</th>
                                    <th class="d-none d-md-table-cell" style="width: 210px;">Status</th>
                                    <th style="width:176px">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedAccounts.Any())
                                {
                                    @foreach (var acc in PagedAccounts)
                                    {
                                        <tr>
                                            <!-- PLUS ICON for mobile -->
                                            <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#rowDetailsModal"
                                                   @onclick="() => OpenRowDetails(acc)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td class="fw-medium ">
                                              <span>
                                                    <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                    <a href="/vendor-accounts/@acc.Id/view" class="text-decoration-none link-View"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       title="@acc.VendorCode details">
                                                        @acc.VendorCode
                                                    </a>
                                              </span>
                                            </td>

                                            <td class="d-none d-md-table-cell">
                                                <div>@TruncateName(acc.VendorName, 35)</div>
                                                <span class="badge bg-light text-dark">@acc.CurrencyCode</span>

                                            </td>

                                            @* <td class="d-none d-lg-table-cell">
                                                <span class="badge bg-light text-dark">@acc.CurrencyCode</span>
                                            </td> *@

                                            <td class="d-none d-xl-table-cell text-end">
                                                    <span class="@(acc.OutstandingPayableAmount > 0 ? "text-primary fw-medium" : "text-muted")">
                                                        @* @acc.OutstandingPayableAmount.ToString("N2") *@
                                                        @IndianNumberFormatter.Format(@acc.OutstandingPayableAmount)
                                                    </span>
                                            </td>

                                            <td class="d-none d-xl-table-cell text-end">
                                                @if (acc.AdvancePaidAmount > 0)
                                                {
                                                    <span class="text-success">
                                                        @IndianNumberFormatter.Format(@acc.AdvancePaidAmount)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0.00</span>
                                                }
                                            </td>

                                            <td class="d-none d-xxl-table-cell text-end">
                                                @if (acc.HasAdvanceSurplus)
                                                {
                                                    <span class="badge bg-success-transparent text-success">
                                                        Surplus:  @IndianNumberFormatter.Format(@acc.AdvanceSurplusAmount)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="@(acc.NetExposureAmount > 0 ? "text-warning" : "text-muted")">
                                                        @* @acc.NetExposureAmount.ToString("N2") *@
                                                        @IndianNumberFormatter.Format(@acc.NetExposureAmount)
                                                    </span>
                                                }
                                            </td>

                                            @* <td class="d-none d-md-table-cell" style="text-overflow:inherit">
                                                <span class="badge @GetStatusBadgeClass(acc.AccountStatus)">@acc.AccountStatus</span>
                                                @if (acc.IsPaymentBlocked)
                                                {
                                                    <span class="badge bg-danger ms-1" title="@acc.PaymentBlockReason">
                                                        <i class="ti ti-credit-card-off"></i>
                                                    </span>
                                                }
                                                @if (acc.IsPostingBlocked)
                                                {
                                                    <span class="badge bg-warning ms-1" title="@acc.PostingBlockReason">
                                                        <i class="ti ti-lock"></i>
                                                    </span>
                                                }
                                            </td> *@


                                            <td class="d-none d-md-table-cell">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="ActiveDot @GetStatusDotBadgeClass(acc.AccountStatus)">
                                                    </div>
                                                    <span>@acc.AccountStatus</span>
                                                </div>
                                                @if (acc.AccountStatus != VendorAccountStatuses.Frozen)
                                                {
                                                    @if (acc.IsPaymentBlocked)
                                                    {
                                                        <span class="badge bg-danger ms-1" title="@acc.PaymentBlockReason" data-bs-toggle="tooltip"
                                                              data-bs-placement="top">
                                                            <i class="ti ti-credit-card-off"></i>
                                                        </span>
                                                    }
                                                    @if (acc.IsPostingBlocked)
                                                    {
                                                        <span class="badge bg-warning ms-1" title="@acc.PostingBlockReason" data-bs-toggle="tooltip"
                                                              data-bs-placement="top">
                                                            <i class="ti ti-lock"></i>
                                                        </span>
                                                    }
                                                }
                                            </td>


                                            <td class="action-table-data" style="text-overflow:inherit">
                                                <div class="edit-delete-action  gap-2">
                                                    <a class="p-1 action-icon view-icon" href="/vendor-accounts/@acc.Id/view"
                                                       title="View Details">
                                                        <i class="ti ti-eye"></i>
                                                    </a>
                                                    @if (!acc.IsBlocked && acc.AccountStatus == VendorAccountStatuses.Active)
                                                    {
                                                        <a class="me-2 p-1 action-icon activate-icon" href="javascript:void(0);"
                                                           title="Freeze Account" data-bs-toggle="modal" data-bs-target="#freeze-modal"
                                                           @onclick="() => OpenFreezeModal(acc)">
                                                            <i class="ti ti-lock"></i>
                                                        </a>
                                                    }
                                                    @if (acc.IsBlocked || acc.AccountStatus == VendorAccountStatuses.Frozen)
                                                    {
                                                        <a class="me-2 p-1 action-icon deactivate-icon" href="javascript:void(0);"
                                                           title="Unfreeze Account" data-bs-toggle="modal" data-bs-target="#unfreeze-modal"
                                                           @onclick="() => ConfirmUnfreeze(acc)">
                                                            <i class="ti ti-lock-open"></i>
                                                        </a>
                                                    }
                                                  
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@VisibleColumnCount" class="text-center py-4">
                                            <div class="text-muted">
                                                <i class="ti ti-database-off fs-24 d-block mb-2"></i>
                                                No vendor accounts found
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                        <div class="d-flex align-items-center">
                            <span class="me-2">Rows per page:</span>
                            <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                                <option value="5" selected="@(PageSize == 5)">5</option>
                                <option value="10" selected="@(PageSize == 10)">10</option>
                                <option value="25" selected="@(PageSize == 25)">25</option>
                                <option value="50" selected="@(PageSize == 50)">50</option>
                            </select>
                            <span class="ms-3 text-muted">
                                Entries
                            </span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = 1; i <= TotalPages; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row Details Modal (Mobile) -->
        <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Account Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                style="padding:0; right:22px; position:absolute;transform:none"></button>
                    </div>
                    <div class="modal-body">
                        @if (SelectedAccount != null)
                        {
                            <div class="mb-2 d-flex gap-3">
                                <strong>Vendor:</strong>
                                <div>@SelectedAccount.VendorCode</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Name:</strong>
                                <div>@SelectedAccount.VendorName</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Currency:</strong>
                                <div>@SelectedAccount.CurrencyCode</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Outstanding Payable:</strong>
                                <div class="text-primary fw-medium">@SelectedAccount.OutstandingPayableAmount.ToString("N2")</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Advance Paid:</strong>
                                <div class="text-success">@SelectedAccount.AdvancePaidAmount.ToString("N2")</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Net Exposure:</strong>
                                <div>@SelectedAccount.NetExposureDisplay</div>
                            </div>
                            <div class="mb-2 gap-3 d-md-none">
                                <strong>Status:</strong>
                                <span class="badge @GetStatusBadgeClass(SelectedAccount.AccountStatus)">
                                    @SelectedAccount.AccountStatus
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Freeze Modal -->
        <div class="modal fade" id="freeze-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                                <i class="ti ti-lock fs-24 text-warning"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Freeze Vendor Account</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to freeze account for <strong>@SelectedAccount?.VendorName</strong>
                            </p>
                            <p class="text-muted small mt-1">
                                This will block both payments and posting for this vendor account.
                            </p>
                            <div class="mt-3 text-start">
                                <label class="form-label">Reason <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="3" @bind="freezeReasonInput"
                                          placeholder="Enter reason for freezing account (e.g., Bank verification pending, Dispute under review)..."></textarea>
                            </div>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="FreezeConfirmed" data-bs-dismiss="modal"><i class="ti ti-lock me-1"></i>Yes, Freeze</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Unfreeze Modal -->
        <div class="modal fade" id="unfreeze-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-lock-open fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Unfreeze Vendor Account</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to unfreeze the account for <strong>@SelectedAccount?.VendorName</strong>?
                            </p>
                            <p class="text-muted small mt-1">
                                This will remove all blocks and allow payments and posting.
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="UnfreezeConfirmed" data-bs-dismiss="modal"><i class="ti ti-lock-open me-1"></i>Yes, Unfreeze</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

}
