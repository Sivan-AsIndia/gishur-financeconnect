@page "/vendor-bills"

@inject VendorBillService BillService
@inject NavigationManager Navigation
@inject ToastService ToastService

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Vendor Bill List</h4>
                    <h6>Manage your AP vendor bills</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/vendor-bills/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Statistics Cards -->

        <div class="row mb-0">
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #fe9f43, #db6c00) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Total</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.TotalBills</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-white rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-file-invoice" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #092c4c, #00396e) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Draft</h6>
                                <h5 class="mb-0 fw-bold text-secondary text-white">@Statistics.DraftBills</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-secondary rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-file-text text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #155eef, #002e8b) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Posted</h6>
                                <h5 class="mb-0 fw-bold text-info text-white">@Statistics.PostedBills</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-info rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-send text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #3eb780, #008146) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Paid</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.PaidBills</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-success rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-circle-check text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #ff0000, #d10000) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Overdue</h6>
                                <h5 class="mb-0 fw-bold text-danger text-white">@Statistics.OverdueBills</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-danger rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-alert-triangle text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #00b9a0, #00aba0) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Outstanding</h6>
                                <h5 class="mb-0 fw-bold text-warning text-white" style="font-size: 14px;">@Statistics.TotalOutstandingAmount.ToString("N0")</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-warning rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-currency-rupee text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>


        <!-- Bill List -->
        <div class="card">
            <div class="card-header d-flex align-items-end justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search by bill no, vendor, invoice no..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px;    align-items: end;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedBillType">
                            <option value="">All Types</option>
                            @foreach (var type in DistinctBillTypes)
                            {
                                <option value="@type">@BillTypes.GetDisplayName(type)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in DistinctStatuses)
                            {
                                <option value="@status">@VendorBillStatuses.GetDisplayName(status)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2 filter-date">
                        <label class="form-label">From</label>
                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="FromDate" title="From Date" />
                    </div>
                    <div class="ms-2 filter-date">
                        <label class="form-label">To</label>
                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="ToDate" title="To Date" />
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <div>
                        <table class="table align-middle w-100 table-fixed">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xl-none" style="width:40px"></th>
                                    <th style="width:200px">Bill No</th>
                                    <th class="d-none d-md-table-cell">Vendor</th>
                                    <th class="d-none d-xl-table-cell" title="Vendor Invoice" style="width:160px">Invoice</th>
                                    <th class="d-none d-xl-table-cell" title="Bill Date" style="width:110px">Date</th>
                                    @* <th class="d-none d-xl-table-cell" title="Due Date" style="width:100px">Due Date</th> *@
                                    @* <th class="d-none d-xl-table-cell text-end" style="width: 116px;">Amount</th> *@
                                    <th class="d-none d-xxl-table-cell text-end" title="Outstanding" style="width:140px">Outstanding</th>
                                    <th class="d-none d-md-table-cell" style="width:100px">Status</th>
                                    <th style="width:170px">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedBills.Any())
                                {
                                    @foreach (var bill in PagedBills)
                                    {
                                        <tr>
                                            <!-- PLUS ICON -->
                                            <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#rowDetailsModal"
                                                   @onclick="() => OpenRowDetails(bill)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td class="fw-medium">
                                                <span>
                                                    <i class="ti ti-external-link me-2 PopupIcon"></i>

                                                    <a href="/vendor-bills/@bill.Id/view" class="text-decoration-none link-View"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       title="@bill.BillNumber details">
                                                        @bill.BillNumber
                                                    </a>
                                                </span>
                                            </td>

                                            <td class="d-none d-md-table-cell">
                                                <div class="fw-medium">@bill.VendorCode</div>
                                                <small class="text-muted" title="VendorName">@bill.VendorName</small>
                                            </td>

                                            <td class="d-none d-xl-table-cell">
                                                @bill.VendorInvoiceNumber
                                            </td>

                                            <td class="d-none d-xl-table-cell">
                                                @bill.BillDate.ToString("dd-MMM-yy")
                                            </td>

                                            @* <td title="@bill.DueDate.ToString("dd-MMM-yy")" class="d-none d-xl-table-cell @(IsOverdue(bill) ? "text-danger fw-medium" : "")">
                                                @bill.DueDate.ToString("dd-MMM-yy")
                                                @if (IsOverdue(bill))
                                                {
                                                    <i class="ti ti-alert-circle ms-1" title="Overdue"></i>
                                                }
                                            </td> *@

                                            @* <td class="d-none d-xl-table-cell text-end fw-medium">
                                                @IndianNumberFormatter.Format(bill.GrandTotalAmount)
                                            </td> *@

                                            <td class="d-none d-xxl-table-cell text-end @(bill.OutstandingAmount > 0 ? "text-danger fw-medium" : "text-success")">
                                                @IndianNumberFormatter.Format(bill.OutstandingAmount)

                                            </td>

                                            <td class="d-none d-md-table-cell">
                                                <span class="badge @GetStatusBadgeClass(bill.BillStatus)"
                                                      data-bs-toggle="tooltip"
                                                      title="@VendorBillStatuses.GetDisplayName(bill.BillStatus)">

                                                    <i class="@GetStatusIcon(bill.BillStatus)"></i>
                                                </span>
                                            </td>


                                            <td class="action-table-data">
                                                <div class="edit-delete-action">
                                                    @if (bill.CanEdit)
                                                    {
                                                        <a class="me-2 edit-icon p-1" href="/vendor-bills/@bill.Id" title="Edit">
                                                            <i data-feather="edit"></i>
                                                        </a>
                                                    }
                                                    @if (bill.CanPost)
                                                    {
                                                        <a class="me-2 p-1 action-icon Reissue" href="javascript:void(0);"
                                                           title="Post Bill" data-bs-toggle="modal" data-bs-target="#postModal"
                                                           @onclick="() => OpenPostModal(bill)">
                                                            <i class="ti ti-send "></i>
                                                        </a>
                                                    }
                                                    @if (bill.CanCancel)
                                                    {
                                                        <a class="me-2 p-1 action-icon Bounce" href="javascript:void(0);"
                                                           title="Cancel Bill" data-bs-toggle="modal" data-bs-target="#cancelModal"
                                                           @onclick="() => OpenCancelModal(bill)">
                                                            <i class="ti ti-ban"></i>
                                                        </a>
                                                    }
                                                    @if (bill.BillStatus == VendorBillStatuses.Draft)
                                                    {
                                                        <a class="p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                                           data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                           @onclick="() => OpenDeleteModal(bill)">
                                                            <i data-feather="trash-2"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@VisibleColumnCount" class="text-center py-4">
                                            <div class="text-muted">
                                                <i class="ti ti-file-off fs-1"></i>
                                                <p class="mt-2">No vendor bills found</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Pagination -->
            <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                <div class="d-flex align-items-center">
                    <span class="me-2">Rows per page:</span>
                    <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                        <option value="5" selected="@(PageSize == 5)">5</option>
                        <option value="10" selected="@(PageSize == 10)">10</option>
                        <option value="25" selected="@(PageSize == 25)">25</option>
                        <option value="50" selected="@(PageSize == 50)">50</option>
                    </select>
                    <span class="ms-3 text-muted">
                        Entries
                    </span>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(CurrentPage - 1)">
                                <i class="ti ti-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(CurrentPage + 1)">
                                <i class="ti ti-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
}

<!-- Post Modal -->
<div class="modal fade" id="postModal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                        <i class="ti ti-send fs-24 text-success"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Post Vendor Bill</h4>
                    <p class="text-gray-6 mb-0 fs-16">
                        Are you sure you want to post <strong>@SelectedBill?.BillNumber</strong>?
                    </p>
                    <div class="alert alert-warning mt-3 text-start small">
                        <i class="ti ti-alert-triangle me-2"></i>
                        Once posted, the bill cannot be edited. This will create GL entries.
                    </div>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="PostBill" data-bs-dismiss="modal"><i class="ti ti-check me-1"></i>Yes, Post</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                        <i class="ti ti-ban fs-24 text-warning"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Cancel Vendor Bill</h4>
                    <p class="text-gray-6 mb-0 fs-16">
                        Are you sure you want to Cancel bill <strong>@SelectedBill?.BillNumber</strong>
                    </p>
                    <div class="mt-3 text-start">
                        <label class="form-label">Cancellation Reason <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" @bind="CancellationReason" placeholder="Enter reason for cancelling this bill..."></textarea>
                    </div>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Close</button>
                        <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="CancelBill" data-bs-dismiss="modal"><i class="ti ti-ban me-1"></i>Yes, Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                        <i class="ti ti-trash fs-24 text-danger"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Vendor Bill</h4>
                    <p class="text-gray-6 mb-0 fs-16">
                        Are you sure you want to delete <strong>@SelectedBill?.BillNumber</strong>?
                    </p>
                    <div class="alert alert-danger mt-3 text-start small">
                        <i class="ti ti-alert-triangle me-2"></i>
                        This action cannot be undone.
                    </div>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteBill" data-bs-dismiss="modal"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Row Details Modal (Mobile) -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1" aria-labelledby="rowDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rowDetailsModalLabel">Bill Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="    padding: 0;
    right: 22px;
    position: absolute;
    transform: none;"></button>
            </div>
            <div class="modal-body">
                @if (SelectedBill != null)
                {

                    <div class="mb-2 d-flex gap-3">
                        <!--!--><strong>Bill No:</strong>
                        <div>@SelectedBill.BillNumber</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <!--!--><strong>Vendor:</strong>
                        <div>@SelectedBill.VendorCode - @SelectedBill.VendorName</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <!--!--><strong>Vendor Invoice:</strong>
                        <div>@SelectedBill.VendorInvoiceNumber</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <!--!--><strong>Type:</strong>
                        <div><span class="badge @GetTypeBadgeClass(SelectedBill.BillType)">@BillTypes.GetDisplayName(SelectedBill.BillType)</span></div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <!--!--><strong>Bill Date:</strong>
                        <div>@SelectedBill.BillDate.ToString("dd-MMM-yyyy")</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <!--!--><strong>Due Date:</strong>
                        <div class="@(IsOverdue(SelectedBill) ? "text-danger fw-medium" : "")">
                            @SelectedBill.DueDate.ToString("dd-MMM-yyyy")
                            @if (IsOverdue(SelectedBill))
                            {
                                <span class="ms-1">(Overdue)</span>
                            }
                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <!--!--><strong>Amount:</strong>
                        <div>@SelectedBill.CurrencyCode @SelectedBill.GrandTotalAmount.ToString("N2")</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <!--!--><strong>Outstanding:</strong>
                        <div class="@(SelectedBill.OutstandingAmount > 0 ? "text-danger fw-medium" : "text-success")">
                            @SelectedBill.CurrencyCode @SelectedBill.OutstandingAmount.ToString("N2")
                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <!--!--><strong>Status:</strong>
                        <div>
                            <span class="badge @GetStatusBadgeClass(SelectedBill.BillStatus)">@VendorBillStatuses.GetDisplayName(SelectedBill.BillStatus)</span>
                        </div>
                    </div>
                }
            </div>
            @* <div class="modal-footer">
                <a href="/vendor-bill/@SelectedBill?.Id" class="btn btn-primary">
                    <i class="ti ti-eye me-1"></i> View Details
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Close</button>
            </div> *@
        </div>
    </div>
</div>
