@page "/vendors/create"
@page "/vendors/{Id:guid}"

<style>
    .form-select option:checked {
        color: #fff;
        background: var(--primary);
    }

    .form-select:focus {
        border-color: var(--primary);
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }

    .attachment-card {
        border: 1px solid #e5e9f2;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 10px;
        background: #fafbfc;
    }

    .attachment-card:hover {
        background: #f0f4f8;
    }

    .attachment-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        background: linear-gradient(135deg, var(--primary), var(--primary));
        color: white;
    }

    .attachment-info {
        flex: 1;
        margin-left: 12px;
    }

    .attachment-info .file-name {
        font-weight: 600;
        font-size: 14px;
        color: #333;
    }

    .attachment-info .file-meta {
        font-size: 12px;
        color: #6b7280;
    }

    .attachment-actions {
        display: flex;
        gap: 8px;
    }

    @@media(max-width:1395px) and (min-width:1200px){
        #AttachmentsDta{
            flex-wrap:wrap;
        }

            #AttachmentsDta .col-md-4{
                  width: 100%;
            }
            #AttachmentsDta .col-md-5{
                  width: 100%;
            }
            #AttachmentsDta .col-md-3{
                  width: 100%;
            }
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    <div class="content form-wizard">
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">@PageTitle</h4>
                    <h6>@PageSubTitle</h6>
                </div>
            </div>

            <div class="d-flex page-btn mt-0 gap-2">
                @if(IsEdit){
                <button type="button" class="btn btn-primary" @onclick="Save"> <i class="ti ti-device-floppy"></i> @(IsEdit ? "Update" : "Save")</button>

                }
              
                <a href="/vendors" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left me-1"></i>    Back
                </a>
            </div>
        </div>

        <div class="wizard-overlay d-flex mb-4">
            <EditForm EditContext="editContext" OnSubmit="Save" style="width: 100%;">

                <div class="wizard-overlay">
                    <div class="wizard-modal">

                        <!-- LEFT STEPPER -->
                        <div class="wizard-steps">
                            <div class="timeline-line"></div>
                            <div class="timeline-indicator @(IsCurrentStepValid() ? "success" : "error")"
                                 style="top:@IndicatorToppx"></div>

                            @for (int i = 1; i <= Steps.Count; i++)
                            {
                                <div class="wizard-step @StepClass(i)">
                                    <div class="dot">
                                        @if (i < CurrentStep)
                                        {
                                            <i class="ti ti-check" style="color: white; font-size: 22px;"></i>
                                        }
                                        else
                                        {
                                            <i class="@Steps[i - 1].Icon"></i>
                                        }
                                    </div>
                                    <div class="label">
                                        <b>@Steps[i - 1].Title</b>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- RIGHT CONTENT -->
                        <div class="wizard-content">
                            <h2 style="font-size: 17px; margin-bottom: 10px;">
                                @Steps[CurrentStep - 1].Title
                            </h2>

                            @* Step 1: Vendor Identity *@
                            @if (CurrentStep == 1)
                            {
                                <div id="vendorIdentity" class="accordion-collapse collapse show">
                                    <div class="accordion-body border-top pt-3 p-0">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Vendor Code <span class="text-danger ms-1">*</span></label>
                                                <InputText class="@($"form-control text-uppercase {(ShowFieldError(1, "VendorCode") ? "is-invalid" : "")}")"
                                                           @bind-Value="Vendor.VendorCode" @bind-Value:after="OnVendorCodeChanged"
                                                           disabled="@IsEdit" placeholder="e.g., VND-000001" maxlength="30" title="Unique code for the vendor" />
                                                @if (ShowFieldError(1, "VendorCode"))
                                                {
                                                    <div class="text-danger small mt-1">Vendor Code is required</div>
                                                }
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Vendor Name (Trade) <span class="text-danger ms-1">*</span></label>
                                                <InputText class="@($"form-control {(ShowFieldError(1, "VendorName") ? "is-invalid" : "")}")"
                                                           @bind-Value="Vendor.VendorName" @bind-Value:after="OnVendorNameChanged"
                                                           placeholder="e.g., Tech Components India Pvt Ltd" maxlength="200" title="Trade name of the vendor" />
                                                @if (ShowFieldError(1, "VendorName"))
                                                {
                                                    <div class="text-danger small mt-1">Vendor Name is required</div>
                                                }
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Legal Name</label>
                                                <InputText class="form-control" @bind-Value="Vendor.LegalName"
                                                           placeholder="e.g., Tech Components India Private Limited" maxlength="250" title="Official legal name of the vendor" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Vendor Type <span class="text-danger ms-1">*</span></label>
                                                <InputSelect class="@($"form-select {(ShowFieldError(1, "VendorType") ? "is-invalid" : "")}")" @bind-Value="Vendor.VendorType" title="Type of vendor">
                                                    <option value="">--Select Vendor Type--</option>
                                                    @foreach (var type in VendorTypes.All)
                                                    {
                                                        <option value="@type">@VendorTypes.GetDisplayName(type)</option>
                                                    }
                                                </InputSelect>
                                                @if (ShowFieldError(1, "VendorType"))
                                                {
                                                    <div class="text-danger small mt-1">Vendor Type is required</div>
                                                }
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Vendor Category</label>
                                                <InputSelect class="form-select" @bind-Value="Vendor.VendorCategoryId" title="Vendor category for reporting">
                                                    <option value="">--Select Vendor Category--</option>
                                                    @foreach (var cat in VendorCategories)
                                                    {
                                                        <option value="@cat.Id">@cat.Name</option>
                                                    }
                                                </InputSelect>
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Status <span class="text-danger ms-1">*</span></label>
                                                <InputSelect class="form-select" @bind-Value="Vendor.VendorStatus"
                                                             @oninput="OnStatusChange" title="Vendor status">
                                                    <option value="">--Select Vendor Status--</option>
                                                    @foreach (var status in VendorStatuses.All)
                                                    {
                                                        <option value="@status">@VendorStatuses.GetDisplayName(status)</option>
                                                    }
                                                </InputSelect>
                                            </div>

                                            @if (Vendor.VendorStatus == VendorStatuses.OnHold)
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Hold Reason <span class="text-danger ms-1">*</span></label>
                                                    <InputTextArea class="@($"form-control {(ShowFieldError(1, "HoldReason") ? "is-invalid" : "")}")"
                                                                   @bind-Value="Vendor.HoldReason"
                                                                   rows="2" placeholder="Enter reason for hold..." maxlength="250" title="Reason for placing vendor on hold" />
                                                    @if (ShowFieldError(1, "HoldReason"))
                                                    {
                                                        <div class="text-danger small mt-1">Hold Reason is required when vendor is on hold</div>
                                                    }
                                                </div>
                                            }

                                            @if (Vendor.VendorStatus == VendorStatuses.Blacklisted)
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Blacklist Reason <span class="text-danger ms-1">*</span></label>
                                                    <InputTextArea class="@($"form-control {(ShowFieldError(1, "BlacklistReason") ? "is-invalid" : "")}")"
                                                                   @bind-Value="Vendor.BlacklistReason"
                                                                   rows="2" placeholder="Enter reason for blacklisting..." maxlength="250" title="Reason for blacklisting vendor" />
                                                    @if (ShowFieldError(1, "BlacklistReason"))
                                                    {
                                                        <div class="text-danger small mt-1">Blacklist Reason is required when vendor is blacklisted</div>
                                                    }
                                                </div>
                                            }

                                            <div class="col-12 mb-3">
                                                <label class="form-label">Notes</label>
                                                <RichTextEditor @ref="notesEditor" Value="@Vendor.Notes" Placeholder="Additional notes about the vendor..." MinHeight="60" MaxHeight="150" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Step 2: Address & Contacts *@
                            @if (CurrentStep == 2)
                            {
                                <div id="addressContacts" class="accordion-collapse">
                                    <div class="accordion-body border-top pt-3 p-0">
                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label class="form-label">Registered Address Line 1</label>
                                                <InputText class="form-control" @bind-Value="Vendor.RegisteredAddressLine1"
                                                           placeholder="e.g., 123, Industrial Estate" maxlength="200" title="First line of registered address" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Address Line 2</label>
                                                <InputText class="form-control" @bind-Value="Vendor.RegisteredAddressLine2"
                                                           placeholder="e.g., SIPCOT Phase II" maxlength="200" title="Second line of address" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Address Line 3</label>
                                                <InputText class="form-control" @bind-Value="Vendor.RegisteredAddressLine3"
                                                           placeholder="e.g., Near Main Road" maxlength="200" title="Third line of address" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">City</label>
                                                <InputText class="form-control" @bind-Value="Vendor.City"
                                                           placeholder="e.g., Chennai" maxlength="100" title="City" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">State</label>
                                                <InputSelect class="form-select" @bind-Value="Vendor.StateId" title="State/Province">
                                                    <option value="">--Select State--</option>
                                                    @foreach (var state in States)
                                                    {
                                                        <option value="@state.Id">@state.StateProvinceName</option>
                                                    }
                                                </InputSelect>
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Country <span class="text-danger ms-1">*</span></label>
                                                <InputSelect class="@($"form-select {(ShowFieldError(2, "CountryId") ? "is-invalid" : "")}")" @bind-Value="Vendor.CountryId" title="Country">
                                                    <option value="">--Select Country--</option>
                                                    @foreach (var country in Countries)
                                                    {
                                                        <option value="@country.Id">@country.CountryName</option>
                                                    }
                                                </InputSelect>
                                                @if (ShowFieldError(2, "CountryId"))
                                                {
                                                    <div class="text-danger small mt-1">Country is Required</div>
                                                }
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Postal Code</label>
                                                <InputText class="form-control" @bind-Value="Vendor.PostalCode"
                                                           placeholder="e.g., 600001" maxlength="12" title="Postal code" />
                                            </div>

                                            <hr class="my-3" />
                                            <h6 class="mb-3">Contact Information</h6>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Primary Contact Name</label>
                                                <InputText class="form-control" @bind-Value="Vendor.PrimaryContactName"
                                                           placeholder="e.g., John Smith" maxlength="150" title="Primary contact person name" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Primary Email</label>
                                                <InputText class="form-control" @bind-Value="Vendor.PrimaryEmail"
                                                           type="email" placeholder="e.g., contact@vendor.com" maxlength="150" title="Primary email address" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Primary Phone</label>
                                                <InputText class="form-control" @bind-Value="Vendor.PrimaryPhone"
                                                           placeholder="e.g., +91-9876543210" maxlength="20" title="Primary phone number" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Alternate Phone</label>
                                                <InputText class="form-control" @bind-Value="Vendor.AlternatePhone"
                                                           placeholder="e.g., +91-4412345678" maxlength="20" title="Alternate phone number" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Remittance Email</label>
                                                <InputText class="form-control" @bind-Value="Vendor.RemittanceEmail"
                                                           type="email" placeholder="e.g., remittance@vendor.com" maxlength="150" title="Email for remittance advice" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Step 3: Compliance (GST/PAN/TDS) *@
                            @if (CurrentStep == 3)
                            {
                                <div id="compliance" class="accordion-collapse">
                                    <div class="accordion-body border-top pt-3 p-0">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <div class="form-check mt-2">
                                                    <InputCheckbox class="form-check-input" @bind-Value="Vendor.IsGSTRegistered" id="gstRegistered" />
                                                    <label class="form-check-label" for="gstRegistered">GST Registered?</label>
                                                </div>
                                            </div>

                                            @if (Vendor.IsGSTRegistered)
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">GSTIN <span class="text-danger ms-1">*</span></label>
                                                    <InputText class="@($"form-control text-uppercase {(ShowFieldError(3, "GSTIN") ? "is-invalid" : "")}")"
                                                               @bind-Value="Vendor.GSTIN"
                                                               placeholder="e.g., 33AAAAA9999A1Z5" maxlength="15" title="15-digit GST Identification Number" />
                                                    @if (ShowFieldError(3, "GSTIN"))
                                                    {
                                                        <div class="text-danger small mt-1">GSTIN is required for GST registered vendors</div>
                                                    }
                                                </div>

                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">GST State</label>
                                                    <InputSelect class="form-select" @bind-Value="Vendor.VendorGSTStateId" title="State for GST registration">
                                                        <option value="">--Select GST State--</option>
                                                        @foreach (var state in States)
                                                        {
                                                            <option value="@state.Id">@state.StateProvinceName</option>
                                                        }
                                                    </InputSelect>
                                                </div>
                                            }

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">PAN @(Vendor.IsTDSApplicable ? "*" : "")</label>
                                                <InputText class="@($"form-control text-uppercase {(ShowFieldError(3, "PAN") ? "is-invalid" : "")}")"
                                                           @bind-Value="Vendor.PAN"
                                                           placeholder="e.g., AAAAA9999A" maxlength="10" title="Permanent Account Number" />
                                                @if (ShowFieldError(3, "PAN"))
                                                {
                                                    <div class="text-danger small mt-1">PAN is required when TDS is applicable</div>
                                                }
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">MSME Category</label>
                                                <InputSelect class="form-select" @bind-Value="Vendor.MSMECategory" title="MSME registration category">
                                                    <option value="">--Select MSME Category--</option>
                                                    @foreach (var cat in MSMECategories.All)
                                                    {
                                                        <option value="@cat">@MSMECategories.GetDisplayName(cat)</option>
                                                    }
                                                </InputSelect>
                                            </div>

                                            <hr class="my-3" />
                                            <h6 class="mb-3">TDS / Withholding Configuration</h6>

                                            <div class="col-md-6 mb-3">
                                                <div class="form-check mt-3">
                                                    <InputCheckbox class="form-check-input" @bind-Value="Vendor.IsTDSApplicable" id="tdsApplicable" style="width: auto;" />
                                                    <label class="form-check-label" for="tdsApplicable">TDS Applicable?</label>
                                                </div>
                                            </div>

                                            @if (Vendor.IsTDSApplicable)
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">TDS Section Code <span class="text-danger ms-1">*</span></label>
                                                    <InputSelect class="@($"form-select {(ShowFieldError(3, "TDSSectionCode") ? "is-invalid" : "")}")"
                                                                 @bind-Value="Vendor.TDSSectionCode" title="TDS section code">
                                                        <option value="">--Select TDS Section Code--</option>
                                                        <option value="194C">194C - Contractor</option>
                                                        <option value="194J">194J - Professional/Technical</option>
                                                        <option value="194I">194I - Rent</option>
                                                        <option value="194H">194H - Commission</option>
                                                        <option value="194A">194A - Interest</option>
                                                        <option value="194Q">194Q - Purchase of Goods</option>
                                                    </InputSelect>
                                                    @if (ShowFieldError(3, "TDSSectionCode"))
                                                    {
                                                        <div class="text-danger small mt-1">TDS Section Code is required when TDS is applicable</div>
                                                    }
                                                </div>

                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">TDS Rate (%)</label>
                                                    <InputNumber class="form-control" @bind-Value="Vendor.TDSRatePercent"
                                                                 placeholder="e.g., 2.0" min="0" max="100" step="0.001" title="TDS rate percentage" />
                                                </div>
                                            }

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Residency Type</label>
                                                <InputSelect class="form-select" @bind-Value="Vendor.VendorResidencyType" title="Vendor residency type for withholding">
                                                    <option value="">--Select Residency Type--</option>
                                                    @foreach (var res in VendorResidencyTypes.All)
                                                    {
                                                        <option value="@res">@VendorResidencyTypes.GetDisplayName(res)</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Step 4: Payment & Banking *@
                            @if (CurrentStep == 4)
                            {
                                <div id="paymentBanking" class="accordion-collapse">
                                    <div class="accordion-body border-top pt-3 p-0">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Preferred Payment Method</label>
                                                <InputSelect class="form-select" @bind-Value="Vendor.PreferredPaymentMethod" title="Preferred method of payment">
                                                    <option value="">--Select Payment Method--</option>
                                                    @foreach (var method in VendorPaymentMethods.All)
                                                    {
                                                        <option value="@method">@VendorPaymentMethods.GetDisplayName(method)</option>
                                                    }
                                                </InputSelect>
                                            </div>

                                            <hr class="my-3" />
                                            <h6 class="mb-3">Bank Account Details <small class="text-muted">(Sensitive - Masked in View)</small></h6>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Bank Account Name</label>
                                                <InputText class="form-control" @bind-Value="Vendor.BankAccountName"
                                                           placeholder="e.g., Tech Components India Pvt Ltd" maxlength="150" title="Name as per bank account" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Bank Account Number</label>
                                                <InputText class="form-control" @bind-Value="Vendor.BankAccountNumber"
                                                           placeholder="e.g., 1234567890123456" maxlength="30" title="Bank account number" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">IFSC Code</label>
                                                <InputText class="form-control text-uppercase" @bind-Value="Vendor.IFSC"
                                                           placeholder="e.g., HDFC0001234" maxlength="11" title="11-character IFSC code" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Bank Name</label>
                                                <InputText class="form-control" @bind-Value="Vendor.BankName"
                                                           placeholder="e.g., HDFC Bank" maxlength="150" title="Name of the bank" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Branch Name</label>
                                                <InputText class="form-control" @bind-Value="Vendor.BranchName"
                                                           placeholder="e.g., Chennai Main Branch" maxlength="150" title="Branch name" />
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">UPI ID</label>
                                                <InputText class="form-control" @bind-Value="Vendor.UPIId"
                                                           placeholder="e.g., vendor@upi" maxlength="100" title="UPI ID for payments" />
                                            </div>

                                            @if (IsEdit && Vendor.IsBankVerified)
                                            {
                                                <div class="col-12 mb-3">
                                                    <div class="alert alert-success mb-0">
                                                        <i class="ti ti-check me-2"></i>
                                                        Bank details verified on @Vendor.BankVerifiedOn?.ToString("dd MMM yyyy HH:mm") by @Vendor.BankVerifiedByUserName
                                                    </div>
                                                </div>
                                            }
                                            else if (IsEdit && !string.IsNullOrEmpty(Vendor.BankAccountNumber))
                                            {
                                                <div class="col-12 mb-3">
                                                    <div class="alert alert-warning mb-0">
                                                        <i class="ti ti-alert-triangle me-2"></i>
                                                        Bank details not verified
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Step 5: AP Defaults & Controls *@
                            @if (CurrentStep == 5)
                            {
                                <div id="apDefaults" class="accordion-collapse">
                                    <div class="accordion-body border-top pt-3 p-0">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Default Currency <span class="text-danger ms-1">*</span></label>
                                                <InputSelect class="@($"form-select {(ShowFieldError(5, "DefaultCurrencyId") ? "is-invalid" : "")}")"
                                                             @bind-Value="Vendor.DefaultCurrencyId" title="Default currency for transactions">
                                                    <option value="">--Select Default Currency--</option>
                                                    @foreach (var curr in Currencies)
                                                    {
                                                        <option value="@curr.Id">@curr.CurrencyCode - @curr.CurrencyName</option>
                                                    }
                                                </InputSelect>
                                                @if (ShowFieldError(5, "DefaultCurrencyId"))
                                                {
                                                    <div class="text-danger small mt-1">Default Currency is required</div>
                                                }
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Payment Terms</label>
                                                <InputSelect class="form-select" @bind-Value="Vendor.PaymentTermsId" title="Default payment terms">
                                                    <option value="">--Select Payment Terms--</option>
                                                    @foreach (var term in PaymentTerms)
                                                    {
                                                        <option value="@term.Id">@term.Name</option>
                                                    }
                                                </InputSelect>
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">AP Control Account <span class="text-danger ms-1">*</span></label>
                                                <InputSelect class="@($"form-select {(ShowFieldError(5, "DefaultPayableAccountId") ? "is-invalid" : "")}")"
                                                             @bind-Value="Vendor.DefaultPayableAccountId" title="Default Accounts Payable GL account">
                                                    <option value="">--Select AP Control Account--</option>
                                                    @foreach (var acc in GLAccounts.Where(a => a.AccountCode.StartsWith("2")))
                                                    {
                                                        <option value="@acc.Id">@acc.AccountCode - @acc.AccountName</option>
                                                    }
                                                </InputSelect>
                                                @if (ShowFieldError(5, "DefaultPayableAccountId"))
                                                {
                                                    <div class="text-danger small mt-1">AP Control Account is required</div>
                                                }
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Vendor Advance Account</label>
                                                <InputSelect class="form-select" @bind-Value="Vendor.AdvanceToVendorAccountId" title="GL account for vendor advances">
                                                    <option value="">--Select Vendor Advance Account--</option>
                                                    @foreach (var acc in GLAccounts.Where(a => a.AccountCode.StartsWith("1")))
                                                    {
                                                        <option value="@acc.Id">@acc.AccountCode - @acc.AccountName</option>
                                                    }
                                                </InputSelect>
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Default Expense Account</label>
                                                <InputSelect class="form-select" @bind-Value="Vendor.DefaultExpenseAccountId" title="Default expense account for bills">
                                                    <option value="">--Select Default Expense Account--</option>
                                                    @foreach (var acc in GLAccounts.Where(a => a.AccountCode.StartsWith("6") || a.AccountCode.StartsWith("5")))
                                                    {
                                                        <option value="@acc.Id">@acc.AccountCode - @acc.AccountName</option>
                                                    }
                                                </InputSelect>
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Default Tax Profile</label>
                                                <InputSelect class="form-select" @bind-Value="Vendor.DefaultTaxProfileId" title="Default tax profile for bills">
                                                    <option value="">--Select Default Tax Profile--</option>
                                                    @foreach (var tp in TaxProfiles)
                                                    {
                                                        <option value="@tp.Id">@tp.Name</option>
                                                    }
                                                </InputSelect>
                                            </div>

                                            <hr class="my-3" />
                                            <h6 class="mb-3">Blocking Controls</h6>

                                            <div class="col-md-6 mb-3">
                                                <div class="form-check mt-2">
                                                    <InputCheckbox class="form-check-input" @bind-Value="Vendor.IsPaymentBlocked" id="paymentBlocked" style="width: auto;" />
                                                    <label class="form-check-label" for="paymentBlocked">Payment Blocked</label>
                                                </div>
                                            </div>

                                            @if (Vendor.IsPaymentBlocked)
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Payment Block Reason <span class="text-danger ms-1">*</span></label>
                                                    <InputTextArea class="@($"form-control {(ShowFieldError(5, "PaymentBlockReason") ? "is-invalid" : "")}")"
                                                                   @bind-Value="Vendor.PaymentBlockReason"
                                                                   rows="2" placeholder="Enter reason..." maxlength="250" title="Reason for blocking payments" />
                                                    @if (ShowFieldError(5, "PaymentBlockReason"))
                                                    {
                                                        <div class="text-danger small mt-1">Payment Block Reason is required</div>
                                                    }
                                                </div>
                                            }

                                            <div class="col-md-6 mb-3">
                                                <div class="form-check mt-2">
                                                    <InputCheckbox class="form-check-input" @bind-Value="Vendor.IsBillPostingBlocked" id="billPostingBlocked" style="width: auto;" />
                                                    <label class="form-check-label" for="billPostingBlocked">Bill Posting Blocked</label>
                                                </div>
                                            </div>

                                            @if (Vendor.IsBillPostingBlocked)
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Bill Posting Block Reason <span class="text-danger ms-1">*</span></label>
                                                    <InputTextArea class="@($"form-control {(ShowFieldError(5, "BillPostingBlockReason") ? "is-invalid" : "")}")"
                                                                   @bind-Value="Vendor.BillPostingBlockReason"
                                                                   rows="2" placeholder="Enter reason..." maxlength="250" title="Reason for blocking bill posting" />
                                                    @if (ShowFieldError(5, "BillPostingBlockReason"))
                                                    {
                                                        <div class="text-danger small mt-1">Bill Posting Block Reason is required</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Step 6: Attachments (Evidence / KYC) *@
                            @if (CurrentStep == 6)
                            {
                                <div id="attachments" class="accordion-collapse">
                                    <div class="accordion-body border-top pt-3 p-0">
                                        <div class="row">
                                            <div class="col-12 mb-3">
                                                <div class="alert alert-info mb-3">
                                                    <i class="ti ti-info-circle me-2"></i>
                                                    Upload KYC/Evidence documents such as GST Certificate, PAN Copy, Cancelled Cheque, MSME Certificate, or Vendor Agreement.
                                                    <br/><small class="mt-1 d-block"><strong>Allowed formats:</strong> PDF, JPG, JPEG, PNG | <strong>Max size:</strong> 5MB per file</small>
                                                </div>
                                            </div>

                                            <div class="d-flex gap-2 align-items-center" id="AttachmentsDta">
                                            <!-- Add Attachment Form -->
                                            <div class="col-md-4 mb-3">
                                                <label class="form-label">Attachment Type <span class="text-danger ms-1">*</span></label>
                                                <InputSelect class="@($"form-select {(ShowFieldError(6, "NewAttachmentType") ? "is-invalid" : "")}")"
                                                             @bind-Value="NewAttachmentType" title="Type of document">
                                                    <option value="">--Select Attachment Type--</option>
                                                    @foreach (var type in VendorAttachmentTypes.All)
                                                    {
                                                        <option value="@type">@VendorAttachmentTypes.GetDisplayName(type)</option>
                                                    }
                                                </InputSelect>
                                                @if (ShowFieldError(6, "NewAttachmentType"))
                                                {
                                                    <div class="text-danger small mt-1">Attachment Type is required</div>
                                                }
                                            </div>

                                            <div class="col-md-5 mb-3">
                                                <label class="form-label">Select File <span class="text-danger ms-1">*</span></label>
                                                <InputFile @key="fileInputKey" class="@($"form-control {(ShowFieldError(6, "NewAttachmentFile") ? "is-invalid" : "")}")"
                                                           OnChange="OnFileSelected"
                                                           accept=".pdf,.jpg,.jpeg,.png"
                                                           title="Select file to upload" />
                                                @if (ShowFieldError(6, "NewAttachmentFile"))
                                                {
                                                    <div class="text-danger small mt-1">@fileValidationMessage</div>
                                                }
                                                @if (!string.IsNullOrEmpty(selectedFileName))
                                                {
                                                    <div class="text-success small mt-1">
                                                        <i class="ti ti-check me-1"></i>@selectedFileName (@FormatFileSize(selectedFileSize))
                                                    </div>
                                                }
                                            </div>

                                            <div class="col-md-3 mb-3">
                                                <label class="form-label">&nbsp;</label>
                                                <button type="button" class="btn btn-sm btn-outline-primary d-block w-100" @onclick="AddAttachment" disabled="@isUploadingFile">
                                                    @if (isUploadingFile)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                        <span>Uploading...</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="ti ti-upload me-1"></i>
                                                        <span>Attach</span>
                                                    }
                                                </button>
                                            </div>
                                            </div>
                                            <div class="col-md-12 mb-3">
                                                <label class="form-label">Notes</label>
                                                <RichTextEditor @ref="attachmentNotesEditor" Value="@NewAttachmentNotes" Placeholder="Additional notes about this document..." MinHeight="60" MaxHeight="120" />
                                            </div>
                                         
                                            <hr class="my-3" />

                                            <!-- Attachments List -->
                                            <div class="col-12">
                                                <h6 class="mb-3">
                                                    <i class="ti ti-paperclip me-2"></i>Attachments
                                                    @if (Vendor.Attachments.Any())
                                                    {
                                                        <span class="badge bg-primary ms-2">@Vendor.Attachments.Count</span>
                                                    }
                                                </h6>

                                                @if (!Vendor.Attachments.Any())
                                                {
                                                    <div class="text-center py-4 text-muted">
                                                        <i class="ti ti-file-off" style="font-size: 48px;"></i>
                                                        <p class="mt-2 mb-0">No attachments added yet</p>
                                                        <small>Add KYC documents using the form above</small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @foreach (var attachment in Vendor.Attachments)
                                                    {
                                                        <div class="attachment-card d-flex align-items-center">
                                                            <div class="attachment-icon">
                                                                <i class="@VendorAttachmentTypes.GetIcon(attachment.AttachmentType)"></i>
                                                            </div>
                                                            <div class="attachment-info">
                                                                <div class="file-name">@attachment.FileName</div>
                                                                <div class="file-meta">
                                                                    <span class="badge bg-secondary-transparent text-secondary me-2">
                                                                        @VendorAttachmentTypes.GetDisplayName(attachment.AttachmentType)
                                                                    </span>
                                                                    <span class="badge bg-light text-dark me-2">
                                                                        @attachment.FileExtension.ToUpper().TrimStart('.')
                                                                    </span>
                                                                    <span class="text-muted me-2">@FormatFileSize(attachment.FileSizeBytes)</span>
                                                                    @if (!string.IsNullOrEmpty(attachment.Notes))
                                                                    {
                                                                        <span class="text-muted">| @attachment.Notes</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                            <div class="attachment-actions">
                                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAttachment(attachment.Id)" title="Remove">
                                                                    <i class="ti ti-trash"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- WIZARD FOOTER -->
                            @if (!IsEdit)
                            {
                                <div class="d-flex gap-2 wizard-footer mb-4" style="justify-content: end;">
                                    @if (CurrentStep != 1)
                                    {
                                        <button type="button" class="btn btn-outline-secondary" @onclick="Back" disabled="@(CurrentStep == 1)"> <i class="ti ti-chevron-left"></i>  Previous</button>
                                    }
                                    @if (CurrentStep < Steps.Count)
                                    {
                                        <button type="button" class="btn btn-primary" @onclick="Next">Next <i class="ti ti-chevron-right"></i></button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-primary" @onclick="Save"> <i class="ti ti-device-floppy"></i> @(IsEdit ? "Update" : "Save")</button>
                                    }
                                </div>
                            }
                            @if(IsEdit){
                                  <div class="d-flex gap-2 wizard-footer mb-4" style="justify-content: end;">
                                    @if (CurrentStep != 1)
                                    {
                                        <button type="button" class="btn btn-outline-secondary" @onclick="Back" disabled="@(CurrentStep == 1)"> <i class="ti ti-chevron-left"></i>  Previous</button>
                                    }
                                    @if (CurrentStep < Steps.Count)
                                    {
                                        <button type="button" class="btn btn-primary" @onclick="Next">Next <i class="ti ti-chevron-right"></i></button>
                                    }
                            </div>
                            }
                          

                        </div>

                        <!-- LIVE SUMMARY PANEL -->
                        <aside class="summary p-3 rounded d-none d-xl-flex" style="height: auto; background: white; border: none; display: flex; padding-left: 32px !important; padding-top: 42px !important;">
                            <div class="timeline-line1"></div>
                            <div class="timeline-indicator1"></div>
                            <div style="padding-left: 15px; width: 262px;">
                                <h3 class="text-warning mb-3" style="font-size: 17px;">Live Summary</h3>

                                <div class="row">
                                    @* Step 1: Core Identity *@
                                    @if (CurrentStep == 1)
                                    {
                                        <div class="col-md-12 mb-2"><small class="text-muted">Vendor Code:</small> <b>@(string.IsNullOrEmpty(Vendor.VendorCode) ? "-" : Vendor.VendorCode)</b></div>
                                        <div class="col-md-12 mb-2 text-truncate"><small class="text-muted">Vendor Name:</small> <b>@(string.IsNullOrEmpty(Vendor.VendorName) ? "-" : Vendor.VendorName)</b></div>
                                        <div class="col-md-12 mb-2"><small class="text-muted">Type:</small> <b>@VendorTypes.GetDisplayName(Vendor.VendorType)</b></div>
                                        <div class="col-md-12 mb-2"><small class="text-muted">Status:</small> <b>@VendorStatuses.GetDisplayName(Vendor.VendorStatus)</b></div>
                                    }

                                    @if (CurrentStep == 2)
                                    {
                                        @* Step 2: Address & Contacts *@
                                        @if (!string.IsNullOrEmpty(Vendor.RegisteredAddressLine1))
                                        {
                                            <div class="col-md-12 mb-2"><small class="text-muted">Registered Address Line1:</small> <b>@Vendor.RegisteredAddressLine1</b></div>
                                        }
                                        @if (!string.IsNullOrEmpty(Vendor.City))
                                        {
                                            <div class="col-md-12 mb-2"><small class="text-muted">City:</small> <b>@Vendor.City</b></div>
                                        }
                                        @if (!string.IsNullOrEmpty(Vendor.PrimaryContactName))
                                        {
                                            <div class="col-md-12 mb-2"><small class="text-muted">Contact:</small> <b>@Vendor.PrimaryContactName</b></div>
                                        }
                                        @if (!string.IsNullOrEmpty(Vendor.PrimaryPhone))
                                        {
                                            <div class="col-md-12 mb-2"><small class="text-muted">Phone:</small> <b>@Vendor.PrimaryPhone</b></div>
                                        }
                                    }
                                    @if (CurrentStep == 3)
                                    {

                                        @* Step 3: Compliance *@
                                        <div class="col-md-12 mb-2"><small class="text-muted">GST Registered:</small> <b>@(Vendor.IsGSTRegistered ? "Yes" : "No")</b></div>
                                        @if (Vendor.IsGSTRegistered && !string.IsNullOrEmpty(Vendor.GSTIN))
                                        {
                                            <div class="col-md-12 mb-2"><small class="text-muted">GSTIN:</small> <b>@Vendor.GSTIN</b></div>
                                        }
                                        @if (!string.IsNullOrEmpty(Vendor.PAN))
                                        {
                                            <div class="col-md-12 mb-2"><small class="text-muted">PAN:</small> <b>@Vendor.PAN</b></div>
                                        }
                                        <div class="col-md-12 mb-2"><small class="text-muted">TDS Applicable:</small> <b>@(Vendor.IsTDSApplicable ? "Yes" : "No")</b></div>
                                        @if (Vendor.IsTDSApplicable && !string.IsNullOrEmpty(Vendor.TDSSectionCode))
                                        {
                                            <div class="col-md-12 mb-2"><small class="text-muted">TDS Section:</small> <b>@Vendor.TDSSectionCode</b></div>
                                        }
                                    }

                                    @if (CurrentStep == 4)
                                    {

                                        @* Step 4: Payment & Banking *@
                                        @if (!string.IsNullOrEmpty(Vendor.PreferredPaymentMethod))
                                        {
                                            <div class="col-md-12 mb-2"><small class="text-muted">Payment Method:</small> <b>@VendorPaymentMethods.GetDisplayName(Vendor.PreferredPaymentMethod)</b></div>
                                        }
                                        @if (!string.IsNullOrEmpty(Vendor.BankName))
                                        {
                                            <div class="col-md-12 mb-2"><small class="text-muted">Bank:</small> <b>@Vendor.BankName</b></div>
                                        }
                                        @if (!string.IsNullOrEmpty(Vendor.BankAccountNumber))
                                        {
                                            <div class="col-md-12 mb-2"><small class="text-muted">Account:</small> <b>@Vendor.MaskedBankAccountNumber</b></div>
                                        }
                                        <div class="col-md-12 mb-2"><small class="text-muted">Bank Verified:</small> <b>@(Vendor.IsBankVerified ? "Yes" : "No")</b></div>

                                    }



                                    @* Step 5: AP Defaults *@
                                    @{
                                        var currency = Currencies.FirstOrDefault(c => c.Id == Vendor.DefaultCurrencyId);
                                        var payTerms = PaymentTerms.FirstOrDefault(p => p.Id == Vendor.PaymentTermsId);
                                        var apAccount = GLAccounts.FirstOrDefault(a => a.Id == Vendor.DefaultPayableAccountId);
                                    }
                                    @if (CurrentStep == 5)
                                    {
                                        @if (currency != null)
                                        {
                                            <div class="col-md-12 mb-2"><small class="text-muted">Currency:</small> <b>@currency.CurrencyCode</b></div>
                                        }
                                        @if (payTerms != null)
                                        {
                                            <div class="col-md-12 mb-2"><small class="text-muted">Payment Terms:</small> <b>@payTerms.Name</b></div>
                                        }
                                        @if (apAccount != null)
                                        {
                                            <div class="col-md-12 mb-2"><small class="text-muted">AP Account:</small> <b>@apAccount.AccountCode</b></div>
                                        }
                                        <div class="col-md-12 mb-2"><small class="text-muted">Payment Blocked:</small> <b>@(Vendor.IsPaymentBlocked ? "Yes" : "No")</b></div>
                                        <div class="col-md-12 mb-2"><small class="text-muted">Posting Blocked:</small> <b>@(Vendor.IsBillPostingBlocked ? "Yes" : "No")</b></div>
                                    }
                                    @if (CurrentStep == 6)
                                    {
                                        @* Step 6: Attachments *@
                                        <div class="col-md-12 mb-2"><small class="text-muted">Attachments:</small> <b>@Vendor.Attachments.Count</b></div>
                                        @foreach (var att in Vendor.Attachments.Take(3))
                                        {
                                            <div class="col-md-12 mb-1">
                                                <small><i class="@VendorAttachmentTypes.GetIcon(att.AttachmentType) me-1"></i>@att.FileName</small>
                                            </div>
                                        }
                                        @if (Vendor.Attachments.Count > 3)
                                        {
                                            <div class="col-md-12 mb-1"><small class="text-muted">+@(Vendor.Attachments.Count - 3) more...</small></div>
                                        }
                                    }
                                </div>
                            </div>
                        </aside>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}
