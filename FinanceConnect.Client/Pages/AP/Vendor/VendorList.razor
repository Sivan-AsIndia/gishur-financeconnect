@page "/vendors"

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Vendor List</h4>
                    <h6>Manage your AP vendors</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/vendors/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Vendor List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search by code, name, GSTIN, PAN, phone, email..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 160px" @bind="SelectedVendorType">
                            <option value="">All Types</option>
                            @foreach (var type in AvailableVendorTypes)
                            {
                                <option value="@type">@VendorTypes.GetDisplayName(type)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in AvailableStatuses)
                            {
                                <option value="@status">@VendorStatuses.GetDisplayName(status)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <div>
                        <table class="table align-middle w-100 table-fixed">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xxl-none" style="width:40px"></th>
                                    <th style="width:200px">Code</th>
                                    <th class="d-none d-md-table-cell">Vendor Name</th>
                                    <th class="d-none d-xl-table-cell" style="width:130px;white-space:nowrap">Type</th>
                                    <th class="d-none d-xxl-table-cell" style="width:180px">GSTIN</th>
                                    @* <th class="d-none d-xxl-table-cell" style="width:140px">Phone</th> *@
                                    <th class="d-none d-xl-table-cell" style="width:110px">Status</th>
                                    <th style="width:170px">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedVendors.Any())
                                {
                                    @foreach (var v in PagedVendors)
                                    {
                                        <tr>
                                            <td class="d-xxl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#rowDetailsModal"
                                                   @onclick="() => OpenRowDetails(v)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td class="fw-medium">
                                               <span>
                                                    <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                    <a href="/vendors/@v.Id/view" class="text-decoration-none link-View"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       title="@v.VendorCode details">
                                                        @v.VendorCode
                                                    </a>
                                               </span>
                                            </td>

                                            <td class="d-none d-md-table-cell">
                                                @v.VendorName
                                                @if (v.IsPaymentBlocked)
                                                {
                                                    <i class="ti ti-lock text-danger ms-1" title="Payment Blocked"></i>
                                                }
                                            </td>

                                            <td class="d-none d-xl-table-cell" style="white-space:nowrap">
                                                <span class="badge @GetTypeBadgeClass(v.VendorType)">@VendorTypes.GetDisplayName(v.VendorType)</span>
                                            </td>

                                            <td class="d-none d-xxl-table-cell">
                                                @(v.GSTIN ?? "-")
                                            </td>

                                            @* <td class="d-none d-xxl-table-cell">
                                                @(v.PrimaryPhone ?? "-")
                                            </td> *@

                                            @* <td class="d-none d-lg-table-cell">
                                                <span class="badge @GetStatusBadgeClass(v.VendorStatus)">
                                                    @VendorStatuses.GetDisplayName(v.VendorStatus)
                                                </span>
                                            </td> *@
                                            <td class="d-none d-xl-table-cell">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="ActiveDot @GetStatusDotBadgeClass(v.VendorStatus)">
                                                    </div>
                                                    <span>@v.VendorStatus</span>
                                                </div>
                                            </td>

                                            <td class="action-table-data">
                                                <div class="edit-delete-action">
                                                    <a class="me-2 edit-icon p-1" href="/vendors/@v.Id" title="Edit">
                                                        <i data-feather="edit"></i>
                                                    </a>
                                                    @if (v.VendorStatus == VendorStatuses.Active)
                                                    {
                                                        <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon" href="javascript:void(0);"
                                                           title="Deactivate" data-bs-toggle="modal" data-bs-target="#deactivate-modal"
                                                           @onclick="() => ConfirmDeactivate(v)">
                                                            <i class="ti ti-toggle-right" style="color:green;"></i>
                                                        </a>
                                                    }
                                                    else if (v.VendorStatus != VendorStatuses.Blacklisted)
                                                    {
                                                        <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                           title="Activate" data-bs-toggle="modal" data-bs-target="#activate-modal"
                                                           @onclick="() => ConfirmActivate(v)">
                                                            <i class="ti ti-toggle-left" ></i>
                                                        </a>
                                                    }
                                                    @if (v.VendorStatus != VendorStatuses.OnHold && v.VendorStatus != VendorStatuses.Blacklisted)
                                                    {
                                                        <a class="me-2 p-1 action-icon Bounce" href="javascript:void(0);"
                                                           title="Place Hold" data-bs-toggle="modal" data-bs-target="#hold-modal"
                                                           @onclick="() => OpenHoldModal(v)">
                                                            <i class="ti ti-ban"></i>
                                                        </a>
                                                    }
                                                    else if (v.VendorStatus == VendorStatuses.OnHold)
                                                    {
                                                        <a class="me-2 p-1 action-icon release-hold-icon" href="javascript:void(0);"
                                                           title="Release Hold" data-bs-toggle="modal" data-bs-target="#release-hold-modal"
                                                           @onclick="() => ConfirmReleaseHold(v)">
                                                            <i class="ti ti-check"></i>
                                                        </a>
                                                    }
                                                    <a class="p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                                       data-bs-toggle="modal" data-bs-target="#delete-modal"
                                                       @onclick="() => ConfirmDelete(v)">
                                                        <i data-feather="trash-2"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@VisibleColumnCount" class="text-center py-4">
                                            <div class="text-muted">
                                                <i class="ti ti-inbox fs-1 d-block mb-2"></i>
                                                No vendors found
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (FilteredVendors.Count > 0)
                    {
                        <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                            <div class="d-flex align-items-center">
                                <span class="me-2">Rows per page</span>
                                <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                                    <option value="5" selected="@(PageSize == 5)">5</option>
                                    <option value="10" selected="@(PageSize == 10)">10</option>
                                    <option value="25" selected="@(PageSize == 25)">25</option>
                                    <option value="50" selected="@(PageSize == 50)">50</option>
                                </select>
                                <span class="ms-3 text-muted">
                                    Entries
                                </span>
                            </div>
                            @* <div class="text-muted small">
                                Showing @((CurrentPage - 1) * PageSize + 1) to @Math.Min(CurrentPage * PageSize, FilteredVendors.Count) of @FilteredVendors.Count entries
                            </div> *@
                            <nav>
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>
                                    @for (int i = 1; i <= TotalPages; i++)
                                    {
                                        var pageActive = i;
                                        <li class="page-item @(CurrentPage == pageActive ? "active" : "")">
                                            <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageActive)">@pageActive</a>
                                        </li>
                                    }
                                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                        <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Row Details Modal (Mobile) -->
        <div class="modal fade list-Popup" id="rowDetailsModal" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Vendor Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" style="padding: 0;right: 22px;position: absolute;transform: none;"></button>
                    </div>
                    <div class="modal-body">
                        @if (SelectedVendor != null)
                        {
                            <div class="row g-3">
                                <div class="col-4"><strong>Code:</strong></div>
                                <div class="col-6">@SelectedVendor.VendorCode</div>
                                <div class="col-4"><strong>Name:</strong></div>
                                <div class="col-6">@SelectedVendor.VendorName</div>
                                <div class="col-4"><strong>Type:</strong></div>
                                <div class="col-6">@VendorTypes.GetDisplayName(SelectedVendor.VendorType)</div>
                                <div class="col-4"><strong>Status:</strong></div>
                                <div class="col-6"><span class="badge @GetStatusBadgeClass(SelectedVendor.VendorStatus)">@VendorStatuses.GetDisplayName(SelectedVendor.VendorStatus)</span></div>
                                <div class="col-4"><strong>GSTIN:</strong></div>
                                <div class="col-6">@(SelectedVendor.GSTIN ?? "-")</div>
                                <div class="col-4"><strong>Phone:</strong></div>
                                <div class="col-6">@(SelectedVendor.PrimaryPhone ?? "-")</div>
                                <div class="col-4"><strong>Email:</strong></div>
                                <div class="col-6">@(SelectedVendor.PrimaryEmail ?? "-")</div>
                            </div>
                        }
                    </div>
                    @* <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Close</button>
                        <a href="/vendor/@SelectedVendor?.Id" class="btn btn-primary">View Full Details</a>
                    </div> *@
                </div>
            </div>
        </div>

        <!-- Activate Modal -->
        <div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-toggle-right fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Vendor</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to activate <strong>@SelectedVendor?.VendorName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-right me-1"></i>Yes, Activate</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deactivate Modal -->
        <div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                                <i class="ti ti-toggle-left fs-24 text-warning"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate Vendor</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDeactivate)
                                {
                                    <span class="text-danger">Cannot deactivate! Vendor has active transactions.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to deactivate <strong>@SelectedVendor?.VendorName</strong>?</span>
                                }
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDeactivate)
                                {
                                    <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-left me-1"></i>Yes, Deactivate</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hold Modal -->
        <div class="modal fade" id="hold-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                <i class="ti ti-ban fs-24 text-danger"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Place Vendor on Hold</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Place hold on <strong>@SelectedVendor?.VendorName</strong>
                            </p>
                            <div class="mt-3 text-start">
                                <label class="form-label">Reason <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="3" @bind="holdReasonInput" placeholder="Enter reason for placing hold..."></textarea>
                            </div>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="PlaceHoldConfirmed" data-bs-dismiss="modal"><i class="ti ti-ban me-1"></i>Yes, Place Hold</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Release Hold Modal -->
        <div class="modal fade" id="release-hold-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-check fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Release Hold</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to release <strong>@SelectedVendor?.VendorName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ReleaseHoldConfirmed" data-bs-dismiss="modal"><i class="ti ti-check me-1"></i>Yes, Release Hold</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                <i class="ti ti-trash fs-24 text-danger"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Vendor</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDelete)
                                {
                                    <span class="text-danger">Cannot delete! Vendor has active transactions. Set to Inactive instead.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to delete <strong>@SelectedVendor?.VendorName</strong>?</span>
                                }
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDelete)
                                {
                                    <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteConfirmed" data-bs-dismiss="modal"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
}
