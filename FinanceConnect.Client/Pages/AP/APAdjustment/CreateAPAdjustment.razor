@page "/ap-adjustments/create"
@page "/ap-adjustments/{Id:guid}"

@using FinanceConnect.Client.ViewModels

<style>
    .form-select option:checked {
        color: #fff;
        background: var(--primary);
    }

    .form-select:focus {
        border-color: var(--primary);
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 11px;
        margin-top: 2px;
    }

    /* Summary Card Styling */
    .summary-card {
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 12px 16px;
        text-align: center;
    }

    .summary-card-label {
        font-size: 11px;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .summary-card-value {
        font-size: 18px;
        font-weight: 700;
        color: #212529;
        margin-top: 4px;
    }

    .summary-card-value.highlight {
        color: #FE9F43;
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    <div class="content">
        <div class="page-header">
            <div class="add-item d-flex justify-content-between w-100 align-items-center">
                <div class="page-title">
                    <h4 class="fw-bold">@(IsEdit ? "Edit" : "Create") AP Adjustment</h4>
                    <h6>@(IsEdit ? "Modify adjustment details" : "Create a new accounts payable adjustment")</h6>
                </div>
                <a href="/ap-adjustments" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left"></i> Back
                </a>
            </div>
            <div class="page-btn d-flex gap-2">
                @if (IsEdit && !IsReadOnly)
                {
                    <span class="badge @GetStatusBadgeClass(Adjustment.AdjustmentStatus) fs-6 py-2 px-3">
                        @APAdjustmentStatuses.GetDisplayName(Adjustment.AdjustmentStatus)
                    </span>
                }
            </div>
        </div>

        <EditForm EditContext="_editContext" OnSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <!-- Section 1: Core Identity (Header) -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0 text-primary">
                        <i class="ti ti-id me-2 "></i>Header Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Branch -->
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label">Branch <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm @(HasValidationError("BranchId") ? "is-invalid" : "")"
                                    @bind="Adjustment.BranchId" disabled="@IsReadOnly"
                                    title="Select the branch for this adjustment">
                                <option value="@Guid.Empty">--Select Branch--</option>
                                @foreach (var branch in Branches)
                                {
                                    <option value="@branch.Id">@branch.BranchCode - @branch.BranchName</option>
                                }
                            </select>
                            @if (HasValidationError("BranchId"))
                            {
                                <span class="validation-message">@GetValidationError("BranchId")</span>
                            }
                        </div>

                        <!-- Vendor -->
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label">Vendor <span class="text-danger">*</span></label>
                            <SearchDropdown TItem="VendorViewModel"
                                            Items="Vendors"
                                            TextSelector="@(v => v.VendorCode + " - " + v.VendorName)"
                                            ValueSelector="@(v => v.Id)"
                                            @bind-Value="Adjustment.VendorId"
                                            @bind-Value:after="OnVendorChanged"
                                            Class="@(HasValidationError("VendorId")? "is-invalid" : "")"
                                            Placeholder="-- Select Customer --"
                                            Disabled="@IsReadOnly" />
                            @if (HasValidationError("VendorId"))
                            {
                                <span class="validation-message">@GetValidationError("VendorId")</span>
                            }
                        </div>

                        <!-- Adjustment Number -->
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label">Adjustment Number</label>
                            <input type="text" class="form-control form-control-sm" readonly
                                   value="@Adjustment.AdjustmentNumber"
                                   title="System-generated adjustment number (e.g., APADJ-000001)" />
                        </div>

                        <!-- Currency (Badge) -->
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label">Currency</label>
                            <div>
                                <span class="badge bg-primary-transparent text-primary py-2 px-3">
                                    @(Adjustment.CurrencyCode ?? "INR")
                                </span>
                            </div>
                        </div>

                        <!-- Adjustment Date -->
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label">Adjustment Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control form-control-sm @(HasValidationError("AdjustmentDate") ? "is-invalid" : "")"
                                   @bind="Adjustment.AdjustmentDate" disabled="@IsReadOnly"
                                   title="Date of the adjustment entry (default: today)" />
                            @if (HasValidationError("AdjustmentDate"))
                            {
                                <span class="validation-message">@GetValidationError("AdjustmentDate")</span>
                            }
                        </div>

                        <!-- Posting Date (Read-only until posting) -->
                        @if (Adjustment.PostingDate.HasValue)
                        {
                            <div class="col-md-4 col-lg-3">
                                <label class="form-label">Posting Date</label>
                                <input type="date" class="form-control form-control-sm" readonly
                                       value="@Adjustment.PostingDate?.ToString("yyyy-MM-dd")"
                                       title="Date when the adjustment was posted (open period only)" />
                            </div>
                        }

                        <!-- Exchange Rate (Future-ready) -->
                        @if (Adjustment.CurrencyCode != "INR")
                        {
                            <div class="col-md-4 col-lg-3">
                                <label class="form-label">Exchange Rate</label>
                                <input type="number" step="0.000001" class="form-control form-control-sm text-end"
                                       @bind="Adjustment.ExchangeRate" disabled="@IsReadOnly"
                                       title="Required if currency is not base currency" />
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Section 2: Adjustment Classification -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0 text-primary">
                        <i class="ti ti-category me-2 "></i>Adjustment Classification
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Adjustment Type -->
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label">Adjustment Type <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm @(HasValidationError("AdjustmentType") ? "is-invalid" : "")"
                                    @bind="Adjustment.AdjustmentType" @bind:after="OnAdjustmentTypeChanged" disabled="@IsReadOnly"
                                    title="Type of adjustment: WriteOff, RoundOffCorrection, DisputeSettlement, Reclassification, VendorBalanceTransfer, FXDifference, Other">
                                <option value="">--Select Adjustment Type--</option>
                                @foreach (var type in APAdjustmentTypes.All)
                                {
                                    <option value="@type">@APAdjustmentTypes.GetDisplayName(type)</option>
                                }
                            </select>
                            @if (HasValidationError("AdjustmentType"))
                            {
                                <span class="validation-message">@GetValidationError("AdjustmentType")</span>
                            }
                            else if (!string.IsNullOrEmpty(Adjustment.AdjustmentType))
                            {
                                <small class="text-muted">@APAdjustmentTypes.GetDescription(Adjustment.AdjustmentType)</small>
                            }
                        </div>

                        <!-- Adjustment Direction -->
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label">Direction <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm @(HasValidationError("AdjustmentDirection") ? "is-invalid" : "")"
                                    @bind="Adjustment.AdjustmentDirection" disabled="@IsReadOnly"
                                    title="ReducePayable (most common) or IncreasePayable (rare, strict policy)">
                                <option value="">--Select Direction--</option>
                                @foreach (var direction in APAdjustmentDirections.All)
                                {
                                    <option value="@direction">@APAdjustmentDirections.GetDisplayName(direction)</option>
                                }
                            </select>
                            @if (HasValidationError("AdjustmentDirection"))
                            {
                                <span class="validation-message">@GetValidationError("AdjustmentDirection")</span>
                            }
                        </div>

                        <!-- Reason Code -->
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label">Reason Code <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm @(HasValidationError("ReasonCodeId") ? "is-invalid" : "")"
                                    @bind="Adjustment.ReasonCodeId" @bind:after="OnReasonCodeChanged" disabled="@IsReadOnly"
                                    title="Reason for the adjustment (drives approval requirements)">
                                <option value="">--Select Reason Code--</option>
                                @foreach (var reason in FilteredReasons)
                                {
                                    <option value="@reason.Id">@reason.ReasonCode - @reason.ReasonDescription</option>
                                }
                            </select>
                            @if (HasValidationError("ReasonCodeId"))
                            {
                                <span class="validation-message">@GetValidationError("ReasonCodeId")</span>
                            }
                        </div>

                        <!-- Policy Limit Category (Read-only Derived) -->
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label">Policy Category</label>
                            <div>
                                <span class="badge @GetPolicyBadgeClass(Adjustment.PolicyLimitCategory) py-2 px-3"
                                      title="Derived from amount and type - drives required approval level">
                                    @APPolicyLimitCategories.GetDisplayName(Adjustment.PolicyLimitCategory)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Target & Impact -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0 text-primary">
                        <i class="ti ti-target me-2 "></i>Target & Impact
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Adjustment Scope -->
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label">Scope <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm @(HasValidationError("AdjustmentScope") ? "is-invalid" : "")"
                                    @bind="Adjustment.AdjustmentScope" @bind:after="OnScopeChanged" disabled="@IsReadOnly"
                                    title="VendorLevel (overall payable), BillLevel (specific invoice), AdvanceLevel (advance/open credit)">
                                <option value="">--Select Scope--</option>
                                @foreach (var scope in APAdjustmentScopes.All)
                                {
                                    <option value="@scope">@APAdjustmentScopes.GetDisplayName(scope)</option>
                                }
                            </select>
                            @if (HasValidationError("AdjustmentScope"))
                            {
                                <span class="validation-message">@GetValidationError("AdjustmentScope")</span>
                            }
                            else if (!string.IsNullOrEmpty(Adjustment.AdjustmentScope))
                            {
                                <small class="text-muted">@APAdjustmentScopes.GetDescription(Adjustment.AdjustmentScope)</small>
                            }
                        </div>

                        <!-- Target Vendor Bill (Conditional) -->
                        @if (Adjustment.AdjustmentScope == APAdjustmentScopes.BillLevel)
                        {
                            <div class="col-md-4 col-lg-3">
                                <label class="form-label">Target Vendor Bill <span class="text-danger">*</span></label>
                                <select class="form-select form-select-sm @(HasValidationError("TargetVendorBillId") ? "is-invalid" : "")"
                                        @bind="Adjustment.TargetVendorBillId" @bind:after="OnBillSelected" disabled="@IsReadOnly"
                                        title="Select the vendor bill to adjust. Filter: vendor + outstanding > 0">
                                <option value="">--Select Target Vendor Bill--</option>
                                    @foreach (var bill in VendorBills)
                                    {
                                        <option value="@bill.Id">@bill.BillNumber (O/S: @bill.AmountOutstanding.ToString("N2"))</option>
                                    }
                                </select>
                                @if (Adjustment.TargetBillOutstandingSnapshot.HasValue)
                                {
                                    <small class="text-muted">Outstanding: @Adjustment.TargetBillOutstandingSnapshot?.ToString("N2")</small>
                                }
                                @if (HasValidationError("TargetVendorBillId"))
                                {
                                    <span class="validation-message">@GetValidationError("TargetVendorBillId")</span>
                                }
                            </div>
                        }

                        <!-- Target Reference Text -->
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label">Reference</label>
                            <input type="text" class="form-control form-control-sm" maxlength="100"
                                   @bind="Adjustment.TargetReferenceText" disabled="@IsReadOnly"
                                   placeholder="Dispute ID, Email ref, Ticket no..."
                                   title="Optional reference: dispute id, email ref, ticket no, etc." />
                        </div>

                        <!-- Adjustment Amount -->
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label">Adjustment Amount <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" class="form-control form-control-sm text-end @(HasValidationError("AdjustmentAmount") ? "is-invalid" : "")"
                                   @bind="Adjustment.AdjustmentAmount" @bind:after="OnAmountChanged" disabled="@IsReadOnly"
                                   min="0.01" placeholder="0.00"
                                   title="Adjustment amount (must be greater than 0)" />
                            @if (HasValidationError("AdjustmentAmount"))
                            {
                                <span class="validation-message">@GetValidationError("AdjustmentAmount")</span>
                            }
                        </div>

                        <!-- Impact Summary (Read-only) -->
                        <div class="col-12">
                            <div class="row g-3 mt-2">
                                <div class="col-md-4">
                                    <div class="summary-card">
                                        <div class="summary-card-label">Impact on Vendor Payable</div>
                                        <div class="summary-card-value @(Adjustment.ImpactOnVendorPayableAmount < 0 ? "text-success" : "text-danger")">
                                            @(Adjustment.ImpactOnVendorPayableAmount > 0 ? "+" : "")@Adjustment.ImpactOnVendorPayableAmount.ToString("N2")
                                        </div>
                                    </div>
                                </div>
                                @if (Adjustment.AdjustmentScope == APAdjustmentScopes.AdvanceLevel)
                                {
                                    <div class="col-md-4">
                                        <div class="summary-card">
                                            <div class="summary-card-label">Impact on Vendor Advance</div>
                                            <div class="summary-card-value @(Adjustment.ImpactOnVendorAdvanceAmount != 0 ? "text-info" : "")">
                                                @(Adjustment.ImpactOnVendorAdvanceAmount > 0 ? "+" : "")@Adjustment.ImpactOnVendorAdvanceAmount.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 4: Accounting Mapping -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0 text-primary">
                        <i class="ti ti-calculator me-2 "></i>Accounting Mapping (GL Posting)
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Adjustment GL Account -->
                        <div class="col-md-6 col-lg-4">
                            <label class="form-label">Adjustment Account <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm @(HasValidationError("AdjustmentGLAccountId") ? "is-invalid" : "")"
                                    @bind="Adjustment.AdjustmentGLAccountId" @bind:after="OnGLAccountChanged" disabled="@IsReadOnly"
                                    title="GL account to offset the AP adjustment (e.g., Bad Debts/Write-off, Rounding, Dispute Settlement)">
                                <option value="">--Select Adjustment Account--</option>
                                @foreach (var acc in OffsetAccounts)
                                {
                                    <option value="@acc.Id">@acc.AccountCode - @acc.AccountName</option>
                                }
                            </select>
                            @if (HasValidationError("AdjustmentGLAccountId"))
                            {
                                <span class="validation-message">@GetValidationError("AdjustmentGLAccountId")</span>
                            }
                        </div>

                        <!-- GL Account Type (Read-only Derived) -->
                        @if (!string.IsNullOrEmpty(Adjustment.AdjustmentGLAccountType))
                        {
                            <div class="col-md-3 col-lg-2">
                                <label class="form-label">Account Type</label>
                                <div>
                                    <span class="badge bg-secondary-transparent text-secondary py-1 px-2"
                                          title="Derived from selected account - for rule enforcement">
                                        @Adjustment.AdjustmentGLAccountType
                                    </span>
                                </div>
                            </div>
                        }

                        <!-- Is Tax Impacting -->
                        <div class="col-md-3 col-lg-2">
                            <label class="form-label">Tax Impacting</label>
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" id="taxImpactSwitch"
                                       @bind="Adjustment.IsTaxImpactingAdjustment" disabled="@IsReadOnly"
                                       title="Enable if this adjustment has tax implications (rare)" />
                                <label class="form-check-label small" for="taxImpactSwitch">
                                    @(Adjustment.IsTaxImpactingAdjustment ? "Yes" : "No")
                                </label>
                            </div>
                        </div>

                        <!-- Tax Code (Conditional) -->
                        @if (Adjustment.IsTaxImpactingAdjustment)
                        {
                            <div class="col-md-4 col-lg-3">
                                <label class="form-label">Tax Code</label>
                                <select class="form-select form-select-sm"
                                        @bind="Adjustment.TaxCodeId" disabled="@IsReadOnly"
                                        title="Select applicable tax code (future policy)">
                                <option value="">--Select Tax Code--</option>
                                    @foreach (var tax in TaxCodes)
                                    {
                                        <option value="@tax.Id">@tax.Name</option>
                                    }
                                </select>
                            </div>
                        }

                        <!-- AP Control Account (Read-only snapshot at posting) -->
                        @if (Adjustment.AdjustmentStatus == APAdjustmentStatuses.Posted && Adjustment.APControlAccountIdSnapshot.HasValue)
                        {
                            <div class="col-md-6 col-lg-4">
                                <label class="form-label">AP Control Account</label>
                                <input type="text" class="form-control form-control-sm" readonly
                                       value="@Adjustment.APControlAccountCode - @Adjustment.APControlAccountName"
                                       title="Snapshot from company AP control config at posting" />
                            </div>
                        }
                        <!-- Posting Narration Snapshot (Read-only, shown when posted) -->
                        @if (Adjustment.AdjustmentStatus == APAdjustmentStatuses.Posted && !string.IsNullOrEmpty(Adjustment.PostingNarrationSnapshot))
                        {
                            <div class="col-12">
                                <label class="form-label">Posting Narration (GL Entry)</label>
                                <input type="text" class="form-control form-control-sm" readonly
                                       value="@Adjustment.PostingNarrationSnapshot"
                                       title="Narration passed into GL entry at posting time" />
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Section 5: Narration / Notes -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0 text-primary">
                        <i class="ti ti-notes me-2 "></i>Notes / Explanation
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Narration <span class="text-danger">*</span></label>
                            @if (IsReadOnly)
                            {
                                <div class="form-control bg-light" style="min-height:60px">@((MarkupString)(Adjustment.Narration ?? ""))</div>
                            }
                            else
                            {
                                <RichTextEditor @ref="narrationEditor" Value="@Adjustment.Narration" Placeholder="Enter detailed explanation for this adjustment..." MinHeight="80" MaxHeight="200" />
                            }
                            @if (HasValidationError("Narration"))
                            {
                                <span class="validation-message text-danger">@GetValidationError("Narration")</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 6: Summary -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0 text-primary">
                        <i class="ti ti-receipt me-2 "></i>Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="summary-card">
                                <div class="summary-card-label">Adjustment Amount</div>
                                <div class="summary-card-value highlight">@Adjustment.CurrencyCode @Adjustment.AdjustmentAmount.ToString("N2")</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="summary-card">
                                <div class="summary-card-label">Direction</div>
                                <div class="summary-card-value">
                                    <span class="badge @GetDirectionBadgeClass(Adjustment.AdjustmentDirection)">
                                        <i class="ti @(Adjustment.AdjustmentDirection == APAdjustmentDirections.ReducePayable ? "ti-arrow-down" : "ti-arrow-up") me-1"></i>
                                        @APAdjustmentDirections.GetDisplayName(Adjustment.AdjustmentDirection)
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="summary-card">
                                <div class="summary-card-label">Scope</div>
                                <div class="summary-card-value">@APAdjustmentScopes.GetDisplayName(Adjustment.AdjustmentScope)</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="summary-card">
                                <div class="summary-card-label">Attachments</div>
                                <div class="summary-card-value">
                                    @Adjustment.AttachmentCount
                                    @if (Adjustment.EvidenceRequired && Adjustment.AttachmentCount == 0)
                                    {
                                        <i class="ti ti-alert-triangle text-warning ms-1" title="Evidence required"></i>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Evidence Required Warning -->
            @if (Adjustment.EvidenceRequired && Adjustment.AttachmentCount == 0)
            {
                <div class="alert alert-warning mb-4">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <strong>Evidence Required:</strong> This adjustment type/amount requires supporting documentation.
                    Please attach evidence before submitting.
                </div>
            }

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end gap-3 mb-4">
                <a href="/ap-adjustments" class="btn btn-outline-secondary">
                    <i class="ti ti-x me-1"></i>Cancel
                </a>
                @if (!IsReadOnly)
                {
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1"></i>@(IsEdit ? "Update" : "Save")
                    </button>
                }
            </div>
        </EditForm>
    </div>
}
