@page "/ap-adjustments"

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">AP Adjustment List</h4>
                    <h6>Manage AP adjustments for write-offs, rounding, and dispute settlements</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/ap-adjustments/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Statistics Cards -->


        <div class="row mb-0">
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #f905b9, #f60080) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Total</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.TotalAdjustments</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-white rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-adjustments-horizontal" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #092c4c, #00396e) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Draft</h6>
                                <h5 class="mb-0 fw-bold text-secondary text-white">@Statistics.DraftAdjustments</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-secondary rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-file-text text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #ffad00, #ffb137) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Pending Approval</h6>
                                <h5 class="mb-0 fw-bold text-info text-white">@Statistics.PendingApproval</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-info rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-clock text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(343deg, #009b54, #3eb780) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Posted</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.PostedAdjustments</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-success rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-check text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #ff0000, #f60000) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Cancelled</h6>
                                <h5 class="mb-0 fw-bold text-danger text-white">@Statistics.CancelledAdjustments</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-danger rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-ban text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(343deg, #fe3737, #ff8d21) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">
                                    Total Amount
                                </h6>
                                <h5 class="mb-0 fw-bold text-warning text-white" style="font-size: 14px;">@Statistics.TotalAdjustmentAmount.ToString("N0")</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-warning rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-currency-rupee text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>





        <!-- Adjustment List -->
        <div class="card">
            <div class="card-header d-flex align-items-end justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search by adjustment no, vendor..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px;    align-items: end;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="statusFilter" @bind:after="ApplyFilters">
                            <option value="">All Status</option>
                            @foreach (var status in DistinctStatuses)
                            {
                                <option value="@status">@APAdjustmentStatuses.GetDisplayName(status)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="typeFilter" @bind:after="ApplyFilters">
                            <option value="">All Types</option>
                            @foreach (var type in DistinctTypes)
                            {
                                <option value="@type">@APAdjustmentTypes.GetDisplayName(type)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2 filter-date">
                        <label class="form-label">From</label>

                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="FromDate" @bind:after="ApplyFilters" title="From Date" />
                    </div>
                    <div class="ms-2 filter-date">
                        <label class="form-label">To</label>

                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="ToDate" @bind:after="ApplyFilters" title="To Date" />
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <div>
                        <table class="table align-middle w-100 table-fixed">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xl-none" style="width:40px"></th>
                                    <th style="width: 195px;">No</th>
                                    <th class="d-none d-md-table-cell" >Vendor</th>
                                    <th class="d-none d-xl-table-cell" style="width:130px">Type</th>
                                    <th class="d-none d-lg-table-cell text-center">Date</th>
                                    <th class="d-none d-xl-table-cell text-right" style="width:120px">Amount</th>
                                    <th class="d-none d-xxl-table-cell text-center">Direction</th>
                                    <th class="d-none d-md-table-cell" >Status</th>
                                    <th style="width:194px" class="text-left">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedAdjustments.Any())
                                {
                                    @foreach (var adjustment in PagedAdjustments)
                                    {
                                        <tr>
                                            <!-- PLUS ICON for Mobile -->
                                            <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#rowDetailsModal"
                                                   @onclick="() => OpenRowDetails(adjustment)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td class="fw-medium">
                                              <span>
                                                    <i class="ti ti-external-link me-2 PopupIcon"></i>

                                                    <a href="/ap-adjustments/@adjustment.APAdjustmentId/view" class="text-decoration-none link-View"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       title="@adjustment.AdjustmentNumber details">
                                                        @adjustment.AdjustmentNumber
                                                    </a>
                                              </span>
                                            </td>

                                            <td class="d-none d-md-table-cell">
                                                <div class="fw-medium">@adjustment.VendorCode</div>
                                                <small class="text-muted" title="Vendor Name">@adjustment.VendorName</small>
                                            </td>

                                            <td class="d-none d-xl-table-cell">

                                                <span class="badge @GetTypeBadgeClass(adjustment.AdjustmentType)"
                                                      data-bs-toggle="tooltip"
                                                      data-bs-placement="top"
                                                      title="@APAdjustmentTypes.GetDisplayName(adjustment.AdjustmentType)">

                                                    <i class="@GetAdjustmentTypeIcon(adjustment.AdjustmentType)"></i>

                                                </span>

                                            </td>

                                            <td class="d-none d-lg-table-cell text-center" >
                                                @adjustment.AdjustmentDate.ToString("dd-MMM-yy")
                                            </td>

                                            <td class="text-end d-none d-xl-table-cell fw-medium" >
                                                @* @adjustment.AdjustmentAmount.ToString("N2") *@
                                                @IndianNumberFormatter.Format(@adjustment.AdjustmentAmount)

                                            </td>

                                            <td class="d-none d-xxl-table-cell text-center">

                                                <span class="badge @GetDirectionBadgeClass(adjustment.AdjustmentDirection)"
                                                      data-bs-toggle="tooltip"
                                                      data-bs-placement="top"
                                                      title="@APAdjustmentDirections.GetDisplayName(adjustment.AdjustmentDirection)">

                                                    <i class="@GetAdjustmentDirectionIcon(adjustment.AdjustmentDirection)"></i>

                                                </span>

                                            </td>

                                            @* <td class="d-none d-md-table-cell" style="text-overflow:inherit">
                                                <span class="badge @GetStatusBadgeClass(adjustment.AdjustmentStatus)">@APAdjustmentStatuses.GetDisplayName(adjustment.AdjustmentStatus)</span>
                                            </td> *@

                                            <td class="d-none d-md-table-cell">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="ActiveDot @GetStatusDotBadgeClass(adjustment.AdjustmentStatus)">
                                                    </div>
                                                    <span>@APAdjustmentStatuses.GetDisplayName(adjustment.AdjustmentStatus)</span>
                                                </div>
                                            </td>

                                            <td class="action-table-data">
                                                <div class="edit-delete-action d-flex justify-content-start gap-1">
                                                    @if (adjustment.CanEdit)
                                                    {
                                                        <a class="me-1 edit-icon p-1" href="/ap-adjustments/@adjustment.APAdjustmentId" title="Edit">
                                                            <i data-feather="edit"></i>
                                                        </a>
                                                    }
                                                    @if (adjustment.AdjustmentStatus == APAdjustmentStatuses.Draft)
                                                    {
                                                        <a class="me-1 p-1 action-icon Issue" href="javascript:void(0);"
                                                           title="Submit for Approval" data-bs-toggle="modal" data-bs-target="#submitModal"
                                                           @onclick="() => OpenSubmitModal(adjustment)">
                                                            <i class="ti ti-send"></i>
                                                        </a>
                                                    }
                                                    @if (adjustment.CanPost)
                                                    {
                                                        <a class="me-1 p-1 action-icon Clear" href="javascript:void(0);"
                                                           title="Post Adjustment" data-bs-toggle="modal" data-bs-target="#postModal"
                                                           @onclick="() => OpenPostModal(adjustment)">
                                                            <i class="ti ti-check"></i>
                                                        </a>
                                                    }
                                                    @if (adjustment.CanCancel)
                                                    {
                                                        <a class="me-1 p-1 action-icon Bounce" href="javascript:void(0);"
                                                           title="Cancel Adjustment" data-bs-toggle="modal" data-bs-target="#cancelModal"
                                                           @onclick="() => OpenCancelModal(adjustment)">
                                                            <i class="ti ti-ban"></i>
                                                        </a>
                                                    }
                                                    @if (adjustment.CanEdit)
                                                    {
                                                        <a class="me-1 p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                                           data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                           @onclick="() => OpenDeleteModal(adjustment)">
                                                            <i data-feather="trash-2"></i>
                                                        </a>
                                                    }
                                                    @if (adjustment.CanReverse)
                                                    {
                                                        <a class="p-1 action-icon Bounce" href="javascript:void(0);"
                                                           title="Reverse Adjustment" data-bs-toggle="modal" data-bs-target="#reverseModal"
                                                           @onclick="() => OpenReverseModal(adjustment)">
                                                            <i class="ti ti-arrow-back-up"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@VisibleColumnCount" class="text-center py-4 text-muted">
                                            <i class="ti ti-database-off fs-1 d-block mb-2"></i>
                                            No adjustments found. Click "Create Adjustment" to add one.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                        <div class="d-flex align-items-center">
                            <span class="me-2">Rows per page:</span>
                            <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                                <option value="5" selected="@(PageSize == 5)">5</option>
                                <option value="10" selected="@(PageSize == 10)">10</option>
                                <option value="25" selected="@(PageSize == 25)">25</option>
                                <option value="50" selected="@(PageSize == 50)">50</option>
                            </select>
                            <span class="ms-3 text-muted">
                                Entries
                            </span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = 1; i <= TotalPages; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages || TotalPages == 0 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Submit Modal -->
    <div class="modal fade" id="submitModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-info-transparent mb-2">
                            <i class="ti ti-send fs-24 text-info"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Submit Adjustment</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Are you sure you want to submit <strong>@SelectedAdjustment?.AdjustmentNumber</strong> for approval?
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-info fs-13 fw-medium p-2 px-4" @onclick="SubmitAdjustment" data-bs-dismiss="modal"><i class="ti ti-send me-1"></i>Yes, Submit</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Post Modal -->
    <div class="modal fade" id="postModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                            <i class="ti ti-check fs-24 text-success"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Post Adjustment</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Are you sure you want to post <strong>@SelectedAdjustment?.AdjustmentNumber</strong>?
                        </p>
                        <div class="alert alert-warning mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            Once posted, the adjustment cannot be edited. Any corrections must be made via reversal.
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="PostAdjustment" data-bs-dismiss="modal">
                                <i class="ti ti-check me-1"></i>Yes, Post
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cancel Modal -->
    <div class="modal fade" id="cancelModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                            <i class="ti ti-ban fs-24 text-warning"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Cancel Adjustment</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Are you sure you want to Cancel adjustment <strong>@SelectedAdjustment?.AdjustmentNumber</strong>
                        </p>
                        <div class="mt-3 text-start">
                            <label class="form-label">Cancellation Reason <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="3" @bind="cancelReasonInput" placeholder="Enter reason for cancelling this adjustment..."></textarea>
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Close</button>
                            <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="CancelAdjustment" data-bs-dismiss="modal">
                                <i class="ti ti-ban me-1"></i>Yes, Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reverse Modal -->
    <div class="modal fade" id="reverseModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-arrow-back-up fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Reverse Adjustment</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Are you sure you want to Reverse posted adjustment <strong>@SelectedAdjustment?.AdjustmentNumber</strong>
                        </p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This will create a reversal entry in the GL. The adjustment effect will be nullified.
                        </div>
                        <div class="mt-3 text-start">
                            <label class="form-label">Reversal Reason <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="3" @bind="reverseReasonInput" placeholder="Enter reason for reversing this adjustment..."></textarea>
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Close</button>
                            <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="ReverseAdjustment" data-bs-dismiss="modal">
                                <i class="ti ti-arrow-back-up me-1"></i>Yes, Reverse
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Adjustment</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Are you sure you want to delete <strong>@SelectedAdjustment?.AdjustmentNumber</strong>?
                        </p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This action cannot be undone.
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteAdjustment" data-bs-dismiss="modal">
                                <i class="ti ti-trash me-1"></i>Yes, Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row Details Modal (Mobile) -->
    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Adjustment Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            style="padding:0; right:22px; position:absolute;transform:none"></button>
                </div>
                <div class="modal-body">
                    @if (SelectedAdjustment != null)
                    {
                        <div class="mb-2 d-flex gap-3">
                            <strong>Adjustment No:</strong>
                            <div>@SelectedAdjustment.AdjustmentNumber</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Vendor:</strong>
                            <div>@SelectedAdjustment.VendorCode - @SelectedAdjustment.VendorName</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Type:</strong>
                            <div><span class="badge @GetTypeBadgeClass(SelectedAdjustment.AdjustmentType)">@APAdjustmentTypes.GetDisplayName(SelectedAdjustment.AdjustmentType)</span></div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Date:</strong>
                            <div>@SelectedAdjustment.AdjustmentDate.ToString("dd-MMM-yyyy")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Amount:</strong>
                            <div class="fw-medium">@SelectedAdjustment.CurrencyCode @SelectedAdjustment.AdjustmentAmount.ToString("N2")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Direction:</strong>
                            <div><span class="badge @GetDirectionBadgeClass(SelectedAdjustment.AdjustmentDirection)">@APAdjustmentDirections.GetDisplayName(SelectedAdjustment.AdjustmentDirection)</span></div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Status:</strong>
                            <div><span class="badge @GetStatusBadgeClass(SelectedAdjustment.AdjustmentStatus)">@APAdjustmentStatuses.GetDisplayName(SelectedAdjustment.AdjustmentStatus)</span></div>
                        </div>
                    }
                </div>
                @* <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Close</button>
                    <a href="/ap-adjustment/@SelectedAdjustment?.APAdjustmentId" class="btn btn-info btn-sm">
                        <i class="ti ti-eye me-1"></i>View
                    </a>
                    @if (SelectedAdjustment?.CanEdit == true)
                    {
                        <a href="/create-ap-adjustment/@SelectedAdjustment?.APAdjustmentId" class="btn btn-primary btn-sm">
                            <i class="ti ti-pencil me-1"></i>Edit
                        </a>
                    }
                </div> *@
            </div>
        </div>
    </div>
}
