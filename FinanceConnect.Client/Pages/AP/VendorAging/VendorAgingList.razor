@page "/vendor-aging"

<PageTitle>Vendor Aging Report - FinanceConnect</PageTitle>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Vendor Aging Report</h4>
                    <h6>AP outstanding analysis by aging buckets for payment prioritization</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh Data - Click to reload seed data" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#generateModal"
                        title="Generate a new vendor aging snapshot">
                    <i class="ti ti-player-play me-1"></i>
                    Generate Snapshot
                </button>
            </div>
        </div>

        <!-- Statistics Cards -->

        <div class="row mb-0">
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #f905b9, #f60080) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Total Snapshots</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.TotalSnapshots</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-white rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-camera" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #092c4c, #00396e) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">
                                    Completed
                                </h6>
                                <h5 class="mb-0 fw-bold text-secondary text-white">@Statistics.CompletedSnapshots</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-secondary rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-circle-check text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #ffad00, #ffb137) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Overdue Vendors</h6>
                                <h5 class="mb-0 fw-bold text-info text-white">@Statistics.OverdueVendors</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-info rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-alert-triangle text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(343deg, #009b54, #3eb780) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Failed</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.FailedSnapshots</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-success rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-x text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(343deg, #fe3737, #ff8d21) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">
                                    Net Payable (Total)
                                </h6>
                                <h5 class="mb-0 fw-bold text-warning text-white" style="font-size: 14px;">@Statistics.TotalNetPayable.ToString("N0")</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-warning rounded-circle p-2" style="background: #ffffff47;width: 36px;
                    height: 36px;
                    display: flex;
                    align-items: center;
                    justify-content: center;">
                                <i class="ti ti-currency-rupee text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>






        <!-- Bucket Summary Cards (from latest snapshot) - 8 Buckets -->
        @if (LatestSnapshot != null)
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <span><i class="ti ti-chart-bar me-2"></i>Aging Bucket Summary (As of @LatestSnapshot.AsOfDate.ToString("dd-MMM-yyyy"))</span>
                            <div class="d-flex gap-2 flex-wrap">
                                <span class="badge @GetRunTypeBadgeClass(LatestSnapshot.RunType)">@VendorAgingRunTypes.GetDisplayName(LatestSnapshot.RunType)</span>
                                @if (LatestSnapshot.IncludeOpenCredits)
                                {
                                    <span class="badge bg-info-transparent text-info">Credits Included</span>
                                }
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <div class="row text-center g-2">
                                <div class="col-xl col-lg-3 col-md-4 col-sm-6">
                                    <div class="p-2 bg-success bg-opacity-10 rounded">
                                        <small class="text-muted d-block">Current</small>
                                        <span class="fw-bold text-success">₹ @BucketSummaryViewModel.CurrentNotDueAmount.ToString("N0")</span>
                                        <small class="d-block text-muted">@BucketSummaryViewModel.CurrentNotDueCount bills</small>
                                    </div>
                                </div>
                                <div class="col-xl col-lg-3 col-md-4 col-sm-6">
                                    <div class="p-2 bg-info bg-opacity-10 rounded">
                                        <small class="text-muted d-block">0-30 Days</small>
                                        <span class="fw-bold text-info">₹ @BucketSummaryViewModel.Days0To30Amount.ToString("N0")</span>
                                        <small class="d-block text-muted">@BucketSummaryViewModel.Days0To30Count bills</small>
                                    </div>
                                </div>
                                <div class="col-xl col-lg-3 col-md-4 col-sm-6">
                                    <div class="p-2 bg-warning bg-opacity-10 rounded">
                                        <small class="text-muted d-block">31-60 Days</small>
                                        <span class="fw-bold text-warning">₹ @BucketSummaryViewModel.Days31To60Amount.ToString("N0")</span>
                                        <small class="d-block text-muted">@BucketSummaryViewModel.Days31To60Count bills</small>
                                    </div>
                                </div>
                                <div class="col-xl col-lg-3 col-md-4 col-sm-6">
                                    <div class="p-2 rounded" style="background-color: rgba(255, 165, 0, 0.15);">
                                        <small class="text-muted d-block">61-90 Days</small>
                                        <span class="fw-bold" style="color: #e67300;">₹ @BucketSummaryViewModel.Days61To90Amount.ToString("N0")</span>
                                        <small class="d-block text-muted">@BucketSummaryViewModel.Days61To90Count bills</small>
                                    </div>
                                </div>
                                <div class="col-xl col-lg-3 col-md-4 col-sm-6">
                                    <div class="p-2 rounded" style="background-color: rgba(255, 99, 71, 0.15);">
                                        <small class="text-muted d-block">91-120 Days</small>
                                        <span class="fw-bold" style="color: #ff6347;">₹ @BucketSummaryViewModel.Days91To120Amount.ToString("N0")</span>
                                        <small class="d-block text-muted">@BucketSummaryViewModel.Days91To120Count bills</small>
                                    </div>
                                </div>
                                <div class="col-xl col-lg-3 col-md-4 col-sm-6">
                                    <div class="p-2 rounded" style="background-color: rgba(220, 53, 69, 0.15);">
                                        <small class="text-muted d-block">121-180 Days</small>
                                        <span class="fw-bold text-danger">₹ @BucketSummaryViewModel.Days121To180Amount.ToString("N0")</span>
                                        <small class="d-block text-muted">@BucketSummaryViewModel.Days121To180Count bills</small>
                                    </div>
                                </div>
                                <div class="col-xl col-lg-3 col-md-4 col-sm-6">
                                    <div class="p-2 rounded" style="background-color: rgba(139, 0, 0, 0.15);">
                                        <small class="text-muted d-block">181-365 Days</small>
                                        <span class="fw-bold" style="color: #8b0000;">₹ @BucketSummaryViewModel.Days181To365Amount.ToString("N0")</span>
                                        <small class="d-block text-muted">@BucketSummaryViewModel.Days181To365Count bills</small>
                                    </div>
                                </div>
                                <div class="col-xl col-lg-3 col-md-4 col-sm-6">
                                    <div class="p-2 rounded" style="background-color: rgba(75, 0, 130, 0.15);">
                                        <small class="text-muted d-block">365+ Days</small>
                                        <span class="fw-bold" style="color: #4b0082;">₹ @BucketSummaryViewModel.Days366PlusAmount.ToString("N0")</span>
                                        <small class="d-block text-muted">@BucketSummaryViewModel.Days366PlusCount bills</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Snapshot List -->
        <div class="card">
            <div class="card-header d-flex align-items-end justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm"
                               placeholder="Search by company, branch..."
                               title="Search snapshots by company name, branch name, or date"
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px;align-items: end;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 140px"
                                @bind="selectedRunType" @bind:after="ApplyFilters"
                                title="Filter by Run Type">
                            <option value="">All Run Types</option>
                            @foreach (var runType in DistinctRunTypes)
                            {
                                <option value="@runType">@VendorAgingRunTypes.GetDisplayName(runType)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 140px"
                                @bind="selectedStatus" @bind:after="ApplyFilters"
                                title="Filter by Status">
                            <option value="">All Status</option>
                            @foreach (var status in DistinctStatuses)
                            {
                                <option value="@status">@VendorAgingRunStatuses.GetDisplayName(status)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2 filter-date">
                        <label class="form-label">From</label>
                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="FromDate" @bind:after="ApplyFilters" title="From Date" />
                    </div>
                    <div class="ms-2 filter-date">
                        <label class="form-label">To</label>

                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="ToDate" @bind:after="ApplyFilters" title="To Date" />
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th style="min-width:110px">As Of Date</th>
                                @* <th class="d-none d-xl-table-cell" style="min-width:110px">Run Type</th> *@
                                <th class="d-none d-md-table-cell" title="Company / Branch" style="min-width:200px">Company / Branch</th>
                                @* <th class="d-none d-xl-table-cell text-center" style="min-width:80px">Vendors</th> *@
                                <th class="d-none d-xxl-table-cell text-end" style="min-width:140px">Net Payable</th>
                                <th class="d-none d-md-table-cell text-left" style="min-width:100px">Status</th>
                                <th class="d-none d-xl-table-cell" style="min-width:145px">Generated On</th>
                                <th class=" pe-4" style="min-width:130px">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedSnapshots.Any())
                            {
                                @foreach (var snapshot in PagedSnapshots)
                                {
                                    <tr>
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal" data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(snapshot)"
                                               title="View details">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>
                                        <td class="fw-medium text-nowrap">
                                            <span>
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>

                                                <a href="/vendor-aging/@snapshot.VendorAgingId" class="text-decoration-none link-View"
                                                   title="Click to view aging details for @snapshot.AsOfDate.ToString("dd-MMM-yyyy")" data-bs-toggle="tooltip">
                                                    @snapshot.AsOfDate.ToString("dd-MMM-yyyy")
                                                </a>
                                            </span>
                                        </td>
                                        @* <td class="d-none d-xl-table-cell ">
                                            <span class="badge @GetRunTypeBadgeClass(snapshot.RunType)"
                                                  data-bs-toggle="tooltip"
                                                  title="@VendorAgingRunTypes.GetDisplayName(snapshot.RunType)">

                                                <i class="@GetRunTypeIcon(snapshot.RunType)"></i>

                                            </span>
                                        </td> *@

                                        <td class="d-none d-md-table-cell">
                                            <div class="fw-medium"  style="max-width:200px;">@snapshot.CompanyName</div>
                                            <small class="text-muted" >@(snapshot.BranchName ?? "All Branches")</small>
                                        </td>
                                        @* <td class="d-none d-xl-table-cell text-center" title="@snapshot.RecordCountVendors">@snapshot.RecordCountVendors</td> *@
                                        <td class="d-none d-xxl-table-cell text-end fw-medium text-nowrap" >
                                            @IndianNumberFormatter.Format(
                                            snapshot.VendorRows.Sum(r => r.NetPayableAmount))


                            </td>
                            @* <td class="d-none d-md-table-cell text-center" style="text-overflow:inherit">
                                            <span class="badge @GetStatusBadgeClass(snapshot.RunStatus)">@VendorAgingRunStatuses.GetDisplayName(snapshot.RunStatus)</span>
                                        </td> *@

                            <td class="d-none d-md-table-cell">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="ActiveDot @GetStatusDotBadgeClass(snapshot.RunStatus)">
                                    </div>
                                    <span>@VendorAgingRunStatuses.GetDisplayName(snapshot.RunStatus)</span>
                                </div>
                            </td>
                            <td class="d-none d-xl-table-cell text-nowrap">
                                <div class="d-flex flex-column gap-1">
                                    <span style="color:black;font-weight:500">@snapshot.GeneratedAt.ToString("dd-MMM-yyy")</span>
                                    <span>@snapshot.GeneratedAt.ToString("HH:mm")</span>
                                </div>
                            </td>
                            <td class="action-table-data pe-4">
                                <div class="edit-delete-action d-flex justify-content-start gap-2">
                                    <a class="p-1 view-icon" href="/vendor-aging/@snapshot.VendorAgingId"
                                       title="View Details">
                                        <i data-feather="eye"></i>
                                    </a>
                                    @if (snapshot.CanRegenerate)
                                                {
                                                    <a class="p-1 action-icon refresh" href="javascript:void(0);"
                                                       title="Retry Generation" data-bs-toggle="modal" data-bs-target="#retryModal"
                                                       @onclick="() => OpenRetryModal(snapshot)">
                                                        <i class="ti ti-refresh"></i>
                                                    </a>
                                                }
                                                @if (snapshot.RunStatus == VendorAgingRunStatuses.Failed)
                                                {
                                                    <a class="p-1 action-icon delete-icon" href="javascript:void(0);"
                                                       title="Delete Failed Snapshot" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                       @onclick="() => OpenDeleteModal(snapshot)">
                                                        <i class="ti ti-trash"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center py-4">
                                        <i class="ti ti-camera-off fs-1 text-muted d-block mb-2"></i>
                                        No vendor aging snapshots found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (TotalPages > 0)
            {
                <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                    <div class="d-flex align-items-center">
                        <span class="me-2">Rows per page:</span>
                        <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                            <option value="5" selected="@(PageSize == 5)">5</option>
                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                        <span class="ms-3 text-muted">
                            Entries
                        </span>
                    </div>
                    @* <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">
                            Showing @(((CurrentPage - 1) * PageSize) + 1) to @Math.Min(CurrentPage * PageSize, FilteredSnapshots.Count) of @FilteredSnapshots.Count entries
                        </span>
                    </div> *@
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage"><i class="ti ti-chevron-left"></i></a>
                            </li>
                            @for (int i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(pageNum == CurrentPage ? "active" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="NextPage"><i class="ti ti-chevron-right"></i></a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>

    <!-- Generate Snapshot Modal -->
    <div class="modal fade list-popup" id="generateModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="ti ti-player-play me-2"></i>Generate Vendor Aging Snapshot</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" style="    padding: 0;
            right: 22px;
            position: absolute;
            transform: none;
        "></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">As Of Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control @(generateValidationErrors.ContainsKey("AsOfDate") ? "is-invalid" : "")" @bind="generateAsOfDate"
                               title="Select the date for which to generate the aging snapshot" />
                        @if (generateValidationErrors.ContainsKey("AsOfDate"))
                        {
                            <span class="text-danger" style="font-size: 11px; margin-top: 2px;">@generateValidationErrors["AsOfDate"]</span>
                        }
                        else
                        {
                            <small class="text-muted">Snapshot will be computed based on payables as of this date</small>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Run Type <span class="text-danger">*</span></label>
                        <select class="form-select @(generateValidationErrors.ContainsKey("RunType") ? "is-invalid" : "")" @bind="generateRunType"
                                title="Select the type of aging run">
                            <option value="">--Select Run Type--</option>
                            @foreach (var runType in VendorAgingRunTypes.All)
                            {
                                <option value="@runType">@VendorAgingRunTypes.GetDisplayName(runType)</option>
                            }
                        </select>
                        @if (generateValidationErrors.ContainsKey("RunType"))
                        {
                            <span class="text-danger" style="font-size: 11px; margin-top: 2px;">@generateValidationErrors["RunType"]</span>
                        }
                        else
                        {
                            <small class="text-muted">Month-End Final runs are locked after completion for audit</small>
                        }
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="includeCreditsSwitch"
                                   @bind="generateIncludeCredits"
                                   title="Include open credits and advances in the calculation" />
                            <label class="form-check-label" for="includeCreditsSwitch">Include Open Credits</label>
                        </div>
                        <small class="text-muted">Include unapplied credit notes and advances in Net Payable calculation</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Branch <small class="text-muted">(Optional)</small></label>
                        <select class="form-select" @bind="generateBranchId"
                                title="Optionally filter by branch. Leave blank for all branches.">
                            <option value="">--Select Branch-- (All Branches)</option>
                            @foreach (var branch in Branches)
                            {
                                <option value="@branch.Id">@branch.BranchCode - @branch.BranchName</option>
                            }
                        </select>
                        <small class="text-muted">Leave blank to include all branches</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Vendor <small class="text-muted">(Optional)</small></label>
                        <select class="form-select" @bind="generateVendorId"
                                title="Optionally filter by a specific vendor. Leave blank for all vendors.">
                            <option value="">--Select Vendor-- (All Vendors)</option>
                            @foreach (var vendor in Vendors)
                            {
                                <option value="@vendor.Id">@vendor.VendorCode - @vendor.VendorName</option>
                            }
                        </select>
                        <small class="text-muted">Leave blank to include all active vendors</small>
                    </div>
                    <div class="alert alert-info small">
                        <i class="ti ti-info-circle me-2"></i>
                        Snapshot generation will analyze all posted vendor bills with outstanding balance and categorize them into 8 aging buckets.
                    </div>
                </div>
                <div class="modal-footer gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="ti ti-x"></i> Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="GenerateSnapshot">
                        <i class="ti ti-player-play me-1"></i>Generate
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Retry Modal -->
    <div class="modal fade" id="retryModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                            <i class="ti ti-refresh fs-24 text-warning"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Retry Snapshot Generation</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Are you sure you want to retry the failed snapshot for <strong>@SelectedSnapshot?.AsOfDate.ToString("dd-MMM-yyyy")</strong>?
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Close</button>
                            <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="RetrySnapshot" data-bs-dismiss="modal">
                                <i class="ti ti-refresh me-1"></i>Yes, Retry
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Failed Snapshot</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Are you sure you want to delete the failed snapshot for <strong>@SelectedSnapshot?.AsOfDate.ToString("dd-MMM-yyyy")</strong>?
                        </p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This action cannot be undone.
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x"></i>Cancel</button>
                            <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteSnapshot" data-bs-dismiss="modal">
                                <i class="ti ti-trash me-1"></i>Yes, Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row Details Modal (Mobile) -->
    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Vendor Aging Snapshot Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" style="padding:0; right:22px; position:absolute;transform:none"></button>
                </div>
                <div class="modal-body">
                    @if (SelectedSnapshot != null)
                    {
                        <div class="mb-2 d-flex gap-3">
                            <strong>As Of Date:</strong>
                            <div>@SelectedSnapshot.AsOfDate.ToString("dd-MMM-yyyy")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Run Type:</strong>
                            <div><span class="badge @GetRunTypeBadgeClass(SelectedSnapshot.RunType)">@VendorAgingRunTypes.GetDisplayName(SelectedSnapshot.RunType)</span></div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Company:</strong>
                            <div>@SelectedSnapshot.CompanyName</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Branch:</strong>
                            <div>@(SelectedSnapshot.BranchName ?? "All Branches")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Vendors:</strong>
                            <div>@SelectedSnapshot.RecordCountVendors</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Net Payable:</strong>
                            <div class="fw-medium">@(SelectedSnapshot.CurrencyCode ?? "₹") @SelectedSnapshot.VendorRows.Sum(r => r.NetPayableAmount).ToString("N2")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Status:</strong>
                            <div><span class="badge @GetStatusBadgeClass(SelectedSnapshot.RunStatus)">@VendorAgingRunStatuses.GetDisplayName(SelectedSnapshot.RunStatus)</span></div>
                        </div>
                    }
                </div>
                @* <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Close</button>
                    <a href="/vendor-aging/@SelectedSnapshot?.VendorAgingId" class="btn btn-info btn-sm">
                        <i class="ti ti-eye me-1"></i>View
                    </a>
                </div> *@
            </div>
        </div>
    </div>
}
