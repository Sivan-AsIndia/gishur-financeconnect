@page "/File-Manager/Folder/{FolderId:int}"
@using System.Collections.Generic
@using System.Linq
@using System.Threading
@inject FileManagerService State
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(Folder?.Name ?? "Folder") – File Manager</PageTitle>

<style>
    .fd-topbar {
        display: flex; align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: 12px; margin-bottom: 24px;
    }
    .fd-breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 13px; flex-wrap: wrap; }
    .fd-breadcrumb a {
        color: #475569; text-decoration: none; font-weight: 500;
        transition: color .15s; cursor: pointer;
    }
    .fd-breadcrumb a:hover { color: var(--primary); }
    .fd-breadcrumb-sep { color: #cbd5e1; font-size: 18px; line-height: 1; }
    .fd-breadcrumb-cur { color: var(--primary); font-weight: 700; font-size: 14px; }

    .fd-banner {
        border-radius: 14px; padding: 32px 36px; margin-bottom: 24px;
        position: relative; overflow: hidden; display: flex; align-items: center; gap: 28px;
    }
    .fd-banner::before {
        content: ''; position: absolute; top: -40px; right: -40px;
        width: 200px; height: 200px; border-radius: 50%; background: rgba(255,255,255,.08);
    }
    .fd-banner::after {
        content: ''; position: absolute; bottom: -60px; right: 80px;
        width: 260px; height: 260px; border-radius: 50%; background: rgba(255,255,255,.05);
    }
    .fd-banner-icon {
        width: 72px; height: 72px; border-radius: 18px;
        background: rgba(255,255,255,.18); backdrop-filter: blur(8px);
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        border: 1.5px solid rgba(255,255,255,.25);
    }
    .fd-banner-title { font-size: 26px; font-weight: 700; color: #fff; margin: 0 0 8px; line-height: 1.2; }
    .fd-banner-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .fd-banner-chip {
        display: inline-flex; align-items: center; gap: 5px;
        background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.2);
        border-radius: 8px; padding: 4px 12px; font-size: 12px;
        color: rgba(255,255,255,.9); font-weight: 500;
    }
    .fd-progress-wrap { margin-top: 14px; max-width: 320px; }
    .fd-progress-track { height: 5px; border-radius: 99px; background: rgba(255,255,255,.2); overflow: hidden; }
    .fd-progress-fill { height: 100%; border-radius: 99px; background: rgba(255,255,255,.85); transition: width .6s; }
    .fd-star-btn {
        margin-left: auto; z-index: 1; background: rgba(255,255,255,.15);
        border: 1.5px solid rgba(255,255,255,.25); border-radius: 12px;
        width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
        cursor: pointer; transition: all .2s; flex-shrink: 0; color: rgba(255,255,255,.7);
    }
    .fd-star-btn:hover { background: rgba(255,255,255,.25); }
    .fd-star-btn.starred { color: #fbbf24; }

    .fd-stats { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; margin-bottom: 24px; }
    @@media(max-width:992px) { .fd-stats { grid-template-columns: repeat(2,1fr); } }
    .fd-stat-card {
        background: #fff; border-radius: 14px; padding: 20px 22px;
        display: flex; align-items: center; gap: 16px; transition: transform .18s, box-shadow .18s;
    }
    .fd-stat-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .fd-stat-val { font-size: 24px; font-weight: 700; color: #0f172a; line-height: 1; margin-bottom: 3px; font-family: 'DM Mono', monospace; }
    .fd-stat-label { font-size: 11px; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }

    .fd-main-row { display: grid; grid-template-columns: 1fr 320px; gap: 20px; align-items: start; }
    @@media(max-width:1100px) { .fd-main-row { grid-template-columns: 1fr; } }

    .fd-files-card { background: #fff; border-radius: 14px; overflow: hidden; }
    .fd-toolbar {
        display: flex; align-items: center; gap: 10px; padding: 18px 22px;
        border-bottom: 1px solid #f1f5f9; flex-wrap: wrap;
    }
    .fd-toolbar-title { font-size: 15px; font-weight: 700; color: #0f172a; margin-right: auto; display: flex; align-items: center; gap: 8px; }
    .fd-toolbar-count { background: #f1f5f9; color: #64748b; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 20px; }
    .fd-search { display: flex; align-items: center; gap: 7px; border: 1.5px solid #e2e8f0; border-radius: 10px; padding: 7px 14px; min-width: 190px; transition: border-color .18s; }
    .fd-search:focus-within { border-color: var(--primary); }
    .fd-search input { background: none; border: none; outline: none; font-size: 13px; color: #1e293b; width: 100%; }
    .fd-search input::placeholder { color: #94a3b8; }
    .fd-toggle { display: flex; gap: 4px; }
    .fd-toggle-btn { width: 36px; height: 36px; border-radius: 9px; display: flex; align-items: center; justify-content: center; border: 1.5px solid #e2e8f0; background: #f8fafc; cursor: pointer; color: #94a3b8; transition: all .15s; font-size: 14px; }
    .fd-toggle-btn.active { background: var(--primary); border-color: var(--primary); color: #fff; }
    .fd-toggle-btn:hover:not(.active) { border-color: var(--primary); color: var(--primary); background: #f5f3ff; }

    .fd-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(155px,1fr)); gap: 14px; padding: 22px; }
    .fd-file-card {
        background: #f8fafc; border: 1.5px solid #e9eef6; border-radius: 16px;
        padding: 20px 16px 16px; text-align: center; cursor: pointer;
        position: relative; transition: all .2s;
    }
    .fd-file-card:hover { border-color: var(--primary); background: #fff; box-shadow: 0 8px 24px rgba(79,70,229,.12); transform: translateY(-3px); }
    .fd-folder-card:hover { border-color: var(--primary); }

    .fd-file-badge { width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; font-size: 11px; font-weight: 800; font-family: 'DM Mono', monospace; letter-spacing: .5px; }
    .fd-file-name { font-size: 12px; font-weight: 600; color: #1e293b; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fd-file-size { font-size: 11px; color: #94a3b8; font-family: 'DM Mono', monospace; }
    .fd-file-date { font-size: 10px; color: #b8c4d4; margin-top: 2px; }
    .fd-file-star { position: absolute; top: 10px; right: 10px; background: none; border: none; cursor: pointer; color: #cbd5e1; font-size: 13px; padding: 2px; transition: color .15s; }
    .fd-file-star:hover, .fd-file-star.starred { color: #f59e0b; }

    .fd-table { width: 100%; border-collapse: collapse; }
    .fd-table thead th { padding: 11px 16px; background: #f8fafc; font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .7px; border-bottom: 1px solid #f1f5f9; }
    .fd-table thead th:first-child { padding-left: 22px; }
    .fd-table thead th:last-child { padding-right: 22px; text-align: right; }
    .fd-table tbody tr { cursor: pointer; transition: background .12s; }
    .fd-table tbody tr:hover { background: #f8fafc; }
    .fd-table tbody td { padding: 12px 16px; font-size: 13px; color: #475569; border-bottom: 1px solid #f1f5f9; }
    .fd-table tbody tr:last-child td { border-bottom: none; }
    .fd-table tbody td:first-child { padding-left: 22px; }
    .fd-table tbody td:last-child { padding-right: 22px; text-align: right; }
    .fd-row-name { font-weight: 600; color: #0f172a; font-size: 13px; }
    .fd-row-ext { font-size: 11px; color: #94a3b8; text-transform: uppercase; font-family: 'DM Mono', monospace; }
    .fd-ext-pill { display: inline-block; padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; font-family: 'DM Mono', monospace; }
    .fd-act { width: 30px; height: 30px; border-radius: 8px; border: none; background: #f1f5f9; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; font-size: 13px; color: #94a3b8; transition: all .15s; }
    .fd-act:hover { background: #e0e7ff; color: var(--primary); }
    .fd-act.del:hover { background: #fee2e2; color: #ef4444; }
    .fd-act.star:hover, .fd-act.star.starred { color: #f59e0b; background: #fef3c7; }

    .fd-empty { padding: 64px 32px; text-align: center; }
    .fd-empty-icon { width: 80px; height: 80px; border-radius: 24px; background: #f1f5f9; margin: 0 auto 20px; display: flex; align-items: center; justify-content: center; font-size: 32px; color: #cbd5e1; }
    .fd-empty h6 { font-size: 16px; font-weight: 700; color: #1e293b; margin-bottom: 6px; }
    .fd-empty p { font-size: 13px; color: #94a3b8; margin-bottom: 18px; }

    .fd-sidebar { display: flex; flex-direction: column; gap: 16px; height: 100%; }
    .fd-upload-card, .fd-subfolder-card { background: #fff; border-radius: 14px; overflow: hidden; }
    .fd-card-head { padding: 16px 20px 14px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; }
    .fd-card-title { font-size: 14px; font-weight: 700; color: #0f172a; display: flex; align-items: center; gap: 8px; }
    .fd-upload-hints { display: flex; gap: 8px; padding: 0 16px 16px; }
    .fd-upload-hint { flex: 1; background: #f8fafc; border-radius: 10px; padding: 10px 8px; text-align: center; }
    .fd-upload-hint-label { font-size: 10px; color: #94a3b8; font-weight: 600; margin-bottom: 3px; text-transform: uppercase; letter-spacing: .4px; }
    .fd-upload-hint-val { font-size: 12px; font-weight: 700; }
    .fd-subfolder-list { padding: 0 16px 16px; display: flex; flex-direction: column; gap: 8px; }
    .fd-sub-chip { display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: #f8fafc; border-radius: 10px; border: 1.5px solid #e9eef6; cursor: pointer; transition: all .18s; }
    .fd-sub-chip:hover { border-color: var(--primary); background: #f5f3ff; }
    .fd-sub-chip-icon { width: 32px; height: 32px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .fd-sub-chip-name { font-size: 12px; font-weight: 600; color: #1e293b; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fd-sub-chip-count { font-size: 10px; color: #94a3b8; font-family: 'DM Mono', monospace; }
    .fd-sub-chip-del { background: none; border: none; color: #cbd5e1; cursor: pointer; font-size: 13px; padding: 0 2px; transition: color .15s; }
    .fd-sub-chip-del:hover { color: #ef4444; }

    .fd-modal-overlay { position: fixed; inset: 0; background: rgba(15,23,42,.55); z-index: 1040; backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; padding: 20px; animation: fdFadeIn .2s ease; }
    @@keyframes fdFadeIn { from { opacity:0 } to { opacity:1 } }
    @@keyframes fdSlideUp { from { opacity:0; transform: translateY(24px) } to { opacity:1; transform: translateY(0) } }

    .fd-create-modal { background: #fff; border-radius: 20px; width: 100%; max-width: 440px; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,.22); animation: fdSlideUp .25s ease; }
    .fd-cm-head { padding: 24px 24px 0; display: flex; align-items: center; justify-content: space-between; }
    .fd-cm-head-icon { width: 44px; height: 44px; border-radius: 12px; background: color-mix(in srgb,var(--primary) 11%,white); display: flex; align-items: center; justify-content: center; }
    .fd-cm-close { width: 32px; height: 32px; border-radius: 8px; background: #f1f5f9; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 16px; transition: all .15s; }
    .fd-cm-close:hover { background: #e2e8f0; }
    .fd-cm-title { font-size: 18px; font-weight: 700; color: #0f172a; margin: 16px 24px 4px; }
    .fd-cm-sub { font-size: 13px; color: #94a3b8; margin: 0 24px 20px; }
    .fd-cm-body { padding: 0 24px 24px; }
    .fd-cm-label { font-size: 12px; font-weight: 600; color: #475569; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 8px; }
    .fd-cm-input { width: 100%; padding: 12px 16px; border: 1.5px solid #e2e8f0; border-radius: 12px; font-size: 14px; color: #0f172a; outline: none; transition: border-color .18s; box-sizing: border-box; }
    .fd-cm-input:focus { border-color: var(--primary); background: #fafafe; box-shadow: 0 0 0 3px rgba(79,70,229,.08); }
    .fd-cm-input::placeholder { color: #b0bec5; }
    .fd-cm-colors { display: flex; gap: 10px; flex-wrap: wrap; margin: 16px 0 20px; }
    .fd-cm-dot { width: 30px; height: 30px; border-radius: 50%; cursor: pointer; border: 3px solid transparent; transition: transform .15s, border-color .15s; }
    .fd-cm-dot:hover { transform: scale(1.15); }
    .fd-cm-dot.selected { border-color: #0f172a; transform: scale(1.15); }
    .fd-cm-footer { display: flex; gap: 10px; }

    .fd-upload-modal { background: #fff; border-radius: 20px; width: 100%; max-width: 500px; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,.22); animation: fdSlideUp .25s ease; }
    .fd-um-head { padding: 18px 24px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f1f5f9; }
    .fd-um-folder-pill { display: flex; align-items: center; gap: 10px; }
    .fd-um-folder-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .fd-um-folder-name { font-size: 14px; font-weight: 700; color: #0f172a; }
    .fd-um-folder-path { font-size: 11px; color: #94a3b8; }
    .fd-um-close { width: 32px; height: 32px; border-radius: 8px; background: #f1f5f9; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 16px; transition: all .15s; }
    .fd-um-close:hover { background: #e2e8f0; }
    .fd-um-steps { display: flex; align-items: center; padding: 20px 32px 0; }
    .fd-um-step { display: flex; flex-direction: column; align-items: center; flex: 1; position: relative; }
    .fd-um-step:not(:last-child)::after { content: ''; position: absolute; top: 16px; left: calc(50% + 18px); width: calc(100% - 36px); height: 2px; background: #e2e8f0; border-radius: 2px; z-index: 0; }
    .fd-um-step.done:not(:last-child)::after, .fd-um-step.active:not(:last-child)::after { background: var(--primary); }
    .fd-um-step-circle { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; z-index: 1; border: 2px solid #e2e8f0; background: #fff; color: #94a3b8; transition: all .3s; }
    .fd-um-step.active .fd-um-step-circle, .fd-um-step.done .fd-um-step-circle { border-color: var(--primary); background: var(--primary); color: #fff; }
    .fd-um-step-label { font-size: 10px; font-weight: 600; color: #94a3b8; margin-top: 6px; text-transform: uppercase; letter-spacing: .4px; text-align: center; }
    .fd-um-step.active .fd-um-step-label, .fd-um-step.done .fd-um-step-label { color: var(--primary); }
    .fd-um-body { padding: 24px; min-height: 230px; }
    .fd-um-dropzone { border: 2px dashed var(--primary); background: color-mix(in srgb,var(--primary) 10%,white); border-radius: 16px; padding: 36px 24px; text-align: center; cursor: pointer; transition: all .2s; position: relative; margin-bottom: 14px; display: block; }
    .fd-um-dropzone:hover { border-color: var(--primary); background: white; }
    .fd-um-dropzone input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
    .fd-um-dz-icon { width: 60px; height: 60px; border-radius: 50%; background: color-mix(in srgb,var(--primary) 29%,white); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
    .fd-um-uploading-list { display: flex; flex-direction: column; gap: 14px; }
    .fd-um-uitem { background: #f8fafc; border-radius: 12px; padding: 14px 16px; }
    .fd-um-uitem-row { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
    .fd-um-uitem-icon { width: 36px; height: 36px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 800; flex-shrink: 0; font-family: 'DM Mono', monospace; }
    .fd-um-uitem-name { font-size: 13px; font-weight: 600; color: #0f172a; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fd-um-uitem-pct { font-size: 12px; font-weight: 700; font-family: 'DM Mono', monospace; flex-shrink: 0; }
    .fd-um-bar { height: 6px; border-radius: 99px; background: #e0e7ff; overflow: hidden; }
    .fd-um-bar-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg,var(--primary),#8b5cf6); transition: width .25s ease; }
    .fd-um-done { text-align: center; padding: 8px 0; }
    .fd-um-done-icon { width: 72px; height: 72px; border-radius: 50%; background: #d1fae5; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
    .fd-um-done-files { display: flex; flex-direction: column; gap: 8px; margin-top: 18px; max-height: 180px; overflow-y: auto; }
    .fd-um-done-row { display: flex; align-items: center; gap: 10px; background: #f8fafc; border-radius: 10px; padding: 10px 14px; }
    .fd-um-done-badge { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 8px; font-weight: 800; flex-shrink: 0; font-family: 'DM Mono', monospace; }
    .fd-um-done-name { font-size: 12px; font-weight: 600; color: #0f172a; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fd-um-done-size { font-size: 11px; color: #94a3b8; font-family: 'DM Mono', monospace; flex-shrink: 0; }
    .fd-um-check { color: #10b981; flex-shrink: 0; }
    .fd-um-footer { padding: 0 24px 24px; display: flex; gap: 10px; }

    /* OFFCANVAS */
    .fd-oc-backdrop { position: fixed; inset: 0; background: rgba(15,23,42,.38); z-index: 1045; animation: fdFadeIn .2s ease; }
    .fd-prev-text { white-space: normal; word-break: break-word; overflow-wrap: anywhere; }
    .fd-prev-none { display: flex; flex-direction: column; align-items: center; width: 100%; height: 100%; justify-content: center; }
    .fd-offcanvas { position: fixed; top: 0; right: 0; bottom: 0; width: 395px; background: #fff; z-index: 1050; display: flex; flex-direction: column; box-shadow: -8px 0 48px rgba(0,0,0,.18); animation: fdOcSlide .28s cubic-bezier(.4,0,.2,1); }
    @@keyframes fdOcSlide { from { transform: translateX(100%) } to { transform: translateX(0) } }
    .fd-oc-head { padding: 18px 22px; background: #0f172a; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
    .fd-oc-title { font-size: 15px; font-weight: 700; color: #fff; }
    .fd-oc-hacts { display: flex; gap: 6px; }
    .fd-oc-hbtn { width: 34px; height: 34px; border-radius: 9px; background: rgba(255,255,255,.09); border: 1px solid rgba(255,255,255,.14); display: flex; align-items: center; justify-content: center; cursor: pointer; color: rgba(255,255,255,.6); font-size: 15px; transition: all .15s; }
    .fd-oc-hbtn:hover { background: rgba(255,255,255,.18); color: #fff; }
    .fd-oc-hbtn.starred { color: #fbbf24; }
    .fd-oc-hbtn.del:hover { background: #ff000040; color: red; }
    .fd-oc-thumb { padding: 30px 22px 22px; text-align: center; background: linear-gradient(180deg,#f8fafc,#fff); border-bottom: 1px solid #f1f5f9; flex-shrink: 0; }
    .fd-oc-badge { width: 80px; height: 80px; border-radius: 20px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-size: 14px; font-weight: 800; font-family: 'DM Mono', monospace; }
    .fd-oc-fname { font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 4px; word-break: break-word; }
    .fd-oc-fmeta { font-size: 12px; color: #94a3b8; }
    .fd-oc-body { padding: 20px 22px; flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 20px; }
    .fd-oc-section { font-size: 10px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .7px; margin-bottom: 10px; }
    .fd-info-grid { display: grid; grid-template-columns: repeat(3,1fr); border: 1.5px solid #e9eef6; border-radius: 14px; overflow: hidden; text-align: center; }
    .fd-info-cell + .fd-info-cell { border-left: 1px solid #e9eef6; }
    .fd-info-cell { padding: 14px 8px; }
    .fd-info-label { font-size: 10px; color: #94a3b8; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 4px; font-weight: 600; }
    .fd-info-val { font-size: 13px; font-weight: 700; color: #0f172a; font-family: 'DM Mono', monospace; }
    .fd-oc-dl-box { background: linear-gradient(135deg,color-mix(in srgb,var(--primary) 11%,white),color-mix(in srgb,var(--primary) 11%,white)); border: 1.5px solid var(--primary); border-radius: 14px; padding: 18px; }
    .fd-oc-dl-title { font-size: 13px; font-weight: 700; color: #0f172a; margin-bottom: 12px; display: flex; align-items: center; gap: 7px; }
    .fd-oc-dl-file-row { display: flex; align-items: center; gap: 12px; background: #fff; border-radius: 10px; padding: 12px 14px; border: 1px solid #e0e7ff; margin-bottom: 12px; }
    .fd-oc-dl-icon { width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 800; font-family: 'DM Mono', monospace; flex-shrink: 0; }
    .fd-oc-dl-info { flex: 1; min-width: 0; }
    .fd-oc-dl-name { font-size: 13px; font-weight: 600; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fd-oc-dl-size { font-size: 11px; color: #94a3b8; font-family: 'DM Mono', monospace; margin-top: 1px; }
    .fd-oc-dl-btn { width: 36px; height: 36px; background: var(--primary); border: none; color: #fff; border-radius: 9px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 16px; transition: all .18s; flex-shrink: 0; }
    .fd-oc-dl-btn:hover { color: var(--primary); background: color-mix(in srgb,var(--primary) 11%,white); transform: scale(1.1); }
    .fd-oc-dl-note { font-size: 11px; color: #6366f1; text-align: center; }
    .fd-share-box { background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 12px 16px; display: flex; align-items: center; gap: 10px; }
    .fd-share-link { font-size: 11px; color: #64748b; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-family: 'DM Mono', monospace; }
    .fd-share-copy { background: var(--primary); border: none; color: #fff; border-radius: 8px; padding: 6px 14px; font-size: 12px; font-weight: 600; cursor: pointer; transition: all .15s; flex-shrink: 0; }
    .fd-share-copy:hover { background: #4338ca; }
    .fd-oc-footer { padding: 16px 22px 22px; display: flex; gap: 10px; flex-shrink: 0; border-top: 1px solid #f1f5f9; }

    .fd-toast { position: fixed; bottom: 24px; right: 24px; z-index: 9999; min-width: 280px; padding: 14px 18px; border-radius: 14px; display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; box-shadow: 0 8px 30px rgba(0,0,0,.15); animation: toastIn .25s ease; }
    @@keyframes toastIn { from { opacity:0; transform: translateY(12px) } to { opacity:1; transform: translateY(0) } }
    .fd-toast-ok  { background: #0f172a; color: #fff; }
    .fd-toast-err { background: #ef4444; color: #fff; }
    .fd-toast-close { margin-left: auto; background: none; border: none; color: rgba(255,255,255,.6); cursor: pointer; font-size: 15px; padding: 0; }
    .fd-toast-close:hover { color: #fff; }
</style>

@if (Folder == null)
{
    <div class="d-flex align-items-center justify-content-center" style="min-height:50vh">
        <div class="text-center">
            <div class="fd-empty-icon mx-auto"><i class="ti ti-folder-off"></i></div>
            <h6 style="font-weight:700">Folder not found</h6>
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/File-Manager")'>
                <i class="ti ti-arrow-left me-1"></i> Back
            </button>
        </div>
    </div>
}
else
{
    <div class="content mb-4">

        <!-- TOPBAR -->
        <div class="fd-topbar">
            <nav class="fd-breadcrumb">
                <a @onclick='() => Navigation.NavigateTo("/File-Manager")'>
                    <i class="ti ti-home fs-12 me-1"></i>File Manager
                </a>
                @foreach (var crumb in GetBreadcrumbs())
                {
                    <span class="fd-breadcrumb-sep">›</span>
                    @if (crumb.Id == FolderId)
                    {
                        <span class="fd-breadcrumb-cur">@crumb.Name</span>
                    }
                    else
                    {
                        var cid = crumb.Id;
                        <!-- FIX: @onclick NavigateTo replaces broken href string interpolation -->
                        <a  @onclick='() => Navigation.NavigateTo($"/File-Manager/Folder/{cid}")'>@crumb.Name</a>
                    }
                }
            </nav>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" style="font-size:12px;font-weight:700" @onclick="OpenCreateModal">
                    <i class="ti ti-folder-plus fs-13 me-1"></i> New Folder
                </button>
                <button class="btn btn-outline-secondary" @onclick="GoBack">
                    <i class="ti ti-arrow-left fs-13 me-1"></i> Back
                </button>
            </div>
        </div>

        <!-- BANNER -->
        <div class="fd-banner" style="background:linear-gradient(135deg,@Folder.Color 0%,@DarkenHex(Folder.Color) 100%);">
            <div class="fd-banner-icon"><i class="ti ti-folder-filled text-white" style="font-size:34px"></i></div>
            <div style="flex:1;min-width:0;position:relative;z-index:1">
                <h2 class="fd-banner-title">@Folder.Name</h2>
                <div class="fd-banner-meta">
                    <span class="fd-banner-chip"><i class="ti ti-files fs-11"></i> @FolderFiles.Count files</span>
                    <span class="fd-banner-chip"><i class="ti ti-folders fs-11"></i> @SubFolders.Count sub-folders</span>
                    <span class="fd-banner-chip"><i class="ti ti-database fs-11"></i> @Folder.Size / @Folder.Total GB</span>
                </div>
                <div class="fd-progress-wrap">
                    <div style="display:flex;justify-content:space-between;margin-bottom:5px">
                        <span style="font-size:11px;color:rgba(255,255,255,.7)">Storage used</span>
                        <span style="font-size:11px;color:#fff;font-weight:700">@((Folder.Size / Folder.Total * 100).ToString("F0"))%</span>
                    </div>
                    <div class="fd-progress-track">
                        <div class="fd-progress-fill" style="width:@((Folder.Size / Folder.Total * 100).ToString("F0"))%"></div>
                    </div>
                </div>
            </div>
            <button class="fd-star-btn @(Folder.Starred ? "starred" : "")" @onclick="ToggleFolderStar">
                <i class="@(Folder.Starred ? "ti ti-star-filled" : "ti ti-star") fs-18"></i>
            </button>
        </div>

        <!-- STATS -->
        <div class="fd-stats">
            @foreach (var s in FolderStats)
            {
                <div class="fd-stat-card">
                    <div class="fd-stat-icon" style="background:@s.Bg">
                        <i class="@s.Icon" style="color:@s.Color;font-size:20px"></i>
                    </div>
                    <div>
                        <div class="fd-stat-val">@s.Value</div>
                        <div class="fd-stat-label">@s.Label</div>
                    </div>
                </div>
            }
        </div>

        <!-- MAIN ROW -->
        <div class="fd-main-row">

            <!-- FILES CARD -->
            <div class="fd-files-card">
                <div class="fd-toolbar">
                    <div class="fd-toolbar-title">
                        <span style="width:28px;height:28px;background:color-mix(in srgb,var(--primary) 20%,transparent);border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <i class="ti ti-files fs-14" style="color:var(--primary)"></i>
                        </span>
                        Contents
                        <span class="fd-toolbar-count">@(SubFolders.Count + FilteredFiles.Count)</span>
                    </div>
                    <div class="fd-search">
                        <i class="ti ti-search fs-12" style="color:#94a3b8;flex-shrink:0"></i>
                        <input placeholder="Search…" @bind="SearchTerm" @bind:event="oninput" />
                    </div>
                    <select class="form-select form-select-sm" @bind="SortOrder" style="width:150px">
                        <option value="name">Name A–Z</option>
                        <option value="name-d">Name Z–A</option>
                        <option value="size">Size ↑</option>
                        <option value="size-d">Size ↓</option>
                    </select>
                    <div class="fd-toggle">
                        <button class="fd-toggle-btn @(GridView ? "active" : "")" @onclick="() => GridView = true"><i class="ti ti-layout-grid"></i></button>
                        <button class="fd-toggle-btn @(!GridView ? "active" : "")" @onclick="() => GridView = false"><i class="ti ti-list"></i></button>
                    </div>
                </div>

                @if (!SubFolders.Any() && !FilteredFiles.Any())
                {
                    <div class="fd-empty">
                        <div class="fd-empty-icon"><i class="ti ti-folder-open"></i></div>
                        <h6>This folder is empty</h6>
                        <p>Upload files or create sub-folders</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button class="btn btn-primary" @onclick="OpenUploadModal">
                                <i class="ti ti-upload fs-13 me-1"></i> Upload Files
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="OpenCreateModal">
                                <i class="ti ti-folder-plus fs-13 me-1"></i> New Folder
                            </button>
                        </div>
                    </div>
                }
                else if (GridView)
                {
                    <div class="fd-grid">
                        @foreach (var sf in SubFolders)
                        {
                            var sff = sf;
                            <div class="fd-file-card fd-folder-card"
                                 @onclick='() => Navigation.NavigateTo($"/File-Manager/Folder/{sff.Id}")'>
                                <div class="fd-file-badge" style="background:@(sf.Color)22;color:@sf.Color;font-size:28px">
                                    <i class="ti ti-folder-filled"></i>
                                </div>
                                <div class="fd-file-name">@sf.Name</div>
                                <div class="fd-file-size">@State.Files.Count(f => !f.Deleted && f.FolderId == sf.Id) files</div>
                            </div>
                        }
                        @foreach (var f in FilteredFiles)
                        {
                            var rf = f;
                            <div class="fd-file-card @(OffcanvasFile?.Id == rf.Id ? "selected" : "")" @onclick="() => OpenOffcanvas(rf)">
                                <button class="fd-file-star @(f.Starred ? "starred" : "")"
                                        @onclick="() => ToggleFileStar(rf.Id)" @onclick:stopPropagation>
                                    <i class="@(f.Starred ? "ti ti-star-filled" : "ti ti-star")"></i>
                                </button>
                                <div class="fd-file-badge" style="background:@State.GetMeta(f.Ext).Bg;color:@State.GetMeta(f.Ext).Color">@State.GetMeta(f.Ext).Label</div>
                                <div class="fd-file-name">@f.Name</div>
                                <div class="fd-file-size">@FileManagerService.FmtMB(f.Size)</div>
                                <div class="fd-file-date">@f.Date</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <table class="fd-table">
                        <thead><tr><th>Name</th><th>Size</th><th>Type</th><th>Modified</th><th>Actions</th></tr></thead>
                        <tbody>
                            @foreach (var sf in SubFolders)
                            {
                                var sff = sf;
                                <tr @onclick='() => Navigation.NavigateTo($"/File-Manager/Folder/{sff.Id}")'>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:12px">
                                            <div style="width:38px;height:38px;border-radius:10px;background:@(sf.Color)22;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                                <i class="ti ti-folder-filled fs-18" style="color:@sf.Color"></i>
                                            </div>
                                            <div><div class="fd-row-name">@sf.Name</div><div class="fd-row-ext">Folder</div></div>
                                        </div>
                                    </td>
                                    <td style="color:#94a3b8">—</td>
                                    <td><span class="fd-ext-pill" style="background:#fef3c7;color:#b45309">FOLDER</span></td>
                                    <td style="font-size:12px;color:#94a3b8">—</td>
                                    <td @onclick:stopPropagation>
                                        <div style="display:flex;gap:5px;justify-content:flex-end">
                                            <button class="fd-act del" @onclick="() => DelSubFolder(sf.Id)"><i class="ti ti-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @foreach (var f in FilteredFiles)
                            {
                                var fid = f.Id; var rf = f;
                                <tr class="@(OffcanvasFile?.Id == f.Id ? "row-selected" : "")" @onclick="() => OpenOffcanvas(rf)">
                                    <td>
                                        <div style="display:flex;align-items:center;gap:12px">
                                            <div class="fd-file-badge" style="width:38px;height:38px;border-radius:10px;flex-shrink:0;margin:0;font-size:9px;background:@State.GetMeta(f.Ext).Bg;color:@State.GetMeta(f.Ext).Color">@State.GetMeta(f.Ext).Label</div>
                                            <div><div class="fd-row-name">@f.Name</div><div class="fd-row-ext">.@f.Ext</div></div>
                                        </div>
                                    </td>
                                    <td style="font-family:'DM Mono',monospace;font-size:12px">@FileManagerService.FmtMB(f.Size)</td>
                                    <td><span class="fd-ext-pill" style="background:@State.GetMeta(f.Ext).Bg;color:@State.GetMeta(f.Ext).Color">@f.Ext.ToUpper()</span></td>
                                    <td style="font-size:12px;color:#94a3b8">@f.Date</td>
                                    <td @onclick:stopPropagation>
                                        <div style="display:flex;gap:5px;justify-content:flex-end">
                                            <button class="fd-act star @(f.Starred ? "starred" : "")" @onclick="() => ToggleFileStar(fid)"><i class="@(f.Starred ? "ti ti-star-filled" : "ti ti-star")"></i></button>
                                            <button class="fd-act del" @onclick="() => DelFile(fid)"><i class="ti ti-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <!-- SIDEBAR -->
            <div class="fd-sidebar">
                <div class="fd-upload-card">
                    <div class="fd-card-head">
                        <div class="fd-card-title">
                            <span style="width:26px;height:26px;background:color-mix(in srgb,var(--primary) 11%,transparent);border-radius:7px;display:flex;align-items:center;justify-content:center">
                                <i class="ti ti-upload fs-13" style="color:var(--primary)"></i>
                            </span>
                            Upload Files
                        </div>
                    </div>
                    <div style="padding:16px">
                        <button class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2" @onclick="OpenUploadModal">
                            <i class="ti ti-cloud-upload fs-16"></i> Upload to "@Folder.Name"
                        </button>
                        <p style="font-size:11px;color:#94a3b8;text-align:center;margin-top:10px;margin-bottom:0">PDF, Images, Documents, Text, Audio, Video</p>
                    </div>
                    <div class="fd-upload-hints">
                        <div class="fd-upload-hint"><div class="fd-upload-hint-label">Max</div><div class="fd-upload-hint-val" style="color:var(--primary)">50MB</div></div>
                        <div class="fd-upload-hint"><div class="fd-upload-hint-label">Types</div><div class="fd-upload-hint-val" style="color:#10b981">All</div></div>
                        <div class="fd-upload-hint"><div class="fd-upload-hint-label">Encrypted</div><div class="fd-upload-hint-val" style="color:#f59e0b">Yes</div></div>
                    </div>
                </div>

                @if (SubFolders.Any())
                {
                    <div class="fd-subfolder-card">
                        <div class="fd-card-head">
                            <div class="fd-card-title">
                                <span style="width:26px;height:26px;background:#f5f3ff;border-radius:7px;display:flex;align-items:center;justify-content:center">
                                    <i class="ti ti-folders fs-13" style="color:#8b5cf6"></i>
                                </span>
                                Sub-Folders
                            </div>
                            <span style="font-size:11px;color:#94a3b8;font-weight:600">@SubFolders.Count</span>
                        </div>
                        <div class="fd-subfolder-list">
                            @foreach (var sf in SubFolders)
                            {
                                var sff = sf;
                                <div class="fd-sub-chip" hre="/File-Manager/Folder/{sff.Id}">
                                    <div class="fd-sub-chip-icon" style="background:@(sf.Color)22">
                                        <i class="ti ti-folder-filled fs-14" style="color:@sf.Color"></i>
                                    </div>
                                    <span class="fd-sub-chip-name">@sf.Name</span>
                                    <span class="fd-sub-chip-count">@State.Files.Count(f => !f.Deleted && f.FolderId == sf.Id)</span>
                                    <button class="fd-sub-chip-del" @onclick="() => DelSubFolder(sf.Id)" @onclick:stopPropagation>
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- CREATE SUB-FOLDER MODAL -->
@if (ShowCreateModal)
{
    <div class="fd-modal-overlay" @onclick="CloseCreateModal">
        <div class="fd-create-modal" @onclick:stopPropagation>
            <div class="fd-cm-head">
                <div class="fd-cm-head-icon"><i class="ti ti-folder-plus fs-20" style="color:var(--primary)"></i></div>
                <button class="fd-cm-close" @onclick="CloseCreateModal"><i class="ti ti-x"></i></button>
            </div>
            <div class="fd-cm-title">Create Sub-Folder</div>
            <div class="fd-cm-sub">Inside <strong>@Folder?.Name</strong></div>
            <div class="fd-cm-body">
                <div class="fd-cm-label">Folder Name</div>
                <input class="fd-cm-input" placeholder="e.g. Design Assets"
                       @bind="NewSubName" @bind:event="oninput"
                       @onkeydown="OnSubFolderKey" />
                <div class="fd-cm-label" style="margin-top:16px">Choose Color</div>
                <div class="fd-cm-colors">
                    @foreach (var c in FolderColors)
                    {
                        var cc = c;
                        <div class="fd-cm-dot @(NewSubColor == cc ? "selected" : "")" style="background:@cc" @onclick="() => NewSubColor = cc"></div>
                    }
                </div>
                <div class="fd-cm-footer">
                    <button class="btn btn-outline-secondary flex-fill" @onclick="CloseCreateModal"><i class="ti ti-x"></i> Cancel</button>
                    <button class="btn btn-primary flex-fill d-flex align-items-center justify-content-center gap-2"
                            @onclick="CreateSubFolder" disabled="@string.IsNullOrWhiteSpace(NewSubName)">
                        <i class="ti ti-folder-plus fs-13"></i> Create
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- UPLOAD MODAL -->
@if (ShowUploadModal)
{
    <div class="fd-modal-overlay" @onclick="() => { if (UploadStep != 2) CloseUploadModal(); }">
        <div class="fd-upload-modal" @onclick:stopPropagation>
            <div class="fd-um-head">
                <div class="fd-um-folder-pill">
                    <div class="fd-um-folder-icon" style="background:@((Folder?.Color ?? "#4f46e5") + "22")">
                        <i class="ti ti-folder-filled fs-20" style="color:@(Folder?.Color ?? "#4f46e5")"></i>
                    </div>
                    <div>
                        <div class="fd-um-folder-name">@Folder?.Name</div>
                        <div class="fd-um-folder-path">File Manager › @Folder?.Name</div>
                    </div>
                </div>
                @if (UploadStep != 2)
                {
                    <button class="fd-um-close" @onclick="CloseUploadModal"><i class="ti ti-x"></i></button>
                }
            </div>

            <div class="fd-um-steps">
                @for (int i = 1; i <= 3; i++)
                {
                    var step = i;
                    var cls = UploadStep > step ? "done" : UploadStep == step ? "active" : "";
                    var lbl = step == 1 ? "Select" : step == 2 ? "Uploading" : "Done";
                    <div class="fd-um-step @cls">
                        <div class="fd-um-step-circle">
                            @if (UploadStep > step) { <i class="ti ti-check fs-13"></i> }
                            else { <span>@step</span> }
                        </div>
                        <div class="fd-um-step-label">@lbl</div>
                    </div>
                }
            </div>

            <div class="fd-um-body">
                @if (UploadStep == 1)
                {
                    <label class="fd-um-dropzone">
                        <InputFile OnChange="OnFilesSelected" multiple style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%" />
                        <div class="fd-um-dz-icon"><i class="ti ti-cloud-upload fs-28" style="color:var(--primary)"></i></div>
                        <h6 style="font-size:15px;font-weight:700;color:#0f172a;margin-bottom:6px">Drop files here</h6>
                        <p style="font-size:12px;color:#94a3b8;margin-bottom:16px">or click to browse your device</p>
                        <span class="btn btn-primary px-5" style="pointer-events:none;font-weight:700">Choose Files</span>
                    </label>
                    @if (UploadQueue.Any())
                    {
                        <div style="margin-top:4px;max-height: 200px;overflow-y: scroll;">
                            <div style="font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">
                                Selected (@UploadQueue.Count)
                            </div>
                            @foreach (var uq in UploadQueue)
                            {
                                var meta = State.GetMeta(uq.Ext);
                                <div style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:#f8fafc;border-radius:10px;margin-bottom:6px">
                                    <div class="fd-file-badge" style="width:34px;height:34px;border-radius:9px;flex-shrink:0;margin:0;font-size:9px;background:@meta.Bg;color:@meta.Color">@meta.Label</div>
                                    <div style="flex:1;min-width:0">
                                        <div style="font-size:12px;font-weight:600;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@uq.FullName</div>
                                        <div style="font-size:11px;color:#94a3b8;font-family:'DM Mono',monospace">@FileManagerService.FmtMB(uq.SizeMB)</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else if (UploadStep == 2)
                {
                    <div class="fd-um-uploading-list" style="max-height: 200px;overflow-y: scroll;">
                        @foreach (var uq in UploadQueue)
                        {
                            <div class="fd-um-uitem">
                                <div class="fd-um-uitem-row">
                                    <div class="fd-um-uitem-icon" style="background:@State.GetMeta(uq.Ext).Bg;color:@State.GetMeta(uq.Ext).Color">@State.GetMeta(uq.Ext).Label</div>
                                    <span class="fd-um-uitem-name">@uq.FullName</span>
                                    <span class="fd-um-uitem-pct" style="color:@(uq.Progress == 100 ? "#10b981" : "var(--primary)")">@uq.Progress%</span>
                                </div>
                                <div class="fd-um-bar">
                                    <div class="fd-um-bar-fill" style="width:@uq.Progress%;@(uq.Progress == 100 ? "background:#10b981" : "")"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="fd-um-done">
                        <div class="fd-um-done-icon"><i class="ti ti-circle-check fs-32" style="color:#10b981"></i></div>
                        <h6 style="font-size:16px;font-weight:700;color:#0f172a;margin-bottom:4px">Upload Complete!</h6>
                        <p style="font-size:13px;color:#94a3b8;margin:0">@UploadedFiles.Count file(s) added to "@Folder?.Name"</p>
                        <div class="fd-um-done-files" style="max-height: 200px;overflow-y: scroll;">
                            @foreach (var f in UploadedFiles)
                            {
                                <div class="fd-um-done-row">
                                    <div class="fd-um-done-badge" style="background:@State.GetMeta(f.Ext).Bg;color:@State.GetMeta(f.Ext).Color">@State.GetMeta(f.Ext).Label</div>
                                    <span class="fd-um-done-name">@f.Name.@f.Ext</span>
                                    <span class="fd-um-done-size">@FileManagerService.FmtMB(f.Size)</span>
                                    <i class="ti ti-circle-check fs-14" style="color:#10b981;flex-shrink:0"></i>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="fd-um-footer">
                @if (UploadStep == 1)
                {
                    <button class="btn btn-outline-secondary flex-fill" @onclick="CloseUploadModal">Cancel</button>
                    <button class="btn btn-primary flex-fill" @onclick="StartUpload" disabled="@(!UploadQueue.Any())">
                        <i class="ti ti-upload me-1 fs-13"></i> Upload (@UploadQueue.Count)
                    </button>
                }
                else if (UploadStep == 3)
                {
                    <button class="btn btn-outline-secondary flex-fill" @onclick="() => { UploadStep = 1; UploadQueue.Clear(); UploadedFiles.Clear(); }">
                        <i class="ti ti-upload me-1 fs-13"></i> Upload More
                    </button>
                    <button class="btn btn-primary flex-fill" @onclick="CloseUploadModal">
                        <i class="ti ti-check me-1 fs-13"></i> Done
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- OFFCANVAS FILE DETAILS -->
@if (OffcanvasFile != null)
{
    <div class="fd-oc-backdrop" @onclick="CloseOffcanvas"></div>
    <div class="fd-offcanvas">

        <div class="fd-oc-head">
            <span class="fd-oc-title">File Details</span>
            <div class="fd-oc-hacts">
                <button class="fd-oc-hbtn @(OffcanvasFile.Starred ? "starred" : "")" @onclick="() => ToggleFileStar(OffcanvasFile.Id)">
                    <i class="@(OffcanvasFile.Starred ? "ti ti-star-filled" : "ti ti-star")"></i>
                </button>
                <button class="fd-oc-hbtn del" @onclick="() => { DelFile(OffcanvasFile.Id); CloseOffcanvas(); }">
                    <i class="ti ti-trash"></i>
                </button>
                <button class="fd-oc-hbtn" @onclick="CloseOffcanvas"><i class="ti ti-x"></i></button>
            </div>
        </div>

        <div class="fd-oc-thumb">
            <div class="fd-oc-badge" style="background:@State.GetMeta(OffcanvasFile.Ext).Bg;color:@State.GetMeta(OffcanvasFile.Ext).Color">
                @State.GetMeta(OffcanvasFile.Ext).Label
            </div>
            <div class="fd-oc-fname">@OffcanvasFile.Name.@OffcanvasFile.Ext</div>
            <div class="fd-oc-fmeta">@FileManagerService.FmtMB(OffcanvasFile.Size) &nbsp;·&nbsp; .@OffcanvasFile.Ext.ToUpper() &nbsp;·&nbsp; @OffcanvasFile.Date</div>
        </div>

        <div class="fd-oc-body">
            @{
                var ext = OffcanvasFile.Ext.ToLower();
                bool hasBytes = OffcanvasFile.FileBytes?.Length > 0;
            }

            @if (hasBytes)
            {
                <div class="fd-preview-area" style="height:100%">
                    @if (ext is "jpg" or "jpeg" or "png" or "gif" or "webp" or "svg" or "bmp" or "ico")
                    {
                        <img src="@OffcanvasFile.DataUrl" alt="@OffcanvasFile.Name" style="width:100%;border-radius:10px;object-fit:contain;max-height:280px" />
                    }
                    else if (ext == "pdf")
                    {
                        <iframe src="@OffcanvasFile.DataUrl" title="@OffcanvasFile.Name" style="width:100%;height:320px;border:none;border-radius:10px"></iframe>
                    }
                    else if (ext is "mp4" or "webm" or "ogg" or "mov")
                    {
                        <video controls style="width:100%;border-radius:10px;max-height:240px">
                            <source src="@OffcanvasFile.DataUrl" type="@OffcanvasFile.MimeType" />
                        </video>
                    }
                    else if (ext is "mp3" or "wav" or "ogg" or "flac" or "aac")
                    {
                        <audio controls style="width:100%">
                            <source src="@OffcanvasFile.DataUrl" type="@OffcanvasFile.MimeType" />
                        </audio>
                    }
                    else if (IsTextExt(ext))
                    {
                        <pre class="fd-prev-text" style="background:#f8fafc;border-radius:10px;padding:14px;font-size:11.5px;color:#475569;overflow:auto;max-height:300px">@OffcanvasFile.TextContent</pre>
                    }
                    else
                    {
                        <div class="fd-prev-none">
                            <i class="@GetFileIcon(ext)" style="color:@State.GetMeta(ext).Color;font-size:36px"></i>
                            <div style="font-weight:600;color:#475569">Preview not available</div>
                            <div style="font-size:12px;color:#94a3b8">.@ext files cannot be previewed</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div>
                    <div class="fd-oc-section">File Info</div>
                    <div class="fd-info-grid" style="margin-bottom:20px">
                        <div class="fd-info-cell"><div class="fd-info-label">Type</div><div class="fd-info-val">@OffcanvasFile.Ext.ToUpper()</div></div>
                        <div class="fd-info-cell"><div class="fd-info-label">Items</div><div class="fd-info-val">@OffcanvasFile.Items</div></div>
                        <div class="fd-info-cell"><div class="fd-info-label">Size</div><div class="fd-info-val">@FileManagerService.FmtMB(OffcanvasFile.Size)</div></div>
                    </div>
                    <div class="fd-oc-section">Share Link</div>
                    <div class="fd-share-box">
                        <span class="fd-share-link">https://files.app/@(Folder?.Name.ToLower().Replace(" ","-"))/@(OffcanvasFile.Name.ToLower().Replace(" ","-")).@OffcanvasFile.Ext</span>
                        <button class="fd-share-copy" @onclick="CopyShareLink">@(LinkCopied ? "Copied!" : "Copy")</button>
                    </div>
                </div>
            }
        </div>

        <div class="fd-oc-footer">
            @if (hasBytes)
            {
                <button class="btn btn-primary" @onclick="DownloadFile">
                    <i class="ti ti-download fs-14"></i> Download
                </button>
                <button class="btn btn-outline-secondary" @onclick="CopyShareLink">
                    <i class="ti ti-share fs-14"></i> @(LinkCopied ? "Copied!" : "Share")
                </button>
            }
            else
            {
                <button class="btn btn-primary" disabled>
                    <i class="ti ti-download fs-14"></i> Download
                </button>
                <button class="btn btn-outline-secondary" @onclick="CopyShareLink">
                    <i class="ti ti-share fs-14"></i> @(LinkCopied ? "Copied!" : "Share")
                </button>
            }
        </div>
    </div>
}

<!-- TOAST -->
@if (ToastVisible)
{
    <div class="fd-toast @(ToastErr ? "fd-toast-err" : "fd-toast-ok")">
        <i class="@(ToastErr ? "ti ti-alert-circle" : "ti ti-circle-check") fs-16"></i>
        @ToastMsg
        <button class="fd-toast-close" @onclick="() => ToastVisible = false"><i class="ti ti-x"></i></button>
    </div>
}

@code {
    [Parameter] public int FolderId { get; set; }

    record StatCard(string Label, string Value, string Icon, string Color, string Bg);
    record BreadcrumbEntry(int Id, string Name);

    class UQItem
    {
        public string FullName  { get; set; } = "";
        public string Ext       { get; set; } = "";
        public double SizeMB    { get; set; }
        public byte[] Bytes     { get; set; } = Array.Empty<byte>();
        public string MimeType  { get; set; } = "";
        public int    Progress  { get; set; }
    }

    string SearchTerm = ""; string SortOrder = "name"; bool GridView = true;
    bool ToastVisible = false; bool ToastErr = false; string ToastMsg = "";
    CancellationTokenSource? _cts;

    bool   ShowCreateModal = false;
    string NewSubName = ""; string NewSubColor = "#4f46e5";

    bool   ShowUploadModal = false;
    int    UploadStep      = 1;
    List<UQItem> UploadQueue = new();
    List<FileManagerService.FileItem> UploadedFiles = new();

    FileManagerService.FileItem? OffcanvasFile = null;
    bool LinkCopied = false;

    static readonly string[] FolderColors = { "#4f46e5","#ef4444","#10b981","#4f8ef7","#8b5cf6","#06b6d4","#f59e0b","#ec4899" };

    // ── Computed ──
    FileManagerService.FolderItem? Folder => State.GetFolderById(FolderId);

    // FIX: SubFolders uses ParentId == FolderId (int comparison, consistent with service)
    List<FileManagerService.FolderItem> SubFolders =>
        State.Folders.Where(f => f.ParentId == FolderId).ToList();

    List<FileManagerService.FileItem> FolderFiles =>
        State.Files.Where(f => !f.Deleted && f.FolderId == FolderId).ToList();

    List<FileManagerService.FileItem> FilteredFiles
    {
        get
        {
            var q = FolderFiles.AsEnumerable();
            if (!string.IsNullOrEmpty(SearchTerm))
                q = q.Where(f => f.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
                               || f.Ext.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
            q = SortOrder switch
            {
                "name-d" => q.OrderByDescending(f => f.Name),
                "size"   => q.OrderBy(f => f.Size),
                "size-d" => q.OrderByDescending(f => f.Size),
                _        => q.OrderBy(f => f.Name)
            };
            return q.ToList();
        }
    }

    List<StatCard> FolderStats => new()
    {
        new("Total Files",  FolderFiles.Count.ToString(),                  "ti ti-files",   "var(--primary)", "color-mix(in srgb,var(--primary) 20%,transparent)"),
        new("Total Size",   FileManagerService.FmtMB(FolderFiles.Sum(f => f.Size)),     "ti ti-database","#10b981",        "#d1fae5"),
        new("Starred",      FolderFiles.Count(f => f.Starred).ToString(),  "ti ti-star",    "#f59e0b",        "#fef3c7"),
        new("Sub-Folders",  SubFolders.Count.ToString(),                   "ti ti-folders", "#8b5cf6",        "#f5f3ff"),
    };

    // ── Breadcrumb ──
    List<BreadcrumbEntry> GetBreadcrumbs()
    {
        var trail = new List<BreadcrumbEntry>();
        var f = Folder;
        while (f != null)
        {
            trail.Insert(0, new BreadcrumbEntry(f.Id, f.Name));
            // ParentId > 0 means it has a real parent (0 = root)
            f = f.ParentId > 0 ? State.GetFolderById(f.ParentId) : null;
        }
        return trail;
    }

    void GoBack()
    {
        if (Folder?.ParentId > 0) Navigation.NavigateTo($"/File-Manager/Folder/{Folder.ParentId}");
        else Navigation.NavigateTo("/File-Manager");
    }

    // ── Create sub-folder ──
    void OpenCreateModal()  { NewSubName = ""; NewSubColor = "#4f46e5"; ShowCreateModal = true; }
    void CloseCreateModal() => ShowCreateModal = false;
    void OnSubFolderKey(KeyboardEventArgs e) { if (e.Key == "Enter") CreateSubFolder(); }

    void CreateSubFolder()
    {
        var name = NewSubName.Trim();
        if (string.IsNullOrEmpty(name)) { ShowToast("Enter a folder name", true); return; }
        State.Folders.Add(new FileManagerService.FolderItem
        {
            Id       = State.NextFolderId(),
            Name     = name,
            Size     = 0,
            Total    = 10,
            Color    = NewSubColor,
            ParentId = FolderId   // parent = current folder
        });
        ShowCreateModal = false;
        ShowToast($"Folder \"{name}\" created!");
    }

    void DelSubFolder(int id)
    {
        State.Folders.RemoveAll(f => f.Id == id);
        State.Files.RemoveAll(f => f.FolderId == id);
        ShowToast("Sub-folder deleted");
    }

    // ── Upload ──
    void OpenUploadModal()  { UploadStep = 1; UploadQueue.Clear(); UploadedFiles.Clear(); ShowUploadModal = true; }
    void CloseUploadModal() { ShowUploadModal = false; UploadQueue.Clear(); }

    async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        UploadQueue.Clear();
        foreach (var file in e.GetMultipleFiles(20))
        {
            try
            {
                using var ms = new System.IO.MemoryStream();
                await file.OpenReadStream(50 * 1024 * 1024).CopyToAsync(ms);
                var bytes = ms.ToArray();
                var ext   = System.IO.Path.GetExtension(file.Name).TrimStart('.').ToLower();
                UploadQueue.Add(new UQItem
                {
                    FullName = file.Name, Ext = ext,
                    SizeMB   = Math.Round(file.Size / 1048576.0, 2),
                    Bytes    = bytes, MimeType = file.ContentType, Progress = 0
                });
            }
            catch { ShowToast($"Cannot read: {file.Name}", true); }
        }
        StateHasChanged();
    }

    async Task StartUpload()
    {
        if (!UploadQueue.Any()) return;
        UploadStep = 2; StateHasChanged();
        foreach (var uq in UploadQueue)
        {
            var rnd = new Random();
            while (uq.Progress < 100)
            {
                await Task.Delay(60);
                uq.Progress = Math.Min(100, uq.Progress + rnd.Next(8, 22));
                StateHasChanged();
            }
        }
        await Task.Delay(300);
        int nextId = State.NextFileId();
        foreach (var uq in UploadQueue)
        {
            var mime    = string.IsNullOrEmpty(uq.MimeType) ? GetMime(uq.Ext) : uq.MimeType;
            var dataUrl = uq.Bytes.Length > 0 ? $"data:{mime};base64,{Convert.ToBase64String(uq.Bytes)}" : "";
            var txt     = "";
            if (IsTextExt(uq.Ext) && uq.Bytes.Length > 0)
                try { txt = System.Text.Encoding.UTF8.GetString(uq.Bytes); } catch { }

            var fi = new FileManagerService.FileItem
            {
                Id          = nextId++,
                Name        = System.IO.Path.GetFileNameWithoutExtension(uq.FullName),
                Ext         = uq.Ext, Size = uq.SizeMB, Items = 1,
                Date        = DateTime.Now.ToString("dd MMM yyyy"),
                FolderId    = FolderId,
                FileBytes   = uq.Bytes, DataUrl = dataUrl, TextContent = txt, MimeType = mime,
            };
            State.Files.Add(fi);
            UploadedFiles.Add(fi);
        }
        UploadStep = 3; StateHasChanged();
        ShowToast($"{UploadedFiles.Count} file(s) uploaded to \"{Folder?.Name}\"!");
    }

    // ── Offcanvas ──
    void OpenOffcanvas(FileManagerService.FileItem f)
    {
        OffcanvasFile = State.Files.FirstOrDefault(x => x.Id == f.Id);
        LinkCopied    = false;
    }
    void CloseOffcanvas() => OffcanvasFile = null;

    async Task DownloadFile()
    {
        if (OffcanvasFile?.FileBytes == null || OffcanvasFile.FileBytes.Length == 0) return;
        var name = $"{OffcanvasFile.Name}.{OffcanvasFile.Ext}";
        await JS.InvokeVoidAsync("downloadFileFromBytes", name, OffcanvasFile.MimeType ?? GetMime(OffcanvasFile.Ext), OffcanvasFile.FileBytes);
        ShowToast($"Downloading {name}");
    }

    async void CopyShareLink()
    {
        LinkCopied = true; StateHasChanged(); ShowToast("Share link copied!");
        await Task.Delay(2000); LinkCopied = false; StateHasChanged();
    }

    // ── Helpers ──
    static bool IsTextExt(string e) =>
        e is "txt" or "csv" or "json" or "xml" or "md" or "log"
          or "html" or "htm" or "css" or "js" or "ts" or "cs"
          or "py" or "sql" or "yaml" or "yml" or "ini" or "env";

    static string GetMime(string ext) => ext switch
    {
        "pdf"           => "application/pdf",
        "jpg" or "jpeg" => "image/jpeg",
        "png"           => "image/png",
        "gif"           => "image/gif",
        "webp"          => "image/webp",
        "svg"           => "image/svg+xml",
        "mp4"           => "video/mp4",
        "webm"          => "video/webm",
        "mp3"           => "audio/mpeg",
        "wav"           => "audio/wav",
        "txt"           => "text/plain",
        "csv"           => "text/csv",
        "html" or "htm" => "text/html",
        "json"          => "application/json",
        "xml"           => "application/xml",
        _               => "application/octet-stream"
    };

    static string GetFileIcon(string ext) => ext switch
    {
        "pdf"           => "ti ti-file-type-pdf",
        "doc" or "docx" => "ti ti-file-type-doc",
        "xls" or "xlsx" => "ti ti-file-spreadsheet",
        "zip" or "rar"  => "ti ti-file-zip",
        "mp4" or "mov"  => "ti ti-video",
        "mp3" or "wav"  => "ti ti-music",
        _               => "ti ti-file"
    };

    string DarkenHex(string hex)
    {
        try
        {
            hex = hex.TrimStart('#');
            int r = Math.Max(0, Convert.ToInt32(hex[..2], 16) - 45);
            int g = Math.Max(0, Convert.ToInt32(hex[2..4], 16) - 45);
            int b = Math.Max(0, Convert.ToInt32(hex[4..6], 16) - 45);
            return $"#{r:X2}{g:X2}{b:X2}";
        }
        catch { return "#" + hex; }
    }

    void ToggleFolderStar() { if (Folder != null) Folder.Starred = !Folder.Starred; }

    void ToggleFileStar(int id)
    {
        var f = State.Files.FirstOrDefault(x => x.Id == id);
        if (f != null) f.Starred = !f.Starred;
        if (OffcanvasFile?.Id == id) OffcanvasFile = f;
    }

    void DelFile(int id)
    {
        State.Files.RemoveAll(f => f.Id == id);
        if (OffcanvasFile?.Id == id) OffcanvasFile = null;
        ShowToast("File deleted");
    }

    async void ShowToast(string msg, bool err = false)
    {
        _cts?.Cancel(); _cts = new CancellationTokenSource(); var token = _cts.Token;
        ToastMsg = msg; ToastErr = err; ToastVisible = true; StateHasChanged();
        try { await Task.Delay(3000, token); ToastVisible = false; StateHasChanged(); }
        catch (TaskCanceledException) { }
    }
}
