@page "/employees/{Id:guid}/view"
@using FinanceConnect.Client.ViewModels

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else if (Employee == null)
{
    <div class="vb-root">
        <div class="content">
            <div class="alert alert-danger">
                <i class="ti ti-alert-circle me-2"></i>
                Employee not found.
                <a href="/employees" class="alert-link ms-2">Return to list</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="dn-wrapper">
        <div class="content">

            <!-- PAGE HEADER -->
            <div class="pageHeader d-flex justify-content-between align-items-center mb-3">

                <div>
                    <h3>Employee Details</h3>
                    <p style="color:gray;">Employee profile overview and employment information.</p>
                </div>

                <div class="dn-hero-actions">

                    <button class="btn btn-primary" @onclick="PrintPage">
                        <i class="ti ti-printer"></i> Print
                    </button>

                    <a href="/employees" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left"></i> Back
                    </a>
                </div>

            </div>


            <!-- HERO -->
            <div class="dn-hero">

                <div class="dn-hero-inner">

                    <div class="dn-icon-wrap">
                        @Employee.FirstName?.Substring(0, 1).ToUpper()
                        @Employee.LastName?.Substring(0, 1).ToUpper()
                    </div>

                    <div class="dn-hero-content">

                        <h1 class="dn-number">
                            @Employee.FirstName @Employee.LastName
                        </h1>

                        <div class="dn-meta-row">

                            <span class="dn-meta-item">
                                <i class="ti ti-id-badge"></i>
                                @Employee.EmployeeId
                            </span>

                            <span class="dn-meta-item">
                                <i class="ti ti-briefcase"></i>
                                @DepartmentName · @DesignationName
                            </span>

                            <span class="dn-meta-item">
                                <i class="ti ti-building"></i>
                                @Employee.CompanyId
                            </span>

                        </div>

                        <div class="dn-badges">

                            <span class="badge-dn @(Employee.Status == EmployeeStatus.Active ? "badge-posted" : "badge-draft")">
                                @Employee.Status
                            </span>

                            <span class="badge-dn badge-info">
                                @Employee.EmploymentType
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- GRID -->
            <div class="dn-grid">


                <!-- ================= LEFT ================= -->
                <div class="dn-left">

                    <!-- CORE INFO -->
                    <div class="dn-card">

                        <div class="dn-card-header">
                            <span class="dn-card-title">
                                <i class="ti ti-user"></i> Core Information
                            </span>
                        </div>

                        <div class="card-body">

                            <div class="row g-0">

                                <div class="col-md-3 field-item">
                                    <div class="field-label">Date of Joining</div>
                                    <div class="field-value">
                                        @Employee.DateOfJoining?.ToString("dd MMM yyyy")
                                    </div>
                                </div>

                                <div class="col-md-3 field-item">
                                    <div class="field-label">Total Experience</div>
                                    <div class="field-value">
                                        @(Employee.TotalExperience ?? 0) Years
                                    </div>
                                </div>

                                <div class="col-md-3 field-item">
                                    <div class="field-label">Gender</div>
                                    <div class="field-value">@Employee.Gender</div>
                                </div>

                                <div class="col-md-3 field-item">
                                    <div class="field-label">Marital Status</div>
                                    <div class="field-value">@Employee.MaritalStatus</div>
                                </div>

                                <div class="col-md-6 field-item">
                                    <div class="field-label">Reporting Manager</div>
                                    <div class="field-value">@ReportingManagerName</div>
                                </div>

                                <div class="col-md-6 field-item">
                                    <div class="field-label">Source of Hire</div>
                                    <div class="field-value">@Employee.SourceOfHire</div>
                                </div>

                            </div>

                        </div>
                    </div>


                    <!-- CONTACT -->
                    <div class="dn-card">

                        <div class="dn-card-header">
                            <span class="dn-card-title">
                                <i class="ti ti-phone"></i> Contact Details
                            </span>
                        </div>

                        <div class="card-body">

                            <div class="row g-0">

                                <div class="col-md-4 field-item">
                                    <div class="field-label">Official Email</div>
                                    <div class="field-value">@Employee.OfficialEmail</div>
                                </div>

                                <div class="col-md-4 field-item">
                                    <div class="field-label">Personal Email</div>
                                    <div class="field-value">@Employee.PersonalEmail</div>
                                </div>

                                <div class="col-md-4 field-item">
                                    <div class="field-label">Mobile</div>
                                    <div class="field-value">@Employee.PersonalMobileNumber</div>
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- EXPERTISE -->
                    @if (!string.IsNullOrWhiteSpace(Employee.Expertise))
                    {
                        <div class="dn-card">

                            <div class="dn-card-header">
                                <span class="dn-card-title">
                                    <i class="ti ti-star"></i> Expertise
                                </span>
                            </div>

                            <div class="dn-card-body">

                                <div class="field-item-full">

                                    <div class="field-value ql-editor">
                                        @(new MarkupString(Employee?.Expertise ?? ""))
                                    </div>

                                </div>

                            </div>

                        </div>
                    }


                    <!-- EDUCATION -->
                    @if (Employee.Educations.Any())
                    {
                        <div class="dn-card">

                            <div class="dn-card-header">
                                <span class="dn-card-title">
                                    <i class="ti ti-school"></i> Education
                                </span>
                            </div>

                            <div class="dn-card-body">

                                <table class="table">

                                    <thead class="thead-light">
                                        <tr>
                                            <th>Degree</th>
                                            <th>Specialization</th>
                                            <th>Institute</th>
                                            <th>Completion</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var edu in Employee.Educations)
                                        {
                                            <tr>

                                                <td>@edu.Degree</td>
                                                <td>@edu.Specialization</td>
                                                <td>@edu.InstituteName</td>
                                                <td>@edu.DateOfCompletion?.ToString("yyyy")</td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>
                    }


                    <!-- WORK EXPERIENCE -->
                    @if (Employee.WorkExperiences.Any())
                    {
                        <div class="dn-card">

                            <div class="dn-card-header">
                                <span class="dn-card-title">
                                    <i class="ti ti-history"></i> Work Experience
                                </span>
                            </div>

                            <div class="dn-card-body">

                                <table class="table">

                                    <thead class="thead-light">
                                        <tr>
                                            <th>Company</th>
                                            <th>Role</th>
                                            <th>From</th>
                                            <th>To</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var exp in Employee.WorkExperiences)
                                        {
                                            <tr>

                                                <td>@exp.CompanyName</td>

                                                <td>@exp.JobTitle</td>

                                                <td>@exp.FromDate?.ToString("MMM yyyy")</td>

                                                <td>
                                                    @(exp.ToDate.HasValue
                                                    ? exp.ToDate.Value.ToString("MMM yyyy")
                                                    : "Present")
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>
                    }

                </div>


                <!-- ================= RIGHT ================= -->
                <div class="dn-right">

                    <!-- EXPERIENCE SUMMARY -->
                    <div class="dn-card">

                        <div class="dn-card-header">
                            <span class="dn-card-title">
                                <i class="ti ti-chart-bar"></i> Experience Summary
                            </span>
                        </div>

                        <div class="dn-card-body">

                            <div class="info-row">
                                <span class="info-key">Current Experience</span>
                                <span class="info-val">@Employee.CurrentExperience Years</span>
                            </div>

                            <div class="info-row">
                                <span class="info-key">Total Experience</span>
                                <span class="info-val">@Employee.TotalExperience Years</span>
                            </div>

                            <div class="info-row">
                                <span class="info-key">Joined On</span>
                                <span class="info-val">@Employee.DateOfJoining?.ToString("dd MMM yyyy")</span>
                            </div>

                        </div>

                    </div>


                    <!-- COMPLIANCE -->
                    <div class="dn-card">

                        <div class="dn-card-header">
                            <span class="dn-card-title">
                                <i class="ti ti-shield-check"></i> Compliance
                            </span>
                        </div>

                        <div class="dn-card-body">

                            <div class="info-row">
                                <span class="info-key">PAN</span>
                                <span class="info-val">@Employee.PAN</span>
                            </div>

                            <div class="info-row">
                                <span class="info-key">Aadhaar</span>
                                <span class="info-val">@Employee.Aadhaar</span>
                            </div>

                            <div class="info-row">
                                <span class="info-key">UAN</span>
                                <span class="info-val">@Employee.UAN</span>
                            </div>

                        </div>

                    </div>


                    <!-- SYSTEM INFO -->
                    <div class="dn-card">

                        <div class="dn-card-header">
                            <span class="dn-card-title">
                                <i class="ti ti-settings"></i> System Information
                            </span>
                        </div>

                        <div class="dn-card-body">

                            <div class="info-row">
                                <span class="info-key">Created</span>
                                <span class="info-val">@Employee.AddedTime?.ToString("dd MMM yyyy HH:mm")</span>
                            </div>

                            <div class="info-row">
                                <span class="info-key">Last Updated</span>
                                <span class="info-val">@Employee.ModifiedTime?.ToString("dd MMM yyyy HH:mm")</span>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
}