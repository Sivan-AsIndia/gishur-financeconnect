@page "/employees"
@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Employee List</h4>
                    <h6>Manage your employees</h6>
                </div>
            </div>
            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);"
                    title="Refresh"
                    @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>
            <div class="page-btn">
                <a href="/employees/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Employee List -->
        <div class="card">
            <div class="card-header d-flex justify-content-between">

                <!-- Search -->
                <input type="search"
                class="form-control form-control-sm"
                placeholder="Search employee"
                style="max-width:250px"
                @bind="searchText"
                @oninput="OnSearch" />
                <div style="display:flex;
                gap: 10px;">
                    <!-- Company Filter -->
                    <div>
                        <select class="form-select form-select-sm"
                        style="min-width: 180px"
                        @bind="SelectedCompany">
                            <option value="">All Companies</option>
                            @foreach (var c in Companies)
                            {
                                <option value="@c.Id">@c.LegalName</option>
                            }
                        </select>
                    </div>

                    <div>
                        <select class="form-select form-select-sm"
                        style="min-width: 180px"
                        @bind="SelectedDepartment">
                            <option value="">All Departments</option>
                            @foreach (var c in Departments)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <!-- Status Filter -->
                    <select class="form-select form-select-sm"
                    style="max-width:140px"
                    @bind="SelectedStatus"
                    @oninput="ApplyFilters">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <div>
                        <table class="table align-middle w-100">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xl-none" style="width:40px"></th>
                                    <th style="width:220px">Emp ID</th>
                                    <th class="d-none d-md-table-cell">Name</th>
                                    <th class="d-none d-md-table-cell">Email</th>
                                    <th class="d-none d-l-table-cell">Department</th>
                                    <th class="d-none d-xl-table-cell">Designation</th>
                                    <th class="d-none d-xl-table-cell">Status</th>
                                    <th style="width:130px">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedEmployees.Any())
                                {
                                    @foreach (var e in PagedEmployees)
                                    {
                                        <tr>
                                            <!-- PLUS ICON -->
                                            <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                data-bs-toggle="modal"
                                                data-bs-target="#rowDetailsModal"
                                                @onclick="() => OpenRowDetails(e)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td class="fw-medium">
                                                <div class="d-flex align-items-center">
                                                    <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                    <a class="link-View"
                                                    @onclick="() => ViewEmployee(e)">
                                                        @e.EmployeeId
                                                    </a>
                                                </div>
                                            </td>
                                            <td class="d-none d-md-table-cell">@($"{e.FirstName} {e.LastName}")</td>
                                            <td class="d-none d-md-table-cell">@e.OfficialEmail</td>
                                            <td class="d-none d-l-table-cell">@EmployeeService.GetDepartmentName(e.DepartmentId)</td>
                                            <td class="d-none d-xl-table-cell">@EmployeeService.GetDesignationName(e.DesignationId)</td>
                                            <td class="d-none d-xl-table-cell">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="ActiveDot @GetStatusBadge(e.Status)">
                                                    </div>
                                                    <span>@e.Status</span>
                                                </div>
                                            </td>
                                            <td class="action-table-data">
                                                <div class="edit-delete-action">
                                                    <a class="me-2 edit-icon p-1" title="Edit Employee"
                                                    @onclick='() => Nav.NavigateTo($"/employees/{e.Id}")'>
                                                        <i data-feather="edit"></i>
                                                    </a>

                                                    @if (e.Status == EmployeeStatus.Active)
                                                    {
                                                        <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon" href="javascript:void(0);"
                                                        title="Deactivate" data-bs-toggle="modal" data-bs-target="#deactivate-modal"
                                                        @onclick="() => ConfirmDeactivate(e)">
                                                            <i class="ti ti-toggle-left"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                        title="Activate" data-bs-toggle="modal" data-bs-target="#activate-modal" @onclick="() => ConfirmActivate(e)">
                                                            <i class="ti ti-toggle-right"></i>
                                                        </a>
                                                    }

                                                    <a class="p-1 delete-icon" title="Delete Employee" data-bs-toggle="modal" data-bs-target="#delete-modal"
                                                    @onclick="() => ConfirmDelete(e)">
                                                        <i data-feather="trash-2"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4">
                                            <div class="text-muted">
                                                <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                                No employees found
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    @if (FilteredEmployees.Any())
                    {
                        <!-- Pagination -->
                        <div class="d-flex justify-content-between align-items-center p-3">

                            <div class="d-flex align-items-center fs-13">
                                <span class="me-2">Rows Per Page</span>
                                <select class="form-select form-select-sm w-auto"
                                @onchange="OnPageSizeChange">
                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                </select>
                                <span class="ms-2">Entries</span>
                            </div>

                            <nav>
                                <ul class="pagination pagination-sm mb-0">

                                    <!-- Prev -->
                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                        @onclick="PreviousPage"
                                        @onclick:preventDefault>
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>

                                    <!-- Pages -->
                                    @foreach (var pageNumber in VisiblePages)
                                    {
                                        <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                            <button type="button"
                                            class="page-link"
                                            @onclick="() => GoToPage(pageNumber)">
                                                @pageNumber
                                            </button>
                                        </li>
                                    }

                                    <!-- Next -->
                                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                        @onclick="NextPage"
                                        @onclick:preventDefault>
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>

                                </ul>
                            </nav>
                        </div>
                    }

                </div>
            </div>
        </div>

        <!-- Activate Modal -->
        <div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-toggle-right fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Employee</h4>
                            <p class="text-gray-6 mb-0 fs-16" style="max-width: 95%;" title="@SelectedEmployee?.EmployeeId">
                                Are you sure you want to activate <strong>@SelectedEmployee?.EmployeeId</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal">
                                    <i class="ti ti-toggle-right me-1"></i>Yes, Activate
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deactivate Modal -->
        <div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                                <i class="ti ti-toggle-left fs-24 text-warning"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate Employee</h4>
                            <p class="text-gray-6 mb-0 fs-16" style="max-width: 95%;" title="@SelectedEmployee?.EmployeeId">
                                @if (!canDeactivate)
                                {
                                    <span class="text-danger">Cannot deactivate! Employee has active references.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to deactivate <strong>@SelectedEmployee?.EmployeeId</strong>?</span>
                                }
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDeactivate)
                                {
                                    <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal">
                                        <i class="ti ti-toggle-left me-1"></i>Yes, Deactivate
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- delete modal -->
        <div class="modal fade" id="delete-modal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Branch</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDelete)
                                {
                                    <span class="text-danger">Cannot delete this Employee.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to delete <strong title="@SelectedEmployee?.EmployeeId">@SelectedEmployee?.EmployeeId</strong>?</span>
                                }
                            </p>

                            @if (canDelete)
                            {
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                            }
                            <div class="modal-footer-btn mt-3 d-flex justify-content-center">
                                <button type="button" class="btn me-2 btn-outline-secondary fs-13 fw-medium p-2 px-3 shadow-none" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDelete)
                                {
                                    <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteConfirmed" data-bs-dismiss="modal">
                                        <i class="ti ti-trash me-1"></i>Yes, Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Responsive Row Details Modal -->
        <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="ti ti-user me-1"></i>
                            Employee Details
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                style="padding:0; right:22px; position:absolute;">
                        </button>
                    </div>

                    @if (SelectedEmployee != null)
                    {
                        <div class="modal-body">

                            <div class="mb-2 d-flex gap-3">
                                <strong>Employee ID:</strong>
                                <div>@SelectedEmployee.EmployeeId</div>
                            </div>

                            <div class="mb-2 d-flex gap-3">
                                <strong>Name:</strong>
                                <div>
                                    @($"{SelectedEmployee.FirstName} {SelectedEmployee.LastName}")
                                </div>
                            </div>

                            <div class="mb-2 d-flex gap-3">
                                <strong>Email:</strong>
                                <div>@SelectedEmployee.OfficialEmail</div>
                            </div>

                            <div class="mb-2 d-flex gap-3">
                                <strong>Department:</strong>
                                <div>
                                    @EmployeeService.GetDepartmentName(SelectedEmployee.DepartmentId)
                                </div>
                            </div>

                            <div class="mb-2 d-flex gap-3">
                                <strong>Designation:</strong>
                                <div>
                                    @EmployeeService.GetDesignationName(SelectedEmployee.DesignationId)
                                </div>
                            </div>

                            <div class="mb-2 d-flex gap-3 align-items-center">
                                <strong>Status:</strong>

                                <span class="badge @GetStatusBadge(SelectedEmployee.Status)">
                                    @SelectedEmployee.Status
                                </span>
                            </div>

                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
}