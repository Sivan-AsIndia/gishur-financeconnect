@page "/tax-category-mapping/create"
@page "/tax-category-mapping/{Id:guid}/edit"
@using FinanceConnect.Client.Services
@using static FinanceConnect.Client.ViewModels.TaxCategoryMappingViewModel
@inject IJSRuntime JS
@inject ToastService ToastService

<style>
    .form-select option:checked {
        color: white;
        background-color: var(--primary);
    }
    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }
    .line-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 12px;
        position: relative;
        transition: border-color .2s, box-shadow .2s;
    }
    .line-card:hover {
        border-color: #a5b4fc;
        box-shadow: 0 2px 8px rgba(99,102,241,.08);
    }
    .line-card.line-inactive-card {
        opacity: .55;
        background: #f9fafb;
    }
    .line-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #ede9fe;
        color: #6d28d9;
        font-size: 11px;
        font-weight: 700;
        flex-shrink: 0;
    }
    .line-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px dashed #e5e7eb;
    }
    .line-card-title {
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        flex: 1;
    }
    .line-section-label {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #9ca3af;
        margin-bottom: 8px;
    }
    .line-divider {
        border: none;
        border-top: 1px dashed #e5e7eb;
        margin: 12px 0;
    }
    .add-line-btn-area {
        border: 2px dashed #c7d2fe;
        border-radius: 8px;
        padding: 18px;
        text-align: center;
        cursor: pointer;
        transition: background .15s, border-color .15s;
        background: #f5f3ff;
    }
    .add-line-btn-area:hover {
        background: #ede9fe;
        border-color: #a5b4fc;
    }
</style>

<div class="content Accordion-form">
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">@(IsEdit ? "Edit Tax Category Mapping" : "New Tax Category Mapping")</h4>
                <h6>Tax rule engine · Define conditions and applied tax codes</h6>
            </div>
        </div>
        <div class="page-btn mt-0">
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">
                <i class="ti ti-arrow-left"></i> Back
            </button>
        </div>
    </div>

    @if (!isInitialized)
    {
        <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(globalError))
        {
            <div class="alert alert-danger py-2 mb-3 d-flex align-items-center gap-2">
                <i class="ti ti-alert-circle"></i> @globalError
            </div>
        }

        @if (IsEdit && Model.IsUsedInPostedTransactions)
        {
            <div class="alert alert-warning py-2 mb-3">
                <i class="ti ti-alert-triangle me-2"></i>
                This mapping has been used in <strong>@Model.UsedInTransactionCount</strong> posted transaction(s).
                Structural fields (Code, Scope, Context, Tax Lines) are read-only.
            </div>
        }

        <EditForm EditContext="_editContext" OnSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="add-product" style="background:#f4f7fb; padding:24px 14px;">
                <div class="tl-accordion">

                    <!---- LEFT PANEL ------>
                    <div class="tl-left-panel">

                        <div class="tl-label @(ShowIdentity ? "active accent-orange" : "")"
                             @onclick="@(() => ToggleAccordion("identity"))">
                            <div class="tl-label-icon ico-orange"><i data-feather="info"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Core Identity</div>
                                <div class="tl-label-sub">Code, name, scope &amp; dates</div>
                            </div>
                            <span class="tl-label-chevron @(ShowIdentity ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowConditions ? "active accent-blue" : "")"
                             @onclick="@(() => ToggleAccordion("conditions"))">
                            <div class="tl-label-icon ico-blue"><i data-feather="filter"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Conditions</div>
                                <div class="tl-label-sub">Supply, party &amp; geography</div>
                            </div>
                            <span class="tl-label-chevron @(ShowConditions ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowLines ? "active accent-purple" : "")"
                             @onclick="@(() => ToggleAccordion("lines"))">
                            <div class="tl-label-icon ico-purple"><i data-feather="layers"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Tax Lines</div>
                                <div class="tl-label-sub">Applied tax codes &amp; modes</div>
                            </div>
                            <span class="tl-label-chevron @(ShowLines ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowReporting ? "active accent-green" : "")"
                             @onclick="@(() => ToggleAccordion("reporting"))">
                            <div class="tl-label-icon ico-green"><i data-feather="bar-chart-2"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Reporting</div>
                                <div class="tl-label-sub">GST classification &amp; tags</div>
                            </div>
                            <span class="tl-label-chevron @(ShowReporting ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowGovernance ? "active accent-teal" : "")"
                             @onclick="@(() => ToggleAccordion("governance"))">
                            <div class="tl-label-icon ico-teal"><i data-feather="shield"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Governance</div>
                                <div class="tl-label-sub">Lock control &amp; audit info</div>
                            </div>
                            <span class="tl-label-chevron @(ShowGovernance ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                    </div>

                    <!---- RIGHT AREA --->
                    <div class="tl-right-area">

                        <!-- ── 01 Core Identity ── -->
                        <div class="tl-card-row @(ShowIdentity ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("identity"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowIdentity ? "card-active border-orange" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("identity"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-orange">01</span>
                                            Core Identity
                                        </div>
                                        <span class="tl-card-toggle @(ShowIdentity ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>
                                    <div class="tl-collapse @(ShowIdentity ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner">
                                                <div class="row">
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Mapping Code <span class="text-danger ms-1">*</span></label>
                                                        <InputText @bind-Value="Model.MappingCode"
                                                                   class="form-control text-uppercase"
                                                                   placeholder="e.g. MAP-GST-INTRA-18"
                                                                   maxlength="30"
                                                                   disabled="@(IsEdit && Model.IsUsedInPostedTransactions)" />
                                                        <ValidationMessage For="() => Model.MappingCode" />
                                                    </div>
                                                    <div class="col-sm-5 mb-3">
                                                        <label class="form-label">Mapping Name <span class="text-danger ms-1">*</span></label>
                                                        <InputText @bind-Value="Model.MappingName"
                                                                   class="form-control"
                                                                   placeholder="Descriptive name for this rule"
                                                                   maxlength="200" />
                                                        <ValidationMessage For="() => Model.MappingName" />
                                                    </div>
                                                    <div class="col-sm-2 mb-3">
                                                        <label class="form-label">Status <span class="text-danger ms-1">*</span></label>
                                                        <InputSelect @bind-Value="Model.MappingStatus" class="form-select">
                                                            <option value="Draft">Draft</option>
                                                            <option value="Active">Active</option>
                                                            <option value="Inactive">Inactive</option>
                                                        </InputSelect>
                                                        <ValidationMessage For="() => Model.MappingStatus" />
                                                    </div>
                                                    <div class="col-sm-2 mb-3">
                                                        <label class="form-label">Priority <span class="text-danger ms-1">*</span></label>
                                                        <InputNumber @bind-Value="Model.Priority" class="form-control" min="1" />
                                                        <div class="form-text">Lower = higher</div>
                                                        <ValidationMessage For="() => Model.Priority" />
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Tax Type Scope <span class="text-danger ms-1">*</span></label>
                                                        <InputSelect @bind-Value="Model.TaxTypeScope"
                                                                     class="form-select"
                                                                     disabled="@(IsEdit && Model.IsUsedInPostedTransactions)">
                                                            <option value="">— Select Scope —</option>
                                                            <option value="GST">GST</option>
                                                            <option value="TDS">TDS</option>
                                                            <option value="TCS">TCS</option>
                                                            <option value="Mixed">Mixed</option>
                                                        </InputSelect>
                                                        <ValidationMessage For="() => Model.TaxTypeScope" />
                                                    </div>
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Transaction Context <span class="text-danger ms-1">*</span></label>
                                                        <InputSelect @bind-Value="Model.TransactionContext"
                                                                     class="form-select"
                                                                     disabled="@(IsEdit && Model.IsUsedInPostedTransactions)">
                                                            <option value="">— Select Context —</option>
                                                            <option value="AR_SalesInvoice">AR – Sales Invoice</option>
                                                            <option value="AR_SalesCreditNote">AR – Sales Credit Note</option>
                                                            <option value="AP_PurchaseBill">AP – Purchase Bill</option>
                                                            <option value="AP_PurchaseCreditNote">AP – Purchase Credit Note</option>
                                                            <option value="AP_VendorPayment">AP – Vendor Payment (TDS)</option>
                                                            <option value="Other">Other</option>
                                                        </InputSelect>
                                                        <ValidationMessage For="() => Model.TransactionContext" />
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Effective From <span class="text-danger ms-1">*</span></label>
                                                        <InputDate @bind-Value="Model.EffectiveFrom" class="form-control" />
                                                        <ValidationMessage For="() => Model.EffectiveFrom" />
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Effective To</label>
                                                        <InputDate @bind-Value="Model.EffectiveTo" class="form-control" />
                                                        <div class="form-text">Leave blank for open-ended</div>
                                                        @if (Model.EffectiveTo.HasValue && Model.EffectiveTo < Model.EffectiveFrom)
                                                        {
                                                            <div class="validation-message">Must be ≥ Effective From</div>
                                                        }
                                                    </div>
                                                    <div class="col-sm-12 mb-3">
                                                        <label class="form-label">Description</label>
                                                        <InputTextArea @bind-Value="Model.Description"
                                                                      class="form-control" rows="2" maxlength="1000"
                                                                      placeholder="Optional description or policy note" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 02 Conditions ── -->
                        <div class="tl-card-row @(ShowConditions ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("conditions"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowConditions ? "card-active border-blue" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("conditions"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-blue">02</span>
                                            Conditions — IF Rules
                                        </div>
                                        <span class="tl-card-toggle @(ShowConditions ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>
                                    <div class="tl-collapse @(ShowConditions ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner">
                                                <div class="alert alert-info py-2 mb-3" style="font-size:12px;">
                                                    <i class="ti ti-info-circle me-1"></i>
                                                    Leave fields blank to match <strong>any</strong> value. All filled conditions are combined with AND logic.
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Supply Type</label>
                                                        <InputSelect @bind-Value="Model.SupplyType" class="form-select">
                                                            <option value="">Any Supply Type</option>
                                                            <option value="IntraState">Intra-State</option>
                                                            <option value="InterState">Inter-State</option>
                                                            <option value="Import">Import</option>
                                                            <option value="Export">Export</option>
                                                            <option value="SEZ">SEZ</option>
                                                            <option value="DeemedExport">Deemed Export</option>
                                                        </InputSelect>
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Customer Type</label>
                                                        <InputSelect @bind-Value="Model.CustomerType" class="form-select">
                                                            <option value="">Any Customer Type</option>
                                                            <option value="Registered">Registered</option>
                                                            <option value="Unregistered">Unregistered</option>
                                                            <option value="Composition">Composition</option>
                                                            <option value="SEZ">SEZ</option>
                                                            <option value="Export">Export</option>
                                                        </InputSelect>
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Vendor Type</label>
                                                        <InputSelect @bind-Value="Model.VendorType" class="form-select">
                                                            <option value="">Any Vendor Type</option>
                                                            <option value="Registered">Registered</option>
                                                            <option value="Unregistered">Unregistered</option>
                                                            <option value="SEZ">SEZ</option>
                                                            <option value="ImportVendor">Import Vendor</option>
                                                        </InputSelect>
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Exempt / Nil / Non-GST</label>
                                                        <InputSelect @bind-Value="Model.IsExemptOrNilOrNonGST" class="form-select">
                                                            <option value="None">None (Taxable)</option>
                                                            <option value="Exempt">Exempt</option>
                                                            <option value="NilRated">Nil Rated</option>
                                                            <option value="NonGST">Non-GST</option>
                                                        </InputSelect>
                                                    </div>
                                                    <div class="col-sm-2 mb-3">
                                                        <label class="form-label">From State</label>
                                                        <InputText @bind-Value="Model.FromStateCode"
                                                                   class="form-control" maxlength="5" placeholder="e.g. TN" />
                                                        <ValidationMessage For="() => Model.FromStateCode" />
                                                    </div>
                                                    <div class="col-sm-2 mb-3">
                                                        <label class="form-label">To State</label>
                                                        <InputText @bind-Value="Model.ToStateCode"
                                                                   class="form-control" maxlength="5" placeholder="e.g. MH" />
                                                        <ValidationMessage For="() => Model.ToStateCode" />
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Place of Supply Rule</label>
                                                        <InputSelect @bind-Value="Model.PlaceOfSupplyRuleMode" class="form-select">
                                                            <option value="UseShipToState">Use Ship-To State</option>
                                                            <option value="UseBillToState">Use Bill-To State</option>
                                                            <option value="ServicePlaceOfSupplyPolicy">Service POS Policy</option>
                                                            <option value="ManualOverrideAllowed">Manual Override Allowed</option>
                                                        </InputSelect>
                                                    </div>
                                                    <div class="col-sm-2 mb-3">
                                                        <label class="form-label">HSN / SAC</label>
                                                        <InputText @bind-Value="Model.HSNOrSAC"
                                                                   class="form-control" maxlength="20" placeholder="Optional" />
                                                        <ValidationMessage For="() => Model.HSNOrSAC" />
                                                    </div>
                                                    <div class="col-sm-2 mb-3">
                                                        <label class="form-label">Is Service?</label>
                                                        <select class="form-select" @onchange="OnIsServiceChange">
                                                            <option value="">Any</option>
                                                            <option value="true" selected="@(Model.IsService == true)">Yes – Service</option>
                                                            <option value="false" selected="@(Model.IsService == false)">No – Goods</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Reverse Charge?</label>
                                                        <select class="form-select" @onchange="OnRCMChange">
                                                            <option value="">Any</option>
                                                            <option value="true" selected="@(Model.IsReverseChargeApplicable == true)">Yes – RCM</option>
                                                            <option value="false" selected="@(Model.IsReverseChargeApplicable == false)">No – Forward Charge</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-sm-12 mb-3">
                                                        <label class="form-label">Condition JSON <span class="text-muted">(Advanced)</span></label>
                                                        <InputTextArea @bind-Value="Model.ConditionJson"
                                                                      class="form-control" rows="3"
                                                                      style="font-family:monospace;font-size:12px;"
                                                                      placeholder='{"vendorPAN":"required","section":"194C"}' />
                                                        <div class="form-text">Optional JSON for advanced rule conditions.</div>
                                                    </div>
                                                </div>
                                                @if (Model.TaxTypeScope == "GST" && Model.IsExemptOrNilOrNonGST == "None")
                                                {
                                                    <div class="alert alert-warning py-2" style="font-size:12px;">
                                                        <i class="ti ti-alert-triangle me-1"></i>
                                                        <strong>GST Rule:</strong> Intra-State → CGST + SGST lines only.
                                                        Inter-State / Export / SEZ → IGST line only.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 03 Tax Lines ── CARD LAYOUT (not table) ── -->
                        <div class="tl-card-row @(ShowLines ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("lines"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowLines ? "card-active border-purple" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("lines"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-purple">03</span>
                                            Applied Tax Set — THEN Rules
                                            <span class="badge bg-primary ms-2" style="font-size:10px;">@Model.Lines.Count</span>
                                        </div>
                                        <span class="tl-card-toggle @(ShowLines ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>
                                    <div class="tl-collapse @(ShowLines ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner">

                                                @if (Model.IsExemptOrNilOrNonGST != "None")
                                                {
                                                    <div class="alert alert-warning py-2 mb-3" style="font-size:12px;">
                                                        <i class="ti ti-info-circle me-1"></i>
                                                        Mapping marked as <strong>@Model.IsExemptOrNilOrNonGST</strong>. Tax lines should be empty or all inactive.
                                                    </div>
                                                }

                                                @if (!string.IsNullOrEmpty(lineError))
                                                {
                                                    <div class="alert alert-danger py-2 mb-3" style="font-size:12px;">
                                                        <i class="ti ti-alert-circle me-1"></i>@lineError
                                                    </div>
                                                }

                                                <!-- ══ Per-line cards ══ -->
                                                @foreach (var line in Model.Lines.OrderBy(l => l.LineNumber))
                                                {
                                                    <div @key="line.Id" class="line-card @(!line.IsLineActive ? "line-inactive-card" : "")">

                                                        <!-- Line Header -->
                                                        <div class="line-card-header">
                                                            <span class="line-badge">@line.LineNumber</span>
                                                            <span class="line-card-title">
                                                                @if (!string.IsNullOrEmpty(line.TaxCodeCode))
                                                                {
                                                                    @line.TaxCodeCode
                                                                    @if (!string.IsNullOrEmpty(line.TaxCodeName))
                                                                    {
                                                                        <span class="text-muted fw-normal ms-2" style="font-size:12px;">@line.TaxCodeName</span>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted fw-normal">Tax Line @line.LineNumber</span>
                                                                }
                                                            </span>
                                                            <!-- Active toggle -->
                                                            <div class="form-check form-switch mb-0 me-2">
                                                                <input class="form-check-input" type="checkbox"
                                                                       id="lineActive_@line.Id"
                                                                       checked="@line.IsLineActive"
                                                                       @onchange="e => line.IsLineActive = (bool)(e.Value ?? true)" />
                                                                <label class="form-check-label" for="lineActive_@line.Id" style="font-size:12px;">
                                                                    @(line.IsLineActive ? "Active" : "Inactive")
                                                                </label>
                                                            </div>
                                                            <!-- Remove -->
                                                            <button type="button" class="btn btn-sm btn-outline-danger p-1"
                                                                    @onclick="() => RemoveLine(line)"
                                                                    disabled="@(IsEdit && Model.IsUsedInPostedTransactions)"
                                                                    title="Remove this line">
                                                                <i class="ti ti-trash" style="font-size:14px;"></i>
                                                            </button>
                                                        </div>

                                                        <!-- Row 1: Tax Code + Component + Direction + Apply Mode -->
                                                        <div class="row g-3 mb-2">
                                                            <div class="col-sm-3">
                                                                <div class="line-section-label">Tax Code <span class="text-danger">*</span></div>
                                                                <input class="form-control form-control-sm @(showValidation && string.IsNullOrEmpty(line.TaxCodeCode) ? "is-invalid" : "")"
                                                                       value="@line.TaxCodeCode"
                                                                       @oninput="e => line.TaxCodeCode = e.Value?.ToString()"
                                                                       placeholder="Enter tax code"
                                                                       disabled="@(IsEdit && Model.IsUsedInPostedTransactions)" />
                                                                @if (showValidation && string.IsNullOrEmpty(line.TaxCodeCode))
                                                                {
                                                                    <div class="validation-message">Required</div>
                                                                }
                                                            </div>
                                                            <div class="col-sm-3">
                                                                <div class="line-section-label">Tax Code Name</div>
                                                                <input class="form-control form-control-sm"
                                                                       value="@line.TaxCodeName"
                                                                       @oninput="e => line.TaxCodeName = e.Value?.ToString()"
                                                                       placeholder="Display name"
                                                                       disabled="@(IsEdit && Model.IsUsedInPostedTransactions)" />
                                                            </div>
                                                            <div class="col-sm-3">
                                                                <div class="line-section-label">Component</div>
                                                                <input class="form-control form-control-sm"
                                                                       value="@line.TaxCodeComponent"
                                                                       @oninput="e => line.TaxCodeComponent = e.Value?.ToString()"
                                                                       placeholder="e.g. CGST, SGST"
                                                                       disabled="@(IsEdit && Model.IsUsedInPostedTransactions)" />
                                                            </div>
                                                            <div class="col-sm-3">
                                                                <div class="line-section-label">Direction</div>
                                                                <input class="form-control form-control-sm"
                                                                       value="@line.TaxCodeDirection"
                                                                       @oninput="e => line.TaxCodeDirection = e.Value?.ToString()"
                                                                       placeholder="e.g. Output, Input"
                                                                       disabled="@(IsEdit && Model.IsUsedInPostedTransactions)" />
                                                            </div>
                                                        </div>

                                                        <hr class="line-divider" />

                                                        <!-- Row 2: Apply Mode + Rate Source + Override % + Rate Date Basis -->
                                                        <div class="row g-3 mb-2">
                                                            <div class="col-sm-3">
                                                                <div class="line-section-label">Apply Mode <span class="text-danger">*</span></div>
                                                                <select class="form-select form-select-sm"
                                                                        value="@line.ApplyMode"
                                                                        @onchange="e => line.ApplyMode = e.Value?.ToString() ?? string.Empty"
                                                                        disabled="@(IsEdit && Model.IsUsedInPostedTransactions)">
                                                                    <option value="AddOn">Add-On (Exclusive)</option>
                                                                    <option value="Inclusive">Inclusive</option>
                                                                    <option value="Withholding">Withholding (TDS)</option>
                                                                    <option value="Collection">Collection (TCS)</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-sm-3">
                                                                <div class="line-section-label">Rate Source <span class="text-danger">*</span></div>
                                                                <select class="form-select form-select-sm"
                                                                        value="@line.RateResolutionMode"
                                                                        @onchange="e => line.RateResolutionMode = e.Value?.ToString() ?? string.Empty"
                                                                        disabled="@(IsEdit && Model.IsUsedInPostedTransactions)">
                                                                    <option value="FromTaxRateVersionByDate">From Rate Version</option>
                                                                    <option value="FixedOverrideRate">Fixed Override Rate</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-sm-3">
                                                                <div class="line-section-label">Override Rate %</div>
                                                                @if (line.RateResolutionMode == "FixedOverrideRate")
                                                                {
                                                                    <div class="input-group input-group-sm">
                                                                        <input type="number" class="form-control form-control-sm"
                                                                               value="@line.OverrideRatePercent"
                                                                               @oninput="e => line.OverrideRatePercent = decimal.TryParse(e.Value?.ToString(), out var v) ? v : null"
                                                                               min="0" max="100" step="0.01" placeholder="0.00" />
                                                                        <span class="input-group-text">%</span>
                                                                    </div>
                                                                    @if (showValidation && line.OverrideRatePercent == null)
                                                                    {
                                                                        <div class="validation-message">Required for Fixed Override</div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <input class="form-control form-control-sm" disabled value="From Rate Version" />
                                                                }
                                                            </div>
                                                            <div class="col-sm-3">
                                                                <div class="line-section-label">Rate Date Basis</div>
                                                                <select class="form-select form-select-sm"
                                                                        value="@line.RateEffectiveDateBasis"
                                                                        @onchange="e => line.RateEffectiveDateBasis = e.Value?.ToString() ?? string.Empty">
                                                                    <option value="PostingDate">Posting Date</option>
                                                                    <option value="DocumentDate">Document Date</option>
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <!-- Row 3: ITC Override + RCM + GL Override + Notes -->
                                                        <div class="row g-3">
                                                            <div class="col-sm-3">
                                                                <div class="line-section-label">ITC Eligibility Override</div>
                                                                <select class="form-select form-select-sm"
                                                                        value="@line.ITCEligibilityOverride"
                                                                        @onchange="e => line.ITCEligibilityOverride = e.Value?.ToString() ?? string.Empty">
                                                                    <option value="Inherit">Inherit from Tax Code</option>
                                                                    <option value="Eligible">Eligible</option>
                                                                    <option value="Ineligible">Ineligible</option>
                                                                    <option value="Provisional">Provisional</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-sm-3">
                                                                <div class="line-section-label">RCM Behavior</div>
                                                                <select class="form-select form-select-sm"
                                                                        value="@line.RCMBehavior"
                                                                        @onchange="e => line.RCMBehavior = e.Value?.ToString() ?? string.Empty">
                                                                    <option value="Normal">Normal</option>
                                                                    <option value="RCM_OutputLiabilityOnly">Output Liability Only</option>
                                                                    <option value="RCM_OutputPlusInputCredit">Output + Input Credit</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-sm-3">
                                                                <div class="line-section-label">GL Account Override</div>
                                                                <input class="form-control form-control-sm"
                                                                       value="@line.GLAccountOverrideName"
                                                                       @oninput="e => line.GLAccountOverrideName = e.Value?.ToString()"
                                                                       placeholder="Optional GL override" />
                                                            </div>
                                                            <div class="col-sm-3">
                                                                <div class="line-section-label">Line Notes</div>
                                                                <input class="form-control form-control-sm"
                                                                       value="@line.LineNotes"
                                                                       @oninput="e => line.LineNotes = e.Value?.ToString()"
                                                                       maxlength="300" placeholder="Optional notes" />
                                                            </div>
                                                        </div>

                                                    </div>
                                                }

                                                <!-- Add Line Button Area -->
                                                @if (!(IsEdit && Model.IsUsedInPostedTransactions))
                                                {
                                                    <div class="add-line-btn-area" @onclick="AddLine">
                                                        <i class="ti ti-plus me-2" style="font-size:16px;color:#6d28d9;"></i>
                                                        <span style="font-size:13px;font-weight:600;color:#6d28d9;">Add Tax Line</span>
                                                        <div class="text-muted mt-1" style="font-size:11px;">Click to add a new tax code line to this mapping</div>
                                                    </div>
                                                }

                                                @if (Model.Lines.Any())
                                                {
                                                    <div class="d-flex gap-3 justify-content-end mt-3 text-muted" style="font-size:11px;">
                                                        <span>Total: @Model.Lines.Count</span>
                                                        <span class="text-success fw-medium">Active: @Model.Lines.Count(l => l.IsLineActive)</span>
                                                        <span class="text-secondary">Inactive: @Model.Lines.Count(l => !l.IsLineActive)</span>
                                                    </div>
                                                }

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 04 Reporting ── -->
                        <div class="tl-card-row @(ShowReporting ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("reporting"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowReporting ? "card-active border-green" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("reporting"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-green">04</span>
                                            Reporting &amp; Classification
                                        </div>
                                        <span class="tl-card-toggle @(ShowReporting ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>
                                    <div class="tl-collapse @(ShowReporting ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner">
                                                <div class="row">
                                                    <div class="col-sm-5 mb-3">
                                                        <label class="form-label">GST Return Classification</label>
                                                        <InputSelect @bind-Value="Model.GSTReturnClassification" class="form-select">
                                                            <option value="">None / Not Applicable</option>
                                                            <option value="Outward_Taxable">Outward – Taxable</option>
                                                            <option value="Outward_Exempt">Outward – Exempt</option>
                                                            <option value="Outward_Nil">Outward – Nil Rated</option>
                                                            <option value="Outward_Export">Outward – Export</option>
                                                            <option value="Inward_ITC_Eligible">Inward – ITC Eligible</option>
                                                            <option value="Inward_ITC_Ineligible">Inward – ITC Ineligible</option>
                                                            <option value="RCM_Liability">RCM Liability</option>
                                                        </InputSelect>
                                                        <div class="form-text">Used by GST Return Run (#71) to classify transactions</div>
                                                    </div>
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Invoice-Level Reporting</label>
                                                        <div class="form-check form-switch mt-2">
                                                            <input class="form-check-input" type="checkbox" id="invoiceLvlRpt"
                                                                   checked="@Model.RequiresInvoiceLevelReporting"
                                                                   @onchange="e => Model.RequiresInvoiceLevelReporting = (bool)(e.Value ?? true)" />
                                                            <label class="form-check-label" for="invoiceLvlRpt">
                                                                @(Model.RequiresInvoiceLevelReporting ? "Yes — Invoice-level" : "No — Summary only")
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-12 mb-3">
                                                        <label class="form-label">Condition JSON Preview</label>
                                                        @if (!string.IsNullOrWhiteSpace(Model.ConditionJson))
                                                        {
                                                            <pre class="p-3 rounded" style="background:#f8f9fa;font-size:12px;max-height:100px;overflow-y:auto;border:1px solid #dee2e6;">@Model.ConditionJson</pre>
                                                        }
                                                        else
                                                        {
                                                            <div class="p-3 rounded text-muted" style="background:#f8f9fa;font-size:12px;border:1px solid #dee2e6;">
                                                                No condition JSON. Set it in the Conditions section.
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 05 Governance ── -->
                        <div class="tl-card-row @(ShowGovernance ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("governance"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowGovernance ? "card-active border-teal" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("governance"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-teal">05</span>
                                            Governance &amp; Lock Control
                                        </div>
                                        <span class="tl-card-toggle @(ShowGovernance ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>
                                    <div class="tl-collapse @(ShowGovernance ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner">
                                                <div class="row">
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Lock for Changes</label>
                                                        <div class="form-check form-switch mt-2">
                                                            <input class="form-check-input" type="checkbox" id="lockChk"
                                                                   checked="@Model.IsLockedForChanges"
                                                                   @onchange="e => Model.IsLockedForChanges = (bool)(e.Value ?? false)" />
                                                            <label class="form-check-label" for="lockChk">
                                                                @(Model.IsLockedForChanges ? "🔒 Locked" : "🔓 Unlocked")
                                                            </label>
                                                        </div>
                                                        <div class="form-text">Controller only. Prevents any further edits.</div>
                                                    </div>
                                                    @if (Model.IsLockedForChanges)
                                                    {
                                                        <div class="col-sm-6 mb-3">
                                                            <label class="form-label">Lock Reason <span class="text-danger ms-1">*</span></label>
                                                            <InputText @bind-Value="Model.LockReason"
                                                                       class="@($"form-control {(Model.IsLockedForChanges && string.IsNullOrWhiteSpace(Model.LockReason) ? "is-invalid" : "")}")"
                                                                       maxlength="300"
                                                                       placeholder="Reason for locking this mapping..." />
                                                            @if (Model.IsLockedForChanges && string.IsNullOrWhiteSpace(Model.LockReason))
                                                            {
                                                                <div class="invalid-feedback d-block">Lock reason is required when locking.</div>
                                                            }
                                                        </div>
                                                    }
                                                    <div class="col-sm-12 mb-3">
                                                        <div class="alert alert-info py-2" style="font-size:12px;">
                                                            <i class="ti ti-shield-check me-1"></i>
                                                            <strong>Conflict Rule:</strong> No two Active mappings with identical conditions and overlapping
                                                            effective dates should share the same priority.
                                                        </div>
                                                    </div>
                                                    @if (IsEdit)
                                                    {
                                                        <div class="col-sm-12">
                                                            <div class="card" style="background:#f8f9fa;">
                                                                <div class="card-body py-2">
                                                                    <div class="row text-muted" style="font-size:12px;">
                                                                        <div class="col-md-3">
                                                                            <small class="d-block fw-bold">Created At</small>
                                                                            <div>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <small class="d-block fw-bold">Created By</small>
                                                                            <div>@(Model.CreatedBy ?? "—")</div>
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <small class="d-block fw-bold">Updated At</small>
                                                                            <div>@(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm") : "—")</div>
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <small class="d-block fw-bold">Used in Transactions</small>
                                                                            <div class="fw-bold @(Model.IsUsedInPostedTransactions ? "text-danger" : "text-success")">
                                                                                @Model.UsedInTransactionCount
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="page-btn d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">
                        <i class="ti ti-x"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="ti ti-device-floppy"></i> @(IsEdit ? "Update" : "Save")
                    </button>
                </div>
            </div>
        </EditForm>
    }
</div>
