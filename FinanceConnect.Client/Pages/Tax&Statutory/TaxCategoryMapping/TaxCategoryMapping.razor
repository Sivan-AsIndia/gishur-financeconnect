@page "/tax-category-mapping"
@using static FinanceConnect.Client.ViewModels.TaxCategoryMappingViewModel

<style>
    @@media(max-width:635px) { .responsivefilter { flex-wrap: wrap; } }
    .lock-badge { background:#f8d7da;color:#842029;border-radius:4px;padding:2px 6px;font-size:10px;font-weight:700; }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else
{
    @if (isLoading) { <div class="page-loading-overlay"><div class="whirly-loader"></div></div> }

    <div class="content List-view">

        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Tax Category Mapping</h4>
                    <h6>Tax rule engine — applicability and applied tax codes</h6>
                </div>
            </div>
            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>
              <div class="page-btn">
            <a href="/tax-category-mapping/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i> Create
            </a>
        </div>
        </div>

        <div class="card">

            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm"
                               placeholder="Search code, name..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>
                <div style="display:flex; gap:8px;" class="responsivefilter">
                    <select class="form-select form-select-sm" style="min-width:130px"
                            @bind="SelectedStatus" @bind:event="oninput" @onchange="OnFilterChanged">
                        <option value="">All Status</option>
                        <option value="1">Active</option>
                        <option value="2">Inactive</option>
                        <option value="3">Archived</option>
                    </select>
                    <select class="form-select form-select-sm" style="min-width:120px"
                            @bind="SelectedScope" @bind:event="oninput" @onchange="OnFilterChanged">
                        <option value="">All Scopes</option>
                        <option value="1">GST</option>
                        <option value="2">TDS</option>
                        <option value="3">TCS</option>
                        <option value="4">Mixed</option>
                    </select>
                    <select class="form-select form-select-sm" style="min-width:170px"
                            @bind="SelectedContext" @bind:event="oninput" @onchange="OnFilterChanged">
                        <option value="">All Contexts</option>
                        <option value="1">Sales Invoice</option>
                        <option value="3">Purchase Bill</option>
                        <option value="5">Vendor Payment (TDS)</option>
                    </select>
                </div>
            </div>

            <div class="card-body p-0">
                <div>
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th>Mapping Code</th>
                                <th class="d-none d-md-table-cell">Scope</th>
                                <th class="d-none d-md-table-cell">Context</th>
                                <th class="d-none d-lg-table-cell">Supply Type</th>
                                <th class="d-none d-lg-table-cell text-center">Lines</th>
                                <th class="d-none d-xl-table-cell">Effective From</th>
                                @* <th class="d-none d-xxl-table-cell">Priority</th> *@
                                <th class="d-none d-xxl-table-cell">Status</th>
                                <th class="no-sort">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedItems.Any())
                            {
                                @foreach (var item in PagedItems)
                                {
                                    <tr @key="item.TaxCategoryMappingId">

                                        <!-- Mobile expand -->
                                        <td class="d-xl-none text-center" style="padding:0; padding-left:15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal" data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenViewModal(item)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <!-- Mapping Code -->
                                        <td>
                                            <span class="fw-medium">
                                                <span class="PopupIcon me-1">⧉</span>
                                                <a @onclick="() => OpenViewModal(item)"  title="@item.MappingCode Details"  data-bs-toggle="tooltip" data-bs-placement="top"
                                                   class="text-decoration-none link-View" href="/tax-category-mapping/@item.TaxCategoryMappingId/view">
                                                    @item.MappingCode
                                                </a>
                                            </span>
                                            @if (item.IsLockedForChanges)
                                            {
                                                <span class="lock-badge ms-1"><i class="ti ti-lock"></i></span>
                                            }
                                            <div class="text-muted" style="font-size:0.72rem;margin-top:2px;">@item.MappingName</div>
                                        </td>

                                        <!-- Scope -->
                                        <td class="d-none d-md-table-cell">
                                            <span class="badge @TaxMappingHelper.GetScopeClass(item.TaxTypeScope)">@item.TaxTypeScope</span>
                                        </td>

                                        <!-- Context -->
                                        <td class="d-none d-md-table-cell" style="font-size:11px;">
                                            @TaxMappingHelper.GetContextLabel(item.TransactionContext)
                                        </td>

                                        <!-- Supply Type -->
                                        <td class="d-none d-lg-table-cell" style="font-size:12px;">
                                            @if (item.SupplyType.HasValue)
                                            {
                                                <span>@item.SupplyType</span>
                                            }
                                            else if (item.IsExemptOrNilOrNonGST != ExemptType.None)
                                            {
                                                <span class="badge bg-warning-transparent text-dark badge-sm">@item.IsExemptOrNilOrNonGST</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>

                                        <!-- Lines -->
                                        <td class="d-none d-lg-table-cell text-center">
                                            <span class="badge bg-primary-transparent">@item.LineCount</span>
                                        </td>

                                        <!-- Effective From -->
                                        <td class="d-none d-xl-table-cell" style="font-size:12px;">
                                            @item.EffectiveFrom.ToString("dd MMM yyyy")
                                            @if (item.EffectiveTo.HasValue)
                                            {
                                                <div class="text-muted" style="font-size:10px;">To: @item.EffectiveTo.Value.ToString("dd MMM yyyy")</div>
                                            }
                                            else
                                            {
                                                <div class="text-muted" style="font-size:10px;">Open-ended</div>
                                            }
                                        </td>

                                        <!-- Priority -->
                                        @* <td class="d-none d-xxl-table-cell" style="font-size:12px;font-weight:600;">
                                            @item.Priority
                                        </td> *@

                                        <!-- Status -->
                                        <td class="d-none d-xxl-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @TaxMappingHelper.GetStatusDot(item.MappingStatus)"></div>
                                                <span style="font-size:12px;">@TaxMappingHelper.GetStatusLabel(item.MappingStatus)</span>
                                            </div>
                                        </td>

                                        <!-- Actions -->
                                        <td class="action-table-data">
                                            <div class="edit-delete-action">
                                                <a class="me-2 view-icon p-1" title="View" href="/tax-category-mapping/@item.TaxCategoryMappingId/view" 
                                                 
                                                   @onclick="() => OpenViewModal(item)">
                                                    <i data-feather="eye"></i>
                                                </a>
                                                @if (!item.IsLockedForChanges)
                                                {
                                                    <a class="me-2 edit-icon p-1" title="Edit"
                                                       href="/tax-category-mapping/@item.TaxCategoryMappingId/edit">
                                                        <i data-feather="edit"></i>
                                                    </a>
                                                }
                                                @if (item.MappingStatus == MappingStatus.Active)
                                                {
                                                    <a class="me-2 p-1 pause" title="Inactivate"
                                                       @onclick="() => OnInactivate(item.TaxCategoryMappingId)">
                                                        <i class="ti ti-player-pause"></i>
                                                    </a>
                                                }
                                                @if (item.MappingStatus == MappingStatus.Inactive)
                                                {
                                                    <a class="me-2 p-1 play-icon" title="Activate"
                                                       @onclick="() => OnActivate(item.TaxCategoryMappingId)">
                                                        <i class="ti ti-player-play"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4 text-muted">
                                        <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                        No tax mappings found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (PagedItems.Any())
                {
                    <div class="d-flex justify-content-between align-items-center p-3">
                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChange">
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="#" @onclick="PreviousPage" @onclick:preventDefault>
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @foreach (var p in VisiblePages)
                                {
                                    <li class="page-item @(p == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(p)">@p</button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="#" @onclick="NextPage" @onclick:preventDefault>
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- ═══ Mobile Row Detail Modal ═════════════════════════════════ -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Mapping Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute; transform:none"></button>
            </div>
            @if (SelectedItem != null)
            {
                <div class="modal-body">
                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Scope:</strong>
                        <span class="badge @TaxMappingHelper.GetScopeClass(SelectedItem.TaxTypeScope)">@SelectedItem.TaxTypeScope</span>
                    </div>
                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Context:</strong>
                        <div>@TaxMappingHelper.GetContextLabel(SelectedItem.TransactionContext)</div>
                    </div>
                    <div class="mb-2 d-flex gap-3 d-lg-none">
                        <strong>Supply:</strong>
                        <div>@(SelectedItem.SupplyType?.ToString() ?? "—")</div>
                    </div>
                    <div class="mb-2 d-flex gap-3 d-lg-none">
                        <strong>Lines:</strong>
                        <span class="badge bg-primary-transparent">@SelectedItem.LineCount</span>
                    </div>
                    <div class="mb-2 d-flex gap-3 d-xxl-none">
                        <strong>Status:</strong>
                        <span class="badge @TaxMappingHelper.GetStatusClass(SelectedItem.MappingStatus)">
                            @TaxMappingHelper.GetStatusLabel(SelectedItem.MappingStatus)
                        </span>
                    </div>
                    <div class="mb-2 d-flex gap-3 d-xl-none">
                        <strong>Effective:</strong>
                        <div>@SelectedItem.EffectiveFrom.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Priority:</strong>
                        <div>@SelectedItem.Priority</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Exempt:</strong>
                        <div>@SelectedItem.IsExemptOrNilOrNonGST</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
