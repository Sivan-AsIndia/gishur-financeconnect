@page "/tax-codes"
@using static FinanceConnect.Client.ViewModels.TaxCodeViewModel

<style>
    @@media(max-width:635px) {
        .responsivefilter {
            flex-wrap: wrap;
        }
    }
</style>

<div class="content List-view">

    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Tax Code List</h4>
                <h6>Manage Tax Codes (GST / TDS / TCS)</h6>
            </div>
        </div>
        <ul class="table-top-head me-2">
            <li>
                <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>
        <div class="page-btn">
            <a href="/tax-codes/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i> Create
            </a>
        </div>
    </div>

    <div class="card">

        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                    <input type="search" class="form-control form-control-sm"
                           placeholder="Search code, name, section..."
                           @bind="searchText" @oninput="OnSearch" />
                </div>
            </div>
            <div style="display:flex; gap:15px;" class="responsivefilter">
                <select class="form-select form-select-sm" style="min-width:160px"
                        @bind="SelectedType" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Types</option>
                    <option value="1">GST</option>
                    <option value="2">TDS</option>
                    <option value="3">TCS</option>
                    <option value="4">Other</option>
                </select>
                <select class="form-select form-select-sm" style="min-width:160px"
                        @bind="SelectedStatus" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Status</option>
                    <option value="1">Active</option>
                    <option value="2">Inactive</option>
                    <option value="3">Archived</option>
                </select>
            </div>
        </div>

        <div class="card-body p-0">
            <table class="table align-middle w-100 table-fixed">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xxl-none" style="width:40px"></th>
                        <th>Tax Code</th>
                        <th class="d-none d-md-table-cell">Tax Name</th>
                        <th class="d-none d-xl-table-cell">Type</th>
                        <th class="d-none d-xxl-table-cell">Component / Section</th>
                        <th class="d-none d-xxl-table-cell">Direction</th>
                        <th class="d-none d-xl-table-cell">Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedCodes.Any())
                    {
                        @foreach (var tc in PagedCodes)
                        {
                            <tr>
                                <td class="d-xxl-none text-center" style="padding:0;padding-left:15px;">
                                    <a href="javascript:void(0);" class="TablePlus"
                                           data-bs-toggle="modal" data-bs-target="#rowDetailsModal"
                                           @onclick="() => OpenRowDetails(tc)">
                                        <i class="ti ti-plus"></i>
                                    </a>
                                </td>

                                <td>
                                    <span class="fw-medium">
                                        <i class="ti ti-external-link me-2 PopupIcon"></i>
                                        <a href="/tax-codes/@tc.TaxCodeId/view"
                                               class="link-View text-decoration-none"
                                               data-bs-toggle="tooltip" data-bs-placement="top"
                                               title="@tc.Code details">
                                            @tc.Code
                                        </a>
                                    </span>
                                    @if (tc.IsLockedForChanges)
                                    {
                                        <i class="ti ti-lock ms-1 text-warning" title="Locked" data-bs-toggle="tooltip"></i>
                                    }
                                </td>

                                <td class="d-none d-md-table-cell">
                                    <div>@tc.TaxName</div>
                                    @if (!string.IsNullOrWhiteSpace(tc.Description))
                                    {
                                        <small class="text-muted">@(tc.Description.Length > 50 ? tc.Description[..50] + "…" : tc.Description)</small>
                                    }
                                </td>

                                <td class="d-none d-xl-table-cell">
                                    <span class="badge @GetTypeBadgeClass(tc.Type)">
                                        @GetTypeLabel(tc.Type)
                                    </span>
                                </td>

                                <td class="d-none d-xxl-table-cell">
                                    @if (tc.Type == TaxType.GST && tc.GSTComponent.HasValue)
                                    {
                                        <span class="badge bg-light text-dark">@tc.GSTComponent</span>
                                    }
                                    else if (tc.Type == TaxType.TDS && !string.IsNullOrWhiteSpace(tc.TDSSectionCode))
                                    {
                                        <span class="badge bg-light text-dark">§ @tc.TDSSectionCode</span>
                                    }
                                    else if (tc.Type == TaxType.TCS && !string.IsNullOrWhiteSpace(tc.TCSSectionCode))
                                    {
                                        <span class="badge bg-light text-dark">§ @tc.TCSSectionCode</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td class="d-none d-xxl-table-cell">
                                    <span class="badge @GetDirectionBadgeClass(tc.Direction)">
                                        @GetDirectionLabel(tc.Direction)
                                    </span>
                                </td>

                                <td class="d-none d-xl-table-cell">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="ActiveDot @GetStatusDotClass(tc.Status)"></div>
                                        <span>@GetStatusLabel(tc.Status)</span>
                                    </div>
                                </td>

                                <!-- ACTION COLUMN -->
                                <td class="action-table-data">
                                    <div class="edit-delete-action">

                                        <!-- Edit (non-locked, non-archived) -->
                                        @if (!tc.IsLockedForChanges && tc.Status != TaxCodeStatus.Archived)
                                        {
                                            <a class="me-2 p-1 edit-icon"
                                                   href="/tax-codes/edit/@tc.TaxCodeId" title="Edit">
                                                <i data-feather="edit"></i>
                                            </a>
                                        }

                                        <!-- Activate -->
                                        @if (tc.Status == TaxCodeStatus.Inactive)
                                        {
                                            <a class="me-2 p-1 action-icon icon-approve"
                                                   href="javascript:void(0);"
                                                   title="Activate"
                                                   data-bs-toggle="tooltip"
                                                   @onclick="() => OnActivate(tc.TaxCodeId)">
                                                <i class="ti ti-circle-check"></i>
                                            </a>
                                        }

                                        <!-- Inactivate -->
                                        @if (tc.Status == TaxCodeStatus.Active && !tc.IsLockedForChanges)
                                        {
                                            <a class="me-2 p-1 action-icon icon-cancel"
                                                   href="javascript:void(0);"
                                                   title="Inactivate"
                                                   data-bs-toggle="tooltip"
                                                   @onclick="() => OnInactivate(tc.TaxCodeId)">
                                                <i class="ti ti-ban"></i>
                                            </a>
                                        }

                                        <!-- Lock -->
                                        @if (!tc.IsLockedForChanges && tc.Status == TaxCodeStatus.Active)
                                        {
                                            <a class="me-2 p-1 action-icon icon-submit"
                                                   href="javascript:void(0);"
                                                   title="Lock"
                                                   data-bs-toggle="tooltip"
                                                   @onclick="() => OpenLockModal(tc)">
                                                <i class="ti ti-lock"></i>
                                            </a>
                                        }

                                        <!-- Unlock -->
                                        @if (tc.IsLockedForChanges)
                                        {
                                            <a class="me-2 p-1 action-icon icon-receive"
                                                   href="javascript:void(0);"
                                                   title="Unlock"
                                                   data-bs-toggle="tooltip"
                                                   @onclick="() => OnUnlock(tc.TaxCodeId)">
                                                <i class="ti ti-lock-open"></i>
                                            </a>
                                        }

                                        <!-- Archive -->
                                        @if (tc.Status != TaxCodeStatus.Archived && !tc.IsLockedForChanges)
                                        {
                                            <a class="me-2 p-1 action-icon icon-reverse"
                                                   href="javascript:void(0);"
                                                   title="Archive"
                                                   data-bs-toggle="tooltip"
                                                   @onclick="() => OnArchive(tc.TaxCodeId)">
                                                <i class="ti ti-archive"></i>
                                            </a>
                                        }

                                        <!-- Delete -->
                                        <a class="me-2 p-1 delete-icon action-icon"
                                               href="javascript:void(0);"
                                               title="Delete"
                                               data-bs-toggle="modal"
                                               data-bs-target="#delete-modal"
                                               @onclick="() => DeletePopupOpen(tc)">
                                            <i class="ti ti-trash"></i>
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No tax codes found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (FilteredCodes.Count > 0)
        {
            <div class="d-flex align-items-center justify-content-between p-3">
                <div class="d-flex align-items-center fs-13">
                    <span class="me-2">Rows per page</span>
                    <select class="form-select form-select-sm" style="width:80px" @onchange="OnPageSizeChange">
                        <option value="5" selected="@(PageSize == 5)">5</option>
                        <option value="10" selected="@(PageSize == 10)">10</option>
                        <option value="25" selected="@(PageSize == 25)">25</option>
                        <option value="50" selected="@(PageSize == 50)">50</option>
                    </select>
                    <span class="ms-2">Entries</span>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                <i class="ti ti-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = StartPage; i <= EndPage; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                <a class="page-link" href="javascript:void(0);"
                                   @onclick="() => GoToPage(pageNum)">@pageNum</a>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                <i class="ti ti-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }

    </div>

    <!-- ═══ Responsive Row Details Modal ═══ -->
    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Tax Code Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            style="padding:0; right:22px; position:absolute; transform:none"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2 d-flex gap-3">
                        <strong>Code:</strong>
                        <div>@SelectedCode?.Code</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Name:</strong>
                        <div>@SelectedCode?.TaxName</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Type:</strong>
                        <div>@GetTypeLabel(SelectedCode?.Type)</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Direction:</strong>
                        <div>@GetDirectionLabel(SelectedCode?.Direction)</div>
                    </div>
                    @if (SelectedCode?.Type == TaxType.GST)
                    {
                        <div class="mb-2 d-flex gap-3">
                            <strong>GST Component:</strong>
                            <div>@SelectedCode?.GSTComponent</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Return Tag:</strong>
                            <div>@SelectedCode?.ReturnTag</div>
                        </div>
                    }
                    @if (SelectedCode?.Type == TaxType.TDS)
                    {
                        <div class="mb-2 d-flex gap-3">
                            <strong>TDS Section:</strong>
                            <div>@SelectedCode?.TDSSectionCode</div>
                        </div>
                    }
                    @if (SelectedCode?.Type == TaxType.TCS)
                    {
                        <div class="mb-2 d-flex gap-3">
                            <strong>TCS Section:</strong>
                            <div>@SelectedCode?.TCSSectionCode</div>
                        </div>
                    }
                    <div class="mb-2 d-flex gap-3">
                        <strong>Status:</strong>
                        @if (SelectedCode != null)
                        {
                            <span class="badge @GetStatusBadgeClass(SelectedCode.Status)">
                                @GetStatusLabel(SelectedCode.Status)
                            </span>
                        }
                    </div>
                    @if (SelectedCode?.IsLockedForChanges == true)
                    {
                        <div class="mb-2 d-flex gap-3">
                            <strong>Lock Reason:</strong>
                            <div class="text-warning">@SelectedCode.LockReason</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ Delete Modal ═══ -->
    <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Tax Code</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            @if (SelectedCode?.Status == TaxCodeStatus.Inactive || SelectedCode?.Status == TaxCodeStatus.Archived)
                            {
                                <span>Are you sure you want to delete <strong>@SelectedCode?.Code</strong>?</span>
                            }
                            else
                            {
                                <span class="text-danger">Only Inactive or Archived tax codes can be deleted.</span>
                            }
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4"
                                    data-bs-dismiss="modal">
                                <i class="ti ti-x me-1"></i>Cancel
                            </button>
                            @if (SelectedCode?.Status == TaxCodeStatus.Inactive || SelectedCode?.Status == TaxCodeStatus.Archived)
                            {
                                <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4"
                                        @onclick="() => ConfirmDelete(SelectedCode!.TaxCodeId)"
                                        data-bs-dismiss="modal">
                                    <i class="ti ti-trash me-1"></i>Yes, Delete
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-secondary" disabled>Cannot Delete</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ Lock Modal ═══ -->
    @if (showLockModal)
    {
        <div class="modal fade show d-block" style="background:rgba(0,0,0,.45);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-warning">
                            <i class="ti ti-lock me-2"></i>Lock Tax Code
                        </h5>
                        <button type="button" class="btn-close" style="position: relative;
        width: 9px;
        height: 9px;
        right: 26px;"
                                @onclick="() => { showLockModal = false; showLockError = false; lockReason = string.Empty; }"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-2">
                            Locking <strong>@actionCode?.Code</strong> — @actionCode?.TaxName
                        </p>
                        <div class="alert alert-warning py-2 mb-3" style="font-size:13px;">
                            <i class="ti ti-alert-triangle me-1"></i>
                            Once locked, structural fields cannot be edited. Only rate versions may change.
                        </div>
                        <label class="form-label">Lock Reason <span class="text-danger">*</span></label>
                        <textarea class="form-control @(showLockError ? "is-invalid" : "")"
                                  rows="3" @bind="lockReason"
                                  placeholder="e.g. Used in posted transactions – locked for audit integrity"></textarea>
                        @if (showLockError)
                        {
                            <div class="text-danger small mt-1">Lock reason is required.</div>
                        }
                    </div>
                    <div class="modal-footer gap-3">
                        <button class="btn btn-outline-secondary"
                                @onclick="() => { showLockModal = false; showLockError = false; lockReason = string.Empty; }">
                            <i class="ti ti-x"></i> Cancel
                        </button>
                        <button class="btn btn-warning" @onclick="ConfirmLock">
                            <i class="ti ti-lock me-1"></i>Confirm Lock
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <style>
            .modal .btn-close::before {
                background: white
            }
    </style>

</div>
