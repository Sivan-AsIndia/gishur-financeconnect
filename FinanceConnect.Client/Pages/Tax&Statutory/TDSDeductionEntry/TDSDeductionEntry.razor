@page "/tds-deduction-entries"
@inject IJSRuntime JS
@using static FinanceConnect.Client.ViewModels.TDSDeductionEntryViewModel

<style>
    @@media(max-width:635px) { .responsivefilter { flex-wrap: wrap; } }
    .modal .btn-close::before{
        background:white
    }
    .tds-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        /* border-radius: 20px; */
        font-size: 11px;
        font-weight: 600;
        /* padding: 2px 10px; */
    }
    .tds-pill.draft1     { background: #ffc3109c; color: #4a3000; }
    .tds-pill.posted1   { background: #cfe2ff;   color: #084298; }
    .tds-pill.partial1   { background: #fff3cd;   color: #664d03; }
    .tds-pill.settled1   { background: #d1e7dd;   color: #0a3622; }
    .tds-pill.reversed1 { background: #f8d7da;   color: #842029; }
    .tds-pill.cancelled1 { background: #e2e3e5;   color: #41464b; }

        .tds-pill.draft     { background: #4a3000; }
    .tds-pill.posted    {  background: #084298; }
    .tds-pill.partial   {  background: #664d03; }
    .tds-pill.settled   {  background: #0a3622; }
    .tds-pill.reversed  { background: #842029; }
    .tds-pill.cancelled {    background: #41464b; }

    .pan-missing-badge {
        background: #f8d7da;
        color: #842029;
        border-radius: 4px;
        padding: 2px 7px;
        font-size: 10px;
        font-weight: 700;
    }
    .section-badge {
        background: #e0e7ff;
        color: #3730a3;
        /* border-radius: 4px; */
        /* padding: 2px 8px; */
        font-size: 11px;
        font-weight: 700;
    }
    .amount-cell { font-variant-numeric: tabular-nums; font-size: 13px; }
    .outstanding-chip {
        background: #fff3cd;
        color: #664d03;
        border-radius: 4px;
        padding: 1px 7px;
        font-size: 11px;
        font-weight: 600;
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
    }

    <div class="content List-view">

        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">TDS Deduction Entries</h4>
                    <h6>Withholding event ledger — all deduction records</h6>
                </div>
            </div>
            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>
        </div>

        <div class="card">

            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm"
                               placeholder="Search vendor, deduction no, section..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>
                <div style="display:flex; gap:8px;" class="responsivefilter">
                    <select class="form-select form-select-sm" style="min-width:150px"
                            @bind="SelectedStatus" @bind:event="oninput" @onchange="OnFilterChanged">
                        <option value="">All Status</option>
                        <option value="1">Draft</option>
                        <option value="2">Posted</option>
                        <option value="3">Partially Settled</option>
                        <option value="4">Settled</option>
                        <option value="5">Reversed</option>
                        <option value="6">Cancelled</option>
                    </select>
                    <select class="form-select form-select-sm" style="min-width:150px"
                            @bind="SelectedSection" @bind:event="oninput" @onchange="OnFilterChanged">
                        <option value="">All Sections</option>
                        <option value="194C">194C – Contractor</option>
                        <option value="194J">194J – Professional</option>
                        <option value="194I">194I – Rent</option>
                        <option value="194H">194H – Commission</option>
                        <option value="194A">194A – Interest</option>
                    </select>
                    <select class="form-select form-select-sm" style="min-width:160px"
                            @bind="SelectedSettlement" @bind:event="oninput" @onchange="OnFilterChanged">
                        <option value="">All Settlement</option>
                        <option value="1">Not Settled</option>
                        <option value="2">Partially Settled</option>
                        <option value="3">Fully Settled</option>
                    </select>
                </div>
            </div>

            <div class="card-body p-0">
                <div>
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xxl-none" style="width:40px"></th>
                                <th>No</th>
                                @* <th class="d-none d-md-table-cell">Date</th> *@
                                <th class="d-none d-md-table-cell">Vendor</th>
                                <th class="d-none d-lg-table-cell">Source</th>
                                <th class="d-none d-lg-table-cell text-end">Base Amt</th>
                                <th class="d-none d-lg-table-cell text-center">Outstanding</th>
                                <th class="d-none d-xxl-table-cell">Settlement</th>
                                <th class="d-none d-xxl-table-cell">Status</th>
                                <th class="no-sort">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedVersions.Any())
                            {
                                @foreach (var entry in PagedVersions)
                                {
                                    <tr @key="entry.TDSDeductionEntryId">

                                        <!-- Mobile expand -->
                                        <td class="d-xxl-none text-center" style="padding:0; padding-left:15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenViewModal(entry)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <!-- Deduction No -->
                                        <td>
                                            <span class="fw-medium"
                                                  data-bs-toggle="tooltip"
                                                  data-bs-placement="top"
                                                  title="@entry.DeductionNumber Details">
                                                <span class="PopupIcon me-1">⧉</span>
                                                <a href="/tds-deduction-entries/@entry.TDSDeductionEntryId/view"
                                                   class="text-decoration-none link-View">
                                                    @entry.DeductionNumber
                                                </a>
                                            </span>
                                            @if (entry.IsSystemReversal)
                                            {
                                                <span class="badge bg-secondary-transparent text-secondary ms-1" style="font-size:9px;">REV</span>
                                            }
                                            <div class="text-muted" style="font-size:0.72rem; margin-top:2px;">
                                                @entry.DeductionDate.ToString("dd-MMM-yyyy")
                                            </div>
                                        </td>

                                        <!-- Date -->
                                        @* <td class="d-none d-md-table-cell" style="font-size:12px;">
                                            @entry.DeductionDate.ToString("dd MMM yyyy")
                                        </td> *@

                                        <!-- Vendor -->
                                        <td class="d-none d-md-table-cell">
                                            <div class="fw-medium">
                                                @entry.VendorNameSnapshot
                                            </div>
                                            <div class="text-muted" style="font-size:11px;">
                                                @if (string.IsNullOrWhiteSpace(entry.VendorPANSnapshot))
                                                {
                                                    <span class="pan-missing-badge ms-1">No PAN</span>
                                                }
                                            </div>
                                        </td>

                                        <!-- Source -->
                                        <td class="d-none d-lg-table-cell" style="font-size:11px;">
                                          <span class="badge badge-sm mb-1 @GetBadgeClass(entry.SourceDocumentType)">
                                           @entry.SourceDocumentType
                                            </span>
                                            <div class="text-muted" style="font-size:10px;">@entry.SourceDocumentNumberSnapshot</div>
                                        </td>

                                        <!-- Base Amt -->
                                        <td class="d-none d-lg-table-cell text-end amount-cell"
                                            style="color:#002fdc;">
                                            ₹@entry.DeductionBaseAmount.ToString("N2")
                                        </td>

                                        <!-- Outstanding -->
                                        <td class="d-none d-lg-table-cell text-center amount-cell">
                                            @if (entry.OutstandingAmount > 0)
                                            {
                                                <span class="outstanding-chip">₹@entry.OutstandingAmount.ToString("N0")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>

                                        <!-- Settlement -->
                                        <td class="d-none d-xxl-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge @GetSettlementStatusClass(entry.SettlementStatus)" style="font-size:12px;">
                                                    @TDSDeductionEntry.GetSettlementStatusLabel(entry.SettlementStatus)
                                                </span>
                                            </div>
                                        </td>

                                        <!-- Status -->
                                        <td class="d-none d-xxl-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot tds-pill @TDSDeductionEntry.GetStatusPillClass(entry.Status)"></div>
                                                <span style="font-size:12px;">
                                                    @TDSDeductionEntry.GetStatusLabel(entry.Status)
                                                </span>
                                            </div>
                                        </td>

                                        <!-- Actions -->
                                        <td class="action-table-data">
                                            <div class="edit-delete-action">
                                                <a class="me-2 view-icon p-1" title="View Details"
                                                  href="/tds-deduction-entries/@entry.TDSDeductionEntryId/view">
                                                    <i data-feather="eye"></i>
                                                </a>

                                                @if (entry.Status == DeductionStatus.Posted || entry.Status == DeductionStatus.PartiallySettled)
                                                {
                                                    <a href="javascript:void(0);" class="me-2 icon-reverse p-1"
                                                       title="Reverse" @onclick="() => OpenReverseModal(entry)">
                                                        <i class="ti ti-rotate-2"></i>
                                                    </a>
                                                }

                                                @if (entry.Status == DeductionStatus.PartiallySettled || entry.Status == DeductionStatus.Posted)
                                                {
                                                    <a href="javascript:void(0);" class="me-2 icon-approve p-1"
                                                       title="Mark Reconciled"
                                                       @onclick="() => OnMarkReconciled(entry.TDSDeductionEntryId)">
                                                        <i class="ti ti-check"></i>
                                                    </a>
                                                }

                                                @if (entry.Status == DeductionStatus.Draft)
                                                {
                                                    <a href="javascript:void(0);" class="me-2 p-1 delete-icon"
                                                       title="Cancel" @onclick="() => DeletePopupOpen(entry)">
                                                        <i class="ti ti-trash"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center py-4">
                                        <div class="text-muted">
                                            <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                            No deduction entries found.
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (PagedVersions.Any())
                {
                    <div class="d-flex justify-content-between align-items-center p-3">
                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="#" @onclick="PreviousPage" @onclick:preventDefault>
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @foreach (var pageNumber in VisiblePages)
                                {
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="#" @onclick="NextPage" @onclick:preventDefault>
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>

    </div>
}

<!-- ═══ Reverse Modal ════════════════════════════════════════════ -->
@if (showReverseModal && actionEntry != null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.4);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="ti ti-rotate-2 me-2 text-warning"></i>Reverse Deduction</h5>
                    <button type="button" class="btn-close" @onclick="() => showReverseModal = false" style="position: relative;
    width: 6px;
    height: 6px;
    right: 31px;"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning py-2" style="font-size:13px;">
                        <strong>@actionEntry.DeductionNumber</strong> — ₹@actionEntry.DeductionAmount.ToString("N0")
                        deducted from <strong>@actionEntry.VendorNameSnapshot</strong>
                        under Section <strong>@actionEntry.SectionCodeSnapshot</strong>
                    </div>
                    <label class="form-label">Reversal Reason <span class="text-danger">*</span></label>
                    <textarea class="form-control @(showReverseError ? "is-invalid" : "")"
                              rows="3" placeholder="Enter reason for reversal..."
                              @bind="reverseReason"></textarea>
                    @if (showReverseError)
                    {
                        <div class="text-danger small mt-1">Reversal reason is required.</div>
                    }
                </div>
                <div class="modal-footer gap-2">
                    <button class="btn btn-outline-secondary" @onclick="() => showReverseModal = false"><i class="ti ti-x"></i> Cancel</button>
                    <button class="btn btn-warning" @onclick="ConfirmReverse">
                        <i class="ti ti-rotate-2 me-1"></i> Confirm Reverse
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ═══ Cancel Confirm Modal ════════════════════════════════════ -->
@if (showDeleteModal && SelectedEntry != null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.4);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger"><i class="ti ti-trash me-2"></i>Cancel Entry</h5>
                    <button class="btn-close" @onclick="() => showDeleteModal = false"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <p>Cancel deduction entry <strong>@SelectedEntry.DeductionNumber</strong>?</p>
                    <p class="text-muted small">This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => showDeleteModal = false">No</button>
                    <button class="btn btn-danger btn-sm" @onclick="() => ConfirmCancel(SelectedEntry.TDSDeductionEntryId)">Yes, Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ═══ Mobile Row Detail Modal ═════════════════════════════════ -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Deduction Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute; transform:none"></button>
            </div>
            @if (SelectedEntry != null)
            {
                <div class="modal-body">
                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Date:</strong>
                        <div>@SelectedEntry.DeductionDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Vendor:</strong>
                        <div>@SelectedEntry.VendorNameSnapshot</div>
                    </div>
                    <div class="mb-2 d-flex gap-3 d-lg-none">
                        <strong>Source:</strong>
                        <div>@SelectedEntry.SourceDocumentType — @SelectedEntry.SourceDocumentNumberSnapshot</div>
                    </div>
                    <div class="mb-2 d-flex gap-3 d-lg-none">
                        <strong>Base Amt:</strong>
                        <div>₹@SelectedEntry.DeductionBaseAmount.ToString("N0")</div>
                    </div>
                    <div class="mb-2 d-flex gap-3 d-lg-none">
                        <strong>TDS Amt:</strong>
                        <div class="fw-semibold">₹@SelectedEntry.DeductionAmount.ToString("N2")</div>
                    </div>
                    <div class="mb-2 d-flex gap-3 d-lg-none">
                        <strong>Outstanding:</strong>
                        <div class="fw-semibold">₹@SelectedEntry.OutstandingAmount.ToString("N2")</div>
                    </div>
                    <div class="mb-2 d-flex gap-3 d-xxl-none">
                        <strong>Settlement:</strong>
                        <span class="badge @TDSDeductionEntry.GetSettlementStatusClass(SelectedEntry.SettlementStatus)">
                            @TDSDeductionEntry.GetSettlementStatusLabel(SelectedEntry.SettlementStatus)
                        </span>
                    </div>
                    <div class="mb-2 d-flex gap-3 d-xxl-none">
                        <strong>Status:</strong>
                        <span class="badge tds-pill @TDSDeductionEntry.GetStatusPillResClass(SelectedEntry.Status)">
                            @TDSDeductionEntry.GetStatusLabel(SelectedEntry.Status)
                        </span>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Section:</strong>
                        <span class="badge section-badge">@SelectedEntry.SectionCodeSnapshot</span>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Rate:</strong>
                        <div>@SelectedEntry.RatePercentApplied%</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
