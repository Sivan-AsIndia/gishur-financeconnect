@page "/gst-return-runs"
@namespace FinanceConnect.Client.Pages.Tax___Statutory.GSTReturnRun

@inject GSTReturnRunService RunService
@inject NavigationManager Nav
@inject ToastService ToastService
@inject IJSRuntime JS

<style>
    @@media(max-width:635px) {
        .responsivefilter {
            flex-wrap: wrap;
        }
    }
</style>
@if (!isInitialized)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
    }
    <div class="content List-view">
        <div class="page-header">
            <div class="add-item d-flex"><div class="page-title"><h4 class="fw-bold">GST Return Run</h4><h6>Period-based GST return compilation &amp; filing</h6></div></div>
            <ul class="table-top-head me-2"><li><a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync"><i class="ti ti-refresh"></i></a></li></ul>
            <div class="page-btn"><a href="/gst-return-runs/create" class="btn btn-primary"><i class="ti ti-circle-plus me-1"></i>Create</a></div>
        </div>
        <div class="card">
            <div class="card-header d-flex align-items-end justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search run no, period..." @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>
                <div style="display:flex;gap:10px;align-items:end;" class="responsivefilter">
                    <select class="form-select form-select-sm" style="min-width:140px" @bind="SelectedStatus"><option value="">All Status</option>@foreach(var s in DistinctStatuses){
                    <option value="@s">@s</option>
                }
</select>
                <select class="form-select form-select-sm" style="min-width:130px" @bind="SelectedFiling"><option value="">All Filing</option>@foreach(var f in DistinctFilings){
                <option value="@f">@f</option>
                                }
</select>
            </div>
        </div>
        <div class="card-body p-0">
            <div>
                <table class="table align-middle w-100 table-fixed">
                    <thead class="thead-light">
                        <tr>
                            <th class="d-xl-none" style="width:40px"></th>
                            <th style="width: 219px;">Run No</th>
                            <th class="d-none d-md-table-cell text-center">Period</th>
                            <th class="d-none d-md-table-cell text-center">Status</th>
                            <th class="d-none d-xl-table-cell text-center">Included</th>
                            <th class="d-none d-xl-table-cell text-center">Exceptions</th>
                            <th class="d-none d-xxl-table-cell text-end">Net Liability</th>
                            <th class="d-none d-md-table-cell text-center">Filing</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (PagedItems.Any())
                        {
                            @foreach (var r in PagedItems)
                            {
                                <tr>
                                    <td class="d-xl-none text-center" style="padding:0;padding-left:15px;"><a href="javascript:void(0);" class="TablePlus" data-bs-toggle="modal" data-bs-target="#rowModal" @onclick="() => Select(r)"><i class="ti ti-plus"></i></a></td>
                                    <td class="fw-medium">
                                        <span>
                                            <span class="PopupIcon me-1">⧉</span>
                                            <a class="text-decoration-none link-View"
                                               data-bs-toggle="offcanvas"
                                               data-bs-target="#viewGSTReturnRunOffcanvas"
                                               @onclick="() => OpenViewOffcanvas(r)"
                                               title="@r.ReturnRunNumber details">@r.ReturnRunNumber</a>
                                        </span>
                                        <br /><small class="text-muted">@(r.GenerationDate?.ToString("dd-MMM-yy") ?? "Not generated")</small>
                                    </td>
                                    <td class="d-none d-md-table-cell text-center">@r.ReturnPeriodKey</td>
                                    <td class="d-none d-md-table-cell text-center">
                                        <span class="badge @GetStatusBadge(r.ReturnRunStatus)" data-bs-toggle="tooltip" title="@r.ReturnRunStatus"><i class="@GetStatusIcon(r.ReturnRunStatus)"></i></span>@if(r.IsLocked){
                                        <i class="ti ti-lock text-warning ms-1" title="Locked"></i>
                                    }
                                </td>
                                <td class="d-none d-xl-table-cell text-center">@r.IncludedTransactionCount.ToString("N0")</td>
                                <td class="d-none d-xl-table-cell text-center">@if(r.HasBlockingExceptions){
                                <span class="text-danger fw-medium">@r.BlockingExceptionCount</span>
                            }
                            else if (r.ExceptionCount > 0)
                            {

                                <span class="text-warning">@r.ExceptionCount</span>
                            }
                            else
                            {

                                <span>0</span>
                            }
</td>
                            <td class="d-none d-xxl-table-cell text-end fw-medium">@r.NetTaxLiabilityTotal.ToString("N2")</td>
                            <td class="d-none d-md-table-cell text-center"><span class="badge @GetFilingBadge(r.FilingStatus)" data-bs-toggle="tooltip" title="@r.FilingStatus"><i class="@GetFilingIcon(r.FilingStatus)"></i></span></td>
                            <td class="action-table-data">
                                <div class="edit-delete-action">
                                    <!-- View detail offcanvas -->
                                    <a class="me-2 view-icon p-1" title="View Detail"
                                       data-bs-toggle="offcanvas"
                                       data-bs-target="#viewGSTReturnRunOffcanvas"
                                       @onclick="() => OpenViewOffcanvas(r)">
                                        <i data-feather="eye"></i>
                                    </a>
                                    @if (r.ReturnRunStatus == "Draft" || r.ReturnRunStatus == "Reopened")
                                    {
                                        <a class="me-2 edit-icon p-1" href="/gst-return-runs/@r.Id" title="Edit"><i data-feather="edit"></i></a>
                                        <a class="me-2 p-1 action-icon Reissue" href="javascript:void(0);" title="Generate" data-bs-toggle="modal" data-bs-target="#actModal" @onclick='() => OpenAction(r, "Generate")'><i class="ti ti-player-play"></i></a>
}
                                    @if (r.ReturnRunStatus == "Generated")
                                    {
                                        <a class="me-2 p-1 action-icon Reissue" href="javascript:void(0);" title="Review" data-bs-toggle="modal" data-bs-target="#actModal" @onclick='() => OpenAction(r, "Review")'><i class="ti ti-search"></i></a>
                                    }
                                    @if (r.ReturnRunStatus == "Reviewed")
                                    {
                                        <a class="me-2 p-1 action-icon Reissue" href="javascript:void(0);" title="Approve" data-bs-toggle="modal" data-bs-target="#actModal" @onclick='() => OpenAction(r, "Approve")'><i class="ti ti-check"></i></a>
                                    }
                                    @if (r.ReturnRunStatus == "Approved")
                                    {
                                        <a class="me-2 p-1 action-icon Reissue" href="javascript:void(0);" title="Finalize" data-bs-toggle="modal" data-bs-target="#actModal" @onclick='() => OpenAction(r, "Finalize")'><i class="ti ti-lock"></i></a>
                                    }
                                    @if (r.ReturnRunStatus == "Finalized")
                                    {
                                        <a class="me-2 p-1 action-icon Reissue" href="javascript:void(0);" title="Mark Filed" data-bs-toggle="modal" data-bs-target="#actModal" @onclick='() => OpenAction(r, "MarkFiled")'><i class="ti ti-file-check"></i></a>
                                        <a class="me-2 p-1 action-icon Bounce" href="javascript:void(0);" title="Reopen" data-bs-toggle="modal" data-bs-target="#actModal" @onclick='() => OpenAction(r, "Reopen")'><i class="ti ti-rotate"></i></a>
}
                                    @if (r.ReturnRunStatus == "Filed")
                                    {
                                        <a class="me-2 p-1 action-icon Reissue" href="javascript:void(0);" title="Close" data-bs-toggle="modal" data-bs-target="#actModal" @onclick='() => OpenAction(r, "Close")'><i class="ti ti-lock"></i></a>
                                    }
                                    @if (r.ReturnRunStatus == "Draft")
                                    {
                                        <a class="p-1 delete-icon" href="javascript:void(0);" title="Delete" data-bs-toggle="modal" data-bs-target="#actModal" @onclick='() => OpenAction(r, "Delete")'><i data-feather="trash-2"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                                                }
                                                }
                                                else
                        {
                            <tr><td colspan="@VisibleColumnCount" class="text-center py-4"><div class="text-muted"><i class="ti ti-file-off fs-1"></i><p class="mt-2">No return runs found</p></div></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4">
            <div class="d-flex align-items-center"><span class="me-2">Rows per page:</span><select class="form-select form-select-sm" style="width:auto" @onchange="OnPageSizeChange"><option value="5">5</option><option value="10" selected="@(PageSize == 10)">10</option><option value="25">25</option></select><span class="ms-3 text-muted">Entries</span></div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")"><a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(CurrentPage - 1)"><i class="ti ti-chevron-left"></i></a></li>
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        var p = i;
                        <li class="page-item @(CurrentPage == p ? "active" : "")"><a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(p)">@p</a></li>
                    }
                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")"><a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(CurrentPage + 1)"><i class="ti ti-chevron-right"></i></a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>
}

<!-- Action Modal -->
<div class="modal fade" id="actModal" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 @ActionBg mb-2"><i class="@ActionIcon fs-24 @ActionTxt"></i></span>
                    <h4 class="fs-20 fw-bold mb-2 mt-1">@ActionTitle</h4>
                    <p class="text-gray-6 mb-0 fs-16">@ActionMsg <strong>@Selected?.ReturnRunNumber</strong>?</p>
                    @if (NeedReason)
                    {
                        <div class="mt-3 text-start"><label class="form-label">Reason <span class="text-danger">*</span></label><textarea class="form-control" rows="3" @bind="ActionReason" placeholder="Enter reason..."></textarea></div>
                    }
                    @if (ActionName == "Delete")
                    {
                        <div class="alert alert-danger mt-3 text-start small"><i class="ti ti-alert-triangle me-2"></i>This action cannot be undone.</div>
                    }
                    @if (ActionName == "Finalize")
                    {
                        <div class="alert alert-warning mt-3 text-start small"><i class="ti ti-alert-triangle me-2"></i>Finalization will lock the dataset. Cannot finalize with blocking exceptions.</div>
                    }
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button type="button" class="btn @ActionBtn p-2 px-4" @onclick="ConfirmAction" data-bs-dismiss="modal"><i class="ti ti-check me-1"></i>Confirm</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Row Details Modal (Mobile) -->
<div class="modal fade list-Popup" id="rowModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Return Run Details</h5><button type="button" class="btn-close" data-bs-dismiss="modal" style="padding:0;right:22px;position:absolute;transform:none;"></button></div>
            <div class="modal-body">
                @if (Selected != null)
                {
                    <div class="mb-2 d-flex gap-3"><strong>Run No:</strong><div>@Selected.ReturnRunNumber</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Period:</strong><div>@Selected.ReturnPeriodKey</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Type:</strong><div>@Selected.ReturnType</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Included:</strong><div>@Selected.IncludedTransactionCount</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Excluded:</strong><div>@Selected.ExcludedTransactionCount</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Exceptions:</strong><div>@Selected.ExceptionCount (@Selected.BlockingExceptionCount blocking)</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Net Liability:</strong><div>@Selected.NetTaxLiabilityTotal.ToString("N2")</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Filing:</strong><div><span class="badge @GetFilingBadge(Selected.FilingStatus)">@Selected.FilingStatus</span></div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Status:</strong><div><span class="badge @GetStatusBadge(Selected.ReturnRunStatus)">@Selected.ReturnRunStatus</span></div></div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ═══ View Offcanvas ════════════════════════════════════════════ -->
<div class="offcanvas offcanvas-end offcanvas-view"
     tabindex="-1"
     id="viewGSTReturnRunOffcanvas"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    @if (SelectedView != null)
    {
        <!-- Offcanvas Header -->
        <div class="offcanvas-header">
            <div class="oc-avatar">
                GST
            </div>
            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@SelectedView.ReturnRunNumber</h5>
                    <span class="badge @GetStatusBadge(SelectedView.ReturnRunStatus)">
                        @SelectedView.ReturnRunStatus
                    </span>
                </div>
                <p class="oc-header-sub">
                    <i class="ti ti-calendar"></i>
                    @SelectedView.ReturnPeriodKey &nbsp;·&nbsp;
                    @SelectedView.PeriodStartDate.ToString("dd MMM") – @SelectedView.PeriodEndDate.ToString("dd MMM yyyy")
                </p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>

        <!-- Summary Cards -->
        <div class="offcanvas-body">
            <div class="oc-summary-row">
                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value">₹@SelectedView.NetTaxLiabilityTotal.ToString("N0")</div>
                    <div class="oc-summary-label">Net Liability</div>
                </div>
                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value">@SelectedView.IncludedTransactionCount</div>
                    <div class="oc-summary-label">Included</div>
                </div>
                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value">@SelectedView.ExceptionCount</div>
                    <div class="oc-summary-label">Exceptions</div>
                </div>
            </div>

            <!-- Core Identity -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-id"></i>
                    <h6 class="oc-card-title">Core Identity</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-grid">
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Run Number</div>
                            <div class="oc-field-value">@SelectedView.ReturnRunNumber</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Return Type</div>
                            <div class="oc-field-value">@SelectedView.ReturnType</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Status</div>
                            <div class="oc-field-value">
                                <span class="badge @GetStatusBadge(SelectedView.ReturnRunStatus)">
                                    @SelectedView.ReturnRunStatus
                                </span>
                            </div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Period</div>
                            <div class="oc-field-value">@SelectedView.ReturnPeriodKey</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Company & Scope -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-building"></i>
                    <h6 class="oc-card-title">Company &amp; Scope</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">Company</span>
                            <span class="oc-list-value fw-medium">@(SelectedView.CompanyName ?? "—")</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Branch</span>
                            <span class="oc-list-value">@(SelectedView.BranchName ?? "All Branches")</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Selection Mode</span>
                            <span class="oc-list-value">@SelectedView.SelectionMode</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Scope</span>
                            <span class="oc-list-value">
                                <div class="d-flex flex-wrap gap-1">
                                    @if (SelectedView.IncludeOutwardSupplies) { <span class="badge bg-success-transparent badge-sm">Outward</span> }
                                    @if (SelectedView.IncludeInwardSupplies) { <span class="badge bg-info-transparent text-dark badge-sm">Inward</span> }
                                    @if (SelectedView.IncludeRCMTransactions) { <span class="badge bg-warning-transparent text-dark badge-sm">RCM</span> }
                                    @if (SelectedView.IncludeCreditDebitNotes) { <span class="badge bg-purple-transparent badge-sm">CN/DN</span> }
                                    @if (SelectedView.IncludeExemptNilNonGST) { <span class="badge bg-secondary-transparent badge-sm">Exempt/Nil</span> }
                                </div>
                            </span>
                        </div>
                        @if (SelectedView.IsLocked)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Locked</span>
                                <span class="oc-list-value">
                                    <span class="oc-dot-badge db-green"><span class="dot"></span> Yes</span>
                                    @if (!string.IsNullOrWhiteSpace(SelectedView.LockReason))
                                    {
                                        <span class="text-muted ms-1">(@SelectedView.LockReason)</span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Metrics -->
            @if (SelectedView.ReturnRunStatus != "Draft" && SelectedView.ReturnRunStatus != "Cancelled")
            {
                <div class="oc-card">
                    <div class="oc-card-header hdr-green">
                        <i class="ti ti-chart-bar"></i>
                        <h6 class="oc-card-title">Generation Metrics</h6>
                    </div>
                    <div class="oc-card-body">
                        <div class="oc-grid">
                            <div class="oc-grid-item">
                                <div class="oc-field-label">Eligible</div>
                                <div class="oc-field-value">@SelectedView.EligibleTransactionCount.ToString("N0")</div>
                            </div>
                            <div class="oc-grid-item">
                                <div class="oc-field-label">Included</div>
                                <div class="oc-field-value text-success fw-semibold">@SelectedView.IncludedTransactionCount.ToString("N0")</div>
                            </div>
                            <div class="oc-grid-item">
                                <div class="oc-field-label">Excluded</div>
                                <div class="oc-field-value">@SelectedView.ExcludedTransactionCount</div>
                            </div>
                            <div class="oc-grid-item">
                                <div class="oc-field-label">Lines</div>
                                <div class="oc-field-value">@SelectedView.IncludedLineCount.ToString("N0")</div>
                            </div>
                        </div>
                        <div class="oc-grid mt-2">
                            <div class="oc-grid-item">
                                <div class="oc-field-label">Warnings</div>
                                <div class="oc-field-value text-warning">@SelectedView.WarningExceptionCount</div>
                            </div>
                            <div class="oc-grid-item">
                                <div class="oc-field-label">Blocking</div>
                                <div class="oc-field-value text-danger fw-semibold">@SelectedView.BlockingExceptionCount</div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Summary Totals -->
            @if (SelectedView.OutwardTaxableValueTotal > 0 || SelectedView.InputEligibleITCTotal > 0)
            {
                <div class="oc-card">
                    <div class="oc-card-header hdr-orange">
                        <i class="ti ti-calculator"></i>
                        <h6 class="oc-card-title">Return Summary</h6>
                    </div>
                    <div class="oc-card-body">
                        <div class="oc-list">
                            <div class="oc-list-row">
                                <span class="oc-list-label">Outward Taxable</span>
                                <span class="oc-list-value fw-semibold">₹@SelectedView.OutwardTaxableValueTotal.ToString("N2")</span>
                            </div>
                            <div class="oc-list-row">
                                <span class="oc-list-label">CGST / SGST / IGST</span>
                                <span class="oc-list-value" style="font-size:0.8rem;">
                                    ₹@SelectedView.OutwardCGSTTotal.ToString("N2") / ₹@SelectedView.OutwardSGSTTotal.ToString("N2") / ₹@SelectedView.OutwardIGSTTotal.ToString("N2")
                                </span>
                            </div>
                            <div class="oc-list-row">
                                <span class="oc-list-label">Eligible ITC</span>
                                <span class="oc-list-value text-success fw-semibold">₹@SelectedView.InputEligibleITCTotal.ToString("N2")</span>
                            </div>
                            <div class="oc-list-row">
                                <span class="oc-list-label">Net Liability</span>
                                <span class="oc-list-value fw-bold text-danger">₹@SelectedView.NetTaxLiabilityTotal.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Filing & Export -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-file-check"></i>
                    <h6 class="oc-card-title">Filing &amp; Export</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">Filing Status</span>
                            <span class="oc-list-value">
                                <span class="badge @GetFilingBadge(SelectedView.FilingStatus)">@SelectedView.FilingStatus</span>
                            </span>
                        </div>
                        @if (SelectedView.FiledDate.HasValue)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Filed Date</span>
                                <span class="oc-list-value">@SelectedView.FiledDate.Value.ToString("dd MMM yyyy")</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(SelectedView.FiledBy))
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Filed By</span>
                                <span class="oc-list-value">@SelectedView.FiledBy</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(SelectedView.GovernmentAcknowledgementNumber))
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Ack. Number</span>
                                <span class="oc-list-value font-monospace" style="font-size:0.78rem;">@SelectedView.GovernmentAcknowledgementNumber</span>
                            </div>
                        }
                        <div class="oc-list-row">
                            <span class="oc-list-label">Export Generated</span>
                            <span class="oc-list-value">
                                @if (SelectedView.IsExportGenerated)
                                {
                                    <span class="oc-dot-badge db-green"><span class="dot"></span> Yes</span>
                                }
                                else
                                {
                                    <span class="oc-dot-badge db-red"><span class="dot"></span> No</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Governance -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-shield-check"></i>
                    <h6 class="oc-card-title">Governance</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        @if (SelectedView.ApprovedOn.HasValue)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Approved</span>
                                <span class="oc-list-value">@SelectedView.ApprovedOn.Value.ToString("dd MMM yyyy") @(!string.IsNullOrWhiteSpace(SelectedView.ApprovedBy) ? $"by {SelectedView.ApprovedBy}" : "")</span>
                            </div>
                        }
                        @if (SelectedView.FinalizedOn.HasValue)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Finalized</span>
                                <span class="oc-list-value">@SelectedView.FinalizedOn.Value.ToString("dd MMM yyyy") @(!string.IsNullOrWhiteSpace(SelectedView.FinalizedBy) ? $"by {SelectedView.FinalizedBy}" : "")</span>
                            </div>
                        }
                        @if (SelectedView.ReopenedOn.HasValue)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Reopened</span>
                                <span class="oc-list-value text-warning">@SelectedView.ReopenedOn.Value.ToString("dd MMM yyyy") @(!string.IsNullOrWhiteSpace(SelectedView.ReopenedBy) ? $"by {SelectedView.ReopenedBy}" : "")</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(SelectedView.ReopenReason))
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Reopen Reason</span>
                                <span class="oc-list-value text-warning">@SelectedView.ReopenReason</span>
                            </div>
                        }
                        <div class="oc-list-row">
                            <span class="oc-list-label">Created</span>
                            <span class="oc-list-value">@SelectedView.CreatedAt.ToString("dd MMM yyyy") @(!string.IsNullOrWhiteSpace(SelectedView.CreatedBy) ? $"by {SelectedView.CreatedBy}" : "")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigate to Full Details -->
            <div class="oc-card hover-shadow cursor-pointer"
                 data-bs-dismiss="offcanvas"
                 @onclick="() => NavigateToDetail()">
                <div class="d-flex align-items-center justify-content-between p-2">
                    <div class="d-flex align-items-center">
                        <div class="me-3 text-primary">
                            <i class="ti ti-external-link fs-28"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">Full Details Page</div>
                            <div class="text-muted small">
                                View complete return run with all summary totals
                            </div>
                        </div>
                    </div>
                    <i class="ti ti-chevron-right"></i>
                </div>
            </div>

        </div>
    }
</div>
