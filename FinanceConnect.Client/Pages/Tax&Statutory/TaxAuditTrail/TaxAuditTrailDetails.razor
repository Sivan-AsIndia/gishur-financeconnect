@page "/tax-audit-trail/{Id:guid}"
@namespace FinanceConnect.Client.Pages.Tax___Statutory.TaxAuditTrail
@using FinanceConnect.Client.ViewModels

<PageTitle>Tax Audit Event Details - FinanceConnect</PageTitle>

@if (!isInitialized) { <div class="page-loading-overlay"><div class="whirly-loader"></div></div> }
else if (A == null) { <div class="content"><div class="alert alert-warning"><i class="ti ti-alert-triangle me-2"></i>Audit event not found. <a href="/tax-audit-trail" class="btn btn-secondary ms-2"><i class="ti ti-arrow-left me-1"></i>Back to List</a></div></div> }
else
{
<div class="content">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h4 class="fw-bold mb-1">Tax Audit Event Details</h4><p class="text-muted mb-0 small">Immutable audit evidence record</p></div>
        <a href="/tax-audit-trail" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>Back</a>
    </div>

    <!-- Header Card -->
    <div class="card mb-3">
        <div class="header-card">
            <div class="header-inner">
                <div class="header-left1">
                    <div class="company-logo" style="background:linear-gradient(135deg,@(A.SecurityEventFlag?"#dc2626,#b91c1c":A.EventSeverity=="Critical"?"#dc2626,#b91c1c":A.EventSeverity=="High"?"#f59e0b,#d97706":"#3b82f6,#2563eb"));border-color:transparent;">
                        <i class="ti @(A.SecurityEventFlag?"ti-shield-x":"ti-file-search")" style="font-size:24px;color:#fff;"></i>
                    </div>
                    <div class="header-meta">
                        <h2 class="company-title" style="font-size:20px;">@(A.AuditEventNumber ?? "")</h2>
                        <div class="company-subtitle">
                            <span>@(A.CompanyName ?? "")</span>
                            <span class="dot">·</span>
                            <span>@(A.EntityType ?? "") — @(A.EntityNumberSnapshot ?? "")</span>
                            <span class="dot">·</span>
                            <span>@(A.EntityDisplayNameSnapshot ?? "")</span>
                        </div>
                        <div class="header-tags">
                            <span class="tag" style="border:1px solid @GetSeverityColor(A.EventSeverity ?? "");background:@GetSeverityBg(A.EventSeverity ?? "");color:@GetSeverityColor(A.EventSeverity ?? "");">@(A.EventSeverity ?? "")</span>
                            <span class="tag" style="border:1px solid #0081ff;background:#e9f3ff;color:#1420ff;">@(A.EventCategory ?? "")</span>
                            <span class="tag" style="border:1px solid #0ed77a;background:#e6f9f0;color:#14a85a;">@(A.EventType ?? "")</span>
                            @if(A.SecurityEventFlag){<span class="tag" style="border:1px solid #dc2626;background:#fef2f2;color:#dc2626;">Security: @(A.SecurityEventType ?? "")</span>}
                            @if(A.IsSensitiveChange){<span class="tag" style="border:1px solid #f59e0b;background:#fefce8;color:#d97706;">Sensitive Change</span>}
                        </div>
                    </div>
                </div>
                <div class="header-right">
                    <span class="status-badge @(A.ValidationStatus=="Passed"?"status-active":A.ValidationStatus=="Failed"?"status-inactive":"status-draft")">● @(A.ValidationStatus ?? "")</span>
                    <div class="created-info">@A.EventTimestamp.ToString("dd MMM yyyy HH:mm:ss") UTC</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <!-- Entity Reference -->
            <div class="card mb-3"><div class="card-body p-3">
                        <h6 class="mb-3 text-primary fw-bold" style="font-size:14px;"><i class="ti ti-link me-2" style="color:var(--primary);"></i>Entity Reference</h6>
                <div class="row g-2">
                    <div class="col-md-4"><small class="text-muted d-block">Entity Type</small><span class="badge bg-light text-dark">@(A.EntityType ?? "")</span></div>
                    <div class="col-md-4"><small class="text-muted d-block">Entity No</small><span>@(A.EntityNumberSnapshot ?? "—")</span></div>
                    <div class="col-md-4"><small class="text-muted d-block">Display Name</small><span>@(A.EntityDisplayNameSnapshot ?? "—")</span></div>
                    @if(!string.IsNullOrWhiteSpace(A.ParentEntityType)){<div class="col-md-6"><small class="text-muted d-block">Parent Entity Type</small><span class="badge bg-light text-dark">@A.ParentEntityType</span></div>}
                    @if(A.ParentEntityId.HasValue){<div class="col-md-6"><small class="text-muted d-block">Parent Entity ID</small><span class="font-monospace small">@A.ParentEntityId.Value.ToString("N").Substring(0,12)...</span></div>}
                </div>
            </div></div>

            <!-- Before / After -->
            @if(!string.IsNullOrWhiteSpace(A.ChangedFieldListJson) || !string.IsNullOrWhiteSpace(A.BeforeStateJson) || !string.IsNullOrWhiteSpace(A.AfterStateJson))
            {
                <div class="card mb-3"><div class="card-body p-3">
                    <h6 class="fw-semibold mb-3" style="font-size:14px;"><i class="ti ti-git-compare me-2" style="color:var(--primary);"></i>Before / After Snapshot</h6>
                    @if(!string.IsNullOrWhiteSpace(A.ChangedFieldListJson)){<div class="mb-2"><small class="text-muted d-block">Changed Fields</small><pre class="p-2 bg-light rounded" style="font-size:12px;max-height:100px;overflow:auto;">@(A.ChangedFieldListJson ?? "")</pre></div>}
                    <div class="row g-2">
                        @if(!string.IsNullOrWhiteSpace(A.BeforeStateJson)){<div class="col-md-6"><small class="text-muted d-block text-danger">Before</small><pre class="p-2 bg-light rounded" style="font-size:12px;max-height:200px;overflow:auto;">@(A.BeforeStateJson ?? "")</pre></div>}
                        @if(!string.IsNullOrWhiteSpace(A.AfterStateJson)){<div class="col-md-6"><small class="text-muted d-block text-success">After</small><pre class="p-2 bg-light rounded" style="font-size:12px;max-height:200px;overflow:auto;">@(A.AfterStateJson ?? "")</pre></div>}
                    </div>
                </div></div>
            }

            <!-- Reason -->
            @if(!string.IsNullOrWhiteSpace(A.ReasonText))
            {
                <div class="card mb-3"><div class="card-body p-3">
                    <h6 class="fw-semibold mb-3" style="font-size:14px;"><i class="ti ti-message me-2" style="color:var(--primary);"></i>Reason</h6>
                    @if(!string.IsNullOrWhiteSpace(A.ReasonCode)){<span class="badge bg-secondary-transparent me-2">@(A.ReasonCode ?? "")</span>}
                    <p class="mb-0" style="font-style:italic;border-left:3px solid var(--primary);padding-left:10px;">@(A.ReasonText ?? "")</p>
                </div></div>
            }

            <!-- Validation -->
            <div class="card mb-3"><div class="card-body p-3">
                        <h6 class="mb-3 text-primary fw-bold" style="font-size:14px;"><i class="ti ti-shield-check me-2" style="color:var(--primary);"></i>Validation &amp; Security</h6>
                <div class="row g-2">
                            <div class="col-md-3"><small class="text-muted d-block">Validation Status</small><span class="badge @(A.ValidationStatus == "Passed" ? "bg-success-transparent" : A.ValidationStatus == "Failed" ? "bg-danger-transparent" : "bg-warning-transparent text-dark")">@(A.ValidationStatus ?? "")</span></div>
                    @if(!string.IsNullOrWhiteSpace(A.ValidationMessage)){<div class="col-md-9"><small class="text-muted d-block">Message</small><span class="text-danger">@(A.ValidationMessage ?? "")</span></div>}
                    <div class="col-md-3"><small class="text-muted d-block">Security Event</small><span>@(A.SecurityEventFlag ? "Yes" : "No")</span></div>
                    @if(A.SecurityEventFlag && !string.IsNullOrWhiteSpace(A.SecurityEventType)){<div class="col-md-3"><small class="text-muted d-block">Security Type</small><span class="badge bg-danger-transparent">@(A.SecurityEventType ?? "")</span></div>}
                    <div class="col-md-3"><small class="text-muted d-block">Sensitive Change</small><span>@(A.IsSensitiveChange ? "Yes" : "No")</span></div>
                </div>
            </div></div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="col-lg-4">
            <div class="card mb-3"><div class="card-body p-3">
                        <h6 class="mb-3 text-primary fw-bold" style="font-size:14px;"><i class="ti ti-user me-2" style="color:var(--primary);"></i>Actor / Initiator</h6>
                <div class="mb-2"><small class="text-muted d-block">Actor Type</small><span>@(A.ActorType ?? "")</span></div>
                <div class="mb-2"><small class="text-muted d-block">Name</small><span>@(A.ActorNameSnapshot ?? "")</span></div>
                @if(!string.IsNullOrWhiteSpace(A.ActorRoleSnapshot)){<div class="mb-2"><small class="text-muted d-block">Role</small><span>@(A.ActorRoleSnapshot ?? "")</span></div>}
                @if(!string.IsNullOrWhiteSpace(A.ActorIpAddress)){<div class="mb-2"><small class="text-muted d-block">IP Address</small><span class="font-monospace">@(A.ActorIpAddress ?? "")</span></div>}
                @if(!string.IsNullOrWhiteSpace(A.ActorDeviceInfo)){<div class="mb-2"><small class="text-muted d-block">Device Info</small><span>@(A.ActorDeviceInfo ?? "")</span></div>}
                <div class="mb-2"><small class="text-muted d-block">Correlation ID</small><span class="font-monospace small">@(A.CorrelationId ?? "")</span></div>
                @if(!string.IsNullOrWhiteSpace(A.RequestId)){<div class="mb-2"><small class="text-muted d-block">Request/Trace ID</small><span class="font-monospace small">@(A.RequestId ?? "")</span></div>}
            </div></div>

            <div class="card mb-3"><div class="card-body p-3">
                        <h6 class="mb-3 text-primary fw-bold" style="font-size:14px;"><i class="ti ti-building me-2" style="color:var(--primary);"></i>Business Context</h6>
                <div class="mb-2"><small class="text-muted d-block">Company</small><span>@(A.CompanyName ?? "N/A")</span></div>
                @if(!string.IsNullOrWhiteSpace(A.TaxPeriodKey)){<div class="mb-2"><small class="text-muted d-block">Tax Period</small><span>@(A.TaxPeriodKey ?? "")</span></div>}
                <div class="mb-2"><small class="text-muted d-block">Tax Scope</small><span class="badge @GetScopeBadge(A.TaxTypeScope ?? "")">@(A.TaxTypeScope ?? "")</span></div>
                @if(!string.IsNullOrWhiteSpace(A.BranchName)){<div class="mb-2"><small class="text-muted d-block">Branch</small><span>@(A.BranchName ?? "")</span></div>}
                @if(!string.IsNullOrWhiteSpace(A.PartyNameSnapshot)){<div class="mb-2"><small class="text-muted d-block">Party</small><span>@(A.PartyNameSnapshot ?? "") @(!string.IsNullOrWhiteSpace(A.PartyType)?$"({A.PartyType})":"")</span></div>}
                @if(!string.IsNullOrWhiteSpace(A.TaxCodeSnapshot)){<div class="mb-2"><small class="text-muted d-block">Tax Code</small><span>@(A.TaxCodeSnapshot ?? "")</span></div>}
                @if(!string.IsNullOrWhiteSpace(A.SectionCodeSnapshot)){<div class="mb-2"><small class="text-muted d-block">Section Code</small><span>@(A.SectionCodeSnapshot ?? "")</span></div>}
            </div></div>

            @if(!string.IsNullOrWhiteSpace(A.SupportingDocumentReference) || !string.IsNullOrWhiteSpace(A.GovernmentReferenceNumber) || !string.IsNullOrWhiteSpace(A.ExternalSystemReference))
            {
                <div class="card mb-3"><div class="card-body p-3">
                    <h6 class="fw-semibold mb-3" style="font-size:14px;"><i class="ti ti-paperclip me-2" style="color:var(--primary);"></i>Evidence &amp; Links</h6>
                    @if(!string.IsNullOrWhiteSpace(A.SupportingDocumentReference)){<div class="mb-2"><small class="text-muted d-block">Supporting Document</small><span>@(A.SupportingDocumentReference ?? "")</span></div>}
                    @if(!string.IsNullOrWhiteSpace(A.GovernmentReferenceNumber)){<div class="mb-2"><small class="text-muted d-block">Govt Reference</small><span>@(A.GovernmentReferenceNumber ?? "")</span></div>}
                    @if(!string.IsNullOrWhiteSpace(A.ExternalSystemReference)){<div class="mb-2"><small class="text-muted d-block">External System Ref</small><span>@(A.ExternalSystemReference ?? "")</span></div>}
                    @if(!string.IsNullOrWhiteSpace(A.SourceUrlOrRoute)){<div class="mb-2"><small class="text-muted d-block">Source URL/Route</small><span class="font-monospace small">@(A.SourceUrlOrRoute ?? "")</span></div>}
                </div></div>
            }

            <div class="card mb-3"><div class="card-body p-3">
                <h6 class="fw-semibold mb-3" style="font-size:14px;"><i class="ti ti-lock me-2" style="color:var(--primary);"></i>Immutability &amp; Retention</h6>
                <div class="mb-2"><small class="text-muted d-block">Immutable</small><span>@(A.IsImmutable?"Yes":"No")</span></div>
                <div class="mb-2"><small class="text-muted d-block">Retention</small><span class="badge bg-info-transparent text-dark">@(A.RetentionCategory ?? "")</span></div>
                <div class="mb-2"><small class="text-muted d-block">Archive Status</small><span>@(A.ArchiveStatus ?? "")</span></div>
                @if(!string.IsNullOrWhiteSpace(A.HashChainReference)){<div class="mb-2"><small class="text-muted d-block">Hash Chain</small><span class="font-monospace small">@(A.HashChainReference ?? "")</span></div>}
            </div></div>

            <div class="card mb-3"><div class="card-body p-3">
                <h6 class="fw-semibold mb-3" style="font-size:14px;"><i class="ti ti-history me-2" style="color:var(--primary);"></i>System</h6>
                <div class="mb-2"><small class="text-muted d-block">Event Date</small><span>@A.EventDate.ToString("dd MMM yyyy")</span></div>
                <div class="mb-2"><small class="text-muted d-block">Created</small><span>@A.CreatedAt.ToString("dd MMM yyyy HH:mm") by @(A.CreatedBy ?? "system")</span></div>
            </div></div>
        </div>
    </div>
</div>
}
