@page "/tax-audit-trail"
@namespace FinanceConnect.Client.Pages.Tax___Statutory.TaxAuditTrail

@inject TaxAuditTrailService AuditService
@inject ToastService ToastService
@inject IJSRuntime JS
@inject NavigationManager Nav


<style>
    @@media(max-width:635px) {
        .responsivefilter {
            flex-wrap: wrap;
        }
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
    }
    <div class="content List-view">
        <div class="page-header">
            <div class="add-item d-flex"><div class="page-title"><h4 class="fw-bold">Tax Audit Trail</h4><h6>Immutable event log for all tax-related actions</h6></div></div>
            <ul class="table-top-head me-2"><li><a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync"><i class="ti ti-refresh"></i></a></li></ul>
        </div>

        <div class="card">
            <div class="card-header d-flex align-items-end justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search event no, entity, actor..." @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>
                <div style="display:flex;gap:10px;align-items:end;" class="responsivefilter">
                    <select class="form-select form-select-sm" style="min-width:145px" @bind="SelectedEntityType">
                        <option value="">All Entity Types</option>@foreach(var e in DistinctEntities){
                        <option value="@e">@e</option>
                    }
                </select>
                <select class="form-select form-select-sm" style="min-width:130px" @bind="SelectedCategory">
                    <option value="">All Categories</option>@foreach(var c in DistinctCategories){
                    <option value="@c">@c</option>
                                        }
                </select>
                <select class="form-select form-select-sm" style="min-width:115px" @bind="SelectedSeverity">
                    <option value="">All Severity</option>@foreach(var s in DistinctSeverities){
                    <option value="@s">@s</option>
                                        }
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            <div>
                <table class="table align-middle w-100 table-fixed">
                    <thead class="thead-light">
                        <tr>
                            <th class="d-xl-none" style="width:40px"></th>
                            <th style="white-space:nowrap;">Event No</th>
                            <th class="d-none d-md-table-cell">Entity</th>
                            <th class="d-none d-md-table-cell">Category</th>
                            <th class="d-none d-md-table-cell">Event</th>
                            <th class="d-none d-xl-table-cell">Severity</th>
                            <th class="d-none d-xl-table-cell">Actor</th>
                            <th style="width:80px">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (PagedItems.Any())
                        {
                            @foreach (var a in PagedItems)
                            {
                                <tr class="@(a.SecurityEventFlag ? "table-danger" : "")">
                                    <td class="d-xl-none text-center" style="padding:0;padding-left:15px;"><a href="javascript:void(0);" class="TablePlus" data-bs-toggle="modal" data-bs-target="#rowModal" @onclick="() => Select(a)"><i class="ti ti-plus"></i></a></td>
                                    <td class="fw-medium" style="white-space:nowrap;">
                                        <span>
                                            <span class="PopupIcon me-1">⧉</span>
                                            <a class="text-decoration-none link-View"
                                               data-bs-toggle="offcanvas"
                                               data-bs-target="#viewAuditTrailOffcanvas"
                                               @onclick="() => OpenViewOffcanvas(a)"
                                               title="@(a.AuditEventNumber ?? "") details">@(a.AuditEventNumber ?? "")</a>
                                        </span>
                                        <br /><small class="text-muted" style="white-space:nowrap;">@a.EventTimestamp.ToString("dd-MMM-yy HH:mm")</small>
                                    </td>
                                    <td class="d-none d-md-table-cell"><div class="fw-medium">@(a.EntityType ?? "")</div><small class="text-muted">@(a.EntityNumberSnapshot ?? "")</small></td>
                                    <td class="d-none d-md-table-cell"><span class="badge @GetCategoryBadge(a.EventCategory ?? "")">@(a.EventCategory ?? "")</span></td>
                                    <td class="d-none d-md-table-cell"><span class="badge @GetEventBadge(a.EventType ?? "")">@(a.EventType ?? "")</span></td>
                                    <td class="d-none d-xl-table-cell">
                                        <span class="badge @GetSeverityBadge(a.EventSeverity ?? "")" data-bs-toggle="tooltip" title="@(a.EventSeverity ?? "")"><i class="@GetSeverityIcon(a.EventSeverity ?? "")"></i></span>@if(a.SecurityEventFlag){
                                        <i class="ti ti-shield-x text-danger ms-1" title="Security event"></i>
                                    }
                                </td>
                                <td class="d-none d-xl-table-cell"><small>@(a.ActorNameSnapshot ?? "")</small><br /><small class="text-muted">@(a.ActorType ?? "")</small></td>
                                <td class="action-table-data">
                                    <div class="edit-delete-action">
                                        <a class="p-1 view-icon" title="View Detail"
                                           data-bs-toggle="offcanvas"
                                           data-bs-target="#viewAuditTrailOffcanvas"
                                           @onclick="() => OpenViewOffcanvas(a)">
                                            <i data-feather="eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                                                }
                                                else
                        {
                            <tr><td colspan="@VisibleColumnCount" class="text-center py-4"><div class="text-muted"><i class="ti ti-file-off fs-1"></i><p class="mt-2">No audit trail records found</p></div></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4">
            <div class="d-flex align-items-center"><span class="me-2">Rows per page:</span><select class="form-select form-select-sm" style="width:auto" @onchange="OnPageSizeChange"><option value="5">5</option><option value="10" selected="@(PageSize == 10)">10</option><option value="25">25</option></select><span class="ms-3 text-muted">Entries</span></div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")"><a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(CurrentPage - 1)"><i class="ti ti-chevron-left"></i></a></li>
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        var p = i;
                        <li class="page-item @(CurrentPage == p ? "active" : "")"><a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(p)">@p</a></li>
                    }
                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")"><a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(CurrentPage + 1)"><i class="ti ti-chevron-right"></i></a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>
}

<!-- Row Details Modal (Mobile) -->
<div class="modal fade list-Popup" id="rowModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Audit Event Details</h5><button type="button" class="btn-close" data-bs-dismiss="modal" style="padding:0;right:22px;position:absolute;transform:none;"></button></div>
            <div class="modal-body">
                @if (Selected != null)
                {
                    <div class="mb-2 d-flex gap-3"><strong>Event No:</strong><div>@(Selected.AuditEventNumber ?? "")</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Timestamp:</strong><div>@Selected.EventTimestamp.ToString("dd-MMM-yyyy HH:mm:ss")</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Entity:</strong><div>@(Selected.EntityType ?? "") — @(Selected.EntityNumberSnapshot ?? "")</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Category:</strong><div><span class="badge @GetCategoryBadge(Selected.EventCategory ?? "")">@(Selected.EventCategory ?? "")</span></div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Event:</strong><div><span class="badge @GetEventBadge(Selected.EventType ?? "")">@(Selected.EventType ?? "")</span></div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Severity:</strong><div>@(Selected.EventSeverity ?? "")</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Actor:</strong><div>@(Selected.ActorNameSnapshot ?? "") (@(Selected.ActorType ?? ""))</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Scope:</strong><div>@(Selected.TaxTypeScope ?? "")</div></div>
                    @if (Selected.SecurityEventFlag)
                    {
                        <div class="mb-2 d-flex gap-3"><strong class="text-danger">Security:</strong><div class="text-danger">@(Selected.SecurityEventType ?? "")</div></div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- ═══ View Offcanvas ════════════════════════════════════════════ -->
<div class="offcanvas offcanvas-end offcanvas-view"
     tabindex="-1"
     id="viewAuditTrailOffcanvas"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    @if (SelectedView != null)
    {
        <!-- Offcanvas Header -->
        <div class="offcanvas-header">
            <div class="oc-avatar" style="@(SelectedView.SecurityEventFlag ? "background:linear-gradient(135deg,#dc2626,#b91c1c);color:#fff;" : SelectedView.EventSeverity == "Critical" ? "background:linear-gradient(135deg,#dc2626,#b91c1c);color:#fff;" : SelectedView.EventSeverity == "High" ? "background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;" : "")">
                <i class="ti @(SelectedView.SecurityEventFlag ? "ti-shield-x" : "ti-file-search")"></i>
            </div>
            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@(SelectedView.AuditEventNumber ?? "")</h5>
                    <span class="badge @GetSeverityBadge(SelectedView.EventSeverity ?? "")">
                        @(SelectedView.EventSeverity ?? "")
                    </span>
                </div>
                <p class="oc-header-sub">
                    <i class="ti ti-clock"></i>
                    @SelectedView.EventTimestamp.ToString("dd MMM yyyy HH:mm:ss") &nbsp;·&nbsp;
                    @(SelectedView.EntityType ?? "")
                </p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>

        <!-- Summary Cards -->
        <div class="offcanvas-body">
            <div class="oc-summary-row">
                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value" style="font-size:0.85rem;">@(SelectedView.EventCategory ?? "")</div>
                    <div class="oc-summary-label">Category</div>
                </div>
                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value" style="font-size:0.85rem;">@(SelectedView.EventType ?? "")</div>
                    <div class="oc-summary-label">Event Type</div>
                </div>
                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value" style="font-size:0.85rem;">@(SelectedView.ValidationStatus ?? "")</div>
                    <div class="oc-summary-label">Validation</div>
                </div>
            </div>

            <!-- Entity Reference -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-link"></i>
                    <h6 class="oc-card-title">Entity Reference</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-grid">
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Entity Type</div>
                            <div class="oc-field-value">
                                <span class="badge bg-light text-dark">@(SelectedView.EntityType ?? "")</span>
                            </div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Entity No</div>
                            <div class="oc-field-value">@(SelectedView.EntityNumberSnapshot ?? "—")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Display Name</div>
                            <div class="oc-field-value">@(SelectedView.EntityDisplayNameSnapshot ?? "—")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Tax Scope</div>
                            <div class="oc-field-value">
                                <span class="badge @GetScopeBadge(SelectedView.TaxTypeScope ?? "")">@(SelectedView.TaxTypeScope ?? "")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Event Classification -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-category"></i>
                    <h6 class="oc-card-title">Event Classification</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">Category</span>
                            <span class="oc-list-value">
                                <span class="badge @GetCategoryBadge(SelectedView.EventCategory ?? "")">@(SelectedView.EventCategory ?? "")</span>
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Event Type</span>
                            <span class="oc-list-value">
                                <span class="badge @GetEventBadge(SelectedView.EventType ?? "")">@(SelectedView.EventType ?? "")</span>
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Severity</span>
                            <span class="oc-list-value">@(SelectedView.EventSeverity ?? "")</span>
                        </div>
                        @if (SelectedView.SecurityEventFlag)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Security Event</span>
                                <span class="oc-list-value text-danger fw-medium">@(SelectedView.SecurityEventType ?? "Yes")</span>
                            </div>
                        }
                        @if (SelectedView.IsSensitiveChange)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Sensitive Change</span>
                                <span class="oc-list-value text-warning fw-medium">Yes</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Actor / Initiator -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-user"></i>
                    <h6 class="oc-card-title">Actor / Initiator</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">Actor Name</span>
                            <span class="oc-list-value fw-medium">@(SelectedView.ActorNameSnapshot ?? "")</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Actor Type</span>
                            <span class="oc-list-value">@(SelectedView.ActorType ?? "")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(SelectedView.ActorRoleSnapshot))
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Role</span>
                                <span class="oc-list-value">@SelectedView.ActorRoleSnapshot</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(SelectedView.ActorIpAddress))
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">IP Address</span>
                                <span class="oc-list-value font-monospace" style="font-size:0.78rem;">@SelectedView.ActorIpAddress</span>
                            </div>
                        }
                        <div class="oc-list-row">
                            <span class="oc-list-label">Correlation ID</span>
                            <span class="oc-list-value font-monospace" style="font-size:0.72rem;">@(SelectedView.CorrelationId ?? "")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Validation & Security -->
            <div class="oc-card">
                <div class="oc-card-header hdr-purple">
                    <i class="ti ti-shield-check"></i>
                    <h6 class="oc-card-title">Validation &amp; Security</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">Validation</span>
                            <span class="oc-list-value">
                                <span class="badge @(SelectedView.ValidationStatus == "Passed" ? "bg-success-transparent" : SelectedView.ValidationStatus == "Failed" ? "bg-danger-transparent" : "bg-warning-transparent text-dark")">
                                    @(SelectedView.ValidationStatus ?? "")
                                </span>
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(SelectedView.ValidationMessage))
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Message</span>
                                <span class="oc-list-value text-danger" style="font-size:0.8rem;">@SelectedView.ValidationMessage</span>
                            </div>
                        }
                        <div class="oc-list-row">
                            <span class="oc-list-label">Immutable</span>
                            <span class="oc-list-value">
                                @if (SelectedView.IsImmutable)
                                {
                                    <span class="oc-dot-badge db-green"><span class="dot"></span> Yes</span>
                                }
                                else
                                {
                                    <span class="oc-dot-badge db-red"><span class="dot"></span> No</span>
                                }
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Retention</span>
                            <span class="oc-list-value">
                                <span class="badge bg-info-transparent text-dark">@(SelectedView.RetentionCategory ?? "")</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Business Context -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-building"></i>
                    <h6 class="oc-card-title">Business Context</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">Company</span>
                            <span class="oc-list-value fw-medium">@(SelectedView.CompanyName ?? "—")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(SelectedView.TaxPeriodKey))
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Tax Period</span>
                                <span class="oc-list-value">@SelectedView.TaxPeriodKey</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(SelectedView.BranchName))
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Branch</span>
                                <span class="oc-list-value">@SelectedView.BranchName</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(SelectedView.PartyNameSnapshot))
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Party</span>
                                <span class="oc-list-value">@SelectedView.PartyNameSnapshot @(!string.IsNullOrWhiteSpace(SelectedView.PartyType) ? $"({SelectedView.PartyType})" : "")</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(SelectedView.TaxCodeSnapshot))
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Tax Code</span>
                                <span class="oc-list-value">@SelectedView.TaxCodeSnapshot</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Reason -->
            @if (!string.IsNullOrWhiteSpace(SelectedView.ReasonText))
            {
                <div class="oc-card">
                    <div class="oc-card-header hdr-blue">
                        <i class="ti ti-message"></i>
                        <h6 class="oc-card-title">Reason</h6>
                    </div>
                    <div class="oc-card-body">
                        <div class="oc-list">
                            @if (!string.IsNullOrWhiteSpace(SelectedView.ReasonCode))
                            {
                                <div class="oc-list-row">
                                    <span class="oc-list-label">Code</span>
                                    <span class="oc-list-value"><span class="badge bg-secondary-transparent">@SelectedView.ReasonCode</span></span>
                                </div>
                            }
                            <div class="oc-list-row">
                                <span class="oc-list-label">Reason</span>
                                <span class="oc-list-value" style="font-style:italic;">@SelectedView.ReasonText</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- System Info -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-history"></i>
                    <h6 class="oc-card-title">System</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">Event Date</span>
                            <span class="oc-list-value">@SelectedView.EventDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Created</span>
                            <span class="oc-list-value">@SelectedView.CreatedAt.ToString("dd MMM yyyy HH:mm") @(!string.IsNullOrWhiteSpace(SelectedView.CreatedBy) ? $"by {SelectedView.CreatedBy}" : "")</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }
</div>
