@page "/tax-settlements/create"
@page "/tax-settlements/{Id:guid}"
@namespace FinanceConnect.Client.Pages.Tax___Statutory.TaxSettlement

<style>
    .form-select option:checked {
        color: #fff;
        background: var(--primary);
    }

    .form-select:focus {
        border-color: var(--primary);
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }

    .header-ribbon {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f8f9fa;
        padding: 15px 20px;
        border-radius: 8px;
    }

    .section-card {
        background: #fff;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 16px;
        border: 1px solid #e9ecef;
    }
    /* .section-title { font-size:15px; font-weight:600; margin-bottom:16px; color:var(--primary); border-bottom:2px solid var(--primary); padding-bottom:6px; } */
</style>

<div class="content">
    <div class="header-ribbon">
        <div class="page-title">
            <h4 class="fw-bold mb-0">
                @(IsEdit ? (model.SettlementNumber ?? "Settlement") : "New Tax Settlement")@if(IsEdit){
                <span class="badge @GetStatusBadge(model.SettlementStatus) ms-2">@model.SettlementStatus</span>
                                }
            </h4><small class="text-muted">@(IsEdit ? "Edit settlement" : "Create a new tax settlement")</small>
        </div>
        <div class="d-flex gap-2"><button class="btn btn-outline-secondary" @onclick="BackToList"><i class="ti ti-arrow-left"></i> Back</button></div>
    </div>
    <EditForm EditContext="_editContext" OnSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <div style="background:#f4f7fb;">

            <!-- Section 1: Core Identity -->
            <div class="section-card">
                <div class="section-title text-primary mb-3 fw-bold"><i class="ti ti-id me-2"></i>Core Identity (Header)</div>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Settlement No</label><input type="text" class="form-control" value="@(model.SettlementNumber ?? "Auto-generated")" disabled title="System generated settlement number" /></div>
                    <div class="col-md-4">
                        <label class="form-label">Settlement Type <span class="text-danger">*</span></label>
                        <select class="form-select @(submitted && string.IsNullOrWhiteSpace(model.SettlementType) ? "is-invalid" : "")" @bind="model.SettlementType" disabled="@IsReadOnly" title="Select the type of tax settlement">
                            <option value="">--Select Settlement Type--</option>
                            <option value="GSTCashPayment">GST Cash Payment</option>
                            <option value="GSTInputCreditOffset">GST Input Credit Offset</option>
                            <option value="GSTMixedSettlement">GST Mixed Settlement</option>
                            <option value="TDSRemittance">TDS Remittance</option>
                            <option value="TCSRemittance">TCS Remittance</option>
                            <option value="TaxAdjustment">Tax Adjustment</option>
                        </select>@if(submitted && string.IsNullOrWhiteSpace(model.SettlementType)){
                        <div class="validation-message">Settlement Type is required.</div>
                                                }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Settlement Date <span class="text-danger">*</span></label><input type="date" class="form-control" @bind="model.SettlementDate" disabled="@IsReadOnly" title="Date of settlement" />@if(submitted && model.SettlementDate==default){
                        <div class="validation-message">Settlement Date is required.</div>
                                                }
                    </div>
                    <div class="col-md-4"><label class="form-label">Posting Date</label><input type="date" class="form-control" @bind="model.PostingDate" disabled="@IsReadOnly" title="Posting date - required at posting" /></div>
                    <div class="col-md-4"><label class="form-label">Branch <span class="text-danger">*</span></label><input type="text" class="form-control" value="@(model.BranchName ?? "Chennai HQ")" disabled title="Branch" /></div>
                    <div class="col-md-4"><label class="form-label">Status</label><input type="text" class="form-control" value="@model.SettlementStatus" disabled title="Current settlement status" /></div>
                    <div class="col-12"><label class="form-label">Narration</label><textarea class="form-control" rows="2" @bind="model.Narration" disabled="@IsReadOnly" placeholder="Enter narration / description..." title="Settlement narration or description"></textarea></div>
                </div>
            </div>

            <!-- Section 2: Period & Scope -->
            <div class="section-card">
                <div class="section-title text-primary mb-3 fw-bold"><i class="ti ti-calendar me-2"></i>Period &amp; Scope</div>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Tax Period <span class="text-danger">*</span></label>
                        <input type="text" class="form-control  @(submitted && string.IsNullOrWhiteSpace(model.TaxPeriodKey) ? "is-invalid" : "")" @bind="model.TaxPeriodKey" disabled="@IsReadOnly" placeholder="e.g. 2026-03" title="Tax period key (YYYY-MM)" />
                        @if (submitted && string.IsNullOrWhiteSpace(model.TaxPeriodKey))
                        {
                            <div class="validation-message">Tax Period is required.</div>
                        }
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Tax Type Scope <span class="text-danger">*</span></label>
                        <select class="form-select  @(submitted && string.IsNullOrWhiteSpace(model.TaxTypeScope) ? "is-invalid" : "")" @bind="model.TaxTypeScope" disabled="@IsReadOnly" title="GST / TDS / TCS scope">
                            <option value="">--Select Tax Type Scope--</option>
                            <option value="GST">GST</option>
                            <option value="TDS">TDS</option>
                            <option value="TCS">TCS</option>
                        </select>@if(submitted && string.IsNullOrWhiteSpace(model.TaxTypeScope)){
                        <div class="validation-message">Tax Type Scope is required.</div>
                                                }
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Government Authority <span class="text-danger">*</span></label>
                        <select class="form-select  @(submitted && string.IsNullOrWhiteSpace(model.GovernmentAuthorityType) ? "is-invalid" : "")" @bind="model.GovernmentAuthorityType" disabled="@IsReadOnly" title="Government authority type">
                            <option value="">--Select Authority--</option>
                            <option value="GST">GST</option>
                            <option value="IncomeTax">Income Tax</option>
                            <option value="Other">Other</option>
                        </select>@if(submitted && string.IsNullOrWhiteSpace(model.GovernmentAuthorityType)){
                        <div class="validation-message">Government Authority Type is required.</div>
                                                }
                    </div>
                    <div class="col-md-3"><label class="form-label">Jurisdiction Code</label><input type="text" class="form-control" @bind="model.JurisdictionCode" disabled="@IsReadOnly" placeholder="Optional" title="Jurisdiction code if applicable" /></div>
                    <div class="col-md-4"><label class="form-label">Accounting Period</label><input type="text" class="form-control" @bind="model.AccountingPeriodName" disabled="@IsReadOnly" placeholder="e.g. Feb 2026" title="Accounting period name" /></div>
                    <div class="col-md-4"><label class="form-label">Total Outstanding Amount</label><input type="number" step="0.01" class="form-control" @bind="model.TotalOutstandingAmount" disabled="@IsReadOnly" title="Total outstanding amount from selected liabilities" /></div>
                    <div class="col-md-4"><label class="form-label">Return Run (Optional)</label><input type="text" class="form-control" value="@(model.ReturnRunNumber ?? "—")" disabled title="Linked GST Return Run if applicable" /></div>
                </div>
            </div>

            <!-- Section 3: Payment / Challan Details -->
            <div class="section-card">
                <div class="section-title text-primary mb-3 fw-bold"><i class="ti ti-credit-card me-2"></i>Payment / Challan / Remittance Details</div>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Payment Mode <span class="text-danger">*</span></label>
                        <select class="form-select  @(submitted && string.IsNullOrWhiteSpace(model.PaymentMode) ? "is-invalid" : "")" @bind="model.PaymentMode" disabled="@IsReadOnly" title="Select payment mode">
                            <option value="">--Select Payment Mode--</option>
                            <option value="Bank">Bank</option>
                            <option value="Cash">Cash</option>
                            <option value="CreditOffsetOnly">Credit Offset Only</option>
                            <option value="Mixed">Mixed</option>
                        </select>@if(submitted && string.IsNullOrWhiteSpace(model.PaymentMode)){
                        <div class="validation-message">Payment Mode is required.</div>
                                                }
                    </div>
                    <div class="col-md-3"><label class="form-label">Bank Account</label><input type="text" class="form-control" @bind="model.BankAccountName" disabled="@IsReadOnly" placeholder="Select bank account" title="Bank account for settlement" /></div>
                    <div class="col-md-3"><label class="form-label">Cash Account</label><input type="text" class="form-control" @bind="model.CashAccountName" disabled="@IsReadOnly" placeholder="Select cash account" title="Cash account for settlement" /></div>
                    <div class="col-md-3"><label class="form-label">Challan Number</label><input type="text" class="form-control" @bind="model.ChallanNumber" disabled="@IsReadOnly" placeholder="e.g. CHL-GST-202601-001" title="Challan number for remittance proof" /></div>
                    <div class="col-md-3"><label class="form-label">Challan Date</label><input type="date" class="form-control" @bind="model.ChallanDate" disabled="@IsReadOnly" title="Challan date" /></div>
                    <div class="col-md-3"><label class="form-label">Govt Reference No</label><input type="text" class="form-control" @bind="model.GovernmentReferenceNumber" disabled="@IsReadOnly" placeholder="CIN/CPIN/Txn Ref" title="Government reference number (CIN/CPIN)" /></div>
                    <div class="col-md-3"><label class="form-label">Payment Reference No</label><input type="text" class="form-control" @bind="model.PaymentReferenceNumber" disabled="@IsReadOnly" placeholder="UTR / Cheque No" title="UTR, cheque number, or bank reference" /></div>
                    <div class="col-md-3"><label class="form-label">Remitted On</label><input type="date" class="form-control" @bind="model.RemittedOn" disabled="@IsReadOnly" title="Date of remittance" /></div>
                </div>
            </div>

            <!-- Section 4: GST Credit Offset (GST types only) -->
            @if (model.SettlementType?.Contains("GST") == true)
            {
                <div class="section-card">
                    <div class="section-title text-primary mb-3 fw-bold"><i class="ti ti-arrows-exchange me-2"></i>GST Credit Offset Details</div>
                    <div class="row g-3">
                        <div class="col-md-3"><label class="form-label">ITC Offset CGST</label><input type="number" step="0.01" class="form-control" @bind="model.InputCreditOffsetCGSTAmount" disabled="@IsReadOnly" title="Input credit offset for CGST" /></div>
                        <div class="col-md-3"><label class="form-label">ITC Offset SGST</label><input type="number" step="0.01" class="form-control" @bind="model.InputCreditOffsetSGSTAmount" disabled="@IsReadOnly" title="Input credit offset for SGST" /></div>
                        <div class="col-md-3"><label class="form-label">ITC Offset IGST</label><input type="number" step="0.01" class="form-control" @bind="model.InputCreditOffsetIGSTAmount" disabled="@IsReadOnly" title="Input credit offset for IGST" /></div>
                        <div class="col-md-3"><label class="form-label">ITC Offset CESS</label><input type="number" step="0.01" class="form-control" @bind="model.InputCreditOffsetCESSAmount" disabled="@IsReadOnly" title="Input credit offset for CESS" /></div>
                    </div>
                </div>
            }

            <!-- Section 5: Notes -->
            <div class="section-card">
                <div class="section-title text-primary mb-3 fw-bold"><i class="ti ti-notes me-2"></i>Attachments &amp; Notes</div>
                <div class="row g-3">
                    <div class="col-12"><label class="form-label">Settlement Notes</label><textarea class="form-control" rows="2" @bind="model.SettlementNotes" disabled="@IsReadOnly" placeholder="Optional settlement notes..." title="Additional notes about this settlement"></textarea></div>
                </div>
            </div>

            @if (!IsReadOnly)
            {
                <div class="d-flex gap-2 justify-content-end mt-3 mb-4">
                    <button class="btn btn-outline-secondary" type="button" @onclick="BackToList">
                        <i class="ti ti-x"></i> Cancel
                    </button>
                    <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy me-1"></i>@(IsEdit ? "Update" : "Save")</button>
                </div>
            }
        </div>
    </EditForm>
</div>
