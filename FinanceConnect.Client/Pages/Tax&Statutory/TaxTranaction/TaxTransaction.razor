@page "/tax-transaction"
@namespace FinanceConnect.Client.Pages.Tax___Statutory.TaxTranaction

@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TaxTransactionService TaxTransactionService
@inject ToastService ToastService

<style>

    @@media(max-width:672px) {
        .responsivefilter {
            flex-wrap: wrap;
        }
    }
    .modal .btn-close::before{
        background:white
    }
    .form-select option:checked {
        color: #fff;
        background: var(--primary);
    }

    .form-select:focus {
        border-color: var(--primary);
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }

</style>


@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Tax Transaction Ledger</h4>
                    <h6>Tax records per posted document</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

        </div>

        <!-- Filters + List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

                <!-- Search -->
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset">
                            <i class="ti ti-search fs-14"></i>
                        </span>
                        <input type="search"
                               class="form-control form-control-sm"
                               placeholder="Search Tx No, document, party..."
                               @bind="searchText"
                               @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display:flex; gap:8px;" class="responsivefilter">

                    <!-- Tax Type Filter -->
                    <select class="form-select form-select-sm"
                            style="min-width:140px"
                            @bind="SelectedTaxType">
                        <option value="">All Tax Types</option>
                        <option value="GST">GST</option>
                        <option value="TDS">TDS</option>
                        <option value="TCS">TCS</option>
                        <option value="Mixed">Mixed</option>
                    </select>

                    <!-- Status Filter -->
                    <select class="form-select form-select-sm"
                            style="min-width:160px"
                            @bind="SelectedStatus">
                        <option value="">All Status</option>
                        <option value="Draft">Draft</option>
                        <option value="Posted">Posted</option>
                        <option value="IncludedInReturn">Included in Return</option>
                        <option value="Excluded">Excluded</option>
                        <option value="PartiallySettled">Partially Settled</option>
                        <option value="Settled">Settled</option>
                        <option value="Reversed">Reversed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>

                    <!-- Source Doc Type Filter -->
                    <select class="form-select form-select-sm"
                            style="min-width:175px"
                            @bind="SelectedDocType">
                        <option value="">All Document Types</option>
                        <option value="CustomerInvoice">Customer Invoice</option>
                        <option value="CustomerCreditNote">Customer Credit Note</option>
                        <option value="VendorBill">Vendor Bill</option>
                        <option value="VendorPayment">Vendor Payment</option>
                        <option value="VendorCreditNote">Vendor Credit Note</option>
                        <option value="AssetAcquisition">Asset Acquisition</option>
                    </select>

                    <!-- Tax Period Filter -->
                    @* <input type="text"
                           class="form-control form-control-sm"
                           style="min-width:110px"
                           placeholder="Period e.g. 2026-01"
                           @bind="SelectedPeriod" /> *@

                </div>
            </div>

            <div class="card-body p-0">
                <div>
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th>Tx Number</th>
                                <th class="d-none d-md-table-cell">Source Document</th>
                                <th class="d-none d-lg-table-cell">Party</th>
                                @* <th class="d-none d-xl-table-cell">Tax Type</th> *@
                                @* <th class="d-none d-xl-table-cell" style="width:110px">Supply Type</th> *@
                                <th class="d-none d-lg-table-cell text-center">Tax Amount</th>
                                <th class="d-none d-xxl-table-cell">Return Status</th>
                                <th class="d-none d-xxl-table-cell">Status</th>
                                <th class="no-sort">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (PagedTransactions.Any())
                            {
                                @foreach (var tx in PagedTransactions)
                                {
                                    <tr @key="tx.Id">

                                        <!-- Mobile expand -->
                                        <td class="d-xl-none text-center" style="padding:0; padding-left:15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenViewModal(tx)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <!-- Tx Number -->
                                        <td>
                                            <span class="fw-medium"
                                                  data-bs-toggle="tooltip"
                                                  data-bs-placement="top"
                                                  title="@tx.TaxTransactionNumber Details">
                                                <span class="PopupIcon me-1">⧉</span>
                                                <a @onclick="() => OpenViewModal(tx)"
                                                   class="text-decoration-none link-View"
                                                   data-bs-toggle="offcanvas"
                                                   data-bs-target="#viewTaxTransactionOffcanvas">
                                                    @tx.TaxTransactionNumber
                                                </a>
                                            </span>
                                            <div class="text-muted" style="font-size:0.72rem; margin-top:2px;">
                                                @tx.PostingDate.ToString("dd-MMM-yyyy")
                                            </div>
                                        </td>

                                        <!-- Source Document -->
                                        <td class="d-none d-md-table-cell">
                                            <span class="badge @GetDocTypeBadge(tx.SourceDocumentType) badge-sm mb-1">
                                                @GetDocTypeShort(tx.SourceDocumentType)
                                            </span>
                                            <div style="font-size:0.8rem;">@tx.SourceDocumentNumberSnapshot</div>
                                        </td>

                                        <!-- Party -->
                                        <td class="d-none d-lg-table-cell">
                                            <div class="fw-medium" style="font-size:0.85rem;">@tx.PartyNameSnapshot</div>
                                            @if (!string.IsNullOrEmpty(tx.PartyGSTINSnapshot))
                                            {
                                                <div class="text-muted" style="font-size:0.72rem;">@tx.PartyGSTINSnapshot</div>
                                            }
                                            else if (!string.IsNullOrEmpty(tx.PartyPANSnapshot))
                                            {
                                                <div class="text-muted" style="font-size:0.72rem;">PAN: @tx.PartyPANSnapshot</div>
                                            }
                                        </td>

                                        <!-- Tax Type -->
                                        @* <td class="d-none d-xl-table-cell">
                                            <span class="badge @GetTaxTypeBadge(tx.TaxType)">@tx.TaxType</span>
                                        </td> *@

                                        <!-- Supply Type -->
                                        @* <td class="d-none d-xl-table-cell">
                                            @if (!string.IsNullOrEmpty(tx.SupplyType))
                                            {
                                                <span class="badge @GetSupplyTypeBadge(tx.SupplyType) badge-sm">@tx.SupplyType</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td> *@

                                        <!-- Tax Amount -->
                                        <td class="d-none d-lg-table-cell text-center fw-semibold"
                                            style="color:@(tx.TaxAmountTotal >= 0 ? "#002fdc" : "red")">

                                            <div style="width: 116px;">
                                                ₹@tx.TaxAmountTotal.ToString("N2")
                                            </div>

                                        </td>

                                        <!-- Return Status -->
                                        <td class="d-none d-xxl-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @GetReturnStatusDot(tx.ReturnInclusionStatus)"></div>
                                                <span>@tx.ReturnInclusionStatus</span>
                                            </div>
                                        </td>

                                        <!-- Tx Status -->
                                        <td class="d-none d-xxl-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @GetStatusDot(tx.TaxTransactionStatus)"></div>
                                                <span>@tx.TaxTransactionStatus</span>
                                            </div>
                                        </td>

                                        <!-- Actions -->
                                        <td class="action-table-data">
                                            <div class="edit-delete-action">

                                                <!-- View detail offcanvas -->
                                                <a class="me-2 view-icon p-1" title="View Detail"
                                                   data-bs-toggle="offcanvas"
                                                   data-bs-target="#viewTaxTransactionOffcanvas"
                                                   @onclick="() => OpenViewModal(tx)">
                                                    <i data-feather="eye"></i>
                                                </a>

                                                <!-- View Lines -->
                                                <a class="me-2 Layer-icon p-1" title="View Tax Lines"
                                                   @onclick="() => OpenLinesModal(tx)"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#linesModal">
                                                    <i data-feather="layers"></i>
                                                </a>

                                                <!-- Exclude from Return -->
                                                @if (tx.TaxTransactionStatus == "Posted" && !tx.IsIncludedInReturn)
                                                {
                                                    <a class="me-2 p-1 delete-icon" title="Exclude from Return"
                                                       @onclick="() => AskExclude(tx)"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top">
                                                        <i data-feather="slash"></i>
                                                    </a>
                                                }

                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center py-4">
                                        <div class="text-muted">
                                            <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                            No tax transactions found
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (PagedTransactions.Any())
                {
                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center p-3">
                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="#" @onclick="PreviousPage" @onclick:preventDefault>
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @foreach (var pageNumber in VisiblePages)
                                {
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="#" @onclick="NextPage" @onclick:preventDefault>
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>

    </div>
}

<!-- ═══ Exclude Reason Modal ════════════════════════════════════ -->
@if (ShowReasonModal)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@ModalTitle</h5>
                </div>
                <div class="modal-body">
                    <textarea class="form-control"
                              rows="3"
                              placeholder="Enter reason for exclusion"
                              @bind="Reason"></textarea>
                    @if (string.IsNullOrWhiteSpace(Reason) && showReasonValidation)
                    {
                        <div class="validation-message mt-1">Reason is required.</div>
                    }
                </div>
                <div class="modal-footer" style="column-gap:10px;">
                    <button class="btn btn-outline-secondary" @onclick="CloseModal">
                        <i class="ti ti-x me-1"></i>Cancel
                    </button>
                    <button class="btn btn-primary" @onclick="ConfirmAction">
                        <i class="ti ti-check me-1"></i>Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<!-- ═══ Mobile row detail modal ══════════════════════════════════ -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tax Transaction Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute; transform:none"></button>
            </div>
            @if (SelectedTx != null)
            {
                <div class="modal-body">

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Source Doc:</strong>
                        <div>@SelectedTx.SourceDocumentNumberSnapshot</div>
                    </div>

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Party:</strong>
                        <div>@SelectedTx.PartyNameSnapshot</div>
                    </div>

                    <div class="mb-2 d-flex gap-3 d-xl-none">
                        <strong>Tax Type:</strong>
                        <span class="badge @GetTaxTypeBadge(SelectedTx.TaxType)">@SelectedTx.TaxType</span>
                    </div>

                    <div class="mb-2 d-flex gap-3 d-xl-none">
                        <strong>Supply Type:</strong>
                        @if (!string.IsNullOrEmpty(SelectedTx.SupplyType))
                        {
                            <span class="badge @GetSupplyTypeBadge(SelectedTx.SupplyType) badge-sm">@SelectedTx.SupplyType</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </div>

                    <div class="mb-2 d-flex gap-3 d-lg-none">
                        <strong>Tax Amount:</strong>
                        <div class="fw-semibold">₹@SelectedTx.TaxAmountTotal.ToString("N2")</div>
                    </div>

                    <div class="mb-2 d-flex gap-3 d-xxl-none">
                        <strong>Return Status:</strong>
                        <span>@SelectedTx.ReturnInclusionStatus</span>
                    </div>

                    <div class="mb-2 d-flex gap-3 d-xxl-none">
                        <strong>Status:</strong>
                        <span class="badge @GetStatusBadge(SelectedTx.TaxTransactionStatus)">
                            @SelectedTx.TaxTransactionStatus
                        </span>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Mapping:</strong>
                        <code style="font-size:0.78rem;">@SelectedTx.AppliedMappingCodeSnapshot</code>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Posted On:</strong>
                        <div>@SelectedTx.PostedOn?.ToString("dd-MMM-yyyy HH:mm")</div>
                    </div>

                </div>
            }
        </div>
    </div>
</div>

<!-- ═══ View Offcanvas ════════════════════════════════════════════ -->
<div class="offcanvas offcanvas-end offcanvas-view"
     tabindex="-1"
     id="viewTaxTransactionOffcanvas"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    @if (SelectedTx != null)
    {
        <!-- Offcanvas Header -->
        <div class="offcanvas-header">
            <div class="oc-avatar">
                @SelectedTx.TaxType
            </div>
            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@SelectedTx.TaxTransactionNumber</h5>
                    <span class="badge  @GetStatusBadge(SelectedTx.TaxTransactionStatus)">
                        @SelectedTx.TaxTransactionStatus
                    </span>
                </div>
                <p class="oc-header-sub">
                    <i class="ti ti-file-invoice"></i>
                    @SelectedTx.SourceDocumentNumberSnapshot &nbsp;·&nbsp;
                    @SelectedTx.PostingDate.ToString("dd MMM yyyy")
                </p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>

        <!-- Summary Cards -->
        <div class="offcanvas-body">
            <div class="oc-summary-row">
                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value">₹@SelectedTx.TaxableValueTotal.ToString("N0")</div>
                    <div class="oc-summary-label">Taxable Value</div>
                </div>
                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value">₹@SelectedTx.TaxAmountTotal.ToString("N0")</div>
                    <div class="oc-summary-label">Tax Amount</div>
                </div>
                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value">@SelectedTx.Lines.Count</div>
                    <div class="oc-summary-label">Tax Lines</div>
                </div>
            </div>

            <!-- Core Identity -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-id"></i>
                    <h6 class="oc-card-title">Core Identity</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-grid">
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Tx Number</div>
                            <div class="oc-field-value">@SelectedTx.TaxTransactionNumber</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Tax Type</div>
                            <div class="oc-field-value">
                                <span class="badge @GetTaxTypeBadge(SelectedTx.TaxType)">@SelectedTx.TaxType</span>
                            </div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Status</div>
                            <div class="oc-field-value">
                                <span class="badge @GetStatusBadge(SelectedTx.TaxTransactionStatus)">
                                    @SelectedTx.TaxTransactionStatus
                                </span>
                            </div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Period</div>
                            <div class="oc-field-value">@(SelectedTx.TaxPeriodKey ?? "—")</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Source Document -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-file-invoice"></i>
                    <h6 class="oc-card-title">Source Document</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-grid">
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Type</div>
                            <div class="oc-field-value">
                                <span class="badge @GetDocTypeBadge(SelectedTx.SourceDocumentType) badge-sm">
                                    @GetDocTypeShort(SelectedTx.SourceDocumentType)
                                </span>
                            </div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Document No.</div>
                            <div class="oc-field-value">@SelectedTx.SourceDocumentNumberSnapshot</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Document Date</div>
                            <div class="oc-field-value">@SelectedTx.SourceDocumentDateSnapshot.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label">Posting Date</div>
                            <div class="oc-field-value">@SelectedTx.PostingDate.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Party & Supply -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-building"></i>
                    <h6 class="oc-card-title">Party &amp; Supply</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">Party Name</span>
                            <span class="oc-list-value fw-medium">@SelectedTx.PartyNameSnapshot</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">GSTIN</span>
                            <span class="oc-list-value">@(SelectedTx.PartyGSTINSnapshot ?? "—")</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">PAN</span>
                            <span class="oc-list-value">@(SelectedTx.PartyPANSnapshot ?? "—")</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Supply Type</span>
                            <span class="oc-list-value">
                                @if (!string.IsNullOrEmpty(SelectedTx.SupplyType))
                                {
                                    <span class="badge @GetSupplyTypeBadge(SelectedTx.SupplyType) badge-sm">
                                        @SelectedTx.SupplyType
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">From / To State</span>
                            <span class="oc-list-value">
                                @(SelectedTx.FromStateCode ?? "—") → @(SelectedTx.ToStateCode ?? "—")
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Reverse Charge</span>
                            <span class="oc-list-value">
                                @if (SelectedTx.IsReverseCharge)
                                {
                                    <span class="oc-dot-badge db-green"><span class="dot"></span> Yes</span>
                                }
                                else
                                {
                                    <span class="oc-dot-badge db-red"><span class="dot"></span> No</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Totals -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-calculator"></i>
                    <h6 class="oc-card-title">Totals</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">Taxable Value</span>
                            <span class="oc-list-value fw-semibold">₹@SelectedTx.TaxableValueTotal.ToString("N2")</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Total Tax</span>
                            <span class="oc-list-value fw-semibold text-danger">₹@SelectedTx.TaxAmountTotal.ToString("N2")</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Gross Value</span>
                            <span class="oc-list-value">₹@(SelectedTx.GrossDocumentValueSnapshot?.ToString("N2") ?? "—")</span>
                        </div>
                        @if (SelectedTx.ITCEligibleTaxAmount > 0)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">ITC Eligible</span>
                                <span class="oc-list-value text-success">₹@SelectedTx.ITCEligibleTaxAmount.ToString("N2")</span>
                            </div>
                        }
                        @if (SelectedTx.WithholdingTaxAmount > 0)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">TDS Withheld</span>
                                <span class="oc-list-value text-info">₹@SelectedTx.WithholdingTaxAmount.ToString("N2")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Return Status -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-file-check"></i>
                    <h6 class="oc-card-title">Return &amp; Reconciliation</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label">Return Inclusion</span>
                            <span class="oc-list-value">
                                <span class="badge @GetReturnStatusBadge(SelectedTx.ReturnInclusionStatus)">
                                    @SelectedTx.ReturnInclusionStatus
                                </span>
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label">Reconciliation</span>
                            <span class="oc-list-value">
                                <span class="badge @GetReconciliationBadge(SelectedTx.ReconciliationStatus)">
                                    @SelectedTx.ReconciliationStatus
                                </span>
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(SelectedTx.ExclusionReason))
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label">Exclusion Reason</span>
                                <span class="oc-list-value text-danger">@SelectedTx.ExclusionReason</span>
                            </div>
                        }
                        <div class="oc-list-row">
                            <span class="oc-list-label">Mapping Code</span>
                            <span class="oc-list-value" style="font-size:0.75rem;">
                                <code>@SelectedTx.AppliedMappingCodeSnapshot</code>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigate to Lines -->
            <div class="oc-card hover-shadow cursor-pointer"
                 data-bs-dismiss="offcanvas"
                 @onclick="() => OpenLinesModal(SelectedTx)"
                 data-bs-toggle="modal"
                 data-bs-target="#linesModal">
                <div class="d-flex align-items-center justify-content-between p-2">
                    <div class="d-flex align-items-center">
                        <div class="me-3 text-primary">
                            <i class="ti ti-list-details fs-28"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">Tax Lines (Model #66)</div>
                            <div class="text-muted small">
                                @SelectedTx.Lines.Count line(s) · View component-level breakup
                            </div>
                        </div>
                    </div>
                    <i class="ti ti-chevron-right"></i>
                </div>
            </div>

        </div>
    }
</div>

<!-- ═══ Tax Lines Modal (#66) ════════════════════════════════════ -->
<div class="modal fade" id="linesModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Tax Lines — Model #66
                    @if (SelectedTx != null)
                    {
                        <span class="text-muted fs-14 fw-normal ms-2">@SelectedTx.TaxTransactionNumber</span>
                    }
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute; transform:none"></button>
            </div>
            <div class="modal-body p-0">
                @if (SelectedTx != null && SelectedTx.Lines.Any())
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Line</th>
                                <th>Tax Code</th>
                                <th>Component</th>
                                <th>Direction</th>
                                <th>Source Line</th>
                                <th class="text-end">Taxable Base</th>
                                <th class="text-end">Rate %</th>
                                <th class="text-end">Tax Amount</th>
                                <th>ITC / RCM</th>
                                <th>Formula</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in SelectedTx.Lines)
                            {
                                <tr class="@(line.TaxAmount < 0 ? "table-warning" : "")">
                                    <td><code>@line.LineNumber</code></td>
                                    <td>
                                        <code style="font-size:0.78rem;">@line.TaxCodeSnapshot</code>
                                        <div class="text-muted" style="font-size:0.7rem;">v@line.RateVersionNumberSnapshot</div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(line.GSTComponentTypeSnapshot))
                                        {
                                            <span class="badge bg-primary-transparent  badge-sm">@line.GSTComponentTypeSnapshot</span>
                                        }
                                        else if (!string.IsNullOrEmpty(line.SectionCodeSnapshot))
                                        {
                                            <span class="badge bg-warning-transparent text-dark badge-sm">§@line.SectionCodeSnapshot</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                </td>
                                <td>
                                    <span class="badge @GetDirectionBadge(line.TaxDirectionSnapshot) badge-sm">
                                        @GetDirectionShort(line.TaxDirectionSnapshot)
                                    </span>
                                </td>
                                <td style="font-size:0.78rem; max-width:160px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
                                    title="@line.SourceLineDescriptionSnapshot">
                                    @(line.SourceLineDescriptionSnapshot ?? "—")
                                </td>
                                <td class="text-end">₹@line.TaxableBaseAmount.ToString("N2")</td>
                                <td class="text-end">
                                    @(line.RatePercentSnapshot.HasValue
                                                                    ? $"{line.RatePercentSnapshot.Value:0.##}%"
                                                                    : "—")
                                    </td>
                                    <td class="text-end @(line.TaxAmount < 0 ? "text-danger" : "fw-semibold")">
                                        ₹@line.TaxAmount.ToString("N2")
                                    </td>
                                    <td>
                                        @if (line.ITCEligibilityStatus == "Eligible")
                                        {
                                            <span class="badge bg-success badge-sm">ITC ✓</span>
                                        }
                                        @if (line.IsReverseChargeLine)
                                        {
                                            <span class="badge bg-warning text-dark badge-sm ms-1">RCM</span>
                                        }
                                        @if (line.IsPanMissingAlternateRateApplied)
                                        {
                                            <span class="badge bg-danger badge-sm ms-1">No PAN</span>
                                        }
                                    </td>
                                    <td style=" max-width:180px;">
                                        <code>@(line.CalculationFormulaSnapshot ?? "—")</code>
                                    </td>
                                    <td>
                                        <span class="badge @GetLineStatusBadge(line.LineStatus) badge-sm">
                                            @line.LineStatus
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-semibold">
                            <tr>
                                <td colspan="5" class="text-end p-3">Total</td>
                                <td class="text-end">₹@SelectedTx.Lines.Sum(l => l.TaxableBaseAmount).ToString("N2")</td>
                                <td></td>
                                <td class="text-end">₹@SelectedTx.Lines.Sum(l => l.TaxAmount).ToString("N2")</td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="ti ti-database-off fs-28 d-block mb-2"></i>
                        No lines found for this transaction.
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="ClosepopupModal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="view-fiscalyear-modal" tabindex="-1"></div>
