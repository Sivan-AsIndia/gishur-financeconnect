@page "/tcs-config/create"
@page "/tcs-config/{Id:guid}/edit"
@using FinanceConnect.Client.Services
@using static FinanceConnect.Client.ViewModels.TCSConfigViewModel
@inject IJSRuntime JS
@inject ToastService ToastService

<style>
    .form-select option:checked { color:white;background-color:var(--primary); }
    .validation-message { color:#dc3545;font-size:12px; }
</style>

<div class="content Accordion-form">
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">@(IsEdit ? "Edit TCS Config" : "New TCS Config")</h4>
                <h6>Tax Collected at Source — section-wise collection rule master</h6>
            </div>
        </div>
        <div class="page-btn mt-0">
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">
                <i class="ti ti-arrow-left"></i> Back
            </button>
        </div>
    </div>

    @if (!isInitialized)
    {
        <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(globalError))
        {
            <div class="alert alert-danger py-2 mb-3 d-flex align-items-center gap-2">
                <i class="ti ti-alert-circle"></i> @globalError
            </div>
        }

        <EditForm EditContext="_editContext" OnSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="add-product" style="background:#f4f7fb;padding:24px 14px;">
                <div class="tl-accordion">

                    <!-- LEFT PANEL -->
                    <div class="tl-left-panel">

                        <div class="tl-label @(ShowGeneral ? "active accent-orange" : "")"
                             @onclick="@(() => ToggleAccordion("general"))">
                            <div class="tl-label-icon ico-orange"><i data-feather="info"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">General</div>
                                <div class="tl-label-sub">Code, name, status &amp; dates</div>
                            </div>
                            <span class="tl-label-chevron @(ShowGeneral ? "open" : "")"><i data-feather="chevron-right"></i></span>
                        </div>

                        <div class="tl-label @(ShowSection ? "active accent-blue" : "")"
                             @onclick="@(() => ToggleAccordion("section"))">
                            <div class="tl-label-icon ico-blue"><i data-feather="tag"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">TCS Identity</div>
                                <div class="tl-label-sub">Section, TaxCode &amp; context</div>
                            </div>
                            <span class="tl-label-chevron @(ShowSection ? "open" : "")"><i data-feather="chevron-right"></i></span>
                        </div>

                        <div class="tl-label @(ShowApplicability ? "active accent-purple" : "")"
                             @onclick="@(() => ToggleAccordion("applicability"))">
                            <div class="tl-label-icon ico-purple"><i data-feather="users"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Applicability</div>
                                <div class="tl-label-sub">Customer, residency &amp; trigger</div>
                            </div>
                            <span class="tl-label-chevron @(ShowApplicability ? "open" : "")"><i data-feather="chevron-right"></i></span>
                        </div>

                        <div class="tl-label @(ShowThreshold ? "active accent-green" : "")"
                             @onclick="@(() => ToggleAccordion("threshold"))">
                            <div class="tl-label-icon ico-green"><i data-feather="sliders"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Threshold Logic</div>
                                <div class="tl-label-sub">Threshold mode &amp; amount</div>
                            </div>
                            <span class="tl-label-chevron @(ShowThreshold ? "open" : "")"><i data-feather="chevron-right"></i></span>
                        </div>

                        <div class="tl-label @(ShowRate ? "active accent-rose" : "")"
                             @onclick="@(() => ToggleAccordion("rate"))">
                            <div class="tl-label-icon ico-rose"><i data-feather="percent"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Rate Behavior</div>
                                <div class="tl-label-sub">Rate source, PAN &amp; certificates</div>
                            </div>
                            <span class="tl-label-chevron @(ShowRate ? "open" : "")"><i data-feather="chevron-right"></i></span>
                        </div>

                        <div class="tl-label @(ShowBase ? "active accent-teal" : "")"
                             @onclick="@(() => ToggleAccordion("base"))">
                            <div class="tl-label-icon ico-teal"><i data-feather="layers"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Collection Base</div>
                                <div class="tl-label-sub">Deduction base &amp; GST exclusion</div>
                            </div>
                            <span class="tl-label-chevron @(ShowBase ? "open" : "")"><i data-feather="chevron-right"></i></span>
                        </div>

                        <div class="tl-label @(ShowAccounting ? "active accent-orange" : "")"
                             @onclick="@(() => ToggleAccordion("accounting"))">
                            <div class="tl-label-icon ico-orange"><i data-feather="book-open"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Accounting &amp; Governance</div>
                                <div class="tl-label-sub">GL, lock &amp; compliance</div>
                            </div>
                            <span class="tl-label-chevron @(ShowAccounting ? "open" : "")"><i data-feather="chevron-right"></i></span>
                        </div>

                    </div>

                    <!-- RIGHT AREA -->
                    <div class="tl-right-area">

                        <!-- ── 01 GENERAL ── -->
                        <div class="tl-card-row @(ShowGeneral ? "row-active" : "")">
                            <div class="tl-dot-col"><div class="tl-dot" @onclick="@(() => ToggleAccordion("general"))"></div></div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowGeneral ? "card-active border-orange" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("general"))">
                                        <div class="tl-card-header-title"><span class="tl-card-step step-orange">01</span>General — Core Identity</div>
                                        <span class="tl-card-toggle @(ShowGeneral ? "toggle-open" : "")"><i data-feather="chevron-down"></i></span>
                                    </div>
                                    <div class="tl-collapse @(ShowGeneral ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner">
                                                <div class="row">
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Config Code <span class="text-danger ms-1">*</span></label>
                                                        <input class="form-control text-uppercase"
                                                               value="@Form.ConfigCode"
                                                               @oninput="e => Form.ConfigCode = e.Value?.ToString() ?? string.Empty"
                                                               placeholder="e.g. TCS-206C-01" maxlength="30" />
                                                        <div class="form-text">Unique per company</div>
                                                    </div>
                                                    <div class="col-sm-5 mb-3">
                                                        <label class="form-label">Config Name <span class="text-danger ms-1">*</span></label>
                                                        <input class="form-control"
                                                               value="@Form.ConfigName"
                                                               @oninput="e => Form.ConfigName = e.Value?.ToString() ?? string.Empty"
                                                               placeholder="e.g. TCS on Sale of Goods – 206C" maxlength="200" />
                                                    </div>
                                                    <div class="col-sm-2 mb-3">
                                                        <label class="form-label">Status <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select"
                                                                value="@Form.ConfigStatus"
                                                                @onchange="e => Form.ConfigStatus = Enum.Parse<ConfigStatus>(e.Value!.ToString()!)">
                                                            <option value="Active">Active</option>
                                                            <option value="Inactive">Inactive</option>
                                                            <option value="Archived">Archived</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-sm-2 mb-3">
                                                        <label class="form-label">Priority <span class="text-danger ms-1">*</span></label>
                                                        <input type="number" class="form-control" min="1"
                                                               value="@Form.Priority"
                                                               @oninput="e => { if(int.TryParse(e.Value?.ToString(), out var v)) Form.Priority = v; }" />
                                                        <div class="form-text">Lower = higher</div>
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Effective From <span class="text-danger ms-1">*</span></label>
                                                        <input type="date" class="form-control"
                                                               value="@Form.EffectiveFrom.ToString("yyyy-MM-dd")"
                                                               @onchange="e => { if(DateTime.TryParse(e.Value?.ToString(), out var d)) Form.EffectiveFrom = d; }" />
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Effective To</label>
                                                        <input type="date" class="form-control"
                                                               value="@Form.EffectiveTo?.ToString("yyyy-MM-dd")"
                                                               @onchange="e => Form.EffectiveTo = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value!.ToString()!)" />
                                                        <div class="form-text">Leave blank for open-ended</div>
                                                    </div>
                                                    <div class="col-sm-12 mb-3">
                                                        <label class="form-label">Description</label>
                                                        <textarea class="form-control" rows="2" maxlength="500"
                                                                  placeholder="Optional description or policy note"
                                                                  @bind="Form.Description"></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 02 TCS IDENTITY & SECTION ── -->
                        <div class="tl-card-row @(ShowSection ? "row-active" : "")">
                            <div class="tl-dot-col"><div class="tl-dot" @onclick="@(() => ToggleAccordion("section"))"></div></div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowSection ? "card-active border-blue" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("section"))">
                                        <div class="tl-card-header-title"><span class="tl-card-step step-blue">02</span>TCS Identity &amp; Section Mapping</div>
                                        <span class="tl-card-toggle @(ShowSection ? "toggle-open" : "")"><i data-feather="chevron-down"></i></span>
                                    </div>
                                    <div class="tl-collapse @(ShowSection ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner">
                                                <div class="row">
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Linked TCS Tax Code <span class="text-danger ms-1">*</span></label>
                                                        <input class="form-control"
                                                               value="@Form.LinkedTaxCodeDisplay"
                                                               @oninput="e => Form.LinkedTaxCodeDisplay = e.Value?.ToString() ?? string.Empty"
                                                               placeholder="Select TCS tax code" />
                                                        <div class="form-text">Must be TaxType = TCS</div>
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">TCS Section <span class="text-danger ms-1">*</span></label>
                                                        <input class="form-control"
                                                               value="@Form.SectionCode"
                                                               @oninput="e => Form.SectionCode = e.Value?.ToString() ?? string.Empty"
                                                               placeholder="e.g. 206C, 206C(1H)" maxlength="20" />
                                                        <div class="form-text">Income Tax Act section</div>
                                                    </div>
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Transaction Context <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select"
                                                                value="@Form.TransactionContext"
                                                                @onchange="e => Form.TransactionContext = Enum.Parse<TCSTransactionContext>(e.Value!.ToString()!)">
                                                            <option value="SalesInvoice">Sales Invoice</option>
                                                            <option value="SalesReceipt">Sales Receipt</option>
                                                            <option value="AdvanceReceipt">Advance Receipt</option>
                                                            <option value="Other">Other</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-sm-12 mb-3">
                                                        <label class="form-label">Section Description</label>
                                                        <input class="form-control"
                                                               value="@Form.SectionDescription"
                                                               @oninput="e => Form.SectionDescription = e.Value?.ToString()"
                                                               placeholder="e.g. TCS on sale of goods exceeding ₹50 lakhs" maxlength="300" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 03 APPLICABILITY ── -->
                        <div class="tl-card-row @(ShowApplicability ? "row-active" : "")">
                            <div class="tl-dot-col"><div class="tl-dot" @onclick="@(() => ToggleAccordion("applicability"))"></div></div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowApplicability ? "card-active border-purple" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("applicability"))">
                                        <div class="tl-card-header-title"><span class="tl-card-step step-purple">03</span>Applicability — Customer Scope &amp; Trigger</div>
                                        <span class="tl-card-toggle @(ShowApplicability ? "toggle-open" : "")"><i data-feather="chevron-down"></i></span>
                                    </div>
                                    <div class="tl-collapse @(ShowApplicability ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner">
                                                <div class="row">
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Collection Trigger <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select"
                                                                value="@Form.CollectionTrigger"
                                                                @onchange="e => Form.CollectionTrigger = Enum.Parse<TCSCollectionTrigger>(e.Value!.ToString()!)">
                                                            <option value="OnInvoiceBooking">On Invoice Booking</option>
                                                            <option value="OnReceiptOfPayment">On Receipt of Payment</option>
                                                            <option value="OnEarlierOfInvoiceOrReceipt">Whichever Earlier</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Customer Type <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select"
                                                                value="@Form.CustomerTypeApplicability"
                                                                @onchange="e => Form.CustomerTypeApplicability = Enum.Parse<TCSCustomerTypeApplicability>(e.Value!.ToString()!)">
                                                            <option value="All">All</option>
                                                            <option value="Individual">Individual</option>
                                                            <option value="Company">Company</option>
                                                            <option value="Partnership">Partnership</option>
                                                            <option value="Proprietor">Proprietor</option>
                                                            <option value="Other">Other</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Residential Status <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select"
                                                                value="@Form.ResidentialStatusApplicability"
                                                                @onchange="e => Form.ResidentialStatusApplicability = Enum.Parse<TCSResidentialStatus>(e.Value!.ToString()!)">
                                                            <option value="All">All</option>
                                                            <option value="ResidentOnly">Resident Only</option>
                                                            <option value="NonResidentOnly">Non-Resident Only</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Allow Exempt Customer?</label>
                                                        <div class="form-check form-switch mt-2">
                                                            <input class="form-check-input" type="checkbox" id="exemptCust"
                                                                   checked="@Form.IsExemptCustomerAllowed"
                                                                   @onchange="e => Form.IsExemptCustomerAllowed = (bool)(e.Value ?? false)" />
                                                            <label class="form-check-label" for="exemptCust">
                                                                @(Form.IsExemptCustomerAllowed ? "Yes — check exemption flags" : "No")
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Customer Tag Filter</label>
                                                        <input class="form-control"
                                                               value="@Form.CustomerTagFilter"
                                                               @oninput="e => Form.CustomerTagFilter = e.Value?.ToString()"
                                                               placeholder="Optional customer group tag" />
                                                        <div class="form-text">For special customer grouping</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 04 THRESHOLD ── -->
                        <div class="tl-card-row @(ShowThreshold ? "row-active" : "")">
                            <div class="tl-dot-col"><div class="tl-dot" @onclick="@(() => ToggleAccordion("threshold"))"></div></div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowThreshold ? "card-active border-green" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("threshold"))">
                                        <div class="tl-card-header-title"><span class="tl-card-step step-green">04</span>Threshold Logic</div>
                                        <span class="tl-card-toggle @(ShowThreshold ? "toggle-open" : "")"><i data-feather="chevron-down"></i></span>
                                    </div>
                                    <div class="tl-collapse @(ShowThreshold ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner">
                                                <div class="row">
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Threshold Mode <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select"
                                                                value="@Form.ThresholdMode"
                                                                @onchange="e => Form.ThresholdMode = Enum.Parse<TCSThresholdMode>(e.Value!.ToString()!)">
                                                            <option value="NoThreshold">No Threshold — Always Collect</option>
                                                            <option value="PerDocument">Per Document</option>
                                                            <option value="CumulativeFinancialYear">Cumulative – Financial Year</option>
                                                        </select>
                                                    </div>
                                                    @if (Form.ThresholdMode != TCSThresholdMode.NoThreshold)
                                                    {
                                                        <div class="col-sm-3 mb-3">
                                                            <label class="form-label">Threshold Amount <span class="text-danger ms-1">*</span></label>
                                                            <div class="input-group">
                                                                <span class="input-group-text">₹</span>
                                                                <input type="number" class="form-control" min="0"
                                                                       value="@Form.ThresholdAmount"
                                                                       @oninput="e => Form.ThresholdAmount = decimal.TryParse(e.Value?.ToString(), out var v) ? v : null"
                                                                       placeholder="e.g. 5000000" />
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-3 mb-3">
                                                            <label class="form-label">Comparison Rule</label>
                                                            <select class="form-select"
                                                                    value="@Form.ThresholdComparisonRule"
                                                                    @onchange="e => Form.ThresholdComparisonRule = Enum.Parse<TCSThresholdComparisonRule>(e.Value!.ToString()!)">
                                                                <option value="GreaterThan">Greater Than (&gt;)</option>
                                                                <option value="GreaterThanOrEqual">Greater Than or Equal (≥)</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-sm-3 mb-3">
                                                            <label class="form-label">Threshold Computation Base <span class="text-danger ms-1">*</span></label>
                                                            <select class="form-select"
                                                                    value="@Form.ThresholdComputationBase"
                                                                    @onchange="e => Form.ThresholdComputationBase = Enum.Parse<TCSThresholdComputationBase>(e.Value!.ToString()!)">
                                                                <option value="TaxableAmountOnly">Taxable Amount Only</option>
                                                                <option value="GrossAmountIncludingTax">Gross Amount incl. Tax</option>
                                                                <option value="NetOfDiscountBeforeTax">Net of Discount (before tax)</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-sm-3 mb-3">
                                                            <label class="form-label">FY Basis</label>
                                                            <select class="form-select"
                                                                    value="@Form.FinancialYearBasis"
                                                                    @onchange="e => Form.FinancialYearBasis = Enum.Parse<TCSFinancialYearBasis>(e.Value!.ToString()!)">
                                                                <option value="CompanyFinancialYear">Company Financial Year</option>
                                                                <option value="GovernmentAssessmentYear">Govt Assessment Year (future)</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-sm-3 mb-3">
                                                            <label class="form-label">Collect Only on Excess Above Threshold?</label>
                                                            <div class="form-check form-switch mt-2">
                                                                <input class="form-check-input" type="checkbox" id="excessOnly"
                                                                       checked="@Form.ApplyCollectionOnlyOnExcessAboveThreshold"
                                                                       @onchange="e => Form.ApplyCollectionOnlyOnExcessAboveThreshold = (bool)(e.Value ?? false)" />
                                                                <label class="form-check-label" for="excessOnly">
                                                                    @(Form.ApplyCollectionOnlyOnExcessAboveThreshold ? "Yes – Excess Only" : "No – Full Amount")
                                                                </label>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 05 RATE BEHAVIOR ── -->
                        <div class="tl-card-row @(ShowRate ? "row-active" : "")">
                            <div class="tl-dot-col"><div class="tl-dot" @onclick="@(() => ToggleAccordion("rate"))"></div></div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowRate ? "card-active border-rose" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("rate"))">
                                        <div class="tl-card-header-title"><span class="tl-card-step step-rose">05</span>Rate Behavior — TCS Rate &amp; PAN Logic</div>
                                        <span class="tl-card-toggle @(ShowRate ? "toggle-open" : "")"><i data-feather="chevron-down"></i></span>
                                    </div>
                                    <div class="tl-collapse @(ShowRate ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner">
                                                <div class="row">
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Rate Resolution Mode <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select"
                                                                value="@Form.RateResolutionMode"
                                                                @onchange="e => Form.RateResolutionMode = Enum.Parse<TCSRateResolutionMode>(e.Value!.ToString()!)">
                                                            <option value="FromTaxRateVersion">From Tax Rate Version</option>
                                                            <option value="FixedRateOverride">Fixed Rate Override</option>
                                                        </select>
                                                    </div>
                                                    @if (Form.RateResolutionMode == TCSRateResolutionMode.FixedRateOverride)
                                                    {
                                                        <div class="col-sm-2 mb-3">
                                                            <label class="form-label">Fixed Rate % <span class="text-danger ms-1">*</span></label>
                                                            <div class="input-group">
                                                                <input type="number" class="form-control" min="0" max="100" step="0.001"
                                                                       value="@Form.FixedRatePercent"
                                                                       @oninput="e => Form.FixedRatePercent = decimal.TryParse(e.Value?.ToString(), out var v) ? v : null"
                                                                       placeholder="e.g. 0.1" />
                                                                <span class="input-group-text">%</span>
                                                            </div>
                                                        </div>
                                                    }
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">PAN Availability Rule <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select"
                                                                value="@Form.PanAvailabilityRule"
                                                                @onchange="e => Form.PanAvailabilityRule = Enum.Parse<TCSPanAvailabilityRule>(e.Value!.ToString()!)">
                                                            <option value="UseStandardRateIfPANAvailable">Standard Rate if PAN Available</option>
                                                            <option value="HigherRateIfPANMissing">Higher Rate if PAN Missing</option>
                                                            <option value="BlockWithoutPAN">Block Without PAN</option>
                                                        </select>
                                                    </div>
                                                    @if (Form.PanAvailabilityRule == TCSPanAvailabilityRule.HigherRateIfPANMissing)
                                                    {
                                                        <div class="col-sm-2 mb-3">
                                                            <label class="form-label">Alternate Rate (No PAN) <span class="text-danger ms-1">*</span></label>
                                                            <div class="input-group">
                                                                <input type="number" class="form-control" min="0" max="100" step="0.001"
                                                                       value="@Form.AlternateRatePercentIfPanMissing"
                                                                       @oninput="e => Form.AlternateRatePercentIfPanMissing = decimal.TryParse(e.Value?.ToString(), out var v) ? v : null"
                                                                       placeholder="e.g. 5" />
                                                                <span class="input-group-text">%</span>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                                <hr style="border-top:1px dashed #e5e7eb;margin:12px 0;" />
                                                <div class="row">
                                                    <div class="col-sm-2 mb-3">
                                                        <label class="form-label">Allow Lower Collection Cert?</label>
                                                        <div class="form-check form-switch mt-2">
                                                            <input class="form-check-input" type="checkbox" id="lowerCert"
                                                                   checked="@Form.AllowLowerCollectionCertificate"
                                                                   @onchange="e => Form.AllowLowerCollectionCertificate = (bool)(e.Value ?? true)" />
                                                            <label class="form-check-label" for="lowerCert">@(Form.AllowLowerCollectionCertificate ? "Yes" : "No")</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-2 mb-3">
                                                        <label class="form-label">Allow Nil Collection Cert?</label>
                                                        <div class="form-check form-switch mt-2">
                                                            <input class="form-check-input" type="checkbox" id="nilCert"
                                                                   checked="@Form.AllowNilCollectionCertificate"
                                                                   @onchange="e => Form.AllowNilCollectionCertificate = (bool)(e.Value ?? true)" />
                                                            <label class="form-check-label" for="nilCert">@(Form.AllowNilCollectionCertificate ? "Yes" : "No")</label>
                                                        </div>
                                                    </div>
                                                    @if (Form.AllowLowerCollectionCertificate || Form.AllowNilCollectionCertificate)
                                                    {
                                                        <div class="col-sm-4 mb-3">
                                                            <label class="form-label">Certificate Validation Mode</label>
                                                            <select class="form-select"
                                                                    value="@Form.CertificateValidationMode"
                                                                    @onchange="e => Form.CertificateValidationMode = Enum.Parse<TCSCertificateValidationMode>(e.Value!.ToString()!)">
                                                                <option value="NotRequired">Not Required</option>
                                                                <option value="ReferenceOnly">Reference Only</option>
                                                                <option value="ReferenceAndDateRangeValidation">Reference + Date Range Validation</option>
                                                            </select>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 06 COLLECTION BASE ── -->
                        <div class="tl-card-row @(ShowBase ? "row-active" : "")">
                            <div class="tl-dot-col"><div class="tl-dot" @onclick="@(() => ToggleAccordion("base"))"></div></div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowBase ? "card-active border-teal" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("base"))">
                                        <div class="tl-card-header-title"><span class="tl-card-step step-teal">06</span>Collection Base Rules</div>
                                        <span class="tl-card-toggle @(ShowBase ? "toggle-open" : "")"><i data-feather="chevron-down"></i></span>
                                    </div>
                                    <div class="tl-collapse @(ShowBase ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner">
                                                <div class="row">
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Collection Base Mode <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select"
                                                                value="@Form.DeductionBaseMode"
                                                                @onchange="e => Form.DeductionBaseMode = Enum.Parse<TCSDeductionBaseMode>(e.Value!.ToString()!)">
                                                            <option value="TaxableLineAmount">Taxable Line Amount</option>
                                                            <option value="GrossLineAmount">Gross Line Amount</option>
                                                            <option value="DocumentNetAmount">Document Net Amount</option>
                                                            <option value="ReceiptAmount">Receipt Amount</option>
                                                        </select>
                                                        <div class="form-text">Recommended: Receipt for OnReceipt trigger</div>
                                                    </div>
                                                    <div class="col-sm-2 mb-3">
                                                        <label class="form-label">Exclude GST from Base?</label>
                                                        <div class="form-check form-switch mt-2">
                                                            <input class="form-check-input" type="checkbox" id="excGST"
                                                                   checked="@Form.ExcludeGSTFromCollectionBase"
                                                                   @onchange="e => Form.ExcludeGSTFromCollectionBase = (bool)(e.Value ?? true)" />
                                                            <label class="form-check-label" for="excGST">@(Form.ExcludeGSTFromCollectionBase ? "Yes" : "No")</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-2 mb-3">
                                                        <label class="form-label">Exclude Non-Collectible Lines?</label>
                                                        <div class="form-check form-switch mt-2">
                                                            <input class="form-check-input" type="checkbox" id="excLines"
                                                                   checked="@Form.ExcludeNonCollectibleLines"
                                                                   @onchange="e => Form.ExcludeNonCollectibleLines = (bool)(e.Value ?? true)" />
                                                            <label class="form-check-label" for="excLines">@(Form.ExcludeNonCollectibleLines ? "Yes" : "No")</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-2 mb-3">
                                                        <label class="form-label">Allow Manual Base Override?</label>
                                                        <div class="form-check form-switch mt-2">
                                                            <input class="form-check-input" type="checkbox" id="manualOverride"
                                                                   checked="@Form.AllowManualBaseOverride"
                                                                   @onchange="e => Form.AllowManualBaseOverride = (bool)(e.Value ?? false)" />
                                                            <label class="form-check-label" for="manualOverride">@(Form.AllowManualBaseOverride ? "Yes" : "No")</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── 07 ACCOUNTING & GOVERNANCE ── -->
                        <div class="tl-card-row @(ShowAccounting ? "row-active" : "")">
                            <div class="tl-dot-col"><div class="tl-dot" @onclick="@(() => ToggleAccordion("accounting"))"></div></div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowAccounting ? "card-active border-orange" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("accounting"))">
                                        <div class="tl-card-header-title"><span class="tl-card-step step-orange">07</span>Accounting, Compliance &amp; Governance</div>
                                        <span class="tl-card-toggle @(ShowAccounting ? "toggle-open" : "")"><i data-feather="chevron-down"></i></span>
                                    </div>
                                    <div class="tl-collapse @(ShowAccounting ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner">
                                                <div class="row">
                                                    <div class="col-sm-5 mb-3">
                                                        <label class="form-label">TCS Payable GL Account <span class="text-danger ms-1">*</span></label>
                                                        <input class="form-control"
                                                               value="@Form.TCSPayableGLAccountDisplay"
                                                               @oninput="e => Form.TCSPayableGLAccountDisplay = e.Value?.ToString() ?? string.Empty"
                                                               placeholder="Select TCS payable liability GL" />
                                                        <div class="form-text">Liability ledger for collected TCS</div>
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Reporting Tag</label>
                                                        <input class="form-control"
                                                               value="@Form.ReportingTag"
                                                               @oninput="e => Form.ReportingTag = e.Value?.ToString()"
                                                               placeholder="e.g. 27EQ_206C" maxlength="50" />
                                                        <div class="form-text">For TCS return filing</div>
                                                    </div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">TAN Reference</label>
                                                        <input class="form-control"
                                                               value="@Form.TANReference"
                                                               @oninput="e => Form.TANReference = e.Value?.ToString()"
                                                               placeholder="Optional TAN" maxlength="30" />
                                                    </div>
                                                    <div class="col-sm-12"><hr style="border-top:1px dashed #e5e7eb;margin:4px 0 16px;" /></div>
                                                    <div class="col-sm-3 mb-3">
                                                        <label class="form-label">Lock for Changes</label>
                                                        <div class="form-check form-switch mt-2">
                                                            <input class="form-check-input" type="checkbox" id="lockChk"
                                                                   checked="@Form.IsLockedForChanges"
                                                                   @onchange="e => Form.IsLockedForChanges = (bool)(e.Value ?? false)" />
                                                            <label class="form-check-label" for="lockChk">
                                                                @(Form.IsLockedForChanges ? "🔒 Locked" : "🔓 Unlocked")
                                                            </label>
                                                        </div>
                                                        <div class="form-text">Controller only</div>
                                                    </div>
                                                    @if (Form.IsLockedForChanges)
                                                    {
                                                        <div class="col-sm-5 mb-3">
                                                            <label class="form-label">Lock Reason <span class="text-danger ms-1">*</span></label>
                                                            <input class="form-control @(Form.IsLockedForChanges && string.IsNullOrWhiteSpace(Form.LockReason) ? "is-invalid" : "")"
                                                                   value="@Form.LockReason"
                                                                   @oninput="e => Form.LockReason = e.Value?.ToString()"
                                                                   maxlength="300" placeholder="Reason for locking..." />
                                                        </div>
                                                    }
                                                    @if (IsEdit)
                                                    {
                                                        <div class="col-sm-12 mt-2">
                                                            <div class="card" style="background:#f8f9fa;">
                                                                <div class="card-body py-2">
                                                                    <div class="row text-muted" style="font-size:12px;">
                                                                        <div class="col-md-4">
                                                                            <small class="d-block fw-bold">Created At</small>
                                                                            <div>@Form.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                                                                        </div>
                                                                        <div class="col-md-4">
                                                                            <small class="d-block fw-bold">Updated At</small>
                                                                            <div>@(Form.UpdatedAt.HasValue ? Form.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm") : "—")</div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="page-btn d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">
                        <i class="ti ti-x"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="ti ti-device-floppy"></i> @(IsEdit ? "Update" : "Save")
                    </button>
                </div>
            </div>
        </EditForm>
    }
</div>
