                        <span class="title-icon bg-soft-primary fs-16 me-2">
                            <i class="ti ti-cash"></i>
                        </span>
                        <h5 class="card-title mb-0">Fiscal Progress</h5>

                    </div>
                </div>
                <div class="card-body">
                        <h5 class="fw-bold mb-2">
                            Period @CurrentPeriodNumber / @TotalPeriods
                        </h5>

                        <div class="progress fiscal-progress mb-2">
                            <div class="progress-bar" style="width:@FiscalProgressPercent%"></div>
                        </div>

                        <p class="text-muted fs-13 mb-0">
                            @FiscalProgressPercent% of year completed
                        </p>
                </div>
            </div>

        </div>
                   }else{
                        <div class="col-xxl-3 col-xl-3 col-lg-6 col-md-12 d-none d-md-none d-lg-block d-xl-block d-xxl-block d-flex">
<div class="card-body p-0">

    @if (TopOverdueInvoices.Any())
    {
        @foreach (var inv in TopOverdueInvoices.Select((value, index) => new { value, index }))
        {
            var daysOverdue = (DateTime.Today - inv.value.DueDate).Days;

            var colorClass = daysOverdue switch
            {
                > 40 => "text-danger",
                > 20 => "text-warning",
                _ => "text-primary"
            };

            var bgClass = daysOverdue switch
            {
                > 40 => "bg-soft-danger",
                > 20 => "bg-soft-warning",
                _ => "bg-soft-info"
            };

            var responsiveClass = inv.index == 4 ? "xxxxl-show" : "";

            <div class="overdue-item @responsiveClass">
                <div class="overdue-left">
                    <span class="overdue-icon @bgClass">
                        <i class="ti ti-user"></i>
                    </span>

                    <div>
                        <div class="overdue-title">@inv.value.CustomerName</div>
                        <div class="overdue-meta">
                            @inv.value.InvoiceNumber • @daysOverdue Days Overdue
                        </div>
                    </div>
                </div>

                <div class="overdue-amount @colorClass">
                                    @CurrencySymbol@FormatAmountInternational(inv.value.AmountOutstanding)
                </div>
            </div>
        }
    }
    else
    {
                        <div class="card flex-fill">
                            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                                <div class="d-inline-flex align-items-center">
                                    <span class="title-icon bg-soft-primary fs-16 me-2">
                                        <i class="ti ti-cash"></i>
                                    </span>
                                    <h5 class="card-title mb-0">Fiscal Progress</h5>

                                </div>
                            </div>
                            <div class="card-body">
                                <h5 class="fw-bold mb-2">
                                    Period @CurrentPeriodNumber / @TotalPeriods
                                </h5>

                                <div class="progress fiscal-progress mb-2">
                                    <div class="progress-bar" style="width:@FiscalProgressPercent%"></div>
                                </div>

                                <p class="text-muted fs-13 mb-0">
                                    @FiscalProgressPercent% of year completed
                                </p>
                            </div>
                        </div>
    }

</div>

        </div>
                   }
       

    </div>



</div>


