@page "/fiscalyears"
@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject FiscalYearService FiscalYearService
@inject ToastService ToastService
<style>
    .form-select option:checked {
        color: #fff;
        background: var(--primary);
    }

    .form-select:focus {
        border-color: var(--primary);
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Fiscal Year List</h4>
                    <h6>Manage company fiscal years</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/fiscalyears/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- FiscalYear List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

                <!-- Search -->
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset">
                            <i class="ti ti-search fs-14"></i>
                        </span>
                        <input type="search"
                        class="form-control form-control-sm"
                        placeholder="Search fiscal year"
                        @bind="searchText"
                        @oninput="OnSearch" />
                    </div>
                </div>
                <div style="display:flex">
                    <!-- Company Filter -->
                    <div>
                        <select class="form-select form-select-sm"
                        style="min-width: 180px"
                        @bind="SelectedCompanyId">
                            <option value="">All Companies</option>
                            @foreach (var c in Companies)
                            {
                                <option value="@c.Id">@c.LegalName</option>
                            }
                        </select>
                    </div>

                    <!-- Status Filter -->
                    <div class="ms-2">
                        <select class="form-select form-select-sm"
                        style="min-width: 140px"
                        @bind="SelectedStatus">
                            <option value="">All Status</option>
                            <option value="@FiscalYearStatus.Draft">Draft</option>
                            <option value="@FiscalYearStatus.Open">Open</option>
                            <option value="@FiscalYearStatus.SoftClosed">Soft Closed</option>
                            <option value="@FiscalYearStatus.Closed">Closed</option>
                        </select>
                    </div>
                </div>



            </div>

            <div class="card-body p-0">
                <div class="">
                    <div>
                        <table class="table align-middle w-100 table-fixed">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xl-none" style="width:40px"></th>
                                    <th style="width:225px">Code</th>
                                    <th class="d-none d-md-table-cell">Name</th>
                                    <th class="d-none d-md-table-cell">Period</th>
                                    @* <th class="d-none d-lg-table-cell">No. of Periods</th> *@
                                    <th class="d-none d-xl-table-cell" style="width: 160px;">Type</th>
                                    <th class="d-none d-xxl-table-cell" style="width: 160px;">Status</th>
                                    <th class="no-sort" style="width: 140px;">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedYears.Any())
                                {
                                    @foreach (var fy in PagedYears)
                                    {
                                        <tr @key="fy.Id">
                                            <!-- PLUS ICON -->
                                            <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                data-bs-toggle="modal"
                                                data-bs-target="#rowDetailsModal"
                                                @onclick="() => OpenViewModal(fy)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td>
                                                <span class="fw-medium"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="@fy.FiscalYearCode Details">
                                                    <span class="PopupIcon me-1">⧉</span>
                                                    <a @onclick="() => OpenViewModal(fy)"
                                                    class="text-decoration-none link-View"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#view-fiscalyear-modal">
                                                        @fy.FiscalYearCode
                                                    </a>

                                                </span>

                                            </td>
                                            <td class="d-none d-md-table-cell">@fy.FiscalYearName</td>
                                            <td class="d-none d-md-table-cell">
                                                @fy.StartDate?.ToString("dd-MMM-yyyy")
                                                -
                                                @fy.EndDate?.ToString("dd-MMM-yyyy")
                                            </td>
                                            @* <td class="d-none d-lg-table-cell">@fy.NumberOfPeriods</td> *@
                                            <td class="d-none d-xl-table-cell">@fy.PeriodType</td>

                                            <td class="d-none d-xxl-table-cell">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="ActiveDot @GetStatusDotBadge(fy.Status)">
                                                    </div>
                                                    <span>@fy.Status</span>
                                                </div>
                                            </td>
                                            <td class="action-table-data">
                                                <div class="edit-delete-action">
                                                    @* <a class="me-2 view-icon p-1" title="View"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#view-fiscalyear-modal"
                                                   @onclick="() => OpenViewModal(fy)">
                                                    <i data-feather="eye"></i>
                                                </a> *@
                                                    <a class="me-2 Layer-icon p-1" title="Open Accounting Period" href="@($"/fiscalyears/{fy.Id}/periods")">
                                                        <i data-feather="layers"></i>
                                                    </a>

                                                    @if (fy.Status == FiscalYearStatus.Draft)
                                                    {

                                                        @* OPEN *@
                                                        <a class="me-2 p-1 play-icon"
                                                        title="Open FY"
                                                        @onclick="() => ChangeStatusOfFy(fy, FiscalYearStatus.Open)">
                                                            <i data-feather="play"></i>
                                                        </a>


                                                        <a class="me-2 edit-icon p-1" title="Edit"
                                                        @onclick='() => Nav.NavigateTo($"/fiscalyears/{fy.Id}")'>
                                                            <i data-feather="edit"></i>
                                                        </a>
                                                        <a class="p-1 delete-icon" title="Delete" data-bs-toggle="modal" data-bs-target="#delete-modal" @onclick="() => ConfirmDelete(fy)">
                                                            <i data-feather="trash-2"></i>
                                                        </a>

                                                    }

                                                    @* SOFT CLOSE *@
                                                    @if (fy.Status == FiscalYearStatus.Open)
                                                    {
                                                        <a class="me-2 p-1 pause"
                                                        title="Soft Close FY"
                                                        @onclick="() => ChangeStatusOfFy(fy, FiscalYearStatus.SoftClosed)">
                                                            <i data-feather="pause"></i>
                                                        </a>

                                                        <a class="me-2 p-1 delete-icon"
                                                        title="Close FY"
                                                        @onclick="() => AskLock(fy, FiscalYearStatus.Closed)">
                                                            <i data-feather="lock"></i>
                                                        </a>
                                                    }

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else if (!PagedYears.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4">
                                            <div class="text-muted">
                                                <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                                No fiscal years found
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (PagedYears.Any())
                    {
                        <!-- Pagination -->
                        <div class="d-flex justify-content-between align-items-center p-3">

                            <div class="d-flex align-items-center fs-13">
                                <span class="me-2">Rows Per Page</span>
                                <select class="form-select form-select-sm w-auto"
                                @onchange="OnPageSizeChange">
                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                </select>
                                <span class="ms-2">Entries</span>
                            </div>

                            <nav>
                                <ul class="pagination pagination-sm mb-0">

                                    <!-- Prev -->
                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                        @onclick="PreviousPage"
                                        @onclick:preventDefault>
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>

                                    <!-- Pages -->
                                    @foreach (var pageNumber in VisiblePages)
                                    {
                                        <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                            <button type="button"
                                            class="page-link"
                                            @onclick="() => GoToPage(pageNumber)">
                                                @pageNumber
                                            </button>
                                        </li>
                                    }

                                    <!-- Next -->
                                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                        @onclick="NextPage"
                                        @onclick:preventDefault>
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>

                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
}

@if (ShowReasonModal)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@ModalTitle</h5>
                </div>

                <div class="modal-body">
                    <textarea class="form-control"
                              rows="3"
                              placeholder="Enter reason"
                              @bind="Reason"></textarea>
                </div>

                <div class="modal-footer" style="column-gap: 10px;">
                    <button class="btn btn-outline-secondary"
                            @onclick="CloseModal">
                        <i class="ti ti-x me-1"></i>Cancel
                    </button>

                    <button class="btn btn-primary"
                            @onclick="ConfirmAction">
                        <i class="ti ti-check me-1"></i>Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<!-- Responsive modal -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Fiscal Year Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>
            @if (SelectedYear != null)
            {
                <div class="modal-body">

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>FY Name:</strong>
                        <div class="text-truncate" style="max-width: 95%;" title="@SelectedYear.FiscalYearName">
                            @SelectedYear.FiscalYearName
                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Period:</strong>
                        <div>
                            @SelectedYear?.StartDate?.ToString("dd-MMM-yyyy")
                            -
                            @SelectedYear?.EndDate?.ToString("dd-MMM-yyyy")
                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>No. of Periods:</strong>
                        <div>@SelectedYear.NumberOfPeriods</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Period Type:</strong>
                        <div>@SelectedYear.PeriodType</div>
                    </div>

                    <div class="mb-2 gap-3">
                        <strong>Status:</strong>
                        <span class="badge @GetStatusBadge(SelectedYear.Status)">
                            @(SelectedYear.Status)
                        </span>

                    </div>


                </div>
            }
        </div>
    </div>
</div>



<!-- View Fiscal Year Modal -->
<div class="offcanvas offcanvas-end offcanvas-view"
     tabindex="-1"
     id="viewFiscalYearOffcanvas"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    @if (SelectedYear != null)
    {
        <!-- Header -->
        <div class="offcanvas-header">

            <div class="oc-avatar">
                FY-@SelectedYear.StartDate?.ToString("yy")
            </div>

            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@SelectedYear.FiscalYearName</h5>

                    <span class="oc-status-pill @GetStatusBadge(SelectedYear.Status)">
                        @SelectedYear.Status
                    </span>
                </div>

                <p class="oc-header-sub">
                    <i class="ti ti-calendar-event"></i>
                    @SelectedYear.StartDate?.ToString("dd MMM yyyy")
                    -
                    @SelectedYear.EndDate?.ToString("dd MMM yyyy")
                </p>
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas">
            </button>
        </div>

        <!-- Body -->
        <div class="offcanvas-body">

            <!-- Summary Cards -->
            <div class="oc-summary-row">
                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value">
                        @SelectedYear.NumberOfPeriods
                    </div>
                    <div class="oc-summary-label">Periods</div>
                </div>

                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value">
                        @SelectedYear.PeriodType
                    </div>
                    <div class="oc-summary-label">Period Type</div>
                </div>

                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value">
                        @SelectedYear.PeriodNamingConvention
                    </div>
                    <div class="oc-summary-label">Naming</div>
                </div>
            </div>

            <!-- Fiscal Year Identity -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-id"></i>
                    <h6 class="oc-card-title">Fiscal Year Identity</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Code</div>
                            <div class="oc-field-value">
                                @SelectedYear.FiscalYearCode
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Name</div>
                            <div class="oc-field-value">
                                @SelectedYear.FiscalYearName
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Status</div>
                            <div class="oc-field-value">
                                <span class="badge @GetStatusBadge(SelectedYear.Status)">
                                    @SelectedYear.Status
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Date Range -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-calendar-event"></i>
                    <h6 class="oc-card-title">Date Range</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">Start Date</div>
                            <div class="oc-field-value">
                                @SelectedYear.StartDate?.ToString("dd MMM yyyy")
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">End Date</div>
                            <div class="oc-field-value">
                                @SelectedYear.EndDate?.ToString("dd MMM yyyy")
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Closing Controls -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-lock"></i>
                    <h6 class="oc-card-title">Closing Controls</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                Adjustment Posting
                            </span>

                            <span class="oc-list-value">
                                @if (SelectedYear.AllowAdjustmentPostingAfterSoftClose)
                                {
                                    <span class="oc-dot-badge db-green">
                                        <span class="dot"></span> Allowed
                                    </span>
                                }
                                else
                                {
                                    <span class="oc-dot-badge db-red">
                                        <span class="dot"></span> Not Allowed
                                    </span>
                                }
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                Close Checklist
                            </span>

                            <span class="oc-list-value">
                                @if (SelectedYear.RequirePeriodCloseChecklist)
                                {
                                    <span class="oc-dot-badge db-green">
                                        <span class="dot"></span> Required
                                    </span>
                                }
                                else
                                {
                                    <span class="oc-dot-badge db-red">
                                        <span class="dot"></span> Not Required
                                    </span>
                                }
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                Checklist Template
                            </span>
                            <span class="oc-list-value">
                                @(SelectedYear.CloseChecklistTemplateId ?? "—")
                            </span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Navigation Card -->
            <div class="oc-card hover-shadow cursor-pointer"
                 data-bs-dismiss="offcanvas"
                 @onclick="OpenAccountingPeriods">

                <div class="d-flex align-items-center justify-content-between p-2">
                    <div class="d-flex align-items-center">

                        <div class="me-3 text-primary">
                            <i class="ti ti-calendar-time fs-28"></i>
                        </div>

                        <div>
                            <div class="fw-semibold">
                                Accounting Periods
                            </div>
                            <div class="text-muted small">
                                View and manage periods for this fiscal year
                            </div>
                        </div>

                    </div>

                    <i class="ti ti-chevron-right"></i>
                </div>

            </div>

        </div>
    }
</div>




<!-- delete modal -->
<div class="modal fade" id="delete-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Fiscal Year</h4>
                    <p class="text-gray-6 mb-0 fs-16">Are you sure you want to delete <strong>@SelectedYear?.FiscalYearName</strong>?</p>
                    <div class="modal-footer-btn mt-3 d-flex justify-content-center">
                        <button type="button" class="btn me-2 btn-outline-secondary fs-13 fw-medium p-2 px-3 shadow-none" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button type="submit" class="btn btn-danger fs-13 fw-medium p-2 px-3" @onclick="DeleteConfirmed"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
