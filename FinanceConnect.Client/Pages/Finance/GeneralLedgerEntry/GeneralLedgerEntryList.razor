@page "/general-ledger-entries"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MasterDataService MasterDataService
@inject ToastService ToastService

@if (!isInitialized)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
    }

    <div class="content List-view">
        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">General Ledger Entries</h4>
                    <h6>View posted GL entries - Read-only</h6>
                </div>
            </div>
            <ul class="table-top-head">
                <li><a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync"><i class="ti ti-refresh"></i></a></li>
            </ul>
        </div>

        <!-- SUMMARY CARDS -->
        <div class="row g-3 mb-4">

            <!-- Total Entries -->
            <div class="col-12 col-sm-6 col-md-3">
                <div class="card text-white h-100" style="background-color: #1E3A8A !important;">
                    <div class="card-body p-3 d-flex">
                        <div class="d-flex align-items-center flex-wrap justify-content-around w-100">
                            <i class="ti ti-file-text fs-1 me-3 opacity-75"></i>
                            <div>
                                <div class="fs-18 fw-bold">@FilteredItems?.Count</div>
                                <small class="fs-18">Total Entries</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Total Debit -->
            <div class="col-12 col-sm-6 col-md-3">
                <div class="card text-white h-100" style="background-color: #5B21B6 !important;">
                    <div class="card-body p-3 d-flex">
                        <div class="d-flex align-items-center flex-wrap justify-content-around w-100">
                            <i class="ti ti-arrow-up-right fs-1 me-3 opacity-75"></i>
                            <div>
                                <div class="fs-18 fw-bold">₹ @TotalDebit.ToString("N0")</div>
                                <small class="fs-18">Total Debit</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Total Credit -->
            <div class="col-12 col-sm-6 col-md-3">
                <div class="card bg-info text-white h-100" style="background-color: #0F766E !important;">
                    <div class="card-body p-3 d-flex">
                        <div class="d-flex align-items-center flex-wrap justify-content-around w-100">
                            <i class="ti ti-arrow-down-left fs-1 me-3 opacity-75"></i>
                            <div>
                                <div class="fs-18 fw-bold">₹ @TotalCredit.ToString("N0")</div>
                                <small class="fs-18">Total Credit</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Balance -->
            <div class="col-12 col-sm-6 col-md-3">
                <div class="card @(IsBalanced ? "bg-light" : "bg-danger text-white") h-100" style="background-color: #B91C1C !important;">
                    <div class="card-body p-3 d-flex">
                        <div class="d-flex align-items-center flex-wrap justify-content-around w-100">
                            <i class="ti ti-scale fs-1 me-3 @(IsBalanced ? "" : "opacity-75")"></i>
                            <div>
                                <div class="fs-14 fw-bold">
                                    @(IsBalanced ? "✓ Balanced" : "! Unbalanced")
                                </div>
                                <small class="fs-18 fw-bold">
                                    Diff: ₹ @Math.Abs(TotalDebit - TotalCredit).ToString("N2")
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>


        <!-- GL Entries List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search account, narration..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display:flex;flex-wrap:wrap;gap:8px;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width:220px" @bind="SelectedCompanyId">
                            <option value="">--All Companies--</option>
                            @foreach (var company in Entries.Select(e => new { e.CompanyId, e.CompanyCode, e.CompanyName }).DistinctBy(c => c.CompanyId).OrderBy(c => c.CompanyCode))
                            {
                                <option value="@company.CompanyId">@company.CompanyCode - @company.CompanyName</option>
                            }
                        </select>
                    </div>
                    <div>
                        <select class="form-select form-select-sm" style="min-width:220px" @bind="SelectedBranchId">
                            <option value="">--All Branches--</option>
                            @foreach (var branch in Entries.Select(e => new { e.BranchId, e.BranchCode, e.BranchName }).Where(b => !string.IsNullOrEmpty(b.BranchCode)).DistinctBy(b => b.BranchId).OrderBy(b => b.BranchCode))
                            {
                                <option value="@branch.BranchId">@branch.BranchCode - @branch.BranchName</option>
                            }
                        </select>
                    </div>
                    <div>
                        <select class="form-select form-select-sm" style="min-width:130px" @bind="SelectedPeriodId">
                            <option value="">--All Periods--</option>
                            @foreach (var period in Entries.Select(e => new { e.AccountingPeriodId, e.AccountingPeriodCode }).Where(p => !string.IsNullOrEmpty(p.AccountingPeriodCode)).DistinctBy(p => p.AccountingPeriodId).OrderBy(p => p.AccountingPeriodCode))
                            {
                                <option value="@period.AccountingPeriodId">@period.AccountingPeriodCode</option>
                            }
                        </select>
                    </div>
                    <div>
                        <select class="form-select form-select-sm" style="min-width:150px" @bind="SelectedSourceType">
                            <option value="">--All Sources--</option>
                            @foreach (var type in Entries.Select(e => e.SourceType).Where(t => !string.IsNullOrEmpty(t)).Distinct().OrderBy(t => t))
                            {
                                <option value="@type">@GLSourceTypes.GetDisplayName(type)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100" style="table-layout:fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th style="width:8%">Seq#</th>
                                <th class="d-none d-xl-table-cell" style="width:10%">Posting Date</th>
                                <th class="d-none d-md-table-cell" style="width:13%">Account</th>
                                <th class="d-none d-xl-table-cell" style="width:6%">Branch</th>
                                <th class="text-end d-none d-xl-table-cell" style="width:10%">Debit</th>
                                <th class="text-end d-none d-xl-table-cell" style="width:10%">Credit</th>
                                <th class="d-none d-xl-table-cell" style="width:5%">Source</th>
                                <th style="width:14%">Doc No</th>
                                <th class="no-sort" style="width:7%;padding-right:15px">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedItems.Any())
                            {
                                @foreach (var item in PagedItems)
                                {
                                    <tr>
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(item)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td style="white-space:nowrap">
                                            <span class="fw-medium">
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a @onclick="() => ViewItem(item)" class="text-decoration-none link-View"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title="@item.PostingSequenceNumber details">
                                                    @item.PostingSequenceNumber
                                                </a>
                                            </span>
                                        </td>
                                        <td class="d-none d-xl-table-cell" style="white-space:nowrap">@item.PostingDate.ToString("dd MMM yyyy")</td>
                                        <td class="d-none d-md-table-cell" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                            <span class="fw-medium">@item.AccountCode</span>
                                            <small class="d-block text-muted" style="text-overflow:ellipsis;white-space:nowrap">@item.AccountName</small>
                                        </td>
                                        <td class="d-none d-xl-table-cell">
                                            <span class="badge bg-info-transparent text-info">@(item.BranchCode ?? "-")</span>
                                        </td>
                                        <td class="text-end d-none d-xl-table-cell" style="white-space:nowrap">
                                            @if (item.DebitAmount > 0)
                                            {
                                                <span class="text-success fw-medium">
                                                    @IndianNumberFormatter.Format(@item.DebitAmount)
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    @IndianNumberFormatter.Format(@item.DebitAmount)
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end d-none d-xl-table-cell" style="white-space:nowrap">
                                            @if (item.CreditAmount > 0)
                                            {
                                                <span class="text-info fw-medium">
                                                    @IndianNumberFormatter.Format(@item.CreditAmount)
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    @IndianNumberFormatter.Format(@item.CreditAmount)
                                                </span>
                                            }
                                        </td>
                                        <td class="d-none d-xl-table-cell">
                                            <span class="badge @GetSourceTypeBadge(item.SourceType)"
                                                  data-bs-toggle="tooltip"
                                                  data-bs-placement="top"
                                                  title="@GLSourceTypes.GetDisplayName(item.SourceType)">

                                                <i class="@GetSourceTypeIcon(item.SourceType)"></i>
                                            </span>
                                        </td>

                                        <td style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><small>@(item.SourceDocumentNumber ?? "-")</small></td>
                                        <td class="action-table-data" style="padding-right:15px">
                                            <div class="edit-delete-action">
                                                <a class="me-2 view-icon p-1" href="javascript:void(0);" title="View"
                                                   @onclick="() => ViewItem(item)">
                                                    <i data-feather="eye"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center text-muted py-4">
                                        No GL entries found
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center p-3" id="RowsPerPageContent">
                        <div class="d-flex align-items-center">
                            <span class="me-2">Rows per page</span>
                            <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected="@(PageSize == 10)">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = StartPage; i <= EndPage; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

}




<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">General Ledger Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>

            <div class="modal-body">

                <div class="mb-2 d-flex gap-3">
                    <strong>Posting Date:</strong>
                    <div>@(SelectedCompany?.PostingDate != null ? SelectedCompany.PostingDate.ToString("dd MMM yyyy") : "-")</div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Branch:</strong>
                    <div>@(SelectedCompany?.BranchCode ?? "-")</div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Debit:</strong>
                    <div>
                        @if (SelectedCompany != null)
                        {
                            if (SelectedCompany.DebitAmount > 0)
                            {
                                <span class="text-success fw-medium">@SelectedCompany.DebitAmount.ToString("N2")</span>
                            }
                            else
                            {
                                <span>@SelectedCompany.DebitAmount.ToString("N2")</span>
                            }
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Credit:</strong>
                    <div>
                        @if (SelectedCompany != null)
                        {
                            if (SelectedCompany.CreditAmount > 0)
                            {
                                <span class="text-info fw-medium">@SelectedCompany.CreditAmount.ToString("N2")</span>
                            }
                            else
                            {
                                <span>@SelectedCompany.CreditAmount.ToString("N2")</span>
                            }
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Account:</strong>
                    <div>
                        <span class="fw-medium">@(SelectedCompany?.AccountCode ?? "-")</span>
                        <small class="d-block text-muted">@(SelectedCompany?.AccountName ?? "-")</small>
                    </div>
                </div>

                <div class="mb-2 gap-3 d-md-none">
                    <strong>Source:</strong>
                    <span class="badge @(SelectedCompany != null ? GetSourceTypeBadge(SelectedCompany.SourceType) : "")">
                        @(SelectedCompany != null ? GLSourceTypes.GetDisplayName(SelectedCompany.SourceType) : "-")
                    </span>
                </div>

            </div>


        </div>
    </div>
</div>

