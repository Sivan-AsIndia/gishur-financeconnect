@page "/general-ledger-entries/{EntryId:guid}/view"
@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services
@inject MasterDataService MasterDataService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="content view-screen py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-1">General Ledger Entries Details</h4>
            <p class="text-muted mb-0 small">Track ledger transactions and balances</p>
        </div>
        <a class="btn btn-outline-secondary" @onclick="GoBack">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
    @if (SelectedEntry != null)
    {
        <div class="row g-3">
            <!-- TOP PANEL : ENTRY HEADER -->
            <div class="col-lg-12">
                <div class="card mb-0">
                    <div class="header-card">
                        <div class="header-inner">
                            <div class="header-left1">
                                <div class="company-logo">
                                    <span class="logo-initials"><i class="ti ti-file-text" style="font-size:24px"></i></span>
                                </div>

                                <div class="header-meta">
                                    <h2 class="company-title">GL Entry #@SelectedEntry.PostingSequenceNumber</h2>
                                    <div class="company-subtitle">
                                        <span>@SelectedEntry.CompanyName</span>
                                        <span class="dot">·</span>
                                        <span>@SelectedEntry.BranchName</span>
                                        <span class="dot">·</span>
                                        <span>@SelectedEntry.PostingDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                    <div class="header-tags">
                                        <span class="tag @GetSourceTypeBadge(SelectedEntry.SourceType)">
                                            @GLSourceTypes.GetDisplayName(SelectedEntry.SourceType)
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(SelectedEntry.BaseCurrencyCode))
                                        {
                                            <span class="tag tag-default" style="border: 1px solid #0081ff; background: #e9f3ff; color: #1420ff;">
                                                @SelectedEntry.BaseCurrencyCode
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="header-right">
                                @if (SelectedEntry.IsReversal)
                                {
                                    <span class="status-badge status-draft">● REVERSAL</span>
                                }
                                else
                                {
                                    <span class="status-badge status-active">● POSTED</span>
                                }
                                <div class="created-info">Created @SelectedEntry.CreatedAt.ToString("dd MMM yyyy")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- LEFT PANEL : ENTRY DETAILS -->
            <div class="col-lg-8">
                <div class="profile-card">
                    @* <h5 class="mb-3">
                        <i class="ti ti-file-text me-2" style="color: #fe9f43;"></i>GL Entry Details
                    </h5> *@

                    <!-- Entry Identity -->
                    <div class="card mb-3">
                        <div class="card-header py-2">
                            <i class="ti ti-id me-2"></i> Entry Identity
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-3">
                                    <small class="text-muted">Sequence No</small>
                                    <div class="fw-medium">@SelectedEntry.PostingSequenceNumber</div>
                                </div>
                                <div class="col-md-3">
                                    <small class="text-muted">Posting Date</small>
                                    <div>@SelectedEntry.PostingDate.ToString("dd MMM yyyy")</div>
                                </div>
                                <div class="col-md-3">
                                    <small class="text-muted">Entry Date</small>
                                    <div>@SelectedEntry.EntryDate.ToString("dd MMM yyyy")</div>
                                </div>
                                <div class="col-md-3">
                                    <small class="text-muted">Period</small>
                                    <div>@(SelectedEntry.AccountingPeriodName ?? "-")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Context -->
                    <div class="card mb-3">
                        <div class="card-header py-2">
                            <i class="ti ti-building me-2"></i> Context
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-4">
                                    <small class="text-muted">Company</small>
                                    <div>@SelectedEntry.CompanyName</div>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted">Branch</small>
                                    <div>@SelectedEntry.BranchName</div>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted">Ledger</small>
                                    <div>@SelectedEntry.LedgerName</div>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted">Account</small>
                                    <div class="fw-medium">@SelectedEntry.AccountCode - @SelectedEntry.AccountName</div>
                                </div>
                                <div class="col-md-3">
                                    <small class="text-muted">Currency</small>
                                    <div>@SelectedEntry.BaseCurrencyCode</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Source Traceability -->
                    <div class="card mb-0">
                        <div class="card-header py-2">
                            <i class="ti ti-link me-2"></i> Source Traceability
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-3">
                                    <small class="text-muted">Source Type</small>
                                    <div>
                                        <span class="badge @GetSourceTypeBadge(SelectedEntry.SourceType)">
                                            @GLSourceTypes.GetDisplayName(SelectedEntry.SourceType)
                                        </span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <small class="text-muted">Document No</small>
                                    <div>@(SelectedEntry.SourceDocumentNumber ?? "-")</div>
                                </div>
                                <div class="col-md-3">
                                    <small class="text-muted">Journal No</small>
                                    <div>@(SelectedEntry.JournalEntryNumber ?? "-")</div>
                                </div>
                                <div class="col-md-3">
                                    <small class="text-muted">External Ref</small>
                                    <div>@(SelectedEntry.ExternalReferenceNumber ?? "-")</div>
                                </div>
                                <div class="col-12">
                                    <small class="text-muted">Narration</small>
                                    <div class="ql-rendered">@((MarkupString)(SelectedEntry.Narration ?? string.Empty))</div>
                                </div>
                                <div class="col-12">
                                    <small class="text-muted">Line Narration</small>
                                    <div class="ql-rendered">@((MarkupString)(SelectedEntry.LineNarration ?? string.Empty))</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT PANEL : AMOUNTS & AUDIT -->
            <div class="col-lg-4">
                <div class="profile-card mb-3">
                    <!-- Amounts -->
                    <div class="card mb-0">
                        <div class="card-header py-2">
                            <i class="ti ti-calculator me-2"></i> Amounts
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-12 mb-2">
                                    <div class="p-3 bg-success-transparent rounded text-center">
                                        <small class="text-muted">Debit</small>
                                        <div class="fs-15 fw-bold text-success">₹ @SelectedEntry.DebitAmount.ToString("N2")</div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="p-3 bg-info-transparent rounded text-center">
                                        <small class="text-muted">Credit</small>
                                        <div class="fs-15 fw-bold text-info">₹ @SelectedEntry.CreditAmount.ToString("N2")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (SelectedEntry.IsReversal)
                {
                    <div class="alert alert-warning mb-3">
                        <i class="ti ti-arrow-back-up me-2"></i>This is a reversal entry.
                    </div>
                }

                <div class="profile-card">
                    <!-- Snapshot -->
                    <div class="card mb-0">
                        <div class="card-header py-2">
                            <i class="ti ti-history me-2"></i> Snapshot
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-12">
                                    <small class="text-muted">Account Code</small>
                                    <div>@(SelectedEntry.AccountCodeSnapshot ?? "-")</div>
                                </div>
                                <div class="col-12">
                                    <small class="text-muted">Account Name</small>
                                    <div>@(SelectedEntry.AccountNameSnapshot ?? "-")</div>
                                </div>
                                <div class="col-12">
                                    <small class="text-muted">Branch Code</small>
                                    <div>@(SelectedEntry.BranchCodeSnapshot ?? "-")</div>
                                </div>
                                <div class="col-12">
                                    <small class="text-muted">Created At</small>
                                    <div>@SelectedEntry.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                                </div>
                                <div class="col-12">
                                    <small class="text-muted">Created By</small>
                                    <div>@(SelectedEntry.CreatedBy ?? "-")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="ti ti-alert-circle fs-1 text-muted"></i>
            <p class="text-muted mt-2">Entry not found</p>
            <button class="btn btn-secondary" @onclick="GoBack">
                <i class="ti ti-arrow-left me-1"></i> Back to List
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid EntryId { get; set; }

    private GeneralLedgerEntryModel? SelectedEntry;

    protected override void OnInitialized()
    {
        var entries = MasterDataService.GetAllGeneralLedgerEntries();
        SelectedEntry = entries.FirstOrDefault(e => e.Id == EntryId);
    }

    private void GoBack()
    {
        Nav.NavigateTo("/general-ledger-entries");
    }

    private string GetSourceTypeBadge(string sourceType)
    {
        return sourceType switch
        {
            GLSourceTypes.JournalEntry => "bg-primary-transparent text-primary",
            GLSourceTypes.OpeningBalance => "bg-info-transparent text-info",
            GLSourceTypes.VendorBill => "bg-warning-transparent text-warning",
            GLSourceTypes.VendorPayment => "bg-success-transparent text-success",
            GLSourceTypes.CustomerInvoice => "bg-purple-transparent text-purple",
            GLSourceTypes.CustomerReceipt => "bg-success-transparent text-success",
            GLSourceTypes.BankTransaction => "bg-cyan-transparent text-cyan",
            GLSourceTypes.AssetTransaction => "bg-secondary-transparent text-secondary",
            GLSourceTypes.SystemAdjustment => "bg-dark-transparent text-dark",
            _ => "bg-secondary-transparent text-secondary"
        };
    }
}
