@page "/ledgers/create"
@page "/ledgers/{Id:guid}"
@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels

<style>
    .form-select option:checked {
        color: white;
        background-color: var(--primary);
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }

    .form-select.is-invalid {
        border-color: #dc3545;
    }

    .field-validation-error {
        color: #dc3545;
        font-size: 12px;
        display: block;
        margin-top: 4px;
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else
{
    <div class="content Accordion-form">

        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">@PageTitle</h4>
                    <h6>@PageSubTitle</h6>
                </div>
            </div>

            <div class="page-btn mt-0">
                <button type="button" class="btn btn-outline-secondary" @onclick="GoBackToList">
                    <i class="ti ti-arrow-left"></i> Back
                </button>
            </div>
        </div>

        <EditForm EditContext="_editContext" OnSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="add-product" style="background:#f4f7fb; padding:24px 14px;">
                <div class="tl-accordion">

                    @* ══════ LEFT PANEL – Fixed sidebar ══════ *@
                    <div class="tl-left-panel">

                        <div class="tl-label @(ShowIdentity ? "active accent-orange" : "")"
                             @onclick="@(() => ToggleAccordion("ledgerIdentity"))">
                            <div class="tl-label-icon ico-orange"><i data-feather="book"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Ledger Identity</div>
                                <div class="tl-label-sub">Basic ledger information</div>
                            </div>
                            <span class="tl-label-chevron @(ShowIdentity ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowCurrency ? "active accent-blue" : "")"
                             @onclick="@(() => ToggleAccordion("typeCurrency"))">
                            <div class="tl-label-icon ico-blue"><i data-feather="dollar-sign"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Type & Currency Rules</div>
                                <div class="tl-label-sub">Ledger type and currency settings</div>
                            </div>
                            <span class="tl-label-chevron @(ShowCurrency ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowPosting ? "active accent-purple" : "")"
                             @onclick="@(() => ToggleAccordion("postingControls"))">
                            <div class="tl-label-icon ico-purple"><i data-feather="lock"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Posting Controls</div>
                                <div class="tl-label-sub">Posting dates & lock period</div>
                            </div>
                            <span class="tl-label-chevron @(ShowPosting ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                        <div class="tl-label @(ShowStatus ? "active accent-teal" : "")"
                             @onclick="@(() => ToggleAccordion("statusGovernance"))">
                            <div class="tl-label-icon ico-teal"><i data-feather="check-circle"></i></div>
                            <div class="tl-label-text">
                                <div class="tl-label-title">Status & Governance</div>
                                <div class="tl-label-sub">Status and consolidation settings</div>
                            </div>
                            <span class="tl-label-chevron @(ShowStatus ? "open" : "")">
                                <i data-feather="chevron-right"></i>
                            </span>
                        </div>

                    </div>

                    @* ══════ RIGHT AREA – Timeline dots + Expanding Cards ══════ *@
                    <div class="tl-right-area">

                        @* ── 1. Ledger Identity ── *@
                        <div class="tl-card-row @(ShowIdentity ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("ledgerIdentity"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowIdentity ? "card-active border-orange" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("ledgerIdentity"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-orange">01</span>
                                            Ledger Identity
                                        </div>
                                        <span class="tl-card-toggle @(ShowIdentity ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>
                                    <div class="tl-collapse @(ShowIdentity ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(IdentityTouched ? "touched" : "")">
                                                <div class="row">

                                                    <div class="col-sm-6 col-md-3 mb-3">
                                                        <label class="form-label">Ledger Code <span class="text-danger ms-1">*</span></label>
                                                        <input class="form-control text-uppercase @(LedgerCodeValidationError != null ? "is-invalid" : "")"
                                                               @bind="LedgerCodeValue"
                                                               @bind:event="oninput"
                                                               @bind:after="OnLedgerCodeChanged"
                                                               disabled="@(IsEdit && !CanEdit)"
                                                               placeholder="e.g., PRIM" maxlength="15" />
                                                        @if (LedgerCodeValidationError != null)
                                                        {
                                                            <span class="field-validation-error">@LedgerCodeValidationError</span>
                                                        }
                                                    </div>

                                                    <div class="col-sm-6 col-md-5 mb-3">
                                                        <label class="form-label">Ledger Name <span class="text-danger ms-1">*</span></label>
                                                        <input class="form-control @(LedgerNameValidationError != null ? "is-invalid" : "")"
                                                               @bind="Ledger.LedgerName"
                                                               @bind:event="oninput"
                                                               @bind:after="OnLedgerNameChanged"
                                                               @onblur="OnLedgerNameChangedTrim"
                                                               placeholder="e.g., Primary Ledger" maxlength="200" />
                                                        @if (LedgerNameValidationError != null)
                                                        {
                                                            <span class="field-validation-error">@LedgerNameValidationError</span>
                                                        }
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Company <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select @(CompanyValidationError != null ? "is-invalid" : "")"
                                                                @bind="SelectedCompanyId"
                                                                @bind:after="OnCompanyChanged"
                                                                disabled="@(IsEdit && !CanEdit)">
                                                            <option value="">--Select Company--</option>
                                                            @foreach (var company in Companies)
                                                            {
                                                                <option value="@company.Id">@company.CompanyCode - @company.LegalName</option>
                                                            }
                                                        </select>
                                                        @if (CompanyValidationError != null)
                                                        {
                                                            <span class="field-validation-error">@CompanyValidationError</span>
                                                        }
                                                    </div>

                                                    <div class="col-12 mb-3">
                                                        <label class="form-label">Description</label>
                                                        <RichTextEditor @ref="_descriptionEditor"
                                                                        Value="@Ledger.Description"
                                                                        Placeholder="Purpose of this ledger..."
                                                                        MinHeight="80"
                                                                        MaxHeight="200" />
                                                    </div>

                                                    <div class="col-sm-6 d-flex align-items-center">
                                                        <div class="form-check form-switch mt-3">
                                                            <input class="form-check-input"
                                                                   type="checkbox"
                                                                   @bind="Ledger.IsDefaultLedger"
                                                                   id="isDefault"
                                                                   @oninput="TouchIdentity" />
                                                            <label class="form-check-label" for="isDefault">
                                                                Default Ledger
                                                            </label>
                                                        </div>
                                                        <small class="text-muted ms-2 mt-3">(Only one default per company)</small>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* ── 2. Type & Currency Rules ── *@
                        <div class="tl-card-row @(ShowCurrency ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("typeCurrency"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowCurrency ? "card-active border-blue" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("typeCurrency"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-blue">02</span>
                                            Type & Currency Rules
                                        </div>
                                        <span class="tl-card-toggle @(ShowCurrency ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>
                                    <div class="tl-collapse @(ShowCurrency ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(CurrencyTouched ? "touched" : "")">
                                                <div class="row">

                                                    <div class="col-sm-6 col-md-3 mb-3">
                                                        <label class="form-label">Ledger Type <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select @(LedgerTypeValidationError != null ? "is-invalid" : "")"
                                                                @bind="SelectedLedgerType"
                                                                @bind:after="OnLedgerTypeChanged"
                                                                disabled="@(IsEdit && !CanEdit)">
                                                            <option value="">--Select Ledger Type--</option>
                                                            @foreach (var type in LedgerTypes.All)
                                                            {
                                                                <option value="@type">@LedgerTypes.GetDisplayName(type)</option>
                                                            }
                                                        </select>
                                                        @if (LedgerTypeValidationError != null)
                                                        {
                                                            <span class="field-validation-error">@LedgerTypeValidationError</span>
                                                        }
                                                    </div>

                                                    <div class="col-sm-6 col-md-3 mb-3">
                                                        <label class="form-label">Base Currency <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select @(BaseCurrencyValidationError != null ? "is-invalid" : "")"
                                                                @bind="SelectedBaseCurrencyId"
                                                                @bind:after="OnBaseCurrencyChanged"
                                                                disabled="@(IsEdit && !CanEdit)">
                                                            <option value="">--Select Base Currency--</option>
                                                            @foreach (var currency in Currencies)
                                                            {
                                                                <option value="@currency.Id">@currency.CurrencyCode - @currency.CurrencyName</option>
                                                            }
                                                        </select>
                                                        @if (BaseCurrencyValidationError != null)
                                                        {
                                                            <span class="field-validation-error">@BaseCurrencyValidationError</span>
                                                        }
                                                    </div>

                                                    <div class="col-sm-6 col-md-3 mb-3">
                                                        <label class="form-label">Reporting Currency</label>
                                                        <select class="form-select"
                                                                @bind="ReportingCurrencyIdStr"
                                                                @oninput="TouchCurrency">
                                                            <option value="">--Select Reporting Currency--</option>
                                                            @foreach (var currency in Currencies)
                                                            {
                                                                <option value="@currency.Id">@currency.CurrencyCode - @currency.CurrencyName</option>
                                                            }
                                                        </select>
                                                    </div>

                                                    <div class="col-sm-6 col-md-3 mb-3">
                                                        <label class="form-label">Currency Mode <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select @(CurrencyModeValidationError != null ? "is-invalid" : "")"
                                                                @bind="SelectedCurrencyMode"
                                                                @bind:after="OnCurrencyModeChanged">
                                                            <option value="">--Select Currency Mode--</option>
                                                            @foreach (var mode in CurrencyModes.All)
                                                            {
                                                                <option value="@mode">@CurrencyModes.GetDisplayName(mode)</option>
                                                            }
                                                        </select>
                                                        @if (CurrencyModeValidationError != null)
                                                        {
                                                            <span class="field-validation-error">@CurrencyModeValidationError</span>
                                                        }
                                                    </div>

                                                    <div class="col-sm-6 col-md-3 mb-3">
                                                        <label class="form-label">Exchange Rate Source</label>
                                                        <select class="form-select"
                                                                @bind="Ledger.ExchangeRateSource"
                                                                @oninput="TouchCurrency">
                                                            <option value="">--Select Exchange Rate Source--</option>
                                                            @foreach (var source in ExchangeRateSources.All)
                                                            {
                                                                <option value="@source">@ExchangeRateSources.GetDisplayName(source)</option>
                                                            }
                                                        </select>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* ── 3. Posting Controls ── *@
                        <div class="tl-card-row @(ShowPosting ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("postingControls"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowPosting ? "card-active border-purple" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("postingControls"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-purple">03</span>
                                            Posting Controls
                                        </div>
                                        <span class="tl-card-toggle @(ShowPosting ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>
                                    <div class="tl-collapse @(ShowPosting ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(PostingTouched ? "touched" : "")">
                                                <div class="row">

                                                    <div class="col-sm-6 col-md-3 mb-3">
                                                        <label class="form-label">Allow Posting From</label>
                                                        <input type="date" class="form-control"
                                                               @bind="Ledger.AllowPostingFromDate"
                                                               @oninput="TouchPosting" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-3 mb-3">
                                                        <label class="form-label">Allow Posting To</label>
                                                        <input type="date" class="form-control"
                                                               @bind="Ledger.AllowPostingToDate"
                                                               @oninput="TouchPosting" />
                                                    </div>

                                                    <div class="col-sm-6 col-md-3 mb-3">
                                                        <label class="form-label">Backdated Days Allowed</label>
                                                        <select class="form-select"
                                                                @bind="Ledger.BackdatedPostingDaysAllowed"
                                                                @oninput="TouchPosting">
                                                            <option value="">--Select Backdated Days--</option>
                                                            <option value="0">0 (None)</option>
                                                            <option value="7">7 days</option>
                                                            <option value="15">15 days</option>
                                                            <option value="30">30 days</option>
                                                            <option value="60">60 days</option>
                                                            <option value="90">90 days</option>
                                                        </select>
                                                    </div>

                                                    <div class="col-sm-6 col-md-3 mb-3">
                                                        <label class="form-label">Future Days Allowed</label>
                                                        <select class="form-select"
                                                                @bind="Ledger.FuturePostingDaysAllowed"
                                                                @oninput="TouchPosting">
                                                            <option value="">--Select Future Days--</option>
                                                            <option value="0">0 (None)</option>
                                                            <option value="7">7 days</option>
                                                            <option value="15">15 days</option>
                                                            <option value="30">30 days</option>
                                                        </select>
                                                    </div>

                                                    <div class="col-sm-4 mt-4">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input"
                                                                   type="checkbox"
                                                                   @bind="Ledger.LockBackDatedPosting"
                                                                   id="lockBackdated"
                                                                   @oninput="TouchPosting" />
                                                            <label class="form-check-label" for="lockBackdated">
                                                                Lock Backdated Posting
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="col-sm-4 mt-4">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input"
                                                                   type="checkbox"
                                                                   @bind="Ledger.RequireApprovalBeforePosting"
                                                                   id="reqApproval"
                                                                   @oninput="TouchPosting" />
                                                            <label class="form-check-label" for="reqApproval">
                                                                Require Approval Before Posting
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="col-sm-4 mt-4">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input"
                                                                   type="checkbox"
                                                                   @bind="Ledger.EnforceAccountingPeriodOpen"
                                                                   id="enforcePeriod"
                                                                   @oninput="TouchPosting" />
                                                            <label class="form-check-label" for="enforcePeriod">
                                                                Enforce Accounting Period Open
                                                            </label>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* ── 4. Status & Governance ── *@
                        <div class="tl-card-row @(ShowStatus ? "row-active" : "")">
                            <div class="tl-dot-col">
                                <div class="tl-dot" @onclick="@(() => ToggleAccordion("statusGovernance"))"></div>
                            </div>
                            <div class="tl-card-col">
                                <div class="tl-card @(ShowStatus ? "card-active border-teal" : "")">
                                    <div class="tl-card-header" @onclick="@(() => ToggleAccordion("statusGovernance"))">
                                        <div class="tl-card-header-title">
                                            <span class="tl-card-step step-teal">04</span>
                                            Status & Governance
                                        </div>
                                        <span class="tl-card-toggle @(ShowStatus ? "toggle-open" : "")">
                                            <i data-feather="chevron-down"></i>
                                        </span>
                                    </div>
                                    <div class="tl-collapse @(ShowStatus ? "tl-open" : "")">
                                        <div class="tl-card-body">
                                            <div class="tl-card-body-inner @(StatusTouched ? "touched" : "")">
                                                <div class="row">

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Status <span class="text-danger ms-1">*</span></label>
                                                        <select class="form-select @(StatusValidationError != null ? "is-invalid" : "")"
                                                                @bind="SelectedStatus"
                                                                @bind:after="OnStatusChanged">
                                                            <option value="">--Select Status--</option>
                                                            @foreach (var status in LedgerStatus.All)
                                                            {
                                                                <option value="@status">@status</option>
                                                            }
                                                        </select>
                                                        @if (StatusValidationError != null)
                                                        {
                                                            <span class="field-validation-error">@StatusValidationError</span>
                                                        }
                                                    </div>

                                                    @if (IsEdit)
                                                    {
                                                        <div class="col-sm-6 col-md-4 mb-3">
                                                            <label class="form-label">Lock Status</label>
                                                            <input type="text" class="form-control bg-light" value="@Ledger.LockStatus" readonly />
                                                        </div>
                                                    }

                                                    <div class="col-sm-4 mt-4">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input"
                                                                   type="checkbox"
                                                                   @bind="Ledger.IsConsolidationEligible"
                                                                   id="consEligible"
                                                                   @oninput="TouchStatus" />
                                                            <label class="form-check-label" for="consEligible">
                                                                Consolidation Eligible
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="col-sm-6 col-md-4 mb-3">
                                                        <label class="form-label">Consolidation Group</label>
                                                        <input type="text" class="form-control"
                                                               @bind="Ledger.ConsolidationGroupName"
                                                               placeholder="e.g., Group A"
                                                               maxlength="200"
                                                               @oninput="TouchStatus" />
                                                    </div>

                                                    <div class="col-12 mb-3">
                                                        <label class="form-label">Lock / Inactivation Reason @if (Ledger.Status == LedgerStatus.Inactive || Ledger.LockStatus != LockStatuses.Unlocked) { <span class="text-danger ms-1">*</span> }</label>
                                                        <RichTextEditor @ref="_lockReasonEditor"
                                                                        Value="@Ledger.LockReason"
                                                                        Placeholder="Reason for locking or inactivating this ledger..."
                                                                        MinHeight="60"
                                                                        MaxHeight="160" />
                                                        @if (LockReasonValidationError != null)
                                                        {
                                                            <span class="field-validation-error">@LockReasonValidationError</span>
                                                        }
                                                    </div>

                                                </div>

                                                @if (IsEdit && !CanEdit)
                                                {
                                                    <div class="alert alert-warning mb-0 mt-3">
                                                        <i class="ti ti-alert-triangle me-2"></i>
                                                        <strong>Read-only:</strong> This ledger has postings and core fields cannot be modified.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            <div class="page-btn d-flex justify-content-end gap-2 mb-3">
                <button type="button" class="btn btn-outline-secondary" @onclick="GoBackToList">
                    <i class="ti ti-x"></i> Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy"></i> @(IsEdit ? "Update" : "Save")
                </button>
            </div>

        </EditForm>

    </div>
}

<!-- Global Confirmation Modal -->
<div class="modal fade" id="confirm-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">

                    <span class="rounded-circle d-inline-flex p-2
                        @(ConfirmType == "danger" ? "bg-danger-transparent" : "bg-warning-transparent")
                        mb-2">
                        <i class="ti
                            @(ConfirmType == "danger" ? "ti-trash text-danger" : "ti-alert-circle text-warning")
                            fs-24"></i>
                    </span>

                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">
                        @ConfirmTitle
                    </h4>

                    <p class="text-gray-6 mb-0 fs-16">
                        @ConfirmMessage
                    </p>

                    <div class="modal-footer-btn mt-3 d-flex justify-content-center" style="column-gap: 20px">

                        <button type="button"
                                class="btn btn-secondary fs-13 fw-medium p-2 px-3 shadow-none"
                                data-bs-dismiss="modal">
                            <i class="ti ti-x me-1"></i>Cancel
                        </button>

                        @if (ConfirmAction != null)
                        {
                            <button type="button"
                                    class="btn btn-primary fs-13 fw-medium p-2 px-3"
                                    @onclick="ConfirmYes">
                                <i class="ti ti-check me-1"></i>Yes, Continue
                            </button>
                        }

                    </div>


                </div>
            </div>
        </div>
    </div>
</div>
