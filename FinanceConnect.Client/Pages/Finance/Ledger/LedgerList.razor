@page "/ledgers"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MasterDataService MasterDataService
@inject ToastService ToastService

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Ledger List</h4>
                    <h6>Manage ledgers</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/ledgers/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Ledger List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search ledgers..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display:flex;flex-wrap:wrap;gap:10px">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 180px" @bind="SelectedCompanyId">
                            <option value="">All Companies</option>
                            @foreach (var company in Companies)
                            {
                                <option value="@company.Id">@company.Code - @company.Name</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedType">
                            <option value="">All Types</option>
                            @foreach (var type in DistinctTypes)
                            {
                                <option value="@type">@LedgerTypes.GetDisplayName(type)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-0">
                        <select class="form-select form-select-sm" style="min-width: 120px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in DistinctStatuses)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>

                                <th>Code</th>
                                <th class="d-none d-md-table-cell">Name</th>
                                <th class="d-none d-md-table-cell">Company</th>
                                <th class="d-none d-xxl-table-cell">Type</th>
                                <th class="d-none d-md-table-cell">Status</th>
                                <th class="no-sort">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedLedgers.Any())
                            {
                                @foreach (var ledger in PagedLedgers)
                                {
                                    <tr>
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(ledger)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td>
                                            <span class="fw-medium">
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a @onclick="async () => await ViewLedger(ledger)" class="text-decoration-none link-View"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title="@ledger.LedgerCode details">
                                                    @ledger.LedgerCode
                                                </a>
                                            </span>
                                        </td>
                                        <td class="d-none d-md-table-cell">
                                            <div class="d-flex flex-column gap-1">
                                                <span>@ledger.LedgerName</span>
                                                <span title="DefaultLedger">
                                                    @if (ledger.IsDefaultLedger)
                                                    {
                                                        <span class="badge bg-success-transparent text-success">Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-transparent text-secondary">No</span>
                                                    }
                                                </span>
                                            </div>
                                           
                                        </td>
                                        <td class="d-none d-md-table-cell">@(ledger.CompanyCode ?? "-")</td>
                                        <td class="d-none d-xxl-table-cell" style="text-overflow:inherit">
                                            <span class="badge @GetLedgerTypeBadge(ledger.LedgerType)">
                                                @LedgerTypes.GetDisplayName(ledger.LedgerType)
                                            </span>
                                        </td>

                                        <td class="d-none d-md-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @GetStatusDotBadge(ledger.Status)">
                                                </div>
                                                <span>@ledger.Status</span>
                                            </div>
                                        </td>

                                        <td class="action-table-data">
                                            <div class="edit-delete-action">
                                                <a class="me-2 edit-icon p-1" href="/ledgers/@ledger.Id" title="Edit">
                                                    <i data-feather="edit"></i>
                                                </a>
                                                @if (ledger.Status == "Active")
                                                {
                                                    <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon" href="javascript:void(0);"
                                                       title="Deactivate" data-bs-toggle="modal" data-bs-target="#deactivate-modal"
                                                       @onclick="() => ConfirmDeactivate(ledger)">
                                                        <i class="ti ti-toggle-right"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Activate" data-bs-toggle="modal" data-bs-target="#activate-modal"
                                                       @onclick="() => ConfirmActivate(ledger)">
                                                        <i class="ti ti-toggle-left"></i>
                                                    </a>
                                                }
                                                <a class="p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                                   data-bs-toggle="modal" data-bs-target="#delete-modal"
                                                   @onclick="() => ConfirmDelete(ledger)">
                                                    <i data-feather="trash-2"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center text-muted py-4">
                                        No ledgers found
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center p-3" id="RowsPerPageContent">
                        <div class="d-flex align-items-center">
                            <span class="me-2">Rows per page</span>
                            <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = StartPage; i <= EndPage; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>





        <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Ledger Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                style="padding:0; right:22px; position:absolute;transform:none"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-2 d-flex gap-3">
                            <strong>Name:</strong>
                            <div>@(SelectedCompany?.LedgerName ?? "-")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Currency:</strong>
                            <div>@(SelectedCompany?.BaseCurrencyCode ?? "-")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Company:</strong>
                            <div>@(SelectedCompany?.CompanyCode ?? "-")</div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>IsDefault:</strong>
                            <div>
                                @if (SelectedCompany?.IsDefaultLedger == true)
                                {
                                    <span class="badge bg-success-transparent text-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-transparent text-secondary">No</span>
                                }

                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Type:</strong>
                        <div>
                            <span class="badge @(SelectedCompany != null ? GetLedgerTypeBadge(SelectedCompany.LedgerType) : "")">
                                @(SelectedCompany != null
                                                                ? LedgerTypes.GetDisplayName(SelectedCompany.LedgerType)
                                                                : "-")
                                </span>
                            </div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Status:</strong>
                            <div>
                                <span class="badge @(SelectedCompany != null ? GetStatusBadge(SelectedCompany.Status) : "")">
                                    @(SelectedCompany?.Status ?? "-")
                                </span>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Activate Modal -->
        <div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-toggle-right fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Ledger</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to activate <strong>@SelectedLedger?.LedgerName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-check me-1"></i>Yes, Activate</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deactivate Modal -->
        <div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                                <i class="ti ti-toggle-left fs-24 text-warning"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate Ledger</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDeactivate)
                                {
                                    <span class="text-danger">Cannot deactivate! Ledger has active GL entries.</span>
                                }
                                else
                                {
                                    <span>Do you want to deactivate <strong>@SelectedLedger?.LedgerName</strong>?</span>
                                }
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDeactivate)
                                {
                                    <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-left me-1"></i>Yes, Deactivate</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                <i class="ti ti-trash fs-24 text-danger"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Ledger</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDelete)
                                {
                                    <span class="text-danger">Cannot delete! Ledger has active GL entries.</span>
                                }
                                else
                                {
                                    <span>Are you sure you want to delete<strong>@SelectedLedger?.LedgerName</strong>?</span>
                                }
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDelete)
                                {
                                    <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteConfirmed" data-bs-dismiss="modal"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

}
