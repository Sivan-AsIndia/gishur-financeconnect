@page "/journals"
@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject JournalService JournalService
@inject ToastService ToastService
<style>
    .form-select option:checked {
        color: #fff;
        background: #FE9F43;
    }

    .form-select:focus {
        border-color: #FE9F43;
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }
</style>


@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Journal List</h4>
                    <h6>Manage accounting journals</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/journals/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Journal List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

                <!-- Search -->
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset">
                            <i class="ti ti-search fs-14"></i>
                        </span>
                        <input type="search"
                        class="form-control form-control-sm"
                        placeholder="Search journal"
                        @bind="searchText"
                        @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display:flex">

                    <!-- Company Filter -->
                    <div>
                        <select class="form-select form-select-sm"
                        style="min-width:180px"
                        @bind="SelectedCompanyId">
                            <option value="">All Companies</option>
                            @foreach (var c in Companies)
                            {
                                <option value="@c.Id">@c.LegalName</option>
                            }
                        </select>
                    </div>

                    <!-- Status Filter -->
                    <div class="ms-2">
                        <select class="form-select form-select-sm"
                        style="min-width:140px"
                        @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in Enum.GetValues<JournalStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <div>
                        <table class="table align-middle w-100 table-fixed">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xl-none" style="width:40px"></th>
                                    <th style="width:130px">Code</th>
                                    <th class="d-none d-md-table-cell">Journal Name</th>
                                    <th class="d-none d-md-table-cell">Type</th>
                                    <th class="d-none d-xl-table-cell" title="Require Approval">Require Approval</th>
                                    <th class="d-none d-xxl-table-cell">Status</th>
                                    <th class="no-sort" style="width: 135px;">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedJournals.Any())
                                {
                                    @foreach (var j in PagedJournals)
                                    {

                                        <tr>
                                            <!-- PLUS ICON -->
                                            <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                data-bs-toggle="modal"
                                                data-bs-target="#rowDetailsModal"
                                                @onclick="() => OpenRowModal(j)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td>
                                                <span class="fw-medium" data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="@j.JournalCode details">
                                                    <span class="PopupIcon">⧉</span>
                                                    <a @onclick="async () => await ViewJournal(j)" class="text-decoration-none link-View"
                                                    href="javascript:void(0);">
                                                        @j.JournalCode
                                                    </a>
                                                </span>
                                            </td>

                                            <td class="d-none d-md-table-cell">
                                                <div class="d-flex flex-column gap-1">
                                                    <span>@j.JournalName</span>
                                                    <span title="Reset Numbering">
                                                        @if (j.RequireApprovalBeforePosting == true)
                                                        {
                                                            <span class="badge bg-info-transparent text-info">Yes</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary-transparent text-secondary">No</span>
                                                        }
                                                    </span>
                                                </div>

                                            </td>
                                            <td class="d-none d-md-table-cell">@j.JournalType</td>

                                            <td class="d-none d-xl-table-cell">
                                                @(string.IsNullOrWhiteSpace(j.ResetNumbering) ? "-" : j.ResetNumbering)
                                            </td>

                                            <td class="d-none d-xxl-table-cell">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="ActiveDot @GetStatusDotBadge(j.Status)">
                                                    </div>
                                                    <span> @j.Status</span>
                                                </div>
                                            </td>

                                            <td class="action-table-data">
                                                <div class="edit-delete-action">

                                                    <!-- View -->
                                                    <a class="me-2 view-icon p-1"
                                                    title="View"
                                                    href="javascript:void(0);"
                                                    @onclick="async () => await ViewJournal(j)">
                                                        <i data-feather="eye"></i>
                                                    </a>

                                                    <!-- Edit -->
                                                    @if (j.Status == JournalStatus.Draft)
                                                    {
                                                        <a class="me-2 edit-icon p-1" title="Edit"
                                                        @onclick='() => Nav.NavigateTo($"/journals/{j.Id}")'>
                                                            <i data-feather="edit"></i>
                                                        </a>
                                                    }

                                                    <!-- Activate / Deactivate -->
                                                    @if (j.Status == JournalStatus.Active)
                                                    {
                                                        <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon"
                                                        title="Deactivate"
                                                        @onclick="() => AskDeactivate(j)">
                                                            <i data-feather="toggle-left"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a class="me-2 Toggle-icon p-1 action-icon activate-icon"
                                                        title="Activate"
                                                        @onclick="() => AskActivate(j)">
                                                            <i data-feather="toggle-right"></i>
                                                        </a>
                                                    }
                                                    @if (j.Status == JournalStatus.Draft)
                                                    {
                                                        <a class="p-1 delete-icon" title="Delete" data-bs-toggle="modal" data-bs-target="#delete-modal" @onclick="() => ConfirmDelete(j)">
                                                            <i data-feather="trash-2"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@VisibleColumnCount" class="text-center py-4">
                                            <div class="text-muted">
                                                <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                                No journals found
                                            </div>
                                        </td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    @if (PagedJournals.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center p-3" id="RowsPerPageContent">

                            <div class="d-flex align-items-center">
                                <span class="me-2">Rows per page</span>
                                <select class="form-select form-select-sm w-auto"
                                @onchange="OnPageSizeChange">
                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                </select>
                                <span class="ms-2">Entries</span>
                            </div>

                            <nav>
                                <ul class="pagination pagination-sm mb-0">

                                    <!-- Prev -->
                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                        @onclick="PreviousPage"
                                        @onclick:preventDefault>
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>

                                    <!-- Pages -->
                                    @foreach (var pageNumber in VisiblePages)
                                    {
                                        <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                            <button type="button"
                                            class="page-link"
                                            @onclick="() => GoToPage(pageNumber)">
                                                @pageNumber
                                            </button>
                                        </li>
                                    }

                                    <!-- Next -->
                                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                        @onclick="NextPage"
                                        @onclick:preventDefault>
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>

                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
<!-- View Journal Offcanvas -->
<div class="offcanvas offcanvas-end offcanvas-view" tabindex="-1" id="viewJournalOffcanvas" data-bs-backdrop="true" data-bs-scroll="false" style="width:480px !important;">
    @if (SelectedJournalView != null)
    {
        <!-- Header: Avatar + Name + Status -->
        <div class="offcanvas-header">
            <div class="oc-avatar">@SelectedJournalView.JournalCode?.Substring(0, Math.Min(2, SelectedJournalView.JournalCode?.Length ?? 0))</div>
            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@SelectedJournalView.JournalName</h5>
                    <span class="oc-status-pill @(SelectedJournalView.Status == JournalStatus.Active ? "active" : "inactive")">
                        <span class="oc-status-dot"></span>
                        @SelectedJournalView.Status
                    </span>
                </div>
                <p class="oc-header-sub">@SelectedJournalView.JournalCode &nbsp;·&nbsp; @SelectedJournalView.JournalType</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <!-- Body -->
        <div class="offcanvas-body">

            <!-- Summary Cards -->
            <div class="oc-summary-row">
                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value">@SelectedJournalView.JournalCode</div>
                    <div class="oc-summary-label">Code</div>
                </div>
                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value">@SelectedJournalView.JournalType</div>
                    <div class="oc-summary-label">Type</div>
                </div>
                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value">@SelectedJournalView.Status</div>
                    <div class="oc-summary-label">Status</div>
                </div>
            </div>

            <!-- Journal Identity -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-id"></i>
                    <h6 class="oc-card-title">Journal Identity</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-grid">
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-tag"></i> Journal Code</div>
                            <div class="oc-field-value fw-medium">@SelectedJournalView.JournalCode</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-writing"></i> Journal Name</div>
                            <div class="oc-field-value text-truncate" title="@SelectedJournalView.JournalName">@SelectedJournalView.JournalName</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-category"></i> Journal Type</div>
                            <div class="oc-field-value">@SelectedJournalView.JournalType</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-book"></i> Ledger</div>
                            <div class="oc-field-value">@GetLedgerName(SelectedJournalView.LedgerId)</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-toggle-right"></i> Status</div>
                            <div class="oc-field-value">
                                <span class="badge @GetStatusBadge(SelectedJournalView.Status)">@SelectedJournalView.Status</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Numbering & Controls -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-hash"></i>
                    <h6 class="oc-card-title">Numbering & Controls</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-grid">
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-refresh"></i> Reset Numbering</div>
                            <div class="oc-field-value">@(SelectedJournalView.ResetNumbering ?? "—")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-keyboard"></i> Manual Entry Number</div>
                            <div class="oc-field-value">
                                @if (SelectedJournalView.AllowManualEntryNumber)
                                {
                                    <span class="badge bg-success-transparent text-success">Allowed</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-transparent text-secondary">Not Allowed</span>
                                }
                            </div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-letter-case"></i> Entry Prefix</div>
                            <div class="oc-field-value">@(SelectedJournalView.EntryNumberPrefix ?? "—")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-file-text"></i> Doc Number Series</div>
                            <div class="oc-field-value">@GetDocumentNumberSeriesName(SelectedJournalView.DocumentNumberSeriesId)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Posting & Validation -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-lock"></i>
                    <h6 class="oc-card-title">Posting & Validation</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-shield-check"></i> Require Approval</span>
                            <span class="oc-list-value">
                                @if (SelectedJournalView.RequireApprovalBeforePosting)
                                {
                                    <span class="oc-dot-badge db-green"><span class="dot"></span> Yes</span>
                                }
                                else
                                {
                                    <span class="oc-dot-badge db-red"><span class="dot"></span> No</span>
                                }
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-calendar-check"></i> Enforce Open Period</span>
                            <span class="oc-list-value">
                                @if (SelectedJournalView.EnforceAccountingPeriodOpen)
                                {
                                    <span class="oc-dot-badge db-green"><span class="dot"></span> Yes</span>
                                }
                                else
                                {
                                    <span class="oc-dot-badge db-red"><span class="dot"></span> No</span>
                                }
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-arrow-back-up"></i> Allow Reversals</span>
                            <span class="oc-list-value">
                                @if (SelectedJournalView.AllowReversalEntries)
                                {
                                    <span class="oc-dot-badge db-green"><span class="dot"></span> Yes</span>
                                }
                                else
                                {
                                    <span class="oc-dot-badge db-red"><span class="dot"></span> No</span>
                                }
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-list-numbers"></i> Max Lines Per Entry</span>
                            <span class="oc-list-value">@SelectedJournalView.MaxLinesPerEntry</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Governance -->
            <div class="oc-card">
                <div class="oc-card-header hdr-purple">
                    <i class="ti ti-clipboard-text"></i>
                    <h6 class="oc-card-title">Governance</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-notes"></i> Narration Required</span>
                            <span class="oc-list-value">
                                @if (SelectedJournalView.NarrationRequired)
                                {
                                    <span class="oc-dot-badge db-green"><span class="dot"></span> Yes</span>
                                }
                                else
                                {
                                    <span class="oc-dot-badge db-red"><span class="dot"></span> No</span>
                                }
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-template"></i> Narration Template</span>
                            <span class="oc-list-value text-truncate ql-editor" style="max-width:200px;" title="@GetPlainText(SelectedJournalView?.NarrationTemplate)">@(new MarkupString(SelectedJournalView?.NarrationTemplate ?? "-"))</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }
</div>


<!-- Responsive modal -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Journal Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>
            @if (SelectedJournalView != null)
            {
                <div class="modal-body">

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Journal Name:</strong>
                        <div class="text-truncate" style="max-width: 95%;" title="@SelectedJournalView.JournalName">
                            @SelectedJournalView.JournalName
                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Journal Type:</strong>
                        <div>@SelectedJournalView.JournalType</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Require Approval:</strong>
                        <div>
                            @if (SelectedJournalView.RequireApprovalBeforePosting == true)
                            {
                                <span class="badge bg-info-transparent text-info">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-transparent text-secondary">No</span>
                            }
                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Reset Numbering:</strong>
                        <div>@SelectedJournalView.ResetNumbering</div>
                    </div>

                    <div class="mb-2 gap-3">
                        <strong>Status:</strong>
                        <span class="badge @GetStatusBadge(SelectedJournalView.Status)">
                            @(SelectedJournalView.Status)
                        </span>

                    </div>


                </div>
            }
        </div>
    </div>
</div>


<!-- delete modal -->
<div class="modal fade" id="delete-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Journal</h4>
                    <p class="text-gray-6 mb-0 fs-16 text-truncate" style="max-width: 95%;" title="@SelectedJournal?.JournalName">Do you want to delete Journal <strong>@SelectedJournal?.JournalName</strong>?</p>
                    <div class="modal-footer-btn mt-3 d-flex justify-content-center">
                        <button type="button" class="btn me-2 btn-secondary fs-13 fw-medium p-2 px-3 shadow-none" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button type="submit" class="btn btn-danger fs-13 fw-medium p-2 px-3" @onclick="DeleteConfirmed"><i class="ti ti-trash me-1"></i>Yes Delete</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowReasonModal && SelectedJournal != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background: rgba(0,0,0,.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">

                <div class="modal-body text-center p-4">

                    <!-- ICON -->
                    <div class="mb-3">
                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center"
                              style="width:60px;height:60px;background:@(ActionType == "Activate" ? "#e9f7ef" : "#fff4e5");">
                            <i class="ti @(ActionType == "Activate" ? "ti-toggle-right text-success" : "ti-toggle-left text-warning") fs-28"></i>
                        </span>
                    </div>

                    <!-- TITLE -->
                    <h5 class="fw-bold mb-2">
                        @(ActionType == "Activate" ? "Activate Journal" : "Deactivate Journal")
                    </h5>

                    <!-- MESSAGE -->
                    <p class="text-muted mb-4" style="max-width: 95%;" title="@SelectedJournal?.JournalName">
                        Are you sure you want to deactivate
                        <strong>@ActionType.ToLower()</strong>
                        <strong>@SelectedJournal.JournalName</strong>
                        (<span class="fw-semibold">@SelectedJournal.JournalCode</span>)?
                    </p>

                    <!-- REASON -->
                    <div class="mb-3 text-start">
                        <label class="form-label small">
                            Reason <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control"
                                  rows="3"
                                  maxlength="250"
                                  @bind="Reason"
                                  placeholder="Enter reason for this action"></textarea>
                    </div>

                    <!-- ACTIONS -->
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button class="btn btn-outline-secondary px-4"
                                @onclick="CloseReasonModal">
                            <i class="ti ti-x me-1"></i>Cancel
                        </button>

                        <button class="btn @(ActionType == "Activate" ? "btn-success" : "btn-warning") px-4"
                                @onclick="ConfirmAction">
                            <i class="ti @(ActionType == "Activate" ? "ti-toggle-right" : "ti-toggle-left") me-1"></i>Yes, @ActionType
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
}
