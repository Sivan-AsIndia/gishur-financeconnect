@page "/journal-entries"
@page "/journal-entries/journal/{JournalId:guid}"
@using FinanceConnect.Client.ViewModels
@inject NavigationManager Nav
@inject JournalEntryService Service
@inject ToastService ToastService
@inject IJSRuntime JS
<style>
    .hover-shadow:hover {
        box-shadow: 0 3px 8px rgba(0,0,0,.08);
        background: #fff !important;
        transition: all .15s ease;
    }

    .form-select option:checked {
        color: #fff;
        background: #FE9F43;
    }

    .form-select:focus {
        border-color: #FE9F43;
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Journal Entry List</h4>
                    <h6>Manage accounting journal entries</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>
            <div class="page-btn">
                <a href="/journal-entries/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Journal Entry List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

                <!-- Search -->
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset">
                            <i class="ti ti-search fs-14"></i>
                        </span>
                        <input type="search"
                        class="form-control form-control-sm"
                        placeholder="Search entry no / narration"
                        @bind="searchText"
                        @oninput="OnSearch" />
                    </div>
                </div>
                <div style="display:flex">
                    <!-- Company Filter -->
                    <div>
                        <select class="form-select form-select-sm"
                        style="min-width: 180px"
                        @bind="SelectedCompanyId">
                            <option value="">All Companies</option>
                            @foreach (var c in Companies)
                            {
                                <option value="@c.Id">@c.LegalName</option>
                            }
                        </select>
                    </div>

                    <!-- Status Filter -->
                    <div class="ms-2">
                        <select class="form-select form-select-sm"
                        style="min-width:140px"
                        @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in Enum.GetValues<JournalEntryStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                </div>

            </div>

            <div class="card-body p-0">
                <div class="">
                    <div>
                        <table class="table align-middle w-100 table-fixed">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xl-none" style="width:40px"></th>
                                    <th style="width: 200px;">Entry no</th>
                                    <th class="d-none d-md-table-cell">Journal</th>
                                    <th class="d-none d-md-table-cell" title="Posting Date">Posting Date</th>
                                    @* <th class="d-none d-lg-table-cell">Narration</th> *@
                                    <th class="d-none d-xl-table-cell text-end" style="width: 143px;">Debit</th>
                                    <th class="d-none d-xxl-table-cell text-end">Credit</th>
                                    <th class="d-none d-xxl-table-cell">Status</th>
                                    <th class="no-sort" style="width: 145px;">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedEntries != null && PagedEntries.Any())
                                {
                                    @foreach (var e in PagedEntries)
                                    {
                                        <tr>
                                            <!-- PLUS ICON -->
                                            <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                data-bs-toggle="modal"
                                                data-bs-target="#rowDetailsModal"
                                                @onclick="() => ViewEntry(e)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td>
                                                <span class="fw-medium" data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="@e.JournalEntryNumber details">
                                                    <span class="PopupIcon">⧉</span>
                                                    <a href="@($"/journal-entries/{e.Id}/view")" class="text-decoration-none link-View">
                                                        @e.JournalEntryNumber
                                                    </a>
                                                </span>
                                            </td>

                                            <td class="d-none d-md-table-cell">@Service.GetJournalName(e.JournalId)</td>

                                            <td class="d-none d-md-table-cell">@e.PostingDate.ToString("dd-MMM-yyyy")</td>

                                            @* <td class="text-truncate d-none d-lg-table-cell" style="max-width:220px" title="@e.Narration">
                                            @(string.IsNullOrWhiteSpace(e.Narration) ? "-" : e.Narration)
                                        </td> *@

                                            <td class="text-end d-none d-xl-table-cell">@e.TotalDebit.ToString("N2")</td>
                                            <td class="text-end d-none d-xxl-table-cell">@e.TotalCredit.ToString("N2")</td>

                                            <td class="d-none d-xxl-table-cell">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="ActiveDot @GetStatusDotBadge(e.Status)">
                                                    </div>
                                                    <span>@e.Status</span>
                                                </div>
                                            </td>
                                            <td class="action-table-data">
                                                <div class="edit-delete-action">
                                                    <!-- Edit -->
                                                    @if (e.Status == JournalEntryStatus.Draft)
                                                    {
                                                        <a class="me-2 edit-icon p-1" title="Edit"
                                                        @onclick="() => EditEntry(e.Id)">
                                                            <i data-feather="edit"></i>
                                                        </a>
                                                    }
                                                    <!-- Delete -->
                                                    @if (e.Status == JournalEntryStatus.Draft)
                                                    {
                                                        <a class="p-1 delete-icon" title="Delete" data-bs-toggle="modal" data-bs-target="#delete-modal" @onclick="() => ConfirmDelete(e)">
                                                            <i data-feather="trash-2"></i>
                                                        </a>
                                                    }

                                                </div>
                                            </td>

                                        </tr>
                                    }
                                }
                                else if (!PagedEntries.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-4">
                                            <div class="text-muted">
                                                <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                                No journal entries found
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    @if (PagedEntries != null && PagedEntries.Any())
                    {
                        <div class="d-flex justify-content-between align-items-center p-3" id="RowsPerPageContent">

                            <div class="d-flex align-items-center">
                                <span class="me-2">Rows per page</span>
                                <select class="form-select form-select-sm w-auto"
                                @onchange="OnPageSizeChange">
                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                </select>
                                <span class="ms-2">Entries</span>
                            </div>

                            <nav>
                                <ul class="pagination pagination-sm mb-0">

                                    <!-- Prev -->
                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                        @onclick="PreviousPage"
                                        @onclick:preventDefault>
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>

                                    <!-- Pages -->
                                    @foreach (var pageNumber in VisiblePages)
                                    {
                                        <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                            <button type="button"
                                            class="page-link"
                                            @onclick="() => GoToPage(pageNumber)">
                                                @pageNumber
                                            </button>
                                        </li>
                                    }

                                    <!-- Next -->
                                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                        @onclick="NextPage"
                                        @onclick:preventDefault>
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>

                                </ul>
                            </nav>

                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

}

<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Jounal Entry Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>
            @if (SelectedEntry != null)
            {
                <div class="modal-body">

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Journal:</strong>
                        <div>@SelectedEntry.JournalEntryNumber.Split('-')[0]</div>
                    </div>

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Posting Date:</strong>
                        <div>@SelectedEntry?.PostingDate</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Narration:</strong>
                        <div class="text-truncate" style="max-width: 95%;" title="@SelectedEntry.Narration">
                            @(string.IsNullOrWhiteSpace(SelectedEntry.Narration) ? "-" : SelectedEntry.Narration)
                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Debit:</strong>
                        <div>@SelectedEntry?.TotalDebit.ToString("N2")</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Credit:</strong>
                        <div>@SelectedEntry?.TotalCredit.ToString("N2")</div>
                    </div>

                    <div class="mb-2 gap-3">
                        <strong>Status:</strong>
                        <span class="badge @GetStatusBadge(SelectedEntry.Status)">
                            @(SelectedEntry.Status)
                        </span>

                    </div>


                </div>
            }
        </div>
    </div>
</div>

<!-- delete modal -->
<div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Journal Entry</h4>
                    <p class="text-gray-6 mb-0 fs-16">Are you sure you want to delete <strong>@SelectedEntry?.JournalEntryNumber</strong>?</p>
                    <div class="modal-footer-btn mt-3 d-flex justify-content-center">
                        <button type="button" class="btn me-2 btn-outline-secondary fs-13 fw-medium p-2 px-3 shadow-none" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button type="submit" class="btn btn-danger fs-13 fw-medium p-2 px-3" @onclick="DeleteConfirmed"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>