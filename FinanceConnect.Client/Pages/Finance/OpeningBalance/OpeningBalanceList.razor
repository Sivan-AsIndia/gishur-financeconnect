@page "/opening-balances"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MasterDataService MasterDataService
@inject ToastService ToastService

@if (!isInitialized)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
    }

    <div class="content List-view">
        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Opening Balance List</h4>
                    <h6>Manage opening balances</h6>
                </div>
            </div>
            <ul class="table-top-head">
                <li><a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync"><i class="ti ti-refresh"></i></a></li>
            </ul>
        </div>

        <!-- Opening Balance List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display:flex">
                    <div>
                        <select class="form-select form-select-sm" style="min-width:140px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in DistinctStatuses)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th style="width:200px; white-space:nowrap;">No</th>
                                <th class="d-none d-md-table-cell" style="width:130px;">Fiscal Year</th>
                                <th style="width:120px;">Date</th>
                                <th class="text-end" style="width:140px;">Debit</th>
                                <th class="text-end d-none d-xl-table-cell" style="width:140px;">Credit</th>
                                <th class="d-none d-xl-table-cell" style="width:120px;">Status</th>
                                <th class="no-sort" style="width:150px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedItems.Any())
                            {
                                @foreach (var item in PagedItems)
                                {
                                    <tr>
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(item)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td>
                                            <div class="d-flex align-items-start gap-2 flex-column">
                                                <span class="fw-medium" style="white-space:nowrap;">
                                                    <i class="ti ti-external-link me-1 PopupIcon"></i>
                                                    <a @onclick="() => ViewItem(item)" class="text-decoration-none link-View"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       title="@item.OpeningBalanceNumber details">
                                                        @item.OpeningBalanceNumber
                                                    </a>
                                                </span>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span title="CompanyCode" class="badge bg-info-transparent text-info" style="font-size: 11px;">@(item.CompanyCode ?? "-")</span>
                                                    <span title="BranchCode" class="badge bg-secondary-transparent text-secondary" style="font-size: 11px;">@(item.BranchCode ?? "-")</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="d-none d-md-table-cell">
                                            <span>@(item.FiscalYearName ?? "-")</span>
                                        </td>
                                        <td>@item.OpeningDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-end text-success">
                                            @IndianNumberFormatter.Format(@item.TotalDebit)
                                        </td>
                                        <td class="text-end text-info d-none d-xl-table-cell">
                                            @IndianNumberFormatter.Format(@item.TotalCredit)
                                        </td>
                                        <td class="d-none d-xl-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @GetStatusDotBadge(item.Status)">
                                                </div>
                                                <span> @item.Status</span>
                                            </div>
                                        </td>
                                        <td class="action-table-data">
                                            <div class="edit-delete-action">
                                                <a class="me-2 view-icon p-1" href="javascript:void(0);" title="View"
                                                   @onclick="() => ViewItem(item)">
                                                    <i data-feather="eye"></i>
                                                </a>
                                                @if (item.Status == "Draft")
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Submit for Approval" data-bs-toggle="modal" data-bs-target="#submitModal"
                                                       @onclick="() => ConfirmSubmit(item)">
                                                        <i class="ti ti-send"></i>
                                                    </a>
                                                }
                                                @if (item.Status == "Submitted")
                                                {
                                                    <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                       title="Approve" data-bs-toggle="modal" data-bs-target="#approveModal"
                                                       @onclick="() => ConfirmApprove(item)">
                                                        <i class="ti ti-check"></i>
                                                    </a>
                                                }
                                                @if (item.Status == "Approved")
                                                {
                                                    <a class="me-2 p-1 Toggle-icon post action-icon" href="javascript:void(0);"
                                                       title="Post" data-bs-toggle="modal" data-bs-target="#postModal"
                                                       @onclick="() => ConfirmPost(item)">
                                                        <i class="ti ti-checkbox"></i>
                                                    </a>
                                                }
                                                @if (item.Status == "Draft" || item.Status == "Cancelled")
                                                {
                                                    <a class="p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                                       data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                       @onclick="() => ConfirmDelete(item)">
                                                        <i data-feather="trash-2"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center py-4">
                                        <div class="text-muted">
                                            <i class="ti ti-folder-off fs-24 mb-2"></i>
                                            <p class="mb-0">No opening balances found</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer d-flex align-items-center justify-content-between flex-wrap row-gap-3 border-top" id="RowsPerPageContent">
                    <div class="d-flex align-items-center">
                        <span class="me-2">Rows per page</span>
                        <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChange">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                        </select>
                        <span class="ms-2">Entries</span>
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                    <i class="ti ti-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = StartPage; i <= EndPage; i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                    <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                        @pageNumber
                                    </button>
                                </li>
                            }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                <i class="ti ti-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>


    <!-- Row Details Modal (Responsive) -->
    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Opening Balance Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            style="padding:0; right:22px; position:absolute;transform:none"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-2 d-flex gap-3">
                        <strong>Fiscal Year:</strong>
                        <div>@(SelectedCompany?.FiscalYearName ?? "-")</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Company:</strong>
                        <div>@(SelectedCompany?.CompanyCode ?? "-")</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Branch:</strong>
                        <div>@(SelectedCompany?.BranchCode ?? "-")</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Total Credit:</strong>
                        <div>
                            @(SelectedCompany != null
                                                        ? SelectedCompany.TotalCredit.ToString("N2")
                                                        : "-")
                            </div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Status:</strong>
                            <div>
                                <span class="badge @(SelectedCompany != null ? GetStatusBadge(SelectedCompany.Status) : "")">
                                    @(SelectedCompany?.Status ?? "-")
                                </span>
                            </div>
                        </div>


                    </div>

                </div>
            </div>
        </div>


        <!-- SUBMIT MODAL -->
        <div class="modal fade" id="submitModal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            @if (SelectedItem?.IsBalanced ?? false)
                            {
                                <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                    <i class="ti ti-send fs-24 text-success"></i>
                                </span>
                                <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Submit Opening Balance</h4>
                                <p class="text-gray-6 mb-0 fs-16">
                                    Are you sure you want to submit <strong>@SelectedItem?.OpeningBalanceNumber</strong> for approval?
                                </p>
                            }
                            else
                            {
                                <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                    <i class="ti ti-alert-triangle fs-24 text-danger"></i>
                                </span>
                                <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Cannot Submit</h4>
                                <p class="text-gray-6 mb-0 fs-16 text-danger">
                                    Debit and Credit must balance!
                                </p>
                            }
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (SelectedItem?.IsBalanced ?? false)
                                {
                                    <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal" @onclick="SubmitConfirmed"><i class="ti ti-send me-1"></i>Yes, Submit</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>



        <!-- APPROVE MODAL -->
        <div class="modal fade" id="approveModal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-check fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Approve Opening Balance</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to approve <strong>@SelectedItem?.OpeningBalanceNumber</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal" @onclick="ApproveConfirmed"><i class="ti ti-check me-1"></i>Yes, Approve</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- POST MODAL -->
        <div class="modal fade" id="postModal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-primary-transparent mb-2">
                                <i class="ti ti-checkbox fs-24 text-primary"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Post Opening Balance</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to post <strong>@SelectedItem?.OpeningBalanceNumber</strong> to General Ledger?
                            </p>
                            <small class="text-muted">This action cannot be undone.</small>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-primary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal" @onclick="PostConfirmed"><i class="ti ti-checkbox me-1"></i>Yes, Post</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- DELETE MODAL -->
        <div class="modal fade" id="deleteModal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                <i class="ti ti-trash fs-24 text-danger"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Opening Balance</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Are you sure you want to delete <strong>@SelectedItem?.OpeningBalanceNumber</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal" @onclick="DeleteConfirmed"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
