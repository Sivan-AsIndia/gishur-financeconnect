@page "/closing-balances"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MasterDataService MasterDataService
@inject ToastService ToastService

@if (!isInitialized)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
    }

    <div class="content List-view">
        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Closing Balances</h4>
                    <h6>View period-end balances - Read-only</h6>
                </div>
            </div>
            <ul class="table-top-head">
                <li><a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync"><i class="ti ti-refresh"></i></a></li>
            </ul>
        </div>

        <!-- SUMMARY CARDS -->
        <div class="row g-3 mb-4">

            <div class="col-12 col-sm-6 col-md-3">
                <div class="card bg-primary text-white h-100" style="background-color: #334155 !important;">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center">
                            <i class="ti ti-report fs-1 me-3 opacity-75"></i>
                            <div>
                                <div class="fs-4 fw-bold">@FilteredItems?.Count</div>
                                <small class="fs-15">Total Records</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-3">
                <div class="card bg-success text-white h-100" style="    background-color: #065F46 !important;">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center">
                            <i class="ti ti-arrow-up-right fs-1 me-3 opacity-75"></i>
                            <div>
                                <div class="fs-4 fw-bold">
                                    ₹ @TotalClosingDebit.ToString("N0")
                                </div>
                                <small class="fs-15">Total Closing Debit</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-3">
                <div class="card bg-info text-white h-100" style="background-color: #B45309 !important;">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center">
                            <i class="ti ti-arrow-down-left fs-1 me-3 opacity-75"></i>
                            <div>
                                <div class="fs-4 fw-bold">
                                    ₹ @TotalClosingCredit.ToString("N0")
                                </div>
                                <small class="fs-15">Total Closing Credit</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-3">
                <div class="card bg-warning text-white h-100" style="background-color: #4C1D95 !important;">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center">
                            <i class="ti ti-lock fs-1 me-3"></i>
                            <div>
                                <div class="fs-4 fw-bold">@LockedCount</div>
                                <small class="fs-15">Locked Periods</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>


        <!-- Closing Balance List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search account..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display:flex;flex-wrap:wrap;gap:8px;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width:140px" @bind="SelectedBranchId">
                            <option value="">--All Branches--</option>
                            @foreach (var branch in CBBranches)
                            {
                                <option value="@branch.Id">@branch.Code - @branch.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <select class="form-select form-select-sm" style="min-width:130px" @bind="SelectedPeriodId">
                            <option value="">--All Periods--</option>
                            @foreach (var period in CBPeriods)
                            {
                                <option value="@period.Id">@period.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <select class="form-select form-select-sm" style="min-width:130px" @bind="SelectedCloseStatus">
                            <option value="">--All Status--</option>
                            @foreach (var status in DistinctCloseStatuses)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th class="d-none d-md-table-cell" title="Period">Period</th>
                                <th title="Account">Account</th>
                                <th class="d-none d-md-table-cell" title="Branch">Branch</th>
                                <th class="text-end" title="Opening">Opening</th>

                                <th class="text-end d-none d-xl-table-cell" title="Period Dr">Period Dr</th>
                                <th class="text-end d-none d-xl-table-cell" title="Period Cr">Period Cr</th>
                                <th class="text-end d-none d-xl-table-cell" title="Closing">Closing</th>
                                @* <th class="d-none d-xl-table-cell">Side</th> *@
                                <th class="d-none d-md-table-cell">Status</th>

                                <th class="no-sort">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedItems.Any())
                            {
                                @foreach (var item in PagedItems)
                                {
                                    <tr>
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal"
                                               data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(item)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td class="d-none d-md-table-cell">
                                            <span class="badge bg-info-transparent text-info">@(item.AccountingPeriodName ?? "-")</span>
                                        </td>
                                        <td >
                                           <div>
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a @onclick="() => ViewItem(item)" class="text-decoration-none link-View" data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title="@item.AccountCode details">
                                                    <span class="fw-medium" title="@item.AccountCode">@item.AccountCode</span>
                                                    <small class="d-block text-muted">@item.AccountName</small>
                                                </a>
                                           </div>

                                        </td>
                                        <td class="d-none d-md-table-cell">
                                            <span class="badge bg-secondary-transparent text-secondary">@(item.BranchCode ?? "-")</span>
                                        </td>
                                        <td class="text-end">
                                            @IndianNumberFormatter.Format(
                                            item.OpeningDebit - item.OpeningCredit)


                            </td>
                            <td class="text-end text-success d-none d-xl-table-cell">
                                @* @item.PeriodDebit.ToString("N2") *@
                                @IndianNumberFormatter.Format(@item.PeriodDebit)

                            </td>
                            <td class="text-end text-info d-none d-xl-table-cell">
                                @* @item.PeriodCredit.ToString("N2") *@
                                @IndianNumberFormatter.Format(@item.PeriodCredit)
                            </td>
                            <td class="text-end fw-bold d-none d-xl-table-cell">
                                @* @item.ClosingBalanceAmount.ToString("N2") *@
                                @IndianNumberFormatter.Format(@item.ClosingBalanceAmount)
                            </td>
                            @* <td class="d-none d-xl-table-cell">
                                            <span class="badge @GetSideBadge(item.ClosingBalanceSide)">@item.ClosingBalanceSide</span>
                                        </td> *@
                            @* <td class="d-none d-md-table-cell">
                                            <span class="badge @GetStatusBadge(item.CloseStatus)">@item.CloseStatus</span>
                                        </td> *@

                            <td class="d-none d-md-table-cell">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="ActiveDot @GetStatusDotBadge(item.CloseStatus)">
                                    </div>
                                    <span> @item.CloseStatus</span>
                                </div>
                            </td>
                            <td class="action-table-data">
                                <div class="edit-delete-action">
                                    <a class="me-2 view-icon p-1" href="javascript:void(0);" title="View"
                                       @onclick="() => ViewItem(item)">
                                        <i data-feather="eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center text-muted py-4">
                                        No closing balances found
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center p-3" id="RowsPerPageContent">
                        <div class="d-flex align-items-center">
                            <span class="me-2">Rows per page</span>
                            <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected="@(PageSize == 10)">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = StartPage; i <= EndPage; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

}




<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">ClosingBalance Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>

            <div class="modal-body">
                <div class="mb-2 d-flex gap-3">
                    <strong>Closing:</strong>
                    <div>
                        @(SelectedCompany != null
                                                ? SelectedCompany.ClosingBalanceAmount.ToString("N2")
                                                : "-")
                    </div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Period:</strong>
                    <div>
                        <span class="badge bg-info-transparent text-info">
                            @(SelectedCompany?.AccountingPeriodName ?? "-")
                        </span>
                    </div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Branch:</strong>
                    <div>
                        <span class="badge bg-secondary-transparent text-secondary">
                            @(SelectedCompany?.BranchCode ?? "-")
                        </span>
                    </div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Period Dr:</strong>
                    <div>
                        @SelectedCompany?.PeriodCredit
                    </div>
                </div>
                <div class="mb-2 d-flex gap-3">
                    <strong>Period Cr:</strong>
                    <div>
                        @SelectedCompany?.PeriodCredit
                    </div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Side:</strong>
                    <div>
                        <span class="badge @(SelectedCompany != null ? GetSideBadge(SelectedCompany.ClosingBalanceSide) : "")">
                            @(SelectedCompany?.ClosingBalanceSide ?? "-")
                        </span>
                    </div>
                </div>

                <div class="mb-2 d-flex gap-3">
                    <strong>Status:</strong>
                    <div>
                        <span class="badge @(SelectedCompany != null ? GetStatusBadge(SelectedCompany.CloseStatus) : "")">
                            @(SelectedCompany?.CloseStatus ?? "-")
                        </span>
                    </div>
                </div>



            </div>

        </div>
    </div>
</div>

