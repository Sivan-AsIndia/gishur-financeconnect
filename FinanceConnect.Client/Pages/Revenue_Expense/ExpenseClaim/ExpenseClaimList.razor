@page "/expense-claims"
@inject IJSRuntime JS
@using static FinanceConnect.Client.ViewModels.ExpenseClaimViewModel

<style>
    @@media(max-width:635px) {
        .responsivefilter {
            flex-wrap: wrap;
        }
    }</style>

<div class="content List-view">
    <div class="page-header">
        <div class="add-item d-flex"><div class="page-title"><h4 class="fw-bold">Expense Claim List</h4><h6>Manage Employee Reimbursement Claims</h6></div></div>
        <ul class="table-top-head me-2"><li><a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync"><i class="ti ti-refresh"></i></a></li></ul>
        <div class="page-btn"><a href="/expense-claims/create" class="btn btn-primary"><i class="ti ti-circle-plus me-1"></i> Create</a></div>
    </div>
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
            <div class="search-set"><div class="search-input"><span class="btn-searchset"><i class="ti ti-search fs-14"></i></span><input type="search" class="form-control form-control-sm" placeholder="Search code, title, claimant..." @bind="searchText" @oninput="OnSearch" /></div></div>
            <div style="display:flex;gap:15px;" class="responsivefilter">
                <select class="form-select form-select-sm" style="min-width:180px" @bind="SelectedStatus" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Status</option>
                    @foreach (var s in Enum.GetValues<ClaimStatusEnum>())
                    {
                        <option value="@((int)s)">@s</option>
                    }
                </select>
                <select class="form-select form-select-sm" style="min-width:180px" @bind="SelectedReimb" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Reimbursement</option>
                    @foreach (var r in Enum.GetValues<ReimbursementStatusEnum>())
                    {
                        <option value="@((int)r)">@r</option>
                    }
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            <table class="table align-middle w-100 table-fixed">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xxl-none" style="width:40px"></th>
                        <th>Claim</th>
                        <th class="d-none d-md-table-cell">Claimant</th>
                        <th class="d-none d-xxl-table-cell">Claimed</th>
                        <th class="d-none d-xxl-table-cell">Approved</th>
                        <th class="d-none d-xl-table-cell">Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedItems.Any())
                    {
                        @foreach (var c in PagedItems)
                        {
                            <tr>
                                <td class="d-xxl-none text-center" style="padding:0;padding-left:15px;">
                                    <a href="javascript:void(0);" class="TablePlus" data-bs-toggle="modal" data-bs-target="#rowDetailsModal" @onclick="() => SelectedItem = c"><i class="ti ti-plus"></i></a>
                                </td>
                                <td>
                                    <div>
                                        <span class="fw-medium">
                                            <i class="ti ti-external-link me-2 PopupIcon"></i>
                                            <a href="/expense-claims/@c.ExpenseClaimId/view" data-bs-toggle="tooltip"
                                               data-bs-placement="top" class="link-View text-decoration-none" title="@c.ClaimCode details">@c.ClaimTitle</a>
                                        </span>
                                    </div><small class="text-muted">@c.ClaimCode</small>
                                </td>
                                <td class="d-none d-md-table-cell"><div>@(c.ClaimantNameSnapshot ?? "–")</div><small class="text-muted">@c.ClaimantCodeSnapshot</small></td>
                                <td class="d-none d-xxl-table-cell fw-medium">₹@c.TotalClaimedAmount.ToString("N2")</td>
                                <td class="d-none d-xxl-table-cell">₹@c.TotalApprovedAmount.ToString("N2")</td>
                                <td class="d-none d-xl-table-cell"><div class="d-flex align-items-center gap-2"><div class="ActiveDot @GetStatusDot(c.ClaimStatus)"></div><span>@c.ClaimStatus</span></div></td>
                                <td class="action-table-data">
                                    <div class="edit-delete-action d-flex align-items-center gap-2">
                                        <a href="/expense-claims/@c.ExpenseClaimId/view" class="p-1  view-icon" title="View"><i class="ti ti-eye"></i></a>
                                        @if (c.ClaimStatus == ClaimStatusEnum.Draft)
                                        {
                                            <a href="/expense-claims/edit/@c.ExpenseClaimId" class="p-1 edit-icon" title="Edit"><i class="ti ti-edit"></i></a>
                                            <a href="javascript:void(0);" class="p-1 delete-icon" title="Delete" data-bs-toggle="modal" data-bs-target="#delete-modal" @onclick="() => SelectedItem = c"><i class="ti ti-trash"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="@VisibleColumnCount" class="text-center text-muted py-4">No expense claims found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @if (FilteredItems.Count > 0)
        {
            <div class="d-flex align-items-center justify-content-between p-3">
                <div class="d-flex align-items-center fs-13">
                    <span class="me-2">Rows per page</span>
                    <select class="form-select form-select-sm" style="width:80px" @onchange="OnPageSizeChange">
                        <option value="5" selected="@(PageSize == 5)">5</option>
                        <option value="10" selected="@(PageSize == 10)">10</option>
                        <option value="25" selected="@(PageSize == 25)">25</option>
                        <option value="50" selected="@(PageSize == 50)">50</option>
                    </select>
                    <span class="ms-2">Entries</span>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage"><i class="ti ti-chevron-left"></i></a>
                        </li>
                        @foreach (var p in VisiblePages)
                        {
                            <li class="page-item @(p == CurrentPage ? "active" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(p)">@p</a>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="NextPage"><i class="ti ti-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
    <!-- Row Details Modal -->
    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Claim Details</h5><button type="button" class="btn-close" data-bs-dismiss="modal" style="padding:0;right:22px;position:absolute;transform:none"></button></div>
                <div class="modal-body">
                    <div class="mb-2 d-flex gap-3"><strong>Code:</strong><div>@SelectedItem?.ClaimCode</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Title:</strong><div>@SelectedItem?.ClaimTitle</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Claimant:</strong><div>@(SelectedItem?.ClaimantNameSnapshot ?? "–")</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Purpose:</strong><div>@(SelectedItem?.BusinessPurpose ?? "–")</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Claimed:</strong><div>₹@(SelectedItem?.TotalClaimedAmount.ToString("N2") ?? "0")</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Approved:</strong><div>₹@(SelectedItem?.TotalApprovedAmount.ToString("N2") ?? "0")</div></div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Status:</strong>@if(SelectedItem != null){
                        <span class="badge @GetStatusBadge(SelectedItem.ClaimStatus)">@SelectedItem.ClaimStatus</span>
                                                }
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Reimbursement:</strong>@if(SelectedItem != null){
                        <span class="badge @GetReimbBadge(SelectedItem.ReimbursementStatus)">@SelectedItem.ReimbursementStatus</span>
                                                }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Delete Modal -->
    <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Claim</h4>
                        <p class="text-gray-6 mb-0 fs-16">Are you sure you want to delete <strong>@SelectedItem?.ClaimCode</strong>?</p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="() => ConfirmDelete(SelectedItem!.ExpenseClaimId)" data-bs-dismiss="modal"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
