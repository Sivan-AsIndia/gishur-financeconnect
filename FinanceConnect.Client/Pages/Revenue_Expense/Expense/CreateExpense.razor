@page "/expenses/create"
@page "/expenses/edit/{Id:guid}"
@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services
@using static FinanceConnect.Client.ViewModels.ExpenseViewModel

<style>.validation-message{color:#dc3545;font-size:12px;}.form-check-label{font-size:13px;}</style>

<div class="content flat-form">
    <div class="page-header">
        <div class="page-title"><h4 class="fw-bold">@(IsEdit ? "Edit Expense" : "Create Expense")</h4><h6>Operational cost event capture and classification</h6></div>
        <div class="page-btn"><a href="/expenses" class="btn btn-outline-secondary"><i class="ti ti-arrow-left"></i> Back</a></div>
    </div>

    <EditForm EditContext="_editContext" OnSubmit="Save">
        <DataAnnotationsValidator />

        <!-- SECTION 1: CORE IDENTITY -->
        <div class="card mt-4"><div class="card-body">
            <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-id me-2" style="font-size:22px;"></i> Core Identity</h6>
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label">Expense Code <span class="text-danger">*</span></label>@if(IsEdit){<div class="fw-semibold fs-14 mt-1">@Model.ExpenseCode</div>}else{<InputText class="form-control text-uppercase" @bind-Value="Model.ExpenseCode" placeholder="e.g. EXP-2026-0001" title="Unique expense code per company (max 30)" />}<ValidationMessage For="@(() => Model.ExpenseCode)" /></div>
                <div class="col-md-5"><label class="form-label">Expense Title <span class="text-danger">*</span></label><InputText class="form-control" @bind-Value="Model.ExpenseTitle" placeholder="e.g. April Office Rent" title="Descriptive title (max 200)" /><ValidationMessage For="@(() => Model.ExpenseTitle)" /></div>
                <div class="col-md-2"><label class="form-label">Status <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="Model.ExpenseStatus" title="Current expense status">@foreach(var s in Enum.GetValues<ExpenseStatusEnum>()){<option value="@s">@s</option>}</InputSelect></div>
                <div class="col-md-2"><label class="form-label">Expense Type <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="Model.ExpenseType" title="Type of expense">@foreach(var v in Enum.GetValues<ExpenseTypeEnum>()){<option value="@v">@v</option>}</InputSelect></div>
                <div class="col-md-12"><label class="form-label">Description</label><InputTextArea class="form-control" rows="2" @bind-Value="Model.Description" placeholder="Optional description (max 1000)..." /></div>
            </div>
        </div></div>

        <!-- SECTION 2: PAYEE & SOURCE -->
        <div class="card mt-4"><div class="card-body">
            <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-users me-2" style="font-size:22px;"></i> Payee & Source Context</h6>
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label">Payee Type <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="Model.PayeeType" title="Who is the payee">@foreach(var v in Enum.GetValues<PayeeTypeEnum>()){<option value="@v">@v</option>}</InputSelect></div>
                <div class="col-md-3"><label class="form-label">Payee Code</label><InputText class="form-control" @bind-Value="Model.PayeeCodeSnapshot" placeholder="e.g. VND-001" title="Payee code snapshot (max 30)" /></div>
                <div class="col-md-3"><label class="form-label">Payee Name</label><InputText class="form-control" @bind-Value="Model.PayeeNameSnapshot" placeholder="e.g. Narpavi Wood Traders" title="Payee name snapshot (max 200)" /></div>
                <div class="col-md-3"><label class="form-label">Source Document Type <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="Model.SourceDocumentType" title="Type of source document">@foreach(var v in Enum.GetValues<SourceDocumentTypeEnum>()){<option value="@v">@v</option>}</InputSelect></div>
                <div class="col-md-3"><label class="form-label">Source Document Number</label><InputText class="form-control" @bind-Value="Model.SourceDocumentNumber" placeholder="e.g. VB-2026-0001" title="Source document reference (max 50)" /></div>
                <div class="col-md-3"><label class="form-label">Supplier Invoice #</label><InputText class="form-control" @bind-Value="Model.SupplierInvoiceNumber" placeholder="e.g. INV-12345" title="Supplier invoice number (max 50)" /></div>
            </div>
        </div></div>

        <!-- SECTION 3: DATE & PERIOD CONTEXT -->
        <div class="card mt-4"><div class="card-body">
            <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-calendar me-2" style="font-size:22px;"></i> Date & Period Context</h6>
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label">Expense Date <span class="text-danger">*</span></label><InputDate class="form-control" @bind-Value="Model.ExpenseDate" title="Operational/incurrence date" /><ValidationMessage For="@(() => Model.ExpenseDate)" /></div>
                <div class="col-md-3"><label class="form-label">Posting Date</label><InputDate class="form-control" @bind-Value="Model.PostingDate" title="Usually derived from expense date" /></div>
                <div class="col-md-3"><label class="form-label">Fiscal Year <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="Model.FiscalYearId" title="Fiscal year for this expense"><option value="">-- Select Fiscal Year --</option>@foreach(var f in FiscalYears){<option value="@f.Key">@f.Value</option>}</InputSelect><ValidationMessage For="@(() => Model.FiscalYearId)" /></div>
                <div class="col-md-3"><label class="form-label">Currency <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="Model.CurrencyId" title="Transaction currency"><option value="">-- Select Currency --</option>@foreach(var c in CurrencyList){<option value="@c.Key">@c.Value</option>}</InputSelect><ValidationMessage For="@(() => Model.CurrencyId)" /></div>
                <div class="col-md-3"><label class="form-label">Coverage Start Date</label><InputDate class="form-control" @bind-Value="Model.CoverageStartDate" title="Important for prepayment/service coverage" /></div>
                <div class="col-md-3"><label class="form-label">Coverage End Date</label><InputDate class="form-control" @bind-Value="Model.CoverageEndDate" title="End of coverage period" /></div>
            </div>
        </div></div>

        <!-- SECTION 4: AMOUNTS -->
        <div class="card mt-4"><div class="card-body">
            <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-currency-rupee me-2" style="font-size:22px;"></i> Header Amounts</h6>
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label">Net Amount</label><div class="form-control bg-light fw-medium" title="Derived from lines">₹@Model.TotalNetAmount.ToString("N2")</div></div>
                <div class="col-md-3"><label class="form-label">Tax Amount</label><div class="form-control bg-light" title="Derived from lines">₹@Model.TotalTaxAmount.ToString("N2")</div></div>
                <div class="col-md-3"><label class="form-label">Gross Amount</label><div class="form-control bg-light fw-bold" title="Derived from lines">₹@Model.TotalGrossAmount.ToString("N2")</div></div>
                <div class="col-md-3"><label class="form-label">Adjustment Amount</label><InputNumber class="form-control" @bind-Value="Model.AdjustmentAmount" placeholder="0.00" title="Controlled expense adjustment" /></div>
                <div class="col-md-3 d-flex align-items-end"><div class="d-flex align-items-center gap-2 mb-2"><InputCheckbox class="form-check-input" @bind-Value="Model.TaxInclusiveFlag" /><label class="form-check-label" title="Are amounts tax-inclusive">Tax Inclusive</label></div></div>
                <div class="col-md-3 d-flex align-items-end"><div class="d-flex align-items-center gap-2 mb-2"><InputCheckbox class="form-check-input" @bind-Value="Model.ReceiptRequiredFlag" /><label class="form-check-label" title="Is receipt required by policy">Receipt Required</label></div></div>
            </div>
        </div></div>

        <!-- SECTION 5: TIMING TREATMENT -->
        <div class="card mt-4"><div class="card-body">
            <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-clock me-2" style="font-size:22px;"></i> Timing Treatment</h6>
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label">Timing Treatment <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="Model.TimingTreatment" title="How this expense is timed">@foreach(var v in Enum.GetValues<TimingTreatmentEnum>()){<option value="@v">@v</option>}</InputSelect></div>
                <div class="col-md-3"><label class="form-label">Timing Status <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="Model.TimingTreatmentStatus" title="Current timing treatment status">@foreach(var v in Enum.GetValues<TimingTreatmentStatusEnum>()){<option value="@v">@v</option>}</InputSelect></div>
                <div class="col-md-3"><label class="form-label">Posting Status <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="Model.PostingStatus" title="Current posting status">@foreach(var v in Enum.GetValues<PostingStatusEnum>()){<option value="@v">@v</option>}</InputSelect></div>
                <div class="col-md-3"><label class="form-label">Budget Check Status</label><InputSelect class="form-select" @bind-Value="Model.BudgetCheckStatus" title="Budget check result">@foreach(var v in Enum.GetValues<BudgetCheckStatusEnum>()){<option value="@v">@v</option>}</InputSelect></div>
                <div class="col-md-3 d-flex flex-column gap-2 mt-2">
                    <div class="d-flex align-items-center gap-2"><InputCheckbox class="form-check-input" @bind-Value="Model.AccrualRequiredFlag" /><label class="form-check-label" title="Indicates accrual treatment path">Accrual Required</label></div>
                    <div class="d-flex align-items-center gap-2"><InputCheckbox class="form-check-input" @bind-Value="Model.PrepaymentRequiredFlag" /><label class="form-check-label" title="Indicates prepayment treatment path">Prepayment Required</label></div>
                    <div class="d-flex align-items-center gap-2"><InputCheckbox class="form-check-input" @bind-Value="Model.IsLocked" /><label class="form-check-label" title="Lock expense from further edits">Locked</label></div>
                </div>
            </div>
        </div></div>

        <!-- SECTION 6: DIMENSIONS & OWNERSHIP -->
        <div class="card mt-4"><div class="card-body">
            <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-building me-2" style="font-size:22px;"></i> Dimensions & Ownership</h6>
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label">Branch</label><InputSelect class="form-select" @bind-Value="Model.BranchId" title="Header default branch"><option value="">-- Select Branch --</option>@foreach(var b in BranchList){<option value="@b.Key">@b.Value</option>}</InputSelect></div>
                <div class="col-md-3"><label class="form-label">Cost Center</label><InputText class="form-control" @bind-Value="Model.CostCenterName" placeholder="e.g. Production" title="Cost center name" /></div>
                <div class="col-md-3"><label class="form-label">Department</label><InputText class="form-control" @bind-Value="Model.DepartmentName" placeholder="e.g. Finance" title="Department name" /></div>
                <div class="col-md-3"><label class="form-label">Project</label><InputText class="form-control" @bind-Value="Model.ProjectName" placeholder="e.g. Showroom Expansion" title="Project name" /></div>
                <div class="col-md-3"><label class="form-label">Expense Owner</label><InputText class="form-control" @bind-Value="Model.ExpenseOwnerUserText" placeholder="e.g. finance.admin" title="Expense owner user (max 100)" /></div>
            </div>
        </div></div>

        <!-- SECTION 7: WORKFLOW & POSTING -->
        <div class="card mt-4"><div class="card-body">
            <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-git-merge me-2" style="font-size:22px;"></i> Workflow & Posting</h6>
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label">Prepared By <span class="text-danger">*</span></label><InputText class="form-control" @bind-Value="Model.PreparedByUserId" placeholder="e.g. finance.admin" title="User who prepared this expense" /><ValidationMessage For="@(() => Model.PreparedByUserId)" /></div>
                <div class="col-md-3"><label class="form-label">Submitted On</label><InputDate class="form-control" @bind-Value="Model.SubmittedOn" title="Date when expense was submitted" /></div>
                <div class="col-md-3"><label class="form-label">Reviewed By</label><InputText class="form-control" @bind-Value="Model.ReviewedByUserId" placeholder="Optional reviewer" title="User who reviewed" /></div>
                <div class="col-md-3"><label class="form-label">Reviewed On</label><InputDate class="form-control" @bind-Value="Model.ReviewedOn" title="Date of review" /></div>
                <div class="col-md-3"><label class="form-label">Approved By</label><InputText class="form-control" @bind-Value="Model.ApprovedByUserId" placeholder="Optional approver" title="User who approved" /></div>
                <div class="col-md-3"><label class="form-label">Approved On</label><InputDate class="form-control" @bind-Value="Model.ApprovedOn" title="Date of approval" /></div>
                <div class="col-md-6"><label class="form-label">Rejection Reason</label><InputText class="form-control" @bind-Value="Model.RejectionReason" placeholder="Required if status is Rejected (max 500)" title="Reason for rejection" /></div>
                <div class="col-md-6"><label class="form-label">Cancellation Reason</label><InputText class="form-control" @bind-Value="Model.CancellationReason" placeholder="Required if status is Cancelled (max 500)" title="Reason for cancellation" /></div>
            </div>
        </div></div>

        <!-- SECTION 8: EXPENSE LINES -->
        <div class="card mt-4"><div class="card-body">
            <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-list me-2" style="font-size:22px;"></i> Expense Lines</h6>
            <div class="table-responsive"><table class="table table-bordered table-sm">
                <thead><tr><th style="width:35px">#</th><th>Description <span class="text-danger">*</span></th><th>Category <span class="text-danger">*</span></th><th>GL Account <span class="text-danger">*</span></th><th style="width:80px">Qty</th><th style="width:90px">Unit Price</th><th style="width:100px">Net <span class="text-danger">*</span></th><th style="width:80px">Tax</th><th style="width:100px">Gross</th><th>Treatment</th><th style="width:90px">Svc Start</th><th style="width:90px">Svc End</th><th style="width:40px"></th></tr></thead>
                <tbody>@foreach (var l in Model.Lines) { var line = l;
                    <tr>
                        <td>@line.LineNumber</td>
                        <td><InputText class="form-control form-control-sm" @bind-Value="line.LineDescription" placeholder="Line description" /></td>
                        <td><InputSelect class="form-select form-select-sm" @bind-Value="line.ExpenseCategoryId"><option value="">-- Select --</option>@foreach(var cat in Categories){<option value="@cat.ExpenseCategoryId">@cat.CategoryName</option>}</InputSelect></td>
                        <td><InputSelect class="form-select form-select-sm" @bind-Value="line.GLAccountId"><option value="">-- Select --</option>@foreach(var a in GLAccounts){<option value="@a.Key">@a.Value</option>}</InputSelect></td>
                        <td><InputNumber class="form-control form-control-sm" @bind-Value="line.Quantity" placeholder="0" /></td>
                        <td><InputNumber class="form-control form-control-sm" @bind-Value="line.UnitPrice" placeholder="0.00" /></td>
                        <td><InputNumber class="form-control form-control-sm" @bind-Value="line.NetAmount" @oninput="RecalcTotals" /></td>
                        <td><InputNumber class="form-control form-control-sm" @bind-Value="line.TaxAmount" @oninput="RecalcTotals" /></td>
                        <td><div class="form-control form-control-sm bg-light">@((line.NetAmount + line.TaxAmount).ToString("N2"))</div></td>
                        <td><InputSelect class="form-select form-select-sm" @bind-Value="line.AccrualTreatment">@foreach(var v in Enum.GetValues<AccrualTreatmentEnum>()){<option value="@v">@v</option>}</InputSelect></td>
                        <td><InputDate class="form-control form-control-sm" @bind-Value="line.ServiceStartDate" /></td>
                        <td><InputDate class="form-control form-control-sm" @bind-Value="line.ServiceEndDate" /></td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLine(line)"><i class="ti ti-x"></i></button></td>
                    </tr>
                    <tr><td></td><td colspan="12"><InputText class="form-control form-control-sm" @bind-Value="line.LineNotes" placeholder="Line notes (optional, max 500)" /></td></tr>
                }</tbody>
            </table></div>
            <button type="button" class="btn btn-sm btn-outline-primary mt-2" @onclick="AddLine"><i class="ti ti-plus me-1"></i> Add Line</button>
        </div></div>

        <!-- SECTION 9: NOTES -->
        <div class="card mt-4"><div class="card-body">
            <h6 class="text-primary mb-3 d-flex align-items-center"><i class="ti ti-notes me-2" style="font-size:22px;"></i> Notes & Supporting Evidence</h6>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Notes</label><InputTextArea class="form-control" rows="2" @bind-Value="Model.Notes" placeholder="Additional notes (max 1500)..." /></div>
                <div class="col-md-6"><label class="form-label">Supporting Commentary</label><InputTextArea class="form-control" rows="2" @bind-Value="Model.SupportingCommentary" placeholder="Period-end support note, card transaction explanation (max 1500)..." /></div>
            </div>
        </div></div>

        <div class="text-end mt-4 mb-5">
            <a href="/expenses" class="btn btn-outline-secondary me-2"><i class="ti ti-x me-1"></i> Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> @(IsEdit ? "Update" : "Create")</button>
        </div>
    </EditForm>
</div>
