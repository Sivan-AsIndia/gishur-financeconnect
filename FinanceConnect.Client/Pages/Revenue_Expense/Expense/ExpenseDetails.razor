@page "/expenses/{Id:guid}/view"
@using static FinanceConnect.Client.ViewModels.ExpenseViewModel

@if (!isInitialized) { <div class="page-loading-overlay"><div class="whirly-loader"></div></div> }
else if (Exp == null) { <div class="content"><div class="alert alert-danger"><i class="ti ti-alert-circle me-2"></i>Expense not found.<a href="/expenses" class="alert-link ms-2">Return to list</a></div></div> }
else {
<div class="content">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h4 class="fw-bold mb-1">Expense Details</h4><p class="text-muted mb-0 small">Operational cost event record and posting status</p></div>
        <div class="d-flex gap-2 page-btn">
            @if (Exp.ExpenseStatus == ExpenseStatusEnum.Draft) { <a href="/expenses/edit/@Exp.ExpenseId" class="btn btn-primary"><i class="ti ti-edit me-1"></i> Edit</a> }
            <a class="btn btn-outline-secondary" href="/expenses"><i class="ti ti-arrow-left me-1"></i> Back</a>
        </div>
    </div>
    <div class="card">
        <!-- TOP HEADER CARD -->
        <div class="header-card"><div class="header-inner">
            <div class="header-left1">
                <div class="company-logo"><span class="logo-initials">@Exp.ExpenseCode?.Substring(0, Math.Min(2, Exp.ExpenseCode?.Length ?? 0)).ToUpper()</span></div>
                <div class="header-meta">
                    <h2 class="company-title">@Exp.ExpenseCode – @Exp.ExpenseTitle</h2>
                    <div class="company-subtitle">@Exp.ExpenseType <span class="dot">·</span> @Exp.PayeeType @if(!string.IsNullOrEmpty(Exp.PayeeNameSnapshot)){<span class="dot">·</span><span>@Exp.PayeeNameSnapshot</span>}</div>
                    <div class="header-tags">
                        <span class="tag tag-default" style="border:1px solid #0081ff;background:#e9f3ff;color:#1420ff;">@Exp.TimingTreatment</span>
                        <span class="tag tag-default" style="border:1px solid #c6b500;background:#f7ffdf;color:#b4ac00;">@Exp.PostingStatus</span>
                        @if(Exp.IsLocked){<span class="tag tag-default" style="border:1px solid #dc3545;background:#ffe0e0;color:#dc3545;">🔒 Locked</span>}
                    </div>
                </div>
            </div>
            <div class="header-right">
                @{ var sClass = Exp.ExpenseStatus switch { ExpenseStatusEnum.Posted or ExpenseStatusEnum.Closed => "status-active", ExpenseStatusEnum.Draft => "status-draft", _ => "status-inactive" }; }
                <span class="status-badge @sClass">● @Exp.ExpenseStatus.ToString().ToUpper()</span>
                <div class="created-info">Created @Exp.CreatedAt.ToString("dd MMM yyyy")</div>
            </div>
        </div></div>
        <div class="details-body">
            <!-- CORE IDENTITY -->
            <div class="section-block"> 
                <div class="section-header">
                <span class="section-icon" style="background: #dae4ff6e;
    padding: 2px 6px 0px 6px;
    border-radius: 5px;
    border: 1px solid #3741ff;
    color: #0037ff;"> <i class="ti ti-id"></i></span>
                <div class="section-title"> Core Identity</div>
                </div>
                <div class="section-content">
                    <div class="fields-grid fields-grid-3">
                        <div class="field-item"><small class="field-label field-label">Expense Code</small><div class="field-value fw">@Exp.ExpenseCode</div></div>
                        <div class="field-item"><small class="text-muted field-label">Expense Title</small><div class="field-value fw">@Exp.ExpenseTitle</div></div>
                        <div class="field-item"><small class="text-muted field-label">Type</small><div class="field-value fw">@Exp.ExpenseType</div></div>
                        <div class="field-item"><small class="text-muted field-label">Status</small><div class="field-value fw"><span class="badge @GetStatusBadge(Exp.ExpenseStatus)">@Exp.ExpenseStatus</span></div></div>
                    @if(!string.IsNullOrEmpty(Exp.Description)){<div class="field-item"><small class="text-muted field-label">Description</small><div class="field-value fw">@Exp.Description</div></div>}
              </div>
                </div>
                
            </div>
            <!-- PAYEE & SOURCE -->
            <div class="section-block">
            <div class="section-header">
            <span class="section-icon" style="background:#fe6dde36;
    padding: 2px 6px 0px 6px;
    border-radius: 5px;
    border: 1px solid #ff79f2;
    color: #eb0091;"><i class="ti ti-users"></i> </span>
            <div class="section-block">
                <div class="section-title">Payee & Source Context</div>
                </div>
                </div>
                <div class="section-content">
                    <div class="fields-grid fields-grid-3">
                    <div class="field-item"><small class="text-muted field-label">Payee Type</small><div class="field-value fw">@Exp.PayeeType</div></div>
                    <div class="field-item"><small class="text-muted field-label">Payee</small><div class="field-value fw">@(Exp.PayeeNameSnapshot ?? "–") @(string.IsNullOrEmpty(Exp.PayeeCodeSnapshot) ? "" : $"({Exp.PayeeCodeSnapshot})")</div></div>
                    <div class="field-item"><small class="text-muted field-label">Source Document Type</small><div class="field-value fw">@Exp.SourceDocumentType</div></div>
                    <div class="field-item"><small class="text-muted field-label">Source Document No</small><div class="field-value fw">@(Exp.SourceDocumentNumber ?? "–")</div></div>
                    <div class="field-item"><small class="text-muted field-label">Supplier Invoice #</small><div class="field-value fw">@(Exp.SupplierInvoiceNumber ?? "–")</div></div>
                </div>
                </div>
                </div>
            <!-- DATES & AMOUNTS -->
            <div class="section-block">
                <div class="section-header">
                <span class="section-icon" style="    background: #daffde61;
    padding: 3px 6px 2px 6px;
    border-radius: 5px;
    border: 1px solid #12e141;
    color: #00ce3f;"> <i class="ti ti-currency-rupee"></i></span>
                <div class="section-title"> Dates & Amounts</div>
                </div>
                <div class="section-content">
                    <div class="fields-grid fields-grid-3">
                    <div class="field-item"><small class="text-muted field-label">Expense Date</small><div class="field-value fw">@(Exp.ExpenseDate?.ToString("dd MMM yyyy") ?? "–")</div></div>
                    <div class="field-item"><small class="text-muted field-label">Posting Date</small><div class="field-value fw">@(Exp.PostingDate?.ToString("dd MMM yyyy") ?? "–")</div></div>
                    <div class="field-item"><small class="text-muted field-label">Coverage Start</small><div class="field-value fw">@(Exp.CoverageStartDate?.ToString("dd MMM yyyy") ?? "–")</div></div>
                    <div class="field-item"><small class="text-muted field-label">Coverage End</small><div class="field-value fw">@(Exp.CoverageEndDate?.ToString("dd MMM yyyy") ?? "–")</div></div>
                    <div class="field-item"><small class="text-muted field-label">Net Amount</small><div class="fw-medium field-value">₹@Exp.TotalNetAmount.ToString("N2")</div></div>
                    <div class="field-item"><small class="text-muted field-label">Tax Amount</small><div class="field-value fw">₹@Exp.TotalTaxAmount.ToString("N2")</div></div>
                    <div class="field-item"><small class="text-muted field-label">Gross Amount</small><div class="fw-bold field-value text-primary">₹@Exp.TotalGrossAmount.ToString("N2")</div></div>
                    <div class="field-item"><small class="text-muted field-label">Adjustment</small><div class="field-value fw">₹@(Exp.AdjustmentAmount?.ToString("N2") ?? "0.00")</div></div>
                    <div class="field-item"><small class="text-muted field-label">Tax Inclusive</small><div class="field-value fw">@(Exp.TaxInclusiveFlag ? "Yes" : "No")</div></div>
                    <div class="field-item"><small class="text-muted field-label">Receipt Required</small><div class="field-value fw">@(Exp.ReceiptRequiredFlag ? "Yes" : "No")</div></div>
                </div></div>
                </div>
            <!-- TIMING & POSTING -->
            <div class="section-block">
                <div class="section-header">
                    <span class="section-icon" style="    background: #6debfe2b;
    padding: 2px 6px 0px 6px;
    border-radius: 5px;
    border: 1px solid #00a785;
    color: #008f9c;"><i class="ti ti-clock"></i></span>
                <div class="section-title"> Timing & Posting</div>
                </div>
                <div class="section-content">
                    <div class="fields-grid fields-grid-3">

                        <div class="field-item"><small class="field-label">Timing Treatment</small><div class="field-value"><span class="badge bg-info-transparent">@Exp.TimingTreatment</span></div></div>
                        <div class="field-item"><small class="field-label">Timing Status</small><div class="field-value">@Exp.TimingTreatmentStatus</div></div>
                        <div class="field-item"><small class="field-label">Posting Status</small><div class="field-value"><span class="badge @GetPostingBadge(Exp.PostingStatus)">@Exp.PostingStatus</span></div></div>
                        <div class="field-item"><small class="field-label">Budget Check</small><div class="field-value">@Exp.BudgetCheckStatus</div></div>
                        <div class="field-item"><small class="field-label">Accrual Required</small><div class="field-value">@(Exp.AccrualRequiredFlag ? "Yes" : "No")</div></div>
                        <div class="field-item"><small class="field-label">Prepayment Required</small><div class="field-value">@(Exp.PrepaymentRequiredFlag ? "Yes" : "No")</div></div>
                        <div class="field-item"><small class="field-label">Locked</small><div class="field-value">@(Exp.IsLocked ? "Yes" : "No")</div></div>
                        @if (Exp.LockedOn.HasValue)
                        {
                            <div class="field-item"><small class="text-muted field-label">Locked On</small><div class="field-value">@Exp.LockedOn?.ToString("dd MMM yyyy")</div></div>
                        }
                        <div class="field-item"><small class="text-muted field-label">Attachment Count</small><div class="field-value">@Exp.AttachmentCount</div></div>
                </div></div>
                </div>
            <!-- DIMENSIONS -->
            <div class="section-block">
                <div class="section-header">
                    <span class="section-icon" style="background: #ff708d30;
    padding: 2px 6px 0px 6px;
    border-radius: 5px;
    border: 1px solid #ff2173;
    color: #ff1b2d;"><i class="ti ti-building"></i> </span>
                <div class="section-title">Dimensions & Ownership</div>
                </div>
                <div class="section-content">
                    <div class="fields-grid fields-grid-3">
                        <div class="field-item"><small class="text-muted field-label">Branch</small><div class="field-value">@(Exp.BranchName ?? "–")</div></div>
                        <div class="field-item"><small class="text-muted field-label">Department</small><div class="field-value">@(Exp.DepartmentName ?? "–")</div></div>
                        <div class="field-item"><small class="text-muted field-label">Cost Center</small><div class="field-value">@(Exp.CostCenterName ?? "–")</div></div>
                        <div class="field-item"><small class="text-muted field-label">Project</small><div class="field-value">@(Exp.ProjectName ?? "–")</div></div>
                        <div class="field-item"><small class="text-muted field-label">Expense Owner</small><div class="field-value">@(Exp.ExpenseOwnerUserText ?? "–")</div></div>
                </div></div>
                </div>
            <!-- WORKFLOW -->
            <div class="section-block">
                <div class="section-header">
                    <span class="section-icon" style="    background: #f8c5051f;
    padding: 2px 6px 0px 6px;
    border-radius: 5px;
    border: 1px solid #a7b500;
    color: #c0a700;"><i class="ti ti-git-merge"></i></span>
                <div class="section-title"> Workflow</div>
                </div>
                <div class="section-content">
                    <div class="fields-grid fields-grid-3">
                        <div class="field-item"><small class="text-muted field-label">Prepared By</small><div>@Exp.PreparedByUserId</div></div>
                        <div class="field-item"><small class="text-muted field-label">Submitted On</small><div>@(Exp.SubmittedOn?.ToString("dd MMM yyyy") ?? "–")</div></div>
                        <div class="field-item"><small class="text-muted field-label">Reviewed By</small><div>@(Exp.ReviewedByUserId ?? "–")</div></div>
                        <div class="field-item"><small class="text-muted field-label">Reviewed On</small><div>@(Exp.ReviewedOn?.ToString("dd MMM yyyy") ?? "–")</div></div>
                        <div class="field-item"><small class="text-muted field-label">Approved By</small><div>@(Exp.ApprovedByUserId ?? "–")</div></div>
                        <div class="field-item"><small class="text-muted field-label">Approved On</small><div>@(Exp.ApprovedOn?.ToString("dd MMM yyyy") ?? "–")</div></div>
                        @if (!string.IsNullOrEmpty(Exp.RejectionReason))
                        {
                            <div class="field-item"><small class="text-muted text-danger field-label">Rejection Reason</small><div class="text-danger field-value">@Exp.RejectionReason</div></div>
                        }
                        @if (!string.IsNullOrEmpty(Exp.CancellationReason))
                        {
                            <div class="field-item"><small class="text-muted text-secondary field-label">Cancellation Reason</small><div class="field-value">@Exp.CancellationReason</div></div>
                        }
                </div></div>
                </div>
            <!-- EXPENSE LINES -->
            @if (Exp.Lines.Any()) {
            <div class="section-block">
                    <div class="section-header">
                        <span class="section-icon" style="    background: #f8c5051f;
    padding: 2px 6px 0px 6px;
    border-radius: 5px;
    border: 1px solid #a7b500;
        color: #c0a700;"><i class="ti ti-list"></i> </span>
                <div class="section-title">Expense Lines</div>
                </div>
                <div class="table-responsive"><table class="table table-bordered table-sm">
                    <thead><tr><th>#</th><th>Description</th><th>Category</th><th>GL Account</th><th class="text-end">Qty</th><th class="text-end">Unit Price</th><th class="text-end">Net</th><th class="text-end">Tax</th><th class="text-end">Gross</th><th>Treatment</th><th>Service Period</th></tr></thead>
                    <tbody>@foreach (var l in Exp.Lines.OrderBy(x => x.LineNumber)) {
                        <tr>
                            <td>@l.LineNumber</td><td>@l.LineDescription</td><td>@(l.ExpenseCategoryName ?? "–")</td><td>@(l.GLAccountName ?? "–")</td>
                            <td class="text-end">@(l.Quantity?.ToString("N2") ?? "–")</td><td class="text-end">@(l.UnitPrice?.ToString("N2") ?? "–")</td>
                            <td class="text-end">₹@l.NetAmount.ToString("N2")</td><td class="text-end">₹@l.TaxAmount.ToString("N2")</td><td class="text-end fw-medium">₹@l.GrossAmount.ToString("N2")</td>
                            <td><span class="badge bg-info-transparent">@l.AccrualTreatment</span></td>
                            <td>@(l.ServiceStartDate?.ToString("dd MMM") ?? "–") — @(l.ServiceEndDate?.ToString("dd MMM yyyy") ?? "–")</td>
                        </tr>
                        @if(!string.IsNullOrEmpty(l.LineNotes)){<tr><td></td><td colspan="10"><small class="text-muted"><i class="ti ti-note me-1"></i>@l.LineNotes</small></td></tr>}
                    }</tbody>
                </table></div>
            </div>}
            <!-- NOTES -->
            @if(!string.IsNullOrEmpty(Exp.Notes) || !string.IsNullOrEmpty(Exp.SupportingCommentary)){
            <div class="section-block"><div class="section-title"><i class="ti ti-notes me-2"></i> Notes & Supporting Evidence</div>
                <div class="row">
                    @if(!string.IsNullOrEmpty(Exp.Notes)){<div class="col-md-6 mb-2"><small class="text-muted">Notes</small><div>@Exp.Notes</div></div>}
                    @if(!string.IsNullOrEmpty(Exp.SupportingCommentary)){<div class="col-md-6 mb-2"><small class="text-muted">Supporting Commentary</small><div>@Exp.SupportingCommentary</div></div>}
                </div></div>}
        </div>
    </div>
</div>
}
