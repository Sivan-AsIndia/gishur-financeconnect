@page "/revenues"
@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels
@using static FinanceConnect.Client.ViewModels.RevenueViewModel

<style>
    @@media (max-width:635px) { .responsivefilter { flex-wrap: wrap; } }
    /* .rv-col-name   { width: 26%; }
    .rv-col-cust   { width: 16%; }
    .rv-col-type   { width: 11%; }
    .rv-col-amt    { width: 13%; }
    .rv-col-stat   { width: 10%; }
    .rv-col-recog  { width: 10%; }
    .rv-col-action { width: 8%;  }
    .cell-wrap { word-break: break-word; overflow-wrap: break-word; } */
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
    }

    <div class="content List-view">

        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Revenue</h4>
                    <h6>Operational income event records &amp; recognition tracking</h6>
                </div>
            </div>
            <ul class="table-top-head me-2">
                <li><a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync"><i class="ti ti-refresh"></i></a></li>
            </ul>
            <div class="page-btn">
                <a href="/revenues/create" class="btn btn-primary"><i class="ti ti-circle-plus me-1"></i>Create</a>
            </div>
        </div>

        <div class="card">

            <!-- Search + all filters in one row -->
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm"
                               placeholder="Search name, code or customer..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>
                <div style="display:flex; gap:10px;" class="responsivefilter">
                    <select class="form-select form-select-sm" style="min-width:150px"
                            @bind="SelectedStatusFilter" @bind:event="oninput" @onchange="OnFilterChanged">
                        <option value="">All Status</option>
                        @foreach (var v in Enum.GetValues<RevenueStatus>()) { <option value="@v">@v</option> }
                    </select>
                    <select class="form-select form-select-sm" style="min-width:150px"
                            @bind="SelectedTypeFilter" @bind:event="oninput" @onchange="OnFilterChanged">
                        <option value="">All Types</option>
                        @foreach (var v in Enum.GetValues<RevenueType>()) { <option value="@v">@v</option> }
                    </select>
                    <select class="form-select form-select-sm" style="min-width:160px"
                            @bind="SelectedCompanyFilter" @bind:event="oninput" @onchange="OnFilterChanged">
                        <option value="">All Companies</option>
                        @foreach (var c in Companies) { <option value="@c.Id">@c.LegalName</option> }
                    </select>
                </div>
            </div>

            <div class="card-body p-0">
                <table class="table align-middle w-100 table-fixed">
                    <thead class="thead-light">
                        <tr>
                            <th class="d-xl-none" style="width:40px"></th>
                            <th class="rv-col-name" style="width: 298px;">Revenue Name</th>
                            <th class="d-none d-md-table-cell rv-col-cust">Customer</th>
                            <th class="d-none d-md-table-cell rv-col-type text-center">Type</th>
                            <th class="d-none d-xl-table-cell rv-col-amt text-center">Gross Amount</th>
                            <th class="d-none d-xl-table-cell rv-col-stat">Status</th>
                            <th class="d-none d-xxl-table-cell rv-col-recog">Recognition</th>
                            <th class="rv-col-action">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (PagedItems.Any())
                        {
                            @foreach (var r in PagedItems)
                            {
                                <tr>
                                    <td class="d-xl-none text-center" style="padding:0;padding-left:15px;">
                                        <a href="javascript:void(0);" class="TablePlus"
                                           data-bs-toggle="modal" data-bs-target="#rowDetailsModal"
                                           @onclick="() => SelectItem(r)">
                                            <i class="ti ti-plus"></i>
                                        </a>
                                    </td>

                                    <!-- Revenue Name column with external-link icon, code as sub-text -->
                                    <td>
                                        <span class="fw-medium">
                                            <i class="ti ti-external-link me-2 PopupIcon"></i>
                                            <a href="/revenues/@r.RevenueId/view" data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               class="link-View text-decoration-none"
                                               title="View @r.RevenueName details">@r.RevenueName</a>
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(r.RevenueCode))
                                        {
                                            <div class="text-muted small">@r.RevenueCode</div>
                                        }
                                        @if (r.IsLocked)
                                        {
                                            <span class="badge bg-danger-transparent ms-1" style="font-size:10px;">
                                                <i class="ti ti-lock me-1" style="font-size:9px;"></i>Locked
                                            </span>
                                        }
                                    </td>

                                    <td class="d-none d-md-table-cell cell-wrap">@(r.CustomerNameSnapshot ?? "—")</td>

                                    <td class="d-none d-md-table-cell cell-wrap text-center">
                                        <span class="badge bg-info-transparent text-info">@r.RevenueType</span>
                                    </td>

                                    <td class="d-none d-xl-table-cell text-end fw-medium">
                                        <div style="width: 120px;">
                                            @GetCurrencySymbol(r.CurrencyId) @r.GrossRevenueAmount.ToString("N2")
                                    </div>
                                    </td>

                                    <td class="d-none d-xl-table-cell">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="ActiveDot @GetStatusDot(r.Status)"></div>
                                            <span>@r.Status</span>
                                        </div>
                                    </td>

                                    <td class="d-none d-xxl-table-cell cell-wrap">
                                        <span class="badge @GetRecognitionBadgeClass(r.RecognitionStatus)">@r.RecognitionStatus</span>
                                    </td>

                                    <td class="action-table-data">
                                        <div class="edit-delete-action">
                                            @if (!r.IsLocked)
                                            {
                                                <a class="me-2 p-1 edit-icon" title="Edit Revenue"
                                                   @onclick='() => Nav.NavigateTo($"/revenues/{r.RevenueId}")'>
                                                    <i data-feather="edit"></i>
                                                </a>
                                                <a class="me-2 p-1 delete-icon" title="Delete Revenue"
                                                   data-bs-toggle="modal" data-bs-target="#delete-modal"
                                                   @onclick="() => SelectItem(r)">
                                                    <i data-feather="trash-2"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="me-2 p-1 text-muted" style="cursor:not-allowed;opacity:0.4;" title="Locked">
                                                    <i data-feather="edit"></i>
                                                </a>
                                                <a class="me-2 p-1 Toggle-icon action-icon activate-icon"
                                                   href="javascript:void(0);" title="Unlock Revenue"
                                                   data-bs-toggle="modal" data-bs-target="#unlock-modal"
                                                   @onclick="() => SelectItem(r)">
                                                    <i class="ti ti-lock-open"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                    No revenue records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (FilteredItems.Count > 0)
            {
                <div class="d-flex align-items-center justify-content-between p-3">
                    <div class="d-flex align-items-center fs-13">
                        <span class="me-2">Rows per page</span>
                        <select class="form-select form-select-sm" style="width:80px" @onchange="OnPageSizeChange">
                            <option value="5"  selected="@(PageSize == 5)">5</option>
                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                        <span class="ms-2">Entries</span>
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage"><i class="ti ti-chevron-left"></i></a>
                            </li>
                            @foreach (var p in VisiblePages)
                            {
                                <li class="page-item @(p == CurrentPage ? "active" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(p)">@p</a>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="NextPage"><i class="ti ti-chevron-right"></i></a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
}

<!-- Lock Modal -->
<div class="modal fade" id="lock-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="page-wrapper-new p-0">
        <div class="p-5 px-3 text-center">
            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2"><i class="ti ti-lock fs-24 text-warning"></i></span>
            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Lock Revenue Record</h4>
            <p class="text-gray-6 mb-0 fs-16">Lock <strong>@SelectedItem?.RevenueCode</strong>? Locked records cannot be edited.</p>
            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="LockConfirmed" data-bs-dismiss="modal"><i class="ti ti-lock me-1"></i>Yes, Lock</button>
            </div>
        </div>
    </div></div></div>
</div>

<!-- Unlock Modal -->
<div class="modal fade" id="unlock-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="page-wrapper-new p-0">
        <div class="p-5 px-3 text-center">
            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2"><i class="ti ti-lock-open fs-24 text-success"></i></span>
            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Unlock Revenue Record</h4>
            <p class="text-gray-6 mb-0 fs-16">Are you sure you want to unlock <strong>@SelectedItem?.RevenueCode</strong>?</p>
            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="UnlockConfirmed" data-bs-dismiss="modal"><i class="ti ti-lock-open me-1"></i>Yes, Unlock</button>
            </div>
        </div>
    </div></div></div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="page-wrapper-new p-0">
        <div class="p-5 px-3 text-center">
            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Revenue</h4>
            <p class="text-gray-6 mb-0 fs-16">Are you sure you want to delete <strong>@SelectedItem?.RevenueCode</strong> — @SelectedItem?.RevenueName?</p>
            <div class="alert alert-danger mt-3 text-start small"><i class="ti ti-alert-triangle me-2"></i>This action cannot be undone.</div>
            <div class="modal-footer-btn mt-3 d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteConfirmed" data-bs-dismiss="modal"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
            </div>
        </div>
    </div></div></div>
</div>

<!-- Responsive Row Modal -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Revenue Details</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" style="padding:0;right:22px;position:absolute;transform:none"></button>
        </div>
        @if (SelectedItem != null)
        {
            <div class="modal-body">
                <div class="mb-2 d-flex gap-3"><strong>Code:</strong><div>@(SelectedItem.RevenueCode ?? "—")</div></div>
                <div class="mb-2 d-flex gap-3"><strong>Name:</strong><div>@SelectedItem.RevenueName</div></div>
                <div class="mb-2 d-flex gap-3"><strong>Customer:</strong><div>@(SelectedItem.CustomerNameSnapshot ?? "—")</div></div>
                <div class="mb-2 d-flex gap-3"><strong>Type:</strong><span class="badge bg-info-transparent text-info">@SelectedItem.RevenueType</span></div>
                <div class="mb-2 d-flex gap-3"><strong>Gross Amount:</strong><div>@GetCurrencySymbol(SelectedItem.CurrencyId) @SelectedItem.GrossRevenueAmount.ToString("N2")</div></div>
                <div class="mb-2 d-flex gap-3"><strong>Status:</strong><span class="badge @GetStatusBadgeClass(SelectedItem.Status)">@SelectedItem.Status</span></div>
                <div class="mb-2 d-flex gap-3"><strong>Recognition:</strong><span class="badge @GetRecognitionBadgeClass(SelectedItem.RecognitionStatus)">@SelectedItem.RecognitionStatus</span></div>
                <div class="mb-2 d-flex gap-3"><strong>Billing:</strong><span class="badge @GetBillingBadgeClass(SelectedItem.BillingStatus)">@SelectedItem.BillingStatus</span></div>
            </div>
        }
    </div></div>
</div>
