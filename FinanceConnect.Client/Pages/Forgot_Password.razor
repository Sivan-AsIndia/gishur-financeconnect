@page "/Forgot-password"
@layout AuthLayout
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ToastService ToastService

<style>
    .login-wrapper-centered {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1a1c2e 0%, #2d3154 50%, #1a1c2e 100%);
        position: relative;
        overflow: hidden;
    }

    .login-wrapper-centered::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(254, 159, 67, 0.1) 0%, transparent 50%);
        animation: pulse 15s ease-in-out infinite;
    }

    .login-wrapper-centered::after {
        content: '';
        position: absolute;
        bottom: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(254, 159, 67, 0.05) 0%, transparent 40%);
        animation: pulse 20s ease-in-out infinite reverse;
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 0.5; }
        50% { transform: scale(1.1); opacity: 0.8; }
    }

    .login-card {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        padding: 40px;
        width: 100%;
        max-width: 450px;
        position: relative;
        z-index: 10;
        backdrop-filter: blur(10px);
    }

    .login-card .login-logo {
        text-align: center;
        margin-bottom: 30px;
    }

    .login-card .login-logo img {
        max-height: 60px;
        width: auto;
    }

    .login-card .login-userheading {
        text-align: center;
        margin-bottom: 30px;
    }

    .login-card .login-userheading h3 {
        color: #1a1c2e;
        font-weight: 700;
        font-size: 28px;
        margin-bottom: 10px;
    }

    .login-card .login-userheading h4 {
        color: #6c757d;
        font-weight: 400;
    }


    .copyright-text p {
        color: #6c757d;
        font-size: 10px;
    }
    .text-orange {
        color: color-mix(in srgb, var(--primary) 94%, white) !important;
    }

        .text-orange:hover {
            color: var(--primary) !important;
        }
</style>

<div class="login-wrapper-centered">
    <div class="login-card">
        @if (!showResetForm)
        {
            <EditForm Model="@forgotModel" OnValidSubmit="HandleForgotPassword">
                <div class="login-logo">
                    <img src="assets/images/logo.png" alt="Gishur Finance">
                </div>
                <div class="login-userheading">
                    <h3>Forgot Password?</h3>
                    <h4 class="fs-16">If you forgot your password, we'll email you a code to reset it.</h4>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <InputText @bind-Value="forgotModel.Email" class="form-control border-end-0" placeholder="Enter your email" />
                        <span class="input-group-text border-start-0">
                            <i class="ti ti-mail"></i>
                        </span>
                    </div>
                </div>
                <div class="form-login mt-4">
                    <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>Send Reset Code</span>
                        }
                    </button>
                </div>
                <div class="signinform mt-4 text-center">
                    <h4 style="font-size: 14px !important;">Return to <a href="/Login" class="text-orange fw-medium">Login</a></h4>
                </div>
				<div class="form-setlogin or-text my-3 d-flex justify-content-center">
                    <h4 class="m-0" style="font-size: 14px !important;">OR</h4>
				</div>
                <div class="signinform text-center">
                    <h4 style="font-size: 14px !important;">Already have a code? <a href="javascript:void(0);" class="text-orange fw-medium" @onclick="ShowResetForm">Enter it here</a></h4>
                </div>
                <div class="mt-4 d-flex justify-content-center align-items-center copyright-text">
                    <p class="mb-0">Copyright © 2026 FinanceConnect. All rights reserved.</p>
                </div>
            </EditForm>
        }
        else
        {
            <EditForm Model="@resetModel" OnValidSubmit="HandleResetPassword">
                <div class="login-logo">
                    <img src="assets/images/logo.png" alt="Gishur Finance">
                </div>
                <div class="login-userheading">
                    <h3>Reset Password</h3>
                    <h4 class="fs-16">Enter the code sent to your email and set your new password.</h4>
                </div>

                <div class="mb-3">
                    <label class="form-label">Reset Code <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <InputText @bind-Value="resetModel.Token" class="form-control border-end-0" placeholder="Enter 6-digit code" maxlength="6" />
                        <span class="input-group-text border-start-0">
                            <i class="ti ti-key"></i>
                        </span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">New Password <span class="text-danger">*</span></label>
                    <div class="pass-group">
                        <InputText type="@(showPassword ? "text" : "password")" @bind-Value="resetModel.NewPassword" class="pass-input form-control" placeholder="Enter new password" />
                        <span class="ti toggle-password @(showPassword ? "ti-eye" : "ti-eye-off") text-gray-9" @onclick="TogglePasswordVisibility" style="cursor: pointer;"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Confirm New Password <span class="text-danger">*</span></label>
                    <div class="pass-group">
                        <InputText type="@(showConfirmPassword ? "text" : "password")" @bind-Value="resetModel.ConfirmNewPassword" class="pass-inputs form-control" placeholder="Confirm new password" />
                        <span class="ti toggle-passwords @(showConfirmPassword ? "ti-eye" : "ti-eye-off") text-gray-9" @onclick="ToggleConfirmPasswordVisibility" style="cursor: pointer;"></span>
                    </div>
                </div>
                <div class="form-login mt-4">
                    <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Resetting...</span>
                        }
                        else
                        {
                            <span>Reset Password</span>
                        }
                    </button>
                </div>
                <div class="signinform mt-4 text-center">
                    <h4 style="font-size: 14px !important;"><a href="javascript:void(0);" class="text-orange fw-medium" @onclick="HideResetForm">Back to send code</a></h4>
                </div>
                <div class="mt-4 d-flex justify-content-center align-items-center copyright-text">
                    <p class="mb-0">Copyright © 2026 FinanceConnect. All rights reserved.</p>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    private ForgotPasswordRequest forgotModel = new();
    private ResetPasswordRequest resetModel = new();
    private bool isLoading = false;
    private bool showResetForm = false;
    private bool showPassword = false;
    private bool showConfirmPassword = false;

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword = !showConfirmPassword;
    }

    private void ShowResetForm()
    {
        showResetForm = true;
    }

    private void HideResetForm()
    {
        showResetForm = false;
    }

    private async Task HandleForgotPassword()
    {
        if (string.IsNullOrWhiteSpace(forgotModel.Email))
        {
            ToastService.ShowError("Email is required.", "Validation Error");
            return;
        }

        isLoading = true;
        try
        {
            var response = await AuthService.ForgotPasswordAsync(forgotModel);
            if (response.Success)
            {
                ToastService.ShowSuccess(response.Message + " Check your inbox.", "Code Sent");
                await Task.Delay(1500);
                showResetForm = true;
            }
            else
            {
                ToastService.ShowError(response.Message, "Failed");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"An error occurred: {ex.Message}", "Error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleResetPassword()
    {
        if (string.IsNullOrWhiteSpace(resetModel.Token))
        {
            ToastService.ShowError("Reset code is required.", "Validation Error");
            return;
        }

        if (string.IsNullOrWhiteSpace(resetModel.NewPassword))
        {
            ToastService.ShowError("New password is required.", "Validation Error");
            return;
        }

        if (resetModel.NewPassword.Length < 6)
        {
            ToastService.ShowError("Password must be at least 6 characters long.", "Validation Error");
            return;
        }

        if (resetModel.NewPassword != resetModel.ConfirmNewPassword)
        {
            ToastService.ShowError("Passwords do not match.", "Validation Error");
            return;
        }

        isLoading = true;
        try
        {
            var response = await AuthService.ResetPasswordAsync(resetModel);
            if (response.Success)
            {
                ToastService.ShowSuccess(response.Message, "Password Reset Successful");
                await Task.Delay(2000);
                Navigation.NavigateTo("/Login");
            }
            else
            {
                ToastService.ShowError(response.Message, "Reset Failed");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"An error occurred: {ex.Message}", "Error");
        }
        finally
        {
            isLoading = false;
        }
    }
}
