@page "/customer-credit-notes"
<link rel="stylesheet" href="css/VendorCreditView.css" />

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content vcn-list-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Customer Credit Note List</h4>
                    <h6>Manage your AR credit notes</h6>
                </div>
            </div>
            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>
            <div class="page-btn">
                <a href="/customer-credit-notes/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>Create
                </a>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="row mb-3">
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-2">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #009ac8, #00bfc1) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Total</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.TotalCreditNotes</h5>
                            </div>
                            <div class="stat-icon rounded-circle p-2" style="background:#ffffff47;width:36px;height:36px;display:flex;align-items:center;justify-content:center;">
                                <i class="ti ti-file-invoice text-white" style="font-size:20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-2">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #092c4c, #00396e) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1 small text-white">Draft</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.DraftCreditNotes</h5>
                            </div>
                            <div class="stat-icon rounded-circle p-2" style="background:#ffffff47;width:36px;height:36px;display:flex;align-items:center;justify-content:center;">
                                <i class="ti ti-file-text text-white" style="font-size:20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-2">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #155eef, #002e8b) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1 small text-white">Submitted</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.SubmittedCreditNotes</h5>
                            </div>
                            <div class="stat-icon rounded-circle p-2" style="background:#ffffff47;width:36px;height:36px;display:flex;align-items:center;justify-content:center;">
                                <i class="ti ti-send text-white" style="font-size:20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-2">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(343deg, #b73e3e, #ff8d21) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1 small text-white">Approved</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.ApprovedCreditNotes</h5>
                            </div>
                            <div class="stat-icon rounded-circle p-2" style="background:#ffffff47;width:36px;height:36px;display:flex;align-items:center;justify-content:center;">
                                <i class="ti ti-check text-white" style="font-size:20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-2">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #3eb780, #008146) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1 small text-white">Posted</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.PostedCreditNotes</h5>
                            </div>
                            <div class="stat-icon rounded-circle p-2" style="background:#ffffff47;width:36px;height:36px;display:flex;align-items:center;justify-content:center;">
                                <i class="ti ti-circle-check text-white" style="font-size:20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-2">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #ffca1f, #e8b200) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1 small text-white">Total Amount</h6>
                                <h5 class="mb-0 fw-bold text-white" style="font-size:14px;">@Statistics.TotalCreditNoteAmount.ToString("N0")</h5>
                            </div>
                            <div class="stat-icon rounded-circle p-2" style="background:#ffffff47;width:36px;height:36px;display:flex;align-items:center;justify-content:center;">
                                <i class="ti ti-currency-rupee text-white" style="font-size:20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search & Filters -->
        <div class="d-flex gap-2 align-items-end justify-content-between mb-3">
            <div class="search-input mb-2" style="display: flex; border: 1px solid #80808033; padding-left: 10px; border-radius: 6px; background: white;">
                <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                <input type="search" class="form-control form-control-sm" placeholder="Search credit note no, customer..."
                       @bind="searchTerm" @oninput="OnSearch" style="background: transparent; border: none; outline: none !important" />
            </div>
            <div class="d-flex gap-2 align-items-end">
                <select class="form-select form-select-sm" style="min-width:130px" @bind="selectedStatus" @bind:after="ApplyFilters">
                    <option value="">All Status</option>
                    @foreach (var status in DistinctStatuses)
                    {
                        <option value="@status">@CreditNoteStatuses.GetDisplayName(status)</option>
                    }
                </select>
                <div class="d-flex gap-3 align-items-end">
                    <div class="filter-date">
                        <label class="form-label small mb-1">From</label>
                        <input type="date" class="form-control form-control-sm" style="min-width:125px"
                               @bind="FromDate" @bind:after="ApplyFilters" />
                    </div>
                    <div class="filter-date">
                        <label class="form-label small mb-1">To</label>
                        <input type="date" class="form-control form-control-sm" style="min-width:125px"
                               @bind="ToDate" @bind:after="ApplyFilters" />
                    </div>
                </div>
            </div>
        </div>

        <!-- List View + Side Drawer -->
        <div class="vcn-split-layout @(SelectedCreditNote != null ? "drawer-open" : "")">

            <!-- LEFT: List Panel -->
            <div class="vcn-list-panel card" style="border: 1px solid #8080801f; box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px; display: flex; justify-content: space-between; padding: 10px;">

                <!-- Credit Note Rows -->
                <div class="vcn-list-items">
                    @if (PagedCreditNotes.Any())
                    {
                        @foreach (var cn in PagedCreditNotes)
                        {
                            <div class="vcn-list-item @(SelectedCreditNote?.Id == cn.Id ? "active" : "")"
                                 @onclick="() => OpenRowDetails(cn)">
                                <div class="vcn-item-left">
                                    <div class="vcn-item-number fw-bold">@cn.CreditNoteNumber</div>
                                    <div class="vcn-item-vendor text-muted small">@TruncateName(cn.CustomerName, 22)</div>
                                </div>
                                <div class="vcn-item-right">
                                    <div class="vcn-item-date text-muted small mb-1">@cn.CreditNoteDate.ToString("dd MMM")</div>
                                    <span class="badge @GetStatusBadgeClass(cn.Status)">
                                        @CreditNoteStatuses.GetDisplayName(cn.Status)
                                    </span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="ti ti-database-off fs-1 d-block mb-2"></i>
                            No credit notes found.
                        </div>
                    }
                </div>

                <!-- Pagination -->
                <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                    <div class="d-flex align-items-center">
                        <span class="me-2 small">Rows per page</span>
                        <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChange">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <span class="ms-3 text-muted">
                            Entries
                        </span>
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                    <i class="ti ti-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                    <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages || TotalPages == 0 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                    <i class="ti ti-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>

            <!-- RIGHT: Side Drawer Detail Panel -->
            @if (SelectedCreditNote != null)
            {
                <div class="vcn-drawer card border-0 shadow-sm">
                    <div class="vcn-drawer-header p-3 border-bottom d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="fw-bold mb-0">@SelectedCreditNote.CreditNoteNumber</h5>
                            <small class="text-muted">@SelectedCreditNote.CustomerName</small>
                        </div>
                        <button class="btn btn-sm btn-light vcn-drawer-close" @onclick="CloseDrawer" title="Close">
                            <i class="ti ti-x"></i>
                        </button>
                    </div>
                    <div class="vcn-drawer-body p-3">
                        <div class="vcn-amount-card rounded-3 p-3 mb-3">
                            <div class="small text-muted mb-1 text-uppercase" style="letter-spacing:.05em;">Amount</div>
                            <div class="vcn-amount-value fw-bold">
                                @SelectedCreditNote.CurrencyCode @IndianNumberFormatter.Format(SelectedCreditNote.GrandTotal)
                            </div>
                        </div>
                        <div class="vcn-detail-row">
                            <span class="vcn-detail-label">Date</span>
                            <span class="vcn-detail-value">@SelectedCreditNote.CreditNoteDate.ToString("dd-MMM-yyyy")</span>
                        </div>
                        <div class="vcn-detail-row">
                            <span class="vcn-detail-label">Customer Code</span>
                            <span class="vcn-detail-value">@SelectedCreditNote.CustomerCode</span>
                        </div>
                        <div class="vcn-detail-row">
                            <span class="vcn-detail-label">Reason</span>
                            <span class="vcn-detail-value">
                                <span class="badge @GetReasonBadgeClass(SelectedCreditNote.CreditReasonCode)">
                                    @CreditReasonCodes.GetDisplayName(SelectedCreditNote.CreditReasonCode)
                                </span>
                            </span>
                        </div>
                        @if (SelectedCreditNote.IsAgainstInvoice && !string.IsNullOrEmpty(SelectedCreditNote.InvoiceNumberSnapshot))
                        {
                            <div class="vcn-detail-row">
                                <span class="vcn-detail-label">Ref Invoice</span>
                                <span class="vcn-detail-value text-primary">@SelectedCreditNote.InvoiceNumberSnapshot</span>
                            </div>
                        }
                        <div class="vcn-detail-row">
                            <span class="vcn-detail-label">Status</span>
                            <span class="vcn-detail-value">
                                <span class="badge @GetStatusBadgeClass(SelectedCreditNote.Status)">
                                    @CreditNoteStatuses.GetDisplayName(SelectedCreditNote.Status)
                                </span>
                            </span>
                        </div>
                    </div>
                    <div class="vcn-drawer-footer p-3 border-top d-flex flex-wrap gap-2">
                        <a href="/customer-credit-notes/@SelectedCreditNote.Id/view" class="btn btn-primary btn-sm">
                            <i class="ti ti-eye me-1"></i>View
                        </a>
                        @if (SelectedCreditNote.CanEdit)
                        {
                            <a href="/customer-credit-notes/@SelectedCreditNote.Id" class="btn btn-secondary btn-sm">
                                <i class="ti ti-pencil me-1"></i>Edit
                            </a>
                        }
                        @if (SelectedCreditNote.Status == CreditNoteStatuses.Submitted)
                        {
                            <button type="button" class="btn btn-success btn-sm"
                                    data-bs-toggle="modal" data-bs-target="#approveModal"
                                    @onclick="() => OpenApproveModal(SelectedCreditNote)">
                                <i class="ti ti-check me-1"></i>Approve
                            </button>
                        }
                        @if (SelectedCreditNote.CanPost)
                        {
                            <button type="button" class="btn btn-success btn-sm"
                                    data-bs-toggle="modal" data-bs-target="#postModal"
                                    @onclick="() => OpenPostModal(SelectedCreditNote)">
                                <i class="ti ti-send me-1"></i>Post
                            </button>
                        }
                        @if (SelectedCreditNote.CanCancel)
                        {
                            <button type="button" class="btn btn-warning btn-sm"
                                    data-bs-toggle="modal" data-bs-target="#cancelModal"
                                    @onclick="() => OpenCancelModal(SelectedCreditNote)">
                                <i class="ti ti-ban me-1"></i>Cancel
                            </button>
                        }
                        @if (SelectedCreditNote.Status == CreditNoteStatuses.Draft)
                        {
                            <button type="button" class="btn btn-danger btn-sm"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    @onclick="() => OpenDeleteModal(SelectedCreditNote)">
                                <i class="ti ti-trash me-1"></i>Delete
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="vcn-drawer vcn-drawer-empty card border-0 shadow-sm d-none d-lg-flex">
                    <div class="text-center text-muted p-5 m-auto">
                        <i class="ti ti-layout-sidebar-right-expand fs-1 d-block mb-3 opacity-25"></i>
                        <p class="mb-0">Select a credit note to view details</p>
                    </div>
                </div>
            }
        </div>

    </div>

    <!-- CSS for the Split Layout -->
    <style>
        .vcn-split-layout { display: flex; gap: 16px; }
        .vcn-list-panel { flex: 1; min-width: 0; transition: flex 0.3s ease; }
        .vcn-split-layout.drawer-open .vcn-list-panel { flex: 0 0 360px; }
        .vcn-drawer { flex: 1; min-width: 280px; display: flex; flex-direction: column; animation: drawerSlideIn 0.25s ease; }
        .vcn-drawer-empty { align-items: center; justify-content: center; min-height: 300px; }
        @@keyframes drawerSlideIn { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
        .vcn-list-items { max-height: calc(100vh - 380px); overflow-y: auto; min-height: 417px; }
        .vcn-list-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; cursor: pointer; border-bottom: 1px solid #f1f5f9; transition: background 0.15s ease; }
        .vcn-list-item:hover { background: #f8fafc; }
        .vcn-list-item.active { background: #eff6ff; border-left: 3px solid #155eef; }
        .vcn-item-number { font-size: 0.85rem; color: #1e293b; }
        .vcn-item-vendor { font-size: 0.78rem; margin-top: 2px; }
        .vcn-item-right { text-align: right; flex-shrink: 0; }
        .vcn-amount-card { background: linear-gradient(135deg, #eff6ff, #dbeafe); border: 1px solid #bfdbfe; }
        .vcn-amount-value { font-size: 1.6rem; color: #1d4ed8; }
        .vcn-detail-row { display: flex; justify-content: space-between; align-items: center; padding: 9px 0; border-bottom: 1px solid #f1f5f9; font-size: 0.875rem; }
        .vcn-detail-row:last-child { border-bottom: none; }
        .vcn-detail-label { color: #64748b; font-weight: 500; }
        .vcn-detail-value { font-weight: 500; color: #1e293b; }
        .vcn-drawer-close { border-radius: 50%; width: 30px; height: 30px; padding: 0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        @@media (max-width: 768px) { .vcn-split-layout { flex-direction: column; } .vcn-split-layout.drawer-open .vcn-list-panel { flex: 1; } .vcn-drawer { width: 100%; } }
    </style>

    <!-- ======================== MODALS ======================== -->
    <!-- Approve Modal -->
    <div class="modal fade" id="approveModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-primary-transparent mb-2">
                            <i class="ti ti-check fs-24 text-primary"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Approve Credit Note</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to approve credit note <strong>@SelectedCreditNote?.CreditNoteNumber</strong>?
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-primary fs-13 fw-medium p-2 px-4" @onclick="ApproveCreditNote" data-bs-dismiss="modal"><i class="ti ti-check me-1"></i>Yes, Approve</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Post Modal -->
    <div class="modal fade" id="postModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                            <i class="ti ti-send fs-24 text-success"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Post Credit Note</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to post <strong>@SelectedCreditNote?.CreditNoteNumber</strong>?
                        </p>
                        <div class="alert alert-warning mt-3 text-center small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            Once posted, the credit note cannot be edited.
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="PostCreditNote" data-bs-dismiss="modal"><i class="ti ti-send me-1"></i>Yes, Post</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cancel Modal -->
    <div class="modal fade" id="cancelModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                            <i class="ti ti-ban fs-24 text-warning"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Cancel Credit Note</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to cancel credit note <strong>@SelectedCreditNote?.CreditNoteNumber</strong>?
                        </p>
                        <div class="mt-3 text-start">
                            <label class="form-label">Cancellation Reason <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="3" @bind="cancelReasonInput" placeholder="Enter reason for cancelling this credit note..."></textarea>
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Close</button>
                            <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="CancelCreditNote" data-bs-dismiss="modal"><i class="ti ti-ban me-1"></i>Yes, Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Credit Note</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to delete <strong>@SelectedCreditNote?.CreditNoteNumber</strong>?
                        </p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This action cannot be undone.
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteCreditNote" data-bs-dismiss="modal"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
