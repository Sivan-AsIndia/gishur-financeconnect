@page "/customer-invoices/create"
@page "/customer-invoices/{Id:guid}"

@using FinanceConnect.Client.ViewModels

<style>
    .form-select option:checked {
        color: #fff;
        background: var(--primary);
    }

    .form-select:focus {
        border-color: var(--primary);
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 11px;
        margin-top: 2px;
    }

    /* ===== RESPONSIVE INVOICE LINES GRID ===== */
    .invoice-line-item {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        margin-bottom: 12px;
        padding: 16px;
        transition: all 0.2s ease;
    }

    .invoice-line-item:hover {
            border-color: var(--primary);
        box-shadow: 0 4px 12px rgba(254, 159, 67, 0.1);
    }

    /* Line Header with number and total */
    .line-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e9ecef;
    }

    .line-item-number {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .line-number-badge {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary) 100%);
        color: #fff;
        font-weight: 700;
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 20px;
        min-width: 36px;
        text-align: center;
    }

    .line-item-total {
        text-align: right;
    }

    .line-item-total-label {
        font-size: 10px;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .line-item-total-value {
        font-size: 18px;
        font-weight: 700;
        color: #212529;
    }

    /* Responsive Grid for line fields */
    .line-fields-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 12px;
        align-items: start;
    }

    .line-field {
        display: flex;
        flex-direction: column;
    }

    .line-field-label {
        font-size: 11px;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 600;
        margin-bottom: 4px;
        letter-spacing: 0.3px;
    }

    .line-field input,
    .line-field select {
        width: 100%;
        padding: 8px 10px;
        font-size: 13px;
        border-radius: 6px;
        border: 1px solid #ced4da;
        background-color: #fff;
        transition: all 0.2s ease;
    }

    .line-field input:focus,
    .line-field select:focus {
        border-color: #FE9F43;
        outline: none;
        box-shadow: 0 0 0 2px rgba(254, 159, 67, 0.15);
    }

    .line-field select {
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 8px center;
        background-size: 12px;
        padding-right: 30px;
    }

    .line-field input.text-end {
        text-align: right;
    }

    /* Grid column spans for different screen sizes */
    .col-type { grid-column: span 2; }
    .col-desc { grid-column: span 3; }
    .col-qty { grid-column: span 1; }
    .col-price { grid-column: span 1; }
    .col-disc { grid-column: span 1; }
    .col-discamt { grid-column: span 1; }
    .col-tax { grid-column: span 1; }
    .col-taxamt { grid-column: span 1; }
    .col-account { grid-column: span 3; }

    /* Line Actions */
    .line-item-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #e9ecef;
    }

    .action-btn {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 13px;
        transition: all 0.2s ease;
    }

    .action-btn:hover {
        transform: translateY(-1px);
    }

    

    .is-invalid:focus {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 2px rgba(220, 53, 69, 0.2) !important;
    }

    .field-validation-error {
        color: #dc3545;
        font-size: 10px;
        display: block;
        margin-top: 2px;
    }

    /* Header field validation */
    .form-control.is-invalid,
    .form-select.is-invalid {
        border-color: #dc3545 !important;
        background-color: #fff5f5 !important;
    }

    .form-control.is-invalid:focus,
    .form-select.is-invalid:focus {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 2px rgba(220, 53, 69, 0.2) !important;
    }

    /* Totals Summary Card */
    .totals-summary {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #e9ecef;
    }

    .totals-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 12px;
    }

    .total-item {
        padding: 12px 16px;
        background: #fff;
        border-radius: 8px;
        border: 1px solid #e9ecef;
        text-align: center;
        transition: all 0.2s ease;
    }

    .total-item:hover {
            border-color: var(--primary);
        box-shadow: 0 2px 8px rgba(254, 159, 67, 0.1);
    }

    .total-item-label {
        font-size: 10px;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .total-item-value {
        font-size: 16px;
        font-weight: 700;
        color: #212529;
    }

    .total-item-value.grand-total {
            color: var(--primary);
        font-size: 18px;
    }

    .total-item-value.discount {
        color: #dc3545;
    }

    .currency-badge {
        display: inline-block;
        padding: 4px 12px;
        background: #28a745;
        color: #fff;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    /* Empty State */
    .empty-lines-state {
        padding: 40px 20px;
        text-align: center;
        color: #6c757d;
        background: #f8f9fa;
        border-radius: 10px;
        border: 2px dashed #dee2e6;
    }

    .empty-lines-state i {
        font-size: 48px;
        margin-bottom: 12px;
        color: #dee2e6;
    }

    /* Add Line Button */
    .add-line-btn {
        background: linear-gradient(135deg, var(--primary) 0%,  var(--primary) 100%);
        border: none;
        padding: 8px 16px;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .add-line-btn:hover {
        transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba( var(--primary), 0.3);
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary) 100%);
    }

    /* Section Header */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 16px;
        border-bottom: 2px solid #e9ecef;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--primary);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .section-title i {
        font-size: 18px;
    }

    /* Validation error highlight animation */
    .validation-highlight {
        animation: highlightPulse 0.5s ease-in-out 2;
    }

    @@keyframes highlightPulse {
        0%, 100% {
            box-shadow: 0 0 0 2px rgba(220, 53, 69, 0.2);
        }
        50% {
            box-shadow: 0 0 0 4px rgba(220, 53, 69, 0.4);
        }
    }

    /* ===== RESPONSIVE BREAKPOINTS ===== */

    /* Extra Large screens (Projector, Large Monitors) - 1400px+ */
    @@media (min-width: 1400px) {
        .line-fields-grid {
            /* grid-template-columns: repeat(14, 1fr); */
        }
        .col-type { grid-column: span 2; }
        .col-desc { grid-column: span 3; }
        .col-qty { grid-column: span 1; }
        .col-price { grid-column: span 1; }
        .col-disc { grid-column: span 1; }
        .col-discamt { grid-column: span 1; }
        .col-tax { grid-column: span 1; }
        .col-taxamt { grid-column: span 1; }
        .col-account { grid-column: span 3; }
        
        .totals-grid {
            grid-template-columns: repeat(6, 1fr);
        }
    }

    /* Large screens (Desktop) - 1200px to 1399px */
    @@media (min-width: 1200px) and (max-width: 1399px) {
        .line-fields-grid {
            grid-template-columns: repeat(14, 1fr);
        }
        .col-type { grid-column: span 2; }
        .col-desc { grid-column: span 3; }
        .col-qty { grid-column: span 1; }
        .col-price { grid-column: span 1; }
        .col-disc { grid-column: span 1; }
        .col-discamt { grid-column: span 1; }
        .col-tax { grid-column: span 1; }
        .col-taxamt { grid-column: span 1; }
        .col-account { grid-column: span 3; }
        
        .totals-grid {
            grid-template-columns: repeat(6, 1fr);
        }
    }

    /* Medium-Large screens - 992px to 1199px */
    @@media (min-width: 992px) and (max-width: 1199px) {
        .line-fields-grid {
            grid-template-columns: repeat(8, 1fr);
            gap: 10px;
        }
        .col-type { grid-column: span 2; }
        .col-desc { grid-column: span 6; }
        .col-qty { grid-column: span 1; }
        .col-price { grid-column: span 1; }
        .col-disc { grid-column: span 1; }
        .col-discamt { grid-column: span 1; }
        .col-tax { grid-column: span 1; }
        .col-taxamt { grid-column: span 1; }
        .col-account { grid-column: span 2; }
        
        .totals-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    /* Tablet Landscape - 768px to 991px */
    @@media (min-width: 768px) and (max-width: 991px) {
        .line-fields-grid {
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }
        .col-type { grid-column: span 2; }
        .col-desc { grid-column: span 2; }
        .col-qty { grid-column: span 1; }
        .col-price { grid-column: span 1; }
        .col-disc { grid-column: span 1; }
        .col-discamt { grid-column: span 1; }
        .col-tax { grid-column: span 1; }
        .col-taxamt { grid-column: span 1; }
        .col-account { grid-column: span 4; }
        
        .totals-grid {
            grid-template-columns: repeat(3, 1fr);
        }
        
        .line-field input,
        .line-field select {
            padding: 10px;
            font-size: 14px;
        }
    }

    /* Tablet Portrait - 576px to 767px */
    @@media (min-width: 576px) and (max-width: 767px) {
        .line-fields-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }
        .col-type { grid-column: span 1; }
        .col-desc { grid-column: span 2; }
        .col-qty { grid-column: span 1; }
        .col-price { grid-column: span 1; }
        .col-disc { grid-column: span 1; }
        .col-discamt { grid-column: span 1; }
        .col-tax { grid-column: span 1; }
        .col-taxamt { grid-column: span 1; }
        .col-account { grid-column: span 2; }
        
        .totals-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        
        .line-field input,
        .line-field select {
            padding: 10px 12px;
            font-size: 14px;
        }
        
        .line-item-total-value {
            font-size: 16px;
        }
    }

    /* Mobile - Less than 576px */
    @@media (max-width: 575px) {
        .line-fields-grid {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        /* .col-type { grid-column: span 1; } */
        .col-desc { grid-column: span 2; }
        .col-qty { grid-column: span 1; }
        .col-price { grid-column: span 1; }
        .col-disc { grid-column: span 1; }
        .col-discamt { grid-column: span 1; }
        .col-tax { grid-column: span 1; }
        .col-taxamt { grid-column: span 1; }
        .col-account { grid-column: span 2; }
        
        .totals-grid {
            grid-template-columns: 1fr 1fr;
        }
        
        .total-item:last-child {
            grid-column: span 2;
        }
        
        .line-field input,
        .line-field select {
            padding: 10px 12px;
            font-size: 14px;
        }
        
        .line-item-total-value {
            font-size: 16px;
        }
        
        .section-header {
            flex-direction: column;
            align-items: flex-start;
        }
        
        .add-line-btn {
            width: 100%;
            justify-content: center;
        }
        
        .line-item-actions {
            flex-wrap: wrap;
        }
        
        .line-item-actions .btn {
            flex: 1;
            min-width: 100px;
        }
    }

    /* Very small mobile - Less than 400px */
    @@media (max-width: 399px) {
        .line-fields-grid {
            grid-template-columns: 1fr;
        }
        .col-type,
        .col-desc,
        .col-qty,
        .col-price,
        .col-disc,
        .col-discamt,
        .col-tax,
        .col-taxamt,
        .col-account {
            grid-column: span 1;
        }
        
        .totals-grid {
            grid-template-columns: 1fr;
        }
        
        .total-item:last-child {
            grid-column: span 1;
        }
        
        .line-item-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
        }
        
        .line-item-total {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
    }
</style>

<script suppress-error="BL9992">
    window.scrollToFirstValidationError = function () {
        // Find the first element with is-invalid class
        var invalidElement = document.querySelector('.is-invalid');
        if (invalidElement) {
            // Scroll to the element with some offset
            var elementRect = invalidElement.getBoundingClientRect();
            var absoluteElementTop = elementRect.top + window.pageYOffset;
            var offset = 150; // Offset from top of viewport
            
            window.scrollTo({
                top: absoluteElementTop - offset,
                behavior: 'smooth'
            });
            
            // Add highlight animation
            invalidElement.classList.add('validation-highlight');
            
            // Focus on the element if it's focusable
            setTimeout(function() {
                if (invalidElement.tagName === 'INPUT' || invalidElement.tagName === 'SELECT' || invalidElement.tagName === 'TEXTAREA') {
                    invalidElement.focus();
                }
                // Remove highlight class after animation
                setTimeout(function() {
                    invalidElement.classList.remove('validation-highlight');
                }, 1000);
            }, 300);
            
            return true;
        }
        return false;
    };
</script>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    <div class="content flat-form">
        <!-- Page Header -->
        <div class="page-header">
            <div class="page-title">
                <div style="display: ruby;">
                    <h4 class="fw-bold">
                        @(IsEdit ? "Edit Customer Invoice" : "Create Customer Invoice")
                    </h4>
                    @if (IsEdit)
                    {
                        <span class="badge @GetStatusBadge(Invoice.InvoiceStatus)">
                            @Invoice.InvoiceStatus
                        </span>
                    }
                </div>
                <h6>AR Billing Document</h6>
            </div>

            <div class="page-btn mt-0">
                <a href="/customer-invoices" class="btn btn-secondary">
                    Back
                </a>
            </div>
        </div>

        <EditForm Model="Invoice" OnSubmit="HandleSubmit" @attributes="@(new Dictionary<string, object> { { "novalidate", true } })">
            <DataAnnotationsValidator />

            <div class="mt-4">
                <div class="card">
                    <!-- Header -->
                    <div class="card-header text-white" style="border-bottom: 1px solid #80808036;">
                        <h5>
                            <i class="ti ti-file-invoice me-2"></i>
                            Invoice Details
                        </h5>
                    </div>

                    <div class="card-body mt-3">
                        <!-- Invoice Identity -->
                        <h6 class="text-primary mb-3 mt-3">
                            <i class="ti ti-id me-2"></i> Invoice Identity
                        </h6>

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Invoice Number <span class="text-danger ms-1">*</span></label>
                                <InputText class="@($"form-control text-uppercase {GetHeaderValidationClass("InvoiceNumber")}")"
                                           @bind-Value="Invoice.InvoiceNumber"
                                           placeholder="e.g., INV-2026-0001"
                                           disabled="@IsEdit"
                                           maxlength="40" />
                                @if (HasHeaderError("InvoiceNumber"))
                                {
                                    <span class="field-validation-error">@GetHeaderError("InvoiceNumber")</span>
                                }
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Invoice Type <span class="text-danger ms-1">*</span></label>
                                <InputSelect class="@($"form-select {GetHeaderValidationClass("InvoiceType")}")" @bind-Value="Invoice.InvoiceType" disabled="@IsReadOnly">
                                    <option value="">--Select Invoice Type--</option>
                                    @foreach (var type in InvoiceTypes.All)
                                    {
                                        <option value="@type">@InvoiceTypes.GetDisplayName(type)</option>
                                    }
                                </InputSelect>
                                @if (HasHeaderError("InvoiceType"))
                                {
                                    <span class="field-validation-error">@GetHeaderError("InvoiceType")</span>
                                }
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Invoice Date <span class="text-danger ms-1">*</span></label>
                                <InputDate class="@($"form-control {GetHeaderValidationClass("InvoiceDate")}")" @bind-Value="Invoice.InvoiceDate"
                                           @bind-Value:after="OnInvoiceDateChanged"
                                           disabled="@IsReadOnly" />
                                @if (HasHeaderError("InvoiceDate"))
                                {
                                    <span class="field-validation-error">@GetHeaderError("InvoiceDate")</span>
                                }
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Due Date <span class="text-danger ms-1">*</span></label>
                                <InputDate class="@($"form-control {GetHeaderValidationClass("DueDate")}")" @bind-Value="Invoice.DueDate"
                                           disabled="@IsReadOnly" />
                                @if (HasHeaderError("DueDate"))
                                {
                                    <span class="field-validation-error">@GetHeaderError("DueDate")</span>
                                }
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Posting Date</label>
                                <InputDate class="@($"form-control {GetHeaderValidationClass("PostingDate")}")" @bind-Value="Invoice.PostingDate"
                                           disabled="@IsReadOnly" />
                                @if (HasHeaderError("PostingDate"))
                                {
                                    <span class="field-validation-error">@GetHeaderError("PostingDate")</span>
                                }
                                <small class="text-muted d-block mt-1">Required at posting time</small>
                            </div>
                        </div>

                        <!-- Company & Customer -->
                        <h6 class="text-primary mb-3 mt-4">
                            <i class="ti ti-building me-2"></i> Company & Customer
                        </h6>

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Company <span class="text-danger ms-1">*</span></label>
                                <select class="@($"form-select {GetHeaderValidationClass("CompanyId")}")" value="@Invoice.CompanyId" @onchange="OnCompanyChanged" disabled="@IsReadOnly">
                                    <option value="">-- Select Company --</option>
                                    @foreach (var company in Companies)
                                    {
                                        <option value="@company.Id">@company.LegalName</option>
                                    }
                                </select>
                                @if (HasHeaderError("CompanyId"))
                                {
                                    <span class="field-validation-error">@GetHeaderError("CompanyId")</span>
                                }
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Branch <span class="text-danger ms-1">*</span></label>
                                <select class="@($"form-select {GetHeaderValidationClass("BranchId")}")" @bind="Invoice.BranchId" disabled="@IsReadOnly">
                                    <option value="">-- Select Branch --</option>
                                    @foreach (var branch in Branches)
                                    {
                                        <option value="@branch.Id">@branch.BranchCode - @branch.BranchName</option>
                                    }
                                </select>
                                @if (HasHeaderError("BranchId"))
                                {
                                    <span class="field-validation-error">@GetHeaderError("BranchId")</span>
                                }
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Customer <span class="text-danger ms-1">*</span></label>
                                    <SearchDropdown TItem="CustomerViewModel"
                                        Items="Customers"
                                        TextSelector="@(c => c.CustomerCode + " - " + c.CustomerName)"
                                        ValueSelector="@(c => c.Id)"
                                        @bind-Value="Invoice.CustomerId"
                                        @bind-Value:after="OnCustomerChanged"
                                         Class="@GetHeaderValidationClass("CustomerId")"
                                        Placeholder="-- Select Customer --"
                                        Disabled="@IsReadOnly" />
                                @if (HasHeaderError("CustomerId"))
                                {
                                    <span class="field-validation-error">@GetHeaderError("CustomerId")</span>
                                }
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Payment Terms <span class="text-danger ms-1">*</span></label>
                                <select class="@($"form-select {GetHeaderValidationClass("PaymentTermId")}")" value="@Invoice.PaymentTermId" @onchange="OnPaymentTermChanged" disabled="@IsReadOnly">
                                    <option value="">-- Select Terms --</option>
                                    @foreach (var term in PaymentTerms)
                                    {
                                        <option value="@term.Id">@term.Name</option>
                                    }
                                </select>
                                @if (HasHeaderError("PaymentTermId"))
                                {
                                    <span class="field-validation-error">@GetHeaderError("PaymentTermId")</span>
                                }
                            </div>
                        </div>

                        <!-- Reference & Currency -->
                        <h6 class="text-primary mb-3 mt-4">
                            <i class="ti ti-receipt me-2"></i> Reference & Currency
                        </h6>

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Currency <span class="text-danger ms-1">*</span></label>
                                <input class="@($"form-control {GetHeaderValidationClass("CurrencyId")}")" value="@($"{Invoice.CurrencyCode} - {Invoice.CurrencyName}")" readonly />
                                @if (HasHeaderError("CurrencyId"))
                                {
                                    <span class="field-validation-error">@GetHeaderError("CurrencyId")</span>
                                }
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Exchange Rate</label>
                                <InputNumber class="form-control" min="0" @bind-Value="Invoice.ExchangeRate" disabled="@IsReadOnly" />
                                <small class="text-muted d-block mt-1">Required if foreign currency</small>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">PO Reference</label>
                                <InputText class="form-control" @bind-Value="Invoice.ReferenceText"
                                           placeholder="e.g., PO-2026-001"
                                           disabled="@IsReadOnly"
                                           maxlength="100" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Invoice Notes</label>
                                @if (!IsReadOnly)
                                {
                                    <RichTextEditor @ref="narrationEditor"
                                                    Value="@Invoice.InvoiceNarration"
                                                    Placeholder="Enter invoice notes / narration..."
                                                    MinHeight="60"
                                                    MaxHeight="150" />
                                }
                                else
                                {
                                    <div class="form-control" style="min-height:60px;background:#e9ecef;">
                                        @((MarkupString)(Invoice.InvoiceNarration ?? ""))
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- GST & Compliance -->
                        <h6 class="text-primary mb-3 mt-4">
                            <i class="ti ti-shield-check me-2"></i> GST & Compliance
                        </h6>

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Place of Supply</label>
                                <select class="form-select" @bind="Invoice.PlaceOfSupplyStateId" disabled="@IsReadOnly">
                                    <option value="">-- Select State --</option>
                                    @foreach (var state in States)
                                    {
                                        <option value="@state.Id">@state.StateProvinceName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Supply Type</label>
                                <InputSelect class="form-select" @bind-Value="Invoice.SupplyType" disabled="@IsReadOnly">
                                    <option value="">--Select Supply Type--</option>
                                    @foreach (var st in SupplyTypes.All)
                                    {
                                        <option value="@st">@SupplyTypes.GetDisplayName(st)</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">E-Invoice Status</label>
                                <div>
                                    <span class="badge @GetEInvoiceBadge(Invoice.EInvoiceStatus)">
                                        @Invoice.EInvoiceStatus
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">E-Invoice IRN</label>
                                <input class="form-control" value="@Invoice.EInvoiceIRN" readonly placeholder="Generated after posting" />
                            </div>
                        </div>

                        <!-- Status & Workflow -->
                        <h6 class="text-primary mb-3 mt-4">
                            <i class="ti ti-git-branch me-2"></i> Status & Workflow
                        </h6>

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Invoice Status</label>
                                <div>
                                    <span class="badge @GetStatusBadge(Invoice.InvoiceStatus) px-3 py-2">
                                        @InvoiceStatuses.GetDisplayName(Invoice.InvoiceStatus)
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Approval Status</label>
                                <div>
                                    <span class="badge @GetApprovalStatusBadge(Invoice.ApprovalStatus) px-3 py-2">
                                        @GetApprovalStatusDisplayName(Invoice.ApprovalStatus)
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">System Generated</label>
                                <div>
                                    @if (Invoice.IsSystemGenerated)
                                    {
                                        <span class="badge bg-info px-3 py-2"><i class="ti ti-robot me-1"></i>Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2">No</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Invoice Lines Section -->
                <div class="card mt-4">
                    <div class="card-body">
                        <div class="section-header">
                            <div class="section-title">
                                <i class="ti ti-list-details"></i>
                                <span>Invoice Lines</span>
                            </div>

                            @if (!IsReadOnly)
                            {
                                <button type="button" class="btn btn-primary add-line-btn" @onclick="AddLine">
                                    <i class="ti ti-plus me-1"></i> Add Line
                                </button>
                            }
                        </div>

                        <!-- Responsive Invoice Lines -->
                        <div class="invoice-lines-wrapper">
                            @{ var displayLineNumber = 0; }
                            @foreach (var line in Invoice.Lines)
                            {
                                displayLineNumber++;
                                var lineIndex = Invoice.Lines.IndexOf(line);
                                <div class="invoice-line-item">
                                    <!-- Line Header -->
                                    <div class="line-item-header">
                                        <div class="line-item-number">
                                            <span class="line-number-badge">#@displayLineNumber</span>
                                        </div>
                                        <div class="line-item-total">
                                            <div class="line-item-total-label">Line Total</div>
                                            <div class="line-item-total-value">₹ @line.LineTotalAmount.ToString("N2")</div>
                                        </div>
                                    </div>

                                    <!-- Line Fields Grid -->
                                    <div class="line-fields-grid">
                                        <!-- Type -->
                                        <div class="line-field col-type">
                                            <label class="line-field-label">Type</label>
                                            <select class="@GetValidationClass(lineIndex, "LineType")"
                                                    value="@line.LineType"
                                                    @onchange="e => OnLineTypeChanged(line, e)"
                                                    disabled="@IsReadOnly">
                                                <option value="">--Select Line Type--</option>
                                                @foreach (var lt in LineTypes.All)
                                                {
                                                    <option value="@lt">@LineTypes.GetDisplayName(lt)</option>
                                                }
                                            </select>
                                            @if (HasValidationError(lineIndex, "LineType"))
                                            {
                                                <span class="field-validation-error">@GetValidationError(lineIndex, "LineType")</span>
                                            }
                                        </div>

                                        <!-- Description -->
                                        <div class="line-field col-desc">
                                            <label class="line-field-label">Description <span class="text-danger">*</span></label>
                                            <input type="text"
                                                   class="@GetValidationClass(lineIndex, "Description")"
                                                   value="@line.Description"
                                                   @onchange="e => OnDescriptionChanged(line, e)"
                                                   placeholder="Enter description..."
                                                   disabled="@IsReadOnly" />
                                            @if (HasValidationError(lineIndex, "Description"))
                                            {
                                                <span class="field-validation-error">@GetValidationError(lineIndex, "Description")</span>
                                            }
                                        </div>

                                        <!-- Quantity -->
                                        <div class="line-field col-qty">
                                            <label class="line-field-label">Qty <span class="text-danger">*</span></label>
                                            <input type="text"
                                                   class="text-end @GetValidationClass(lineIndex, "Quantity")"
                                                   value="@line.Quantity"
                                                   disabled="@IsReadOnly"
                                                   @onchange="e => OnQuantityChanged(line, e)" />
                                            @if (HasValidationError(lineIndex, "Quantity"))
                                            {
                                                <span class="field-validation-error">@GetValidationError(lineIndex, "Quantity")</span>
                                            }
                                        </div>

                                        <!-- Unit Price -->
                                        <div class="line-field col-price">
                                            <label class="line-field-label">Price <span class="text-danger">*</span></label>
                                            <input type="text"
                                                   class="text-end @GetValidationClass(lineIndex, "UnitPrice")"
                                                   value="@line.UnitPrice"
                                                   disabled="@IsReadOnly"
                                                   @onchange="e => OnUnitPriceChanged(line, e)" />
                                            @if (HasValidationError(lineIndex, "UnitPrice"))
                                            {
                                                <span class="field-validation-error">@GetValidationError(lineIndex, "UnitPrice")</span>
                                            }
                                        </div>

                                        <!-- Discount % -->
                                        <div class="line-field col-disc">
                                            <label class="line-field-label">Disc %</label>
                                            <input type="text"
                                                   class="text-end @GetValidationClass(lineIndex, "DiscountPercent")"
                                                   value="@line.DiscountPercent"
                                                   disabled="@IsReadOnly"
                                                   @onchange="e => OnDiscountChanged(line, e)" />
                                            @if (HasValidationError(lineIndex, "DiscountPercent"))
                                            {
                                                <span class="field-validation-error">@GetValidationError(lineIndex, "DiscountPercent")</span>
                                            }
                                        </div>

                                        <!-- Discount Amount (read-only derived) -->
                                        <div class="line-field col-discamt">
                                            <label class="line-field-label">Disc Amt</label>
                                            <input type="text"
                                                   class="text-end"
                                                   value="@line.DiscountAmount.ToString("N2")"
                                                   readonly
                                                   style="background-color: #f8f9fa;" />
                                        </div>

                                        <!-- Tax % -->
                                        <div class="line-field col-tax">
                                            <label class="line-field-label">Tax %</label>
                                            <input type="text"
                                                   class="text-end @GetValidationClass(lineIndex, "TaxRatePercent")"
                                                   value="@line.TaxRatePercent"
                                                   disabled="@IsReadOnly"
                                                   @onchange="e => OnTaxRateChanged(line, e)" />
                                            @if (HasValidationError(lineIndex, "TaxRatePercent"))
                                            {
                                                <span class="field-validation-error">@GetValidationError(lineIndex, "TaxRatePercent")</span>
                                            }
                                        </div>

                                        <!-- Tax Amount (read-only derived) -->
                                        <div class="line-field col-taxamt">
                                            <label class="line-field-label">Tax Amt</label>
                                            <input type="text"
                                                   class="text-end"
                                                   value="@line.TaxAmount.ToString("N2")"
                                                   readonly
                                                   style="background-color: #f8f9fa;" />
                                        </div>

                                        <!-- Revenue Account -->
                                        <div class="line-field col-account">
                                            <label class="line-field-label">Revenue Account <span class="text-danger">*</span></label>
                                            <select class="@GetValidationClass(lineIndex, "RevenueAccountId")"
                                                    value="@line.RevenueAccountId"
                                                    @onchange="e => OnRevenueAccountChanged(line, e)"
                                                    disabled="@IsReadOnly">
                                                <option value="">-- Select Account --</option>
                                                @foreach (var a in RevenueAccounts)
                                                {
                                                    <option value="@a.Id">@a.AccountCode - @a.AccountName</option>
                                                }
                                            </select>
                                            @if (HasValidationError(lineIndex, "RevenueAccountId"))
                                            {
                                                <span class="field-validation-error">@GetValidationError(lineIndex, "RevenueAccountId")</span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Line Actions -->
                                    @if (!IsReadOnly)
                                    {
                                        <div class="line-item-actions">
                                            <button type="button" class="btn btn-sm btn-outline-secondary action-btn"
                                                    @onclick="() => DuplicateLine(line)">
                                                <i class="ti ti-copy me-1"></i> Duplicate
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger action-btn"
                                                    @onclick="() => DeleteLine(line)">
                                                <i class="ti ti-trash me-1"></i> Delete
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            @if (!Invoice.Lines.Any())
                            {
                                <div class="empty-lines-state">
                                    <i class="ti ti-file-off d-block"></i>
                                    <div class="fw-semibold mb-1">No invoice lines</div>
                                    <small>Click "Add Line" to add items or services</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Totals Summary -->
                <div class="card mt-4">
                    <div class="card-body">
                        <div class="totals-summary">
                            <div class="totals-grid">
                                <div class="total-item">
                                    <div class="total-item-label">Subtotal</div>
                                    <div class="total-item-value">@Invoice.SubTotalAmount.ToString("N2")</div>
                                </div>
                                <div class="total-item">
                                    <div class="total-item-label">Discount</div>
                                    <div class="total-item-value discount">-@Invoice.DiscountTotalAmount.ToString("N2")</div>
                                </div>
                                <div class="total-item">
                                    <div class="total-item-label">Tax</div>
                                    <div class="total-item-value">@Invoice.TaxTotalAmount.ToString("N2")</div>
                                </div>
                                <div class="total-item">
                                    <div class="total-item-label">Round Off</div>
                                    <div class="total-item-value">@Invoice.RoundOffAmount.ToString("N2")</div>
                                </div>
                                <div class="total-item">
                                    <div class="total-item-label">Grand Total</div>
                                    <div class="total-item-value grand-total">@Invoice.GrandTotalAmount.ToString("N2")</div>
                                </div>
                                <div class="total-item">
                                    <div class="total-item-label">Currency</div>
                                    <div><span class="currency-badge">@Invoice.CurrencyCode</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4 mb-4">
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">
                        <i class="ti ti-x me-1"></i>Cancel
                    </button>

                    @if (!IsReadOnly)
                    {
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>@(IsEdit ? "Update" : "Save")
                        </button>

                        @if (Invoice.InvoiceStatus == InvoiceStatuses.Draft)
                        {
                            <button type="button" class="btn btn-success" @onclick="SubmitForApproval">
                                <i class="ti ti-send me-1"></i> Submit
                            </button>
                        }
                    }

                    @if (Invoice.InvoiceStatus == InvoiceStatuses.Approved && IsEdit)
                    {
                        <button type="button" class="btn btn-warning" @onclick="PostInvoice">
                            <i class="ti ti-check me-1"></i> Post
                        </button>
                    }
                </div>
            </div>
        </EditForm>
    </div>
}
