@page "/customer-invoices"

@inject CustomerInvoiceService InvoiceService
@inject CustomerService CustomerService
@inject NavigationManager Navigation
@inject ToastService ToastService

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Customer Invoice List</h4>
                    <h6>Manage your AR customer invoices</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/customer-invoices/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="row mb-0">
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #A0008B, #6A0074);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Total</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.TotalInvoices</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-white rounded-circle p-2" style="background: #ffffff47;width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;">
                                <i class="ti ti-file-invoice" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style=" background: linear-gradient(135deg, #2F3E53, #1F2A3A);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Draft</h6>
                                <h5 class="mb-0 fw-bold text-secondary text-white">@Statistics.DraftInvoices</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-secondary rounded-circle p-2" style="background: #ffffff47;width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;">
                                <i class="ti ti-file-text text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style=" background: linear-gradient(135deg, #2A0A73, #0F0B5F);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Posted</h6>
                                <h5 class="mb-0 fw-bold text-info text-white">@Statistics.PostedInvoices</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-info rounded-circle p-2" style="background: #ffffff47;width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;">
                                <i class="ti ti-send text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style=" background: linear-gradient(135deg, #0B7A5A, #075F46);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Paid</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.PaidInvoices</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-success rounded-circle p-2" style="background: #ffffff47;width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;">
                                <i class="ti ti-circle-check text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #9B1C1C, #7F1414);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Overdue</h6>
                                <h5 class="mb-0 fw-bold text-danger text-white">@Statistics.OverdueInvoices</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-danger rounded-circle p-2" style="background: #ffffff47;width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;">
                                <i class="ti ti-alert-triangle text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #1F2937, #111827);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Cancelled</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.CancelledInvoices</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-secondary rounded-circle p-2" style="background: #ffffff47;width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;">
                                <i class="ti ti-ban text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoice List -->
        <div class="card">
            <div class="card-header d-flex align-items-end justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search by invoice, customer..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: end;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedInvoiceType">
                            <option value="">All Types</option>
                            @foreach (var type in allInvoices.Select(i => i.InvoiceType).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct().OrderBy(t => t))
                            {
                                <option value="@type">@InvoiceTypes.GetDisplayName(type)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in allInvoices.Select(i => i.InvoiceStatus).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s))
                            {
                                <option value="@status">@InvoiceStatuses.GetDisplayName(status)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2 filter-date">
                        <label class="form-label">From</label>
                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="FromDate" title="From Date" />
                    </div>
                    <div class="ms-2 filter-date">
                        <label class="form-label">To</label>
                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="ToDate" title="To Date" />
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <div class="table-responsive">
                        <table class="table align-middle w-100 mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xxl-none" style="width:40px"></th>
                                    <th style="width:15%">Invoice No</th>
                                    <th class="d-none d-md-table-cell" style="width:22%">Customer</th>
                                    <th class="d-none d-xl-table-cell" style="width:6%" title="Type">Type</th>
                                    <th class="d-none d-lg-table-cell" style="width:10%">Date</th>
                                    <th class="d-none d-xl-table-cell" style="width:10%">Due Date</th>
                                    <th class="d-none d-xxl-table-cell text-end" style="width:12%">Amount</th>
                                    <th class="d-none d-xxl-table-cell" style="width:10%">Status</th>
                                    <th style="width:13%">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedInvoices.Any())
                                {
                                    @foreach (var inv in PagedInvoices)
                                    {
                                        <tr>
                                            <!-- PLUS ICON -->
                                            <td class="d-xxl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#rowDetailsModal"
                                                   @onclick="() => OpenRowDetails(inv)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td class="fw-medium">
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a href="/customer-invoices/@inv.Id/view" class="text-decoration-none link-View"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title="@inv.InvoiceNumber details">
                                                    @inv.InvoiceNumber
                                                </a>
                                            </td>

                                            <td class="d-none d-md-table-cell">
                                                <div class="fw-medium">@inv.CustomerCode</div>
                                                <small class="text-muted text-wrap">@inv.CustomerName</small>
                                            </td>

                                            <td class="d-none d-xl-table-cell">
                                                <span class="badge @GetTypeBadgeClass(inv.InvoiceType)"
                                                      data-bs-toggle="tooltip"
                                                      data-bs-placement="top"
                                                      title="@InvoiceTypes.GetDisplayName(inv.InvoiceType)">
                                                    <i class="@GetInvoiceTypeIcon(inv.InvoiceType)"></i>
                                                </span>
                                            </td>

                                            <td class="d-none d-lg-table-cell">
                                                @inv.InvoiceDate.ToString("dd-MMM-yy")
                                            </td>

                                            <td class="d-none d-xl-table-cell @(IsOverdue(inv) ? "text-danger fw-medium" : "")">
                                                @inv.DueDate.ToString("dd-MMM-yy")
                                                @if (IsOverdue(inv))
                                                {
                                                    <i class="ti ti-alert-circle ms-1" title="Overdue"></i>
                                                }
                                            </td>

                                            <td class="d-none d-xxl-table-cell text-end fw-medium">
                                             
                                                @IndianNumberFormatter.Format(@inv.GrandTotalAmount)
                                            </td>

                                            <td class="d-none d-xxl-table-cell">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="ActiveDot @GetStatusBadgeClass(inv.InvoiceStatus)">
                                                    </div>
                                                    <span>@InvoiceStatuses.GetDisplayName(inv.InvoiceStatus)</span>
                                                </div>
                                            </td>

                                            <td class="action-table-data">
                                                <div class="edit-delete-action">
                                                    @if (inv.CanEdit)
                                                    {
                                                        <a class="me-2 edit-icon p-1" href="/customer-invoices/@inv.Id" title="Edit">
                                                            <i data-feather="edit"></i>
                                                        </a>
                                                    }
                                                    @if (inv.CanPost)
                                                    {
                                                        <a class="me-2 p-1 action-icon" href="javascript:void(0);"
                                                           title="Post Invoice" data-bs-toggle="modal" data-bs-target="#postModal"
                                                           @onclick="() => OpenPostModal(inv)">
                                                            <i class="ti ti-send text-success"></i>
                                                        </a>
                                                    }
                                                    @if (inv.CanCancel)
                                                    {
                                                        <a class="me-2 p-1 action-icon" href="javascript:void(0);"
                                                           title="Cancel Invoice" data-bs-toggle="modal" data-bs-target="#cancelModal"
                                                           @onclick="() => OpenCancelModal(inv)">
                                                            <i class="ti ti-ban text-warning"></i>
                                                        </a>
                                                    }
                                                    @if (inv.InvoiceStatus == InvoiceStatuses.Draft)
                                                    {
                                                        <a class="p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                                           data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                           @onclick="() => OpenDeleteModal(inv)">
                                                            <i data-feather="trash-2"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@VisibleColumnCount" class="text-center py-4 text-muted">
                                            <i class="ti ti-database-off fs-1 d-block mb-2"></i>
                                            No invoices found. Click "Create Invoice" to add one.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                        <div class="d-flex align-items-center">
                            <span class="me-2">Rows per page</span>
                            <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                                <option value="5" selected="@(PageSize == 5)">5</option>
                                <option value="10" selected="@(PageSize == 10)">10</option>
                                <option value="25" selected="@(PageSize == 25)">25</option>
                                <option value="50" selected="@(PageSize == 50)">50</option>
                            </select>
                            <span class="ms-3 text-muted">
                                Entries
                            </span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = 1; i <= TotalPages; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Post Invoice Modal -->
    <div class="modal fade" id="postModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                            <i class="ti ti-send fs-24 text-success"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Post Invoice</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to post <strong>@SelectedInvoice?.InvoiceNumber</strong>?
                        </p>
                        <div class="alert alert-warning mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            Once posted, the invoice cannot be edited. Any corrections must be made via Credit Note or Debit Note.
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="PostInvoice" data-bs-dismiss="modal">
                                <i class="ti ti-send me-1"></i>Yes, Post
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cancel Invoice Modal -->
    <div class="modal fade" id="cancelModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                            <i class="ti ti-ban fs-24 text-warning"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Cancel Invoice</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to cancel invoice <strong>@SelectedInvoice?.InvoiceNumber</strong>?
                        </p>
                        <div class="mt-3 text-start">
                            <label class="form-label">Cancellation Reason <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="3" @bind="cancelReasonInput" placeholder="Enter reason for cancelling this invoice..."></textarea>
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Close</button>
                            <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="CancelInvoice" data-bs-dismiss="modal">
                                <i class="ti ti-ban me-1"></i>Yes, Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Invoice Modal -->
    <div class="modal fade" id="deleteModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Invoice</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to delete <strong>@SelectedInvoice?.InvoiceNumber</strong>?
                        </p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This action cannot be undone.
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteInvoice" data-bs-dismiss="modal">
                                <i class="ti ti-trash me-1"></i>Yes, Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row Details Modal (Mobile) -->
    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Invoice Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" style="padding: 0; right: 22px; position: absolute; transform: none;"></button>
                </div>
                <div class="modal-body">
                    @if (SelectedInvoice != null)
                    {
                        <div class="row">
                            <div class="col-6 mb-2"><small class="text-muted">Invoice No</small><div class="fw-medium">@SelectedInvoice.InvoiceNumber</div></div>
                            <div class="col-6 mb-2"><small class="text-muted">Type</small><div><span class="badge @GetTypeBadgeClass(SelectedInvoice.InvoiceType)">@InvoiceTypes.GetDisplayName(SelectedInvoice.InvoiceType)</span></div></div>
                            <div class="col-6 mb-2"><small class="text-muted">Customer</small><div>@SelectedInvoice.CustomerCode</div></div>
                            <div class="col-6 mb-2"><small class="text-muted">Status</small><div><span class="badge @GetStatusBadgeClass(SelectedInvoice.InvoiceStatus)">@InvoiceStatuses.GetDisplayName(SelectedInvoice.InvoiceStatus)</span></div></div>
                            <div class="col-6 mb-2"><small class="text-muted">Date</small><div>@SelectedInvoice.InvoiceDate.ToString("dd-MMM-yy")</div></div>
                            <div class="col-6 mb-2"><small class="text-muted">Due Date</small><div>@SelectedInvoice.DueDate.ToString("dd-MMM-yy")</div></div>
                            <div class="col-6 mb-2"><small class="text-muted">Amount</small><div class="fw-medium">@SelectedInvoice.CurrencyCode @SelectedInvoice.GrandTotalAmount.ToString("N2")</div></div>
                            <div class="col-6 mb-2"><small class="text-muted">Outstanding</small><div class="@(SelectedInvoice.AmountOutstanding > 0 ? "text-danger fw-medium" : "text-success")">@SelectedInvoice.CurrencyCode @SelectedInvoice.AmountOutstanding.ToString("N2")</div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

