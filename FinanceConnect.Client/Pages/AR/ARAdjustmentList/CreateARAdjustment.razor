@page "/ar-adjustments/create"
@page "/ar-adjustments/{Id:guid}"

@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Shared

<style>
    .form-select option:checked {
        color: #fff;
        background: var(--primary);
    }
    .form-select:focus {
        border-color: var(--primary);
        box-shadow: none;
    }
    .validation-message {
        color: #dc3545;
        font-size: 11px;
        margin-top: 2px;
    }

    /* ===== PAGE HEADER WITH HANGING BADGE ===== */
    .ar-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0;
    }
    .ar-title-group {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }
    .ar-title-group h4 {
        margin: 0;
        font-weight: 700;
    }
    .ar-title-group h6 {
        margin: 0;
        color: #6c757d;
        font-weight: 400;
        font-size: 13px;
    }
    /* Hanging Adjustment Number Badge */
    .adj-number-ribbon {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(135deg, var(--primary) 0%, #f08a2c 100%);
        color: #fff;
        font-weight: 700;
        font-size: 13px;
        padding: 6px 16px 6px 12px;
        border-radius: 0 8px 8px 0;
        box-shadow: 0 3px 12px rgba(254, 159, 67, 0.35);
        letter-spacing: 0.3px;
        line-height: 1.3;
    }
    .adj-number-ribbon::before {
        content: '';
        position: absolute;
        left: -6px;
        top: 0;
        width: 0;
        height: 0;
        border-top: 0 solid transparent;
        border-bottom: 6px solid transparent;
        border-right: 6px solid #c97520;
    }
    .adj-number-ribbon::after {
        content: '';
        position: absolute;
        left: -6px;
        bottom: 0;
        width: 0;
        height: 0;
        border-top: 6px solid transparent;
        border-bottom: 0 solid transparent;
        border-right: 6px solid #c97520;
    }
    .adj-number-ribbon i {
        font-size: 14px;
        opacity: 0.85;
    }

    /* ===== RESPONSIVE ADJUSTMENT LINES ===== */
    .adjustment-line-item {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        margin-bottom: 12px;
        padding: 16px;
        transition: all 0.2s ease;
    }
    .adjustment-line-item:hover {
        border-color: var(--primary);
        box-shadow: 0 4px 12px rgba(254, 159, 67, 0.1);
    }
    .line-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e9ecef;
    }
    .line-item-number {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .line-number-badge {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary) 100%);
        color: #fff;
        font-weight: 700;
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 20px;
        min-width: 36px;
        text-align: center;
    }
    .line-item-total {
        text-align: right;
    }
    .line-item-total-label {
        font-size: 10px;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 600;
        letter-spacing: 0.5px;
    }
    .line-item-total-value {
        font-size: 18px;
        font-weight: 700;
        color: #212529;
    }
    .line-fields-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 12px;
        align-items: start;
    }
    .line-field {
        display: flex;
        flex-direction: column;
    }
    .line-field-label {
        font-size: 11px;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 600;
        margin-bottom: 4px;
        letter-spacing: 0.3px;
    }
    .line-field input,
    .line-field select,
    .line-field textarea {
        width: 100%;
        padding: 8px 10px;
        font-size: 13px;
        border-radius: 6px;
        border: 1px solid #ced4da;
        background-color: #fff;
        transition: all 0.2s ease;
    }
    .line-field input:focus,
    .line-field select:focus,
    .line-field textarea:focus {
        border-color: var(--primary);
        outline: none;
        box-shadow: 0 0 0 2px rgba(254, 159, 67, 0.15);
    }
    .line-field input.text-end {
        text-align: right;
    }

    /* Grid column spans - 4 columns layout */
    .col-type { grid-column: span 3; }
    .col-invoice { grid-column: span 3; }
    .col-amount { grid-column: span 2; }
    .col-account { grid-column: span 4; }

    /* Notes field - full width row */
    .col-notes-full { grid-column: span 12; }

    .line-item-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px dashed #e9ecef;
    }
    .line-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 500;
        border-radius: 6px;
        border: 1px solid;
        transition: all 0.15s ease;
        cursor: pointer;
        background: transparent;
    }
    .btn-duplicate { color: #0d6efd; border-color: #0d6efd; }
    .btn-duplicate:hover { background: #0d6efd; color: #fff; }
    .btn-delete-line { color: #dc3545; border-color: #dc3545; }
    .btn-delete-line:hover { background: #dc3545; color: #fff; }

    /* Totals section */
    .totals-card {
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 12px 16px;
        text-align: center;
    }
    .totals-card-label {
        font-size: 11px;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }
    .totals-card-value {
        font-size: 18px;
        font-weight: 700;
        color: #212529;
    }
    .totals-card-value.grand-total {
        color: var(--primary);
        font-size: 22px;
    }

    /* Approval indicator */
    .approval-indicator {
        padding: 10px 15px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .approval-indicator.required {
        background-color: #fff3cd;
        border: 1px solid #ffc107;
    }
    .approval-indicator.not-required {
        background-color: #d1e7dd;
        border: 1px solid #198754;
    }

    /* Empty state */
    .empty-lines-state {
        background: #f8f9fa;
        border: 2px dashed #dee2e6;
        border-radius: 10px;
        padding: 40px 20px;
        text-align: center;
        color: #6c757d;
    }
    .empty-lines-state i {
        font-size: 48px;
        margin-bottom: 12px;
        opacity: 0.5;
    }

    /* Mobile responsive */
    @@media (max-width: 992px) {
        .line-fields-grid {
            grid-template-columns: repeat(6, 1fr);
        }
        .col-type { grid-column: span 3; }
        .col-invoice { grid-column: span 3; }
        .col-amount { grid-column: span 3; }
        .col-account { grid-column: span 3; }
        .col-notes-full { grid-column: span 6; }
    }
    @@media (max-width: 576px) {
        .line-fields-grid {
            grid-template-columns: 1fr;
        }
        .col-type, .col-invoice, .col-amount, .col-account, .col-notes-full {
            grid-column: span 1;
        }
        .ar-title-group { flex-direction: column; align-items: flex-start; }
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    <div class="content">
        <!-- Page Header with Hanging Adjustment Number -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <div class="ar-title-group">
                        <div>
                            <h4 class="fw-bold">@(IsEdit ? "Edit" : "Create") AR Adjustment</h4>
                            <h6>@(IsEdit ? "Update adjustment details" : "Create a new AR adjustment")</h6>
                        </div>
                        <!-- Hanging Adjustment Number Ribbon -->
                        @if (!string.IsNullOrEmpty(Adjustment.AdjustmentNumber))
                        {
                            <div class="adj-number-ribbon">
                                <i class="ti ti-hash"></i>
                                @Adjustment.AdjustmentNumber
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="page-btn d-flex gap-2 align-items-center">
                <span class="badge @GetStatusBadgeClass(Adjustment.AdjustmentStatus) p-2" style="font-size: 12px;">
                    @AdjustmentStatuses.GetDisplayName(Adjustment.AdjustmentStatus)
                </span>
                @if (!IsReadOnly && Adjustment.AdjustmentStatus == AdjustmentStatuses.Draft)
                {
                    <button type="button" class="btn btn-outline-info" @onclick="SubmitAdjustment" title="Submit for Approval/Processing">
                        <i class="ti ti-send me-1"></i>Submit
                    </button>
                }
                @if (Adjustment.CanPost)
                {
                    <button type="button" class="btn btn-success" @onclick="PostAdjustment" title="Post Adjustment">
                        <i class="ti ti-check me-1"></i>Post
                    </button>
                }
            </div>
        </div>

        <EditForm Model="@Adjustment" OnSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <!-- Section 1: Header Information -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="ti ti-adjustments-horizontal me-2 text-primary"></i>Adjustment Header
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Branch -->
                        <div class="col-md-3">
                            <label class="form-label">Branch <span class="text-danger">*</span></label>
                            <select class="form-select @(HasHeaderError("BranchId") ? "is-invalid" : "")"
                                    @bind="Adjustment.BranchId" disabled="@IsReadOnly"
                                    title="Select the branch for this adjustment">
                                <option value="">--Select Branch--</option>
                                @foreach (var branch in Branches)
                                {
                                    <option value="@branch.Id">@branch.Code - @branch.Name</option>
                                }
                            </select>
                            @if (HasHeaderError("BranchId"))
                            {
                                <div class="validation-message">@GetHeaderError("BranchId")</div>
                            }
                        </div>

                        <!-- Customer -->
                        <div class="col-md-3">
                            <label class="form-label">Customer <span class="text-danger">*</span></label>
                            <SearchDropdown TItem="CustomerViewModel"
                                            Items="Customers"
                                            TextSelector="@(c => c.CustomerCode + " - " + c.CustomerName)"
                                            ValueSelector="@(c => c.Id)"
                                            @bind-Value="Adjustment.CustomerId"
                                            @bind-Value:after="OnCustomerChanged"
                                            Class="@(HasHeaderError("CustomerId")? "is-invalid" : "")"
                                            Placeholder="-- Select Customer --"
                                            Disabled="@IsReadOnly" />
                            @if (HasHeaderError("CustomerId"))
                            {
                                <div class="validation-message">@GetHeaderError("CustomerId")</div>
                            }
                        </div>

                        <!-- Adjustment Date -->
                        <div class="col-md-2">
                            <label class="form-label">Adjustment Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control @(HasHeaderError("AdjustmentDate") ? "is-invalid" : "")"
                                   @bind="Adjustment.AdjustmentDate" disabled="@IsReadOnly" />
                            @if (HasHeaderError("AdjustmentDate"))
                            {
                                <div class="validation-message">@GetHeaderError("AdjustmentDate")</div>
                            }
                        </div>

                        <!-- Currency -->
                        <div class="col-md-2">
                            <label class="form-label">Currency</label>
                            <input type="text" class="form-control" value="@Adjustment.CurrencyCode" readonly placeholder="From customer" />
                        </div>

                        <!-- Posting Date -->
                        <div class="col-md-2">
                            <label class="form-label">Posting Date</label>
                            <input type="date" class="form-control @(HasHeaderError("PostingDate") ? "is-invalid" : "")"
                                   @bind="Adjustment.PostingDate" min="@(Adjustment.AdjustmentDate.ToString("yyyy-MM-dd"))" disabled="@IsReadOnly" />
                            @if (HasHeaderError("PostingDate"))
                            {
                                <div class="validation-message">@GetHeaderError("PostingDate")</div>
                            }
                            <small class="text-muted">Required at posting</small>
                        </div>
                    </div>

                    <!-- Row 2 -->
                    <div class="row g-3 mt-1">
                        <!-- Customer Account -->
                        <div class="col-md-3">
                            <label class="form-label">Customer Account</label>
                            <input type="text" class="form-control" readonly
                                   value="@(Adjustment.CustomerAccountName ?? "Auto-resolved")"
                                   style="background-color: #e9ecef;" />
                            <small class="text-muted">Derived from Company + Customer + Currency</small>
                        </div>

                        <!-- IsSystemGenerated -->
                        <div class="col-md-3">
                            <label class="form-label">System Generated</label>
                            <div class="mt-1">
                                @if (Adjustment.IsSystemGenerated)
                                {
                                    <span class="badge bg-info p-2"><i class="ti ti-robot me-1"></i>Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary p-2"><i class="ti ti-user me-1"></i>No - Manual Entry</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 2: Adjustment Classification -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="ti ti-tag me-2 text-primary"></i>Adjustment Classification
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Adjustment Type -->
                        <div class="col-md-3">
                            <label class="form-label">Adjustment Type <span class="text-danger">*</span></label>
                            <select class="form-select @(HasHeaderError("AdjustmentType") ? "is-invalid" : "")"
                                    @bind="Adjustment.AdjustmentType" @bind:after="OnTypeChanged" disabled="@IsReadOnly">
                                <option value="">--Select Adjustment Type--</option>
                                @foreach (var type in AdjustmentTypes.All)
                                {
                                    <option value="@type">@AdjustmentTypes.GetDisplayName(type)</option>
                                }
                            </select>
                            @if (HasHeaderError("AdjustmentType"))
                            {
                                <div class="validation-message">@GetHeaderError("AdjustmentType")</div>
                            }
                            <small class="text-muted">@AdjustmentTypes.GetDescription(Adjustment.AdjustmentType)</small>
                        </div>

                        <!-- Reason Code -->
                        <div class="col-md-3">
                            <label class="form-label">Reason Code <span class="text-danger">*</span></label>
                            <select class="form-select @(HasHeaderError("ReasonCodeId") ? "is-invalid" : "")"
                                    @bind="Adjustment.ReasonCodeId" @bind:after="OnReasonChanged" disabled="@IsReadOnly">
                                <option value="">--Select Reason Code--</option>
                                @foreach (var reason in FilteredReasons)
                                {
                                    <option value="@reason.Id">@reason.ReasonCode - @reason.ReasonDescription</option>
                                }
                            </select>
                            @if (HasHeaderError("ReasonCodeId"))
                            {
                                <div class="validation-message">@GetHeaderError("ReasonCodeId")</div>
                            }
                        </div>

                        <!-- Direction -->
                        <div class="col-md-2">
                            <label class="form-label">Direction</label>
                            <div class="mt-2">
                                <span class="badge @GetDirectionBadgeClass(Adjustment.AdjustmentDirection) p-2">
                                    <i class="ti @(Adjustment.AdjustmentDirection == AdjustmentDirections.ReduceAR ? "ti-arrow-down" : "ti-arrow-up") me-1"></i>
                                    @AdjustmentDirections.GetDisplayName(Adjustment.AdjustmentDirection)
                                </span>
                            </div>
                        </div>

                        <!-- Approval Status -->
                        <div class="col-md-4">
                            <label class="form-label">Approval Status</label>
                            <div class="approval-indicator @(Adjustment.RequiresApproval ? "required" : "not-required")">
                                @if (Adjustment.RequiresApproval)
                                {
                                    <i class="ti ti-alert-circle text-warning fs-4"></i>
                                    <div>
                                        <div class="fw-medium">Approval Required</div>
                                        <small class="text-muted">Requires approval before posting</small>
                                    </div>
                                }
                                else
                                {
                                    <i class="ti ti-circle-check text-success fs-4"></i>
                                    <div>
                                        <div class="fw-medium text-success">No Approval Required</div>
                                        <small class="text-muted">Can be posted directly</small>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Narration & Approval Comment in ONE ROW -->
                        <div class="col-md-6">
                            <label class="form-label">
                                Narration / Notes
                                @if (Adjustment.IsNarrationRequired)
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>
                            <textarea class="form-control @(HasHeaderError("AdjustmentNarration") ? "is-invalid" : "")"
                                      rows="3" placeholder="Enter adjustment notes and justification..."
                                      @bind="Adjustment.AdjustmentNarration" disabled="@IsReadOnly" maxlength="1000"></textarea>
                            @if (HasHeaderError("AdjustmentNarration"))
                            {
                                <div class="validation-message">@GetHeaderError("AdjustmentNarration")</div>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Approval Comment <span class="text-muted fw-normal">(Optional)</span></label>
                            <textarea class="form-control" rows="3"
                                      placeholder="Enter approval comment if needed..."
                                      @bind="Adjustment.ApprovalComment" disabled="@IsReadOnly" maxlength="250"></textarea>
                            <small class="text-muted">Max 250 characters - visible to approver</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Adjustment Lines -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="ti ti-list me-2 text-primary"></i>Adjustment Lines
                    </h5>
                    @if (!IsReadOnly)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddLine">
                            <i class="ti ti-plus me-1"></i>Add Line
                        </button>
                    }
                </div>
                <div class="card-body">
                    @if (Adjustment.Lines.Any())
                    {
                        @foreach (var line in Adjustment.Lines)
                        {
                            var lineIndex = Adjustment.Lines.IndexOf(line);
                            <div class="adjustment-line-item">
                                <!-- Line Header -->
                                <div class="line-item-header">
                                    <div class="line-item-number">
                                        <span class="line-number-badge">@(lineIndex + 1)</span>
                                        <span class="badge @GetLineTypeBadgeClass(line.LineType)">
                                            @AdjustmentLineTypes.GetDisplayName(line.LineType)
                                        </span>
                                        @if (line.CustomerInvoiceId.HasValue)
                                        {
                                            <span class="text-muted small">
                                                <i class="ti ti-link me-1"></i>@line.CustomerInvoiceNumber
                                            </span>
                                        }
                                    </div>
                                    <div class="line-item-total">
                                        <div class="line-item-total-label">Amount</div>
                                        <div class="line-item-total-value">@line.AdjustmentAmount.ToString("N2")</div>
                                    </div>
                                </div>

                                <!-- Line Fields Grid -->
                                <div class="line-fields-grid">
                                    <!-- Line Type -->
                                    <div class="line-field col-type">
                                        <span class="line-field-label">Line Type <span class="text-danger">*</span></span>
                                        <select @bind="line.LineType" disabled="@IsReadOnly"
                                                class="@GetValidationClass(lineIndex, "LineType")">
                                            <option value="">--Select--</option>
                                            @foreach (var lineType in AdjustmentLineTypes.All)
                                            {
                                                <option value="@lineType">@AdjustmentLineTypes.GetDisplayName(lineType)</option>
                                            }
                                        </select>
                                        @if (HasValidationError(lineIndex, "LineType"))
                                        {
                                            <span class="validation-message">@GetValidationError(lineIndex, "LineType")</span>
                                        }
                                    </div>

                                    <!-- Invoice -->
                                    <div class="line-field col-invoice">
                                        <span class="line-field-label">Invoice (Optional)</span>
                                        <select @bind="line.CustomerInvoiceId" @bind:after="() => OnInvoiceSelected(line)"
                                                disabled="@IsReadOnly">
                                            <option value="">Customer Level</option>
                                            @foreach (var inv in CustomerInvoices)
                                            {
                                                <option value="@inv.Id">@inv.InvoiceNumber (O/S: @inv.AmountOutstanding.ToString("N2"))</option>
                                            }
                                        </select>
                                        @if (line.InvoiceOutstanding.HasValue)
                                        {
                                            <small class="text-muted">Outstanding: @line.InvoiceOutstanding?.ToString("N2")</small>
                                        }
                                    </div>

                                    <!-- Amount -->
                                    <div class="line-field col-amount">
                                        <span class="line-field-label">Amount <span class="text-danger">*</span></span>
                                        <input type="number" step="0.01" class="text-end @GetValidationClass(lineIndex, "AdjustmentAmount")"
                                               @bind="line.AdjustmentAmount" @bind:after="RecalculateTotals"
                                               disabled="@IsReadOnly" min="0.01" placeholder="0.00" />
                                        @if (HasValidationError(lineIndex, "AdjustmentAmount"))
                                        {
                                            <span class="validation-message">@GetValidationError(lineIndex, "AdjustmentAmount")</span>
                                        }
                                    </div>

                                    <!-- Offset Account -->
                                    <div class="line-field col-account">
                                        <span class="line-field-label">Offset Account <span class="text-danger">*</span></span>
                                        <select @bind="line.OffsetAccountId" disabled="@IsReadOnly"
                                                class="@GetValidationClass(lineIndex, "OffsetAccountId")">
                                            <option value="">--Select Account--</option>
                                            @foreach (var acc in OffsetAccounts)
                                            {
                                                <option value="@acc.Id">@acc.Code - @acc.Name</option>
                                            }
                                        </select>
                                        @if (HasValidationError(lineIndex, "OffsetAccountId"))
                                        {
                                            <span class="validation-message">@GetValidationError(lineIndex, "OffsetAccountId")</span>
                                        }
                                    </div>

                                    <!-- Notes - Full Width with Rich Text Editor -->
                                    <div class="line-field col-notes-full">
                                        <span class="line-field-label">Notes</span>
                                        @if (!IsReadOnly)
                                        {
                                            <RichTextEditor @ref="lineEditors[lineIndex]"
                                                            Value="@line.LineNarration"
                                                            Placeholder="Enter line notes..."
                                                            MinHeight="60"
                                                            MaxHeight="150" />
                                        }
                                        else
                                        {
                                            <div class="form-control" style="min-height: 60px; background: #e9ecef;">
                                                @((MarkupString)(line.LineNarration ?? ""))
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Line Actions -->
                                @if (!IsReadOnly)
                                {
                                    <div class="line-item-actions">
                                        <button type="button" class="line-action-btn btn-duplicate" @onclick="() => DuplicateLine(line)">
                                            <i class="ti ti-copy"></i>Duplicate
                                        </button>
                                        @if (Adjustment.Lines.Count > 1)
                                        {
                                            <button type="button" class="line-action-btn btn-delete-line" @onclick="() => RemoveLine(line)">
                                                <i class="ti ti-trash"></i>Delete
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-lines-state">
                            <i class="ti ti-file-plus d-block"></i>
                            <h6>No lines added yet</h6>
                            <p class="mb-3">Click "Add Line" to add adjustment items</p>
                            @if (!IsReadOnly)
                            {
                                <button type="button" class="btn btn-primary" @onclick="AddLine">
                                    <i class="ti ti-plus me-1"></i>Add First Line
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Section 4: Totals Summary -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="ti ti-calculator me-2 text-primary"></i>Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="totals-card">
                                <div class="totals-card-label">Total Lines</div>
                                <div class="totals-card-value">@Adjustment.Lines.Count</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="totals-card" style="background: linear-gradient(135deg, var(--primary) 0%, #f08a2c 100%);">
                                <div class="totals-card-label text-white">Total Adjustment</div>
                                <div class="totals-card-value grand-total text-white">@Adjustment.TotalAdjustmentAmount.ToString("N2")</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="totals-card">
                                <div class="totals-card-label">Currency</div>
                                <div class="totals-card-value">@(Adjustment.CurrencyCode ?? "INR")</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="totals-card">
                                <div class="totals-card-label">Direction</div>
                                <div class="totals-card-value">
                                    <span class="badge @GetDirectionBadgeClass(Adjustment.AdjustmentDirection)">
                                        @AdjustmentDirections.GetDisplayName(Adjustment.AdjustmentDirection)
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Evidence Required Warning -->
            @if (Adjustment.EvidenceRequired && Adjustment.EvidenceAttachmentCount == 0)
            {
                <div class="alert alert-warning mb-4">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <strong>Evidence Required:</strong> This adjustment type requires supporting documentation.
                    Please attach evidence before submitting.
                </div>
            }

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end gap-3 mb-4">
                <a href="/ar-adjustments" class="btn btn-secondary">
                    <i class="ti ti-x me-1"></i>Cancel
                </a>
                @if (!IsReadOnly)
                {
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1"></i>@(IsEdit ? "Update" : "Save")
                    </button>
                }
            </div>
        </EditForm>
    </div>
}
