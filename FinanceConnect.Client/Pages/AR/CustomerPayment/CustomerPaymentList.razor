@page "/customer-payments"

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Customer Payment List</h4>
                    <h6>Manage your AR receipts and payments</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/customer-payments/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Statistics Cards -->
          <div class="row mb-0">
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #0fb7c6, #007e84) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Total</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.TotalPayments</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-white rounded-circle p-2" style="background: #ffffff47;width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;">
                                <i class="ti ti-receipt" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #092c4c, #00396e) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Draft</h6>
                                <h5 class="mb-0 fw-bold text-secondary text-white">@Statistics.DraftPayments</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-secondary rounded-circle p-2" style="background: #ffffff47;width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;">
                                <i class="ti ti-file-text text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #155eef, #002e8b) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Approved</h6>
                                <h5 class="mb-0 fw-bold text-info text-white">@Statistics.ApprovedPayments</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-info rounded-circle p-2" style="background: #ffffff47;width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;">
                                <i class="ti ti-check text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #3eb780, #008146) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Posted</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.PostedPayments</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-success rounded-circle p-2" style="background: #ffffff47;width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;">
                                <i class="ti ti-circle-check text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #ff002c, #b10000) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Reversed</h6>
                                <h5 class="mb-0 fw-bold text-danger text-white">@Statistics.ReversedPayments</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-danger rounded-circle p-2" style="background: #ffffff47;width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;">
                                <i class="ti ti-arrow-back-up text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #83004d, #a70094) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Total Received</h6>
                                <h5 class="mb-0 fw-bold text-warning text-white" style="font-size: 14px;">@Statistics.TotalReceivedAmount.ToString("N0")</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-warning rounded-circle p-2" style="background: #ffffff47;width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;">
                                <i class="ti ti-currency-rupee text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        
        </div>


        <!-- Payment List -->
        <div class="card">
            <div class="card-header d-flex align-items-end justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search by receipt no, customer, instrument..."
                               @bind="searchTerm" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: end;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="selectedStatus" @bind:after="ApplyFilters">
                            <option value="">All Status</option>
                            @foreach (var status in DistinctStatuses)
                            {
                                <option value="@status">@PaymentStatuses.GetDisplayName(status)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="selectedMethod" @bind:after="ApplyFilters">
                            <option value="">All Methods</option>
                            @foreach (var method in DistinctMethods)
                            {
                                <option value="@method">@PaymentMethods.GetDisplayName(method)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2 filter-date">
                        <label class="form-label">From</label>
                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="FromDate" @bind:after="ApplyFilters" title="From Date" />
                    </div>
                    <div class="ms-2 filter-date">
                        <label class="form-label">To</label>
                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="ToDate" @bind:after="ApplyFilters" title="To Date" />
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <div>
                        <table class="table align-middle w-100" style="table-layout:fixed;">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xl-none" style="width:40px"></th>
                                    <th style="width:13%">Receipt No</th>
                                    <th class="d-none d-md-table-cell" style="width:18%">Customer</th>
                                    <th class="d-none d-xl-table-cell" style="width:7%">Method</th>
                                    <th class="d-none d-xl-table-cell" style="width:10%">Date</th>
                                    <th class="d-none d-xl-table-cell" style="width:16%">Instrument</th>
                                    <th class="d-none d-xl-table-cell text-end" style="width:11%">Amount</th>
                                    <th class="d-none d-md-table-cell" style="width:10%">Status</th>
                                    <th style="width:15%">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedPayments.Any())
                                {
                                    @foreach (var pmt in PagedPayments)
                                    {
                                        <tr>
                                            <!-- PLUS ICON -->
                                            <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#rowDetailsModal"
                                                   @onclick="() => OpenRowDetails(pmt)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td class="fw-medium" style="white-space:nowrap;">
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a href="/customer-payments/@pmt.Id/view" class="text-decoration-none link-View"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title="@pmt.ReceiptNumber details">
                                                    @pmt.ReceiptNumber
                                                </a>
                                            </td>

                                            <td class="d-none d-md-table-cell">
                                                <div class="fw-medium" style="white-space:nowrap;">@pmt.CustomerCode</div>
                                                <small class="text-muted" style="white-space:nowrap;">@pmt.CustomerName</small>
                                            </td>

                                            <td class="d-none d-xl-table-cell">
                                                <span class="badge @GetMethodBadgeClass(pmt.PaymentMethod)"
                                                      data-bs-toggle="tooltip"
                                                      data-bs-placement="top"
                                                      title="@PaymentMethods.GetDisplayName(pmt.PaymentMethod)">

                                                    <i class="@GetPaymentMethodIcon(pmt.PaymentMethod)"></i>

                                                    @* @PaymentMethods.GetDisplayName(pmt.PaymentMethod) *@
                                                </span>
                                            </td>

                                            @* <td class="d-none d-xl-table-cell">
                                                <span class="badge @GetMethodBadgeClass(pmt.PaymentMethod)">@PaymentMethods.GetDisplayName(pmt.PaymentMethod)</span>
                                            </td> *@

                                            <td class="d-none d-xl-table-cell">
                                                @pmt.ReceiptDate.ToString("dd-MMM-yy")
                                            </td>

                                            <td class="d-none d-xl-table-cell">
                                                @if (!string.IsNullOrEmpty(pmt.InstrumentNumber))
                                                {
                                                    <span class="text-primary" style="white-space:nowrap;" title="@pmt.InstrumentNumber">@pmt.InstrumentNumber</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>

                                            <td class="d-none d-xl-table-cell fw-medium text-end">
                                              @* @pmt.PaymentAmountTotal.ToString("N2") *@
                                                @IndianNumberFormatter.Format(@pmt.PaymentAmountTotal)
                                            </td>

                                            <td class="d-none d-md-table-cell">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="ActiveDot @GetStatusDotBadgeClass(pmt.Status)">
                                                    </div>
                                                    <span>@PaymentStatuses.GetDisplayName(pmt.Status)</span>
                                                </div>
                                            </td>

                                            <td class="action-table-data">
                                                <div class="edit-delete-action">
                                                    @if (pmt.CanEdit)
                                                    {
                                                        <a class="me-2 edit-icon p-1" href="/customer-payments/@pmt.Id" title="Edit">
                                                            <i data-feather="edit"></i>
                                                        </a>
                                                    }
                                                    @if (pmt.Status == PaymentStatuses.Submitted)
                                                    {
                                                        <a class="me-2 p-1 action-icon" href="javascript:void(0);"
                                                           title="Approve Payment" data-bs-toggle="modal" data-bs-target="#approveModal"
                                                           @onclick="() => OpenApproveModal(pmt)">
                                                            <i class="ti ti-check"></i>
                                                        </a>
                                                    }
                                                    @if (pmt.CanPost)
                                                    {
                                                        <a class="me-2 p-1 action-icon Issue" href="javascript:void(0);"
                                                           title="Post Payment" data-bs-toggle="modal" data-bs-target="#postModal"
                                                           @onclick="() => OpenPostModal(pmt)">
                                                            <i class="ti ti-send"></i>
                                                        </a>
                                                    }
                                                    @if (pmt.CanCancel)
                                                    {
                                                        <a class="me-2 p-1 action-icon Bounce" href="javascript:void(0);"
                                                           title="Cancel Payment" data-bs-toggle="modal" data-bs-target="#cancelModal"
                                                           @onclick="() => OpenCancelModal(pmt)">
                                                            <i class="ti ti-ban"></i>
                                                        </a>
                                                    }
                                                    @if (pmt.CanReverse)
                                                    {
                                                        <a class="me-2 p-1 action-icon Bounce" href="javascript:void(0);"
                                                           title="Reverse Payment (Bounce)" data-bs-toggle="modal" data-bs-target="#reverseModal"
                                                           @onclick="() => OpenReverseModal(pmt)">
                                                            <i class="ti ti-arrow-back-up"></i>
                                                        </a>
                                                    }
                                                    @if (pmt.Status == PaymentStatuses.Draft)
                                                    {
                                                        <a class="p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                                           data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                           @onclick="() => OpenDeleteModal(pmt)">
                                                            <i data-feather="trash-2"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@VisibleColumnCount" class="text-center py-4 text-muted">
                                            <i class="ti ti-database-off fs-1 d-block mb-2"></i>
                                            No payments found. Click "Create Payment" to add one.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                        <div class="d-flex align-items-center">
                            <span class="me-2">Rows per page</span>
                            <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                                <option value="5" selected="@(PageSize == 5)">5</option>
                                <option value="10" selected="@(PageSize == 10)">10</option>
                                <option value="25" selected="@(PageSize == 25)">25</option>
                                <option value="50" selected="@(PageSize == 50)">50</option>
                            </select>
                            <span class="ms-3 text-muted">
                                Entries
                            </span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = 1; i <= TotalPages; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages || TotalPages == 0 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Approve Modal -->
    <div class="modal fade" id="approveModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-primary-transparent mb-2">
                            <i class="ti ti-check fs-24 text-primary"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Approve Payment</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to approve <strong>@SelectedPayment?.ReceiptNumber</strong> for approval?
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-primary fs-13 fw-medium p-2 px-4" @onclick="ApprovePayment"><i class="ti ti-check me-1"></i>Yes, Approve</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Post Modal -->
    <div class="modal fade" id="postModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                            <i class="ti ti-send fs-24 text-success"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Post Payment</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to post <strong>@SelectedPayment?.ReceiptNumber</strong>?
                        </p>
                        <div class="alert alert-warning mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            Once posted, the payment cannot be edited. Use reversal for corrections.
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="PostPayment"><i class="ti ti-send me-1"></i>Yes, Post</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cancel Modal -->
    <div class="modal fade" id="cancelModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                            <i class="ti ti-ban fs-24 text-warning"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Cancel Payment</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to cancel payment <strong>@SelectedPayment?.ReceiptNumber</strong>?
                        </p>
                        <div class="mt-3 text-start">
                            <label class="form-label">Cancellation Reason <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="3" @bind="cancelReasonInput" placeholder="Enter reason for cancelling this payment..."></textarea>
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Close</button>
                            <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="CancelPayment"><i class="ti ti-ban me-1"></i>Yes, Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reverse Modal -->
    <div class="modal fade" id="reverseModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-arrow-back-up fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Reverse Payment</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to reverse posted payment <strong>@SelectedPayment?.ReceiptNumber</strong>?
                        </p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This will reverse all GL entries and restore invoice outstanding amounts.
                        </div>
                        <div class="mt-3 text-start">
                            <label class="form-label">Reversal Reason <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="2" @bind="reversalReasonInput" placeholder="e.g., Cheque bounced - Insufficient funds"></textarea>
                        </div>
                        <div class="mt-3 text-start">
                            <label class="form-label">Bank Reference (Optional)</label>
                            <input type="text" class="form-control" @bind="reversalRefInput" placeholder="e.g., Bounce memo number" />
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="ReversePayment"><i class="ti ti-arrow-back-up me-1"></i>Yes, Reverse</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Payment</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to delete <strong>@SelectedPayment?.ReceiptNumber</strong>?
                        </p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This action cannot be undone.
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeletePayment"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row Details Modal (Mobile) -->
    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Payment Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            style="padding:0; right:22px; position:absolute;transform:none"></button>
                </div>
                <div class="modal-body">
                    @if (SelectedPayment != null)
                    {
                        <div class="mb-2 d-flex gap-3">
                            <strong>Receipt No:</strong>
                            <div>@SelectedPayment.ReceiptNumber</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Customer:</strong>
                            <div>@SelectedPayment.CustomerCode - @SelectedPayment.CustomerName</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Method:</strong>
                            <div><span class="badge @GetMethodBadgeClass(SelectedPayment.PaymentMethod)">@PaymentMethods.GetDisplayName(SelectedPayment.PaymentMethod)</span></div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Date:</strong>
                            <div>@SelectedPayment.ReceiptDate.ToString("dd-MMM-yyyy")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Instrument:</strong>
                            <div>@(SelectedPayment.InstrumentNumber ?? "-")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Amount:</strong>
                            <div class="fw-medium">@SelectedPayment.CurrencyCode @SelectedPayment.PaymentAmountTotal.ToString("N2")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Status:</strong>
                            <div><span class="badge @GetStatusBadgeClass(SelectedPayment.Status)">@PaymentStatuses.GetDisplayName(SelectedPayment.Status)</span></div>
                        </div>
                    }
                </div>
                @* <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <a href="/customer-payment/@SelectedPayment?.Id" class="btn btn-info btn-sm">
                        <i class="ti ti-eye me-1"></i>View
                    </a>
                    @if (SelectedPayment?.CanEdit == true)
                    {
                        <a href="/create-customer-payment/@SelectedPayment?.Id" class="btn btn-primary btn-sm">
                            <i class="ti ti-pencil me-1"></i>Edit
                        </a>
                    }
                </div> *@
            </div>
        </div>
    </div>
}
