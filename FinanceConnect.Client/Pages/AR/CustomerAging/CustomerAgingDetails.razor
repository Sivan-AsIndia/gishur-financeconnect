@page "/customer-aging/{Id:guid}"
@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services

<PageTitle>Customer Aging Details - FinanceConnect</PageTitle>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else if (AgingSnapshot == null)
{
    <div class="container view-screen py-4">
        <div class="alert alert-warning">
            <i class="ti ti-alert-triangle me-2"></i>
            Aging snapshot not found.
        </div>
        <a href="/customer-aging" class="btn btn-secondary">
            <i class="ti ti-arrow-left me-1"></i> Back to List
        </a>
    </div>
}
else
{
    <div class="content">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-1">Customer Aging Details</h4>
                <p class="text-muted mb-0 small">View outstanding invoices and aging summary</p>
            </div>
            <a href="/customer-aging" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Back
            </a>
        </div>

        <!-- HEADER CARD - Company Details Style -->
        <div class="card mb-3">
            <div class="header-card">
                <div class="header-inner">
                    <div class="header-left1">
                        <div class="company-logo" style="background: linear-gradient(135deg, #ff8a00, #ff6b00); border-color: #ff8a00;">
                            <i class="ti ti-chart-bar" style="font-size: 24px; color: #fff;"></i>
                        </div>
                        <div class="header-meta">
                            <h2 class="company-title" style="font-size: 20px;">Aging Report - @AgingSnapshot.AsOfDate.ToString("dd-MMM-yyyy")</h2>
                            <div class="company-subtitle">
                                <span>@AgingSnapshot.CompanyName</span>
                                <span class="dot">·</span>
                                <span>@(AgingSnapshot.BranchName ?? "All Branches")</span>
                                <span class="dot">·</span>
                                <span>@(AgingSnapshot.CurrencyCode ?? "INR")</span>
                            </div>
                            <div class="header-tags">
                                <span class="tag" style="border: 1px solid #0ed77a; background: #e6f9f0; color: #14a85a;">
                                    @SnapshotStatuses.GetDisplayName(AgingSnapshot.SnapshotStatus)
                                </span>
                                <span class="tag" style="border: 1px solid #0081ff; background: #e9f3ff; color: #1420ff;">
                                    @AgingBasisTypes.GetDisplayName(AgingSnapshot.AgingBasis) Basis
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="header-right">
                        @if (AgingSnapshot.SnapshotStatus == SnapshotStatuses.Completed)
                        {
                            <span class="status-badge status-active">● COMPLETED</span>
                        }
                        else if (AgingSnapshot.SnapshotStatus == SnapshotStatuses.Generating)
                        {
                            <span class="status-badge status-draft">● GENERATING</span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive">● FAILED</span>
                        }
                        <div class="created-info">Generated @AgingSnapshot.GeneratedOn.ToString("dd MMM yyyy")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">

            <!-- LEFT PANEL: SNAPSHOT DETAILS & CUSTOMER LIST -->
            <div class="col-lg-8">

                <!-- Aging Bucket Summary -->
                <div class="card mb-3">
                    <div class="card-body p-3">
                        <h6 class="fw-semibold mb-3" style="font-size: 14px; color: #333;">
                            <i class="ti ti-chart-bar me-2" style="color: var(--primary);"></i>Aging Bucket Summary
                        </h6>
                        <div class="row text-center g-2">
                            <div class="col">
                                <div class="p-2 bg-success bg-opacity-10 rounded cursor-pointer @(selectedBucket == AgingBucketCodes.Current ? "border border-success border-2" : "")"
                                     @onclick='() => FilterByBucket(AgingBucketCodes.Current)' title="Click to filter by Current bucket">
                                    <small class="text-muted d-block" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Current</small>
                                    <span class="fw-bold text-success">@(AgingSnapshot.CurrencyCode ?? "₹") @BucketSummaryViewModel.CurrentAmount.ToString("N0")</span>
                                    <small class="d-block text-muted">@BucketSummaryViewModel.CurrentCount invoices</small>
                                </div>
                            </div>
                            <div class="col">
                                <div class="p-2 bg-info bg-opacity-10 rounded cursor-pointer @(selectedBucket == AgingBucketCodes.Days1To30 ? "border border-info border-2" : "")"
                                     @onclick='() => FilterByBucket(AgingBucketCodes.Days1To30)' title="Click to filter by 1-30 Days bucket">
                                    <small class="text-muted d-block" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">1-30 Days</small>
                                    <span class="fw-bold text-info">@(AgingSnapshot.CurrencyCode ?? "₹") @BucketSummaryViewModel.Days1To30Amount.ToString("N0")</span>
                                    <small class="d-block text-muted">@BucketSummaryViewModel.Days1To30Count invoices</small>
                                </div>
                            </div>
                            <div class="col">
                                <div class="p-2 bg-warning bg-opacity-10 rounded cursor-pointer @(selectedBucket == AgingBucketCodes.Days31To60 ? "border border-warning border-2" : "")"
                                     @onclick='() => FilterByBucket(AgingBucketCodes.Days31To60)' title="Click to filter by 31-60 Days bucket">
                                    <small class="text-muted d-block" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">31-60 Days</small>
                                    <span class="fw-bold text-warning">@(AgingSnapshot.CurrencyCode ?? "₹") @BucketSummaryViewModel.Days31To60Amount.ToString("N0")</span>
                                    <small class="d-block text-muted">@BucketSummaryViewModel.Days31To60Count invoices</small>
                                </div>
                            </div>
                            <div class="col">
                                <div class="p-2 rounded cursor-pointer @(selectedBucket == AgingBucketCodes.Days61To90 ? "border border-2" : "")"
                                     style="background-color: rgba(255, 165, 0, 0.1); @(selectedBucket == AgingBucketCodes.Days61To90 ? "border-color: #ff8c00;" : "")"
                                     @onclick='() => FilterByBucket(AgingBucketCodes.Days61To90)' title="Click to filter by 61-90 Days bucket">
                                    <small class="text-muted d-block" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">61-90 Days</small>
                                    <span class="fw-bold" style="color: #ff8c00;">@(AgingSnapshot.CurrencyCode ?? "₹") @BucketSummaryViewModel.Days61To90Amount.ToString("N0")</span>
                                    <small class="d-block text-muted">@BucketSummaryViewModel.Days61To90Count invoices</small>
                                </div>
                            </div>
                            <div class="col">
                                <div class="p-2 bg-danger bg-opacity-10 rounded cursor-pointer @(selectedBucket == AgingBucketCodes.Days90Plus ? "border border-danger border-2" : "")"
                                     @onclick='() => FilterByBucket(AgingBucketCodes.Days90Plus)' title="Click to filter by 90+ Days bucket">
                                    <small class="text-muted d-block" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">90+ Days</small>
                                    <span class="fw-bold text-danger">@(AgingSnapshot.CurrencyCode ?? "₹") @BucketSummaryViewModel.Days90PlusAmount.ToString("N0")</span>
                                    <small class="d-block text-muted">@BucketSummaryViewModel.Days90PlusCount invoices</small>
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(selectedBucket))
                        {
                            <div class="text-center mt-2">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearBucketFilter">
                                    <i class="ti ti-x me-1"></i>Clear Filter
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Customer Aging Summary Table -->
                <div class="card mb-3">
                    <div class="card-header py-2 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span style="font-size: 14px; font-weight: 600; color: var(--primary);">
                                <i class="ti ti-users me-1"></i>Customer Aging Summary
                            </span>
                            <span class="badge bg-primary ms-1">@FilteredCustomerRows.Count</span>
                            @if (showOverdueOnly)
                            {
                                <span class="badge bg-danger ms-1">Overdue Only</span>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div style="position: relative;">
                                <span style="position: absolute; left: 8px; top: 7px; color: #999;"><i class="ti ti-search" style="font-size: 14px;"></i></span>
                                <input type="search" class="form-control form-control-sm" placeholder="Search customer..."
                                       @bind="customerSearchText" @oninput="OnCustomerSearch" style="width: 180px; padding-left: 28px; font-size: 12px;" />
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="overdueToggle" @bind="showOverdueOnly" @bind:after="ApplyCustomerFilters"
                                       title="Show only customers with overdue invoices">
                                <label class="form-check-label small" for="overdueToggle">Overdue Only</label>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 aging-summary-table">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="min-width: 160px;">Customer</th>
                                        <th class="text-end" style="min-width: 100px;">Total</th>
                                        <th class="text-end" style="min-width: 85px;">Current</th>
                                        <th class="text-end" style="min-width: 85px;">1-30</th>
                                        <th class="text-end" style="min-width: 85px;">31-60</th>
                                        <th class="text-end" style="min-width: 85px;">61-90</th>
                                        <th class="text-end" style="min-width: 85px;">90+</th>
                                        <th class="text-center" style="min-width: 80px;">Max Days</th>
                                        <th style="min-width: 90px;">Oldest Due</th>
                                        <th class="text-center" style="min-width: 70px;">Open Inv</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (FilteredCustomerRows.Any())
                                    {
                                        @foreach (var row in FilteredCustomerRows.Take(20))
                                        {
                                            <tr class="cursor-pointer @(SelectedCustomerRow?.CustomerId == row.CustomerId ? "table-active" : "")"
                                                @onclick="() => SelectCustomer(row)" title="Click to view invoice details">
                                                <td>
                                                    <div class="fw-medium" style="font-size: 13px;">@row.CustomerCodeSnapshot</div>
                                                    <small class="text-muted" style="font-size: 11px;">@row.CustomerNameSnapshot</small>
                                                </td>
                                                <td class="text-end fw-bold" style="font-size: 13px;">@row.TotalOutstanding.ToString("N0")</td>
                                                <td class="text-end text-success" style="font-size: 13px;">@FormatAmount(row.BucketCurrentAmount)</td>
                                                <td class="text-end text-info" style="font-size: 13px;">@FormatAmount(row.Bucket1To30Amount)</td>
                                                <td class="text-end text-warning" style="font-size: 13px;">@FormatAmount(row.Bucket31To60Amount)</td>
                                                <td class="text-end" style="color: #ff8c00; font-size: 13px;">@FormatAmount(row.Bucket61To90Amount)</td>
                                                <td class="text-end text-danger" style="font-size: 13px;">@FormatAmount(row.Bucket90PlusAmount)</td>
                                                <td class="text-center">
                                                    @if (row.MaxOverdueDays > 0)
                                                    {
                                                        <span class="badge @GetOverdueBadgeClass(row.MaxOverdueDays)">@row.MaxOverdueDays Days</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (row.OldestDueDate.HasValue)
                                                    {
                                                        <span class="small">@row.OldestDueDate.Value.ToString("dd-MMM-yy")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-secondary">@row.InvoiceCountOpen</span>
                                                </td>
                                            </tr>
                                        }
                                        @if (FilteredCustomerRows.Count > 20)
                                        {
                                            <tr>
                                                <td colspan="10" class="text-center text-muted small py-2">
                                                    Showing 20 of @FilteredCustomerRows.Count customers. Use search to find specific customers.
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="10" class="text-center py-4">
                                                <i class="ti ti-users-minus fs-1 text-muted d-block mb-2"></i>
                                                No customers found matching the criteria.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Invoice Drilldown -->
                @if (SelectedCustomerRow != null)
                {
                    <div class="card mb-3">
                        <div class="card-header py-2 d-flex justify-content-between align-items-center">
                            <span style="font-size: 14px; font-weight: 600; color: var(--primary);">
                                <i class="ti ti-file-invoice me-1"></i>Invoice Details - @SelectedCustomerRow.CustomerCodeSnapshot
                            </span>
                            <span class="badge bg-info">@CustomerInvoiceRows.Count Invoices</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0 invoice-detail-table">
                                    <thead class="thead-light">
                                        <tr>
                                            <th style="min-width: 140px;">Invoice No</th>
                                            <th style="min-width: 110px;">Invoice Date</th>
                                            <th style="min-width: 110px;">Due Date</th>
                                            <th class="text-end" style="min-width: 120px;">Outstanding</th>
                                            <th class="text-center" style="min-width: 90px;">Overdue</th>
                                            <th class="text-center" style="min-width: 90px;">Bucket</th>
                                            <th class="text-center" style="min-width: 90px;">Source</th>
                                            <th style="min-width: 110px;">Last Payment</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var inv in CustomerInvoiceRows)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="fw-medium" style="font-size: 13px;">@inv.InvoiceNumberSnapshot</span>
                                                </td>
                                                <td style="font-size: 13px;">@inv.InvoiceDateSnapshot.ToString("dd-MMM-yy")</td>
                                                <td style="font-size: 13px;">@inv.DueDateSnapshot.ToString("dd-MMM-yy")</td>
                                                <td class="text-end fw-semibold" style="font-size: 13px;">@inv.OutstandingAmount.ToString("N2")</td>
                                                <td class="text-center">
                                                    @if (inv.OverdueDays > 0)
                                                    {
                                                        <span class="text-danger fw-medium" style="font-size: 12px;">@inv.OverdueDays days</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge @GetBucketBadgeClass(inv.BucketCode)">@AgingBucketCodes.GetDisplayName(inv.BucketCode)</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-secondary-transparent text-secondary">@SourceDocumentTypes.GetDisplayName(inv.SourceDocumentType)</span>
                                                </td>
                                                <td style="font-size: 13px;">
                                                    @if (inv.LastPaymentDateSnapshot.HasValue)
                                                    {
                                                        <span>@inv.LastPaymentDateSnapshot.Value.ToString("dd-MMM-yy")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

            </div>

            <!-- RIGHT PANEL: SNAPSHOT INFO -->
            <div class="col-lg-4">

                <!-- Snapshot Totals -->
                <div class="card mb-3">
                    <div class="card-header py-2" style="color: var(--primary); font-weight: 600;">
                        <i class="ti ti-calculator me-2"></i> Snapshot Totals
                    </div>
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Total Outstanding</span>
                            <span class="fw-bold text-primary">@(AgingSnapshot.CurrencyCode ?? "₹") @AgingSnapshot.TotalOutstandingAmount.ToString("N2")</span>
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Customers</span>
                            <span class="fw-medium">@AgingSnapshot.RecordCountCustomers</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Invoices</span>
                            <span class="fw-medium">@AgingSnapshot.RecordCountInvoices</span>
                        </div>
                    </div>
                </div>

                <!-- Snapshot Info -->
                <div class="card mb-3">
                    <div class="card-header py-2" style="color: var(--primary); font-weight: 600;">
                        <i class="ti ti-info-circle me-2"></i> Snapshot Information
                    </div>
                    <div class="card-body py-2">
                        <div class="row">
                            <div class="col-6 mb-2">
                                <small class="text-muted">As Of Date</small>
                                <div class="fw-medium">@AgingSnapshot.AsOfDate.ToString("dd-MMM-yyyy")</div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Aging Basis</small>
                                <div><span class="badge @GetBasisBadgeClass(AgingSnapshot.AgingBasis)">@AgingBasisTypes.GetDisplayName(AgingSnapshot.AgingBasis)</span></div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Status</small>
                                <div><span class="badge @GetStatusBadgeClass(AgingSnapshot.SnapshotStatus)">@SnapshotStatuses.GetDisplayName(AgingSnapshot.SnapshotStatus)</span></div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Policy Version</small>
                                <div class="fw-medium">v@AgingSnapshot.BucketPolicyVersion</div>
                            </div>
                            <div class="col-12 mb-2">
                                <small class="text-muted">Generated On</small>
                                <div class="fw-medium">@AgingSnapshot.GeneratedOn.ToString("dd-MMM-yyyy HH:mm:ss")</div>
                            </div>
                            <div class="col-12 mb-2">
                                <small class="text-muted">Generated By</small>
                                <div>@(AgingSnapshot.GeneratedByUserName ?? "System")</div>
                            </div>
                            @if (!string.IsNullOrEmpty(AgingSnapshot.JobRunId))
                            {
                                <div class="col-12 mb-2">
                                    <small class="text-muted">Job Run ID</small>
                                    <div><code class="small">@AgingSnapshot.JobRunId</code></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Scope -->
                <div class="card mb-3">
                    <div class="card-header py-2" style="color: var(--primary); font-weight: 600;">
                        <i class="ti ti-building me-2"></i> Scope
                    </div>
                    <div class="card-body py-2">
                        <div class="mb-2">
                            <small class="text-muted">Company</small>
                            <div class="fw-medium">@AgingSnapshot.CompanyName</div>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">Branch</small>
                            <div>@(AgingSnapshot.BranchName ?? "All Branches")</div>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">Currency</small>
                            <div>@(AgingSnapshot.CurrencyCode ?? "INR") - @(AgingSnapshot.CurrencyName ?? "Indian Rupee")</div>
                        </div>
                    </div>
                </div>

                <!-- Bucket Definition -->
                <div class="card mb-3">
                    <div class="card-header py-2" style="color: var(--primary); font-weight: 600;">
                        <i class="ti ti-list-details me-2"></i> Bucket Definition
                    </div>
                    <div class="card-body py-2">
                        <div class="small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-success">Current</span>
                                <span>≤ 0 days overdue</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-info">1-30 Days</span>
                                <span>1 to 30 days overdue</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-warning">31-60 Days</span>
                                <span>31 to 60 days overdue</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span style="color: #ff8c00;">61-90 Days</span>
                                <span>61 to 90 days overdue</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-danger">90+ Days</span>
                                <span>> 90 days overdue</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Audit Trail -->
                <div class="card mb-3">
                    <div class="card-header py-2" style="color: var(--primary); font-weight: 600;">
                        <i class="ti ti-history me-2"></i> History
                    </div>
                    <div class="card-body py-2">
                        <div class="row">
                            <div class="col-12 mb-2">
                                <small class="text-muted">Created</small>
                                <div>@AgingSnapshot.CreatedAt.ToString("dd-MMM-yyyy HH:mm") by @(AgingSnapshot.CreatedBy ?? "System")</div>
                            </div>
                            @if (AgingSnapshot.UpdatedAt.HasValue)
                            {
                                <div class="col-12 mb-2">
                                    <small class="text-muted">Last Updated</small>
                                    <div>@AgingSnapshot.UpdatedAt.Value.ToString("dd-MMM-yyyy HH:mm") by @(AgingSnapshot.UpdatedBy ?? "-")</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
}
