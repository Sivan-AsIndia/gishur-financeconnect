@page "/customer-aging"

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Customer Aging Report</h4>
                    <h6>Time-based outstanding analysis by aging buckets</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh Data" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#generateModal">
                    <i class="ti ti-player-play me-1"></i>
                    Generate Snapshot
                </button>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="row row-cols-xl-5 row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-3 mb-0">
            <div class="col d-flex align-items-stretch" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #fe9f43, #d16000) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Total Snapshots</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.TotalSnapshots</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-white rounded-circle p-2" style="background: #ffffff47;width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;">
                                <i class="ti ti-camera" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col d-flex align-items-stretch" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #3eb780, #008146) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Completed</h6>
                                <h5 class="mb-0 fw-bold text-secondary text-white">@Statistics.CompletedSnapshots</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-secondary rounded-circle p-2" style="background: #ffffff47;width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;">
                                <i class="ti  ti-circle-check text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col d-flex align-items-stretch" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #ff0000, #e30000) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">
                                    Overdue Customers
                                </h6>
                                <h5 class="mb-0 fw-bold text-info text-white">@Statistics.OverdueCustomers</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-info rounded-circle p-2" style="background: #ffffff47;width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;">
                                <i class="ti ti-alert-triangle text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col d-flex align-items-stretch" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #ffad2b, #dcab03) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Failed</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.FailedSnapshots</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-success rounded-circle p-2" style="background: #ffffff47;width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;">
                                <i class="ti ti ti-x text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col d-flex align-items-stretch" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #006ba3, #1e0297) !important;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Total Outstanding</h6>
                                <h5 class="mb-0 fw-bold text-warning text-white" style="font-size: 14px;">@Statistics.TotalOutstanding.ToString("N0")</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-warning rounded-circle p-2" style="background: #ffffff47;width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;">
                                <i class="ti ti-currency-rupee text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>




        <!-- Bucket Summary Cards (from latest snapshot) -->
        @if (LatestSnapshot != null)
        {
            <div class="row mb-0">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header py-2 d-flex justify-content-between align-items-center">
                            <span><i class="ti ti-chart-bar me-2"></i>Aging Bucket Summary (As of @LatestSnapshot.AsOfDate.ToString("dd-MMM-yyyy"))</span>
                            <span class="badge bg-info-transparent text-info">@AgingBasisTypes.GetDisplayName(LatestSnapshot.AgingBasis) Basis</span>
                        </div>
                        <div class="card-body p-3">
                            <div class="row text-center">
                                <div class="col">
                                    <div class="p-2 bg-success bg-opacity-10 rounded">
                                        <small class="text-muted d-block">Current</small>
                                        <span class="fw-bold text-success">₹ @BucketSummaryViewModel.CurrentAmount.ToString("N0")</span>
                                        <small class="d-block text-muted">@BucketSummaryViewModel.CurrentCount inv</small>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="p-2 bg-info bg-opacity-10 rounded">
                                        <small class="text-muted d-block">1-30 Days</small>
                                        <span class="fw-bold text-info">₹ @BucketSummaryViewModel.Days1To30Amount.ToString("N0")</span>
                                        <small class="d-block text-muted">@BucketSummaryViewModel.Days1To30Count inv</small>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="p-2 bg-warning bg-opacity-10 rounded">
                                        <small class="text-muted d-block">31-60 Days</small>
                                        <span class="fw-bold text-warning">₹ @BucketSummaryViewModel.Days31To60Amount.ToString("N0")</span>
                                        <small class="d-block text-muted">@BucketSummaryViewModel.Days31To60Count inv</small>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="p-2 rounded" style="background-color: rgba(255, 165, 0, 0.1);">
                                        <small class="text-muted d-block">61-90 Days</small>
                                        <span class="fw-bold" style="color: #ff8c00;">₹ @BucketSummaryViewModel.Days61To90Amount.ToString("N0")</span>
                                        <small class="d-block text-muted">@BucketSummaryViewModel.Days61To90Count inv</small>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="p-2 bg-danger bg-opacity-10 rounded">
                                        <small class="text-muted d-block">90+ Days</small>
                                        <span class="fw-bold text-danger">₹ @BucketSummaryViewModel.Days90PlusAmount.ToString("N0")</span>
                                        <small class="d-block text-muted">@BucketSummaryViewModel.Days90PlusCount inv</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Snapshot List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search by company, branch, job ID..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="selectedAgingBasis" @bind:after="ApplyFilters"
                                title="Filter by Aging Basis">
                            <option value="">All Basis</option>
                            @foreach (var basis in AvailableAgingBases)
                            {
                                <option value="@basis">@AgingBasisTypes.GetDisplayName(basis)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="selectedStatus" @bind:after="ApplyFilters"
                                title="Filter by Status">
                            <option value="">All Status</option>
                            @foreach (var status in AvailableStatuses)
                            {
                                <option value="@status">@SnapshotStatuses.GetDisplayName(status)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="FromDate" @bind:after="ApplyFilters" title="From Date" />
                    </div>
                    <div class="ms-2">
                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="ToDate" @bind:after="ApplyFilters" title="To Date" />
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <table class="table align-middle w-100">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th style="width:12%;">As Of Date</th>
                                @* <th class="d-none d-xl-table-cell" style="width: 84px;">Basis</th> *@
                                <th class="d-none d-md-table-cell">Company</th>
                                <th class="d-none d-xl-table-cell text-center" style="width:8%;">Customers</th>
                                <th class="d-none d-lg-table-cell text-end" style="width:12%;">Outstanding</th>
                                <th class="d-none d-md-table-cell" style="width:10%;">Status</th>
                                <th class="d-none d-xl-table-cell text-nowrap" style="width:14%;">Generated On</th>
                                <th style="width:9%;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedSnapshots.Any())
                            {
                                @foreach (var snapshot in PagedSnapshots)
                                {
                                    <tr>
                                        <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                               data-bs-toggle="modal" data-bs-target="#rowDetailsModal"
                                               @onclick="() => OpenRowDetails(snapshot)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>
                                        <td class="fw-medium text-nowrap">
                                         <span>
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a href="/customer-aging/@snapshot.CustomerAgingId"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top" class="text-decoration-none link-View"
                                                   title="Click to view aging details for @snapshot.AsOfDate.ToString("dd-MMM-yyyy")">
                                                    @snapshot.AsOfDate.ToString("dd-MMM-yyyy")
                                                </a>
                                         </span>
                                        </td>
                                        @* <td class="d-none d-xl-table-cell" style="text-overflow: inherit;">
                                            <span class="badge @GetBasisBadgeClass(snapshot.AgingBasis)"
                                                  data-bs-toggle="tooltip"
                                                  data-bs-placement="top"
                                                  title="@AgingBasisTypes.GetDisplayName(snapshot.AgingBasis)">

                                                <i class="@GetBasisIcon(snapshot.AgingBasis) me-1"></i>
                                            </span>
                                        </td> *@

                                        <td class="d-none d-md-table-cell">
                                            <div class="fw-medium">@snapshot.CompanyName</div>
                                            <small class="text-muted">@(snapshot.BranchName ?? "All Branches")</small>
                                        </td>
                                        <td class="d-none d-xl-table-cell text-center">@snapshot.RecordCountCustomers</td>
                                        <td class="d-none d-lg-table-cell text-end fw-medium text-nowrap" >
                                            @* @snapshot.TotalOutstandingAmount.ToString("N0") *@
                                            @IndianNumberFormatter.Format(@snapshot.TotalOutstandingAmount)

                                        </td>
                                     

                                        <td class="d-none d-md-table-cell text-nowrap">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="ActiveDot @GetStatusDotBadgeClass(snapshot.SnapshotStatus)">
                                                </div>
                                                <span>@snapshot.SnapshotStatus</span>
                                            </div>
                                        </td>


                                        <td class="d-none d-xl-table-cell text-nowrap">
                                            <span style="color:black;font-weight:500;">@snapshot.GeneratedOn.ToString("dd-MMM-yy")</span>
                                            <span class="text-muted ms-1">@snapshot.GeneratedOn.ToString("HH:mm")</span>
                                        </td>
                                        <td class="action-table-data pe-3">
                                            <div class="edit-delete-action d-flex justify-content-start gap-2">
                                                <a class="p-1 view-icon" href="/customer-aging/@snapshot.CustomerAgingId" title="View Details">
                                                    <i data-feather="eye"></i>
                                                </a>
                                                @if (snapshot.CanRegenerate)
                                                {
                                                    <a class="p-1 action-icon Reissue" href="javascript:void(0);"
                                                       title="Retry Generation" data-bs-toggle="modal" data-bs-target="#retryModal"
                                                       @onclick="() => OpenRetryModal(snapshot)">
                                                        <i class="ti ti-refresh"></i>
                                                    </a>
                                                }
                                                @if (snapshot.SnapshotStatus == SnapshotStatuses.Failed)
                                                {
                                                    <a class="p-1 action-icon delete-icon" href="javascript:void(0);"
                                                       title="Delete Failed Snapshot" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                       @onclick="() => OpenDeleteModal(snapshot)">
                                                        <i class="ti ti-trash"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@VisibleColumnCount" class="text-center py-4">
                                        <i class="ti ti-camera-off fs-1 text-muted d-block mb-2"></i>
                                        No aging snapshots found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (TotalPages > 0)
            {
                <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                    <div class="d-flex align-items-center">
                        <span class="me-2">Rows per page</span>
                        <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                            <option value="5" selected="@(PageSize == 5)">5</option>
                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="25" selected="@(PageSize == 25)">25</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                        <span class="ms-3 text-muted">
                            Entries
                        </span>
                    </div>
                    @* <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">
                            Showing @(((CurrentPage - 1) * PageSize) + 1) to @Math.Min(CurrentPage * PageSize, FilteredSnapshots.Count) of @FilteredSnapshots.Count entries
                        </span>
                    </div> *@
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage"><i class="ti ti-chevron-left"></i></a>
                            </li>
                            @for (int i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(pageNum == CurrentPage ? "active" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0);" @onclick="NextPage"><i class="ti ti-chevron-right"></i></a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>

    <!-- Generate Snapshot Modal -->
    <div class="modal fade list-Popup" id="generateModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="ti ti-player-play me-2"></i>Generate Aging Snapshot</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" style="    padding: 0;
            right: 22px;
            position: absolute;
            transform: none;"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">As Of Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" @bind="generateAsOfDate"
                               title="Select the date for which to generate the aging snapshot" />
                        <small class="text-muted">Snapshot will be computed based on outstanding as of this date</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Aging Basis <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="generateAgingBasis"
                                title="Select how to calculate aging - by Due Date or Invoice Date">
                            <option value="">--Select Aging Basis--</option>
                            @foreach (var basis in AgingBasisTypes.All)
                            {
                                <option value="@basis">@AgingBasisTypes.GetDisplayName(basis)</option>
                            }
                        </select>
                        <small class="text-muted">Due Date basis is recommended for collections</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Branch <span class="text-muted fw-normal">(Optional)</span></label>
                        <select class="form-select" @bind="generateBranchId"
                                title="Optionally filter aging to a specific branch">
                            <option value="">--Select Branch--</option>
                            @foreach (var branch in GenerateBranches)
                            {
                                <option value="@branch.Id">@branch.BranchCode - @branch.BranchName</option>
                            }
                        </select>
                        <small class="text-muted">Leave empty to generate for all branches</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Currency <span class="text-muted fw-normal">(Optional)</span></label>
                        <select class="form-select" @bind="generateCurrencyId"
                                title="Optionally filter aging to a specific currency">
                            <option value="">All Currencies (Base)</option>
                            @foreach (var currency in GenerateCurrencies)
                            {
                                <option value="@currency.Id">@currency.CurrencyCode - @currency.CurrencyName</option>
                            }
                        </select>
                        <small class="text-muted">Leave empty for base currency snapshot</small>
                    </div>
                    <div class="alert alert-info small">
                        <i class="ti ti-info-circle me-2"></i>
                        Snapshot generation will analyze all posted invoices with outstanding balance and categorize them into aging buckets.
                    </div>
                </div>
                <div class="modal-footer gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="ti ti-x"></i>Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="GenerateSnapshot" data-bs-dismiss="modal">
                        <i class="ti ti-player-play me-1"></i>Generate
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Retry Modal -->
    <div class="modal fade" id="retryModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                            <i class="ti ti-refresh fs-24 text-warning"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Retry Snapshot Generation</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Retry failed snapshot for <strong>@SelectedSnapshot?.AsOfDate.ToString("dd-MMM-yyyy")</strong>?
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x"></i>Close</button>
                            <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="RetrySnapshot" data-bs-dismiss="modal">
                                <i class="ti ti-refresh me-1"></i>Yes, Retry
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Failed Snapshot</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to proceed with deleting the failed snapshot for <strong>@SelectedSnapshot?.AsOfDate.ToString("dd-MMM-yyyy")</strong>?
                        </p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This action cannot be undone.
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x"></i>Cancel</button>
                            <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteSnapshot" data-bs-dismiss="modal">
                                <i class="ti ti-trash me-1"></i>Yes, Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row Details Modal (Mobile) -->
    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Aging Snapshot Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" style="padding:0; right:22px; position:absolute;transform:none"></button>
                </div>
                <div class="modal-body">
                    @if (SelectedSnapshot != null)
                    {
                        <div class="mb-2 d-flex gap-3">
                            <strong>As Of Date:</strong>
                            <div>@SelectedSnapshot.AsOfDate.ToString("dd-MMM-yyyy")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Aging Basis:</strong>
                            <div><span class="badge @GetBasisBadgeClass(SelectedSnapshot.AgingBasis)">@AgingBasisTypes.GetDisplayName(SelectedSnapshot.AgingBasis)</span></div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Company:</strong>
                            <div>@SelectedSnapshot.CompanyName</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Branch:</strong>
                            <div>@(SelectedSnapshot.BranchName ?? "All Branches")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Customers:</strong>
                            <div>@SelectedSnapshot.RecordCountCustomers</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Outstanding:</strong>
                            <div class="fw-medium">@(SelectedSnapshot.CurrencyCode ?? "₹") @SelectedSnapshot.TotalOutstandingAmount.ToString("N2")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Status:</strong>
                            <div><span class="badge @GetStatusBadgeClass(SelectedSnapshot.SnapshotStatus)">@SnapshotStatuses.GetDisplayName(SelectedSnapshot.SnapshotStatus)</span></div>
                        </div>
                    }
                </div>
                @* <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <a href="/customer-aging/@SelectedSnapshot?.CustomerAgingId" class="btn btn-info btn-sm">
                        <i class="ti ti-eye me-1"></i>View
                    </a>
                </div> *@
            </div>
        </div>
    </div>
}
