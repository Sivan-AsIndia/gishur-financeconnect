@page "/customer-debit-notes"

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Customer Debit Note List</h4>
                    <h6>Manage AR debit notes for additional charges and corrections</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/customer-debit-notes/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="row mb-0">
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #fe9f43, #db6c00);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Total</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.TotalDebitNotes</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-white rounded-circle p-2" style="background: #ffffff47;width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;">
                                <i class="ti ti-file-invoice" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #092c4c, #00396e);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Draft</h6>
                                <h5 class="mb-0 fw-bold text-secondary text-white">@Statistics.DraftDebitNotes</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-secondary rounded-circle p-2" style="background: #ffffff47;width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;">
                                <i class="ti ti-file-text text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #155eef, #002e8b);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Submitted</h6>
                                <h5 class="mb-0 fw-bold text-info text-white">@Statistics.SubmittedDebitNotes</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-info rounded-circle p-2" style="background: #ffffff47;width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;">
                                <i class="ti ti-send text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #3eb780, #008146);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Posted</h6>
                                <h5 class="mb-0 fw-bold text-white">@Statistics.PostedDebitNotes</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-success rounded-circle p-2" style="background: #ffffff47;width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;">
                                <i class="ti ti-circle-check text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #ffd854, #d0a000);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Cancelled</h6>
                                <h5 class="mb-0 fw-bold text-danger text-white">@Statistics.CancelledDebitNotes</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-danger rounded-circle p-2" style="background: #ffffff47;width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;">
                                <i class="ti ti-ban text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-0" style="display: flex;align-items: center;">
                <div class="card stat-card border-0 shadow-sm w-100" style="background: linear-gradient(135deg, #de4bbd, #990077);">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1 small text-white">Total Amount</h6>
                                <h5 class="mb-0 fw-bold text-warning text-white" style="font-size: 14px;">@Statistics.TotalDebitNoteAmount.ToString("N0")</h5>
                            </div>
                            <div class="stat-icon bg-opacity-10 text-warning rounded-circle p-2" style="background: #ffffff47;width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;">
                                <i class="ti ti-currency-rupee text-white" style="font-size: 20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>






        <!-- Debit Note List -->
        <div class="card">
            <div class="card-header d-flex align-items-end justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search by debit note no, customer, reference..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: end;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 160px" @bind="selectedReasonCode" @bind:after="ApplyFilters">
                            <option value="">All Reasons</option>
                            @foreach (var reason in DistinctReasons)
                            {
                                <option value="@reason">@DebitReasonCodes.GetDisplayName(reason)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="selectedStatus" @bind:after="ApplyFilters">
                            <option value="">All Status</option>
                            @foreach (var status in DistinctStatuses)
                            {
                                <option value="@status">@DebitNoteStatuses.GetDisplayName(status)</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2 filter-date">
                        <label class="form-label">From</label>
                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="FromDate" @bind:after="ApplyFilters" title="From Date" />
                    </div>
                    <div class="ms-2 filter-date">
                        <label class="form-label">To</label>
                        <input type="date" class="form-control form-control-sm" style="min-width: 130px"
                               @bind="ToDate" @bind:after="ApplyFilters" title="To Date" />
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <div>
                        <table class="table align-middle w-100 table-fixed">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xxl-none" style="width:40px"></th>
                                    <th style="width:130px; white-space:nowrap;" title="Debit Note No">Debit Note No</th>
                                    <th class="d-none d-xl-table-cell" style="width: 72px;">Reason</th>
                                    <th class="d-none d-md-table-cell" style="width: 170px;">Customer</th>
                                    <th class="d-none d-xl-table-cell" style="width:110px">Ref Invoice</th>
                                    <th class="d-none d-xxl-table-cell" style="width:100px">Date</th>
                                    <th class="d-none d-xxl-table-cell text-end" style="width:100px">Amount</th>
                                    <th class="d-none d-md-table-cell" style="width:90px">Status</th>
                                    <th style="width:145px">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedDebitNotes.Any())
                                {
                                    @foreach (var dn in PagedDebitNotes)
                                    {
                                        <tr>
                                            <!-- PLUS ICON -->
                                            <td class="d-xxl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#rowDetailsModal"
                                                   @onclick="() => OpenRowDetails(dn)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td class="fw-medium" style="white-space:nowrap;">
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a href="/customer-debit-notes/@dn.Id/view" class="text-decoration-none link-View"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title="@dn.DebitNoteNumber details">
                                                    @dn.DebitNoteNumber
                                                </a>
                                            </td>

                                            <td class="d-none d-xl-table-cell">
                                                <span class="badge @GetReasonBadgeClass(dn.DebitReasonCode)"
                                                      data-bs-toggle="tooltip"
                                                      data-bs-placement="top"
                                                      title="@DebitReasonCodes.GetDisplayName(dn.DebitReasonCode)">

                                                    <i class="@GetDebitReasonIcon(dn.DebitReasonCode)"></i>

                                                </span>
                                            </td>


                                            @* <td class="d-none d-xl-table-cell">
                                                <span class="badge @GetReasonBadgeClass(dn.DebitReasonCode)">@DebitReasonCodes.GetDisplayName(dn.DebitReasonCode)</span>
                                            </td> *@

                                            <td class="d-none d-md-table-cell" style="white-space:nowrap;">
                                                <div class="fw-medium" style="white-space:nowrap;">@dn.CustomerCode</div>
                                                <small class="text-muted" style="white-space:nowrap;">@dn.CustomerName</small>
                                            </td>

                                            <td class="d-none d-xl-table-cell">
                                                @if (dn.IsAgainstInvoice && !string.IsNullOrEmpty(dn.InvoiceNumberSnapshot))
                                                {
                                                    <span class="text-primary">@dn.InvoiceNumberSnapshot</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>

                                            <td class="d-none d-xxl-table-cell">
                                                @dn.DebitNoteDate.ToString("dd-MMM-yy")
                                            </td>

                                            <td class="d-none d-xxl-table-cell fw-medium text-end" title="@dn.CurrencyCode @dn.GrandTotalAmount.ToString("N2")">
                                                @* @dn.GrandTotalAmount.ToString("N2") *@
                                                @IndianNumberFormatter.Format(@dn.GrandTotalAmount)
                                            </td>


                                            <td class="d-none d-xl-table-cell">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="ActiveDot @GetStatusDotBadgeClass(dn.DebitNoteStatus)">
                                                    </div>
                                                    <span>@DebitNoteStatuses.GetDisplayName(dn.DebitNoteStatus)</span>
                                                </div>
                                            </td>

                                            <td class="action-table-data">
                                                <div class="edit-delete-action">
                                                    @if (dn.CanEdit)
                                                    {
                                                        <a class="me-2 edit-icon p-1" href="/customer-debit-notes/@dn.Id" title="Edit">
                                                            <i data-feather="edit"></i>
                                                        </a>
                                                    }
                                                    @if (dn.DebitNoteStatus == DebitNoteStatuses.Draft)
                                                    {
                                                        <a class="me-2 p-1 action-icon Issue" href="javascript:void(0);"
                                                           title="Submit for Approval" data-bs-toggle="modal" data-bs-target="#submitModal"
                                                           @onclick="() => OpenSubmitModal(dn)">
                                                            <i class="ti ti-send"></i>
                                                        </a>
                                                    }
                                                    @if (dn.CanPost)
                                                    {
                                                        <a class="me-2 p-1 action-icon Clear" href="javascript:void(0);"
                                                           title="Post Debit Note" data-bs-toggle="modal" data-bs-target="#postModal"
                                                           @onclick="() => OpenPostModal(dn)">
                                                            <i class="ti ti-check"></i>
                                                        </a>
                                                    }
                                                    @if (dn.CanCancel)
                                                    {
                                                        <a class="me-2 p-1 action-icon Bounce" href="javascript:void(0);"
                                                           title="Cancel Debit Note" data-bs-toggle="modal" data-bs-target="#cancelModal"
                                                           @onclick="() => OpenCancelModal(dn)">
                                                            <i class="ti ti-ban"></i>
                                                        </a>
                                                    }
                                                    @if (dn.DebitNoteStatus == DebitNoteStatuses.Draft)
                                                    {
                                                        <a class="p-1 delete-icon" href="javascript:void(0);" title="Delete"
                                                           data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                           @onclick="() => OpenDeleteModal(dn)">
                                                            <i data-feather="trash-2"></i>
                                                        </a>
                                                    }
                                                    @if (dn.CanReverse)
                                                    {
                                                        <a class="p-1 action-icon delete-icon" href="javascript:void(0);"
                                                           title="Reverse Debit Note" data-bs-toggle="modal" data-bs-target="#reverseModal"
                                                           @onclick="() => OpenReverseModal(dn)">
                                                            <i class="ti ti-arrow-back-up"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@VisibleColumnCount" class="text-center py-4 text-muted">
                                            <i class="ti ti-database-off fs-1 d-block mb-2"></i>
                                            No debit notes found. Click "Create Debit Note" to add one.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                        <div class="d-flex align-items-center">
                            <span class="me-2">Rows per page</span>
                            <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                                <option value="5" selected="@(PageSize == 5)">5</option>
                                <option value="10" selected="@(PageSize == 10)">10</option>
                                <option value="25" selected="@(PageSize == 25)">25</option>
                                <option value="50" selected="@(PageSize == 50)">50</option>
                            </select>
                            <span class="ms-3 text-muted">
                                Entries
                            </span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = 1; i <= TotalPages; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages || TotalPages == 0 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Submit Modal -->
    <div class="modal fade" id="submitModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-info-transparent mb-2">
                            <i class="ti ti-send fs-24 text-info"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Submit Debit Note</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to submit <strong>@SelectedDebitNote?.DebitNoteNumber</strong> for approval?
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-info fs-13 fw-medium p-2 px-4" @onclick="SubmitDebitNote" data-bs-dismiss="modal"><i class="ti ti-send me-1"></i>Yes, Submit</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Post Debit Note Modal -->
    <div class="modal fade" id="postModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                            <i class="ti ti-check fs-24 text-success"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Post Debit Note</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to post <strong>@SelectedDebitNote?.DebitNoteNumber</strong>?
                        </p>
                        <div class="alert alert-warning mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            Once posted, the debit note cannot be edited. Any corrections must be made via reversal.
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="PostDebitNote" data-bs-dismiss="modal">
                                <i class="ti ti-check me-1"></i>Yes, Post
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cancel Debit Note Modal -->
    <div class="modal fade" id="cancelModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                            <i class="ti ti-ban fs-24 text-warning"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Cancel Debit Note</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to cancel debit note <strong>@SelectedDebitNote?.DebitNoteNumber</strong>?
                        </p>
                        <div class="mt-3 text-start">
                            <label class="form-label">Cancellation Reason <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="3" @bind="cancelReasonInput" placeholder="Enter reason for cancelling this debit note..."></textarea>
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Close</button>
                            <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="CancelDebitNote" data-bs-dismiss="modal">
                                <i class="ti ti-ban me-1"></i>Yes, Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reverse Debit Note Modal -->
    <div class="modal fade" id="reverseModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-arrow-back-up fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Reverse Debit Note</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to reverse posted debit note <strong>@SelectedDebitNote?.DebitNoteNumber</strong>?
                        </p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This will create a reversal entry in the GL. The debit note effect will be nullified.
                        </div>
                        <div class="mt-3 text-start">
                            <label class="form-label">Reversal Reason <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="3" @bind="reverseReasonInput" placeholder="Enter reason for reversing this debit note..."></textarea>
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Close</button>
                            <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="ReverseDebitNote" data-bs-dismiss="modal">
                                <i class="ti ti-arrow-back-up me-1"></i>Yes, Reverse
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Debit Note Modal -->
    <div class="modal fade" id="deleteModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Debit Note</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Do you want to delete <strong>@SelectedDebitNote?.DebitNoteNumber</strong>?
                        </p>
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This action cannot be undone.
                        </div>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteDebitNote" data-bs-dismiss="modal">
                                <i class="ti ti-trash me-1"></i>Yes, Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row Details Modal (Mobile) -->
    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Debit Note Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            style="padding:0; right:22px; position:absolute;transform:none"></button>
                </div>
                <div class="modal-body">
                    @if (SelectedDebitNote != null)
                    {
                        <div class="mb-2 d-flex gap-3">
                            <strong>Debit Note No:</strong>
                            <div>@SelectedDebitNote.DebitNoteNumber</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Customer:</strong>
                            <div>@SelectedDebitNote.CustomerCode - @SelectedDebitNote.CustomerName</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Reason:</strong>
                            <div><span class="badge @GetReasonBadgeClass(SelectedDebitNote.DebitReasonCode)">@DebitReasonCodes.GetDisplayName(SelectedDebitNote.DebitReasonCode)</span></div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Date:</strong>
                            <div>@SelectedDebitNote.DebitNoteDate.ToString("dd-MMM-yyyy")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Ref Invoice:</strong>
                            <div>@(SelectedDebitNote.IsAgainstInvoice? SelectedDebitNote.InvoiceNumberSnapshot: "-")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Amount:</strong>
                            <div class="fw-medium">@SelectedDebitNote.CurrencyCode @SelectedDebitNote.GrandTotalAmount.ToString("N2")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Status:</strong>
                            <div><span class="badge @GetStatusBadgeClass(SelectedDebitNote.DebitNoteStatus)">@DebitNoteStatuses.GetDisplayName(SelectedDebitNote.DebitNoteStatus)</span></div>
                        </div>
                    }
                </div>
                @* <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <a href="/customer-debit-note/@SelectedDebitNote?.Id" class="btn btn-info btn-sm">
                        <i class="ti ti-eye me-1"></i>View
                    </a>
                    @if (SelectedDebitNote?.CanEdit == true)
                    {
                        <a href="/create-customer-debit-note/@SelectedDebitNote?.Id" class="btn btn-primary btn-sm">
                            <i class="ti ti-pencil me-1"></i>Edit
                        </a>
                    }
                </div> *@
            </div>
        </div>
    </div>
}
