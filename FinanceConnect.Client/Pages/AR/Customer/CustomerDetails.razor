@page "/customers/{Id:guid}/view"
@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services

<PageTitle>Customer Details - FinanceConnect</PageTitle>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else if (Customer == null)
{
    <div class="container view-screen py-4">
        <div class="alert alert-warning">
            <i class="ti ti-alert-triangle me-2"></i>
            Customer not found.
        </div>
        <a href="/customers" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i> Back to List
        </a>
    </div>
}
else
{
    <div class="content">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-1">Customer Details</h4>
                <p class="text-muted mb-0 small">View customer profile and account information</p>
            </div>
            <a href="/customers" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Back
            </a>
        </div>

        <div class="card">
            <!-- TOP HEADER CARD (Company Details Style) -->
            <div class="header-card">
                <div class="header-inner">
                    <div class="header-left1">
                        <div class="company-logo">
                            <span class="logo-initials">@Customer.CustomerName?.Substring(0, 2).ToUpper()</span>
                        </div>

                        <div class="header-meta">
                            <h2 class="company-title">@Customer.CustomerName</h2>
                            <div class="company-subtitle">
                                @if (!string.IsNullOrWhiteSpace(Customer.CustomerDisplayName))
                                {
                                    <span>@Customer.CustomerDisplayName</span>
                                    <span class="dot">·</span>
                                }
                                <span>@Customer.CustomerCode</span>
                                @if (!string.IsNullOrWhiteSpace(Customer.CompanyName))
                                {
                                    <span class="dot">·</span>
                                    <span>@Customer.CompanyName</span>
                                }
                            </div>
                            <div class="header-tags">
                                @if (!string.IsNullOrWhiteSpace(Customer.CustomerType))
                                {
                                    <span class="tag tag-default" style="border: 1px solid #c6b500; background: #f7ffdf; color: #b4ac00;">@Customer.CustomerType</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(Customer.DefaultCurrencyName))
                                {
                                    <span class="tag tag-default" style="border: 1px solid #0081ff; background: #e9f3ff; color: #1420ff;">@Customer.DefaultCurrencyName (@(Customer.DefaultCurrencyCode ?? ""))</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="header-right">
                        @if (Customer.CustomerStatus == CustomerStatuses.Active)
                        {
                            <span class="status-badge status-active">● ACTIVE</span>
                        }
                        else if (Customer.CustomerStatus == CustomerStatuses.Draft)
                        {
                            <span class="status-badge status-draft">● DRAFT</span>
                        }
                        else if (Customer.CustomerStatus == CustomerStatuses.Blacklisted)
                        {
                            <span class="status-badge status-inactive">● BLACKLISTED</span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive">● INACTIVE</span>
                        }
                        <div class="created-info">Created @Customer.CreatedAt.ToString("dd MMM yyyy")</div>
                    </div>
                </div>
            </div>

            <!-- SCROLLABLE BODY -->
            <div class="details-body">
                <div class="row g-4 py-3">

                    <!-- LEFT PANEL : CUSTOMER DETAILS -->
                    <div class="col-lg-8">
                        <div class="profile-card">

                            <!-- Core Customer Fields -->
                            <div class="card mb-3">
                                <div class="card-header py-2">
                                    <i class="ti ti-id me-2"></i> Core Information
                                </div>
                                <div class="card-body py-2">
                                    <div class="row">
                                        <div class="col-md-3 mb-2">
                                            <small class="text-muted">Customer Code</small>
                                            <div class="fw-medium">@Customer.CustomerCode</div>
                                        </div>
                                        <div class="col-md-5 mb-2">
                                            <small class="text-muted">Customer Name</small>
                                            <div class="fw-medium">@Customer.CustomerName</div>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Display Name</small>
                                            <div>@(Customer.CustomerDisplayName ?? "-")</div>
                                        </div>
                                        <div class="col-md-4 mb-2 company-info" style="display: flex; align-items: baseline; gap: 4px; flex-direction: column;">
                                            <small class="text-muted">Type</small>
                                            <span class="badge @GetTypeBadgeClass(Customer.CustomerType)" data-bs-toggle="tooltip" title="@Customer.CustomerType">
                                                @Customer.CustomerType
                                            </span>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Company</small>
                                            <div>@(Customer.CompanyName ?? "-")</div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(Customer.Website))
                                        {
                                            <div class="col-md-4 mb-2">
                                                <small class="text-muted">Website</small>
                                                <div>@Customer.Website</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Contact Information -->
                            <div class="card mb-3">
                                <div class="card-header py-2">
                                    <i class="ti ti-address-book me-2"></i> Contact Information
                                </div>
                                <div class="card-body py-2">
                                    <div class="row">
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Primary Phone</small>
                                            <div>@(Customer.PrimaryPhone ?? "-")</div>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Secondary Phone</small>
                                            <div>@(Customer.SecondaryPhone ?? "-")</div>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Primary Email</small>
                                            <div>@(Customer.PrimaryEmail ?? "-")</div>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Billing Email</small>
                                            <div>@(Customer.BillingEmail ?? "-")</div>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Contact Person</small>
                                            <div>@(Customer.ContactPersonName ?? "-")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Credit & Terms -->
                            <div class="card mb-3">
                                <div class="card-header py-2">
                                    <i class="ti ti-credit-card me-2"></i> Credit & Payment Terms
                                </div>
                                <div class="card-body py-2">
                                    <div class="row">
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Credit Limit</small>
                                            <div class="fw-medium">@Customer.CreditLimitAmount.ToString("N2")</div>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Credit Enforced</small>
                                            <div>
                                                <span class="badge @(Customer.CreditLimitEnforced ? "bg-success-transparent " : "bg-secondary-transparent text-secondary")">
                                                    @(Customer.CreditLimitEnforced ? "Yes" : "No")
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Payment Terms</small>
                                            <div>@(Customer.PaymentTermName ?? "-")</div>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Currency</small>
                                            <div>@(Customer.DefaultCurrencyName ?? "-") (@(Customer.DefaultCurrencyCode ?? "-"))</div>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Payment Method</small>
                                            <div>@PaymentMethods.GetDisplayName(Customer.DefaultPaymentMethod)</div>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Hold Status</small>
                                            <div>
                                                <span class="badge @GetHoldStatusBadgeClass(Customer.CreditHoldStatus)">
                                                    @Customer.CreditHoldStatus
                                                </span>
                                            </div>
                                        </div>
                                        @if (Customer.CreditHoldStatus != CreditHoldStatuses.None && !string.IsNullOrWhiteSpace(Customer.CreditHoldReason))
                                        {
                                            <div class="col-md-12 mb-2">
                                                <small class="text-muted">Hold Reason</small>
                                                <div class="text-danger">@((MarkupString)(Customer.CreditHoldReason ?? ""))</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Accounting Defaults -->
                            <div class="card mb-3">
                                <div class="card-header py-2">
                                    <i class="ti ti-calculator me-2"></i> Accounting Defaults
                                </div>
                                <div class="card-body py-2">
                                    <div class="row">
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Receivable Account</small>
                                            <div class="fw-medium">@(Customer.ReceivableAccountName ?? "-")</div>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Advance Account</small>
                                            <div>@(Customer.AdvanceFromCustomerAccountName ?? "-")</div>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            <small class="text-muted">Write-Off Account</small>
                                            <div>@(Customer.WriteOffAccountName ?? "-")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Account Summary -->
                            @if (AccountSummary != null)
                            {
                                <div class="card mb-3">
                                    <div class="card-header py-2">
                                        <i class="ti ti-chart-bar me-2"></i> Account Summary
                                    </div>
                                    <div class="card-body py-2">
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="text-secondary">Outstanding Balance</span>
                                                <span class="fw-bold text-primary">@AccountSummary.TotalOutstandingReceivable.ToString("N2")</span>
                                            </div>
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="text-secondary">Unapplied Payments</span>
                                                <span class="text-success">@AccountSummary.TotalUnappliedPayments.ToString("N2")</span>
                                            </div>
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="text-secondary">Credit Exposure</span>
                                                <span class="@(AccountSummary.TotalCreditExposure > Customer.CreditLimitAmount ? "text-danger fw-bold" : "")">
                                                    @AccountSummary.TotalCreditExposure.ToString("N2")
                                                </span>
                                            </div>
                                        </div>
                                        <div class="small text-muted">
                                            <i class="ti ti-info-circle me-1"></i>
                                            @AccountSummary.AccountCount account(s) found
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Workflow History (renamed from Audit Information) -->
                            <div class="card mb-0">
                                <div class="card-header py-2">
                                    <i class="ti ti-history me-2"></i> Workflow History
                                </div>
                                <div class="card-body py-2 small">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-secondary">Created</span>
                                        <span>@Customer.CreatedAt.ToString("dd MMM yyyy HH:mm")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-secondary">Created By</span>
                                        <span>@(Customer.CreatedBy ?? "-")</span>
                                    </div>
                                    @if (Customer.UpdatedAt.HasValue)
                                    {
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-secondary">Updated</span>
                                            <span>@Customer.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm")</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="text-secondary">Updated By</span>
                                            <span>@(Customer.UpdatedBy ?? "-")</span>
                                        </div>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- RIGHT PANEL -->
                    <div class="col-lg-4">
                        <div class="profile-card">
                            <!-- Tax & Compliance -->
                            <div class="card mb-3">
                                <div class="card-header py-2">
                                    <i class="ti ti-file-certificate me-2"></i> Tax & Compliance
                                </div>
                                <div class="card-body py-2">
                                    <div class="row">
                                        <div class="col-md-12 mb-2">
                                            <small class="text-muted">Tax Registration Type</small>
                                            <div class="fw-medium">@(Customer.TaxRegistrationType ?? "-")</div>
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <small class="text-muted">Tax Profile</small>
                                            <div class="fw-medium">@(Customer.TaxProfileName ?? "-")</div>
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <small class="text-muted">PAN</small>
                                            <div class="fw-medium">@(Customer.PAN ?? "-")</div>
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <small class="text-muted">GSTIN</small>
                                            <div class="fw-medium">@(Customer.GSTIN ?? "-")</div>
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <small class="text-muted">TAN</small>
                                            <div>@(Customer.TAN ?? "-")</div>
                                        </div>
                                        <hr class="my-2" />
                                        <div class="col-md-12 mb-2">
                                            <small class="text-muted">TDS Applicable</small>
                                            <div>
                                                <span class="badge @(Customer.IsTDSApplicable ? "bg-success-transparent" : "bg-secondary-transparent text-secondary")">
                                                    @(Customer.IsTDSApplicable ? "Yes" : "No")
                                                </span>
                                            </div>
                                        </div>
                                        @if (Customer.IsTDSApplicable && !string.IsNullOrWhiteSpace(Customer.TDSSectionCode))
                                        {
                                            <div class="col-md-12 mb-2">
                                                <small class="text-muted">TDS Section Code</small>
                                                <div>@Customer.TDSSectionCode</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Preferences -->
                            <div class="card mb-3">
                                <div class="card-header py-2">
                                    <i class="ti ti-settings me-2"></i> Preferences
                                </div>
                                <div class="card-body py-2">
                                    <div class="mb-2">
                                        <span class="badge @(Customer.SendInvoiceEmail ? "bg-success-transparent " : "bg-secondary-transparent text-secondary")">
                                            <i class="ti ti-mail me-1"></i>Email Invoices
                                        </span>
                                    </div>
                                    <div class="mb-2">
                                        <span class="badge @(Customer.AllowPartialPayment ? "bg-success-transparent" : "bg-secondary-transparent text-secondary")">
                                            <i class="ti ti-cash me-1"></i>Partial Payments
                                        </span>
                                    </div>
                                    <div class="mb-2">
                                        <span class="badge @(Customer.AllowOverPayment ? "bg-success-transparent" : "bg-secondary-transparent text-secondary")">
                                            <i class="ti ti-plus me-1"></i>Over Payments
                                        </span>
                                    </div>
                                    <div class="mb-2">
                                        <span class="badge @(Customer.AllowAutoAdvanceCreation ? "bg-success-transparent " : "bg-secondary-transparent text-secondary")">
                                            <i class="ti ti-bolt me-1"></i>Auto Advance
                                        </span>
                                    </div>
                                    <hr />
                                    <div class="small">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-secondary">Statement Cycle</span>
                                            <span>@(Customer.CustomerStatementCycle ?? "-")</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="text-secondary">Language</span>
                                            <span>@(Customer.PreferredLanguage ?? "EN")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Status & Controls -->
                            <div class="card mb-0">
                                <div class="card-header py-2">
                                    <i class="ti ti-shield-check me-2"></i> Status & Controls
                                </div>
                                <div class="card-body py-2">
                                    <div class="mb-2">
                                        <span class="badge @GetStatusBadgeClass(Customer.CustomerStatus)">
                                            @Customer.CustomerStatus
                                        </span>
                                    </div>
                                    @if (Customer.CreditHoldStatus != CreditHoldStatuses.None)
                                    {
                                        <div class="mb-2">
                                            <span class="badge @GetHoldStatusBadgeClass(Customer.CreditHoldStatus)">
                                                <i class="ti ti-lock me-1"></i>@Customer.CreditHoldStatus
                                            </span>
                                        </div>
                                    }
                                    <hr />
                                    <div class="mb-2">
                                        <span class="badge @(Customer.CreditLimitEnforced ? "bg-warning-transparent" : "bg-success-transparent")">
                                            <i class="ti ti-shield me-1"></i>Credit Limit @(Customer.CreditLimitEnforced ? "Enforced" : "Not Enforced")
                                        </span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}
