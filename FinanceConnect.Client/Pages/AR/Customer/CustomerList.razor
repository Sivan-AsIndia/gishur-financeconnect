@page "/customers"

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Customer List</h4>
                    <h6>Manage your AR customers</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/customers/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- Customer List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search by code, name, GS..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 150px" @bind="SelectedCustomerType">
                            <option value="">All Types</option>
                            @foreach (var type in AllCustomers.Select(c => c.CustomerType).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct().OrderBy(t => t))
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in AllCustomers.Select(c => c.CustomerStatus).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s))
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 150px" @bind="SelectedHoldStatus">
                            <option value="">All Hold Status</option>
                            @foreach (var holdStatus in AllCustomers.Select(c => c.CreditHoldStatus).Where(h => !string.IsNullOrWhiteSpace(h)).Distinct().OrderBy(h => h))
                            {
                                <option value="@holdStatus">@holdStatus</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <div class="table-responsive">
                        <table class="table align-middle w-100 mb-0" style="table-layout: fixed;">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xl-none" style="width:40px"></th>
                                    <th style="width:11%" title="Customer Code">Code</th>
                                    <th style="width:32%" title="Customer Name & Status" class="d-none d-md-table-cell">Customer</th>
                                    <th class="d-none d-xl-table-cell" style="width:11%" title="Customer Type">Type</th>
                                    <th class="d-none d-xl-table-cell" style="width:13%" title="Credit Hold Status">Hold</th>
                                    <th class="d-none d-xl-table-cell text-end" style="width:14%" title="Credit Limit Amount">Credit Limit</th>
                                    <th style="width:19%" title="Actions">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedCustomers.Any())
                                {
                                    @foreach (var c in PagedCustomers)
                                    {
                                        <tr>
                                            <!-- PLUS ICON -->
                                            <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#rowDetailsModal"
                                                   @onclick="() => OpenRowDetails(c)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td class="fw-medium">
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a href="/customers/@c.Id/view" class="text-decoration-none link-View"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title=" @c.CustomerCode details">
                                                    @c.CustomerCode
                                                </a>
                                            </td>

                                            <td  class="d-none d-md-table-cell">
                                                <div class="d-flex flex-column">
                                                <span style="word-break: break-word; white-space: normal;">@c.CustomerName</span>
                                                
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="ActiveDot @GetStatusDotBadgeClass(c.CustomerStatus)">
                                                        </div>
                                                        <span> @c.CustomerStatus</span>
                                                    </div>
                                                </div>
                                            </td>

                                            <td class="d-none d-xl-table-cell" title="Customer Type: @c.CustomerType">
                                                <span class="badge @GetTypeBadgeClass(c.CustomerType)">@c.CustomerType</span>
                                            </td>

                                            <td class="d-none d-xl-table-cell" >
                                                <span class="badge @GetHoldStatusBadgeClass(c.CreditHoldStatus)">
                                                    @c.CreditHoldStatus
                                                </span>
                                            </td>

                                            <td class="d-none d-xl-table-cell text-end">
                                                @* @(c.CreditLimitAmount.ToString("N2")) *@
                                                @IndianNumberFormatter.Format(@c.CreditLimitAmount)
                                            </td>

                                            <td class="action-table-data">
                                                <div class="edit-delete-action">
                                                    <a class="me-2 edit-icon p-1" href="/customers/@c.Id" title="Edit Customer">
                                                        <i data-feather="edit"></i>
                                                    </a>
                                                    @if (c.CustomerStatus == CustomerStatuses.Active)
                                                    {
                                                        <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon" href="javascript:void(0);"
                                                           title="Deactivate Customer" data-bs-toggle="modal" data-bs-target="#deactivate-modal"
                                                           @onclick="() => ConfirmDeactivate(c)">
                                                            <i class="ti ti-toggle-right"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a class="me-2 p-1 Toggle-icon action-icon activate-icon" href="javascript:void(0);"
                                                           title="Activate Customer" data-bs-toggle="modal" data-bs-target="#activate-modal"
                                                           @onclick="() => ConfirmActivate(c)">
                                                            <i class="ti ti-toggle-left"></i>
                                                        </a>
                                                    }
                                                    @if (c.CreditHoldStatus == CreditHoldStatuses.None)
                                                    {
                                                        <a class="me-2 p-1 action-icon hold-icon" href="javascript:void(0);"
                                                           title="Place Credit Hold" data-bs-toggle="modal" data-bs-target="#hold-modal"
                                                           @onclick="() => OpenHoldModal(c)">
                                                            <i class="ti ti-ban"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a class="me-2 p-1 action-icon release-hold-icon" href="javascript:void(0);"
                                                           title="Release Credit Hold" data-bs-toggle="modal" data-bs-target="#release-hold-modal"
                                                           @onclick="() => ConfirmReleaseHold(c)">
                                                            <i class="ti ti-check"></i>
                                                        </a>
                                                    }
                                                    <a class="p-1 delete-icon" href="javascript:void(0);" title="Delete Customer"
                                                       data-bs-toggle="modal" data-bs-target="#delete-modal"
                                                       @onclick="() => ConfirmDelete(c)">
                                                        <i data-feather="trash-2"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@VisibleColumnCount" class="text-center py-4 text-muted">
                                            <i class="ti ti-database-off fs-1 d-block mb-2"></i>
                                            No customers found. Click "Add Customer" to create one.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                        <div class="d-flex align-items-center">
                            <span class="me-2">Rows per page</span>
                            <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                                <option value="5" selected="@(PageSize == 5)">5</option>
                                <option value="10" selected="@(PageSize == 10)">10</option>
                                <option value="25" selected="@(PageSize == 25)">25</option>
                                <option value="50" selected="@(PageSize == 50)">50</option>
                            </select>
                            <span class="ms-3 text-muted">
                                Entries
                            </span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = 1; i <= TotalPages; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row Details Modal (Mobile) -->
        <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Customer Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                style="padding:0; right:22px; position:absolute;transform:none"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2 d-flex gap-3">
                            <strong>Customer Name:</strong>
                            <div>@SelectedCustomer?.CustomerName</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Type:</strong>
                            <div>@SelectedCustomer?.CustomerType</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>GSTIN:</strong>
                            <div>@(SelectedCustomer?.GSTIN ?? "-")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Phone:</strong>
                            <div>@(SelectedCustomer?.PrimaryPhone ?? "-")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Credit Limit:</strong>
                            <div>@(SelectedCustomer?.CreditLimitAmount.ToString("N2") ?? "-")</div>
                        </div>
                        <div class="mb-2 d-flex gap-3">
                            <strong>Hold Status:</strong>
                            <span class="badge @GetHoldStatusBadgeClass(SelectedCustomer?.CreditHoldStatus)">
                                @(SelectedCustomer?.CreditHoldStatus ?? "-")
                            </span>
                        </div>
                        <div class="mb-2 gap-3">
                            <strong>Status:</strong>
                            <span class="badge @GetStatusBadgeClass(SelectedCustomer?.CustomerStatus)">
                                @(SelectedCustomer?.CustomerStatus ?? "-")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activate Modal -->
        <div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-toggle-right fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Customer</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Do you want to activate <strong>@SelectedCustomer?.CustomerName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-check me-1"></i>Yes, Activate</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deactivate Modal -->
        <div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                                <i class="ti ti-toggle-left fs-24 text-warning"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate Customer</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDeactivate)
                                {
                                    <span class="text-danger">Cannot deactivate! Customer has active transactions.</span>
                                }
                                else
                                {
                                    <span>Do you want to deactivate <strong>@SelectedCustomer?.CustomerName</strong>?</span>
                                }
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDeactivate)
                                {
                                    <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-check me-1"></i>Yes, Deactivate</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hold Modal -->
        <div class="modal fade" id="hold-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                <i class="ti ti-ban fs-24 text-danger"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Place Credit Hold</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Do you want to place credit hold on <strong>@SelectedCustomer?.CustomerName</strong>?
                            </p>
                            <div class="mt-3 text-start">
                                <label class="form-label">Hold Status <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="holdStatusInput">
                                    <option value="OnHold">On Hold</option>
                                    <option value="TemporaryHold">Temporary Hold</option>
                                </select>
                            </div>
                            <div class="mt-3 text-start">
                                <label class="form-label">Reason <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="3" @bind="holdReasonInput" placeholder="Enter reason for placing credit hold..."></textarea>
                            </div>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="PlaceHoldConfirmed" data-bs-dismiss="modal"><i class="ti ti-check me-1"></i>Yes, Place Hold</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Release Hold Modal -->
        <div class="modal fade" id="release-hold-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-check fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Release Credit Hold</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Do you want to release the credit hold for <strong>@SelectedCustomer?.CustomerName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ReleaseHoldConfirmed" data-bs-dismiss="modal"><i class="ti ti-check me-1"></i>Yes, Release Hold</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                                <i class="ti ti-trash fs-24 text-danger"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Customer</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                @if (!canDelete)
                                {
                                    <span class="text-danger">Cannot delete! Customer has active transactions.</span>
                                }
                                else
                                {
                                    <span>Do you want to delete <strong>@SelectedCustomer?.CustomerName</strong>?</span>
                                }
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                @if (canDelete)
                                {
                                    <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="DeleteConfirmed" data-bs-dismiss="modal"><i class="ti ti-check me-1"></i>Yes, Delete</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

}
