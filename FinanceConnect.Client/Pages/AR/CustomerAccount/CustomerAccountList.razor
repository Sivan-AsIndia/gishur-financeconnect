@page "/customer-accounts"

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }

    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Customer Account List</h4>
                    <h6>View AR customer account balances and status</h6>
                </div>
            </div>

            <ul class="table-top-head me-2">
                <li>
                    <a href="javascript:void(0);" title="Refresh Data" @onclick="OnRefreshAsync" style="cursor: pointer;">
                        <i class="ti ti-refresh @(isRefreshing ? "spin-animation" : "")"></i>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Summary Cards with Visible Icons -->
        <div class="row mb-4">
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card summary-card" style=" background: linear-gradient(135deg, #2563EB, #1E40AF) !important;">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="mb-1" style="color: rgba(255,255,255,0.85); font-size: 13px;">Total Outstanding</h6>
                                <h4 class="mb-0" style="color: #ffffff; font-weight: 600;">@SummaryStats.TotalOutstanding.ToString("N2")</h4>
                            </div>
                            <div class="card-icon-box" style="background: rgba(255,255,255,0.25); width: 50px; height: 50px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                <i class="ti ti-currency-rupee" style="color: #ffffff; font-size: 24px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card summary-card" style="background: linear-gradient(135deg, #16A34A, #065F46) !important;">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="mb-1" style="color: rgba(255,255,255,0.85); font-size: 13px;">Active Accounts</h6>
                                <h4 class="mb-0" style="color: #ffffff; font-weight: 600;">@SummaryStats.ActiveAccounts</h4>
                            </div>
                            <div class="card-icon-box" style="background: rgba(255,255,255,0.25); width: 50px; height: 50px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                <i class="ti ti-users" style="color: #ffffff; font-size: 24px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card summary-card" style="background: linear-gradient(135deg, #F59E0B, #B45309) !important;">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="mb-1" style="color: white; font-size: 13px;">Over Credit Limit</h6>
                                <h4 class="mb-0" style="color: white; font-weight: 600;">@SummaryStats.AccountsOverCreditLimit</h4>
                            </div>
                            <div class="card-icon-box" style="background: rgba(255,255,255,0.25); width: 50px; height: 50px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                <i class="ti ti-alert-triangle" style="color: white; font-size: 24px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card summary-card" style=" background: linear-gradient(135deg, #DC2626, #7F1D1D) !important;">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="mb-1" style="color: rgba(255,255,255,0.85); font-size: 13px;">Blocked/Frozen</h6>
                                <h4 class="mb-0" style="color: #ffffff; font-weight: 600;">@(SummaryStats.FrozenAccounts + SummaryStats.PostingBlockedAccounts)</h4>
                            </div>
                            <div class="card-icon-box" style="background: rgba(255,255,255,0.25); width: 50px; height: 50px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                <i class="ti ti-lock" style="color: #ffffff; font-size: 24px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer Account List -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                        <input type="search" class="form-control form-control-sm" placeholder="Search by customer code or name..."
                               @bind="searchText" @oninput="OnSearch" />
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                    <div>
                        <select class="form-select form-select-sm" style="min-width: 140px" @bind="SelectedStatus">
                            <option value="">All Status</option>
                            @foreach (var status in AllAccounts.Select(a => a.AccountStatus).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s))
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 160px" @bind="SelectedBlockedFilter">
                            <option value="">All Accounts</option>
                            @if (AllAccounts.Any(a => a.IsPostingBlocked))
                            {
                                <option value="blocked">Posting Blocked</option>
                            }
                            @if (AllAccounts.Any(a => !a.IsPostingBlocked))
                            {
                                <option value="notblocked">Posting Allowed</option>
                            }
                        </select>
                    </div>
                    <div class="ms-2">
                        <select class="form-select form-select-sm" style="min-width: 160px" @bind="SelectedCreditFilter">
                            <option value="">All Credit Status</option>
                            @if (AllAccounts.Any(a => a.OverCreditAmount > 0))
                            {
                                <option value="overcredit">Over Credit Limit</option>
                            }
                            @if (AllAccounts.Any(a => a.OverCreditAmount <= 0))
                            {
                                <option value="withincredit">Within Credit Limit</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="">
                    <div class="table-responsive">
                        <table class="table align-middle w-100 mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th class="d-xl-none" style="width:40px"></th>
                                    <th style="width:10%" title="Customer Code">Customer</th>
                                    <th style="width:22%" class="d-none d-md-table-cell" title="Customer Name & Currency">Customer Name</th>
                                    <th class="d-none d-lg-table-cell text-end" style="width:12%" title="Outstanding Receivable Amount">Outstanding</th>
                                    <th class="d-none d-xl-table-cell text-end" style="width:12%" title="Credit Limit">Credit Limit</th>
                                    <th class="d-none d-xl-table-cell text-end" style="width:12%" title="Credit Exposure">Exposure</th>
                                    <th style="width:10%" title="Account Status" class="d-none d-md-table-cell">Status</th>
                                    <th style="width:8%" title="Actions">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (PagedAccounts.Any())
                                {
                                    @foreach (var acc in PagedAccounts)
                                    {
                                        <tr>
                                            <!-- PLUS ICON -->
                                            <td class="d-xl-none text-center" style="padding: 0;padding-left: 15px;">
                                                <a href="javascript:void(0);" class="TablePlus"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#rowDetailsModal"
                                                   @onclick="() => OpenRowDetails(acc)">
                                                    <i class="ti ti-plus"></i>
                                                </a>
                                            </td>
                                            <td class="fw-medium" >
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a href="/customer-accounts/@acc.Id/view" class="text-decoration-none link-View"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title=" @acc.CustomerCode details">
                                                    @acc.CustomerCode
                                                </a>
                                            </td>

                                            <td  class="d-none d-md-table-cell">
                                                <div class="d-flex flex-column">
                                                    <span class="text-wrap">@acc.CustomerName</span>
                                                    <span class="badge bg-light text-dark mt-1" style="width: fit-content; font-size: 10px;">
                                                        @acc.CurrencyCode
                                                    </span>
                                                </div>
                                            </td>

                                            <td class="d-none d-lg-table-cell text-end" >
                                                <span class="@(acc.OutstandingReceivableAmount > 0 ? "text-primary fw-medium" : "")">
                                                    @* @acc.OutstandingReceivableAmount.ToString("N2") *@
                                                    @IndianNumberFormatter.Format(@acc.OutstandingReceivableAmount)
                                                </span>
                                            </td>

                                            <td class="d-none d-xl-table-cell text-end" >
                                                @* @acc.CreditLimitAmountSnapshot.ToString("N2") *@
                                                @IndianNumberFormatter.Format(@acc.CreditLimitAmountSnapshot)

                                            </td>

                                            <td class="d-none d-xl-table-cell text-end">
                                                @if (acc.OverCreditAmount > 0)
                                                {
                                                    <span class="badge bg-danger" title="Over Credit by @acc.OverCreditAmount.ToString("N2")">
                                                        
                                                        Over: @IndianNumberFormatter.Format(@acc.OverCreditAmount)
                                                        </span>
                                                }
                                                else
                                                {
                                                    <span class="text-success">
                                                        @IndianNumberFormatter.Format(@acc.CreditExposureAmount)
                                                    </span>
                                                }
                                            </td>



                                            <td class="d-none d-xl-table-cell">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="ActiveDot @GetStatusDotBadgeClass(acc.AccountStatus)">
                                                    </div>
                                                    <span>@acc.AccountStatus</span>
                                                    @if (acc.IsPostingBlocked)
                                                    {
                                                        <span class="badge bg-danger ms-1" title="Posting Blocked: @acc.PostingBlockReason">
                                                            <i class="ti ti-lock"></i>
                                                        </span>
                                                    }
                                                </div>
                                            </td>

                                            <td class="action-table-data">
                                                <div class="edit-delete-action">
                                                    @if (!acc.IsPostingBlocked && acc.AccountStatus == CustomerAccountStatuses.Active)
                                                    {
                                                        <a class="me-2 p-1 action-icon freeze-icon" href="javascript:void(0);"
                                                           title="Freeze Account" data-bs-toggle="modal" data-bs-target="#freeze-modal"
                                                           @onclick="() => OpenFreezeModal(acc)">
                                                            <i class="ti ti-lock"></i>
                                                        </a>
                                                    }
                                                    @if (acc.IsPostingBlocked || acc.AccountStatus == CustomerAccountStatuses.Frozen)
                                                    {
                                                        <a class="me-2 p-1 action-icon unfreeze-icon" href="javascript:void(0);"
                                                           title="Unfreeze Account" data-bs-toggle="modal" data-bs-target="#unfreeze-modal"
                                                           @onclick="() => ConfirmUnfreeze(acc)">
                                                            <i class="ti ti-lock-open"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@VisibleColumnCount" class="text-center py-4">
                                            <div class="text-muted">
                                                <i class="ti ti-database-off fs-24 d-block mb-2"></i>
                                                No customer accounts found
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 px-3 pt-3 pb-4" id="RowsPerPageContent">
                        <div class="d-flex align-items-center">
                            <span class="me-2">Rows per page</span>
                            <select class="form-select form-select-sm" style="width: auto" @onchange="OnPageSizeChange">
                                <option value="5" selected="@(PageSize == 5)">5</option>
                                <option value="10" selected="@(PageSize == 10)">10</option>
                                <option value="25" selected="@(PageSize == 25)">25</option>
                                <option value="50" selected="@(PageSize == 50)">50</option>
                            </select>
                            <span class="ms-3 text-muted">
                                Entries
                            </span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = 1; i <= TotalPages; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button" class="page-link" @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row Details Modal (Mobile) -->
        <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Account Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                style="padding:0; right:22px; position:absolute;transform:none"></button>
                    </div>
                    <div class="modal-body">
                        @if (SelectedAccount != null)
                        {
                            <div class="mb-2 d-flex gap-3">
                                <strong>Customer:</strong>
                                <div>@SelectedAccount.CustomerCode</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Name:</strong>
                                <div>@SelectedAccount.CustomerName</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Currency:</strong>
                                <div>@SelectedAccount.CurrencyCode</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Outstanding:</strong>
                                <div class="text-primary fw-medium">@SelectedAccount.OutstandingReceivableAmount.ToString("N2")</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Unapplied:</strong>
                                <div class="@(SelectedAccount.UnappliedPaymentAmount > 0 ? "text-success" : "")">@SelectedAccount.UnappliedPaymentAmount.ToString("N2")</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Credit Limit:</strong>
                                <div>@SelectedAccount.CreditLimitAmountSnapshot.ToString("N2")</div>
                            </div>
                            <div class="mb-2 d-flex gap-3">
                                <strong>Exposure:</strong>
                                <div>@SelectedAccount.CreditExposureAmount.ToString("N2")</div>
                            </div>
                            <div class="mb-2 gap-3">
                                <strong>Status:</strong>
                                <span class="badge @GetStatusBadgeClass(SelectedAccount.AccountStatus)">
                                    @SelectedAccount.AccountStatus
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Freeze Modal -->
        <div class="modal fade" id="freeze-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                                <i class="ti ti-lock fs-24 text-warning"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Freeze Account</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Do you want to freeze the account for <strong>@SelectedAccount?.CustomerName</strong>?
                            </p>
                            <div class="mt-3 text-start">
                                <label class="form-label">Freeze Type <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="freezeTypeInput">
                                    <option value="">-- Select Freeze Type --</option>
                                    <option value="CollectionsHold">Collections Hold</option>
                                    <option value="ComplianceHold">Compliance Hold</option>
                                    <option value="DisputeHold">Dispute Hold</option>
                                    <option value="Manual">Manual</option>
                                </select>
                            </div>
                            <div class="mt-3 text-start">
                                <label class="form-label">Reason <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="3" @bind="freezeReasonInput" placeholder="Enter reason for freezing account..."></textarea>
                            </div>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="FreezeConfirmed" data-bs-dismiss="modal"><i class="ti ti-lock me-1"></i>Yes, Freeze</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Unfreeze Modal -->
        <div class="modal fade" id="unfreeze-modal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="page-wrapper-new p-0">
                        <div class="p-5 px-3 text-center">
                            <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                                <i class="ti ti-lock-open fs-24 text-success"></i>
                            </span>
                            <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Unfreeze Account</h4>
                            <p class="text-gray-6 mb-0 fs-16">
                                Do you want to unfreeze the account for <strong>@SelectedAccount?.CustomerName</strong>?
                            </p>
                            <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                                <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="UnfreezeConfirmed" data-bs-dismiss="modal"><i class="ti ti-lock-open me-1"></i>Yes, Unfreeze</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

}

<style>
    .spin-animation {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .summary-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .summary-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    }
</style>
