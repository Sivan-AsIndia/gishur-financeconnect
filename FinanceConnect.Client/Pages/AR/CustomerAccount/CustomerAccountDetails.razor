@page "/customer-accounts/{Id:guid}/view"
@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services

<PageTitle>Customer Account Details - FinanceConnect</PageTitle>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else if (Account == null)
{
    <div class="container-xl mt-4">
        <div class="alert alert-warning">
            <i class="ti ti-alert-triangle me-2"></i>
            Customer account not found.
        </div>
        <a href="/customer-accounts" class="btn btn-secondary">
            <i class="ti ti-arrow-left me-1"></i> Back to List
        </a>
    </div>
}
else
{
    <div class="content view-screen py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-1">Customer Account Details</h4>
                <p class="text-muted mb-0 small">View account balances and status</p>
            </div>
            <a href="/customer-accounts" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Back
            </a>
        </div>

        <!-- ═══ HEADER CARD (CompanyDetails gradient style) ═══ -->
        <div class="header-card mb-3" style="border-radius:12px;">
            <div class="header-inner">
                <div class="header-left1">
                    <div class="company-logo d-flex align-items-center justify-content-center"
                         style="background:rgba(255,255,255,0.85); font-size:20px; font-weight:700; color:#FE9F43;">
                        @Account.CustomerName?.Substring(0, Math.Min(2, Account.CustomerName?.Length ?? 0)).ToUpper()
                    </div>
                    <div>
                        <h5 class="mb-1 fw-bold" style="font-size:18px;">@Account.CustomerName</h5>
                        <p class="mb-1" style="font-size:13px; color:#555;">
                            @Account.CustomerCode &nbsp;·&nbsp; @Account.CompanyName
                            @if (Account.BranchId.HasValue)
                            {
                                <span>&nbsp;·&nbsp; @Account.BranchName</span>
                            }
                        </p>
                        <div class="d-flex flex-wrap gap-2 mt-1">
                            <span class="badge @GetStatusBadgeClass(Account.AccountStatus)" style="font-size:11px;">
                                @Account.AccountStatus
                            </span>
                            <span class="badge bg-light text-dark" style="font-size:11px;">
                                <i class="ti ti-currency-rupee me-1" style="font-size:11px;"></i>@Account.CurrencyCode
                            </span>
                            @if (Account.IsPostingBlocked)
                            {
                                <span class="badge bg-danger-transparent text-danger" style="font-size:11px;">
                                    <i class="ti ti-lock me-1"></i>Blocked
                                </span>
                            }
                            @if (Account.FreezeType != FreezeTypes.None)
                            {
                                <span class="badge bg-warning-transparent text-warning" style="font-size:11px;">
                                    <i class="ti ti-snowflake me-1"></i>@Account.FreezeType
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="header-right d-flex align-items-start gap-2">
                    <span class="badge @GetStatusBadgeClass(Account.AccountStatus)" style="font-size:12px; padding:6px 14px;">
                        ● @Account.AccountStatus
                    </span>
                    <small class="text-muted" style="white-space:nowrap;">Created @Account.CreatedAt.ToString("dd MMM yyyy")</small>
                </div>
            </div>
        </div>

        <!-- ═══ BALANCE SUMMARY CARDS ═══ -->
        <div class="row g-2 mb-3">
            <div class="col-6 col-lg-3">
                <div class="card mb-0" style="border:none;border-radius:12px;background:linear-gradient(135deg, #FF7A18, #FF9F43);box-shadow:0 4px 15px rgba(0,0,0,0.1);">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="small" style="color:rgba(255,255,255,0.85);font-size:12px;">Outstanding</div>
                                <div style="color:#fff;font-weight:600;font-size:1.1rem;">@Account.OutstandingReceivableAmount.ToString("N2")</div>
                            </div>
                            <div style="background:rgba(255,255,255,0.25);width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;">
                                <i class="ti ti-receipt" style="color:#fff;font-size:20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card mb-0" style="border:none;border-radius:12px;background:linear-gradient(135deg, #22C55E, #2ECC71);box-shadow:0 4px 15px rgba(0,0,0,0.1);">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="small" style="color:rgba(255,255,255,0.85);font-size:12px;">Advance</div>
                                <div style="color:#fff;font-weight:600;font-size:1.1rem;">@Account.AdvanceBalanceAmount.ToString("N2")</div>
                            </div>
                            <div style="background:rgba(255,255,255,0.25);width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;">
                                <i class="ti ti-wallet" style="color:#fff;font-size:20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card mb-0" style="border:none;border-radius:12px;background:linear-gradient(135deg, #0FB9D7, #22D3EE);box-shadow:0 4px 15px rgba(0,0,0,0.1);">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="small" style="color:rgba(255,255,255,0.85);font-size:12px;">Unapplied</div>
                                <div style="color:#fff;font-weight:600;font-size:1.1rem;">@Account.UnappliedPaymentAmount.ToString("N2")</div>
                            </div>
                            <div style="background:rgba(255,255,255,0.25);width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;">
                                <i class="ti ti-cash" style="color:#fff;font-size:20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card mb-0" style="border:none;border-radius:12px;background:linear-gradient(135deg, @(Account.OverCreditAmount > 0 ? "#DC2626" : "#5B6168") 0%, @(Account.OverCreditAmount > 0 ? "#7F1D1D" : "#7A8087") 100%);box-shadow:0 4px 15px rgba(0,0,0,0.1);">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="small" style="color:rgba(255,255,255,0.85);font-size:12px;">Net Receivable</div>
                                <div style="color:#fff;font-weight:600;font-size:1.1rem;">@Account.NetReceivableAmount.ToString("N2")</div>
                            </div>
                            <div style="background:rgba(255,255,255,0.25);width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;">
                                <i class="ti ti-calculator" style="color:#fff;font-size:20px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <!-- ═══ LEFT COLUMN ═══ -->
            <div class="col-lg-8 mb-4">
                <!-- Credit & Exposure Card -->
                <div class="card info-card mb-2">
                    <div class="card-header py-2" style="background:#f8f9fa;border-bottom:1px solid #e9ecef;font-weight:600;font-size:14px;color:#FE9F43;">
                        <i class="ti ti-credit-card me-2"></i>Credit & Exposure
                    </div>
                    <div class="card-body">
                        <div class="info-grid">
                            <div class="info-grid-item">
                                <div class="label">Credit Limit</div>
                                <div class="value">@Account.CreditLimitAmountSnapshot.ToString("N2")</div>
                            </div>
                            <div class="info-grid-item">
                                <div class="label">Enforced</div>
                                <div class="value">
                                    <span class="badge @(Account.CreditLimitEnforcedSnapshot ? "bg-success" : "bg-secondary")">
                                        @(Account.CreditLimitEnforcedSnapshot ? "Yes" : "No")
                                    </span>
                                </div>
                            </div>
                            <div class="info-grid-item">
                                <div class="label">Exposure</div>
                                <div class="value @(Account.OverCreditAmount > 0 ? "text-danger" : "")">
                                    @Account.CreditExposureAmount.ToString("N2")
                                </div>
                            </div>
                            <div class="info-grid-item">
                                <div class="label">Available</div>
                                <div class="value @(Account.AvailableCreditAmount < 0 ? "text-danger" : "text-success")">
                                    @Account.AvailableCreditAmount.ToString("N2")
                                </div>
                            </div>
                        </div>
                        @if (Account.OverCreditAmount > 0)
                        {
                            <div class="alert alert-danger mb-0 mt-2 py-2 small">
                                <i class="ti ti-alert-triangle me-1"></i>
                                <strong>Over Limit!</strong> Exceeds by @Account.OverCreditAmount.ToString("N2")
                            </div>
                        }
                    </div>
                </div>

                <!-- Opening Balances Card -->
                <div class="card info-card mb-2">
                    <div class="card-header py-2" style="background:#f8f9fa;border-bottom:1px solid #e9ecef;font-weight:600;font-size:14px;color:#FE9F43;">
                        <i class="ti ti-history me-2"></i>Opening Balances
                    </div>
                    <div class="card-body">
                        <div class="info-grid">
                            <div class="info-grid-item">
                                <div class="label">Receivable</div>
                                <div class="value">@Account.OpeningReceivableAmount.ToString("N2")</div>
                            </div>
                            <div class="info-grid-item">
                                <div class="label">Advance</div>
                                <div class="value">@Account.OpeningAdvanceAmount.ToString("N2")</div>
                            </div>
                            <div class="info-grid-item">
                                <div class="label">As Of Date</div>
                                <div class="value">@(Account.OpeningBalanceAsOfDate?.ToString("dd MMM yy") ?? "-")</div>
                            </div>
                            <div class="info-grid-item">
                                <div class="label">Approved By</div>
                                <div class="value">@(Account.OpeningBalanceApprovedByUserName ?? "-")</div>
                            </div>
                            <div class="info-grid-item">
                                <div class="label">Approved On</div>
                                <div class="value">@(Account.OpeningBalanceApprovedOn?.ToString("dd MMM yy") ?? "-")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Locks & Restrictions Card -->
                <div class="card info-card mb-2">
                    <div class="card-header py-2" style="background:#f8f9fa;border-bottom:1px solid #e9ecef;font-weight:600;font-size:14px;color:#FE9F43;">
                        <i class="ti ti-lock me-2"></i>Locks & Restrictions
                    </div>
                    <div class="card-body">
                        <div class="info-grid">
                            <div class="info-grid-item">
                                <div class="label">Posting Blocked</div>
                                <div class="value">
                                    <span class="badge @(Account.IsPostingBlocked ? "bg-danger" : "bg-success")">
                                        @(Account.IsPostingBlocked ? "Yes" : "No")
                                    </span>
                                </div>
                            </div>
                            <div class="info-grid-item">
                                <div class="label">Freeze Type</div>
                                <div class="value">
                                    <span class="badge @(Account.FreezeType != FreezeTypes.None ? "bg-warning text-dark" : "bg-secondary")">
                                        @(Account.FreezeType ?? FreezeTypes.None)
                                    </span>
                                </div>
                            </div>
                            @if (Account.IsPostingBlocked)
                            {
                                <div class="info-grid-item" style="grid-column: span 2;">
                                    <div class="label">Block Reason</div>
                                    <div class="value text-danger">@Account.PostingBlockReason</div>
                                </div>
                            }
                        </div>
                        @if (Account.IsPostingBlocked)
                        {
                            <div class="row mt-2">
                                <div class="col-6">
                                    <small class="text-muted">Blocked By:</small>
                                    <span class="ms-1 small">@(Account.PostingBlockedByUserName ?? "-")</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Blocked On:</small>
                                    <span class="ms-1 small">@(Account.PostingBlockedOn?.ToString("dd MMM yy HH:mm") ?? "-")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ═══ RIGHT COLUMN ═══ -->
            <div class="col-lg-4 mb-4">
                <!-- Account Identity Card -->
                <div class="card info-card mb-2">
                    <div class="card-header py-2" style="background:#f8f9fa;border-bottom:1px solid #e9ecef;font-weight:600;font-size:14px;color:#FE9F43;">
                        <i class="ti ti-id me-2"></i>Account Identity
                    </div>
                    <div class="card-body p-0">
                        <div class="info-row px-3">
                            <span class="info-label">Customer</span>
                            <span class="info-value"><a href="/customer/@Account.CustomerId">@Account.CustomerCode</a></span>
                        </div>
                        <div class="info-row px-3">
                            <span class="info-label">Currency</span>
                            <span class="info-value">@Account.CurrencyCode</span>
                        </div>
                        <div class="info-row px-3">
                            <span class="info-label">Company</span>
                            <span class="info-value" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis;">@Account.CompanyName</span>
                        </div>
                        @if (Account.BranchId.HasValue)
                        {
                            <div class="info-row px-3">
                                <span class="info-label">Branch</span>
                                <span class="info-value">@Account.BranchName</span>
                            </div>
                        }
                        @if (Account.RiskScore.HasValue)
                        {
                            <div class="info-row px-3">
                                <span class="info-label">Risk Score</span>
                                <span class="info-value">
                                    <span class="badge @(Account.RiskScore >= 70 ? "bg-danger" : Account.RiskScore >= 40 ? "bg-warning text-dark" : "bg-success")">
                                        @Account.RiskScore / 100
                                    </span>
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Activity Card -->
                <div class="card info-card mb-2">
                    <div class="card-header py-2" style="background:#f8f9fa;border-bottom:1px solid #e9ecef;font-weight:600;font-size:14px;color:#FE9F43;">
                        <i class="ti ti-activity me-2"></i>Activity
                    </div>
                    <div class="card-body p-0">
                        <div class="info-row px-3">
                            <span class="info-label">Last Activity</span>
                            <span class="info-value">@(Account.LastActivityOn?.ToString("dd MMM yy") ?? "-")</span>
                        </div>
                        <div class="info-row px-3">
                            <span class="info-label">Last Invoice</span>
                            <span class="info-value">@(Account.LastInvoiceOn?.ToString("dd MMM yy") ?? "-")</span>
                        </div>
                        <div class="info-row px-3">
                            <span class="info-label">Last Payment</span>
                            <span class="info-value">@(Account.LastPaymentOn?.ToString("dd MMM yy") ?? "-")</span>
                        </div>
                    </div>
                </div>

                <!-- Collections Card -->
                @if (!string.IsNullOrWhiteSpace(Account.CollectionsStage) && Account.CollectionsStage != CollectionsStages.None)
                {
                    <div class="card info-card mb-2">
                        <div class="card-header py-2" style="background:#f8f9fa;border-bottom:1px solid #e9ecef;font-weight:600;font-size:14px;color:#FE9F43;">
                            <i class="ti ti-gavel me-2"></i>Collections
                        </div>
                        <div class="card-body p-0">
                            <div class="info-row px-3">
                                <span class="info-label">Stage</span>
                                <span class="info-value">
                                    <span class="badge @GetCollectionsBadgeClass(Account.CollectionsStage)">
                                        @Account.CollectionsStage
                                    </span>
                                </span>
                            </div>
                            @if (Account.CollectionsStartedOn.HasValue)
                            {
                                <div class="info-row px-3">
                                    <span class="info-label">Started On</span>
                                    <span class="info-value">@Account.CollectionsStartedOn.Value.ToString("dd MMM yy")</span>
                                </div>
                            }
                            @if (Account.LastCollectionActionOn.HasValue)
                            {
                                <div class="info-row px-3">
                                    <span class="info-label">Last Action</span>
                                    <span class="info-value">@Account.LastCollectionActionOn.Value.ToString("dd MMM yy")</span>
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Account.CollectionsNotes))
                        {
                            <div class="px-3 pb-2">
                                <small class="text-muted d-block">Notes:</small>
                                <small>@Account.CollectionsNotes</small>
                            </div>
                        }
                    </div>
                }

                <!-- Workflow History Card -->
                <div class="card info-card mb-2">
                    <div class="card-header py-2" style="background:#f8f9fa;border-bottom:1px solid #e9ecef;font-weight:600;font-size:14px;color:#FE9F43;">
                        <i class="ti ti-git-branch me-2"></i>Workflow History
                    </div>
                    <div class="card-body p-0">
                        <div class="info-row px-3">
                            <span class="info-label">Created</span>
                            <span class="info-value">@Account.CreatedAt.ToString("dd MMM yy HH:mm")</span>
                        </div>
                        <div class="info-row px-3">
                            <span class="info-label">Created By</span>
                            <span class="info-value">@(Account.CreatedBy ?? "-")</span>
                        </div>
                        @if (Account.UpdatedAt.HasValue)
                        {
                            <div class="info-row px-3">
                                <span class="info-label">Updated</span>
                                <span class="info-value">@Account.UpdatedAt.Value.ToString("dd MMM yy HH:mm")</span>
                            </div>
                            <div class="info-row px-3">
                                <span class="info-label">Updated By</span>
                                <span class="info-value">@(Account.UpdatedBy ?? "-")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .info-card {
        border: 1px solid #e9ecef;
        border-radius: 10px;
        margin-bottom: 1rem;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #f0f0f0;
        font-size: 13px;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-label {
        color: #6c757d;
        font-size: 12.5px;
    }

    .info-value {
        font-weight: 500;
        font-size: 13px;
        text-align: right;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 0.75rem;
    }

    .info-grid-item {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 0.6rem 0.75rem;
    }

    .info-grid-item .label {
        font-size: 11px;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-grid-item .value {
        font-weight: 600;
        font-size: 14px;
        color: #212529;
    }

    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
