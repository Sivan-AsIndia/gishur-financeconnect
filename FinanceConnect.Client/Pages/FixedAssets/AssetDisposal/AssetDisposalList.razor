@page "/asset-disposals"

@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services

@inject AssetDisposalService DisposalService
@inject ToastService ToastService
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
    <div class="content List-view">

        <!-- PAGE HEADER -->

        <div class="page-header">

            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Asset Disposals</h4>
                    <h6>Manage fixed asset retirement / disposal</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" title="Refresh"
                           @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a href="/asset-disposals/create"
                       class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>

        </div>


        <!-- LIST CARD -->

        <div class="card">

            <div class="card-header d-flex align-items-center justify-content-between">

                <div class="search-set">
                    <div class="search-input">

                        <span class="btn-searchset">
                            <i class="ti ti-search fs-14"></i>
                        </span>

                        <input type="search"
                               class="form-control form-control-sm"
                               placeholder="Search disposal number"
                               @bind="searchText"
                               @oninput="OnSearch" />

                    </div>
                </div>

                <div style="display:flex;gap:5px">

                    <select class="form-select form-select-sm"
                            style="min-width:150px"
                            @bind="SelectedStatus">

                        <option value="">All Status</option>

                        @foreach (var s in Enum.GetValues<AssetDisposalStatus>())
                        {
                            <option value="@s">@s</option>
                        }

                    </select>


                    <select class="form-select form-select-sm"
                            style="min-width:150px"
                            @bind="SelectedType">

                        <option value="">All Types</option>

                        @foreach (var s in Enum.GetValues<AssetDisposalType>())
                        {
                            <option value="@s">@s</option>
                        }

                    </select>

                </div>

            </div>


            <div class="card-body p-0">
                <div>
                <table class="table align-middle table-fixed w-100">

                    <thead class="thead-light">

                        <tr>
                                <th class="d-xl-none" style="width:40px"></th>

                            @* <th style="width:200px">Disposal No</th> *@
                                <th class="d-none d-md-table-cell">Asset</th>
                                <th class="d-none d-md-table-cell">Type</th>
                                <th class="text-end d-none d-md-table-cell">NBV</th>
                                <th class="text-end d-none d-l-table-cell">Proceeds</th>
                                <th class="text-end d-none d-xl-table-cell">Gain/Loss</th>
                                <th class="d-none d-xl-table-cell">Status</th>
                                <th class="d-none d-xl-table-cell">Date</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (PagedDisposals.Any())
                        {
                            @foreach (var d in PagedDisposals)
                            {

                                <tr>
                                    
                                        <!-- PLUS ICON -->
                                        <td class="d-xl-none text-center" style="padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#rowDetailsModal"
                                                   @onclick="() => openDisposal(d)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td>
                                            <span class="fw-medium">
                                                <span class="PopupIcon">⧉</span>
                                                <a @onclick="() => ViewDisposal(d)" data-bs-toggle="tooltip" data-bs-placement="top"
                                                       class="text-decoration-none link-View"
                                                   title="@d.AssetNumberSnapshot details">
                                                    @d.AssetNumberSnapshot
                                                </a>
                                            </span>
                                        </td>

                                    @*     <td class="d-none d-md-table-cell">
                                        @d.AssetNumberSnapshot
                                    </td> *@

                                        <td class="d-none d-md-table-cell">
                                        @d.DisposalType
                                    </td>

                                        <td class="text-end d-none d-md-table-cell">
                                        ₹@d.NetBookValueAsOfDisposalSnapshot.ToString("N2")
                                    </td>

                                        <td class="text-end d-none d-l-table-cell">
                                        ₹@d.ProceedsAmount.ToString("N2")
                                    </td>

                                        <td class="text-end d-none d-xl-table-cell">
                                        ₹@d.GainLossAmount.ToString("N2")
                                    </td>

                                        <td class="d-none d-xl-table-cell">
                                        <span class="badge @GetStatusBadge(d.DisposalStatus)">
                                            @d.DisposalStatus
                                        </span>
                                    </td>

                                        <td class="d-none d-xl-table-cell">
                                        @d.DisposalDate?.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="action-table-data">

                                        <div class="edit-delete-action">

                                            @if (d.DisposalStatus == AssetDisposalStatus.Draft)
                                            {
                                                <a class="me-2 edit-icon p-1"
                                                       title="Submit"
                                                       @onclick="() => Submit(d)">
                                                    <i class="ti ti-send"></i>
                                                </a>
                                            }

                                            @if (d.DisposalStatus == AssetDisposalStatus.Submitted)
                                            {
                                                <a class="me-2 edit-icon p-1"
                                                       title="Approve"
                                                       @onclick="() => Approve(d)">
                                                    <i class="ti ti-check"></i>
                                                </a>
                                            }

                                            @if (d.DisposalStatus == AssetDisposalStatus.Approved)
                                            {
                                                <a class="me-2 edit-icon p-1"
                                                       title="Post"
                                                       @onclick="() => Post(d)">
                                                    <i class="ti ti-upload"></i>
                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>

                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4">

                                    <div class="text-muted">

                                        <i class="ti ti-database-off fs-32 d-block mb-2"></i>

                                        No disposals found

                                    </div>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
                    @if (PagedDisposals.Any())
                    {
                        <!-- Pagination -->
                        <div class="d-flex justify-content-between align-items-center p-3">

                            <div class="d-flex align-items-center fs-13">
                                <span class="me-2">Rows Per Page</span>
                                <select class="form-select form-select-sm w-auto"
                                        @onchange="OnPageSizeChange">
                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                </select>
                                <span class="ms-2">Entries</span>
                            </div>

                            <nav>
                                <ul class="pagination pagination-sm mb-0">

                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                               @onclick="PreviousPage"
                                               @onclick:preventDefault>
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>

                                    @foreach (var pageNumber in VisiblePages)
                                    {
                                        <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                            <button class="page-link"
                                                    @onclick="() => GoToPage(pageNumber)">
                                                @pageNumber
                                            </button>
                                        </li>
                                    }

                                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                               @onclick="NextPage"
                                               @onclick:preventDefault>
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>

                                </ul>
                            </nav>
                        </div>
                    }

            </div>
            </div>
        </div>
    </div>
    <!-- ROW DETAILS MODAL -->
    <div class="modal fade" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="ti ti-trash me-2"></i>
                        Asset Disposal Details
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    @if (SelectedDisposal != null)
                    {
                        <div class="row g-3">

                            <div class="col-md-6">
                                <div class="detail-box">
                                    <span class="label">Disposal Number: </span>
                                    <span class="value">@SelectedDisposal.DisposalNumber</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="detail-box">
                                    <span class="label">Asset: </span>
                                    <span class="value">@SelectedDisposal.AssetNumberSnapshot</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="detail-box">
                                    <span class="label">Disposal Type: </span>
                                    <span class="value">@SelectedDisposal.DisposalType</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="detail-box">
                                    <span class="label">Disposal Date: </span>
                                    <span class="value">
                                        @SelectedDisposal.DisposalDate?.ToString("dd MMM yyyy")
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-box">
                                    <span class="label">NBV: </span>
                                    <span class="value">
                                        ₹@SelectedDisposal.NetBookValueAsOfDisposalSnapshot.ToString("N2")
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-box">
                                    <span class="label">Proceeds: </span>
                                    <span class="value">
                                        ₹@SelectedDisposal.ProceedsAmount.ToString("N2")
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-box">
                                    <span class="label">Gain / Loss: </span>
                                    <span class="value">
                                        ₹@SelectedDisposal.GainLossAmount.ToString("N2")
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="detail-box">
                                    <span class="label">Status: </span>

                                    <span class="badge @GetStatusBadge(SelectedDisposal.DisposalStatus)">
                                        @SelectedDisposal.DisposalStatus
                                    </span>
                                </div>
                            </div>

                        </div>
                    }

                </div>


            </div>

        </div>
    </div>
}