@page "/asset-acquisitions/{Id:guid}/view"
@using FinanceConnect.Client.ViewModels
@inject IJSRuntime JS
@inject FinanceConnect.Client.Services.AssetAcquisitionService acqService
@inject NavigationManager navigation

@if (!isInitialized)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else if (Item == null)
{
    <div class="content py-4">
        <div class="alert alert-danger">
            <i class="ti ti-alert-circle me-2"></i> Acquisition not found.
            <a href="/asset-acquisitions" class="alert-link ms-2">Return to list</a>
        </div>
    </div>
}
else
{
    <div class="content py-4 view-screen">

        <!-- PAGE TITLE ROW -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-1">Asset Acquisition Details</h4>
                <p class="text-muted mb-0 small">Acquisition record and cost breakdown</p>
            </div>
            <div class="d-flex gap-2 page-btn">
                @if (Item.AcquisitionStatus == AssetAcquisitionViewModel.AcquisitionStatusEnum.Draft)
                {
                    <a href="/asset-acquisitions/edit/@Item.AssetAcquisitionId" class="btn btn-primary">
                        <i class="ti ti-edit me-1"></i> Edit
                    </a>
                }
                <a class="btn btn-outline-secondary" href="/asset-acquisitions">
                    <i class="ti ti-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>

        <div class="row g-4">

            <!-- ═══ HEADER PANEL ═══ -->
            <div class="col-lg-12">
                <div class="profile-list-card">
                    <div class="profile-left">
                        <div class="avatar letter-avatar">
                            @Item.AcquisitionNumber?.Substring(Math.Max(0, (Item.AcquisitionNumber?.Length ?? 0) - 4))
                        </div>
                    </div>
                    <div class="profile-center">
                        <div class="top-row">
                            <h5>@Item.AcquisitionNumber</h5>
                        </div>
                        <div class="sub-text">
                            <span class="d-flex gap-1 mt-1">
                                <i class="ti ti-box"></i>
                                @Item.AssetNameSnapshot &nbsp;·&nbsp; @Item.AssetNumberSnapshot
                            </span>
                            <span class="d-flex gap-1 mt-1">
                                <i class="ti ti-calendar"></i>
                                Acq. Date: @Item.AcquisitionDate?.ToString("dd MMM yyyy")
                                &nbsp;·&nbsp;
                                @FormatEnumName(Item.AcquisitionType?.ToString())
                            </span>
                        </div>
                        <div class="mt-2">
                            <span class="badge @GetStatusBadgeClass(Item.AcquisitionStatus)">
                                @Item.AcquisitionStatus
                            </span>
                            @if (Item.PostedOn.HasValue)
                            {
                                <span class="badge bg-success-transparent ms-1">Posted @Item.PostedOn.Value.ToString("dd MMM yyyy")</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ═══ LEFT PANEL (col-8) ═══ -->
            <div class="col-lg-8">
                <div class="profile-card">

                    <!-- Header Information -->
                    <div class="card mb-0">
                        <div class="card-header py-2">
                            <i class="ti ti-file-description me-2"></i> Header Information
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Acquisition No</small>
                                    <div class="fw-medium">@Item.AcquisitionNumber</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Type</small>
                                    <div>@FormatEnumName(Item.AcquisitionType?.ToString())</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Acquisition Date</small>
                                    <div>@Item.AcquisitionDate?.ToString("dd MMM yyyy")</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Capitalization Date</small>
                                    <div>@(Item.CapitalizationDate?.ToString("dd MMM yyyy") ?? "—")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Asset Linkage -->
                    <div class="card mt-3 mb-0">
                        <div class="card-header py-2">
                            <i class="ti ti-link me-2"></i> Asset Linkage
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Asset Code</small>
                                    <div class="fw-medium">@Item.AssetNumberSnapshot</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Asset Name</small>
                                    <div>@Item.AssetNameSnapshot</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Asset Status</small>
                                    <div>@Item.AssetStatusSnapshot</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Source & References -->
                    <div class="card mt-3 mb-0">
                        <div class="card-header py-2">
                            <i class="ti ti-receipt me-2"></i> Source &amp; References
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Source Module</small>
                                    <div>@Item.SourceModule</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Vendor Invoice No</small>
                                    <div>@(Item.VendorInvoiceNumber ?? "—")</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Vendor Invoice Date</small>
                                    <div>@(Item.VendorInvoiceDate?.ToString("dd MMM yyyy") ?? "—")</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">PO Reference</small>
                                    <div>@(Item.PurchaseOrderRef ?? "—")</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Reference Text</small>
                                    <div>@(Item.ReferenceText ?? "—")</div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-muted">Posting Route</small>
                                    <div>@FormatEnumName(Item.PostingRoute?.ToString())</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cost Lines -->
                    <div class="card mt-3 mb-0">
                        <div class="card-header py-2">
                            <i class="ti ti-list-details me-2"></i> Cost Lines
                        </div>
                        <div class="card-body py-2">
                            <div class="table-responsive">
                                <table class="table table-bordered align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            <th>Cost Type</th>
                                            <th>Description</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-end">Tax</th>
                                            <th class="text-end">Line Total</th>
                                            <th class="text-center">Capitalizable</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in Item.CostLines)
                                        {
                                            <tr>
                                                <td>@line.LineNumber</td>
                                                <td>@FormatEnumName(line.CostComponentType?.ToString())</td>
                                                <td>@(line.LineDescription ?? "—")</td>
                                                <td class="text-end">@line.LineAmount.ToString("N2")</td>
                                                <td class="text-end">@line.TaxAmount.ToString("N2")</td>
                                                <td class="text-end fw-semibold">@line.LineTotalAmount.ToString("N2")</td>
                                                <td class="text-center">
                                                    @if (line.IsCapitalizable)
                                                    { <span class="badge bg-success-transparent">Yes</span> }
                                                    else
                                                    {

                                                        <span class="badge bg-secondary-transparent text-secondary">No</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Item.Narration))
                    {
                        <div class="card mt-3 mb-0">
                            <div class="card-header py-2">
                                <i class="ti ti-notes me-2"></i> Narration
                            </div>
                            <div class="card-body py-2">
                                <div class="ql-editor">
                                    @((MarkupString)(Item.Narration ?? string.Empty))
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>

            <!-- ═══ RIGHT PANEL (col-4) ═══ -->
            <div class="col-lg-4">
                <div class="profile-card">

                    <!-- Status & Totals -->
                    <div class="card mb-0">
                        <div class="card-header py-2">
                            <i class="ti ti-circle-check me-2"></i> Status &amp; Totals
                        </div>
                        <div class="card-body py-2">
                            <div class="mb-2">
                                <small class="text-muted">Status</small>
                                <div>
                                    <span class="badge @GetStatusBadgeClass(Item.AcquisitionStatus)">@Item.AcquisitionStatus</span>
                                </div>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">Sub Total</small>
                                <div class="fw-medium">@Item.SubTotalAmount.ToString("N2")</div>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">Total Tax</small>
                                <div>@Item.TotalTaxAmount.ToString("N2")</div>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">Round Off</small>
                                <div>@Item.RoundOffAmount.ToString("N2")</div>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">Total Capitalized Amount</small>
                                <div class="fw-bold text-success fs-18">@Item.TotalCapitalizedAmount.ToString("N2")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Audit -->
                    <div class="card mt-3 mb-0">
                        <div class="card-header py-2">
                            <i class="ti ti-clock me-2"></i> Audit
                        </div>
                        <div class="card-body py-2">
                            <div class="mb-2">
                                <small class="text-muted">Created At</small>
                                <div>@Item.CreatedAt.ToString("dd MMM yyyy")</div>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">Attachments</small>
                                <div>@Item.AttachmentCount file(s)</div>
                            </div>
                            @if (Item.PostedOn.HasValue)
                            {
                                <div class="mb-2">
                                    <small class="text-muted">Posted On</small>
                                    <div>@Item.PostedOn.Value.ToString("dd MMM yyyy HH:mm")</div>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
}
