@page "/assets-category"
@inject IJSRuntime JS

<style>
    @@media(max-width:442px) {
        .responsivefilter { flex-wrap: wrap; }
    }
</style>

<div class="content List-view">

    <!-- ═══ PAGE HEADER ═══ -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Asset Category List</h4>
                <h6>Manage Asset Categories</h6>
            </div>
        </div>
        <ul class="table-top-head me-2">
            <li>
                <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>
        <div class="page-btn">
            <a href="/assets-category/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i> Create
            </a>
        </div>
    </div>

    <div class="card">

        <!-- ═══ FILTERS ═══ -->
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                    <input type="search" class="form-control form-control-sm"
                           placeholder="Search category"
                           @bind="searchText" @oninput="OnSearch" />
                </div>
            </div>
            <div style="display:flex; gap:15px;" class="responsivefilter">
                <select class="form-select form-select-sm" style="min-width:180px"
                        @bind="SelectedType" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Types</option>
                    <option value="1">Tangible</option>
                    <option value="2">Intangible</option>
                    <option value="3">Lease Asset</option>
                    <option value="4">Other</option>
                </select>
                <select class="form-select form-select-sm" style="min-width:180px"
                        @bind="SelectedStatus" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Status</option>
                    <option value="1">Active</option>
                    <option value="2">Inactive</option>
                    <option value="3">Archived</option>
                </select>
            </div>
        </div>

        <!-- ═══ TABLE ═══ -->
        <div class="card-body p-0">
            <table class="table align-middle w-100 table-fixed">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xl-none" style="width:40px"></th>
                        @* <th>Code</th> *@
                        <th>Name</th>
                        <th class="d-none d-md-table-cell">Type</th>
                        @* <th class="d-none d-md-table-cell">Capitalizable</th> *@
                        @* <th class="d-none d-xl-table-cell">Depreciable</th> *@
                        <th class="d-none d-xl-table-cell">Useful Life</th>
                        <th class="d-none d-xl-table-cell">Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedCategories.Any())
                    {
                        @foreach (var c in PagedCategories)
                        {
                            <tr>
                                <!-- Responsive expand -->
                                <td class="d-xl-none text-center" style="padding:0;padding-left:15px;">
                                    <a href="javascript:void(0);" class="TablePlus"
                                       data-bs-toggle="modal" data-bs-target="#rowDetailsModal"
                                       @onclick="() => OpenRowDetails(c)">
                                        <i class="ti ti-plus"></i>
                                    </a>
                                </td>

                                <td>
                                    <span class="fw-medium">
                                        <i class="ti ti-external-link me-2 PopupIcon"></i>
                                        <a href="/assets-category/@c.AssetCategoryId/view"
                                           class="link-View text-decoration-none"
                                           data-bs-toggle="tooltip" data-bs-placement="top"
                                           title="@c.CategoryCode details">
                                            @c.CategoryName
                                        </a>
                                    </span>
                                    @* ✅ Lock badge — locked category-க்கு indicator காட்டு *@
                                    @if (c.IsLockedForChanges)
                                    {
                                        <span class="badge bg-danger-transparent ms-1"
                                              title="@c.LockReason">
                                            <i class="ti ti-lock me-1" style="font-size:10px;"></i>Locked
                                        </span>
                                    }
                                </td>

                                @* <td>@c.CategoryName</td> *@

                                <td class="d-none d-md-table-cell">@c.AssetType</td>

                                @* <td class="d-none d-md-table-cell">
                                    @if (c.IsCapitalizable)
                                    {
                                        <span class="badge bg-success-transparent">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-transparent">No</span>
                                    }
                                </td> *@

                                @* <td class="d-none d-xl-table-cell">
                                    @if (c.IsDepreciable)
                                    {
                                        <span class="badge bg-info-transparent">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-transparent">No</span>
                                    }
                                </td> *@

                                <td class="d-none d-xl-table-cell">
                                    @(c.UsefulLifeMonths.HasValue ? $"{c.UsefulLifeMonths} Months" : "—")
                                </td>

                                <td class="d-none d-xl-table-cell">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="ActiveDot @GetStatusDotBadge(c.CategoryStatus)"></div>
                                        <span>@c.CategoryStatus</span>
                                    </div>
                                </td>

                                <td class="action-table-data">
                                    <div class="edit-delete-action">

                                        @if (!c.IsLockedForChanges)
                                        {
                                            <a class="me-2 p-1 edit-icon"
                                               href="/assets-category/edit/@c.AssetCategoryId"
                                               title="Edit">
                                                <i data-feather="edit"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="me-2 p-1 text-muted" style="cursor:not-allowed;opacity:0.4;"
                                               title="Locked — cannot edit">
                                                <i data-feather="edit"></i>
                                            </a>
                                        }

                                        @if (!c.IsLockedForChanges)
                                        {
                                            <a class="me-2 p-1 action-icon lock "
                                               href="javascript:void(0);"
                                               title="Lock Category"
                                               data-bs-toggle="modal"
                                               data-bs-target="#lock-modal"
                                               @onclick="() => LockPopupOpen(c)">
                                                <i class="ti ti-lock-open"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="me-2 p-1 action-icon unLock"
                                               href="javascript:void(0);"
                                               title="Unlock Category"
                                               data-bs-toggle="modal"
                                               data-bs-target="#unlock-modal"
                                               @onclick="() => UnlockPopupOpen(c)">
                                                <i class="ti ti-lock" ></i>
                                            </a>
                                        }

                                        @if (c.CategoryStatus != AssetsCategoryViewModel.CategoryStatus.Archived)
                                        {
                                            <a class="me-2 p-1 action-icon archive"
                                               href="javascript:void(0);"
                                               title="Archive Category"
                                               data-bs-toggle="modal"
                                               data-bs-target="#archive-modal"
                                               @onclick="() => ArchivePopupOpen(c)">
                                                <i class="ti ti-archive"></i>
                                            </a>
                                        }

                                        <!-- Delete -->
                                        <a class="me-2 p-1 delete-icon action-icon"
                                           href="javascript:void(0);"
                                           title="Delete"
                                           data-bs-toggle="modal"
                                           data-bs-target="#delete-modal"
                                           @onclick="() => DeletePopupOpen(c)">
                                            <i class="ti ti-trash"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No categories found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ═══ PAGINATION ═══ -->
        @if (FilteredCategories.Count > 0)
        {
            <div class="d-flex align-items-center justify-content-between p-3">
                <div class="d-flex align-items-center fs-13">
                    <span class="me-2">Rows per page</span>
                    <select class="form-select form-select-sm" style="width:80px" @onchange="OnPageSizeChange">
                        <option value="5"  selected="@(PageSize == 5)">5</option>
                        <option value="10" selected="@(PageSize == 10)">10</option>
                        <option value="25" selected="@(PageSize == 25)">25</option>
                        <option value="50" selected="@(PageSize == 50)">50</option>
                    </select>
                    <span class="ms-2">Entries</span>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                <i class="ti ti-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = StartPage; i <= EndPage; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                <a class="page-link" href="javascript:void(0);"
                                   @onclick="() => GoToPage(pageNum)">@pageNum</a>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                <i class="ti ti-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }

    </div><!-- END card -->

    <!-- ═══ RESPONSIVE ROW DETAILS MODAL ═══ -->
    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Asset Category Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            style="padding:0;right:22px;position:absolute;transform:none"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2 d-flex gap-3">
                        <strong>Useful Life:</strong>
                        <div>@(SelectedCategory?.UsefulLifeMonths.HasValue == true ? $"{SelectedCategory.UsefulLifeMonths} Months" : "—")</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Type:</strong>
                        <div>@SelectedCategory?.AssetType</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Capitalizable:</strong>
                        @if (SelectedCategory?.IsCapitalizable == true)
                        { <span class="badge bg-success-transparent">Yes</span> }
                        else
                        { <span class="badge bg-secondary-transparent">No</span> }
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Depreciable:</strong>
                        @if (SelectedCategory?.IsDepreciable == true)
                        { <span class="badge bg-info-transparent">Yes</span> }
                        else
                        { <span class="badge bg-secondary-transparent">No</span> }
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Status:</strong>
                        @if (SelectedCategory != null)
                        {
                            <span class="badge @GetStatusBadgeClass(SelectedCategory.CategoryStatus)">
                                @SelectedCategory.CategoryStatus
                            </span>
                        }
                    </div>
                    @if (SelectedCategory?.IsLockedForChanges == true)
                    {
                        <div class="mb-2 d-flex gap-3">
                            <strong>Lock Reason:</strong>
                            <span class="text-danger">@SelectedCategory.LockReason</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ ✅ LOCK MODAL ═══ -->
    <div class="modal fade" id="lock-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 mb-2"
                              style="background:#fef3c7;">
                            <i class="ti ti-lock fs-24" style="color:#f59e0b;"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Lock Category</h4>
                        <p class="text-gray-6 mb-3 fs-16">
                            Lock <strong>@SelectedCategory?.CategoryName</strong>?
                            No changes will be allowed once locked.
                        </p>
                        <div class="text-start mb-3 px-2">
                            <label class="form-label fw-medium">
                                Lock Reason <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="@($"form-control {(LockReasonError ? "is-invalid" : "")}")"
                                   @bind="LockReasonInput"
                                   @oninput="OnLockReasonInput"
                                   placeholder="e.g. Locked during Q4 audit close" />
                            @if (LockReasonError)
                            {
                                <div class="text-danger small mt-1">Lock reason is required</div>
                            }
                        </div>
                        <div class="modal-footer-btn mt-2 d-flex justify-content-center gap-3">
                            <button type="button"
                                    class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4"
                                    data-bs-dismiss="modal">
                                <i class="ti ti-x me-1"></i>Cancel
                            </button>
                            <button type="button"
                                    class="btn fs-13 fw-medium p-2 px-4"
                                    style="background:#f59e0b;color:white;"
                                    @onclick="ConfirmLock"
                                    data-bs-dismiss="@(string.IsNullOrWhiteSpace(LockReasonInput) ? "" : "modal")">
                                <i class="ti ti-lock me-1"></i>Yes, Lock
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ ✅ UNLOCK MODAL ═══ -->
    <div class="modal fade" id="unlock-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 mb-2"
                              style="background:#dcfce7;">
                            <i class="ti ti-lock-open fs-24" style="color:#22c55e;"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Unlock Category</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Unlock <strong>@SelectedCategory?.CategoryName</strong>?
                            Changes will be allowed again after unlocking.
                        </p>
                        @if (!string.IsNullOrWhiteSpace(SelectedCategory?.LockReason))
                        {
                            <p class="text-muted small mt-2">
                                Current lock reason: <em>@SelectedCategory.LockReason</em>
                            </p>
                        }
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button"
                                    class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4"
                                    data-bs-dismiss="modal">
                                <i class="ti ti-x me-1"></i>Cancel
                            </button>
                            <button type="button"
                                    class="btn btn-success fs-13 fw-medium p-2 px-4"
                                    @onclick="ConfirmUnlock"
                                    data-bs-dismiss="modal">
                                <i class="ti ti-lock-open me-1"></i>Yes, Unlock
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ ✅ ARCHIVE MODAL ═══ -->
    <div class="modal fade" id="archive-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 mb-2"
                              style="background:#ede9fe;">
                            <i class="ti ti-archive fs-24" style="color:#6366f1;"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Archive Category</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Archive <strong>@SelectedCategory?.CategoryName</strong>?
                            Archived categories cannot be used for new assets.
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button"
                                    class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4"
                                    data-bs-dismiss="modal">
                                <i class="ti ti-x me-1"></i>Cancel
                            </button>
                            <button type="button"
                                    class="btn fs-13 fw-medium p-2 px-4"
                                    style="background:#6366f1;color:white;"
                                    @onclick="ConfirmArchive"
                                    data-bs-dismiss="modal">
                                <i class="ti ti-archive me-1"></i>Yes, Archive
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ DELETE MODAL ═══ -->
    <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Asset Category</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            Are you sure you want to delete
                            <strong>@SelectedCategory?.CategoryCode</strong>?
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button"
                                    class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4"
                                    data-bs-dismiss="modal">
                                <i class="ti ti-x me-1"></i>Cancel
                            </button>
                            <button type="button"
                                    class="btn btn-danger fs-13 fw-medium p-2 px-4"
                                    @onclick="() => ConfirmDelete(SelectedCategory!.AssetCategoryId)"
                                    data-bs-dismiss="modal">
                                <i class="ti ti-trash me-1"></i>Yes, Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
