@page "/fixed-assets"
@using static FinanceConnect.Client.ViewModels.FixedAssetViewModel
@using FA = FinanceConnect.Client.ViewModels.FixedAssetViewModel

<style>
    @@media(max-width:635px) {
        .responsivefilter {
            flex-wrap: wrap;
        }
    }
</style>

<div class="content List-view">

    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Fixed Asset List</h4>
                <h6>Manage Fixed Assets</h6>
            </div>
        </div>

        <ul class="table-top-head me-2">
            <li>
                <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>

        <div class="page-btn">
            <button class="btn btn-primary" @onclick="OpenCreateOffcanvas"
                    data-bs-toggle="offcanvas" data-bs-target="#createEditAssetOffcanvas">
                <i class="ti ti-circle-plus me-1"></i> Create
            </button>
        </div>
    </div>

    <div class="card">

        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                    <input type="search" class="form-control form-control-sm"
                           placeholder="Search asset name, tag, serial..."
                           @bind="searchText" @oninput="OnSearch" />
                </div>
            </div>

            <div style="display:flex; gap:15px;" class="responsivefilter">
                <select class="form-select form-select-sm" style="min-width:180px"
                        @bind="SelectedStatus" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Status</option>
                    <option value="1">Draft</option>
                    <option value="2">Active</option>
                    <option value="3">Inactive</option>
                    <option value="4">Disposed</option>
                </select>

                <select class="form-select form-select-sm" style="min-width:180px"
                        @bind="SelectedDepreciable" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Assets</option>
                    <option value="true">Depreciable</option>
                    <option value="false">Non-Depreciable</option>
                </select>

                <select class="form-select form-select-sm" style="min-width:180px"
                        @bind="SelectedBranchId" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Branches</option>
                    @foreach (var branch in BranchesList)
                    {
                        <option value="@branch.Id">@branch.BranchName</option>
                    }
                </select>
            </div>
        </div>

        <div class="card-body p-0">
            <table class="table align-middle w-100 table-fixed">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xxl-none" style="width:40px"></th>
                        <th>Asset Name</th>
                        <th class="d-none d-md-table-cell">Category</th>
                        <th class="d-none d-md-table-cell">Asset Tag</th>
                        <th class="d-none d-xl-table-cell">Branch</th>
                        <th class="d-none d-xxl-table-cell">Purchase Date</th>
                        <th class="d-none d-xl-table-cell">Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedAssets.Any())
                    {
                        @foreach (var a in PagedAssets)
                        {
                            <tr>
                                <td class="d-xxl-none text-center" style="padding:0;padding-left:15px;">
                                    <a href="javascript:void(0);" class="TablePlus"
                                       data-bs-toggle="modal"
                                       data-bs-target="#rowDetailsModal"
                                       @onclick="() => OpenRowDetails(a)">
                                        <i class="ti ti-plus"></i>
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-medium" data-bs-toggle="offcanvas"
                                          data-bs-target="#viewAssetOffcanvas">
                                        <i class="ti ti-external-link me-2 PopupIcon"></i>
                                        <a href="javascript:void(0)" data-bs-toggle="tooltip" data-bs-placement="top"
                                           title="@a.AssetName details"
                                           class="link-View text-decoration-none"
                                           @onclick="() => OpenRowDetails(a)">
                                            @a.AssetName
                                        </a>
                                    </span>
                                </td>
                                <td class="d-none d-md-table-cell">@(a?.CategoryName ?? "-")</td>
                                <td class="d-none d-md-table-cell">
                                    @if (!string.IsNullOrEmpty(a.AssetTag))
                                    {
                                        <span class="badge bg-light text-dark border">@a.AssetTag</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="d-none d-xl-table-cell">@(string.IsNullOrWhiteSpace(a.BranchName) ? "-" : a.BranchName)</td>
                                <td class="d-none d-xxl-table-cell">
                                    @(a.PurchaseDate?.ToString("dd MMM yyyy") ?? "—")
                                </td>
                                <td class="d-none d-xl-table-cell">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="ActiveDot @GetStatusDotBadge(a.AssetStatus)"></div>
                                        <span>@a.AssetStatus</span>
                                    </div>
                                </td>
                                <td class="action-table-data">
                                    <div class="edit-delete-action">
                                        <a class="me-2 view-icon p-1"
                                           data-bs-toggle="offcanvas"
                                           data-bs-target="#viewAssetOffcanvas"
                                           title="View"
                                           @onclick="() => OpenRowDetails(a)">
                                            <i data-feather="eye"></i>
                                        </a>
                                        @if (a.AssetStatus == AssetStatus.Draft)
                                        {
                                            <a class="me-2 p-1 edit-icon"
                                               href="javascript:void(0);"
                                               title="Edit"
                                               @onclick="() => OpenEditOffcanvas(a)"
                                               data-bs-toggle="offcanvas"
                                               data-bs-target="#createEditAssetOffcanvas">
                                                <i data-feather="edit"></i>
                                            </a>
                                        }
                                        <a class="me-2 p-1 delete-icon action-icon"
                                           href="javascript:void(0);"
                                           title="Delete"
                                           data-bs-toggle="modal"
                                           data-bs-target="#delete-modal"
                                           @onclick="() => DeletePopupOpen(a)">
                                            <i class="ti ti-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">No fixed assets found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (FilteredAssets.Count > 0)
        {
            <div class="d-flex align-items-center justify-content-between p-3">
                <div class="d-flex align-items-center fs-13">
                    <span class="me-2">Rows per page</span>
                    <select class="form-select form-select-sm" style="width:80px" @onchange="OnPageSizeChange">
                        <option value="5" selected="@(PageSize == 5)">5</option>
                        <option value="10" selected="@(PageSize == 10)">10</option>
                        <option value="25" selected="@(PageSize == 25)">25</option>
                        <option value="50" selected="@(PageSize == 50)">50</option>
                    </select>
                    <span class="ms-2">Entries</span>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="PreviousPage">
                                <i class="ti ti-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = StartPage; i <= EndPage; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                <a class="page-link" href="javascript:void(0);"
                                   @onclick="() => GoToPage(pageNum)">@pageNum</a>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0);" @onclick="NextPage">
                                <i class="ti ti-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }

    </div>

    @* Responsive Row Details Modal *@
    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Fixed Asset Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            style="padding:0;right:22px;position:absolute;transform:none"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2 d-flex gap-3"><strong>Category:</strong><div>@SelectedAsset?.CategoryName</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Branch:</strong><div>@SelectedAsset?.BranchName</div></div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Purchase Date:</strong>
                        <div>@(SelectedAsset?.PurchaseDate.HasValue == true ? SelectedAsset.PurchaseDate.Value.ToString("dd MMM yyyy") : "—")</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Depreciable:</strong>
                        @if (SelectedAsset != null)
                        {
                            @if (SelectedAsset.IsDepreciable)
                            {
                                <span class="badge bg-info-transparent">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-transparent">No</span>
                            }
                        }
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Status:</strong>
                        @if (SelectedAsset != null)
                        {
                            <span class="badge @GetStatusBadgeClass(SelectedAsset.AssetStatus)">
                                @GetStatusLabel(SelectedAsset.AssetStatus)
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Fixed Asset</h4>
                        <p class="text-gray-6 mb-0 fs-16">
                            @if (SelectedAsset?.AssetStatus == AssetStatus.Draft)
                            {
                                <span>Are you sure you want to delete <strong>@SelectedAsset?.AssetCode</strong>?</span>
                            }
                            else
                            {
                                <span class="text-danger">Only Draft assets can be deleted.</span>
                            }
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button"
                                    class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4"
                                    data-bs-dismiss="modal">
                                <i class="ti ti-x me-1"></i>Cancel
                            </button>
                            @if (SelectedAsset?.AssetStatus == AssetStatus.Draft)
                            {
                                <button class="btn btn-danger"
                                        @onclick="() => ConfirmDelete(SelectedAsset!.FixedAssetId)"
                                        data-bs-dismiss="modal">
                                    <i class="ti ti-trash me-1"></i>Yes, Delete
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-secondary" disabled>Cannot Delete Active Asset</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


<!-- ═══════════════════════════════════════════════════
     VIEW FIXED ASSET OFFCANVAS
     ═══════════════════════════════════════════════════ -->
<div class="offcanvas offcanvas-end offcanvas-view" tabindex="-1"
     id="viewAssetOffcanvas"
     data-bs-backdrop="true" data-bs-scroll="false">

    @if (SelectedAsset != null)
    {
        <div class="offcanvas-header">
            <div class="oc-avatar">
                @SelectedAsset.AssetCode?.Substring(0, Math.Min(2, SelectedAsset.AssetCode?.Length ?? 0)).ToUpper()
            </div>
            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@SelectedAsset.AssetName</h5>
                    <span class="badge @GetStatusBadgeClass(SelectedAsset.AssetStatus)">
                        @GetStatusLabel(SelectedAsset.AssetStatus)
                    </span>
                </div>
                <p class="oc-header-sub">
                    @SelectedAsset.AssetCode
                    @if (!string.IsNullOrWhiteSpace(SelectedAsset.CategoryName))
                    {
                        <span> · @SelectedAsset.CategoryName</span>
                    }
                </p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body">
            <div class="oc-summary-row">
                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value">@SelectedAsset.AssetCode</div>
                    <div class="oc-summary-label">Code</div>
                </div>
                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value">₹@SelectedAsset.PurchaseCost.ToString("N0")</div>
                    <div class="oc-summary-label">Purchase Cost</div>
                </div>
                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value">
                        @(SelectedAsset.NetBookValue.HasValue ? "₹" + SelectedAsset.NetBookValue.Value.ToString("N0") : "—")
                    </div>
                    <div class="oc-summary-label">Net Book Value</div>
                </div>
            </div>

            <div class="oc-card">
                <div class="oc-card-header text-primary">
                    <i class="ti ti-id"></i>
                    <h6 class="oc-card-title text-primary">Core Identity</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-grid">
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-tag"></i> Asset Code</div>
                            <div class="oc-field-value">@(SelectedAsset.AssetCode ?? "—")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-writing"></i> Asset Name</div>
                            <div class="oc-field-value">@(SelectedAsset.AssetName ?? "—")</div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-category"></i> Category</div>
                            <div class="oc-field-value">
                                @if (!string.IsNullOrWhiteSpace(SelectedAsset.CategoryName))
                                {
                                    <span class="badge bg-purple-transparent text-purple">@SelectedAsset.CategoryName</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-box"></i> Asset Type</div>
                            <div class="oc-field-value">@(SelectedAsset.AssetType ?? "—")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="oc-card">
                <div class="oc-card-header text-primary">
                    <i class="ti ti-barcode"></i>
                    <h6 class="oc-card-title text-primary">Identity & Tagging</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-grid">
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-scan"></i> Asset Tag</div>
                            <div class="oc-field-value">
                                @if (!string.IsNullOrWhiteSpace(SelectedAsset.AssetTag))
                                {
                                    <span class="badge bg-info-transparent text-info">@SelectedAsset.AssetTag</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </div>
                        </div>
                        <div class="oc-grid-item">
                            <div class="oc-field-label"><i class="ti ti-123"></i> Serial Number</div>
                            <div class="oc-field-value">
                                @if (!string.IsNullOrWhiteSpace(SelectedAsset.SerialNumber))
                                {
                                    <span class="badge bg-info-transparent text-info">@SelectedAsset.SerialNumber</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="oc-card">
                <div class="oc-card-header text-primary">
                    <i class="ti ti-building"></i>
                    <h6 class="oc-card-title text-primary">Ownership & Assignment</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-building-skyscraper"></i> Branch</span>
                            <span class="oc-list-value">@(string.IsNullOrWhiteSpace(SelectedAsset.BranchName) ? "—" : SelectedAsset.BranchName)</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-map-pin"></i> Location</span>
                            <span class="oc-list-value">@(string.IsNullOrWhiteSpace(SelectedAsset.Location) ? "—" : SelectedAsset.Location)</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-user"></i> Custodian</span>
                            <span class="oc-list-value">@(string.IsNullOrWhiteSpace(SelectedAsset.Custodian) ? "—" : SelectedAsset.Custodian)</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="oc-card">
                <div class="oc-card-header text-primary">
                    <i class="ti ti-cash"></i>
                    <h6 class="oc-card-title text-primary">Capitalization & Cost</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-calendar"></i> Purchase Date</span>
                            <span class="oc-list-value">@(SelectedAsset.PurchaseDate?.ToString("dd MMM yyyy") ?? "—")</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-coin"></i> Purchase Cost</span>
                            <span class="oc-list-value">₹@SelectedAsset.PurchaseCost.ToString("N2")</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-receipt"></i> Salvage Value</span>
                            <span class="oc-list-value">@(SelectedAsset.SalvageValue.HasValue ? "₹" + SelectedAsset.SalvageValue.Value.ToString("N2") : "—")</span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-calculator"></i> Net Book Value</span>
                            <span class="oc-list-value">@(SelectedAsset.NetBookValue.HasValue ? "₹" + SelectedAsset.NetBookValue.Value.ToString("N2") : "—")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="oc-card">
                <div class="oc-card-header text-primary">
                    <i class="ti ti-chart-line"></i>
                    <h6 class="oc-card-title text-primary">Depreciation Setup</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-percentage"></i> Depreciable</span>
                            <span class="oc-list-value">
                                @if (SelectedAsset.IsDepreciable)
                                {
                                    <span class="oc-dot-badge db-green"><span class="dot"></span> Yes</span>
                                }
                                else
                                {
                                    <span class="oc-dot-badge db-red"><span class="dot"></span> No</span>
                                }
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-clock"></i> Useful Life</span>
                            <span class="oc-list-value">@(SelectedAsset.UsefulLifeMonths.HasValue ? $"{SelectedAsset.UsefulLifeMonths} Months" : "—")</span>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(SelectedAsset.Notes))
            {
                <div class="oc-card">
                    <div class="oc-card-header text-primary">
                        <i class="ti ti-notes"></i>
                        <h6 class="oc-card-title text-primary">Notes</h6>
                    </div>
                    <div class="oc-card-body">
                        <div class="oc-list">
                            <div class="oc-list-row">
                                <span class="oc-list-value" style="white-space:pre-line;">@SelectedAsset.Notes</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (SelectedAsset.AssetStatus == AssetStatus.Disposed && SelectedAsset.DisposedOn.HasValue)
            {
                <div class="oc-card">
                    <div class="oc-card-header text-primary">
                        <i class="ti ti-archive"></i>
                        <h6 class="oc-card-title text-primary">Lifecycle</h6>
                    </div>
                    <div class="oc-card-body">
                        <div class="oc-list">
                            <div class="oc-list-row">
                                <span class="oc-list-label"><i class="ti ti-calendar-x"></i> Disposed On</span>
                                <span class="oc-list-value">@SelectedAsset.DisposedOn.Value.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="oc-card">
                <div class="oc-card-header text-primary">
                    <i class="ti ti-clock-record"></i>
                    <h6 class="oc-card-title text-primary">Status & Audit</h6>
                </div>
                <div class="oc-card-body">
                    <div class="oc-list">
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-toggle-right"></i> Status</span>
                            <span class="oc-list-value">
                                <span class="badge @GetStatusBadgeClass(SelectedAsset.AssetStatus)">
                                    <span class="dot"></span> @GetStatusLabel(SelectedAsset.AssetStatus)
                                </span>
                            </span>
                        </div>
                        <div class="oc-list-row">
                            <span class="oc-list-label"><i class="ti ti-calendar-plus"></i> Created At</span>
                            <span class="oc-list-value">@SelectedAsset.CreatedAt.ToString("dd-MMM-yyyy")</span>
                        </div>
                        @if (SelectedAsset.UpdatedAt.HasValue)
                        {
                            <div class="oc-list-row">
                                <span class="oc-list-label"><i class="ti ti-calendar-event"></i> Updated At</span>
                                <span class="oc-list-value">@SelectedAsset.UpdatedAt.Value.ToString("dd-MMM-yyyy")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    }
</div>


<!-- ═══════════════════════════════════════════════════════════════
     CREATE / EDIT FIXED ASSET OFFCANVAS  —  PROFESSIONAL WIZARD
     ═══════════════════════════════════════════════════════════════ -->

<style>
    /* ── Offcanvas Shell ─────────────────────────────────────────── */
    #createEditAssetOffcanvas {
        width: min(480px, 100vw) !important;
        box-shadow: -6px 0 32px rgba(0,0,0,0.10);
        border-left: none;
    }

    /* ── Header Band ─────────────────────────────────────────────── */
    .fa-oc-header {
        background: linear-gradient( 337deg, var(--primary) 0%, #1a3a6e -21%);
        padding: 20px 22px 18px 22px;
        flex-shrink: 0;
    }

        .fa-oc-header .fa-hdr-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
        }

        .fa-oc-header .fa-mode-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(255,255,255,0.18);
            border: 1px solid rgba(255,255,255,0.28);
            border-radius: 20px;
            padding: 3px 10px;
            font-size: 10.5px;
            font-weight: 700;
            color: rgba(255,255,255,0.92);
            letter-spacing: 0.6px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .fa-oc-header h4 {
            color: #fff;
            font-size: 17px;
            font-weight: 700;
            margin: 0 0 3px 0;
        }

        .fa-oc-header p {
            color: rgba(255,255,255,0.62);
            font-size: 12px;
            margin: 0;
        }

    .fa-hdr-close {
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.25);
        color: white;
        border-radius: 8px;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 15px;
        flex-shrink: 0;
        margin-left: 8px;
        transition: background 0.15s;
    }

        .fa-hdr-close:hover {
            background: rgba(255,255,255,0.28);
        }

    /* ── Accordion Section Header ────────────────────────────────── */
    .fa-sec-hdr {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 20px;
        cursor: pointer;
        background: white;
        border-bottom: 0.5px solid #eaeef4;
        user-select: none;
        transition: background 0.15s;
        position: relative;
    }

        .fa-sec-hdr:hover {
            background: #fafbfd;
        }

        .fa-sec-hdr.open {
            background: white;
        }

        /* ── Error state for section header ─────────────────────── */
        .fa-sec-hdr.has-error {
            border-left: 3px solid #e53e3e;
            background: #fff8f8;
        }

            .fa-sec-hdr.has-error:hover {
                background: #fff0f0;
            }

    /* ── Section Icon ────────────────────────────────────────────── */
    .fa-sec-ico {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

        .fa-sec-ico.c-orange {
            background: #fff4e6;
            color: #e8590c;
        }

        .fa-sec-ico.c-blue {
            background: #e7f5ff;
            color: #1971c2;
        }

        .fa-sec-ico.c-green {
            background: #ebfbee;
            color: #2f9e44;
        }

        .fa-sec-ico.c-teal {
            background: #e3fafc;
            color: #0c8599;
        }

        .fa-sec-ico.c-red {
            background: #fff5f5;
            color: #c92a2a;
        }

    /* ── Section Text ────────────────────────────────────────────── */
    .fa-sec-meta {
        flex: 1;
        min-width: 0;
    }

        .fa-sec-meta .sec-title {
            font-size: 13px;
            font-weight: 700;
            color: #1e2435;
            display: block;
            line-height: 1.3;
        }

        .fa-sec-meta .sec-sub {
            font-size: 11px;
            color: #9aa3b8;
            display: block;
            margin-top: 1px;
        }

    /* ── Error dot on section title ─────────────────────────────── */
    .fa-err-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        background: #e53e3e;
        border-radius: 50%;
        margin-left: 6px;
        vertical-align: middle;
        animation: errPulse 1.4s ease-in-out infinite;
    }

    @@keyframes errPulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.5;
            transform: scale(0.75);
        }
    }

    /* ── Expand/Collapse Arrow ───────────────────────────────────── */
    .fa-sec-arrow {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #f1f4f9;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 14px;
        color: #8a96b0;
        transition: transform 0.25s ease, background 0.2s, color 0.2s;
    }

    .fa-sec-hdr.open .fa-sec-arrow {
        transform: rotate(180deg);
        background: #e7f5ff;
        color: #1971c2;
    }

    /* ── Section Body ────────────────────────────────────────────── */
    .fa-sec-body {
        display: none;
        padding: 16px 20px 4px 20px;
        background: white;
        border-bottom: 0.5px solid #eaeef4;
        margin-bottom: 14px;
    }

        .fa-sec-body.open {
            display: block;
        }

    /* ── Fields ──────────────────────────────────────────────────── */
    .fa-field {
        margin-bottom: 14px;
    }

        .fa-field label {
            font-size: 11.5px;
            font-weight: 600;
            color: #4a5568;
            display: block;
            margin-bottom: 5px;
            text-transform: none;
            letter-spacing: 0;
        }

        .fa-field .form-control.is-invalid,
        .fa-field .form-select.is-invalid {
            border-color: #e53e3e;
        }

        .fa-field .hint-text {
            font-size: 11px;
            color: #9aa3b8;
            margin-top: 4px;
        }

        .fa-field .invalid-feedback {
            display: block;
            font-size: 11.5px;
            color: #e53e3e;
            margin-top: 4px;
        }

    .req {
        color: #e53e3e;
        margin-left: 2px;
    }

    /* ── Input group ₹ prefix ────────────────────────────────────── */
    .fa-inr-wrap {
        display: flex;
        align-items: stretch;
    }

        .fa-inr-wrap .inr-sym {
            display: flex;
            align-items: center;
            padding: 0 10px;
            background: #f1f4f9;
            border: 1.5px solid #e2e8f0;
            border-right: none;
            border-radius: 8px 0 0 8px;
            font-size: 13px;
            font-weight: 700;
            color: #4a5568;
        }

        .fa-inr-wrap .form-control {
            border-radius: 0 8px 8px 0 !important;
        }

    /* ── Threshold Alert ─────────────────────────────────────────── */
    .fa-threshold {
        border-radius: 9px;
        padding: 10px 13px;
        font-size: 12px;
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-bottom: 14px;
    }

        .fa-threshold.warn {
            background: #fffbeb;
            border: 1px solid #fcd34d;
            color: #92400e;
        }

        .fa-threshold.ok {
            background: #f0fdf4;
            border: 1px solid #86efac;
            color: #166534;
        }

        .fa-threshold i {
            font-size: 17px;
            flex-shrink: 0;
            margin-top: 1px;
        }

    /* ── Toggle Card (Depreciable) ───────────────────────────────── */
    .fa-toggle-card {
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: white;
        transition: border-color 0.2s, background 0.2s;
        margin-bottom: 14px;
    }

        .fa-toggle-card.is-on {
            border-color: var(--primary);
            background: color-mix(in srgb, var(--primary) 8%, white);
        }

        .fa-toggle-card .tc-label {
            font-size: 13px;
            font-weight: 600;
            color: #1e2435;
        }

        .fa-toggle-card .tc-sub {
            font-size: 11px;
            color: #9aa3b8;
            margin-top: 2px;
        }

        .fa-toggle-card .form-check-input {
            width: 38px;
            height: 21px;
            cursor: pointer;
            flex-shrink: 0;
        }

    /* ── Footer ──────────────────────────────────────────────────── */
    .fa-oc-footer {
        border-top: 1px solid #eaeef4;
        padding: 13px 20px;
        display: flex;
        gap: 10px;
        background: white;
        flex-shrink: 0;
    }

    .fa-btn-cancel {
        flex: 1;
        padding: 9px 0;
        border: 1.5px solid #d1d8e6;
        background: white;
        color: #4a5568;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

        .fa-btn-cancel:hover {
            border-color: #8a96b0;
            color: #1e2435;
        }

    .fa-btn-save {
        flex: 2;
        padding: 9px 0;
        background: var(--primary, #5c67f2);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: opacity 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
    }

        .fa-btn-save:hover {
            opacity: 0.9;
        }

        .fa-btn-save.is-edit {
            background: #2f9e44;
        }

    /* ── Validation summary bar ──────────────────────────────────── */
    .fa-val-summary {
        background: #fff5f5;
        border-bottom: 1px solid #fed7d7;
        padding: 10px 20px;
        font-size: 12px;
        color: #c53030;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

        .fa-val-summary i {
            font-size: 16px;
            flex-shrink: 0;
        }
</style>


<div class="offcanvas offcanvas-end offcanvas-view" tabindex="-1"
     id="createEditAssetOffcanvas"
     data-bs-backdrop="static" data-bs-scroll="false">

    <!-- ── Header ──────────────────────────────────────────────── -->
    <div class="fa-oc-header">
        <div class="oc-title-row">
            <div>
                <h4>@(FormIsEdit ? "Edit Fixed Asset" : "Create Fixed Asset")</h4>
                <p>@(FormIsEdit ? "Update the asset details below" : "Fill in the details to register a new asset")</p>
            </div>
        </div>
    </div>

    <!-- ── Body ────────────────────────────────────────────────── -->
    <div class="offcanvas-body p-0 d-flex flex-column" style="overflow:hidden; flex:1;">

        @if (FormAsset != null && FormEditContext != null)
        {
            <EditForm EditContext="FormEditContext" OnSubmit="FormSave"
                      style="display:flex;flex-direction:column;flex:1;overflow:hidden;">

                <!-- ── Validation summary (shows after first submit attempt) ── -->
                @if (_formSubmitted && FormHasAnyError())
                {
                    <div class="fa-val-summary">
                        <i class="ti ti-alert-circle"></i>
                        <span>Please fix the highlighted errors before saving.</span>
                    </div>
                }

                <!-- Accordion list (scrollable) -->
                <div style="flex:1; overflow-y:auto;">

                    <!-- ══ Section 1: Core Identity ══════════════════════ -->
                    <div class="fa-sec-hdr open @(FormSectionHasError(1) ? "has-error" : "")"
                         onclick="this.classList.toggle('open'); this.nextElementSibling.classList.toggle('open');">
                        <div class="fa-sec-ico c-orange"><i class="ti ti-id-badge-2" style="font-size: 20px;"></i></div>
                        <div class="fa-sec-meta">
                            <span class="sec-title">
                                Core Identity
                                @if (FormSectionHasError(1))
                                {
                                    <span class="fa-err-dot" title="This section has errors"></span>
                                }
                            </span>
                            <span class="sec-sub">Asset code, name, category, status</span>
                        </div>
                        <div class="fa-sec-arrow"><i class="ti ti-chevron-down"></i></div>
                    </div>
                    <div class="fa-sec-body open @(FormSectionHasError(1) ? "open" : "")">
                        <div class="row g-0">
                            <div class="col-md-6 pe-md-2">
                                <div class="fa-field">
                                    <label>Asset Code</label>
                                    <InputText class="form-control fa-code-field"
                                               @bind-Value="FormAsset.AssetCode"
                                               placeholder="Auto-generated"
                                               maxlength="50" disabled />
                                    <div class="hint-text"><i class="ti ti-info-circle me-1"></i>Auto-generated on save</div>
                                </div>
                            </div>
                            <div class="col-md-6 ps-md-2">
                                <div class="fa-field">
                                    <label>Asset Name <span class="req">*</span></label>
                                    <InputText class="@($"form-control {(FormShowError(1, "AssetName") ? "is-invalid" : "")}")"
                                               @bind-Value="FormAsset.AssetName"
                                               @oninput="e => FormAsset.AssetName = e.Value?.ToString() ?? string.Empty"
                                               placeholder="e.g., Dell Laptop i7"
                                               maxlength="150" />
                                    @if (FormShowError(1, "AssetName"))
                                    {
                                        <div class="invalid-feedback">Asset Name is required</div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6 pe-md-2">
                                <div class="fa-field">
                                    <label>Asset Category <span class="req">*</span></label>
                                    <select class="@($"form-select {(FormShowError(1, "AssetCategoryId") ? "is-invalid" : "")}")"
                                            value="@FormAsset.AssetCategoryId"
                                            @onchange="OnFormCategoryChanged">
                                        <option value="@Guid.Empty">— Select Category —</option>
                                        @foreach (var cat in CategoryList)
                                        {
                                            <option value="@cat.Value">@cat.Text</option>
                                        }
                                    </select>
                                    @if (FormShowError(1, "AssetCategoryId"))
                                    {
                                        <div class="invalid-feedback">Asset Category is required</div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6 ps-md-2">
                                <div class="fa-field">
                                    <label>Status <span class="req">*</span></label>
                                    <InputSelect class="form-select" @bind-Value="FormAsset.Status"
                                                 disabled="@(FormIsEdit && FormAsset.Status == FA.AssetStatus.Disposed)">
                                        <option value="@FA.AssetStatus.Draft">Draft</option>
                                        <option value="@FA.AssetStatus.Active">Active</option>
                                        <option value="@FA.AssetStatus.Inactive">Inactive</option>
                                        @if (FormIsEdit)
                                        {
                                            <option value="@FA.AssetStatus.Disposed">Disposed</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ══ Section 2: Identity & Tagging ════════════════ -->
                    <div class="fa-sec-hdr @(FormSectionHasError(2) ? "open has-error" : "")"
                         onclick="this.classList.toggle('open'); this.nextElementSibling.classList.toggle('open');">
                        <div class="fa-sec-ico c-blue"><i class="ti ti-barcode" style="font-size: 20px;"></i></div>
                        <div class="fa-sec-meta">
                            <span class="sec-title">
                                Identity & Tagging
                                @if (FormSectionHasError(2))
                                {
                                    <span class="fa-err-dot" title="This section has errors"></span>
                                }
                            </span>
                            <span class="sec-sub">Asset tag, serial number, location, custodian</span>
                        </div>
                        <div class="fa-sec-arrow"><i class="ti ti-chevron-down"></i></div>
                    </div>
                    <div class="fa-sec-body @(FormSectionHasError(2) ? "open" : "")">
                        <div class="row g-0">
                            <div class="col-md-6 pe-md-2">
                                <div class="fa-field">
                                    <label>
                                        Asset Tag / Barcode
                                        @if (FormIsAssetTagRequired)
                                        {
                                            <span class="req">*</span>
                                        }
                                    </label>
                                    <InputText class="@($"form-control {(FormShowError(2, "AssetTag") ? "is-invalid" : "")}")"
                                               @bind-Value="FormAsset.AssetTag"
                                               @oninput="e => FormAsset.AssetTag = e.Value?.ToString()?.ToUpper() ?? string.Empty"
                                               placeholder="e.g., TAG-001"
                                               maxlength="100" />
                                    @if (FormShowError(2, "AssetTag"))
                                    {
                                        <div class="invalid-feedback">Asset Tag is required for this category</div>
                                    }
                                    else
                                    {
                                        <div class="hint-text"><i class="ti ti-fingerprint me-1"></i>Must be unique per company</div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6 ps-md-2">
                                <div class="fa-field">
                                    <label>
                                        Serial Number
                                        @if (FormIsSerialNumberRequired)
                                        {
                                            <span class="req">*</span>
                                        }
                                    </label>
                                    <InputText class="@($"form-control {(FormShowError(2, "SerialNumber") ? "is-invalid" : "")}")"
                                               @bind-Value="FormAsset.SerialNumber"
                                               @oninput="e => FormAsset.SerialNumber = e.Value?.ToString()?.ToUpper() ?? string.Empty"
                                               placeholder="e.g., SN-DELL-001"
                                               maxlength="100" />
                                    @if (FormShowError(2, "SerialNumber"))
                                    {
                                        <div class="invalid-feedback">Serial Number is required for this category</div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6 pe-md-2">
                                <div class="fa-field">
                                    <label>Location</label>
                                    <InputText class="form-control"
                                               @bind-Value="FormAsset.Location"
                                               placeholder="e.g., Floor 2 – IT Room"
                                               maxlength="150" />
                                </div>
                            </div>
                            <div class="col-md-6 ps-md-2">
                                <div class="fa-field">
                                    <label>Custodian</label>
                                    <InputText class="form-control"
                                               @bind-Value="FormAsset.Custodian"
                                               placeholder="e.g., Ramesh Kumar"
                                               maxlength="150" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ══ Section 3: Ownership & Assignment ════════════ -->
                    <div class="fa-sec-hdr"
                         onclick="this.classList.toggle('open'); this.nextElementSibling.classList.toggle('open');">
                        <div class="fa-sec-ico c-green"><i class="ti ti-building" style="font-size: 20px;"></i></div>
                        <div class="fa-sec-meta">
                            <span class="sec-title">Ownership & Assignment</span>
                            <span class="sec-sub">Branch, vendor</span>
                        </div>
                        <div class="fa-sec-arrow"><i class="ti ti-chevron-down"></i></div>
                    </div>
                    <div class="fa-sec-body">
                        <div class="row g-0">
                            <div class="col-md-6 pe-md-2">
                                <div class="fa-field">
                                    <label>Branch</label>
                                    <InputSelect class="form-select" @bind-Value="FormAsset.BranchId">
                                        <option value="">— Select Branch —</option>
                                        @foreach (var branch in BranchesList)
                                        {
                                            <option value="@branch.Id">@branch.BranchName</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="col-md-6 ps-md-2">
                                <div class="fa-field">
                                    <label>Vendor</label>
                                    <InputSelect class="form-select" @bind-Value="FormAsset.VendorId">
                                        <option value="">— Select Vendor —</option>
                                        @foreach (var vendor in AllVendors)
                                        {
                                            <option value="@vendor.Id">@vendor.VendorName</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ══ Section 4: Capitalization & Cost ═════════════ -->
                    <div class="fa-sec-hdr @(FormSectionHasError(4) ? "open has-error" : "")"
                         onclick="this.classList.toggle('open'); this.nextElementSibling.classList.toggle('open');">
                        <div class="fa-sec-ico c-teal"><i class="ti ti-cash" style="font-size: 20px;"></i></div>
                        <div class="fa-sec-meta">
                            <span class="sec-title">
                                Capitalization & Cost
                                @if (FormSectionHasError(4))
                                {
                                    <span class="fa-err-dot" title="This section has errors"></span>
                                }
                            </span>
                            <span class="sec-sub">Purchase date, cost, salvage value</span>
                        </div>
                        <div class="fa-sec-arrow"><i class="ti ti-chevron-down"></i></div>
                    </div>
                    <div class="fa-sec-body @(FormSectionHasError(4) ? "open" : "")">
                        <div class="row g-0">
                            <div class="col-md-6 pe-md-2">
                                <div class="fa-field">
                                    <label>Purchase Date <span class="req">*</span></label>
                                    <InputDate class="@($"form-control {(FormShowError(4, "PurchaseDate") ? "is-invalid" : "")}")"
                                               @bind-Value="FormAsset.PurchaseDate"
                                               max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                               disabled="@(FormIsEdit && FormAsset.Status != FA.AssetStatus.Draft)" />
                                    @if (FormShowError(4, "PurchaseDate"))
                                    {
                                        <div class="invalid-feedback">Purchase Date is required</div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6 ps-md-2">
                                <div class="fa-field">
                                    <label>Purchase Cost <span class="req">*</span></label>
                                    <div class="fa-inr-wrap">
                                        <span class="inr-sym">₹</span>
                                        <input type="number"
                                               class="@($"form-control {(FormShowError(4, "PurchaseCost") ? "is-invalid" : "")}")"
                                               value="@FormAsset.PurchaseCost"
                                               @onchange="OnFormPurchaseCostChanged"
                                               placeholder="0.00" min="0" step="0.01"
                                               disabled="@(FormIsEdit && FormAsset.Status != FA.AssetStatus.Draft)" />
                                    </div>
                                    @if (FormShowError(4, "PurchaseCost"))
                                    {
                                        @if (FormAsset.PurchaseCost <= 0)
                                        {
                                            <div class="hint-text" style="color:#e53e3e;">Cost must be greater than zero</div>
                                        }
                                        else if (FormSelectedCategory != null && FormAsset.PurchaseCost < FormSelectedCategory.CapitalizationThresholdAmount)
                                        {
                                            <div class="hint-text" style="color:#e53e3e;">Must be ≥ ₹@FormSelectedCategory.CapitalizationThresholdAmount.ToString("N0") to capitalize</div>
                                        }
                                    }
                                    @if (FormIsEdit && FormAsset.Status != FA.AssetStatus.Draft)
                                    {
                                        <div class="hint-text" style="color:#d97706;"><i class="ti ti-lock me-1"></i>Locked after activation</div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6 pe-md-2">
                                <div class="fa-field">
                                    <label>
                                        Salvage Value
                                        @if (FormSelectedCategory?.ResidualValuePercent.HasValue == true)
                                        {
                                            <span style="font-size:10px;color:#9aa3b8;font-weight:400;margin-left:4px;">
                                                (Auto: @FormSelectedCategory.ResidualValuePercent%)
                                            </span>
                                        }
                                    </label>
                                    <div class="fa-inr-wrap">
                                        <span class="inr-sym">₹</span>
                                        <InputNumber class="form-control"
                                                     @bind-Value="FormAsset.SalvageValue"
                                                     placeholder="0.00" />
                                    </div>
                                    <div class="hint-text">Residual value at end of useful life</div>
                                </div>
                            </div>

                            @if (FormSelectedCategory != null && FormAsset.PurchaseCost > 0)
                            {
                                <div class="col-12">
                                    @if (FormAsset.PurchaseCost < FormSelectedCategory.CapitalizationThresholdAmount)
                                    {
                                        <div class="fa-threshold warn">
                                            <i class="ti ti-alert-triangle"></i>
                                            <div>
                                                Cost <strong>₹@FormAsset.PurchaseCost.ToString("N2")</strong> is below the
                                                <strong>₹@FormSelectedCategory.CapitalizationThresholdAmount.ToString("N2")</strong>
                                                threshold for <em>@FormSelectedCategory.CategoryName</em>.
                                                This asset may need to be expensed instead.
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fa-threshold ok">
                                            <i class="ti ti-circle-check"></i>
                                            <div>
                                                Cost meets the
                                                <strong>₹@FormSelectedCategory.CapitalizationThresholdAmount.ToString("N2")</strong>
                                                threshold — this asset qualifies for capitalization.
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- ══ Section 5: Depreciation & Notes ══════════════ -->
                    <div class="fa-sec-hdr @(FormSectionHasError(5) ? "open has-error" : "")"
                         onclick="this.classList.toggle('open'); this.nextElementSibling.classList.toggle('open');">
                        <div class="fa-sec-ico c-red"><i class="ti ti-chart-line" style="font-size: 20px;"></i></div>
                        <div class="fa-sec-meta">
                            <span class="sec-title">
                                Depreciation & Notes
                                @if (FormSectionHasError(5))
                                {
                                    <span class="fa-err-dot" title="This section has errors"></span>
                                }
                            </span>
                            <span class="sec-sub">Depreciation schedule, useful life, notes</span>
                        </div>
                        <div class="fa-sec-arrow"><i class="ti ti-chevron-down"></i></div>
                    </div>
                    <div class="fa-sec-body @(FormSectionHasError(5) ? "open" : "")">

                        <div class="fa-toggle-card @(FormAsset.IsDepreciable ? "is-on" : "")">
                            <div>
                                <div class="tc-label">
                                    <i class="ti ti-chart-bar me-2" style="color:var(--primary);font-size:15px;"></i>
                                    Is Depreciable
                                </div>
                                <div class="tc-sub">
                                    @if (FormSelectedCategory != null)
                                    {
                                        @($"Category default: {(FormSelectedCategory.IsDepreciable ? "Yes" : "No")}")
                                    }
                                    else
                                    {
                                        @("Enable to configure depreciation schedule")
                                    }
                                </div>
                            </div>
                            <InputCheckbox class="form-check-input"
                                           @bind-Value="FormAsset.IsDepreciable"
                                           id="formIsDepreciable"
                                           style="width:23px;height:20px;" />
                        </div>

                        @if (FormAsset.IsDepreciable)
                        {
                            <div class="fa-field">
                                <label>Useful Life (Months) <span class="req">*</span></label>
                                <InputNumber class="@($"form-control {(FormShowError(5, "UsefulLifeMonths") ? "is-invalid" : "")}")"
                                             @bind-Value="FormAsset.UsefulLifeMonths"
                                             placeholder="e.g., 60" />
                                @if (FormShowError(5, "UsefulLifeMonths"))
                                {
                                    <div class="invalid-feedback">Useful Life must be greater than 0</div>
                                }
                                @if (FormSelectedCategory?.UsefulLifeMonths.HasValue == true)
                                {
                                    <div class="hint-text">
                                        <i class="ti ti-info-circle me-1"></i>
                                        Category default: @FormSelectedCategory.UsefulLifeMonths months
                                    </div>
                                }
                            </div>
                        }

                        <div class="fa-field">
                            <label>Notes</label>
                            <InputTextArea class="form-control"
                                           style="border-radius:9px; resize:vertical; min-height:88px;"
                                           @bind-Value="FormAsset.Notes"
                                           placeholder="Add any additional notes or remarks..."
                                           rows="4" maxlength="500" />
                            <div class="hint-text" style="text-align:right;">
                                @(500 - (FormAsset.Notes?.Length ?? 0)) characters remaining
                            </div>
                        </div>

                    </div>

                </div>
                @* end scrollable accordion *@

                <!-- ── Footer ────────────────────────────────────────── -->
                <div class="fa-oc-footer">
                    <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="offcanvas">
                        <i class="ti ti-x" style="font-size:14px;"></i> Cancel
                    </button>
                    <button type="button" class="btn btn-primary w-100 @(FormIsEdit ? "is-edit" : "")" @onclick="FormSave">
                        <i class="ti ti-device-floppy" style="font-size:15px;"></i>
                        @(FormIsEdit ? "Update" : "Create")
                    </button>
                </div>

            </EditForm>
        }

    </div>

</div>
