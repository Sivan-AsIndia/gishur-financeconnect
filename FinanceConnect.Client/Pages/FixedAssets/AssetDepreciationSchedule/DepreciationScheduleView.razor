@page "/depreciation-schedules/{Id:guid}/view"
@using FinanceConnect.Client.ViewModels
@inject IJSRuntime JS
@inject FinanceConnect.Client.Services.AssetDepreciationScheduleService scheduleService
@inject NavigationManager navigation



<style>
    .profile-list-card {
        position: relative;
    }

        .profile-list-card::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, #ff8a00 0%, #ff4ecd 35%, #5f6cff 70%, #00c6ff 100%);
        }
    .fc-prog-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .fc-prog-pct {
        font-size: 28px;
        font-weight: 800;
        color: var(--bs-body-color);
        line-height: 1;
        letter-spacing: -1px;
    }

    .fc-prog-counts {
        font-size: 11px;
        color: var(--bs-secondary-color);
    }

    .fc-track {
        display: flex;
        gap: 2px;
        height: 10px;
        border-radius: 6px;
        overflow: hidden;
    }

    .fc-seg {
        flex: 1;
        min-width: 2px;
        border-radius: 1px;
        cursor: default;
        transition: opacity .13s;
    }

        .fc-seg:hover {
            opacity: .6;
        }

    .fc-seg-on {
        background-color: #1D9E75;
    }

    .fc-seg-off {
        background-color: #E2E8F0;
    }

    .fc-track-legend {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        color: var(--bs-secondary-color);
        margin-top: 7px;
    }

    .fc-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .fc-dot-teal {
        background-color: #1D9E75;
    }

    .fc-dot-muted {
        background-color: #CBD5E1;
    }

    /* ── Slider Period Cards ── */
    .sched-period-card {
        min-width: 260px;
        max-width: 260px;
        flex-shrink: 0;
        border-radius: 14px;
        overflow: hidden;
        background: var(--bs-body-bg);
        border: 0.5px solid var(--bs-border-color);
    }

        .sched-period-card.spc-posted {
            border-top: 3px solid #1D9E75;
        }

        .sched-period-card.spc-pending {
            border-top: 3px solid #CBD5E1;
        }

    .spc-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 16px 16px 10px;
    }

        .spc-header.spc-header-posted {
            background: linear-gradient(135deg, rgba(29,158,117,0.08) 0%, transparent 80%);
        }
        .spc-header.spc-header-pending {
            background: linear-gradient(135deg, rgb(236 238 241) 0%, transparent 80%);
        }

    .spc-period-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--bs-body-color);
    }

    .spc-period-num {
        font-size: 11px;
        color: var(--bs-secondary-color);
        margin-top: 2px;
    }

    .spc-badge {
        font-size: 10px;
        padding: 3px 10px;
        border-radius: 20px;
        font-weight: 500;
    }

    .spc-badge-posted {
        background: rgba(29, 158, 117, 0.15);
        color: #0F6E56;
    }

    .spc-badge-pending {
        background: rgba(100, 116, 139, 0.12);
        color: var(--bs-secondary-color);
    }

    .spc-dates {
        font-size: 11px;
        color: var(--bs-secondary-color);
        padding: 0 16px 12px;
    }

    .spc-divider {
        height: 0.5px;
        background: var(--bs-border-color);
        margin: 0;
    }

    .spc-metrics {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
    }

    .spc-metric-cell {
        padding: 10px 14px;
        border-top: 0.5px solid var(--bs-border-color);
        border-right: 0.5px solid var(--bs-border-color);
    }

        .spc-metric-cell:nth-child(even) {
            border-right: none;
        }

    .spc-metric-label {
        font-size: 10px;
        color: var(--bs-secondary-color);
        margin-bottom: 3px;
    }

    .spc-metric-value {
        font-size: 13px;
        font-weight: 500;
        color: var(--bs-body-color);
        margin-top: 1px;
    }

    .spc-metric-green {
        color: #1D9E75 !important;
    }
</style>


@if (!isInitialized)
{
    <div class="page-loading-overlay"><div class="whirly-loader"></div></div>
}
else if (Item == null)
{
    <div class="content py-4">
        <div class="alert alert-danger"><i class="ti ti-alert-circle me-2"></i>Schedule not found. <a href="/depreciation-schedules" class="alert-link ms-2">Return to list</a></div>
    </div>
}
else
{
    <div class="content py-4 view-screen">

        <!-- PAGE TITLE ROW -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-1">Depreciation Schedule Details</h4>
                <p class="text-muted mb-0 small">Schedule record and period plan</p>
            </div>
            <div class="d-flex gap-2 page-btn">
                <a class="btn btn-outline-secondary" href="/depreciation-schedules">
                    <i class="ti ti-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>

        <div class="row g-4">

            <!-- ═══ HEADER PANEL ═══ -->
            <div class="col-lg-12">
                <div class="profile-list-card" style="background: linear-gradient(90deg, rgba(255, 138, 0, 0.10) 0%, rgba(255, 78, 205, 0.08) 35%, rgba(95, 108, 255, 0.08) 70%, rgba(0, 198, 255, 0.10) 100%);">
                    <div class="profile-left">
                        <div class="avatar letter-avatar">v@(Item.ScheduleVersion)</div>
                    </div>
                    <div class="profile-center">
                        <div class="top-row"><h5>@Item.ScheduleNumber</h5></div>
                        <div class="sub-text">
                            <span class="d-flex gap-1 mt-1">
                                <i class="ti ti-box"></i>
                                @Item.AssetNameDisplay &nbsp;·&nbsp; @Item.AssetCodeDisplay
                            </span>
                            <span class="d-flex gap-1 mt-1">
                                <i class="ti ti-calendar"></i>
                                @Item.MethodTypeSnapshot &nbsp;·&nbsp; @Item.UsefulLifeMonthsSnapshot months
                            </span>
                        </div>
                        <div class="mt-2">
                            <span class="badge @GetStatusBadgeClass(Item.ScheduleStatus)">@Item.ScheduleStatus</span>
                            @if (Item.IsFullyPosted)
                            {
                                <span class="badge bg-success-transparent ms-1">Fully Posted</span>
                            }
                            @if (Item.SupersededByScheduleId.HasValue)
                            {
                                <span class="badge bg-warning-transparent ms-1">Superseded</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ═══ LEFT PANEL (col-8) ═══ -->
            <div class="col-lg-8">
                <div class="profile-card" style="height: 100% !important;">

                    <!-- Depreciation Input Snapshot -->
                    <div class="card mb-0">
                        <div class="card-header py-2"><i class="ti ti-camera me-2"></i> Depreciation Input Snapshot</div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-4 mb-2"><small class="text-muted">Asset</small><div class="fw-medium">@Item.AssetCodeDisplay – @Item.AssetNameDisplay</div></div>
                                <div class="col-md-4 mb-2"><small class="text-muted">Method</small><div>@Item.MethodNameDisplay</div></div>
                                <div class="col-md-4 mb-2"><small class="text-muted">Method Type</small><div>@Item.MethodTypeSnapshot</div></div>
                                <div class="col-md-4 mb-2"><small class="text-muted">Input Mode</small><div>@Item.InputModeSnapshot</div></div>
                                @if (Item.RatePercentSnapshot.HasValue)
                                {
                                    <div class="col-md-4 mb-2"><small class="text-muted">Rate %</small><div>@Item.RatePercentSnapshot.Value.ToString("N3")%</div></div>
                                }
                                <div class="col-md-4 mb-2"><small class="text-muted">Useful Life</small><div>@Item.UsefulLifeMonthsSnapshot months</div></div>
                                <div class="col-md-4 mb-2"><small class="text-muted">Residual %</small><div>@Item.ResidualValuePercentSnapshot.ToString("N3")%</div></div>
                                <div class="col-md-4 mb-2"><small class="text-muted">Depreciation Base</small><div class="fw-medium">@Item.DepreciationBaseAmountSnapshot.ToString("N2")</div></div>
                                <div class="col-md-4 mb-2"><small class="text-muted">Start Date</small><div>@Item.StartDate.ToString("dd MMM yyyy")</div></div>
                                <div class="col-md-4 mb-2"><small class="text-muted">End Date</small><div>@Item.EndDate.ToString("dd MMM yyyy")</div></div>
                                <div class="col-md-4 mb-2"><small class="text-muted">Start Convention</small><div>@Item.DepreciationStartConventionSnapshot</div></div>
                            </div>
                        </div>
                    </div>

                    <!-- Monthly Schedule Lines -->
                    <div class="card mb-0 mt-3">
                        <div class="card-header py-2 d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2 mb-3">
                            <span><i class="ti ti-layout-cards me-2"></i> Monthly Schedule Lines (@FilteredLines.Count() periods)</span>
                            <div class="d-flex align-items-center gap-2">
                                <div class="btn-group btn-group-sm gap-0">
                                    <button class="btn @(ShowFilter == "" ? "btn-success" : "btn-outline-secondary")" @onclick='() => { ShowFilter = ""; SliderOffset = 0; }'>All</button>
                                    <button class="btn @(ShowFilter == "posted" ? "btn-success" : "btn-outline-secondary")" @onclick='() => { ShowFilter = "posted"; SliderOffset = 0; }'>Posted</button>
                                    <button class="btn @(ShowFilter == "unposted" ? "btn-success" : "btn-outline-secondary")" @onclick='() => { ShowFilter = "unposted"; SliderOffset = 0; }'>Pending</button>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="SlidePrev" disabled="@(SliderOffset <= 0)">
                                        <i class="ti ti-chevron-left"></i>
                                    </button>
                                    <small class="text-muted px-1" style="min-width:52px;text-align:center">@SliderPage / @SliderTotalPages</small>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="SlideNext" disabled="@(SliderOffset >= SliderMax)">
                                        <i class="ti ti-chevron-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Summary chips -->
                        <div class="d-flex gap-2 px-3 py-2 border-bottom" style="flex-wrap:wrap">
                            <span class="badge bg-secondary-transparent text-secondary">Total: @Item.ScheduleLines.Count</span>
                            <span class="badge bg-success-transparent">Posted: @Item.ScheduleLines.Count(l => l.IsPosted)</span>
                            <span class="badge bg-warning-transparent">Pending: @Item.ScheduleLines.Count(l => !l.IsPosted)</span>
                            <span class="badge bg-info-transparent">Progress: @PostedPercent%</span>
                        </div>

                        <!-- Slider cards -->
                        <div class="card-body mt-3" style="overflow:hidden">
                            <div style="display:flex;gap:12px;transition:transform .35s ease;transform:translateX(-@(SliderOffset * 272)px)">
                                @foreach (var line in FilteredLines)
                                {
                                    <div class="sched-period-card @(line.IsPosted ? "spc-posted" : "spc-pending")">
                                        <div class="spc-header @(line.IsPosted ? "spc-header-posted" : "spc-header-pending")">
                                            <div>
                                                <div class="spc-period-label">@line.PeriodLabel</div>
                                                <div class="spc-period-num">Period #@line.LineNumber</div>
                                            </div>
                                            @if (line.IsPosted)
                                            {
                                                <span class="badge spc-badge-posted">Posted</span>
                                            }
                                            else
                                            {
                                                <span class="badge spc-badge-pending">Pending</span>
                                            }
                                        </div>
                                        <div class="spc-dates">
                                            @line.PeriodStartDate.ToString("dd MMM yyyy") &rarr; @line.PeriodEndDate.ToString("dd MMM yyyy")
                                        </div>
                                        <div class="spc-divider"></div>
                                        <div class="spc-metrics">
                                            <div class="spc-metric-cell">
                                                <div class="spc-metric-label">Planned Dep.</div>
                                                <div class="spc-metric-value">@line.PlannedDepreciationAmount.ToString("N2")</div>
                                            </div>
                                            <div class="spc-metric-cell">
                                                <div class="spc-metric-label">Accum. Dep.</div>
                                                <div class="spc-metric-value">@line.PlannedAccumulatedDepreciationAmount.ToString("N2")</div>
                                            </div>
                                            <div class="spc-metric-cell">
                                                <div class="spc-metric-label">Planned NBV</div>
                                                <div class="spc-metric-value spc-metric-green">@line.PlannedNetBookValueAmount.ToString("N2")</div>
                                            </div>
                                            <div class="spc-metric-cell">
                                                <div class="spc-metric-label">Lock</div>
                                                <span class="badge @GetLockBadgeClass(line.LockStatus)" style="font-size:10px">@line.LockStatus</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Dots -->
                            <div class="d-flex justify-content-center gap-1 mt-4 mb-4 flex-wrap">
                                @for (int i = 0; i < SliderTotalPages; i++)
                                {
                                    var pg = i;
                                    <div @onclick="() => { SliderOffset = pg * VisibleCards; }"
                                         style="width:@(SliderPage - 1 == i ? "18px" : "6px");height:6px;border-radius:3px;cursor:pointer;
                                                        background:@(SliderPage - 1 == i ? "#1D9E75" : "var(--bs-border-color)");transition:all .2s">
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ═══ RIGHT PANEL (col-4) ═══ -->
            <div class="col-lg-4">
                <div class="profile-card">

                    <!-- Posting Progress -->
                    <div class="card mb-0">
                        <div class="card-header py-2"><i class="ti ti-chart-bar me-2"></i> Posting Progress</div>
                        <div class="card-body py-2">
                        
                            <div class="mb-2">
                                <small class="text-muted">Total Planned</small>
                                <div class="fw-bold">@Item.TotalPlannedDepreciationAmount.ToString("N2")</div>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">Total Posted</small>
                                <div class="fw-bold text-success">@Item.TotalPostedDepreciationAmount.ToString("N2")</div>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">Remaining</small>
                                <div class="fw-bold text-warning">@((Item.TotalPlannedDepreciationAmount - Item.TotalPostedDepreciationAmount).ToString("N2"))</div>
                            </div>

                            @if (Item.ScheduleLines.Any())
                            {
                                var postedCount = Item.ScheduleLines.Count(l => l.IsPosted);
                                var totalCount = Item.ScheduleLines.Count;
                                var remaining = totalCount - postedCount;
                                var postedPct = totalCount > 0
                                ? (int)((double)postedCount / totalCount * 100) : 0;

                                <div class="fc-prog-header">
                                    <span class="fc-prog-pct">@postedPct<span class="fc-prog-sym">%</span></span>
                                    <span class="fc-prog-counts">@postedCount posted &nbsp;·&nbsp; @remaining remaining</span>
                                </div>

                                <div class="fc-track">
                                    @for (int i = 0; i < totalCount; i++)
                                    {
                                        var line = Item.ScheduleLines[i];
                                        <div class="fc-seg @(line.IsPosted ? "fc-seg-on" : "fc-seg-off")"
                                             title="@line.PeriodLabel – @(line.IsPosted ? "Posted" : "Pending")">
                                        </div>
                                    }
                                </div>

                                <div class="fc-track-legend">
                                    <span class="fc-dot fc-dot-teal"></span><span>Posted</span>
                                    <span class="fc-dot fc-dot-muted ms-3"></span><span>Pending</span>
                                </div>
                            }

                        </div>
                    </div>

                    <!-- Governance -->
                    @if (Item.LockedOn.HasValue || Item.SupersededByScheduleId.HasValue)
                    {
                        <div class="card mt-3 mb-0">
                            <div class="card-header py-2"><i class="ti ti-lock me-2"></i> Governance</div>
                            <div class="card-body py-2">
                                @if (Item.LockedOn.HasValue)
                                {
                                    <div class="mb-2"><small class="text-muted">Locked On</small><div>@Item.LockedOn.Value.ToString("dd MMM yyyy")</div></div>
                                    <div class="mb-2"><small class="text-muted">Locked By</small><div>@Item.LockedBy</div></div>
                                    <div class="mb-2"><small class="text-muted">Lock Reason</small><div>@Item.LockReason</div></div>
                                }
                                @if (Item.SupersededByScheduleId.HasValue)
                                {
                                    <div class="mb-2"><small class="text-muted">Superseded By</small><div>@Item.SupersededByScheduleId</div></div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Audit -->
                    <div class="card mt-3 mb-0">
                        <div class="card-header py-2"><i class="ti ti-clock me-2"></i> Audit</div>
                        <div class="card-body py-2">
                            <div class="mb-2"><small class="text-muted">Created At</small><div>@Item.CreatedAt.ToString("dd MMM yyyy")</div></div>
                            <div class="mb-2"><small class="text-muted">Total Capitalized Cost</small><div>@Item.TotalCapitalizedCostSnapshot.ToString("N2")</div></div>
                            <div class="mb-2"><small class="text-muted">Residual Value</small><div>@Item.ResidualValueAmountSnapshot.ToString("N2")</div></div>
                            <div class="mb-2"><small class="text-muted">Version</small><div>v@(Item.ScheduleVersion)</div></div>
                            <div class="mb-2"><small class="text-muted">Generated On</small><div>@Item.GeneratedOn.ToString("dd MMM yyyy")</div></div>
                            <div class="mb-2"><small class="text-muted">Generated By</small><div>@Item.GeneratedBy</div></div>
                            @if (!string.IsNullOrEmpty(Item.ScheduleGenerationReason))
                            {
                                <div class="mb-2"><small class="text-muted">Generation Reason</small><div>@Item.ScheduleGenerationReason</div></div>
                            }
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
}