@page "/depreciation-methods"
@inject IJSRuntime JS

<div class="content List-view">

    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Depreciation Method List</h4>
                <h6>Manage Depreciation Calculation Methods</h6>
            </div>
        </div>
        <ul class="table-top-head me-2">
            <li><a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync"><i class="ti ti-refresh"></i></a></li>
        </ul>
        <div class="page-btn">
            <a href="/depreciation-methods/create" class="btn btn-primary"><i class="ti ti-circle-plus me-1"></i>Create</a>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
                    <input type="search" class="form-control form-control-sm" placeholder="Search method"
                           @bind="searchText" @oninput="OnSearch" />
                </div>
            </div>
            <div style="display:flex; gap:15px;">
                <select class="form-select form-select-sm" style="min-width:180px"
                        @bind="SelectedMethodType" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Method Types</option>
                    @foreach (var t in AvailableMethodTypes)
                    { <option value="@((int)t)">@FormatEnumName(t.ToString())</option> }
                </select>
                <select class="form-select form-select-sm" style="min-width:180px"
                        @bind="SelectedStatus" @bind:event="oninput" @onchange="OnFilterChanged">
                    <option value="">All Status</option>
                    @foreach (var s in AvailableStatuses)
                    { <option value="@((int)s)">@s</option> }
                </select>
            </div>
        </div>

        <div class="card-body p-0">
            <table class="table align-middle w-100 table-fixed">
                <thead class="thead-light">
                    <tr>
                        <th class="d-xl-none" style="width:40px"></th>
                        @* <th>Code</th> *@
                        <th>Name</th>
                        <th class="d-none d-md-table-cell">Method Type</th>
                        <th class="d-none d-md-table-cell">Input Mode</th>
                        <th class="d-none d-xl-table-cell">Rate %</th>
                        <th class="d-none d-xl-table-cell">Locked</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedItems.Any())
                    {
                        @foreach (var m in PagedItems)
                        {
                            <tr>
                                <td class="d-xl-none text-center" style="padding:0;padding-left:15px;">
                                    <a href="javascript:void(0);" class="TablePlus"
                                       data-bs-toggle="modal" data-bs-target="#rowDetailsModal"
                                       @onclick="() => OpenRowDetails(m)"><i class="ti ti-plus"></i></a>
                                </td>
                                <td>
                                    <span class="fw-medium">
                                        <i class="ti ti-external-link me-2 PopupIcon"></i>
                                        <a href="/depreciation-methods/@m.DepreciationMethodId/view" class="link-View text-decoration-none link-View"
                                           data-bs-toggle="tooltip" data-bs-placement="top"
                                           title="@m.MethodCode details">@m.MethodName</a>
                                    </span>
                                </td>
                                @* <td>@m.MethodName</td> *@
                                <td class="d-none d-md-table-cell">@FormatEnumName(m.MethodType?.ToString())</td>
                                <td class="d-none d-md-table-cell">@m.InputMode</td>
                                <td class="d-none d-xl-table-cell">@(m.DefaultRatePercent.HasValue ? m.DefaultRatePercent.Value.ToString("N3") + "%" : "–")</td>
                                <td class="d-none d-xl-table-cell">
                                    @if (m.IsLockedForChanges)
                                    { <span class="badge bg-danger-transparent">Locked</span> }
                                    else
                                    { <span class="badge bg-success-transparent">Open</span> }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="ActiveDot @GetStatusDotBadge(m.MethodStatus)"></div>
                                        <span>@m.MethodStatus</span>
                                    </div>
                                </td>
                                <td class="action-table-data">
                                    <div class="edit-delete-action">
                                        @if (!m.IsLockedForChanges)
                                        {
                                            <a class="me-2 p-1 edit-icon" href="/depreciation-methods/edit/@m.DepreciationMethodId" title="Edit"><i data-feather="edit"></i></a>
                                            @if (m.UsedAssetCount == 0)
                                            {
                                                <a class="me-2 p-1 delete-icon action-icon" href="javascript:void(0);"
                                                   title="Delete" data-bs-toggle="modal" data-bs-target="#delete-modal"
                                                   @onclick="() => DeletePopupOpen(m)"><i class="ti ti-trash"></i></a>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    { <tr><td colspan="9" class="text-center py-4 text-muted">No methods found</td></tr> }
                </tbody>
            </table>
        </div>

        @if (FilteredItems.Count > 0)
        {
            <div class="d-flex align-items-center justify-content-between p-3">
                <div class="d-flex align-items-center fs-13">
                    <span class="me-2">Rows per page</span>
                    <select class="form-select form-select-sm" style="width:80px" @onchange="OnPageSizeChange">
                        <option value="5" selected="@(PageSize == 5)">5</option>
                        <option value="10" selected="@(PageSize == 10)">10</option>
                        <option value="25" selected="@(PageSize == 25)">25</option>
                    </select>
                    <span class="ms-2">Entries</span>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")"><a class="page-link" href="javascript:void(0);" @onclick="PreviousPage"><i class="ti ti-chevron-left"></i></a></li>
                        @for (int i = StartPage; i <= EndPage; i++)
                        { var pageNum = i; <li class="page-item @(CurrentPage == pageNum ? "active" : "")"><a class="page-link" href="javascript:void(0);" @onclick="() => GoToPage(pageNum)">@pageNum</a></li> }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")"><a class="page-link" href="javascript:void(0);" @onclick="NextPage"><i class="ti ti-chevron-right"></i></a></li>
                    </ul>
                </nav>
            </div>
        }
    </div>

    <!-- Row Details Modal -->
    <div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Method Details</h5><button type="button" class="btn-close" data-bs-dismiss="modal" style="padding:0;right:22px;position:absolute;transform:none"></button></div>
                <div class="modal-body">
                    <div class="mb-2 d-flex gap-3"><strong>Type:</strong><div>@FormatEnumName(SelectedItem?.MethodType?.ToString())</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Input Mode:</strong><div>@SelectedItem?.InputMode</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Rate:</strong><div>@(SelectedItem?.DefaultRatePercent?.ToString("N3") ?? "–")%</div></div>
                    <div class="mb-2 d-flex gap-3"><strong>Used Assets:</strong><div>@SelectedItem?.UsedAssetCount</div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="delete-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Method</h4>
                        <p class="text-gray-6 mb-0 fs-16">Are you sure you want to delete <strong>@SelectedItem?.MethodCode</strong>?</p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-danger fs-13 fw-medium p-2 px-4" @onclick="() => ConfirmDelete(SelectedItem!.DepreciationMethodId)" data-bs-dismiss="modal"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
