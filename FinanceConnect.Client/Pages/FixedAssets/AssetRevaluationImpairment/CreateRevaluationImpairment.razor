@page "/valuation-events/create"
@page "/valuation-events/edit/{Id:guid}"
@inject NavigationManager Nav
@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services

<style>
    .validation-message { color: #dc3545; font-size: 12px; }
    .gl-error { color: #dc3545; font-size: 12px; display: block; margin-top: 2px; }
</style>

<div class="content flat-form">

    <div class="page-header">
        <div class="page-title">
            <h4 class="fw-bold">@(IsEdit ? "Edit Valuation Event" : "Create Valuation Event")</h4>
            <h6>Record asset revaluation or impairment adjustment</h6>
        </div>
        <div class="page-btn">
            <a href="/valuation-events" class="btn btn-outline-secondary"><i class="ti ti-arrow-left"></i> Back</a>
        </div>
    </div>

    <EditForm EditContext="_editContext" OnSubmit="Save">
        <DataAnnotationsValidator />

        <!-- SECTION 1 – HEADER -->
        <div class="card mt-4">
            <div class="card-body">
                <h5 class="text-primary mb-4 d-flex align-items-center">
                    <i class="ti ti-file-text me-2" style="margin-bottom: 3px;    font-size: 22px;
"></i> Header
                </h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Event No</label>
                        <input class="form-control" value="@(IsEdit ? Model.EventNumber : "Auto-generated")" disabled />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Event Type <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="Model.EventType">
                            <option value="">-- Select Event Type --</option>
                            <option value="@AssetRevaluationImpairmentViewModel.EventTypeEnum.RevaluationIncrease">Revaluation Increase</option>
                            <option value="@AssetRevaluationImpairmentViewModel.EventTypeEnum.RevaluationDecrease">Revaluation Decrease</option>
                            <option value="@AssetRevaluationImpairmentViewModel.EventTypeEnum.ImpairmentLoss">Impairment Loss</option>
                            <option value="@AssetRevaluationImpairmentViewModel.EventTypeEnum.ImpairmentReversal">Impairment Reversal</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.EventType)" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Effective Date (As-of) <span class="text-danger">*</span></label>
                        <InputDate class="form-control" @bind-Value="Model.EffectiveDate" />
                        <ValidationMessage For="@(() => Model.EffectiveDate)" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Status</label>
                        <input class="form-control" value="@Model.EventStatus" disabled />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Reason Code</label>
                        <InputSelect class="form-select" @bind-Value="Model.ReasonCode">
                            <option value="">-- Select Reason --</option>
                            <option value="@AssetRevaluationImpairmentViewModel.ReasonCodeEnum.FairValueUpdate">Fair Value Update</option>
                            <option value="@AssetRevaluationImpairmentViewModel.ReasonCodeEnum.MarketDecline">Market Decline</option>
                            <option value="@AssetRevaluationImpairmentViewModel.ReasonCodeEnum.Damage">Damage</option>
                            <option value="@AssetRevaluationImpairmentViewModel.ReasonCodeEnum.Obsolescence">Obsolescence</option>
                            <option value="@AssetRevaluationImpairmentViewModel.ReasonCodeEnum.RegulatoryChange">Regulatory Change</option>
                            <option value="@AssetRevaluationImpairmentViewModel.ReasonCodeEnum.Correction">Correction</option>
                            <option value="@AssetRevaluationImpairmentViewModel.ReasonCodeEnum.Other">Other</option>
                        </InputSelect>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 2 – ASSET LINKAGE -->
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="text-primary mb-4 d-flex align-items-center">
                    <i class="ti ti-link me-2" style="margin-bottom: 3px;    font-size: 22px;
"></i> Asset Linkage
                </h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Fixed Asset <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="Model.FixedAssetId" @bind-Value:after="OnAssetChanged">
                            <option value="">-- Select Asset --</option>
                            @foreach (var asset in FixedAssets)
                            {
                                <option value="@asset.FixedAssetId">@asset.AssetCode – @asset.AssetName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.FixedAssetId)" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Asset Code</label>
                        <input class="form-control" value="@Model.AssetNumberSnapshot" disabled />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">In-Service Date</label>
                        <input class="form-control" value="@Model.InServiceDateSnapshot?.ToString("dd MMM yyyy")" disabled />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Asset Status</label>
                        <input class="form-control" value="@Model.AssetStatusSnapshot" disabled />
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 3 – VALUATION INPUTS -->
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="text-primary mb-4 d-flex align-items-center">
                    <i class="ti ti-calculator me-2" style="margin-bottom: 3px;    font-size: 22px;
"></i> Valuation Inputs
                </h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Calculation Mode <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="Model.CalculationMode">
                            <option value="">-- Select Mode --</option>
                            <option value="@AssetRevaluationImpairmentViewModel.CalculationModeEnum.AdjustByDelta">Adjust By Delta</option>
                            <option value="@AssetRevaluationImpairmentViewModel.CalculationModeEnum.RevalueToAmount">Revalue To Amount</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.CalculationMode)" />
                    </div>

                    @if (Model.CalculationMode == AssetRevaluationImpairmentViewModel.CalculationModeEnum.AdjustByDelta)
                    {
                        <div class="col-md-3">
                            <label class="form-label">Delta Amount <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="Model.DeltaAmount" placeholder="e.g. 40000" />
                            <ValidationMessage For="@(() => Model.DeltaAmount)" />
                        </div>
                    }

                    @if (Model.CalculationMode == AssetRevaluationImpairmentViewModel.CalculationModeEnum.RevalueToAmount)
                    {
                        <div class="col-md-3">
                            <label class="form-label">Target Carrying Amount <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="Model.TargetCarryingAmount" placeholder="e.g. 240000" />
                            <ValidationMessage For="@(() => Model.TargetCarryingAmount)" />
                        </div>
                    }

                    <div class="col-md-3">
                        <label class="form-label">Valuation Basis <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="Model.ValuationBasis">
                            <option value="">-- Select Basis --</option>
                            <option value="@AssetRevaluationImpairmentViewModel.ValuationBasisEnum.ExternalValuerReport">External Valuer Report</option>
                            <option value="@AssetRevaluationImpairmentViewModel.ValuationBasisEnum.InternalAssessment">Internal Assessment</option>
                            <option value="@AssetRevaluationImpairmentViewModel.ValuationBasisEnum.MarketComparable">Market Comparable</option>
                            <option value="@AssetRevaluationImpairmentViewModel.ValuationBasisEnum.InsuranceValuation">Insurance Valuation</option>
                            <option value="@AssetRevaluationImpairmentViewModel.ValuationBasisEnum.Other">Other</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.ValuationBasis)" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Valuer Name</label>
                        <InputText class="form-control" @bind-Value="Model.ValuerName" placeholder="e.g. ABC Valuation Pvt Ltd" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Report Reference</label>
                        <InputText class="form-control" @bind-Value="Model.ValuationReportReference" placeholder="e.g. VR-2024-087" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Report Date</label>
                        <InputDate class="form-control" @bind-Value="Model.ValuationReportDate" />
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 4 – ACCUM DEP TREATMENT -->
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="text-primary mb-4 d-flex align-items-center">
                    <i class="ti ti-adjustments me-2" style="margin-bottom: 3px;    font-size: 22px;
"></i> Accumulated Depreciation Treatment
                </h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Treatment Mode <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="Model.AccumDepTreatmentMode">
                            <option value="">-- Select Treatment --</option>
                            <option value="@AssetRevaluationImpairmentViewModel.AccumDepTreatmentModeEnum.ProportionalRestatement">Proportional Restatement</option>
                            <option value="@AssetRevaluationImpairmentViewModel.AccumDepTreatmentModeEnum.EliminateAccumDepAgainstCost">Eliminate Accum Dep Against Cost</option>
                            <option value="@AssetRevaluationImpairmentViewModel.AccumDepTreatmentModeEnum.KeepAccumDepNoChange">Keep Accum Dep No Change (Rare)</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.AccumDepTreatmentMode)" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Decrease Handling</label>
                        <InputSelect class="form-select" @bind-Value="Model.RevaluationDecreaseHandlingMode">
                            <option value="">-- Select --</option>
                            <option value="@AssetRevaluationImpairmentViewModel.RevalDecreaseHandlingModeEnum.ChargeToReserveThenPAndL">Charge to Reserve then P&amp;L</option>
                            <option value="@AssetRevaluationImpairmentViewModel.RevalDecreaseHandlingModeEnum.DirectToPAndL">Direct to P&amp;L</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="Model.AllowAccumDepTreatmentOverride" />
                            <label class="form-check-label">Override Allowed</label>
                        </div>
                    </div>
                    @if (Model.AllowAccumDepTreatmentOverride)
                    {
                        <div class="col-md-6">
                            <label class="form-label">Override Reason <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="Model.AccumDepTreatmentReason" placeholder="Reason for override..." />
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- SECTION 5 – BEFORE/AFTER VALUES -->
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="text-primary mb-4 d-flex align-items-center">
                    <i class="ti ti-arrows-exchange me-2" style="margin-bottom: 3px;    font-size: 22px;
"></i> Before / After Values (Preview)
                </h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label text-muted">Gross Cost Before</label>
                        <InputNumber class="form-control" @bind-Value="Model.GrossCostBefore" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted">Accum Dep Before</label>
                        <InputNumber class="form-control" @bind-Value="Model.AccumDepBefore" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted">Carrying Value Before (NBV)</label>
                        <InputNumber class="form-control" @bind-Value="Model.CarryingValueBefore" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted">Residual Value Before</label>
                        <InputNumber class="form-control" @bind-Value="Model.ResidualValueAmountBefore" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Gross Cost After</label>
                        <InputNumber class="form-control" @bind-Value="Model.GrossCostAfter" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Accum Dep After</label>
                        <InputNumber class="form-control" @bind-Value="Model.AccumDepAfter" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Carrying Value After</label>
                        <InputNumber class="form-control" @bind-Value="Model.CarryingValueAfter" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Adjustment Amount</label>
                        <input class="form-control text-end fw-bold @(Model.AdjustmentAmount >= 0 ? "text-success" : "text-danger")"
                               value="@Model.AdjustmentAmount.ToString("N2")" disabled />
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 6 – SCHEDULE IMPACT -->
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="text-primary mb-4 d-flex align-items-center">
                    <i class="ti ti-calendar-event me-2" style="margin-bottom: 3px;    font-size: 22px;
"></i> Depreciation Schedule Impact
                </h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Regeneration Mode</label>
                        <InputSelect class="form-select" @bind-Value="Model.RegenerationMode">
                            <option value="@AssetRevaluationImpairmentViewModel.RegenerationModeEnum.ForwardOnlyFromNextPeriod">Forward Only From Next Period</option>
                            <option value="@AssetRevaluationImpairmentViewModel.RegenerationModeEnum.RebuildFromEffectiveDate">Rebuild From Effective Date</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">New Depreciable Base After</label>
                        <InputNumber class="form-control" @bind-Value="Model.NewDepreciableBaseAmountAfter" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">New Useful Life Override (Mo)</label>
                        <InputNumber class="form-control" @bind-Value="Model.NewUsefulLifeMonthsOverride" placeholder="Leave blank to keep" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="Model.RequiresScheduleRegeneration" />
                            <label class="form-check-label">Requires Schedule Regeneration</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 7 – NARRATION -->
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="text-primary mb-4 d-flex align-items-center">
                    <i class="ti ti-notes me-2" style="margin-bottom: 3px;    font-size: 22px;
"></i> Narration &amp; Notes
                </h5>
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label">Narration</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="Model.Narration"
                                       placeholder="Describe the valuation event for audit trail..." />
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(CustomError))
        {
            <div class="alert alert-danger mt-3"><i class="ti ti-alert-circle me-2"></i>@CustomError</div>
        }

        <!-- SUBMIT -->
        <div class="d-flex justify-content-end gap-3 mt-3 mb-4">
            <a href="/valuation-events" class="btn btn-outline-secondary"><i class="ti ti-x me-1"></i>Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>@(IsEdit ? "Update" : "Save")</button>
        </div>
    </EditForm>
</div>
