@page "/ProductDetails/{SKU}"
@using static FinanceConnect.Client.Pages.Product_List
@inject NavigationManager Nav
@using FinanceConnect.Client.Services
@inject ProductService ProductService

<div class="content">
    <div class="page-header">
        <div class="page-title">
            <h4>Product Details</h4>
            <h6>Full details of a product</h6>
        </div>
    </div>

    @if (SelectedProduct == null)
    {
        <p class="text-danger">Product not found</p>
    }
    else
    {
        <div class="row">
            <div class="col-lg-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="bar-code-view">
                            <div class="product-details-barcode">
                                <img src="assets/images/barcode1.png"
                                     class="barcode"
                                     alt="barcode">
                            </div>
                            <a class="printimg">
                                <i class="ti ti-printer fs-24 text-dark"></i>
                            </a>
                        </div>

                        <div class="productdetails">
                            <ul class="product-bar">
                                <li>
                                    <h4>Product</h4>
                                    <h6>@SelectedProduct.ProductName</h6>
                                </li>

                                <li>
                                    <h4>Category</h4>
                                    <h6>@SelectedProduct.Category</h6>
                                </li>

                                <li>
                                    <h4>Sub Category</h4>
                                    <h6>-</h6>
                                </li>

                                <li>
                                    <h4>Brand</h4>
                                    <h6>@SelectedProduct.Brand</h6>
                                </li>

                                <li>
                                    <h4>Unit</h4>
                                    <h6>@SelectedProduct.Unit</h6>
                                </li>

                                <li>
                                    <h4>SKU</h4>
                                    <h6>@SelectedProduct.SKU</h6>
                                </li>

                                <li>
                                    <h4>Minimum Qty</h4>
                                    <h6>5</h6>
                                </li>

                                <li>
                                    <h4>Quantity</h4>
                                    <h6>@SelectedProduct.Qty</h6>
                                </li>

                                <li>
                                    <h4>Tax</h4>
                                    <h6>0.00 %</h6>
                                </li>

                                <li>
                                    <h4>Discount Type</h4>
                                    <h6>Percentage</h6>
                                </li>

                                <li>
                                    <h4>Price</h4>
                                    <h6>@SelectedProduct.Price</h6>
                                </li>

                                <li>
                                    <h4>Status</h4>
                                    <h6>Active</h6>
                                </li>

                                <li>
                                    <h4>Description</h4>
                                    <h6>
                                        Designed for professionals, it offers smooth multitasking
                                        and high-end graphics capability.
                                    </h6>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


@code {
    [Parameter]
    public string? SKU { get; set; }

    Product? SelectedProduct;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(SKU))
            return;

        SelectedProduct = ProductService.Products?
            .FirstOrDefault(p => p.SKU == SKU);
    }
}