@page "/"
@page "/Login"
@layout AuthLayout
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ToastService ToastService

<style>
    .login-wrapper-centered {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1a1c2e 0%, #2d3154 50%, #1a1c2e 100%);
        position: relative;
        overflow: hidden;
    }

    .login-wrapper-centered::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(254, 159, 67, 0.1) 0%, transparent 50%);
        animation: pulse 15s ease-in-out infinite;
    }

    .login-wrapper-centered::after {
        content: '';
        position: absolute;
        bottom: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(254, 159, 67, 0.05) 0%, transparent 40%);
        animation: pulse 20s ease-in-out infinite reverse;
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 0.5; }
        50% { transform: scale(1.1); opacity: 0.8; }
    }

    .login-card {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        padding: 40px;
        width: 100%;
        max-width: 450px;
        position: relative;
        z-index: 10;
        backdrop-filter: blur(10px);
    }

    .login-card .login-logo {
        text-align: center;
        margin-bottom: 10px;
    }

    .login-card .login-logo img {
        max-height: 60px;
        width: auto;
    }

    .login-card .login-userheading {
        text-align: center;
        margin-bottom: 30px;
    }

    .login-card .login-userheading h3 {
        color: #1a1c2e;
        font-weight: 700;
        font-size: 28px;
        margin-bottom: 10px;
    }

    .login-card .login-userheading h4 {
        color: #6c757d;
        font-weight: 400;
    }

    .copyright-text p {
        color: #6c757d;
        font-size: 10px;
    }

    .text-orange {
        color: color-mix(in srgb, var(--primary) 94%, white) !important;
    }

    .text-orange:hover {
            color: var(--primary) !impo;
    }
</style>

<div class="login-wrapper-centered">
    <div class="login-card">
        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <div class="login-logo">
                <img src="assets/images/logo.png" alt="Gishur Finance">
            </div>
            <div class="login-userheading">
                <h3>Sign In</h3>
                <h4 class="fs-16">Access the panel using your email and passcode.</h4>
            </div>

            <div class="mb-3">
                <label class="form-label">Email <span class="text-danger">*</span></label>
                <div class="input-group">
                    <InputText @bind-Value="loginModel.Email" class="form-control border-end-0" placeholder="Enter your email" />
                    <span class="input-group-text border-start-0">
                        <i class="ti ti-mail"></i>
                    </span>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Password <span class="text-danger">*</span></label>
                <div class="pass-group">
                    <InputText type="@(showPassword ? "text" : "password")" @bind-Value="loginModel.Password" class="pass-input form-control" placeholder="Enter your password" />
                    <span class="ti toggle-password @(showPassword ? "ti-eye" : "ti-eye-off") text-gray-9" @onclick="TogglePasswordVisibility" style="cursor: pointer;"></span>
                </div>
            </div>
            <div class="form-login authentication-check">
                <div class="row">
                    <div class="col-12 d-flex align-items-center justify-content-between">
                        <div class="custom-control custom-checkbox">
                            <label class="checkboxs ps-4 mb-0 pb-0 line-height-1 fs-16 text-gray-6" style="font-size: 14px !important;">
                                <input type="checkbox" class="form-control" @bind="rememberMe">
                                <span class="checkmarks" style="border: 1px solid var(--primary);"></span>Remember me
                            </label>
                        </div>
                        <div class="text-end">
                            <a class="text-orange fs-16 fw-medium" href="/Forgot-password" style="font-size: 14px !important;">Forgot Password?</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-login mt-4">
                <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Signing In...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
            </div>
            <div class="signinform mt-4 text-center">
                <h4 style="font-size: 14px !important;">New on our platform? <a href="/Register" class="text-orange fw-medium">Create an account</a></h4>
            </div>
            <div class="mt-4 d-flex justify-content-center align-items-center copyright-text">
                <p class="mb-0">Copyright © 2026 FinanceConnect. All rights reserved.</p>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private LoginRequest loginModel = new();
    private bool isLoading = false;
    private bool showPassword = false;
    private bool rememberMe = false;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/Dashboard", replace: true);
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(loginModel.Email))
        {
            ToastService.ShowError("Email is required.", "Validation Error");
            return;
        }

        if (string.IsNullOrWhiteSpace(loginModel.Password))
        {
            ToastService.ShowError("Password is required.", "Validation Error");
            return;
        }

        isLoading = true;
        try
        {
            var response = await AuthService.LoginAsync(loginModel, rememberMe);
            if (response.Success)
            {
                Navigation.NavigateTo("/Dashboard", replace: true);
            }
            else
            {
                ToastService.ShowError(response.Message, "Login Failed");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"An error occurred: {ex.Message}", "Error");
        }
        finally
        {
            isLoading = false;
        }
    }
}
