@page "/financial-transactions"

@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject FinancialTransactionService TxService
@inject ToastService ToastService

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
    <div class="content List-view">

        <!-- Page Header -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Financial Transactions</h4>
                    <h6>Universal financial envelope & posting lifecycle</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);"
                    title="Refresh"
                           @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
            <a href="/financial-transactions/create" class="btn btn-primary">
                    <i class="ti ti-circle-plus me-1"></i>
                Create
                </a>
            </div>
        </div>

        <!-- LIST -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

                <!-- Search -->
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset">
                            <i class="ti ti-search fs-14"></i>
                        </span>
                        <input type="search"
                        class="form-control form-control-sm"
                        placeholder="Search document no / source ref"
                        @bind="searchText"
                        @oninput="OnSearch" />
                    </div>
                </div>

            <div style="display:flex;flex-wrap: wrap;gap:5px;">

                <!-- Company Filter -->
                <div>
                    <select class="form-select form-select-sm"
                            style="min-width: 180px"
                            @bind="SelectedCompany">
                        <option value="">All Companies</option>
                        @foreach (var c in Companies)
                        {
                            <option value="@c.Id">@c.LegalName</option>
                        }
                    </select>
                </div>
                    <!-- Source Filter -->
                    <div>
                    <select class="form-select form-select-sm"
                    style="min-width:140px"
                    @bind="SelectedSource">
                        <option value="">All Modules</option>
                        <option value="AP">AP</option>
                        <option value="BANK">BANK</option>
                        <option value="MANUAL">MANUAL</option>
                    </select>
                    </div>

                    <!-- Status Filter -->
                    <div>
                    <select class="form-select form-select-sm"
                    style="min-width:140px"
                    @bind="SelectedStatus">
                        <option value="">All Status</option>
                    @foreach (var c in Status)
                    {
                        <option value="@c.Name">@c.Name</option>
                    }
                    </select>
                </div>
                </div>

            </div>

            <div class="card-body p-0">
                <div>
                    <table class="table align-middle w-100 table-fixed">
                        <thead class="thead-light">
                            <tr>
                                <th class="d-xl-none" style="width:40px"></th>
                                <th style="width:220px">Document No</th>
                                <th class="d-none d-md-table-cell">Type</th>
                                @* <th class="d-none d-xl-table-cell">Source</th> *@
                                <th class="d-none d-md-table-cell text-end">Amount</th>
                                @* <th class="d-none d-xl-table-cell">Currency</th> *@
                                <th class="d-none d-xl-table-cell">Date</th>
                            <th class="d-none d-xl-table-cell">Status</th>
                                <th class="no-sort">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (PagedTx.Any())
                            {
                                @foreach (var tx in PagedTx)
                                {
                                    <tr>
                                        <!-- PLUS ICON -->
                                        <td class="d-xl-none text-center" style="padding-left: 15px;">
                                            <a href="javascript:void(0);" class="TablePlus"
                                            data-bs-toggle="modal"
                                            data-bs-target="#rowDetailsModal"
                                            @onclick="() => ViewTx(tx)">
                                                <i class="ti ti-plus"></i>
                                            </a>
                                        </td>

                                        <td>
                                            <span class="fw-medium">
                                            <span class="PopupIcon">⧉</span>
                                                <a @onclick="() => ViewTx(tx)"
                                                class="text-decoration-none link-View"
                                                data-bs-toggle="modal"
                                                data-bs-target="#view-tx-modal"
                                               title="@tx.DocumentNo details">
                                                    @tx.DocumentNo
                                                </a>
                                            </span>

                                            @if (tx.IsReversal)
                                            {
                                                <span class="badge bg-warning-transparent text-warning ms-2">
                                                    Reversal
                                                </span>
                                            }
                                        </td>

                                    <td class="d-none d-md-table-cell">
                                            @tx.TransactionTypeName
                                        </td>

                                    @* <td class="d-none d-xl-table-cell" title="@tx.SourceModule">
                                            @tx.SourceModule
                                        </td> *@

                                    <td class="d-none d-md-table-cell text-end">
                                            @* @tx.TransactionAmount.ToString("N2") *@
                                        @IndianNumberFormatter.Format(@tx.TransactionAmount)

                                        </td>

                                   

                                    <td class="d-none d-xl-table-cell" s>
                                            @tx.TransactionDate?.ToString("dd MMM yyyy")
                                        </td>

                                       

                                    <td class="d-none d-xl-table-cell">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="ActiveDot @GetStatusDotBadge(tx.Status)">
                                            </div>
                                            <span>@tx.Status</span>
                                        </div>
                                    </td>


                                        <td class="action-table-data">
                                            <div class="edit-delete-action">

                                                <a class="me-2 Layer-icon p-1" title="Open Profile Rule" href="@($"/financial-transactions/{tx.FinancialTransactionId}/lines")">
                                                    <i data-feather="layers"></i>
                                                </a>

                                                @if (tx.Status == "Draft")
                                                {
                                                    <a class="me-2 edit-icon p-1"
                                                    title="Edit Transaction"
                                                       @onclick='() => Nav.NavigateTo($"/financial-transactions/{tx.FinancialTransactionId}")'>
                                                        <i data-feather="edit"></i>
                                                    </a>

                                                    <a class="p-1 delete-icon"
                                                    title="Delete"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#delete-modal"
                                                    @onclick="() => SelectTx(tx)">
                                                        <i data-feather="trash-2"></i>
                                                    </a>
                                                }

                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                <td colspan="@VisibleColumnCount" class="text-center py-4">
                                        <div class="text-muted">
                                            <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                            No financial transactions found
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (PagedTx.Any())
                    {
                        <!-- Pagination -->
                        <div class="d-flex justify-content-between align-items-center p-3">

                        <div class="d-flex align-items-center fs-13">
                                <span class="me-2">Rows Per Page</span>
                                <select class="form-select form-select-sm w-auto"
                                @onchange="OnPageSizeChange">
                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                </select>
                                <span class="ms-2">Entries</span>
                            </div>

                            <nav>
                                <ul class="pagination pagination-sm mb-0">

                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                        @onclick="PreviousPage"
                                        @onclick:preventDefault>
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>

                                    @foreach (var pageNumber in VisiblePages)
                                    {
                                        <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                            <button class="page-link"
                                            @onclick="() => GoToPage(pageNumber)">
                                                @pageNumber
                                            </button>
                                        </li>
                                    }

                                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                        <a class="page-link" href="#"
                                        @onclick="NextPage"
                                        @onclick:preventDefault>
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>

                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
    <div class="modal fade" id="delete-modal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                            <i class="ti ti-trash fs-24 text-danger"></i>
                        </span>
                        <h4 class="fs-20 fw-bold mb-2">Delete Transaction</h4>
                        <p>
                            Are you sure you want to delete
                            <strong>@SelectedTx?.DocumentNo</strong>?
                        </p>
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                        <div class="modal-footer-btn mt-3 d-flex justify-content-center">
                        <button class="btn btn-outline-secondary me-2" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button class="btn btn-danger"
                            data-bs-dismiss="modal"
                            @onclick="DeleteConfirmed">
                            <i class="ti ti-trash me-1"></i>Yes, Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="modal fade list-Popup"
    id="view-tx-modal"
    tabindex="-1"
    data-bs-backdrop="static"
    data-bs-keyboard="false">

        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="ti ti-receipt me-2 text-primary"></i>
                        Financial Transaction
                    </h5>
                    <button class="btn-close"
                    data-bs-dismiss="modal"
                    style="position:absolute; right:22px;padding: 0;">
                    </button>
                </div>

                <div class="modal-body">
                    @if (SelectedTx != null)
                    {
                        <div class="row g-3">

                            <!-- Identity -->
                            <div class="col-12">
                                <h6 class="text-primary">
                                    <i class="ti ti-id me-2"></i>Identity
                                </h6>
                            </div>

                            <div class="col-md-4">
                                <label class="text-muted small">Document No</label>
                                <div class="fw-medium">@SelectedTx.DocumentNo</div>
                            </div>

                            <div class="col-md-4">
                                <label class="text-muted small">Transaction Type</label>
                                <div>@SelectedTx.TransactionTypeName</div>
                            </div>

                            <div class="col-md-4">
                                <label class="text-muted small">Source Module</label>
                                <div>@SelectedTx.SourceModule</div>
                            </div>

                            <!-- Amount -->
                            <div class="col-12 mt-4">
                                <h6 class="text-primary">
                                    <i class="ti ti-currency-rupee me-2"></i>Amount
                                </h6>
                            </div>

                            <div class="col-md-4">
                                <label class="text-muted small">Transaction Amount</label>
                                <div>₹@SelectedTx.TransactionAmount.ToString("N2")</div>
                            </div>

                            <div class="col-md-4">
                                <label class="text-muted small">Base Amount</label>
                                <div>₹@SelectedTx.BaseAmount.ToString("N2")</div>
                            </div>

                            <div class="col-md-4">
                                <label class="text-muted small">Currency</label>
                            <div>@CurrencyName</div>
                            </div>

                            <!-- Dates -->
                            <div class="col-12 mt-4">
                                <h6 class="text-primary">
                                    <i class="ti ti-calendar me-2"></i>Dates
                                </h6>
                            </div>

                            <div class="col-md-4">
                                <label class="text-muted small">Transaction Date</label>
                                <div>@SelectedTx.TransactionDate?.ToString("dd MMM yyyy")</div>
                            </div>

                            <div class="col-md-4">
                                <label class="text-muted small">Posted At</label>
                                <div>@(SelectedTx.PostedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</div>
                            </div>

                            <!-- Workflow -->
                            <div class="col-12 mt-4">
                                <h6 class="text-primary">
                                    <i class="ti ti-lock me-2"></i>Workflow
                                </h6>
                            </div>

                            <div class="col-md-3">
                                <label class="text-muted small">Status</label>
                                <div>
                                    <span class="badge @GetStatusBadge(SelectedTx.Status)">
                                        @SelectedTx.Status
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <label class="text-muted small">Submitted At</label>
                                <div>@(SelectedTx.SubmittedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</div>
                            </div>

                            <div class="col-md-3">
                                <label class="text-muted small">Approved At</label>
                                <div>@(SelectedTx.ApprovedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</div>
                            </div>

                            <div class="col-md-3">
                                <label class="text-muted small">Reversal</label>
                                <div>
                                    @(SelectedTx.IsReversal ? "Yes" : "No")
                                </div>
                            </div>

                        </div>
                    }
                </div>

                @if (SelectedTx != null)
                {
                    <!-- Footer -->
                    <div class="modal-footer justify-content-between">

                        <div class="text-muted small">
                            Workflow:
                            <b>Draft</b> → <b>Submitted</b> → <b>Approved</b> → <b>Posted</b>
                        </div>
                        <div class="d-flex gap-2">
                            <!-- DRAFT -->
                            @if (SelectedTx.Status == "Draft")
                            {
                                <button type="button"
                                    class="btn btn-warning" data-bs-dismiss="modal"
                                @onclick="() => SubmitTx()">
                                <i class="ti ti-send"></i> Submit
                                </button>
                                <button type="button"
                                class="btn btn-secondary"
                                @onclick="() => CancelTx()">
                                    <i class="ti ti-x"></i> Cancel
                                </button>
                            }

                            <!-- SUBMITTED -->
                            @if (SelectedTx.Status == "Submitted")
                            {
                                <button type="button"
                                class="btn btn-success" data-bs-dismiss="modal"
                                @onclick="() => ApproveTx()">
                                    <i class="ti ti-check me-1"></i>Approve
                                </button>
                            }

                            <!-- APPROVED -->
                            @if (SelectedTx.Status == "Approved")
                            {
                                <button type="button"
                                class="btn btn-info" data-bs-dismiss="modal"
                                @onclick="() => PostTx()">
                                    <i class="ti ti-send me-1"></i>Post
                                </button>
                            }

                            <!-- POSTED -->
                            @if (SelectedTx.Status == "Posted")
                            {
                                <button type="button"
                                class="btn btn-danger" data-bs-dismiss="modal"
                                @onclick="() => ReverseTx()">
                                <i class="ti ti-arrow-back-up me-1"></i>Reverse
                                </button>
                            }
                        </div>

                    </div>
                }

            </div>
        </div>
    </div>

    <!-- RESPONSIVE ROW MODAL -->
    <div class="modal fade list-Popup"
    id="rowDetailsModal"
    tabindex="-1"
    data-bs-backdrop="static"
    data-bs-keyboard="false">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="ti ti-receipt me-2 text-primary"></i>
                        Financial Transaction
                    </h5>
                    <button class="btn-close"
                    data-bs-dismiss="modal"
                    style="position:absolute; right:22px;">
                    </button>
                </div>

                @if (SelectedTx != null)
                {
                    <div class="modal-body">

                        <!-- Document No -->
                        <div class="mb-2 d-flex gap-3 d-md-none">
                            <strong>Document:</strong>
                            <div>@SelectedTx.DocumentNo</div>
                        </div>

                        <!-- Type -->
                        <div class="mb-2 d-flex gap-3 d-md-none">
                            <strong>Type:</strong>
                            <div>@SelectedTx.TransactionTypeName</div>
                        </div>

                        <!-- Source -->
                        <div class="mb-2 d-flex gap-3 d-md-none">
                            <strong>Source:</strong>
                            <div>@SelectedTx.SourceModule</div>
                        </div>

                        <!-- Amount -->
                        <div class="mb-2 d-flex gap-3">
                            <strong>Amount:</strong>
                            <div>
                                ₹@SelectedTx.TransactionAmount.ToString("N2")
                                <span class="text-muted">
                                (@CurrencyName)
                                </span>
                            </div>
                        </div>

                        <!-- Base Amount -->
                        <div class="mb-2 d-flex gap-3">
                            <strong>Base:</strong>
                            <div>
                                ₹@SelectedTx.BaseAmount.ToString("N2")
                            </div>
                        </div>

                        <!-- Date -->
                        <div class="mb-2 d-flex gap-3">
                            <strong>Date:</strong>
                            <div>
                                @SelectedTx.TransactionDate?.ToString("dd MMM yyyy")
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="mb-2 d-flex gap-3">
                            <strong>Status:</strong>
                            <span class="badge @GetStatusBadge(SelectedTx.Status)">
                                @SelectedTx.Status
                            </span>
                        </div>

                        <!-- Workflow -->
                        <div class="mb-2 d-flex gap-3">
                            <strong>Submitted:</strong>
                            <div>
                                @(SelectedTx.SubmittedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")
                            </div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Approved:</strong>
                            <div>
                                @(SelectedTx.ApprovedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")
                            </div>
                        </div>

                        <div class="mb-2 d-flex gap-3">
                            <strong>Posted:</strong>
                            <div>
                                @(SelectedTx.PostedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")
                            </div>
                        </div>

                        <!-- Reversal Flag -->
                        <div class="mb-2 d-flex gap-3">
                            <strong>Reversal:</strong>
                            <span class="badge @(SelectedTx.IsReversal ? "bg-warning" : "bg-secondary")">
                                @(SelectedTx.IsReversal ? "Yes" : "No")
                            </span>
                        </div>

                    </div>

                }

            </div>
        </div>
    </div>
