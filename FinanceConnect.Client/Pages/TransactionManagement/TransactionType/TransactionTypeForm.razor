@page "/transaction-types/create"
@page "/transaction-types/{Id:guid}"

@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services
@inject TransactionTypeService TypeService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService ToastService

<style>
    .form-select option:checked {
        color: #fff;
        background: var(--primary);
    }

    .form-select:focus {
        border-color: var(--primary);
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }
</style>

<div class="content Accordion-form">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">@PageTitle</h4>
                <h6>@PageSubTitle</h6>
            </div>
        </div>

        <div class="page-btn mt-0">
            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="BackToList">
                <i class="ti ti-arrow-left"></i> Back
            </button>
        </div>
    </div>

    <EditForm EditContext="_editContext" OnSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="add-product" style="background:#f4f7fb; padding:24px 14px;">
            <div class="tl-accordion">

                <!-- LEFT PANEL  -->
                <div class="tl-left-panel">

                    <div class="tl-label @(ShowIdentity ? "active accent-orange" : "")"
                         @onclick="@(() => ToggleAccordion("identity"))">
                        <div class="tl-label-icon ico-orange"><i data-feather="info"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Transaction Identity</div>
                            <div class="tl-label-sub">Code, name and ownership</div>
                        </div>
                        <span class="tl-label-chevron @(ShowIdentity ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowClassification ? "active accent-blue" : "")"
                         @onclick="@(() => ToggleAccordion("classification"))">
                        <div class="tl-label-icon ico-blue"><i data-feather="tag"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Classification</div>
                            <div class="tl-label-sub">Category & nature</div>
                        </div>
                        <span class="tl-label-chevron @(ShowClassification ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowPosting ? "active accent-purple" : "")"
                         @onclick="@(() => ToggleAccordion("posting"))">
                        <div class="tl-label-icon ico-purple"><i data-feather="settings"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Posting & Approval</div>
                            <div class="tl-label-sub">GL behavior & workflow</div>
                        </div>
                        <span class="tl-label-chevron @(ShowPosting ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowDoc ? "active accent-green" : "")"
                         @onclick="@(() => ToggleAccordion("doc"))">
                        <div class="tl-label-icon ico-green"><i data-feather="hash"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Document Policy</div>
                            <div class="tl-label-sub">Series & timing</div>
                        </div>
                        <span class="tl-label-chevron @(ShowDoc ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowPolicies ? "active accent-rose" : "")"
                         @onclick="@(() => ToggleAccordion("policies"))">
                        <div class="tl-label-icon ico-rose"><i data-feather="shield"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Workflow Rules</div>
                            <div class="tl-label-sub">Edit / cancel / reversal</div>
                        </div>
                        <span class="tl-label-chevron @(ShowPolicies ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowCurrency ? "active accent-teal" : "")"
                         @onclick="@(() => ToggleAccordion("currency"))">
                        <div class="tl-label-icon ico-teal"><i data-feather="dollar-sign"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Currency Policy</div>
                            <div class="tl-label-sub">FX & precision</div>
                        </div>
                        <span class="tl-label-chevron @(ShowCurrency ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowStatus ? "active accent-yellow" : "")"
                         @onclick="@(() => ToggleAccordion("status"))">
                        <div class="tl-label-icon ico-yellow"><i data-feather="check-circle"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Activation</div>
                            <div class="tl-label-sub">Lifecycle & lock</div>
                        </div>
                        <span class="tl-label-chevron @(ShowStatus ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                </div>

                <!-- RIGHT TIMELINE AREA -->
                <div class="tl-right-area">

                    <!-- Identity -->
                    <div class="tl-card-row @(ShowIdentity ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("identity"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowIdentity ? "card-active border-orange" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("identity"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-orange">01</span>
                                        Transaction Identity
                                    </div>
                                    <span class="tl-card-toggle @(ShowIdentity ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowIdentity ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(IdentityTouched ? "touched" : "")">

                                            <div class="row">
                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Type Code <span class="text-danger">*</span></label>
                                                    <input class="@($"form-control text-uppercase {GetValidationClass(() => type.Code)}")"
                                                           @bind="TypeCodeInput"
                                                           maxlength="30"
                                                           disabled="@IsEdit"
                                                           placeholder="e.g. AP_VENDOR_BILL"
                                                           @oninput="TouchIdentity" />
                                                    <ValidationMessage For="@(() => type.Code)" />
                                                </div>

                                                <div class="col-sm-5 mb-3">
                                                    <label class="form-label">Type Name <span class="text-danger">*</span></label>
                                                    <input class="@($"form-control {GetValidationClass(() => type.Name)}")"
                                                           @bind="type.Name"
                                                           @bind:after="OnNameChanged"
                                                           maxlength="150"
                                                           placeholder="e.g. Vendor Bill"
                                                           @oninput="TouchIdentity" />
                                                    <ValidationMessage For="@(() => type.Name)" />
                                                </div>

                                                <div class="col-sm-3 mb-3">
                                                    <label class="form-label">Company <span class="text-danger">*</span></label>
                                                    <select class="@($"form-select {GetValidationClass(() => type.CompanyId)}")"
                                                            @bind="type.CompanyId"
                                                            @bind:after="() => OnCompanyChange()"
                                                            disabled="@IsEdit">
                                                        <option value="">-- Select Company --</option>
                                                        @foreach (var c in Companies)
                                                        {
                                                            <option value="@c.Id">@c.LegalName</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => type.CompanyId)" />
                                                </div>
                                                @* maxlength="1000" *@
                                                <div class="col-sm-12 mb-3">
                                                    <label class="form-label">Description</label>
                                                    <RichTextEditor @ref="_descriptionEditor"
                                                                    Value="@type.Description"
                                                                    MaxHeight="200" MinHeight="80"
                                                                    placeholder="Describe when this transaction type should be used" />
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Classification -->
                    <div class="tl-card-row @(ShowClassification ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("classification"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowClassification ? "card-active border-blue" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("classification"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-blue">02</span>
                                        Classification & Reporting
                                    </div>
                                    <span class="tl-card-toggle @(ShowClassification ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowClassification ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(ClassificationTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Source Category <span class="text-danger">*</span></label>
                                                    <select class="form-select"
                                                            @bind="type.SourceCategory"
                                                            @oninput="TouchClassification">
                                                        <option value="">-- Select Category --</option>
                                                        @foreach (var v in Enum.GetValues<SourceCategory>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => type.SourceCategory)" />
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Transaction Nature</label>
                                                    <select class="form-select"
                                                            @bind="type.TransactionNature"
                                                            @oninput="TouchClassification">
                                                        <option value="">-- Select Nature --</option>
                                                        @foreach (var v in Enum.GetValues<TransactionNature>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Posting -->
                    <div class="tl-card-row @(ShowPosting ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("posting"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowPosting ? "card-active border-purple" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("posting"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-purple">03</span>
                                        Posting & Approval Policy
                                    </div>
                                    <span class="tl-card-toggle @(ShowPosting ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowPosting ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(PostingTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="IsPostable"
                                                               @bind="type.IsPostable"
                                                               @oninput="TouchPosting" />
                                                        <label class="form-check-label" for="IsPostable">
                                                            Postable to GL
                                                        </label>
                                                    </div>
                                                </div>

                                                @if (type.IsPostable)
                                                {
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Posting Profile <span class="text-danger">*</span></label>
                                                        <select class="@($"form-select {GetValidationClass(() => type.DefaultPostingProfileId)}")"
                                                                @bind="type.DefaultPostingProfileId"
                                                                @oninput="TouchPosting">
                                                            <option value="">-- Select Posting Profile --</option>
                                                            @foreach (var p in PostingProfiles)
                                                            {
                                                                <option value="@p.PostingProfileId">@p.ProfileName</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => type.DefaultPostingProfileId)" />
                                                    </div>
                                                }

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="AllowAutoPost"
                                                               @bind="type.AllowAutoPost"
                                                               @oninput="TouchPosting" />
                                                        <label class="form-check-label" for="AllowAutoPost">
                                                            Allow Auto Post
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="RequiresApproval"
                                                               @bind="type.RequiresApproval"
                                                               @oninput="TouchPosting" />
                                                        <label class="form-check-label" for="RequiresApproval">
                                                            Requires Approval
                                                        </label>
                                                    </div>
                                                </div>

                                                @if (type.RequiresApproval)
                                                {
                                                    <div class="col-sm-6 mb-3">
                                                        <label class="form-label">Approval Workflow Key <span class="text-danger">*</span></label>
                                                        <input class="@($"form-control {GetValidationClass(() => type.ApprovalWorkflowKey)}")"
                                                               maxlength="100"
                                                               @bind="type.ApprovalWorkflowKey"
                                                               placeholder="FIN_TXN_AP_VENDOR_BILL_WORKFLOW"
                                                               @oninput="TouchPosting" />
                                                        <ValidationMessage For="@(() => type.ApprovalWorkflowKey)" />
                                                    </div>
                                                }

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Document Policy -->
                    <div class="tl-card-row @(ShowDoc ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("doc"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowDoc ? "card-active border-green" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("doc"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-green">04</span>
                                        Document Number Policy
                                    </div>
                                    <span class="tl-card-toggle @(ShowDoc ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowDoc ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(DocTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Assignment Timing <span class="text-danger">*</span></label>
                                                    <select class="@($"form-select {GetValidationClass(() => type.DocumentNoAssignmentTiming)}")"
                                                            @bind="type.DocumentNoAssignmentTiming"
                                                            @oninput="TouchDoc">
                                                        @foreach (var v in Enum.GetValues<DocumentNoAssignmentTimings>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => type.DocumentNoAssignmentTiming)" />
                                                </div>

                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Document Series <span class="text-danger">*</span></label>
                                                    <select class="@($"form-select {GetValidationClass(() => type.DocumentNumberSeriesId)}")"
                                                            @bind="type.DocumentNumberSeriesId"
                                                            @oninput="TouchDoc">
                                                        <option value="">-- Select Series --</option>
                                                        @foreach (var d in DocumentNumberSeries)
                                                        {
                                                            <option value="@d.DocumentNumberSeriesId">@d.SeriesName</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => type.DocumentNumberSeriesId)" />
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Workflow Rules -->
                    <div class="tl-card-row @(ShowPolicies ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("policies"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowPolicies ? "card-active border-rose" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("policies"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-rose">05</span>
                                        Workflow Rules
                                    </div>
                                    <span class="tl-card-toggle @(ShowPolicies ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowPolicies ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(PolicyTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="AllowDraftEdit"
                                                               @bind="type.AllowDraftEdit"
                                                               @oninput="Touchpolicy" />
                                                        <label class="form-check-label" for="AllowDraftEdit">Allow Edit in Draft</label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="AllowDraftCancel"
                                                               @bind="type.AllowDraftCancel"
                                                               @oninput="Touchpolicy" />
                                                        <label class="form-check-label" for="AllowDraftCancel">Allow Cancel in Draft</label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="AllowReversal"
                                                               @bind="type.AllowReversal"
                                                               @oninput="Touchpolicy" />
                                                        <label class="form-check-label" for="AllowReversal">Allow Reversal After Posting</label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="AllowManualEntry"
                                                               @bind="type.AllowManualEntry"
                                                               @oninput="Touchpolicy" />
                                                        <label class="form-check-label" for="AllowManualEntry">Allow Manual Entry</label>
                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Currency Policy -->
                    <div class="tl-card-row @(ShowCurrency ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("currency"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowCurrency ? "card-active border-teal" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("currency"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-teal">06</span>
                                        Currency & Amount Policy
                                    </div>
                                    <span class="tl-card-toggle @(ShowCurrency ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowCurrency ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(CurrencyTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="AllowForeignCurrency"
                                                               @bind="type.AllowForeignCurrency"
                                                               @oninput="TouchCurrency" />
                                                        <label class="form-check-label" for="AllowForeignCurrency">Allow Foreign Currency</label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="AllowNegativeLines"
                                                               @bind="type.AllowNegativeLines"
                                                               @oninput="TouchCurrency" />
                                                        <label class="form-check-label" for="AllowNegativeLines">Allow Negative Lines</label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Amount Precision</label>
                                                    <input type="number"
                                                           min="0"
                                                           max="6"
                                                           placeholder="e.g. 2"
                                                           class="form-control"
                                                           @bind="type.AmountPrecisionPolicy"
                                                           @oninput="TouchCurrency" />
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Activation -->
                    <div class="tl-card-row @(ShowStatus ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("status"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowStatus ? "card-active border-yellow" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("status"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-yellow">07</span>
                                        Activation & Lifecycle
                                    </div>
                                    <span class="tl-card-toggle @(ShowStatus ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowStatus ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(StatusTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="IsActive"
                                                               @bind="type.IsActive"
                                                               @oninput="TouchStatus" />
                                                        <label class="form-check-label" for="IsActive">Active</label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="IsSystemDefined"
                                                               @bind="type.IsSystemDefined" />
                                                        <label class="form-check-label" for="IsSystemDefined">System Type</label>
                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>

            </div>
        </div>

        <!-- ACTIONS -->
        <div class="d-flex justify-content-end mb-4">
            <button type="button"
                    class="btn btn-outline-secondary me-2"
                    @onclick="BackToList">
                <i class="ti ti-x"></i> Cancel
            </button>

            <button type="submit"
                    class="btn btn-primary">
                <i class="ti ti-device-floppy"></i> @(IsEdit ? "Update" : "Save")
            </button>
        </div>

    </EditForm>

</div>


