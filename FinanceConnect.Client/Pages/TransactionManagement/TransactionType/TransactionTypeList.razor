@page "/transaction-types"

@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TransactionTypeService TypeService
@inject ToastService ToastService

<style>
    .form-select option:checked {
        color: #fff;
        background: #FE9F43;
    }

    .form-select:focus {
        border-color: #FE9F43;
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
<div class="content List-view">

    <!-- Page Header -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Transaction Types</h4>
                <h6>Transaction policy, approval & posting classification</h6>
            </div>
        </div>

        <ul class="table-top-head">
            <li>
                <a href="javascript:void(0);"
                   title="Refresh"
                           @onclick="OnRefreshAsync">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>

        <div class="page-btn">
            <a href="/transaction-types/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i>
                Create
            </a>
        </div>
    </div>

    <!-- LIST -->
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

            <!-- Search -->
            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset">
                        <i class="ti ti-search fs-14"></i>
                    </span>
                    <input type="search"
                           class="form-control form-control-sm"
                           placeholder="Search  code or name"
                           @bind="searchText"
                           @oninput="OnSearch" />
                </div>
            </div>

            <div style="display:flex;flex-wrap: wrap;gap:5px;">

                <!-- Company Filter -->
                <div>
                    <select class="form-select form-select-sm"
                            style="min-width: 180px"
                            @bind="SelectedCompany">
                        <option value="">All Companies</option>
                        @foreach (var c in Companies)
                        {
                            <option value="@c.Id">@c.LegalName</option>
                        }
                    </select>
                </div>

                <!-- Category Filter -->
                <div class="ms-2">
                    <select class="form-select form-select-sm"
                            style="min-width: 140px"
                            @bind="SelectedCategory">
                        <option value="">All Categories</option>
                                        @foreach (var v in Enum.GetValues<SourceCategory>())
                                        {
                                            <option value="@v">@v</option>
                                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="ms-2">
                    <select class="form-select form-select-sm"
                            style="min-width: 140px"
                            @bind="SelectedStatus">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>

        </div>

        <div class="card-body p-0">
            <div>
                <table class="table align-middle w-100 table-fixed">
                    <thead class="thead-light">
                        <tr>
                            <th class="d-xl-none" style="width:40px"></th>
                            <th class="td-width">Code</th>
                            <th style="width:300px" class="d-none d-md-table-cell">Name</th>
                            @* <th class="d-none d-md-table-cell">Category</th> *@
                            <th class="d-none d-xl-table-cell" title="Posting Profile">Posting Profile</th>
                            @* <th class="d-none d-xl-table-cell">Approval</th> *@
                            @* <th class="d-none d-xxl-table-cell">Document Series</th> *@
                            @* <th class="d-none d-xxl-table-cell" title="System Type">System Type</th> *@
                            <th class="d-none d-xxl-table-cell">Status</th>
                            <th class="no-sort">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (PagedTypes.Any())
                        {
                            @foreach (var t in PagedTypes)
                            {
                                <tr>
                                    <!-- PLUS ICON -->
                                    <td class="d-xl-none text-center" style="padding-left: 15px;">
                                        <a href="javascript:void(0);" class="TablePlus"
                                           data-bs-toggle="modal"
                                           data-bs-target="#rowDetailsModal"
                                           @onclick="() => ViewType(t)">
                                            <i class="ti ti-plus"></i>
                                        </a>
                                    </td>
                                    
                                    <td>
                                        <span class="fw-medium">
                                            <i class="ti ti-external-link me-2 PopupIcon"></i>
                                            <a @onclick="() => GoToViewPage(t)" data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               class="text-decoration-none link-View"
                                               title="@t.Code details">
                                                @t.Code
                                            </a>
                                        </span>

                                        @if (t.IsSystemDefined)
                                        {
                                            <span class="badge bg-warning-transparent text-warning ms-2"
                                                  title="System Defined">
                                                System
                                            </span>
                                        }
                                    </td>

                                    <td class="d-none d-md-table-cell">@t.Name</td>
                                    @* <td class="d-none d-md-table-cell" title="@t.SourceCategory">@t.SourceCategory</td> *@
                                    <td class="d-none d-xl-table-cell" title="@GetPostingProfileName(t)">@GetPostingProfileName(t)</td>


                                    @* <td class="d-none d-xl-table-cell">
                                        <span class="badge @(t.RequiresApproval ? "bg-info-transparent text-info" : "bg-secondary-transparent text-secondary")">
                                            @(t.RequiresApproval ? "Required" : "None")
                                        </span>
                                    </td> *@
                                    @* <td class="d-none d-xxl-table-cell">
                                        @(t.DocumentNumberSeriesId == Guid.Empty ? "-" : t.DocumentNumberSeriesId.ToString())
                                    </td> *@
                                    @* <td class="d-none d-xxl-table-cell">
                                        <span class="badge @(t.IsSystemDefined ? "bg-info-transparent text-info" : "bg-secondary-transparent text-secondary")">
                                            @(t.IsSystemDefined ? "Yes" : "No")
                                        </span>
                                    </td> *@

                                    <td class="d-none d-xxl-table-cell">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="ActiveDot @(t.IsActive ? "bg-success text-success" : "bg-secondary text-secondary")">
                                            </div>
                                            <span> @(t.IsActive ? "Active" : "Inactive")</span>
                                        </div>
                                    </td>


                                    <td class="action-table-data">
                                        <div class="edit-delete-action">

                                            <a class="me-2 edit-icon p-1"
                                               title="Edit"
                                                   @onclick='() => Nav.NavigateTo($"/transaction-types/{t.TransactionTypeId}")'>
                                                <i data-feather="edit"></i>
                                            </a>

                                            @if (t.IsActive)
                                            {
                                                <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon"
                                                   href="javascript:void(0);"
                                                   title="Deactivate"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#deactivate-modal"
                                                   @onclick="() => SelectType(t)">
                                                    <i class="ti ti-toggle-right"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="me-2 p-1 Toggle-icon action-icon activate-icon"
                                                   href="javascript:void(0);"
                                                   title="Activate"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#activate-modal"
                                                   @onclick="() => SelectType(t)">
                                                    <i class="ti ti-toggle-left"></i>
                                                </a>
                                            }

                                            <a class="p-1 delete-icon"
                                               title="Delete"
                                               data-bs-toggle="modal"
                                               data-bs-target="#delete-modal"
                                               @onclick="() => SelectType(t)">
                                                <i data-feather="trash-2"></i>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@VisibleColumnCount" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                        No transaction types found
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (PagedTypes.Any())
                {
                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center p-3">

                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto"
                                    @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">

                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                       @onclick="PreviousPage"
                                       @onclick:preventDefault>
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>

                                @foreach (var pageNumber in VisiblePages)
                                {
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button class="page-link"
                                                @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }

                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                       @onclick="NextPage"
                                       @onclick:preventDefault>
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

}
<!-- ACTIVATE MODAL -->
<div class="modal fade" id="activate-modal" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                        <i class="ti ti-toggle-right fs-24 text-success"></i>
                    </span>
                    <h4 class="fs-20 fw-bold mb-2">Activate Transaction Type</h4>
                    <p class="mb-0">
                        Are you sure you want to activate <strong>@SelectedType?.Name</strong>?
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button class="btn btn-success" data-bs-dismiss="modal"
                                @onclick="ActivateConfirmed">
                            <i class="ti ti-toggle-right me-1"></i>Yes, Activate
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DEACTIVATE MODAL -->
<div class="modal fade" id="deactivate-modal" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                        <i class="ti ti-toggle-left fs-24 text-warning"></i>
                    </span>
                    <h4 class="fs-20 fw-bold mb-2">Deactivate Transaction Type</h4>

                    @if (!canDeactivate)
                    {
                        <p class="text-danger">
                            Cannot deactivate — this type is in use by active transactions
                        </p>
                    }
                    else
                    {
                        <p>
                            Are you sure you want to deactivate <strong>@SelectedType?.Name</strong>?
                        </p>
                    }

                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        @if (canDeactivate)
                        {
                            <button class="btn btn-warning" data-bs-dismiss="modal"
                                    @onclick="DeactivateConfirmed">
                                <i class="ti ti-toggle-left me-1"></i>Yes, Deactivate
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="delete-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                        <i class="ti ti-trash fs-24 text-danger"></i>
                    </span>
                    <h4 class="fs-20 fw-bold mb-2">Delete Transaction Type</h4>
                    <p>
                        Are you sure you want to delete <strong>@SelectedType?.Name</strong>?
                    </p>
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                    <div class="modal-footer-btn mt-3 d-flex justify-content-center">
                        <button class="btn btn-outline-secondary me-2" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button class="btn btn-danger"
                                data-bs-dismiss="modal"
                                @onclick="DeleteConfirmed">
                            <i class="ti ti-trash me-1"></i>Yes, Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- VIEW MODAL -->

<div class="modal fade list-Popup"
     id="view-type-modal"
     tabindex="-1"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ti ti-settings me-2 text-primary"></i>
                    View Transaction Type
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        style="padding: 0;
                               right: 20px;
                               top: 20px;
                               position: absolute;">
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                @if (SelectedType != null)
                {
                    <div class="row g-3">

                        <!-- ================= IDENTITY ================= -->
                        <div class="col-12">
                            <h6 class="text-primary">
                                <i class="ti ti-id me-2"></i>Identity
                            </h6>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Type Code</label>
                            <div class="fw-medium">@SelectedType.Code</div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small">Type Name</label>
                            <div class="fw-medium text-truncate"
                                 style="max-width:95%;"
                                 title="@SelectedType.Name">
                                @SelectedType.Name
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Company</label>
                            <div>@GetCompanyName(SelectedType.CompanyId)</div>
                        </div>

                        <div class="col-md-8">
                            <label class="text-muted small">Description</label>
                            <div class="text-truncate"
                                 style="max-width:95%;"
                                 title="@SelectedType.Description">
                                @(string.IsNullOrWhiteSpace(SelectedType.Description) ? "-" : SelectedType.Description)
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Category</label>
                            <div>@SelectedType.SourceCategory</div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Transaction Nature</label>
                            <div>@(SelectedType.TransactionNature?.ToString() ?? "-")</div>
                        </div>

                        <!-- ================= POSTING & APPROVAL ================= -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary">
                                <i class="ti ti-lock me-2"></i>Posting & Approval Policy
                            </h6>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Postable to GL</label>
                            <div>
                                <span class="badge @(SelectedType.IsPostable ? "bg-success" : "bg-secondary")">
                                    @(SelectedType.IsPostable ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Auto Post</label>
                            <div>
                                <span class="badge @(SelectedType.AllowAutoPost ? "bg-success" : "bg-secondary")">
                                    @(SelectedType.AllowAutoPost ? "Allowed" : "Not Allowed")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Approval Required</label>
                            <div>
                                <span class="badge @(SelectedType.RequiresApproval ? "bg-warning" : "bg-success")">
                                    @(SelectedType.RequiresApproval ? "Required" : "Not Required")
                                </span>
                            </div>
                        </div>

                        @if (SelectedType.RequiresApproval)
                        {
                            <div class="col-md-8">
                                <label class="text-muted small">Approval Workflow Key</label>
                                <div class="text-truncate"
                                     style="max-width:95%;"
                                     title="@SelectedType.ApprovalWorkflowKey">
                                    @SelectedType.ApprovalWorkflowKey
                                </div>
                            </div>
                        }

                    <div class="col-md-4">
                        <label class="text-muted small">Posting Profile</label>
                        <div>
                            @(PostingProfiles?.ProfileName ?? "-")
                            </div>
                        </div>

                        <!-- ================= DOCUMENT NUMBER ================= -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary">
                                <i class="ti ti-hash me-2"></i>Document Number Policy
                            </h6>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Assignment Timing</label>
                            <div>@SelectedType.DocumentNoAssignmentTiming</div>
                        </div>

                        <div class="col-md-8">
                            <label class="text-muted small">Document Series</label>
                            <div>
                            @(SelectedType.DocumentNumberSeriesId == Guid.Empty ? "-" : SelectedType.DocumentNumberSeriesId.ToString())
                            </div>
                        </div>

                        <!-- ================= WORKFLOW RULES ================= -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary">
                                <i class="ti ti-shield-check me-2"></i>Workflow Rules
                            </h6>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Allow Draft Edit</label>
                            <div>@(SelectedType.AllowDraftEdit ? "Yes" : "No")</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Allow Draft Cancel</label>
                            <div>@(SelectedType.AllowDraftCancel ? "Yes" : "No")</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Allow Reversal</label>
                            <div>@(SelectedType.AllowReversal ? "Yes" : "No")</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Manual Entry</label>
                            <div>@(SelectedType.AllowManualEntry ? "Allowed" : "System Only")</div>
                        </div>

                        <!-- ================= CURRENCY & AMOUNT ================= -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary">
                                <i class="ti ti-currency-dollar me-2"></i>Currency & Amount Policy
                            </h6>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Foreign Currency</label>
                            <div>@(SelectedType.AllowForeignCurrency ? "Allowed" : "Not Allowed")</div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Negative Lines</label>
                            <div>@(SelectedType.AllowNegativeLines ? "Allowed" : "Not Allowed")</div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Amount Precision</label>
                            <div>@(SelectedType.AmountPrecisionPolicy?.ToString() ?? "-")</div>
                        </div>

                        <!-- ================= SYSTEM & STATUS ================= -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary">
                                <i class="ti ti-database me-2"></i>System & Status
                            </h6>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Active</label>
                            <div>
                                <span class="badge @(SelectedType.IsActive ? "bg-success" : "bg-secondary")">
                                    @(SelectedType.IsActive ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">System Type</label>
                            <div>
                                <span class="badge @(SelectedType.IsSystemDefined ? "bg-warning" : "bg-secondary")">
                                    @(SelectedType.IsSystemDefined ? "System" : "User")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Created At</label>
                            <div>@SelectedType.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Updated At</label>
                            <div>
                                @(SelectedType.UpdatedAt.HasValue
                                                            ? SelectedType.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                                            : "-")
                            </div>
                        </div>

                    </div>
                }
            </div>

        </div>
    </div>
</div>


<!-- RESPONSIVE ROW MODAL -->
<div class="modal fade list-Popup" id="rowDetailsModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ti ti-settings me-2 text-primary"></i>
                    Transaction Type
                </h5>
                <button class="btn-close"
                        data-bs-dismiss="modal"
                        style="position:absolute; right:22px;">
                </button>
            </div>

            @if (SelectedType != null)
            {
                <div class="modal-body">

                    <!-- Code -->
                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Code:</strong>
                        <div>@SelectedType.Code</div>
                    </div>

                    <!-- Name -->
                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Name:</strong>
                        <div>@SelectedType.Name</div>
                    </div>

                    <!-- Category -->
                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Category:</strong>
                        <div>@SelectedType.SourceCategory</div>
                    </div>

                    <!-- Posting Profile -->
                    <div class="mb-2 d-flex gap-3">
                        <strong>Posting Profile:</strong>
                        <div>
                            @(PostingProfiles?.ProfileName ?? "-")
                        </div>
                    </div>

                    <!-- Approval -->
                    <div class="mb-2 d-flex gap-3">
                        <strong>Approval:</strong>
                        <div>
                            <span class="badge @(SelectedType.RequiresApproval ? "bg-warning" : "bg-success")">
                                @(SelectedType.RequiresApproval ? "Required" : "Not Required")
                            </span>
                        </div>
                    </div>

                    <!-- Document Series -->
                    <div class="mb-2 d-flex gap-3">
                        <strong>Document Series:</strong>
                        <div>
                          @(SelectedType.DocumentNumberSeriesId == Guid.Empty ? "-" : SelectedType.DocumentNumberSeriesId.ToString())
                        </div>
                    </div>

                    <!-- System Type -->
                    <div class="mb-2 d-flex gap-3">
                        <strong>System Type:</strong>
                        <div>
                            <span class="badge @(SelectedType.IsSystemDefined ? "bg-warning" : "bg-secondary")">
                                @(SelectedType.IsSystemDefined ? "System" : "User")
                            </span>
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="mb-2 gap-3">
                        <strong>Status:</strong>
                        <span class="badge @(SelectedType.IsActive ? "bg-success" : "bg-secondary")">
                            @(SelectedType.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                </div>
            }

        </div>
    </div>
</div>



