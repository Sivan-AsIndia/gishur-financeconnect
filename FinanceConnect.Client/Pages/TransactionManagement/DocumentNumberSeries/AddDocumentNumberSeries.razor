@page "/document-series/create"
@page "/document-series/{Id:guid}"

@using FinanceConnect.Client.ViewModels
@inject IJSRuntime JS
@inject ToastService ToastService

<style>
    .form-select option:checked {
        color: #fff;
        background: var(--primary);
    }

    .form-select:focus {
        border-color: var(--primary);
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }

    .preview-box {
        background: #f8f9fa;
        border: 1px dashed #ddd;
        padding: 10px;
        font-family: monospace;
        border-radius: 5px;
    }
</style>

<div class="content Accordion-form">

    <!-- HEADER -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">@PageTitle</h4>
                <h6>@PageSubTitle</h6>
            </div>
        </div>

        <div class="page-btn mt-0">
            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="BackToList">
                <i class="ti ti-arrow-left"></i> Back
            </button>
        </div>
    </div>

    <EditForm EditContext="_editContext" OnSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="add-product" style="background:#f4f7fb; padding:24px 14px;">
            <div class="tl-accordion">

                <!-- LEFT PANEL – Fixed Sidebar -->
                <div class="tl-left-panel">

                    <!-- Identity -->
                    <div class="tl-label @(ShowIdentity ? "active accent-orange" : "")"
                         @onclick="@(() => ToggleAccordion("identity"))">
                        <div class="tl-label-icon ico-orange"><i data-feather="info"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Identity & Ownership</div>
                            <div class="tl-label-sub">Series code and ownership</div>
                        </div>
                        <span class="tl-label-chevron @(ShowIdentity ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <!-- Scope -->
                    <div class="tl-label @(ShowScope ? "active accent-blue" : "")"
                         @onclick="@(() => ToggleAccordion("scope"))">
                        <div class="tl-label-icon ico-blue"><i data-feather="sliders"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Scope & Reset Policy</div>
                            <div class="tl-label-sub">Counter scope and reset behavior</div>
                        </div>
                        <span class="tl-label-chevron @(ShowScope ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <!-- Format -->
                    <div class="tl-label @(ShowFormat ? "active accent-purple" : "")"
                         @onclick="@(() => ToggleAccordion("format"))">
                        <div class="tl-label-icon ico-purple"><i data-feather="hash"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Format Template</div>
                            <div class="tl-label-sub">Prefix, sequence & suffix</div>
                        </div>
                        <span class="tl-label-chevron @(ShowFormat ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <!-- Range -->
                    <div class="tl-label @(ShowRange ? "active accent-green" : "")"
                         @onclick="@(() => ToggleAccordion("range"))">
                        <div class="tl-label-icon ico-green"><i data-feather="trending-up"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Range & Increment</div>
                            <div class="tl-label-sub">Sequence limits</div>
                        </div>
                        <span class="tl-label-chevron @(ShowRange ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <!-- Assignment -->
                    <div class="tl-label @(ShowAssignment ? "active accent-rose" : "")"
                         @onclick="@(() => ToggleAccordion("assignment"))">
                        <div class="tl-label-icon ico-rose"><i data-feather="shield"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Assignment & Gap Handling</div>
                            <div class="tl-label-sub">Reservation & compliance</div>
                        </div>
                        <span class="tl-label-chevron @(ShowAssignment ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <!-- Status -->
                    <div class="tl-label @(ShowStatus ? "active accent-teal" : "")"
                         @onclick="@(() => ToggleAccordion("status"))">
                        <div class="tl-label-icon ico-teal"><i data-feather="check-circle"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Status & Control</div>
                            <div class="tl-label-sub">Activation and lock</div>
                        </div>
                        <span class="tl-label-chevron @(ShowStatus ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                </div>

                <!-- RIGHT AREA – Expanding Cards -->
                <div class="tl-right-area">

                    <!-- Identity -->
                    <div class="tl-card-row @(ShowIdentity ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("identity"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowIdentity ? "card-active border-orange" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("identity"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-orange">01</span>
                                        Identity & Ownership
                                    </div>
                                    <span class="tl-card-toggle @(ShowIdentity ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowIdentity ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(IdentityTouched ? "touched" : "")">

                                            <!-- FULL ORIGINAL CONTENT PRESERVED -->
                                            <div class="row">

                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Series Code <span class="text-danger">*</span></label>
                                                    <input class="@($"form-control text-uppercase {GetValidationClass(() => series.SeriesCode)}")"
                                                           @bind="SeriesCodeInput"
                                                           disabled="@IsEdit"
                                                           maxlength="50"
                                                           placeholder="e.g., FT_MAIN"
                                                           @oninput="TouchIdentity" />
                                                    <ValidationMessage For="@(() => series.SeriesCode)" />
                                                </div>

                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Series Name <span class="text-danger">*</span></label>
                                                    <input class="@($"form-control {GetValidationClass(() => series.SeriesName)}")"
                                                           @bind="series.SeriesName"
                                                           @bind:after="OnNameChanged"
                                                           maxlength="150"
                                                           placeholder="e.g. Financial Transactions Main"
                                                           @oninput="TouchIdentity" />
                                                    <ValidationMessage For="@(() => series.SeriesName)" />
                                                </div>

                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Company <span class="text-danger">*</span></label>
                                                    <select class="@($"form-select {GetValidationClass(() => series.CompanyId)}")"
                                                            disabled="@IsEdit"
                                                            @bind="series.CompanyId"
                                                            @oninput="TouchIdentity">
                                                        <option value="">-- Select Company --</option>
                                                        @foreach (var c in Companies)
                                                        {
                                                            <option value="@c.Id">@c.LegalName</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => series.CompanyId)" />
                                                </div>

                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Applies To <span class="text-danger">*</span></label>
                                                    <select class="form-select"
                                                            @bind="series.AppliesToEntityType"
                                                            @oninput="TouchIdentity">
                                                        @foreach (var e in Enum.GetValues<AppliesToEntityType>())
                                                        {
                                                            <option value="@e">@e</option>
                                                        }
                                                    </select>
                                                </div>
                                                @* maxlength="500" *@
                                                <div class="col-sm-12 mb-3">
                                                    <label class="form-label">Description</label>
                                                    <RichTextEditor @ref="_descriptionEditor"
                                                                    Value="@series.Description"
                                                                    MaxHeight="200" MinHeight="80"
                                                                    placeholder="Additional notes..." />
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Scope & Reset -->
                    <div class="tl-card-row @(ShowScope ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("scope"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowScope ? "card-active border-blue" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("scope"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-blue">02</span>
                                        Scope & Reset Policy
                                    </div>
                                    <span class="tl-card-toggle @(ShowScope ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowScope ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(ScopeTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Sequence Scope <span class="text-danger">*</span></label>
                                                    <select class="form-select"
                                                            @bind="series.SequenceScopeMode"
                                                            @oninput="TouchScope">
                                                        @foreach (var s in Enum.GetValues<SequenceScopeMode>())
                                                        {
                                                            <option value="@s">@s</option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Reset Frequency <span class="text-danger">*</span></label>
                                                    <select class="form-select"
                                                            @bind="series.ResetFrequency"
                                                            @oninput="TouchScope">
                                                        @foreach (var r in Enum.GetValues<ResetFrequency>())
                                                        {
                                                            <option value="@r">@r</option>
                                                        }
                                                    </select>
                                                </div>

                                                @if (series.ResetFrequency == ResetFrequency.Yearly)
                                                {
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Fiscal Year Mode <span class="text-danger">*</span></label>
                                                        <select class="form-select"
                                                                @bind="series.FiscalYearMode"
                                                                @oninput="TouchScope">
                                                            @foreach (var f in Enum.GetValues<FiscalYearMode>())
                                                            {
                                                                <option value="@f">@f</option>
                                                            }
                                                        </select>
                                                    </div>
                                                }

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Format Template -->
                    <div class="tl-card-row @(ShowFormat ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("format"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowFormat ? "card-active border-purple" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("format"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-purple">03</span>
                                        Format Template
                                    </div>
                                    <span class="tl-card-toggle @(ShowFormat ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowFormat ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(FormatTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Prefix Template</label>
                                                    <input class="form-control"
                                                           @bind="series.PrefixTemplate"
                                                           maxlength="120"
                                                           placeholder="FT/{FY}"
                                                           @oninput="TouchFormat" />
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Sequence Token Format <span class="text-danger">*</span></label>
                                                    <input class="@($"form-control {GetValidationClass(() => series.SequenceTokenFormat)}")"
                                                           @bind="series.SequenceTokenFormat"
                                                           maxlength="20" placeholder="00001"
                                                           @oninput="TouchFormat" />
                                                    <ValidationMessage For="@(() => series.SequenceTokenFormat)" />
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Suffix Template</label>
                                                    <input class="form-control"
                                                           @bind="series.SuffixTemplate"
                                                           maxlength="80" placeholder="AUTO"
                                                           @oninput="TouchFormat" />
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!--  Range & Increment  -->
                    <div class="tl-card-row @(ShowRange ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("range"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowRange ? "card-active border-green" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("range"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-green">04</span>
                                        Range & Increment
                                    </div>
                                    <span class="tl-card-toggle @(ShowRange ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowRange ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(RangeTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Min Sequence Value</label>
                                                    <input type="number" min="0"
                                                           class="form-control"
                                                           @bind="series.MinSequenceValue"
                                                           @oninput="TouchRange" />
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Max Sequence Value</label>
                                                    <input type="number" min="0"
                                                           class="form-control"
                                                           @bind="series.MaxSequenceValue"
                                                           @oninput="TouchRange" />
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Increment By</label>
                                                    <input type="number" min="0"
                                                           class="form-control"
                                                           @bind="series.IncrementBy"
                                                           @oninput="TouchRange" />
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Assignment & Gap Handling  -->
                    <div class="tl-card-row @(ShowAssignment ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("assignment"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowAssignment ? "card-active border-rose" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("assignment"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-rose">05</span>
                                        Assignment & Gap Handling
                                    </div>
                                    <span class="tl-card-toggle @(ShowAssignment ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowAssignment ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(AssignmentTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mt-3">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="AllowNumberPreview"
                                                               @bind="series.AllowNumberPreview"
                                                               @oninput="TouchAssignment" />
                                                        <label class="form-check-label" for="AllowNumberPreview">
                                                            Allow Number Preview
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Reservation Mode</label>
                                                    <select class="form-select"
                                                            @bind="series.ReservationMode"
                                                            @oninput="TouchAssignment">
                                                        @foreach (var r in Enum.GetValues<ReservationMode>())
                                                        {
                                                            <option value="@r">@r</option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Gap Handling Policy</label>
                                                    <select class="form-select"
                                                            @bind="series.GapHandlingPolicy"
                                                            @oninput="TouchAssignment">
                                                        @foreach (var g in Enum.GetValues<GapHandlingPolicy>())
                                                        {
                                                            <option value="@g">@g</option>
                                                        }
                                                    </select>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Status & Control -->
                    <div class="tl-card-row @(ShowStatus ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("status"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowStatus ? "card-active border-teal" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("status"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-teal">06</span>
                                        Status & Control
                                    </div>
                                    <span class="tl-card-toggle @(ShowStatus ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowStatus ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(StatusTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mt-3">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="IsActive"
                                                               @bind="series.IsActive"
                                                               @oninput="TouchStatus" />
                                                        <label class="form-check-label" for="IsActive">
                                                            Is Active
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mt-3">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="IsLocked"
                                                               @bind="series.IsLocked"
                                                               @oninput="TouchStatus" />
                                                        <label class="form-check-label" for="IsLocked">
                                                            Is Locked
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mt-3">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="IsSystemDefined"
                                                               @bind="series.IsSystemDefined"
                                                               @oninput="TouchStatus" />
                                                        <label class="form-check-label" for="IsSystemDefined">
                                                            System Defined (Lock Editing)
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mt-3">
                                                    <label class="form-label">Effective From</label>
                                                    <input type="date"
                                                           class="form-control"
                                                           @bind="series.EffectiveFrom"
                                                           @oninput="TouchStatus" />
                                                </div>

                                                <div class="col-sm-4 mt-3">
                                                    <label class="form-label">Effective To</label>
                                                    <input type="date"
                                                           class="form-control"
                                                           min="@(series.EffectiveFrom?.ToString("yyyy-MM-dd"))"
                                                           @bind="series.EffectiveTo"
                                                           @oninput="TouchStatus" />
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- ACTIONS -->
        <div class="d-flex justify-content-end mb-4">
            <button type="button" class="btn btn-outline-secondary me-2" @onclick="BackToList">
                <i class="ti ti-x"></i> Cancel
            </button>

            <button type="submit" class="btn btn-primary">
                <i class="ti ti-device-floppy"></i> @(IsEdit ? "Update" : "Save")
            </button>
        </div>

    </EditForm>
</div>
