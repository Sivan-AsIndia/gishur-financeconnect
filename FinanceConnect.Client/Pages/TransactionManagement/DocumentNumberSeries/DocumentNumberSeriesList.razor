@page "/document-series"
@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject DocumentNumberSeriesService SeriesService
@inject ToastService ToastService

<style>
    .form-select option:checked {
        color: #fff;
        background: #FE9F43;
    }

    .form-select:focus {
        border-color: #FE9F43;
        box-shadow: none;
    }
</style>


@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
<div class="content List-view">

    <!-- Page Header -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Document Number Series</h4>
                <h6>Manage numbering formats & compliance policies</h6>
            </div>
        </div>

        <ul class="table-top-head">
            <li>
                <a href="javascript:void(0);"
                   title="Refresh"
                   @onclick="OnRefreshAsync">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>

        <div class="page-btn">
            <a href="/document-series/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i>
                Create
            </a>
        </div>
    </div>

    <!-- Series List -->
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

            <!-- Search -->
            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset">
                        <i class="ti ti-search fs-14"></i>
                    </span>
                    <input type="search"
                           class="form-control form-control-sm"
                           placeholder="Search series code or name"
                           @bind="searchText"
                           @oninput="OnSearch" />
                </div>
            </div>

            <div style="display:flex">

                <!-- Company Filter -->
                <div>
                    <select class="form-select form-select-sm"
                            style="min-width: 180px"
                            @bind="SelectedCompany">
                        <option value="">All Companies</option>
                        @foreach (var c in Companies)
                        {
                            <option value="@c.Id">@c.LegalName</option>
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="ms-2">
                    <select class="form-select form-select-sm"
                            style="min-width: 140px"
                            @bind="SelectedStatus">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Locked">Locked</option>
                    </select>
                </div>
            </div>

        </div>

        <div class="card-body p-0">
            <div>
                <table class="table align-middle w-100 table-fixed">
                    <thead class="thead-light">
                        <tr>
                            <th class="d-xl-none" style="width:40px"></th>
                            <th class="td-width">Series Code</th>
                            <th class="d-none d-md-table-cell">Series Name</th>
                            <th class="d-none d-lg-table-cell">Applies To</th>
                            @* <th class="d-none d-lg-table-cell">Reset</th> *@
                            <th class="d-none d-xl-table-cell">Scope</th>
                            @* <th class="d-none d-xxl-table-cell">Preview</th> *@
                            <th class="d-none d-xl-table-cell">Status</th>
                            <th class="no-sort">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (PagedSeries.Any())
                        {
                            @foreach (var s in PagedSeries)
                            {
                                <tr>
                                    <!-- PLUS ICON -->
                                    <td class="d-xl-none text-center" style="padding-left: 15px;">
                                        <a href="javascript:void(0);" class="TablePlus"
                                           data-bs-toggle="modal"
                                           data-bs-target="#rowDetailsModal"
                                           @onclick="() => OpenRowDetails(s)">
                                            <i class="ti ti-plus"></i>
                                        </a>
                                    </td>

                                    <td>
                                        <span class="fw-medium d-flex ">
                                            <i class="ti ti-external-link me-2 PopupIcon"></i>
                                            <a @onclick="() => ViewSeries(s)" data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               class="text-decoration-none link-View"
                                               title="@s.SeriesCode details">
                                                @s.SeriesCode
                                            </a>
                                        </span>

                                        @if (s.IsSystemDefined)
                                        {
                                            <span class="badge bg-secondary-transparent text-secondary ms-2"
                                                  title="System Defined">
                                                System
                                            </span>
                                        }
                                    </td>

                                    <td class="d-none d-md-table-cell">@s.SeriesName</td>
                                    <td class="d-none d-lg-table-cell">@s.AppliesToEntityType</td>
                                    @* <td class="d-none d-lg-table-cell" title="@s.ResetFrequency">@s.ResetFrequency</td> *@
                                    <td class="d-none d-xl-table-cell">@s.SequenceScopeMode</td>

                                    @* <td class="d-none d-xxl-table-cell">
                                        <code class="small">@s.PreviewSample</code>
                                    </td> *@


                                    <td class="d-none d-xl-table-cell">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="ActiveDot @GetStatusDotBadge(s)">
                                            </div>
                                            <span> @GetStatusText(s)</span>
                                        </div>
                                    </td>


                                    <td class="action-table-data">
                                        <div class="edit-delete-action">

                                            <a class="me-2 edit-icon p-1"
                                               title="Edit Series"
                                                   @onclick='() => Nav.NavigateTo($"/document-series/{s.DocumentNumberSeriesId}")'>
                                                <i data-feather="edit"></i>
                                            </a>

                                            @if (s.IsActive && !s.IsLocked)
                                            {
                                                <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon"
                                                   href="javascript:void(0);"
                                                   title="Deactivate"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#deactivate-modal"
                                                   @onclick="() => ConfirmDeactivate(s)">
                                                    <i class="ti ti-toggle-right"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="me-2 p-1 Toggle-icon action-icon activate-icon"
                                                   href="javascript:void(0);"
                                                   title="Activate"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#activate-modal"
                                                   @onclick="() => ConfirmActivate(s)">
                                                    <i class="ti ti-toggle-left"></i>
                                                </a>
                                            }

                                            @if (!s.IsLocked)
                                            {
                                                <a class="p-1 delete-icon"
                                                   title="Delete Series"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#delete-modal"
                                                   @onclick="() => ConfirmDelete(s)">
                                                    <i data-feather="trash-2"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                        No document number series found
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (PagedSeries.Any())
                {
                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center p-3">

                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto"
                                    @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">

                                <!-- Prev -->
                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                       @onclick="PreviousPage"
                                       @onclick:preventDefault>
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>

                                <!-- Pages -->
                                @foreach (var pageNumber in VisiblePages)
                                {
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button"
                                                class="page-link"
                                                @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }

                                <!-- Next -->
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                       @onclick="NextPage"
                                       @onclick:preventDefault>
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Activate Modal -->
    <div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                            <i class="ti ti-toggle-right fs-24 text-success"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Document Series</h4>
                        <p class="text-gray-6 mb-0 fs-16" title="@SelectedSeries?.SeriesName">
                            Are you sure you want to activate <strong>@SelectedSeries?.SeriesName</strong>?
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-right me-1"></i>Yes, Activate</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Deactivate Modal -->
    <div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                            <i class="ti ti-toggle-left fs-24 text-warning"></i>
                        </span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate Document Series</h4>
                        <p class="text-gray-6 mb-0 fs-16" title="@SelectedSeries?.SeriesName">
                            @if (!canDeactivate)
                            {
                                <span class="text-danger">Cannot deactivate! Document Series has active references.</span>
                            }
                            else
                            {
                                <span>Are you sure you want to deactivate <strong>@SelectedSeries?.SeriesName</strong>?</span>
                            }
                        </p>
                        <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            @if (canDeactivate)
                            {
                                <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-left me-1"></i>Yes, Deactivate</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- delete modal -->
    <div class="modal fade" id="delete-modal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="p-5 px-3 text-center">
                        <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
                        <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Document Series</h4>
                        <p class="text-gray-6 mb-0 fs-16" title="@SelectedSeries?.SeriesName">
                            @if (!canDelete)
                            {
                                <span class="text-danger">Cannot Delete! Document Series has active references.</span>
                            }
                            else
                            {
                                <span>Are you sure you want to delete <strong>@SelectedSeries?.SeriesName</strong>?</span>
                            }
                            
                            </p>
                            @if (canDelete)
                            {
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                            }
                        <div class="modal-footer-btn mt-3 d-flex justify-content-center">
                            <button type="button" class="btn me-2 btn-outline-secondary fs-13 fw-medium p-2 px-3 shadow-none" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                            @if (canDelete)
                            {
                                <button type="submit" class="btn btn-danger fs-13 fw-medium p-2 px-3" @onclick="DeleteConfirmed"><i class="ti ti-trash me-1"></i>Yes, Delete</button>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

}
<!-- View Document Number Series Modal -->
<div class="modal fade" id="view-series-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ti ti-hash me-2 text-primary"></i>View Document Number Series
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding: 0; right: 20px; top: 20px; position: absolute;">
                </button>
            </div>

            <div class="modal-body">
                @if (SelectedSeries != null)
                {
                    <div class="row g-3">

                        <!-- ================= Series Identity ================= -->
                        <div class="col-12">
                            <h6 class="text-primary">
                                <i class="ti ti-id me-2"></i>Series Identity
                            </h6>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Series Code</label>
                            <div class="fw-medium">@SelectedSeries.SeriesCode</div>
                        </div>

                        <div class="col-md-5">
                            <label class="text-muted small">Series Name</label>
                            <div class="fw-medium text-truncate" style="max-width: 95%;"
                                 title="@SelectedSeries.SeriesName">
                                @SelectedSeries.SeriesName
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Company</label>
                            <div>@GetCompanyName(SelectedSeries?.CompanyId)</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Applies To</label>
                            <div>
                                <span class="badge bg-primary-transparent text-primary">
                                    @SelectedSeries.AppliesToEntityType
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Active</label>
                            <div>
                                @if (SelectedSeries.IsActive)
                                {
                                    <span class="badge bg-success-transparent text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-transparent text-secondary">Inactive</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">System Defined</label>
                            <div>
                                @if (SelectedSeries.IsSystemDefined)
                                {
                                    <span class="badge bg-warning-transparent text-warning">System</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-transparent text-secondary">User</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Effective Period</label>
                            <div>
                                @(SelectedSeries.EffectiveFrom?.ToString("dd-MMM-yyyy") ?? "-")
                                →
                                @(SelectedSeries.EffectiveTo?.ToString("dd-MMM-yyyy") ?? "Open")
                            </div>
                        </div>

                        <!-- ================= Scope & Reset Policy ================= -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary">
                                <i class="ti ti-settings me-2"></i>Scope & Reset Policy
                            </h6>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Scope Mode</label>
                            <div>
                                <span class="badge bg-info-transparent text-info">
                                    @SelectedSeries.SequenceScopeMode
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Reset Frequency</label>
                            <div>
                                <span class="badge bg-info-transparent text-info">
                                    @SelectedSeries.ResetFrequency
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Fiscal Year Mode</label>
                            <div>
                                @(SelectedSeries.FiscalYearMode?.ToString() ?? "-")
                            </div>
                        </div>

                        <!-- ================= Format Template ================= -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary">
                                <i class="ti ti-code me-2"></i>Format Template
                            </h6>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small">Prefix Template</label>
                            <div class="text-truncate" style="max-width: 95%;"
                                 title="@SelectedSeries.PrefixTemplate">
                                @(SelectedSeries.PrefixTemplate ?? "-")
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Sequence Format</label>
                            <div class="fw-medium">
                                @SelectedSeries.SequenceTokenFormat
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Separator</label>
                            <div>
                                @(SelectedSeries.Separator ?? "-")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small">Suffix Template</label>
                            <div class="text-truncate" style="max-width: 95%;"
                                 title="@SelectedSeries.SuffixTemplate">
                                @(SelectedSeries.SuffixTemplate ?? "-")
                            </div>
                        </div>

                        <!-- ================= Range & Allocation Policy ================= -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary">
                                <i class="ti ti-sliders me-2"></i>Range & Allocation Policy
                            </h6>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Min Value</label>
                            <div>@SelectedSeries.MinSequenceValue</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Max Value</label>
                            <div>@(SelectedSeries.MaxSequenceValue?.ToString() ?? "-")</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Increment By</label>
                            <div>@SelectedSeries.IncrementBy</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Allow Preview</label>
                            <div>
                                @if (SelectedSeries.AllowNumberPreview)
                                {
                                    <span class="badge bg-success-transparent text-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-transparent text-secondary">No</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Reservation Mode</label>
                            <div>
                                <span class="badge bg-warning-transparent text-warning">
                                    @SelectedSeries.ReservationMode
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Gap Handling</label>
                            <div>
                                <span class="badge bg-warning-transparent text-warning">
                                    @SelectedSeries.GapHandlingPolicy
                                </span>
                            </div>
                        </div>


                    </div>
                }
            </div>

        </div>
    </div>
</div>


<!-- Responsive modal -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Series Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>

            @if (SelectedSeries != null)
            {
                <div class="modal-body">

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Series:</strong>
                        <div class="text-truncate"
                             style="max-width: 95%;"
                             title="@SelectedSeries.SeriesName">
                            @SelectedSeries.SeriesName
                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Code:</strong>
                        <div>@SelectedSeries.SeriesCode</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Company:</strong>
                        <div>@GetCompanyName(SelectedSeries.CompanyId)</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Applies To:</strong>
                        <div>@SelectedSeries.AppliesToEntityType</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Reset:</strong>
                        <div>@SelectedSeries.ResetFrequency</div>
                    </div>

                    <div class="mb-2 gap-3">
                        <strong>Status:</strong>
                        <span class="badge @GetStatusBadge(SelectedSeries)">
                            @GetStatusText(SelectedSeries)
                        </span>
                    </div>

                </div>
            }
        </div>
    </div>
</div>
