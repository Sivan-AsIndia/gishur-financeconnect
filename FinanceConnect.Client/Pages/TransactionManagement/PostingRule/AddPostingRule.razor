@page "/posting-profiles/{ProfileId:guid}/rules/create"
@page "/posting-profiles/{ProfileId:guid}/rules/{Id:guid}"

@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services

<style>
    .form-select option:checked {
        color: #fff;
        background: #FE9F43;
    }

    .form-select:focus {
        border-color: #FE9F43;
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }
</style>
<div class="content Accordion-form">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">@PageTitle</h4>
                <h6>@PageSubTitle</h6>
            </div>
        </div>

        <div class="page-btn mt-0">
            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="BackToList">
                <i class="ti ti-arrow-left me-1"></i>Back
            </button>
        </div>
    </div>

    <EditForm EditContext="_editContext" OnSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="add-product" style="background:#f4f7fb; padding:24px 14px;">
            <div class="tl-accordion">

                <!------- LEFT PANEL – Fixed sidebar ---------->
                <div class="tl-left-panel">

                    <div class="tl-label @(ShowIdentity ? "active accent-orange" : "")"
                         @onclick="@(() => ToggleAccordion("identity"))">
                        <div class="tl-label-icon ico-orange"><i data-feather="tag"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Rule Identity</div>
                            <div class="tl-label-sub">Code, name and priority</div>
                        </div>
                        <span class="tl-label-chevron @(ShowIdentity ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowMatch ? "active accent-blue" : "")"
                         @onclick="@(() => ToggleAccordion("match"))">
                        <div class="tl-label-icon ico-blue"><i data-feather="filter"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Match Criteria</div>
                            <div class="tl-label-sub">When this rule applies</div>
                        </div>
                        <span class="tl-label-chevron @(ShowMatch ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowAmount ? "active accent-purple" : "")"
                         @onclick="@(() => ToggleAccordion("amount"))">
                        <div class="tl-label-icon ico-purple"><i data-feather="dollar-sign"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Amount Policy</div>
                            <div class="tl-label-sub">How much to post</div>
                        </div>
                        <span class="tl-label-chevron @(ShowAmount ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowAccounts ? "active accent-green" : "")"
                         @onclick="@(() => ToggleAccordion("accounts"))">
                        <div class="tl-label-icon ico-green"><i data-feather="credit-card"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Account Resolution</div>
                            <div class="tl-label-sub">Debit and credit logic</div>
                        </div>
                        <span class="tl-label-chevron @(ShowAccounts ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowOutput ? "active accent-rose" : "")"
                         @onclick="@(() => ToggleAccordion("output"))">
                        <div class="tl-label-icon ico-rose"><i data-feather="file-text"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Output Enrichment</div>
                            <div class="tl-label-sub">Narration & dimensions</div>
                        </div>
                        <span class="tl-label-chevron @(ShowOutput ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowStatus ? "active accent-teal" : "")"
                         @onclick="@(() => ToggleAccordion("status"))">
                        <div class="tl-label-icon ico-teal"><i data-feather="check-circle"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Lifecycle</div>
                            <div class="tl-label-sub">Activation & validity</div>
                        </div>
                        <span class="tl-label-chevron @(ShowStatus ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                </div>

                <!---- RIGHT AREA – Timeline Cards --------->
                <div class="tl-right-area">

                    <!---- RULE IDENTITY ---->
                    <div class="tl-card-row @(ShowIdentity ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("identity"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowIdentity ? "card-active border-orange" : "")">

                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("identity"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-orange">01</span>
                                        Rule Identity
                                    </div>
                                    <span class="tl-card-toggle @(ShowIdentity ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowIdentity ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(IdentityTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Rule Code <span class="text-danger">*</span></label>
                                                    <input class="@($"form-control text-uppercase {GetValidationClass(() => rule.RuleCode)}")"
                                                           @bind="RuleCodeInput"
                                                           disabled="@IsEdit"
                                                           maxlength="50" placeholder="AP_EXPENSE_TO_AP_CONTROL"
                                                           @oninput="TouchIdentity" />
                                                    <ValidationMessage For="@(() => rule.RuleCode)" />
                                                </div>

                                                <div class="col-sm-5 mb-3">
                                                    <label class="form-label">Rule Name <span class="text-danger">*</span></label>
                                                    <input class="@($"form-control {GetValidationClass(() => rule.RuleName)}")"
                                                           @bind="rule.RuleName"
                                                           @bind:after="OnNameChange"
                                                           maxlength="150" placeholder="AP EXPENSE"
                                                           @oninput="TouchIdentity" />
                                                    <ValidationMessage For="@(() => rule.RuleName)" />
                                                </div>

                                                <div class="col-sm-3 mb-3">
                                                    <label class="form-label">Posting Profile</label>
                                                    <input class="form-control"
                                                           @bind="PostingProfileName"
                                                           readonly />
                                                </div>


                                                <div class="col-sm-3 mb-3">
                                                    <label class="form-label">Priority <span class="text-danger">*</span></label>
                                                    <input type="number"
                                                           min="1"
                                                           class="form-control"
                                                           @bind="rule.Priority"
                                                           @oninput="TouchIdentity" />
                                                    <ValidationMessage For="@(() => rule.Priority)" />
                                                </div>

                                                <div class="col-sm-4 mt-3">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="StopProcessingAfterMatch"
                                                               @bind="rule.StopProcessingAfterMatch"
                                                               @oninput="TouchIdentity" />
                                                        <label class="form-check-label" for="StopProcessingAfterMatch">
                                                            Stop After Match
                                                        </label>
                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!---- MATCH CRITERIA -------->
                    <div class="tl-card-row @(ShowMatch ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("match"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowMatch ? "card-active border-blue" : "")">

                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("match"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-blue">02</span>
                                        Match Criteria
                                    </div>
                                    <span class="tl-card-toggle @(ShowMatch ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowMatch ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(MatchTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Posting Category</label>
                                                    <select class="form-select"
                                                            @bind="rule.MatchPostingCategory"
                                                            @oninput="TouchMatch">
                                                        @foreach (var p in Enum.GetValues<PostingCategory>())
                                                        {
                                                            <option value="@p">@p</option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Line Type</label>
                                                    <select class="form-select"
                                                            @bind="rule.MatchLineType"
                                                            @oninput="TouchMatch">
                                                        @foreach (var type in Enum.GetValues<LineType>())
                                                        {
                                                            <option value="@type">@type</option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Source Module</label>
                                                    <select class="form-select"
                                                            @bind="rule.MatchSourceModule"
                                                            @oninput="TouchMatch">
                                                        @foreach (var v in Enum.GetValues<SourceModuleType>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Match Transaction Type</label>
                                                    <select class="form-select"
                                                            @bind="rule.MatchTransactionTypeId"
                                                            @oninput="TouchMatch">
                                                        @foreach (var v in TransactionTypes)
                                                        {
                                                            <option value="@v.TransactionTypeId">@v.Name</option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Amount Sign</label>
                                                    <select class="form-select"
                                                            @bind="rule.MatchAmountSign"
                                                            @oninput="TouchMatch">
                                                        @foreach (var v in Enum.GetValues<AmountSignMode>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="col-sm-4 mb-3 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="MatchIsTaxLine"
                                                               @bind="rule.MatchIsTaxLine"
                                                               @oninput="TouchMatch" />
                                                        <label class="form-check-label" for="MatchIsTaxLine">
                                                            Tax Line?
                                                        </label>
                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!----AMOUNT POLICY--->
                    <div class="tl-card-row @(ShowAmount ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("amount"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowAmount ? "card-active border-purple" : "")">

                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("amount"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-purple">03</span>
                                        Amount Policy
                                    </div>
                                    <span class="tl-card-toggle @(ShowAmount ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowAmount ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(AmountTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Amount Basis <span class="text-danger">*</span></label>
                                                    <select class="form-select"
                                                            @bind="rule.AmountBasis"
                                                            @oninput="TouchAmount">
                                                        @foreach (var v in Enum.GetValues<AmountBasis>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => rule.AmountBasis)" />
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Multiplier</label>
                                                    <input type="number"
                                                           step="0.0001"
                                                           class="form-control"
                                                           @bind="rule.AmountMultiplier"
                                                           @oninput="TouchAmount" />
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Min Amount</label>
                                                    <input type="number"
                                                           class="form-control"
                                                           @bind="rule.MinimumAmount"
                                                           @oninput="TouchAmount" />
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Max Amount</label>
                                                    <input type="number"
                                                           class="form-control"
                                                           @bind="rule.MaximumAmount"
                                                           @oninput="TouchAmount" />
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!----ACCOUNT RESOLUTION ------>
                    <div class="tl-card-row @(ShowAccounts ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("accounts"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowAccounts ? "card-active border-green" : "")">

                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("accounts"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-green">04</span>
                                        Account Resolution
                                    </div>
                                    <span class="tl-card-toggle @(ShowAccounts ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowAccounts ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(AccountsTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Debit Source <span class="text-danger">*</span></label>
                                                    <select class="form-select"
                                                            @bind="rule.DebitAccountSourceType"
                                                            @oninput="TouchAccounts">
                                                        @foreach (var v in Enum.GetValues<AccountSourceRuleType>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                </div>

                                                @if (rule.DebitAccountSourceType == AccountSourceRuleType.FixedAccount)
                                                {
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Debit Account <span class="text-danger">*</span></label>
                                                        <select class="@($"form-select {GetValidationClass(() => rule.DebitAccountId)}")"
                                                                @bind="rule.DebitAccountId"
                                                                @oninput="TouchAccounts">
                                                            @foreach (var d in Accounts)
                                                            {
                                                                <option value="@d.Id">@d.AccountName</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => rule.DebitAccountId)" />
                                                    </div>
                                                }

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Debit Mapping / Account</label>
                                                    <input class="form-control"
                                                           placeholder="EXPENSE_DEFAULT / GST_INPUT"
                                                           @bind="rule.DebitAccountMappingKey"
                                                           @oninput="TouchAccounts" />
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Credit Source <span class="text-danger">*</span></label>
                                                    <select class="form-select"
                                                            @bind="rule.CreditAccountSourceType"
                                                            @oninput="TouchAccounts">
                                                        @foreach (var v in Enum.GetValues<AccountSourceRuleType>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => rule.CreditAccountSourceType)" />
                                                </div>

                                                @if (rule.CreditAccountSourceType == AccountSourceRuleType.FixedAccount)
                                                {
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Credit Account <span class="text-danger">*</span></label>
                                                        <select class="@($"form-select {GetValidationClass(() => rule.CreditAccountId)}")"
                                                                @bind="rule.CreditAccountId"
                                                                @oninput="TouchAccounts">
                                                            @foreach (var d in Accounts)
                                                            {
                                                                <option value="@d.Id">@d.AccountName</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => rule.CreditAccountId)" />
                                                    </div>
                                                }

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Credit Mapping / Account</label>
                                                    <input class="form-control"
                                                    placeholder="AP_CONTROL / BANK_DEFAULT" 
                                                           @bind="rule.CreditAccountMappingKey"
                                                           @oninput="TouchAccounts" />
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-----OUTPUT ENRICHMENT ----->
                    <div class="tl-card-row @(ShowOutput ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("output"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowOutput ? "card-active border-rose" : "")">

                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("output"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-rose">05</span>
                                        Output Enrichment
                                    </div>
                                    <span class="tl-card-toggle @(ShowOutput ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowOutput ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(OutputTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Output Narration Template</label>
                                                    <input class="form-control"
                                                    placeholder="AP Bill: {SourceDocumentNo} – {LineDescription}"
                                                           @bind="rule.OutputNarrationTemplate"
                                                           @oninput="TouchOutput" />
                                                </div>

                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Dimension Policy Key</label>
                                                    <input class="form-control"
                                                           placeholder="COSTCENTER_REQUIRED_FOR_EXPENSE"
                                                           @bind="rule.DimensionPolicyKey"
                                                           @oninput="TouchOutput" />
                                                </div>

                                                <div class="col-sm-4 mt-3">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="RequirePartyLink"
                                                               @bind="rule.RequirePartyLink"
                                                               @oninput="TouchOutput" />
                                                        <label class="form-check-label" for="RequirePartyLink">
                                                            Require Party Link
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-12 mt-2">
                                                    <div class="alert alert-info py-2 small">
                                                        <i class="ti ti-info-circle me-1"></i>
                                                        Use dimension policies to enforce cost center, project, or branch tagging at posting time.
                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-----LIFECYCLE----->
                    <div class="tl-card-row @(ShowStatus ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("status"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowStatus ? "card-active border-teal" : "")">

                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("status"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-teal">06</span>
                                        Lifecycle
                                    </div>
                                    <span class="tl-card-toggle @(ShowStatus ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowStatus ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(StatusTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mt-3">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="IsActive"
                                                               @bind="rule.IsActive"
                                                               @oninput="TouchStatus" />
                                                        <label class="form-check-label" for="IsActive">
                                                            Is Active
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mt-3">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="IsSystemDefined"
                                                               @bind="rule.IsSystemDefined"
                                                               @oninput="TouchStatus" />
                                                        <label class="form-check-label" for="IsSystemDefined">
                                                            Is System Defined
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Effective From</label>
                                                    <input type="date"
                                                           class="form-control"
                                                           @bind="rule.EffectiveFrom"
                                                           @oninput="TouchStatus" />
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Effective To</label>
                                                    <input type="date"
                                                           class="form-control"
                                                           @bind="rule.EffectiveTo"
                                                           @oninput="TouchStatus" />
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ACTIONS -->
        <div class="d-flex justify-content-end mb-4">
            <button type="button" class="btn btn-outline-secondary me-2"
                    @onclick="BackToList">
               <i class="ti ti-x me-1"></i>Cancel
            </button>

            <button type="submit" class="btn btn-primary">
               <i class="ti ti-device-floppy me-1"></i>@(IsEdit ? "Update" : "Save")
            </button>
        </div>

    </EditForm>

</div>
