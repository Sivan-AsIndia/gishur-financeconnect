@page "/posting-profiles/{ProfileId:guid}/rules"

@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels


<style>
    .form-select option:checked {
        color: #fff;
        background: #FE9F43;
    }

    .form-select:focus {
        border-color: #FE9F43;
        box-shadow: none;
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
    <div class="content List-view">

        <!-- ================= PAGE HEADER ================= -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Posting Rules</h4>
                    <h6>
                        Profile:
                        <span class="text-primary fw-medium">
                            @SelectedProfile?.ProfileCode — @SelectedProfile?.ProfileName
                        </span>
                    </h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">

                <a class="btn btn-primary me-2"
                href="javascript:void(0);"
                @onclick="AddRule">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>

                <a class="btn btn-outline-secondary"
                href="javascript:void(0);"
                @onclick="BackToProfiles">
                    <i class="ti ti-arrow-left me-1"></i>
                    Back
                </a>
            </div>
        </div>

        <!-- ================= RULE LIST ================= -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

                <!-- Search -->
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset">
                            <i class="ti ti-search fs-14"></i>
                        </span>
                        <input type="search"
                        class="form-control form-control-sm"
                        placeholder="Search rule code or name"
                        @bind="searchText"
                        @oninput="OnSearch" />
                    </div>
                </div>

                <div class="d-flex">

                    <!-- Active Filter -->
                    <div>
                        <select class="form-select form-select-sm"
                        style="min-width:140px"
                        @bind="SelectedStatus">
                            <option value="">All Status</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>

                </div>
            </div>

            <div class="card-body p-0">
                <table class="table align-middle w-100 table-fixed">
                    <thead class="thead-light">
                        <tr>
                            <th class="d-xl-none" style="width:40px"></th>
                            @* <th style="width:100px" title="Priority">Priority</th> *@
                            <th class="td-width" title="Rule Code">Rule Code</th>
                            <th class="d-none d-md-table-cell" title="Rule Name">Rule Name</th>
                            <th class="d-none d-lg-table-cell" title="Match">Match</th>
                            <th class="d-none d-xl-table-cell" title="Debit Source">Debit Source</th>
                            <th class="d-none d-xl-table-cell" title="Credit Source">Credit Source</th>
                            <th class="td-xxxl" style="Amount Basis">Amount Basis</th>
                            <th class="d-none d-xxl-table-cell">Status</th>
                            <th class="no-sort">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (PagedRules.Any())
                        {
                            @foreach (var r in PagedRules)
                            {
                                <tr>
                                    <!-- PLUS ICON -->
                                    <td class="d-xl-none text-center" style="padding-left: 15px;">
                                        <a href="javascript:void(0);" class="TablePlus"
                                        data-bs-toggle="modal"
                                        data-bs-target="#rowRuleDetailsModal"
                                        @onclick="() => ViewRule(r)">
                                            <i class="ti ti-plus"></i>
                                        </a>
                                    </td>
                                    @* <td class="fw-bold text-primary" title="@r.Priority">
                                    @r.Priority
                                </td> *@

                                    <td>
                                        <a href="javascript:void(0);"
                                        class="fw-medium link-View"
                                        title="@r.RuleCode Details" data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        @onclick="() => GoToRuleDetails(r)">
                                            @r.RuleCode
                                        </a>

                                        @if (r.IsSystemDefined)
                                        {
                                            <span class="badge bg-warning-transparent text-warning ms-2">
                                                System
                                            </span>
                                        }
                                    </td>

                                    <td class="d-none d-md-table-cell" title="@r.RuleName">
                                        @r.RuleName
                                    </td>

                                    <td class="d-none d-lg-table-cell" style="text-overflow:inherit">

                                        <!-- Posting Category -->
                                        <span class="badge bg-soft-info text-info me-1"
                                        data-bs-toggle="tooltip"
                                        title="Posting Category">
                                            <i class="ti ti-category"></i>
                                        </span>

                                        <!-- Line Type -->
                                        <span class="badge bg-soft-secondary text-secondary me-1"
                                        data-bs-toggle="tooltip"
                                        title="Line Type">
                                            <i class="ti ti-list-details"></i>
                                        </span>

                                        <!-- Tax / Non-Tax -->
                                        @if (r.MatchIsTaxLine.HasValue)
                                        {
                                            <span class="badge bg-soft-warning text-warning"
                                            data-bs-toggle="tooltip"
                                            title="Tax Indicator">

                                                @if (r.MatchIsTaxLine.Value)
                                                {
                                                    <i class="ti ti-receipt-tax "></i>
                                                }
                                                else
                                                {
                                                    <i class="ti ti-receipt-off"></i>
                                                }

                                            </span>
                                        }

                                    </td>


                                    <td class="d-none d-xl-table-cell" title="@r.DebitAccountSourceType">
                                        @r.DebitAccountSourceType
                                    </td>

                                    <td class="d-none d-xl-table-cell" title="@r.CreditAccountSourceType">
                                        @r.CreditAccountSourceType
                                    </td>

                                    <td class="td-xxxl" title="@r.AmountBasis">
                                        @r.AmountBasis
                                    </td>

                                    <td class="d-none d-xxl-table-cell">
                                        <span class="badge @(r.IsActive ? "bg-success-transparent text-success" : "bg-secondary-transparent text-secondary")">
                                            @(r.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>

                                    <td class="action-table-data">
                                        <div class="edit-delete-action">

                                            <a class="me-2 edit-icon p-1"
                                            title="Edit Rule"
                                            @onclick="() => EditRule(r)">
                                                <i data-feather="edit"></i>
                                            </a>

                                            @if (r.IsActive)
                                            {
                                                <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon"
                                                href="javascript:void(0);"
                                                title="Deactivate"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deactivate-modal"
                                                @onclick="() => SelectRule(r)">
                                                    <i class="ti ti-toggle-right"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="me-2 Toggle-icon p-1 action-icon activate-icon"
                                                href="javascript:void(0);"
                                                title="Activate"
                                                data-bs-toggle="modal"
                                                data-bs-target="#activate-modal"
                                                @onclick="() => SelectRule(r)">
                                                    <i class="ti ti-toggle-left"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(VisibleColumnCount == 0 ? 8 : VisibleColumnCount)" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                        No posting rules found
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (PagedRules.Any())
                {
                    <!-- ================= PAGINATION ================= -->
                    <div class="d-flex justify-content-between align-items-center p-3">

                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto"
                            @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">

                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                    @onclick="PreviousPage"
                                    @onclick:preventDefault>
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>

                                @foreach (var pageNumber in VisiblePages)
                                {
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button class="page-link"
                                        @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }

                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                    @onclick="NextPage"
                                    @onclick:preventDefault>
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Activate Modal -->
<div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                        <i class="ti ti-toggle-right fs-24 text-success"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Posting Rule</h4>
                    <p class="text-gray-6 mb-0 fs-16"  title="@SelectedRule?.RuleName">
                        Are you sure you want to activate <strong>@SelectedRule?.RuleName</strong>?
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-right me-1"></i>Yes, Activate</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Deactivate Modal -->
<div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                        <i class="ti ti-toggle-left fs-24 text-warning"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate Posting Rule</h4>
                    <p class="text-gray-6 mb-0 fs-16" title="@SelectedRule?.RuleName">
                        @if (!canDeactivate)
                        {
                            <span class="text-danger">Cannot deactivate!  posting Rule has active references.</span>
                        }
                        else
                        {
                            <span>Are you sure you want to deactivate <strong>@SelectedRule?.RuleName</strong>?</span>
                        }
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        @if (canDeactivate)
                        {
                            <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal">
                                <i class="ti ti-toggle-left me-1"></i>Yes, Deactivate
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="view-rule-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ti ti-filter me-2 text-primary"></i>View Posting Rule
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding: 0; right: 20px; top: 20px; position: absolute;">
                </button>
            </div>

            <div class="modal-body">
                @if (SelectedRule != null)
                {
                    <div class="row g-3">

                        <!-- ================= IDENTITY ================= -->
                        <div class="col-md-4">
                            <label class="text-muted small">Rule Code</label>
                            <div class="fw-medium">@SelectedRule.RuleCode</div>
                        </div>

                        <div class="col-md-5">
                            <label class="text-muted small">Rule Name</label>
                            <div class="fw-medium">@SelectedRule.RuleName</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Priority</label>
                            <div>@SelectedRule.Priority</div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Stop After Match</label>
                            <div>
                                <span class="badge @(SelectedRule.StopProcessingAfterMatch ? "bg-info-transparent text-info" : "bg-secondary-transparent text-secondary")">
                                    @(SelectedRule.StopProcessingAfterMatch ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <!-- ================= MATCH ================= -->
                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Posting Category</label>
                            <div>@(SelectedRule.MatchPostingCategory?.ToString() ?? "-")</div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Line Type</label>
                            <div>@(SelectedRule.MatchLineType?.ToString() ?? "-")</div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Source Module</label>
                            <div>@(SelectedRule.MatchSourceModule?.ToString() ?? "-")</div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Tax Line?</label>
                            <div>
                                <span class="badge @(SelectedRule.MatchIsTaxLine == true
                                                                          ? "bg-warning-transparent text-warning"
                                                                          : SelectedRule.MatchIsTaxLine == false
                                                                              ? "bg-secondary-transparent text-secondary"
                                                                              : "bg-light text-dark")">
                                    @(SelectedRule.MatchIsTaxLine == null
                                                                    ? "Any"
                                                                    : SelectedRule.MatchIsTaxLine.Value ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <!-- ================= AMOUNT ================= -->
                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Amount Basis</label>
                            <div>@SelectedRule.AmountBasis</div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Multiplier</label>
                            <div>@SelectedRule.AmountMultiplier</div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Min Amount</label>
                            <div>@(SelectedRule.MinimumAmount?.ToString() ?? "—")</div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Max Amount</label>
                            <div>@(SelectedRule.MaximumAmount?.ToString() ?? "—")</div>
                        </div>

                        <!-- ================= ACCOUNTS ================= -->
                        <div class="col-md-6 mt-3">
                            <label class="text-muted small">Debit Resolution</label>
                            <div class="fw-medium">
                                @SelectedRule.DebitAccountSourceType
                                @if (!string.IsNullOrWhiteSpace(SelectedRule.DebitAccountMappingKey))
                                {
                                    <span class="text-muted">(@SelectedRule.DebitAccountMappingKey)</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-6 mt-3">
                            <label class="text-muted small">Credit Resolution</label>
                            <div class="fw-medium">
                                @SelectedRule.CreditAccountSourceType
                                @if (!string.IsNullOrWhiteSpace(SelectedRule.CreditAccountMappingKey))
                                {
                                    <span class="text-muted">(@SelectedRule.CreditAccountMappingKey)</span>
                                }
                            </div>
                        </div>

                        <!-- ================= OUTPUT ================= -->
                        <div class="col-md-6 mt-3">
                            <label class="text-muted small">Output Narration</label>
                            <div>@(string.IsNullOrWhiteSpace(SelectedRule.OutputNarrationTemplate) ? "—" : SelectedRule.OutputNarrationTemplate)</div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Require Party Link</label>
                            <div>
                                <span class="badge @(SelectedRule.RequirePartyLink ? "bg-info-transparent text-info" : "bg-secondary-transparent text-secondary")">
                                    @(SelectedRule.RequirePartyLink ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Dimension Policy</label>
                            <div>@(string.IsNullOrWhiteSpace(SelectedRule.DimensionPolicyKey) ? "—" : SelectedRule.DimensionPolicyKey)</div>
                        </div>

                        <!-- ================= STATUS ================= -->
                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Active</label>
                            <div>
                                <span class="badge @(SelectedRule.IsActive ? "bg-success-transparent text-success" : "bg-secondary-transparent text-secondary")">
                                    @(SelectedRule.IsActive ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">System Defined</label>
                            <div>
                                <span class="badge @(SelectedRule.IsSystemDefined ? "bg-warning-transparent text-warning" : "bg-secondary-transparent text-secondary")">
                                    @(SelectedRule.IsSystemDefined ? "System" : "User")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Effective From</label>
                            <div>@(SelectedRule.EffectiveFrom?.ToShortDateString() ?? "—")</div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Effective To</label>
                            <div>@(SelectedRule.EffectiveTo?.ToShortDateString() ?? "—")</div>
                        </div>

                    </div>
                }
            </div>

        </div>
    </div>
</div>


<div class="modal fade list-Popup" id="rowRuleDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Posting Rule</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>

            @if (SelectedRule != null)
            {
                <div class="modal-body">

                    <div class="mb-2 d-flex gap-3">
                        <strong>Code:</strong>
                        <div>@SelectedRule.RuleCode</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Name:</strong>
                        <div>@SelectedRule.RuleName</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Priority:</strong>
                        <div>@SelectedRule.Priority</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Amount:</strong>
                        <div>@SelectedRule.AmountBasis (x@SelectedRule.AmountMultiplier)</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Debit:</strong>
                        <div>
                            @SelectedRule.DebitAccountSourceType
                            @if (!string.IsNullOrWhiteSpace(SelectedRule.DebitAccountMappingKey))
                            {
                                <span> (@SelectedRule.DebitAccountMappingKey)</span>
                            }
                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Credit:</strong>
                        <div>
                            @SelectedRule.CreditAccountSourceType
                            @if (!string.IsNullOrWhiteSpace(SelectedRule.CreditAccountMappingKey))
                            {
                                <span> (@SelectedRule.CreditAccountMappingKey)</span>
                            }
                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Status:</strong>
                        <span class="badge @(SelectedRule.IsActive ? "bg-success" : "bg-secondary")">
                            @(SelectedRule.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                </div>
            }
        </div>
    </div>
</div>
