@page "/transaction-status"
@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
    <div class="content List-view">

        <!-- PAGE HEADER -->
        <div class="page-header">
            <div class="add-item d-flex">
                <div class="page-title">
                    <h4 class="fw-bold">Transaction Status Master</h4>
                    <h6>Lifecycle & posting control layer</h6>
                </div>
            </div>

            <ul class="table-top-head">
                <li>
                    <a href="javascript:void(0);" title="Refresh" @onclick="OnRefreshAsync">
                        <i class="ti ti-refresh"></i>
                    </a>
                </li>
            </ul>

            <div class="page-btn">
                <a class="btn btn-primary"
                href="javascript:void(0);"
                @onclick="AddStatus">
                    <i class="ti ti-circle-plus me-1"></i>
                    Create
                </a>
            </div>
        </div>

        <!-- STATUS LIST -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

                <!-- Search -->
                <div class="search-set">
                    <div class="search-input">
                        <span class="btn-searchset">
                            <i class="ti ti-search fs-14"></i>
                        </span>
                        <input type="search"
                        class="form-control form-control-sm"
                        placeholder="Search status code or name"
                        @bind="searchText"
                        @oninput="OnSearch" />
                    </div>
                </div>

                <!-- Status Filter -->
                <div>
                    <select class="form-select form-select-sm"
                    style="min-width:140px"
                    @bind="SelectedStatus">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="card-body p-0">
                <table class="table align-middle w-100 table-fixed">
                    <thead class="thead-light">
                        <tr>
                            <th class="d-xl-none" style="width:40px"></th>
                            <th style="width:275px">Code</th>
                            <th class="d-none d-md-table-cell" style="width:275px">Name</th>
                            <th class="d-none d-md-table-cell">Stage</th>
                            <th class="td-xxxl">Header Edit</th>
                            @* <th class="d-none d-lg-table-cell">Post</th> *@
                            @* <th class="d-none d-xl-table-cell">Reverse</th> *@
                            <th class="d-none d-xl-table-cell">Final</th>
                            <th class="d-none d-xxl-table-cell">Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (PagedStatuses.Any())
                        {
                            @foreach (var s in PagedStatuses)
                            {
                                <tr>
                                    <!-- PLUS -->
                                    <td class="d-xl-none text-center">
                                        <a href="javascript:void(0);"
                                        class="TablePlus"
                                        data-bs-toggle="modal"
                                        data-bs-target="#rowDetailsModal"
                                        @onclick="() => ViewStatus(s)">
                                            <i class="ti ti-plus"></i>
                                        </a>
                                    </td>

                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            <div class="d-flex">
                                                <i class="ti ti-external-link me-2 PopupIcon"></i>
                                                <a href="javascript:void(0);" data-bs-toggle="tooltip"
                                                data-bs-placement="top" title="@s.Code Details"
                                                class="fw-medium link-View"
                                                @onclick="() => GoToStatusDetails(s)">
                                                    @s.Code
                                                </a>
                                            </div>

                                            @if (s.IsSystemDefined)
                                            {
                                                <span class="badge bg-warning-transparent text-warning" style="max-width: max-content;">
                                                    System
                                                </span>
                                            }
                                        </div>
                                    </td>

                                    <td class="d-none d-md-table-cell">
                                        <div class="fw-medium">@s.Name</div>

                                        @if (!string.IsNullOrWhiteSpace(s.BadgeLabel))
                                        {
                                            <span class="badge @GetBadgeClass(s.BadgeTone) mt-1">
                                                @s.BadgeLabel
                                            </span>
                                        }
                                    </td>

                                    <td class="d-none d-md-table-cell">
                                        <span class="badge bg-soft-info text-info">
                                            @s.StageCategory
                                        </span>
                                    </td>

                                    <td class="td-xxxl">
                                        <span class="badge @(s.AllowHeaderEdit ? "bg-success-transparent text-success" : "bg-secondary-transparent text-secondary")">
                                            @(s.AllowHeaderEdit ? "Yes" : "No")
                                        </span>
                                    </td>

                                    @*     <td class="d-none d-lg-table-cell">
                                <span class="badge @(s.AllowPost ? "bg-success-transparent text-success" : "bg-secondary-transparent text-secondary")">
                                    @(s.AllowPost ? "Yes" : "No")
                                </span>
                            </td>

                                <td class="d-none d-xl-table-cell">
                                <span class="badge @(s.AllowReverse ? "bg-warning-transparent text-warning" : "bg-secondary-transparent text-secondary")">
                                    @(s.AllowReverse ? "Yes" : "No")
                                </span>
                            </td> *@

                                    <td class="d-none d-xl-table-cell">
                                        <span class="badge @(s.IsFinal ? "bg-danger-transparent text-danger" : "bg-secondary-transparent text-secondary")">
                                            @(s.IsFinal ? "Locked" : "Open")
                                        </span>
                                    </td>


                                    <td class="d-none d-xxl-table-cell">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="ActiveDot @(s.IsActive ? "bg-success text-success" : "bg-secondary text-secondary")">
                                            </div>
                                            <span>@(s.IsActive ? "Active" : "Inactive")</span>
                                        </div>
                                    </td>


                                    <td class="action-table-data">
                                        <div class="edit-delete-action">

                                            <a class="me-2 edit-icon p-1"
                                            title="Edit"
                                            @onclick="() => EditStatus(s)">
                                                <i data-feather="edit"></i>
                                            </a>

                                            @if (!s.IsSystemDefined)
                                            {
                                                @if (s.IsActive)
                                                {
                                                    <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon"
                                                    title="Deactivate"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deactivate-modal"
                                                    @onclick="() => SelectStatus(s)">
                                                        <i class="ti ti-toggle-right"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="me-2 Toggle-icon p-1 action-icon activate-icon"
                                                    title="Activate"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#activate-modal"
                                                    @onclick="() => SelectStatus(s)">
                                                        <i class="ti ti-toggle-left"></i>
                                                    </a>
                                                }
                                                <a class="p-1 delete-icon"
                                                title="Delete"
                                                data-bs-toggle="modal"
                                                data-bs-target="#delete-modal"
                                                @onclick="() => SelectStatus(s)">
                                                    <i data-feather="trash-2"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@VisibleColumnCount" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                        No Transaction Status found
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (PagedStatuses.Any())
                {
                    <!-- PAGINATION -->
                    <div class="d-flex justify-content-between align-items-center p-3">

                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto"
                            @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">

                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                    @onclick="PreviousPage"
                                    @onclick:preventDefault>
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>

                                @foreach (var p in VisiblePages)
                                {
                                    <li class="page-item @(p == CurrentPage ? "active" : "")">
                                        <button class="page-link"
                                        @onclick="() => GoToPage(p)">
                                            @p
                                        </button>
                                    </li>
                                }

                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                    @onclick="NextPage"
                                    @onclick:preventDefault>
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Activate Modal -->
<div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                        <i class="ti ti-toggle-right fs-24 text-success"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Posting Profile</h4>
                    <p class="text-gray-6 mb-0 fs-16" title="@SelectedStatuses?.Name">
                        Are you sure you want to activate <strong>@SelectedStatuses?.Name</strong>?
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-right me-1"></i>Yes, Activate</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Deactivate Modal -->
<div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                        <i class="ti ti-toggle-left fs-24 text-warning"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate Posting Profile</h4>
                    <p class="text-gray-6 mb-0 fs-16"  title="@SelectedStatuses?.Name">
                        @if (!canDeactivate)
                        {
                            <span class="text-danger">Cannot deactivate!  posting profile has active references.</span>
                        }
                        else
                        {
                            <span>Are you sure you want to deactivate <strong>@SelectedStatuses?.Name</strong>?</span>
                        }
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        @if (canDeactivate)
                        {
                            <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-left me-1"></i>Yes, Deactivate</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- delete modal -->
<div class="modal fade" id="delete-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Transaction Status</h4>
                    <p class="text-gray-6 mb-0 fs-16" title="@SelectedStatuses?.Name">Are you sure you want to delete <strong>@SelectedStatuses?.Name</strong>?</p>
                                <div class="alert alert-danger mt-3 text-start small">
                                    <i class="ti ti-alert-triangle me-2"></i>
                                    This action cannot be undone.
                                </div>
                    <div class="modal-footer-btn mt-3 d-flex justify-content-center">
                        <button type="button" class="btn btn-outline-secondary me-2" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button type="submit" class="btn btn-danger"
                                data-bs-dismiss="modal" @onclick="DeleteConfirmed">
                            <i class="ti ti-trash me-1"></i>Yes, Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="view-status-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ti ti-shield-check me-2 text-primary"></i>View Transaction Status
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding: 0; right: 20px; top: 20px; position: absolute;">
                </button>
            </div>

            <div class="modal-body">
                @if (SelectedStatuses != null)
                {
                    <div class="row g-3">

                        <!-- ================= IDENTITY ================= -->
                        <div class="col-md-4">
                            <label class="text-muted small">Status Code</label>
                            <div class="fw-medium">@SelectedStatuses.Code</div>
                        </div>

                        <div class="col-md-5">
                            <label class="text-muted small">Status Name</label>
                            <div class="fw-medium">@SelectedStatuses.Name</div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Display Order</label>
                            <div>@SelectedStatuses.DisplayOrder</div>
                        </div>

                        <!-- ================= CLASSIFICATION ================= -->
                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Stage Category</label>
                            <div>
                                <span class="badge bg-soft-info text-info">
                                    @SelectedStatuses.StageCategory
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Final / Locked</label>
                            <div>
                                <span class="badge @(SelectedStatuses.IsFinal
                                                                                                                                                                                            ? "bg-danger-transparent text-danger"
                                                                                                                                                                                            : "bg-secondary-transparent text-secondary")">
                                    @(SelectedStatuses.IsFinal ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6 mt-3">
                            <label class="text-muted small">Description</label>
                            <div>
                                @(string.IsNullOrWhiteSpace(SelectedStatuses.Description)
                                                            ? "—"
                                                            : SelectedStatuses.Description)
                            </div>
                        </div>

                        <!-- ================= CONTROL FLAGS ================= -->
                        <div class="col-12 mt-3">
                            <h6 class="fw-bold text-muted mb-2">Control Policy</h6>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Header Editable</label>
                            <div>
                                <span class="badge @(SelectedStatuses.AllowHeaderEdit
                                                                                                                                                                                            ? "bg-success-transparent text-success"
                                                                                                                                                                                            : "bg-secondary-transparent text-secondary")">
                                    @(SelectedStatuses.AllowHeaderEdit ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Line Editable</label>
                            <div>
                                <span class="badge @(SelectedStatuses.AllowLineEdit
                                                                                                                                                                                            ? "bg-success-transparent text-success"
                                                                                                                                                                                            : "bg-secondary-transparent text-secondary")">
                                    @(SelectedStatuses.AllowLineEdit ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Delete Allowed</label>
                            <div>
                                <span class="badge @(SelectedStatuses.AllowDelete
                                                                                                                                                                                            ? "bg-info-transparent text-info"
                                                                                                                                                                                            : "bg-secondary-transparent text-secondary")">
                                    @(SelectedStatuses.AllowDelete ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Submit Allowed</label>
                            <div>
                                <span class="badge @(SelectedStatuses.AllowSubmit
                                                                                                                                                                                            ? "bg-info-transparent text-info"
                                                                                                                                                                                            : "bg-secondary-transparent text-secondary")">
                                    @(SelectedStatuses.AllowSubmit ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Approve / Reject</label>
                            <div>
                                <span class="badge @(SelectedStatuses.AllowApproveReject
                                                                                                                                                                                            ? "bg-warning-transparent text-warning"
                                                                                                                                                                                            : "bg-secondary-transparent text-secondary")">
                                    @(SelectedStatuses.AllowApproveReject ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Post Allowed</label>
                            <div>
                                <span class="badge @(SelectedStatuses.AllowPost
                                                                                                                                                                                            ? "bg-success-transparent text-success"
                                                                                                                                                                                            : "bg-secondary-transparent text-secondary")">
                                    @(SelectedStatuses.AllowPost ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Reverse Allowed</label>
                            <div>
                                <span class="badge @(SelectedStatuses.AllowReverse
                                                                                                                                                                                            ? "bg-warning-transparent text-warning"
                                                                                                                                                                                            : "bg-secondary-transparent text-secondary")">
                                    @(SelectedStatuses.AllowReverse ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small">Cancel Allowed</label>
                            <div>
                                <span class="badge @(SelectedStatuses.AllowCancel
                                                                                                                                                                                            ? "bg-danger-transparent text-danger"
                                                                                                                                                                                            : "bg-secondary-transparent text-secondary")">
                                    @(SelectedStatuses.AllowCancel ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <!-- ================= UI DISPLAY ================= -->
                        <div class="col-12 mt-3">
                            <h6 class="fw-bold text-muted mb-2">UI Display</h6>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Badge Label</label>
                            <div>@(string.IsNullOrWhiteSpace(SelectedStatuses.BadgeLabel) ? "—" : SelectedStatuses.BadgeLabel)</div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Badge Tone</label>
                            <div>@(SelectedStatuses.BadgeTone)</div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Scope</label>
                            <div>
                                @SelectedStatuses.CompanyScopeMode
                            </div>
                        </div>

                        <!-- ================= STATUS ================= -->
                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Active</label>
                            <div>
                                <span class="badge @(SelectedStatuses.IsActive
                                                                                                                                                                                            ? "bg-success-transparent text-success"
                                                                                                                                                                                            : "bg-secondary-transparent text-secondary")">
                                    @(SelectedStatuses.IsActive ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">System Defined</label>
                            <div>
                                <span class="badge @(SelectedStatuses.IsSystemDefined
                                                                                                                                                                                            ? "bg-warning-transparent text-warning"
                                                                                                                                                                                            : "bg-secondary-transparent text-secondary")">
                                    @(SelectedStatuses.IsSystemDefined ? "System" : "User")
                                </span>
                            </div>
                        </div>

                        <!-- ================= AUDIT ================= -->
                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Created</label>
                            <div>@SelectedStatuses.CreatedAt.ToShortDateString()</div>
                        </div>

                        <div class="col-md-3 mt-3">
                            <label class="text-muted small">Updated</label>
                            <div>@(SelectedStatuses.UpdatedAt?.ToShortDateString() ?? "—")</div>
                        </div>

                    </div>
                }
            </div>

        </div>
    </div>
</div>

<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Transaction Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>

            @if (SelectedStatuses != null)
            {
                <div class="modal-body">

                    <div class="mb-2 d-flex gap-3">
                        <strong>Code:</strong>
                        <div>@SelectedStatuses.Code</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Name:</strong>
                        <div>@SelectedStatuses.Name</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Stage:</strong>
                        <span class="badge bg-soft-info text-info">
                            @SelectedStatuses.StageCategory
                        </span>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Post Allowed:</strong>
                        <span class="badge @(SelectedStatuses.AllowPost ? "bg-success" : "bg-secondary")">
                            @(SelectedStatuses.AllowPost ? "Yes" : "No")
                        </span>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Final:</strong>
                        <span class="badge @(SelectedStatuses.IsFinal ? "bg-danger" : "bg-secondary")">
                            @(SelectedStatuses.IsFinal ? "Locked" : "Open")
                        </span>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Status:</strong>
                        <span class="badge @(SelectedStatuses.IsActive ? "bg-success" : "bg-secondary")">
                            @(SelectedStatuses.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                </div>
            }
        </div>
    </div>
</div>
