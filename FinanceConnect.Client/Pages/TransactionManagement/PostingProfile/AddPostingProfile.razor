@page "/posting-profiles/create"
@page "/posting-profiles/{Id:guid}"

@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels


<style>
    .form-select option:checked {
        color: #fff;
        background: var(--primary);
    }

    .form-select:focus {
        border-color: var(--primary);
        box-shadow: none;
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }
</style>

<div class="content Accordion-form">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">@PageTitle</h4>
                <h6>@PageSubTitle</h6>
            </div>
        </div>

        <div class="page-btn mt-0">
            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="BackToList">
                <i class="ti ti-arrow-left me-1"></i>Back
            </button>
        </div>
    </div>

    <EditForm EditContext="_editContext" OnSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="add-product" style="background:#f4f7fb; padding:24px 14px;">
            <div class="tl-accordion">

                <!--  LEFT PANEL  -->
                <div class="tl-left-panel">

                    <div class="tl-label @(ShowIdentity ? "active accent-orange" : "")"
                         @onclick="@(() => ToggleAccordion("identity"))">
                        <div class="tl-label-icon ico-orange"><i data-feather="info"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Profile Identity</div>
                            <div class="tl-label-sub">Code, name and ownership</div>
                        </div>
                        <span class="tl-label-chevron @(ShowIdentity ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowBehavior ? "active accent-purple" : "")"
                         @onclick="@(() => ToggleAccordion("behavior"))">
                        <div class="tl-label-icon ico-purple"><i data-feather="settings"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Posting Behavior</div>
                            <div class="tl-label-sub">Aggregation & rules</div>
                        </div>
                        <span class="tl-label-chevron @(ShowBehavior ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowFx ? "active accent-teal" : "")"
                         @onclick="@(() => ToggleAccordion("fx"))">
                        <div class="tl-label-icon ico-teal"><i data-feather="dollar-sign"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Rounding & FX</div>
                            <div class="tl-label-sub">Rounding & gain/loss</div>
                        </div>
                        <span class="tl-label-chevron @(ShowFx ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowMapping ? "active accent-blue" : "")"
                         @onclick="@(() => ToggleAccordion("mapping"))">
                        <div class="tl-label-icon ico-blue"><i data-feather="layers"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Mapping & Defaults</div>
                            <div class="tl-label-sub">Account resolution</div>
                        </div>
                        <span class="tl-label-chevron @(ShowMapping ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowNarration ? "active accent-rose" : "")"
                         @onclick="@(() => ToggleAccordion("narration"))">
                        <div class="tl-label-icon ico-rose"><i data-feather="file-text"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Narration Templates</div>
                            <div class="tl-label-sub">Journal & line formatting</div>
                        </div>
                        <span class="tl-label-chevron @(ShowNarration ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                    <div class="tl-label @(ShowStatus ? "active accent-green" : "")"
                         @onclick="@(() => ToggleAccordion("status"))">
                        <div class="tl-label-icon ico-green"><i data-feather="check-circle"></i></div>
                        <div class="tl-label-text">
                            <div class="tl-label-title">Activation & Lifecycle</div>
                            <div class="tl-label-sub">Validity & lock</div>
                        </div>
                        <span class="tl-label-chevron @(ShowStatus ? "open" : "")">
                            <i data-feather="chevron-right"></i>
                        </span>
                    </div>

                </div>


                <!-- RIGHT TIMELINE AREA -->
                <div class="tl-right-area">

                    <!-- Profile Identity -->
                    <div class="tl-card-row @(ShowIdentity ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("identity"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowIdentity ? "card-active border-orange" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("identity"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-orange">01</span>
                                        Profile Identity
                                    </div>
                                    <span class="tl-card-toggle @(ShowIdentity ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowIdentity ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(IdentityTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Profile Code <span class="text-danger">*</span></label>
                                                    <input class="@($"form-control text-uppercase {GetValidationClass(() => profile.ProfileCode)}")"
                                                           @bind="ProfileCodeInput"
                                                           maxlength="50"
                                                           disabled="@IsEdit"
                                                           placeholder="e.g. AP_VENDOR_BILL_PROFILE"
                                                           @oninput="TouchIdentity" />
                                                    <ValidationMessage For="@(() => profile.ProfileCode)" />
                                                </div>

                                                <div class="col-sm-5 mb-3">
                                                    <label class="form-label">Profile Name <span class="text-danger">*</span></label>
                                                    <input class="@($"form-control {GetValidationClass(() => profile.ProfileName)}")"
                                                           @bind="profile.ProfileName"
                                                           @bind:after="OnNameChanged"
                                                           maxlength="150"
                                                           placeholder="e.g. AP Vendor Bill Posting Profile"
                                                           @oninput="TouchIdentity" />
                                                    <ValidationMessage For="@(() => profile.ProfileName)" />
                                                </div>

                                                <div class="col-sm-3 mb-3">
                                                    <label class="form-label">Company <span class="text-danger">*</span></label>
                                                    <select class="@($"form-select {GetValidationClass(() => profile.CompanyId)}")"
                                                            @bind="profile.CompanyId"
                                                            disabled="@IsEdit"
                                                            @oninput="TouchIdentity">
                                                        <option value="">-- Select Company --</option>
                                                        @foreach (var c in Companies)
                                                        {
                                                            <option value="@c.Id">@c.LegalName</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => profile.CompanyId)" />
                                                </div>
                                                 @* maxlength="1000" *@
                                                <div class="col-sm-12 mb-3">
                                                    <label class="form-label">Description</label>
                                                              <RichTextEditor @ref="_descriptionEditor"
                                                                    Value="@profile.Description"
                                                                        MaxHeight="200" MinHeight="80"
                                                                    placeholder="Explain what this profile posts and when to use it" />
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Posting Behavior -->
                    <div class="tl-card-row @(ShowBehavior ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("behavior"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowBehavior ? "card-active border-purple" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("behavior"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-purple">02</span>
                                        Posting Behavior
                                    </div>
                                    <span class="tl-card-toggle @(ShowBehavior ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowBehavior ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(BehaviorTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Aggregation Mode <span class="text-danger">*</span></label>
                                                    <select class="@($"form-select {GetValidationClass(() => profile.AggregationMode)}")"
                                                            @bind="profile.AggregationMode"
                                                            @oninput="TouchBehavior">
                                                        <option value="">-- Select Mode --</option>
                                                        @foreach (var v in Enum.GetValues<AggregationMode>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => profile.AggregationMode)" />
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Rule Application Mode</label>
                                                    <select class="form-select"
                                                            @bind="profile.RuleApplicationMode"
                                                            @oninput="TouchBehavior">
                                                        @foreach (var v in Enum.GetValues<RuleApplicationMode>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="RequireCompleteRuleCoverage"
                                                               @bind="profile.RequireCompleteRuleCoverage"
                                                               @oninput="TouchBehavior" />
                                                        <label class="form-check-label" for="RequireCompleteRuleCoverage">
                                                            Require Complete Rule Coverage
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mt-3">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="AllowCatchAllRule"
                                                               @bind="profile.AllowCatchAllRule"
                                                               @oninput="TouchBehavior" />
                                                        <label class="form-check-label" for="AllowCatchAllRule">
                                                            Allow Catch-All Rule
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Balance Validation</label>
                                                    <select class="form-select"
                                                            @bind="profile.BalanceValidationMode"
                                                            @oninput="TouchBehavior">
                                                        @foreach (var v in Enum.GetValues<BalanceValidationMode>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Rounding & FX -->
                    <div class="tl-card-row @(ShowFx ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("fx"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowFx ? "card-active border-teal" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("fx"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-teal">03</span>
                                        Rounding & FX Policies
                                    </div>
                                    <span class="tl-card-toggle @(ShowFx ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowFx ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(FxTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Rounding Policy</label>
                                                    <select class="form-select"
                                                            @bind="profile.RoundingPolicyMode"
                                                            @oninput="TouchFx">
                                                        @foreach (var v in Enum.GetValues<RoundingPolicyMode>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                </div>

                                                @if (profile.RoundingPolicyMode == RoundingPolicyMode.CreateRoundingAdjustmentLine)
                                                {
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">Rounding Account Source <span class="text-danger">*</span></label>
                                                        <select class="form-select"
                                                                @bind="profile.RoundingAccountSourceType"
                                                                @oninput="TouchFx">
                                                            @foreach (var v in Enum.GetValues<AccountSourceType>())
                                                            {
                                                                <option value="@v">@v</option>
                                                            }
                                                        </select>
                                                    </div>
                                                }

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Rounding Mapping Key / Account</label>
                                                    <input class="form-control"
                                                           @bind="profile.RoundingMappingKey"
                                                           placeholder="ROUNDING_DEFAULT"
                                                           @oninput="TouchFx" />
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">FX Gain Policy</label>
                                                    <select class="form-select"
                                                            @bind="profile.FxGainLossPolicyMode"
                                                            @oninput="TouchFx">
                                                        @foreach (var v in Enum.GetValues<FxGainLossPolicyMode>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                </div>

                                                @if (profile.FxGainLossPolicyMode == FxGainLossPolicyMode.PostFxGainLossToConfiguredAccounts)
                                                {
                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">FX Gain Mapping Key <span class="text-danger">*</span></label>
                                                        <input class="form-control"
                                                               placeholder="FX_GAIN_DEFAULT"
                                                               @bind="profile.FxGainMappingKey"
                                                               @oninput="TouchFx" />
                                                    </div>

                                                    <div class="col-sm-4 mb-3">
                                                        <label class="form-label">FX Loss Mapping Key <span class="text-danger">*</span></label>
                                                        <input class="form-control"
                                                               placeholder="FX_LOSS_DEFAULT"
                                                               @bind="profile.FxLossMappingKey"
                                                               @oninput="TouchFx" />
                                                    </div>
                                                }

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Mapping & Defaults -->
                    <div class="tl-card-row @(ShowMapping ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("mapping"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowMapping ? "card-active border-blue" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("mapping"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-blue">04</span>
                                        Mapping & Defaults
                                    </div>
                                    <span class="tl-card-toggle @(ShowMapping ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowMapping ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(MappingTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="EnableCategory"
                                                               @bind="profile.EnableCategoryToAccountMapping"
                                                               @oninput="TouchedMapping" />
                                                        <label class="form-check-label" for="EnableCategory">
                                                            Enable Category → Account Mapping
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Mapping Scope</label>
                                                    <select class="form-select"
                                                            @bind="profile.MappingScopeMode"
                                                            @oninput="TouchedMapping">
                                                        @foreach (var v in Enum.GetValues<MappingScopeMode>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Default Control Account Policy</label>
                                                    <select class="form-select"
                                                            @bind="profile.DefaultControlAccountPolicy"
                                                            @oninput="TouchedMapping">
                                                        <option value="">-- Optional --</option>
                                                        @foreach (var v in Enum.GetValues<DefaultControlAccountPolicy>())
                                                        {
                                                            <option value="@v">@v</option>
                                                        }
                                                    </select>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Narration -->
                    <div class="tl-card-row @(ShowNarration ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("narration"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowNarration ? "card-active border-rose" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("narration"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-rose">05</span>
                                        Narration Templates
                                    </div>
                                    <span class="tl-card-toggle @(ShowNarration ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowNarration ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(NarrationTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Journal Narration Template</label>
                                                    <input class="form-control"
                                                    placeholder="{TransactionType}-{DocumentNo}-{SourceDocumentNo}"
                                                           @bind="profile.JournalNarrationTemplate"
                                                           @oninput="TouchNarration" />
                                                </div>

                                                <div class="col-sm-6 mb-3">
                                                    <label class="form-label">Line Narration Template</label>
                                                    <input class="form-control"
                                                    placeholder="{LineType}-{Description}"
                                                           @bind="profile.LineNarrationTemplate"
                                                           @oninput="TouchNarration" />
                                                </div>

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="includeSource"
                                                               @bind="profile.IncludeSourceDocumentNoInNarration"
                                                               @oninput="TouchNarration" />
                                                        <label class="form-check-label" for="includeSource">
                                                            Include Source Document No
                                                        </label>
                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Activation & Lifecycle -->
                    <div class="tl-card-row @(ShowStatus ? "row-active" : "")">
                        <div class="tl-dot-col">
                            <div class="tl-dot" @onclick="@(() => ToggleAccordion("status"))"></div>
                        </div>
                        <div class="tl-card-col">
                            <div class="tl-card @(ShowStatus ? "card-active border-green" : "")">
                                <div class="tl-card-header" @onclick="@(() => ToggleAccordion("status"))">
                                    <div class="tl-card-header-title">
                                        <span class="tl-card-step step-green">06</span>
                                        Activation & Lifecycle
                                    </div>
                                    <span class="tl-card-toggle @(ShowStatus ? "toggle-open" : "")">
                                        <i data-feather="chevron-down"></i>
                                    </span>
                                </div>

                                <div class="tl-collapse @(ShowStatus ? "tl-open" : "")">
                                    <div class="tl-card-body">
                                        <div class="tl-card-body-inner @(StatusTouched ? "touched" : "")">

                                            <div class="row">

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Effective From</label>
                                                    <input type="date"
                                                           class="form-control"
                                                           @bind="profile.EffectiveFrom"
                                                           @oninput="TouchStatus" />
                                                </div>

                                                <div class="col-sm-4 mb-3">
                                                    <label class="form-label">Effective To</label>
                                                    <input type="date"
                                                           class="form-control"
                                                           @bind="profile.EffectiveTo"
                                                           min="@(profile.EffectiveFrom?.ToString("yyyy-MM-dd"))"
                                                           @oninput="TouchStatus" />
                                                </div>

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="IsActive"
                                                               @bind="profile.IsActive"
                                                               @oninput="TouchStatus" />
                                                        <label class="form-check-label" for="IsActive">
                                                            Is Active
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="col-sm-4 mt-4">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox" id="IsSystemDefined"
                                                               disabled
                                                               @bind="profile.IsSystemDefined" />
                                                        <label class="form-check-label" for="IsSystemDefined">
                                                            System Defined
                                                        </label>
                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- ACTIONS -->
        <div class="d-flex justify-content-end mb-4">
            <button type="button" class="btn btn-outline-secondary me-2"
                    @onclick="BackToList">
                <i class="ti ti-x"></i> Cancel
            </button>

            <button type="submit" class="btn btn-primary">
                <i class="ti ti-device-floppy"></i> @(IsEdit ? "Update" : "Save")
            </button>
        </div>

    </EditForm>

</div>
<!-- Global Confirmation Modal -->
<div class="modal fade" id="confirm-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">

                    <span class="rounded-circle d-inline-flex p-2
                        @(ConfirmType == "danger" ? "bg-danger-transparent" : "bg-warning-transparent")
                        mb-2">
                        <i class="ti
                        @(ConfirmType == "danger" ? "ti-alert-circle text-danger" : "ti-alert-circle text-warning")
                        fs-24"></i>
                    </span>

                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">
                        @ConfirmTitle
                    </h4>

                    <p class="text-gray-6 mb-0 fs-16">
                        @ConfirmMessage
                    </p>

                    <div class="modal-footer-btn mt-3 d-flex justify-content-center" style="column-gap: 20px">

                        <button type="button"
                                class="btn btn-secondary fs-13 fw-medium p-2 px-3 shadow-none"
                                data-bs-dismiss="modal">
                            <i class="ti ti-x me-1"></i>Cancel
                        </button>

                        @if (ConfirmAction != null)
                        {
                            <button type="button"
                                    class="btn btn-primary fs-13 fw-medium p-2 px-3"
                                    @onclick="ConfirmYes">
                                <i class="ti ti-check me-1"></i>Yes, Continue
                            </button>
                        }

                    </div>


                </div>
            </div>
        </div>
    </div>
</div>