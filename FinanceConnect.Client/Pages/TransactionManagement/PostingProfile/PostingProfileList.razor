@page "/posting-profiles"
@using FinanceConnect.Client.Services
@using FinanceConnect.Client.ViewModels
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PostingProfileService ProfileService
@inject ToastService ToastService

<style>
    

    .validation-message {
        color: #dc3545;
        font-size: 12px;
    }
</style>

@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
<div class="content List-view">

    <!-- Page Header -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Posting Profiles</h4>
                <h6>Accounting templates & rule binding</h6>
            </div>
        </div>

        <ul class="table-top-head">
            <li>
                <a href="javascript:void(0);"
                   title="Refresh"
                           @onclick="OnRefreshAsync">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>

        <div class="page-btn">
            <a href="/posting-profiles/create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i>
                Create
            </a>
        </div>
    </div>

    <!-- Profile List -->
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

            <!-- Search -->
            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset">
                        <i class="ti ti-search fs-14"></i>
                    </span>
                    <input type="search"
                           class="form-control form-control-sm"
                           placeholder="Search profile code or name"
                           @bind="searchText"
                           @oninput="OnSearch" />
                </div>
            </div>

            <div style="display:flex">

                <!-- Company Filter -->
                <div>
                    <select class="form-select form-select-sm"
                            style="min-width: 180px"
                            @bind="SelectedCompany">
                        <option value="">All Companies</option>
                        @foreach (var c in Companies)
                        {
                            <option value="@c.Id">@c.LegalName</option>
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="ms-2">
                    <select class="form-select form-select-sm"
                            style="min-width: 140px"
                            @bind="SelectedStatus">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>

        </div>

        <div class="card-body p-0">
            <div>
                <table class="table align-middle w-100 table-fixed">
                    <thead class="thead-light">
                        <tr>
                            <th class="d-xxl-none" style="width:40px"></th>
                            <th class="td-width">Profile Code</th>
                            <th class="d-none d-md-table-cell">Profile Name</th>
                            <th class="d-none d-md-table-cell">Company</th>
                            @* <th class="d-none d-xxl-table-cell">Rules</th>
                            <th class="d-none d-xxl-table-cell">Usage</th> *@
                            <th class="d-none d-xl-table-cell">Aggregation</th>
                            <th class="d-none d-xxl-table-cell" style="width:110px">Status</th>
                            <th class="no-sort action-width">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (PagedProfiles.Any())
                        {
                            @foreach (var p in PagedProfiles)
                            {
                                <tr>
                                    <!-- PLUS ICON -->
                                    <td class="d-xxl-none text-center" style="padding-left: 15px;">
                                        <a href="javascript:void(0);" class="TablePlus"
                                           data-bs-toggle="modal"
                                           data-bs-target="#rowDetailsModal"
                                           @onclick="() => ViewProfile(p)">
                                            <i class="ti ti-plus"></i>
                                        </a>
                                    </td>

                                    <td>
                                        <span class="fw-medium" data-bs-toggle="tooltip"
                                              data-bs-placement="top">
                                            <span class="PopupIcon">⧉</span> 
                                            <a @onclick="() => ViewProfile(p)"
                                               class="text-decoration-none link-View"
                                               title="@p.ProfileCode details">
                                                @p.ProfileCode
                                            </a>
                                        </span>

                                        @if (p.IsSystemDefined)
                                        {
                                            <span class="badge bg-warning-transparent text-warning ms-2"
                                                  title="System Defined">
                                                System
                                            </span>
                                        }
                                    </td>

                                    <td class="d-none d-md-table-cell">@p.ProfileName</td>
                                    <td class="d-none d-md-table-cell">@GetCompanyName(p.CompanyId)</td>
                                    @* <td class="d-none d-xxl-table-cell" title="@p.RuleCount">@p.RuleCount</td>
                                    <td class="d-none d-xxl-table-cell" title="@p.UsageCount">@p.UsageCount</td> *@
                                    <td class="d-none d-xl-table-cell">@p.AggregationMode</td>

                                  
                                    <td class="d-none d-xxl-table-cell">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="ActiveDot @(p.IsActive ? "bg-success text-success" : "bg-danger text-danger")">
                                            </div>
                                            <span>@(p.IsActive ? "Active" : "Inactive")</span>
                                        </div>
                                    </td>



                                    <td class="action-table-data">
                                        <div class="edit-delete-action">

                                            <a class="me-2 edit-icon p-1"
                                               title="Edit Profile"
                                               @onclick='() => Nav.NavigateTo($"/posting-profiles/{p.PostingProfileId}")'>
                                                <i data-feather="edit"></i>
                                            </a>
                                            <a class="me-2 Layer-icon p-1" title="Open Profile Rule" href="@($"/posting-profiles/{p.PostingProfileId}/rules")">
                                                <i data-feather="layers"></i>
                                            </a>
                                            @if (p.IsActive)
                                            {
                                                <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon"
                                                   href="javascript:void(0);"
                                                   title="Deactivate"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#deactivate-modal"
                                                   @onclick="() => SelectProfile(p)">
                                                    <i class="ti ti-toggle-right"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="me-2 p-1 Toggle-icon action-icon activate-icon"
                                                   href="javascript:void(0);"
                                                   title="Activate"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#activate-modal"
                                                   @onclick="() => SelectProfile(p)">
                                                    <i class="ti ti-toggle-left"></i>
                                                </a>
                                            }

                                            <a class="p-1 delete-icon"
                                               title="Delete Profile"
                                               data-bs-toggle="modal"
                                               data-bs-target="#delete-modal"
                                               @onclick="() => SelectProfile(p)">
                                                <i data-feather="trash-2"></i>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                        No posting profiles found
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (PagedProfiles.Any())
                {
                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center p-3">

                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto"
                                    @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">

                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                       @onclick="PreviousPage"
                                       @onclick:preventDefault>
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>

                                @foreach (var pageNumber in VisiblePages)
                                {
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button class="page-link"
                                                @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }

                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                       @onclick="NextPage"
                                       @onclick:preventDefault>
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>


</div>

}
<!-- Activate Modal -->
<div class="modal fade" id="activate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                        <i class="ti ti-toggle-right fs-24 text-success"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Activate Posting Profile</h4>
                    <p class="text-gray-6 mb-0 fs-16" title="@SelectedProfile?.ProfileName">
                        @if (!canActivate)
                        {
                            <span class="text-danger">Cannot activate!  posting profile has no rules.</span>
                        }
                        else
                        {
                            <span>Are you sure you want to activate <strong>@SelectedProfile?.ProfileName</strong>?</span>
                        }
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        @if (canActivate)
                        {
                            <button type="button" class="btn btn-success fs-13 fw-medium p-2 px-4" @onclick="ActivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-right me-1"></i>Yes, Activate</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Deactivate Modal -->
<div class="modal fade" id="deactivate-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                        <i class="ti ti-toggle-left fs-24 text-warning"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Deactivate Posting Profile</h4>
                    <p class="text-gray-6 mb-0 fs-16" title="@SelectedProfile?.ProfileName">
                        @if (!canDeactivate)
                        {
                            <span class="text-danger">Cannot deactivate!  posting profile has active references.</span>
                        }
                        else
                        {
                            <span>Are you sure you want to deactivate <strong>@SelectedProfile?.ProfileName</strong>?</span>
                        }
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary fs-13 fw-medium p-2 px-4" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        @if (canDeactivate)
                        {
                            <button type="button" class="btn btn-warning fs-13 fw-medium p-2 px-4" @onclick="DeactivateConfirmed" data-bs-dismiss="modal"><i class="ti ti-toggle-left me-1"></i>Yes, Deactivate</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- delete modal -->
<div class="modal fade" id="delete-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Posting Profile</h4>
                    <p class="text-gray-6 mb-0 fs-16" title="@SelectedProfile?.ProfileName">
                        @if (!canDelete)
                        {
                            <span class="text-danger">Cannot Delete!  posting profile has active references.</span>
                        }
                        else
                        {
                            <span>Are you sure you want to delete <strong>@SelectedProfile?.ProfileName</strong>?</span>
                        }
                        
                        </p>
                    @if (canDelete)
                    {
                        <div class="alert alert-danger mt-3 text-start small">
                            <i class="ti ti-alert-triangle me-2"></i>
                            This action cannot be undone.
                        </div>
                    }
                    <div class="modal-footer-btn mt-3 d-flex justify-content-center">
                        <button type="button" class="btn btn-outline-secondary me-2" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        @if (canDelete)
                        {
                            <button type="submit" class="btn btn-danger"
                                    data-bs-dismiss="modal" @onclick="DeleteConfirmed">
                                <i class="ti ti-trash me-1"></i>Yes, Delete
                            </button>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- VIEW PROFILE offcanvas -->
<div class="offcanvas offcanvas-end offcanvas-view"
     tabindex="-1"
     id="viewProfileOffcanvas"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    @if (SelectedProfile != null)
    {
        <!--  HEADER  -->
        <div class="offcanvas-header">

            <div class="oc-avatar">
                @SelectedProfile.ProfileCode?.Substring(0,
                    Math.Min(2, SelectedProfile.ProfileCode.Length)).ToUpper()
            </div>

            <div class="oc-header-info">
                <div class="oc-header-top">
                    <h5>@SelectedProfile.ProfileName</h5>

                    <span class="oc-status-pill @(SelectedProfile.IsActive ? "active" : "inactive")">
                        <span class="oc-status-dot"></span>
                        @(SelectedProfile.IsActive ? "Active" : "Inactive")
                    </span>
                </div>

                <p class="oc-header-sub">
                    @SelectedProfile.ProfileCode
                </p>
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas">
            </button>
        </div>

        <!--  BODY  -->
        <div class="offcanvas-body">

            <!--  SUMMARY CARDS  -->
            <div class="oc-summary-row">

                <div class="oc-summary-card card-orange">
                    <div class="oc-summary-value">
                        @SelectedProfile.AggregationMode
                    </div>
                    <div class="oc-summary-label">Aggregation</div>
                </div>

                <div class="oc-summary-card card-blue">
                    <div class="oc-summary-value">
                        @SelectedProfile.RuleCount
                    </div>
                    <div class="oc-summary-label">Rules</div>
                </div>

                <div class="oc-summary-card card-green">
                    <div class="oc-summary-value">
                        @SelectedProfile.UsageCount
                    </div>
                    <div class="oc-summary-label">Usage</div>
                </div>

            </div>

            <!--  PROFILE IDENTITY  -->
            <div class="oc-card">
                <div class="oc-card-header hdr-orange">
                    <i class="ti ti-id"></i>
                    <h6 class="oc-card-title">Profile Identity</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-tag"></i> Profile Code
                            </div>
                            <div class="oc-field-value">
                                @SelectedProfile.ProfileCode
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-writing"></i> Profile Name
                            </div>
                            <div class="oc-field-value">
                                @SelectedProfile.ProfileName
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-building"></i> Company
                            </div>
                            <div class="oc-field-value">
                                @GetCompanyName(SelectedProfile.CompanyId)
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!--  RULE APPLICATION POLICY  -->
            <div class="oc-card">
                <div class="oc-card-header hdr-blue">
                    <i class="ti ti-filter"></i>
                    <h6 class="oc-card-title">Rule Application Policy</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-grid">

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-layers-difference"></i> Aggregation Mode
                            </div>
                            <div class="oc-field-value">
                                <span class="badge bg-info-transparent text-info">
                                    @SelectedProfile.AggregationMode
                                </span>
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-adjustments"></i> Rule Application Mode
                            </div>
                            <div class="oc-field-value">
                                <span class="badge bg-info-transparent text-info">
                                    @SelectedProfile.RuleApplicationMode
                                </span>
                            </div>
                        </div>

                        <div class="oc-grid-item">
                            <div class="oc-field-label">
                                <i class="ti ti-hash"></i> Rule Count
                            </div>
                            <div class="oc-field-value">
                                @SelectedProfile.RuleCount
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!--  USAGE & IMPACT  -->
            <div class="oc-card">
                <div class="oc-card-header hdr-green">
                    <i class="ti ti-activity"></i>
                    <h6 class="oc-card-title">Usage & Impact</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-link"></i> Linked Transaction Types
                            </span>
                            <span class="oc-list-value">
                                @(SelectedProfile.UsageCount > 0
                                    ? "In Use"
                                    : "Not Linked")
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-ban"></i> Can Deactivate
                            </span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedProfile.UsageCount > 0 ? "db-red" : "db-green")">
                                    <span class="dot"></span>
                                    @(SelectedProfile.UsageCount > 0 ? "Blocked" : "Allowed")
                                </span>
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-chart-bar"></i> Usage Count
                            </span>
                            <span class="oc-list-value">
                                @SelectedProfile.UsageCount
                            </span>
                        </div>

                    </div>
                </div>
            </div>

            <!--  STATUS & SYSTEM  -->
            <div class="oc-card">
                <div class="oc-card-header hdr-purple">
                    <i class="ti ti-shield-check"></i>
                    <h6 class="oc-card-title">Status & Audit</h6>
                </div>

                <div class="oc-card-body">
                    <div class="oc-list">

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-toggle-right"></i> Active
                            </span>
                            <span class="oc-list-value">
                                <span class="oc-dot-badge @(SelectedProfile.IsActive ? "db-green" : "db-red")">
                                    <span class="dot"></span>
                                    @(SelectedProfile.IsActive ? "Yes" : "No")
                                </span>
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-lock"></i> System Defined
                            </span>
                            <span class="oc-list-value">
                                <span class="badge @(SelectedProfile.IsSystemDefined
                                                    ? "bg-warning-transparent text-warning"
                                                    : "bg-secondary-transparent text-secondary")">
                                    @(SelectedProfile.IsSystemDefined ? "System" : "User")
                                </span>
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-calendar-plus"></i> Created
                            </span>
                            <span class="oc-list-value">
                                @(SelectedProfile.CreatedAt
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy HH:mm"))
                            </span>
                        </div>

                        <div class="oc-list-row">
                            <span class="oc-list-label">
                                <i class="ti ti-calendar-event"></i> Updated
                            </span>
                            <span class="oc-list-value">
                                @(SelectedProfile.UpdatedAt.HasValue
                                    ? SelectedProfile.UpdatedAt.Value
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy HH:mm")
                                    : "—")
                            </span>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    }
</div>


<!-- RESPONSIVE ROW MODAL -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Posting Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>

            @if (SelectedProfile != null)
            {
                <div class="modal-body">

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Code:</strong>
                        <div>@SelectedProfile.ProfileCode</div>
                    </div>

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Name:</strong>
                        <div>@SelectedProfile.ProfileName</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Usage:</strong>
                        <div>@SelectedProfile.UsageCount</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Rules:</strong>
                        <div>@SelectedProfile.RuleCount</div>
                    </div>

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Company:</strong>
                        <div>@GetCompanyName(SelectedProfile.CompanyId)</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Aggregation:</strong>
                        <div>@SelectedProfile.AggregationMode</div>
                    </div>

                    <div class="mb-2 gap-3">
                        <strong>Status:</strong>
                        <span class="badge @(SelectedProfile.IsActive ? "bg-success" : "bg-secondary")">
                            @(SelectedProfile.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                </div>
            }
        </div>
    </div>
</div>
