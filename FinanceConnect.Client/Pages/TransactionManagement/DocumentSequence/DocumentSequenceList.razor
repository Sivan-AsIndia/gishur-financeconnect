@page "/document-sequences"
@using FinanceConnect.Client.ViewModels
@using FinanceConnect.Client.Services
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject DocumentSequenceService SequenceService
@inject ToastService ToastService


@if (!isInitialized)
{
    <div class="page-loading-overlay">
        <div class="whirly-loader"></div>
    </div>
}
else
{

    @if (isLoading)
    {
        <div class="page-loading-overlay">
            <div class="whirly-loader"></div>
        </div>
    }
<div class="content List-view">

    <!-- Page Header -->
    <div class="page-header">
        <div class="add-item d-flex">
            <div class="page-title">
                <h4 class="fw-bold">Document Sequences</h4>
                <h6>Atomic counters & numbering integrity (Admin only)</h6>
            </div>
        </div>

        <ul class="table-top-head">
            <li>
                <a href="javascript:void(0);"
                   title="Refresh"
                   @onclick="OnRefreshAsync">
                    <i class="ti ti-refresh"></i>
                </a>
            </li>
        </ul>
    </div>

    <!-- Sequence List -->
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

            <!-- Search -->
            <div class="search-set">
                <div class="search-input">
                    <span class="btn-searchset">
                        <i class="ti ti-search fs-14"></i>
                    </span>
                    <input type="search"
                           class="form-control form-control-sm"
                           placeholder="Search series or reset key"
                           @bind="searchText"
                           @oninput="OnSearch" />
                </div>
            </div>

            <div style="display:flex">

                <!-- Company Filter -->
                <div>
                    <select class="form-select form-select-sm"
                            style="min-width: 180px"
                            @bind="SelectedCompany">
                        <option value="">All Companies</option>
                        @foreach (var c in Companies)
                        {
                            <option value="@c.Id">@c.LegalName</option>
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="ms-2">
                    <select class="form-select form-select-sm"
                            style="min-width: 140px"
                            @bind="SelectedStatus">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Locked">Locked</option>
                        <option value="Exhausted">Exhausted</option>
                    </select>
                </div>
            </div>

        </div>

        <div class="card-body p-0">
            <div>
                <table class="table align-middle w-100 table-fixed">
                    <thead class="thead-light">
                        <tr>
                            <th class="d-xxl-none" style="width:40px"></th>
                            <th style="width:230px">Series</th>
                            <th class="d-none d-md-table-cell">Reset Key</th>
                            <th class="d-none d-lg-table-cell">Scope</th>
                            <th class="d-none d-xl-table-cell">Current Value</th>
                            @* <th class="d-none d-xl-table-cell">Next Value</th> *@
                            <th class="d-none d-xxl-table-cell">Increment By</th>
                            <th class="d-none d-xxl-table-cell">Status</th>
                            <th class="no-sort">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (PagedSequences.Any())
                        {
                            @foreach (var s in PagedSequences)
                            {
                                <tr>
                                    <!-- PLUS ICON -->
                                    <td class="d-xxl-none text-center" style="padding-left: 15px;">
                                        <a href="javascript:void(0);" class="TablePlus"
                                           data-bs-toggle="modal"
                                           data-bs-target="#rowDetailsModal"
                                           @onclick="() => OpenRowDetails(s)">
                                            <i class="ti ti-plus"></i>
                                        </a>
                                    </td>

                                    <td>
                                        <span class="fw-medium link-View">
                                            <span class="PopupIcon">⧉</span>
                                            <a @onclick="() => ViewSequence(s)"
                                               class="text-decoration-none link-View"
                                               data-bs-toggle="modal"
                                               data-bs-target="#view-sequence-modal"
                                               title="@s.SeriesCode details">
                                                @s.SeriesCode
                                            </a>
                                        </span>

                                        @if (s.BranchScopeMode == BranchScopeMode.BranchSpecific)
                                        {
                                            <span class="badge bg-info-transparent text-info ms-2"
                                                  title="Branch Specific">
                                                Branch
                                            </span>
                                        }
                                    </td>

                                    <td class="d-none d-md-table-cell">@s.ResetKey</td>
                                    <td class="d-none d-lg-table-cell">@s.BranchScopeMode</td>
                                    <td class="d-none d-xl-table-cell fw-bold">@s.CurrentValue</td>
                                    @* <td class="d-none d-xl-table-cell">@(s.CurrentValue + s.IncrementBy)</td> *@
                                    <!-- INCREMENT -->
                                    <td class="d-none d-xxl-table-cell">
                                        +@s.IncrementBy
                                    </td>
                                    
                                    <td class="d-none d-xxl-table-cell">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="ActiveDot @GetDotStatusBadge(s)">
                                            </div>
                                            <span> @GetStatusText(s)</span>
                                        </div>
                                    </td>

                                    <td class="action-table-data">
                                        <div class="edit-delete-action">

                                            <!-- RESET (Controller Only) -->
                                            <a class="me-2 p-1 action-icon refresh"
                                               title="Reset Counter"
                                               data-bs-toggle="modal"
                                               data-bs-target="#reset-modal"
                                               @onclick="() => ConfirmReset(s)">
                                                <i class="ti ti-refresh"></i>
                                            </a>

                                            <!-- ADJUST (Highly Restricted) -->
                                            <a class="me-2 edit-icon p-1"
                                               title="Adjust Counter (Audit Logged)"
                                               @onclick="() => ConfirmAdjust(s)">
                                                <i class="ti ti-edit"></i>
                                            </a>

                                            @if (!s.IsLocked)
                                            {
                                                <a class="me-2 Toggle-icon p-1 action-icon deactivate-icon"
                                                   href="javascript:void(0);"
                                                   title="Lock Sequence"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#lock-modal"
                                                   @onclick="() => ConfirmLock(s)">
                                                    <i class="ti ti-lock"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="me-2 p-1 Toggle-icon action-icon activate-icon"
                                                   href="javascript:void(0);"
                                                   title="Unlock Sequence"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#unlock-modal"
                                                   @onclick="() => ConfirmUnlock(s)">
                                                    <i class="ti ti-lock-open"></i>
                                                </a>
                                            }

                                            @* <a class="p-1 delete-icon"
                                               title="Delete Sequence"
                                               data-bs-toggle="modal"
                                               data-bs-target="#delete-modal"
                                               @onclick="() => ConfirmDelete(s)">
                                                <i data-feather="trash-2"></i>
                                            </a> *@

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@VisibleColumnCount" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="ti ti-database-off fs-32 d-block mb-2"></i>
                                        No document sequences found
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (PagedSequences.Any())
                {
                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center p-3">

                        <div class="d-flex align-items-center fs-13">
                            <span class="me-2">Rows Per Page</span>
                            <select class="form-select form-select-sm w-auto"
                                    @onchange="OnPageSizeChange">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                            </select>
                            <span class="ms-2">Entries</span>
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">

                                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                       @onclick="PreviousPage"
                                       @onclick:preventDefault>
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>

                                @foreach (var pageNumber in VisiblePages)
                                {
                                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                                        <button type="button"
                                                class="page-link"
                                                @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }

                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="#"
                                       @onclick="NextPage"
                                       @onclick:preventDefault>
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>


</div>
}
<!-- LOCK MODAL -->
<div class="modal fade" id="lock-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                        <i class="ti ti-lock fs-24 text-warning"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Lock Sequence</h4>
                    <p class="text-gray-6 mb-0 fs-16"
                       title="@SelectedSequence?.SeriesCode">
                        Are you sure you want to lock the <strong>@SelectedSequence?.SeriesCode</strong>?
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button class="btn btn-warning"
                                data-bs-dismiss="modal"
                                @onclick="LockConfirmed">
                            <i class="ti ti-lock me-1"></i>Yes, Lock
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- UNLOCK MODAL -->
<div class="modal fade" id="unlock-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-success-transparent mb-2">
                        <i class="ti ti-lock-open fs-24 text-success"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Unlock Sequence</h4>
                    <p class="text-gray-6 mb-0 fs-16"
                       title="@SelectedSequence?.SeriesCode">
                        Are you sure you want to unlock the <strong>@SelectedSequence?.SeriesCode</strong>?
                    </p>
                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button class="btn btn-success"
                                data-bs-dismiss="modal"
                                @onclick="UnlockConfirmed">
                            <i class="ti ti-lock-open me-1"></i>Yes, Unlock
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="delete-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
                        <i class="ti ti-trash fs-24 text-danger"></i>
                    </span>
                    <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Sequence</h4>
                    <p class="text-gray-6 mb-0 fs-16"
                       title="@SelectedSequence?.SeriesCode">
                        Are you sure you want to delete <strong>@SelectedSequence?.SeriesCode</strong>?
                    </p>
                    <div class="modal-footer-btn mt-3 d-flex justify-content-center">
                        <button class="btn btn-outline-secondary me-2" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button class="btn btn-danger"
                                data-bs-dismiss="modal"
                                @onclick="DeleteConfirmed">
                            <i class="ti ti-trash me-1"></i>Yes, Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- VIEW MODAL -->
<div class="modal fade list-Popup"
     id="view-sequence-modal"
     tabindex="-1"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ti ti-hash me-2 text-primary"></i>View Document Sequence
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        style="padding: 0;
                               right: 20px;
                               top: 20px;
                               position: absolute;">
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                @if (SelectedSequence != null)
                {
                    <div class="row g-3">

                        <!-- ================= IDENTITY ================= -->
                        <div class="col-12">
                            <h6 class="text-primary">
                                <i class="ti ti-id me-2"></i>Sequence Identity
                            </h6>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Series Code</label>
                            <div class="fw-medium">@SelectedSequence.SeriesCode</div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Reset Key</label>
                            <div>@SelectedSequence.ResetKey</div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Scope Mode</label>
                            <div>@SelectedSequence.BranchScopeMode</div>
                        </div>

                        <!-- ================= NUMBERING ================= -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary">
                                <i class="ti ti-hash me-2"></i>Numbering Engine
                            </h6>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Current Value</label>
                            <div class="fw-bold">@SelectedSequence.CurrentValue</div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Increment By</label>
                            <div>@SelectedSequence.IncrementBy</div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Next Value</label>
                            <div>@(SelectedSequence.CurrentValue + SelectedSequence.IncrementBy)</div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Status</label>
                            <div>
                                <span class="badge @GetStatusBadge(SelectedSequence)">
                                    @GetStatusText(SelectedSequence)
                                </span>
                            </div>
                        </div>

                        <!-- ================= AUDIT ================= -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary">
                                <i class="ti ti-shield-check me-2"></i>Audit Trail
                            </h6>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Last Issued At</label>
                            <div>
                                @(SelectedSequence.LastIssuedAt?.ToString("dd-MMM-yyyy HH:mm") ?? "Never")
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small">Last Issued By</label>
                            <div>
                                @(SelectedSequence.LastIssuedBy ?? "-")
                            </div>
                        </div>

                    </div>
                }
            </div>

        </div>
    </div>
</div>

<!-- Responsive modal -->
<div class="modal fade list-Popup" id="rowDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Sequence Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="padding:0; right:22px; position:absolute;transform:none"></button>
            </div>

            @if (SelectedSequence != null)
            {
                <div class="modal-body">

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Series:</strong>
                        <div title="@SelectedSequence.SeriesCode">
                            @SelectedSequence.SeriesCode
                        </div>
                    </div>

                    <div class="mb-2 d-flex gap-3 d-md-none">
                        <strong>Reset Key:</strong>
                        <div>@SelectedSequence.ResetKey</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Scope:</strong>
                        <div>@SelectedSequence.BranchScopeMode</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Current:</strong>
                        <div class="fw-bold">@SelectedSequence.CurrentValue</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Increment By:</strong>
                        <div class="fw-bold">+@SelectedSequence.IncrementBy</div>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <strong>Current Value:</strong>
                        <div class="fw-bold">+@SelectedSequence.CurrentValue</div>
                    </div>

                    <div class="mb-2 d-flex gap-3">
                        <strong>Next:</strong>
                        <div>@(SelectedSequence.CurrentValue + SelectedSequence.IncrementBy)</div>
                    </div>

                    <div class="mb-2 gap-3">
                        <strong>Status:</strong>
                        <span class="badge @GetStatusBadge(SelectedSequence)">
                            @GetStatusText(SelectedSequence)
                        </span>
                    </div>

                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="reset-modal" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="page-wrapper-new p-0">
                <div class="p-5 px-3 text-center">
                    <span class="rounded-circle d-inline-flex p-2 bg-warning-transparent mb-2">
                        <i class="ti ti-refresh fs-24 text-warning"></i>
                    </span>
                    <h4 class="fw-bold mb-2">Reset Counter</h4>
                    <p class="text-muted">
                        Are you sure you want to reset sequence <strong>@SelectedSequence?.SeriesCode</strong>
                        for <code>@SelectedSequence?.ResetKey</code>
                    </p>

                    <div class="modal-footer-btn mt-4 d-flex justify-content-center gap-3">
                        <button class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="ti ti-x me-1"></i>Cancel</button>
                        <button class="btn btn-warning"
                                data-bs-dismiss="modal"
                                @onclick="ResetConfirmed">
                            <i class="ti ti-refresh me-1"></i>Yes, Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if(showAdjustModel){
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">

                <div class="modal-body text-center p-4">

                    <!-- ICON -->
                    <div class="mb-3">
                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center"
                              style="width:60px;height:60px;background:#fff1f1;">
                            <i class="ti ti-adjustments text-danger fs-28"></i>
                        </span>
                    </div>

                    <!-- TITLE -->
                    <h5 class="fw-bold mb-2">
                        Adjust Document Counter
                    </h5>

                    <!-- MESSAGE -->
                    <p class="text-muted mb-4">
                        This action will change the system sequence value and will be
                        <strong class="text-danger">audit logged</strong>.
                        Please provide a valid justification.
                    </p>

                    <!-- NEW VALUE -->
                    <div class="mb-3 text-start">
                        <label class="form-label small">
                            New Current Value <span class="text-danger">*</span>
                        </label>
                        <input type="number"
                               class="form-control"
                               min="0"
                               @bind="AdjustValue"
                               placeholder="Enter new counter value" />
                    </div>

                    <!-- REASON -->
                    <div class="mb-3 text-start">
                        <label class="form-label small">
                            Reason <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control"
                                  rows="3"
                                  maxlength="250"
                                  @bind="AdjustReason"
                                  placeholder="Explain why this counter needs adjustment"></textarea>
                    </div>

                    <!-- ACTIONS -->
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button class="btn btn-outline-secondary px-4"
                                @onclick="CloseAdjustModal">
                            <i class="ti ti-x me-1"></i>Cancel
                        </button>

                        <button class="btn btn-danger px-4"
                                @onclick="AdjustConfirmed">
                            <i class="ti ti-adjustments me-1"></i>Confirm Adjust
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
}


