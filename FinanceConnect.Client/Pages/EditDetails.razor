@code {
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		await Task.Delay(10);
		await JS.InvokeVoidAsync("initFeatherIcons");

	}
	[Parameter]
	public string? SKU { get; set; }
	Product? EditProduct;

	protected override void OnParametersSet()
	{
		EditProduct = ProductService.Products
						.FirstOrDefault(p => p.SKU == SKU);
	}
	void Save()
	{
		ProductService.AddProduct(new Product
		{
			IsSelected = false,

			SKU = EditProduct.SKU,
			ProductName = EditProduct.ProductName,
			Category = EditProduct.Category,
			Brand = EditProduct.Brand,

			Price = EditProduct.Price,
			Unit = EditProduct.Unit,
			Qty = EditProduct.Qty,

			CreatedBy = EditProduct.CreatedBy,

			// optional – image set pannala na default image
			ProductImage = string.IsNullOrEmpty(EditProduct.ProductImage)
		? "assets/images/stock-img-01.png"
		: EditProduct.ProductImage,

			UserImage = string.IsNullOrEmpty(EditProduct.UserImage)
		? "assets/images/user-30.jpg"
		: EditProduct.UserImage
		});


		EditProduct = new Product(); // clear form
		Nav.NavigateTo("/ProductList");

	}

}