                        @* Border Radius  *@
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <div class="" style="width: 100%;margin-bottom: 13px;">
                                <h4 class="accordion-button text-dark fs-16 px-0 py-3 bg-transparent">Border Radius</h4>

                                <div class="radius-slider-wrap">
                                    <input type="range"
                                           min="0"
                                           max="40"
                                           step="1"
                                           value="@borderRadiusLevel"
                                           class="radius-range"
                                           @oninput="OnBorderRadiusPreview" />

                                    <span class="radius-value">@borderRadiusLevel px</span>
                                </div>

                            </div>
                        </div>

                        @* Button Radius  *@
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <div class="" style="width: 100%;margin-bottom: 13px;">
                                <h4 class="accordion-button text-dark fs-16 px-0 py-3 bg-transparent">Button Radius</h4>

                                <div class="radius-slider-wrap">
