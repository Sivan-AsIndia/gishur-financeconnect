                                            <span class="tick">
                                                <i class="bi bi-check"></i>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }

                            @if (IsCustomIcon)
                            {
                                <div class="color-item">
                                    <div class="color-circle active"
                                         style="background:var(--icon-color)">

                                        <span class="tick">
                                            <i class="bi bi-check" ></i>
                                        </span>
                                    </div>
                                </div>
                            }

                            <label class="color-picker-btn">
                                <input type="color"
                                       value="@IconColor"
                                       @oninput="OnIconPreviewChanged" />
                                <i class="bi bi-eyedropper" style="color:var(--icon-color)"></i>
                            </label>

                        </div>
                    </div>
                </div>
            </div>
            @* Heading Color *@
            <div class="accordion-item border px-3">
                <h2 class="accordion-header">
                    <button class="accordion-button text-dark fs-16 px-0 py-3 bg-transparent"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#sidebarHeadingColor">
