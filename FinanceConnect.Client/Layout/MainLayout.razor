                    gap: 8px;
                    margin: 18px 0 10px;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 0.1em;
                    text-transform: uppercase;
                    color: #1313138a;
                }

                .ff-label-dot {
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: var(--primary);
                    flex-shrink: 0;
                }

                /* ── Font Grid ── */
                .ff-grid {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 6px;
                }

                /* ── Font Pill Button ── */
                .ff-pill {
                    padding: 6px 13px;
                    border-radius: 8px;
                    border: 1px solid rgb(181 180 180 / 64%);
                    background: rgb(109 106 106 / 9%);
                    color: #00000087;
                    font-size: 12px;
                    font-weight: 500;
                    cursor: pointer;
                    user-select: none;
                    white-space: nowrap;
                    line-height: 1.4;
                }

                    .ff-pill:hover {
                        border: 1px solid var(--primary);
                        color: var(--primary);
                        background: rgb(255 255 255 / 8%);
                    }

                    .ff-pill.active {
                        background: var(--primary);
                        border-color: var(--primary);
                        color: #fff;
                        box-shadow: 0 0 0 3px rgba(var(--primary-rgb), 0.4);
                        font-weight: 600;
                    }

                /* ── Active indicator badge ── */
                .ff-active-badge {
                    margin-left: 6px;
                    font-size: 9px;
                    letter-spacing: 0.05em;
                    background: rgb(0 0 0 / 13%);
                    border-radius: 4px;
                    padding: 1px 5px;
                    vertical-align: middle;
                }

            </style>

            @* Font Family *@
            <div class="accordion-item border px-3">
                <h2 class="accordion-header">
                    <button class="accordion-button text-dark fs-16 px-0 py-3 bg-transparent"
                            type="button" data-bs-toggle="collapse" data-bs-target="#fontSection">
                        Font Family
                    </button>
                </h2>
                <div id="fontSection" class="accordion-collapse collapse show">
                    <div class="accordion-body border-top p-0 mb-3">
                        <div class="ff-body p-0">

                            @* ── Menu Font ── *@
                            <div class="ff-label"><span class="ff-label-dot"></span>Menu Font</div>
                            <div class="ff-grid">
                                @foreach (var font in Fonts)
                                {
                                    <label class="ff-pill @(SelectedMenuFont == font.Value ? "active" : "")"
                                           @onclick="@(() => SetFont("--font-menu", font.Value, "menu"))">
                                        @font.Name
                                        @if (SelectedMenuFont == font.Value)
                                        {
                                            <span class="ff-active-badge" style="color: white;">✓</span>
                                        }
                                    </label>
                                }
                            </div>

                            @* ── Heading Font ── *@
                            <div class="ff-label"><span class="ff-label-dot"></span>Heading Font</div>
                            <div class="ff-grid">
                                @foreach (var font in Fonts)
                                {
                                    <label class="ff-pill @(SelectedHeadingFont == font.Value ? "active" : "")"
                                           @onclick="@(() => SetFont("--font-heading", font.Value, "heading"))">
                                        @font.Name
                                        @if (SelectedHeadingFont == font.Value)
                                        {
                                            <span class="ff-active-badge" style="color: white;">✓</span>
                                        }
                                    </label>
                                }
                            </div>

                            @* ── Number Font ── *@
                            <div class="ff-label"><span class="ff-label-dot"></span>Number Font</div>
                            <div class="ff-grid">
                                @foreach (var font in Fonts)
                                {
                                    <label class="ff-pill @(SelectedNumberFont == font.Value ? "active" : "")"
                                           @onclick="@(() => SetFont("--font-number", font.Value, "number"))">
                                        @font.Name
                                        @if (SelectedNumberFont == font.Value)
                                        {
                                            <span class="ff-active-badge" style="color: white;">✓</span>
                                        }
                                    </label>
                                }
                            </div>

                            @* ── Other Font ── *@
                            <div class="ff-label"><span class="ff-label-dot"></span>Other Font</div>
                            <div class="ff-grid">
                                @foreach (var font in Fonts)
                                {
                                    <label class="ff-pill @(SelectedOtherFont == font.Value ? "active" : "")"
                                           @onclick="@(() => SetFont("--font-other", font.Value, "other"))">
                                        @font.Name
                                        @if (SelectedOtherFont == font.Value)
                                        {
                                            <span class="ff-active-badge" style="color: white;">✓</span>
                                        }
                                    </label>
                                }
                            </div>

                        </div>

                    </div>
                </div>
            </div>

            @* Font Size & Style *@
            <div class="accordion-item border px-3">
                <h2 class="accordion-header">
                    <button class="accordion-button text-dark fs-16 px-0 py-3 bg-transparent"
                            type="button" data-bs-toggle="collapse" data-bs-target="#fontSizeSection">
                        <span class="d-flex align-items-center gap-2">
                            <span class="fs-icon-wrap">
                                <i class="bi bi-type"></i>
                            </span>
                            Font Size &amp; Style
                        </span>
                    </button>
                </h2>
                <div id="fontSizeSection" class="accordion-collapse collapse show">
                    <div class="accordion-body border-top p-0 pb-3">

                        @* Font Size *@
                        <div class="ff-label"><span class="ff-label-dot"></span>Font Size</div>
                        <div class="size-tile-grid">
                            @foreach (var size in FontSizes)
                            {
                                <div class="size-tile @(SelectedFontSize == size.ToString() ? "active" : "")"
                                     @onclick="@(() => SetFontSize(size))">
                                    <span class="size-num">@size</span>
                                    <span class="size-unit">px</span>
                                </div>
                            }
                        </div>

                        @* Font Weight *@
                        <div class="ff-label"><span class="ff-label-dot"></span>Font Weight</div>
                        <div class="weight-card-grid">
                            @foreach (var w in FontWeights)
                            {
                                <div class="weight-card @(SelectedFontWeight == w.Value ? "active" : "")"
                                     @onclick="@(() => SetFontWeight(w.Value))">
                                    <span class="weight-sample" style="font-weight:@w.Value">Aa</span>
                                    <span class="weight-name">@w.Label</span>
                                </div>
                            }
                        </div>

                        @* Line Height *@
                        <div class="ff-label"><span class="ff-label-dot"></span>Line Height</div>
                        <div class="lh-labels d-flex justify-content-between">
                            <span>Tight 1.2</span><span>Normal 1.6</span><span>Loose 2.2</span>
                        </div>
                        <div class="font-slider-wrap">
                            <input type="range" min="1.2" max="2.2" step="0.1"
                                   value="@SelectedLineHeight"
                                   class="font-range w-100"
                                   @oninput="OnLineHeightPreview" />
