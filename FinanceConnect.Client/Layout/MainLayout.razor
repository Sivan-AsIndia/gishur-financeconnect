                                <div class="color-item"
                                     @onclick="() => SetHeadingPreset(color)">

                                    <div class="color-circle @(HeadingColor?.ToLower() == color.ToLower() ? "active" : "")"
                                         style="background:@color">

                                        @if (HeadingColor?.ToLower() == color.ToLower())
                                        {
                                            <span class="tick">
                                                <i class="bi bi-check"></i>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }

                            @if (IsCustomHeading)
                            {
                                <div class="color-item">
                                    <div class="color-circle active"
                                         style="background:var(--heading-color)">

                                        <span class="tick">
