                                <div class="img-opt"
                                     data-url="@img"
                                     style="background-image:url('@img')"
                                     @onclick="() => OnProfilePreview(img)">
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>


        </div>


        <div class="p-3 pt-0 themeFooter" style="    position: absolute;
    bottom: 0;
    width: 100%;
    background: white;
    right: 0;
    left: 0;z-index: 11111111;
    padding-top: 17px !important;">
            <div class="row gx-3">
                <div class="col-6">
                    <a href="#"
