                <div id="sidebarbgsetting" class="accordion-collapse collapse show">
                    <div class="accordion-body pb-1 px-0 py-3 border-top">
                        <div class="d-flex align-items-center flex-wrap gap-2">

                            <!-- NONE OPTION -->
                            <div class="bg-card @(SelectedBg == null ? "selected" : "")"
                                 @onclick="() => SelectBg(null)" style="background: #80808012;">

                                <div class="none-bg" style="    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    margin-top: 10px;">
                                    <i class="ti ti-ban"></i>
                                    <span>None</span>
                                </div>

                                @if (SelectedBg == null)
                                {
                                    <span class="check-icon">✓</span>
                                }
                            </div>

                            @foreach (var bg in Backgrounds)
                            {
                                <div class="bg-card @(SelectedBg == bg ? "selected" : "")"
                                     @onclick="() => SelectBg(bg)">

                                    <img src="@bg" />

                                    @if (SelectedBg == bg)
                                    {
                                        <span class="check-icon">✓</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* Icon Color *@
            <div class="accordion-item border px-3">
                <h2 class="accordion-header">
                    <button class="accordion-button text-dark fs-16 px-0 py-3 bg-transparent"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#sidebarIconColor">
                        Icon Colors
                    </button>
                </h2>

                <div id="sidebarIconColor" class="accordion-collapse collapse show">
                    <div class="accordion-body pb-2 px-0 py-3 border-top">

                        <div class="color-wrapper d-flex flex-wrap">

                            @foreach (var color in IconPresets)
                            {
                                <div class="color-item"
                                     @onclick="() => SetIconPreset(color)">

                                    <div class="color-circle @(IconColor?.ToLower() == color.ToLower() ? "active" : "")"
                                         style="background:@color">

                                        @if (IconColor?.ToLower() == color.ToLower())
