                <div id="sidebarHeadingColor" class="accordion-collapse collapse show">
                    <div class="accordion-body pb-2 px-0 py-3 border-top">

                        <div class="color-wrapper d-flex flex-wrap">

                            @foreach (var color in HeadingPresets)
