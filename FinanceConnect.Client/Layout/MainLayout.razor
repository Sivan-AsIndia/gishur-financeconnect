    List<(string Name, string Value)> Fonts = new()
    {
        ("Inter",      "Inter, sans-serif"),
        ("Roboto",     "Roboto, sans-serif"),
        ("Poppins",    "Poppins, sans-serif"),
        ("Nunito",     "Nunito, sans-serif"),
        ("Georgia",    "Georgia, serif"),
        ("Times",      "Times New Roman, serif"),
        ("Courier",    "Courier New, monospace"),
        ("Montserrat", "Montserrat, sans-serif"),
        ("Lato",       "Lato, sans-serif"),
    };

    private async Task SetFont(string cssVariable, string fontValue, string type)
    {


        switch (type)
        {
            case "menu": SelectedMenuFont = fontValue; break;
            case "heading": SelectedHeadingFont = fontValue; break;
            case "number": SelectedNumberFont = fontValue; break;
            case "other": SelectedOtherFont = fontValue; break;
        }

        StateHasChanged();
    }

    void SetFontSize(int size)
    {
        SelectedFontSize = size.ToString();
    }
    void SetFontWeight(string w)
    {
        SelectedFontWeight = w;
    }
    void OnLineHeightPreview(ChangeEventArgs e)
    {
        SelectedLineHeight = double.Parse(e.Value?.ToString() ?? "1.6");
    }
    // ── Layout ──────────────────────────────────────
    private async Task SelectLayout(string mode)
    {
        LayoutMode = mode;
        StateHasChanged();
    }

    // ── Background ──────────────────────────────────
    async Task SelectBg(string bg)
    {
        SelectedBg = bg;
        await JS.InvokeVoidAsync("setSidebarBackground", bg);
    }

    // ── Primary Color ───────────────────────────────
    private async Task SetPrimaryButtonPreset(string color)
    {
        PrimaryButton = color.ToLower();
        await JS.InvokeVoidAsync("setPreviewPrimaryButtonColor", PrimaryButton);
        StateHasChanged();
    }

    private async Task OnPrimaryButtonPreviewChanged(ChangeEventArgs e)
    {
        PrimaryButton = e.Value?.ToString()?.ToLower() ?? "#fe9f43";

        await JS.InvokeVoidAsync("setPreviewPrimaryButtonColor", PrimaryButton);
        StateHasChanged();
    }

