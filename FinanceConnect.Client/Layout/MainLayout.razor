<style>
    /* Size Tiles */
    .size-tile-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 5px;
        margin-bottom: 14px;
    }

    .size-tile {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 8px 4px 6px;
        border-radius: 8px;
        border: 1.5px solid #e8e8e8;
        cursor: pointer;
        background: #fafafa;
        transition: all 0.15s;
    }

        .size-tile:hover {
            border-color: var(--primary);
            background-color: color-mix(in srgb, var(--primary) 20%, white);
        }

        .size-tile.active {
            border-color: var(--primary);
            background: var(--primary);
        }

    .size-num {
        font-size: 13px;
        font-weight: 700;
        color: #374151;
    }

    .size-unit {
        font-size: 8px;
        color: #9ca3af;
    }

    .size-tile.active .size-num, .size-tile.active .size-unit {
        color: #fff;
    }

    /* Weight Cards */
    .weight-card-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 5px;
        margin-bottom: 14px;
    }

    .weight-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 8px 4px;
        border-radius: 8px;
        border: 1.5px solid #e8e8e8;
        cursor: pointer;
        background: #fafafa;
        transition: all 0.15s;
        gap: 3px;
    }

        .weight-card:hover {
            border-color: var(--primary);
            background-color: color-mix(in srgb, var(--primary) 20%, white);
        }

        .weight-card.active {
            border-color: var(--primary);
            background: var(--primary);
        }

    .weight-sample {
        font-size: 16px;
        color: #374151;
    }

    .weight-name {
        font-size: 8px;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .weight-card.active .weight-sample, .weight-card.active .weight-name {
        color: #fff;
    }

    /* Line Height */
    .lh-labels {
        font-size: 9px;
        color: #c4c4c4;
        margin-bottom: 4px;
    }

    .lh-big-num {
        font-size: 20px;
        font-weight: 700;
        color: #1a1a2e;
    }

    .lh-unit-text {
        font-size: 10px;
        color: #9ca3af;
    }

    /* Icon wrap */
    .fs-icon-wrap {
        width: 26px;
        height: 26px;
        border-radius: 7px;
        background: var(--primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 13px;
    }
</style>

@* OffCanvas Popup *@
<div class="sidebar-themesettings offcanvas offcanvas-end" id="theme-setting" aria-modal="true" role="dialog">
    <div class="offcanvas-header d-flex align-items-center justify-content-between bg-dark">
        <div>
            <h3 class="mb-1 text-white">Theme Customizer</h3>
            <p class="text-white">Choose your themes &amp; layouts etc.</p>
        </div>
        @* <a href="#" class="custom-btn-close d-flex align-items-center justify-content-center text-white" data-bs-dismiss="offcanvas"><i class="ti ti-x"></i></a> *@
    </div>
    <div class="themecard-body offcanvas-body" style="margin-bottom: 60px;">
        <div class="accordion accordion-customicon1 accordions-items-seperate" id="settingtheme">
            @* Theme color *@
            <div class="accordion-item border px-3">
                <h2 class="accordion-header">
                    <button class="accordion-button text-dark fs-16 px-0 py-3 bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarcolor2" aria-expanded="true">
                        Theme Colors
                    </button>
                </h2>
                <div id="sidebarcolor2" class="accordion-collapse collapse show">
                    <div class="accordion-body pb-2 px-0 py-3 border-top">

                        <div class="d-flex align-items-center flex-wrap">
                            <div class="color-wrapper">

                                @foreach (var color in PrimaryPresets)
                                {
                                    <div class="color-item"
                                         @onclick="() => SetPrimaryButtonPreset(color)">

                                        <div class="color-circle @(PrimaryButton?.ToLower() == color.ToLower() ? "active" : "")"
                                             style="background:@color">

                                            @if (PrimaryButton?.ToLower() == color.ToLower())
                                            {
                                                <span class="tick">
                                                    <i class="bi bi-check"></i>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }

                                @* Custom Color *@
                                @if (IsCustomPrimary)
                                {
                                    <div class="color-item">
                                        <div class="color-circle active"
                                             style="background:var(--primary)">

                                            <span class="tick">
                                                <i class="bi bi-check"></i>
                                            </span>
                                        </div>
                                    </div>
                                }

                                <!-- Color Picker -->
                                <label class="color-picker-btn">
                                    <input type="color"
                                           value="@PrimaryButton"
                                           @oninput="OnPrimaryButtonPreviewChanged" />
                                    <i class="bi bi-eyedropper" style="color:var(--primary)"></i>
                                </label>

                            </div>
                        </div>

                    </div>
                </div>
            </div>


            @* Secondary Color *@
            <div class="accordion-item border px-3">
                <h2 class="accordion-header">
                    <button class="accordion-button text-dark fs-16 px-0 py-3 bg-transparent"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#sidebarcolorSecondary"
                            aria-expanded="true">
                        Secondary Colors
                    </button>
                </h2>
                <div id="sidebarcolorSecondary" class="accordion-collapse collapse show">
                    <div class="accordion-body pb-2 px-0 py-3 border-top">
                        <div class="d-flex align-items-center flex-wrap">
                            <div class="color-wrapper">
                                @foreach (var color in SecondaryPresets)
                                {
                                    <div class="color-item"
                                         @onclick="() => SetSecondaryPreset(color)">

                                        <div class="color-circle @(SecondaryColor?.ToLower() == color.ToLower() ? "active" : "")"
                                             style="background:@color">

                                            @if (SecondaryColor?.ToLower() == color.ToLower())
                                            {
                                                <span class="tick">
                                                    <i class="bi bi-check"></i>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                                @* Custom Secondary *@
                                @if (IsCustomSecondary)
                                {
                                    <div class="color-item">
                                        <div class="color-circle active"
                                             style="background:var(--secondary)">

                                            <span class="tick">
                                                <i class="bi bi-check"></i>
                                            </span>
                                        </div>
                                    </div>
                                }
                                <label class="color-picker-btn">
                                    <input type="color"
                                           value="@SecondaryColor"
                                           @oninput="OnSecondaryPreviewChanged" />
                                    <i class="bi bi-eyedropper" style="color:var(--secondary)"></i>
                                </label>

                            </div>
                        </div>

                    </div>
                </div>
            </div>

            @* Select Layouts *@
            <div class="accordion-item border px-3" id="Select_Layout">
                <h2 class="accordion-header">
                    <button class="accordion-button text-dark fs-16 px-0 py-3 bg-transparent"
                            type="button" data-bs-toggle="collapse"
                            data-bs-target="#sidebarcolorLayouts" aria-expanded="true">
                        Select Layouts
                    </button>
                </h2>
                <div id="sidebarcolorLayouts" class="accordion-collapse collapse show">
                    <div class="accordion-body pb-3 px-0 py-3 border-top">

                        <input type="radio" name="width" id="fluidWidth" value="fluid" style="display:none">
                        <input type="radio" name="width" id="boxWidth" value="box" style="display:none">

                        <div class="layout-card-group">

                            <!-- Horizontal -->
                            <div class="layout-card @(LayoutMode == "fluid" ? "active" : "")"
                                 id="card-horizontal"
                                 @onclick='() => SelectLayout("fluid")'
                                 title="Horizontal">
                                <div class="layout-preview horizontal-preview">
                                    <div class="lp-topbar">
                                        <div class="lp-logo"></div>
                                        <div class="lp-nav">
                                            <span></span><span></span><span></span><span></span>
                                        </div>
                                    </div>
                                    <div class="lp-body">
                                        <div class="lp-content">
                                            <div class="lp-block"></div>
                                            <div class="lp-block short"></div>
                                            <div class="lp-block"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="layout-card-label">
                                    <i class="ti ti-layout-navbar me-1"></i>Horizontal
                                </div>
                                <div class="layout-card-check">
                                    <i class="ti ti-circle-check-filled"></i>
                                </div>
                            </div>

                            <!-- Vertical -->
                            <div class="layout-card @(LayoutMode == "box" ? "active" : "")"
                                 id="card-vertical"
                                 @onclick='() => SelectLayout("box")'
                                 title="Vertical">
                                <div class="layout-preview vertical-preview">
                                    <div class="lp-sidebar">
                                        <div class="lp-logo-v"></div>
                                        <div class="lp-menu">
                                            <span></span><span></span><span></span><span></span><span></span>
                                        </div>
                                    </div>
                                    <div class="lp-main">
                                        <div class="lp-header-v"></div>
                                        <div class="lp-content-v">
                                            <div class="lp-block"></div>
                                            <div class="lp-block short"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="layout-card-label">
                                    <i class="ti ti-layout-sidebar me-1"></i>Vertical
                                </div>
                                <div class="layout-card-check">
                                    <i class="ti ti-circle-check-filled"></i>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <style>
                .btn-group .option-btn.active {
