    };


    private bool IsCustomPrimary => IsCustom(PrimaryButton, PrimaryPresets);
    private bool IsCustomSecondary => IsCustom(SecondaryColor, SecondaryPresets);
    private bool IsCustomIcon => IsCustom(IconColor, IconPresets);
    private bool IsCustomHeading => IsCustom(HeadingColor, HeadingPresets);
    private bool IsCustom(string? color, List<string>? presets)
    {
        return !string.IsNullOrWhiteSpace(color) &&
               presets != null &&
               !presets.Contains(color.ToLower());
    }

    private List<string> DefaultPrimaryPresets = new()
{
    "#f97316",
    "#ef4444",
