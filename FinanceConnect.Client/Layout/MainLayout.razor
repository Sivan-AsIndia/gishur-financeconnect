                </div>
            </div>

            @* Profile Image  *@
            <div class="accordion-item border px-3 layout-select themesidebar-background">
                <h2 class="accordion-header">
                    <button class="accordion-button text-dark fs-16 px-0 py-3 bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#ProfileImageSetting" aria-expanded="true">
