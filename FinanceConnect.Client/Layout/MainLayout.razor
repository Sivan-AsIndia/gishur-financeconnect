                       @onclick="CancelTheme">

                        <i class="bi bi-arrow-counterclockwise me-2"></i>
                        Reset
                    </a>
                </div>
                @* <div class="col-4">
                    <a href="#"
                       class="btn close-theme w-100 btn-outline-secondary p-2 text-center"
                       data-bs-dismiss="offcanvas">

                        <i class="bi bi-x-circle me-2"></i>
