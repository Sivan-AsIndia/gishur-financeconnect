    // ── OnAfterRenderAsync ───
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            // Url
            var redirectUrl = await JS.InvokeAsync<string>("localStorage.getItem", "theme-reset-redirect");
            if (!string.IsNullOrEmpty(redirectUrl))
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", "theme-reset-redirect");
                Navigation.NavigateTo(redirectUrl, false);
            }

            // Primary Color
            var savedPrimary = await JS.InvokeAsync<List<string>>("themeStorage.loadPrimaryColors");
            PrimaryPresets = new List<string>(DefaultPrimaryPresets);
            if (savedPrimary != null)
            {
                foreach (var color in savedPrimary)
                    if (!PrimaryPresets.Contains(color.ToLower()))
                        PrimaryPresets.Add(color.ToLower());
            }

            // secondary Color
            var savedSecondary = await JS.InvokeAsync<List<string>>("themeStorage.loadSecondaryColors");
            SecondaryPresets = new List<string>(DefaultSecondaryPresets);
            if (savedSecondary != null)
            {
                foreach (var color in savedSecondary)
                    if (!SecondaryPresets.Contains(color.ToLower()))
                        SecondaryPresets.Add(color.ToLower());
            }
            // Icon Color
            var savedIcon = await JS.InvokeAsync<List<string>>("themeStorage.loadIconColors");
            IconPresets = new List<string>(DefaultIconPresets);
            if (savedIcon != null)
            {
                foreach (var color in savedIcon)
                    if (!IconPresets.Contains(color.ToLower()))
                        IconPresets.Add(color.ToLower());
            }

            // Heading Color
            var savedHeading = await JS.InvokeAsync<List<string>>("themeStorage.loadHeadingColors");
            HeadingPresets = new List<string>(DefaultHeadingPresets);
            if (savedHeading != null)
            {
                foreach (var color in savedHeading)
                    if (!HeadingPresets.Contains(color.ToLower()))
                        HeadingPresets.Add(color.ToLower());
            }


            var savedTheme = await JS.InvokeAsync<ThemeSettingsViewModel>("themeStorage.loadTheme");

            if (savedTheme != null)
            {
                Theme.CurrentSettings = savedTheme;
                IconColor = savedTheme.IconColor;
                HeadingColor = savedTheme.HeadingColor;
                PrimaryButton = savedTheme.PrimaryColor;
                SecondaryColor = savedTheme.SecondaryColor;
                IsDarkMode = savedTheme.IsDarkMode;
                SelectedFontSize = savedTheme.FontSize;
                borderRadiusLevel = savedTheme.BorderRadius;
                buttonRadiusLevel = savedTheme.ButtonRadius;
                if (!string.IsNullOrEmpty(savedTheme.LayoutMode))
                    LayoutMode = savedTheme.LayoutMode;
                else
                {
                    var stored = await JS.InvokeAsync<string>("localStorage.getItem", "layoutMode");
                    LayoutMode = stored ?? "box";
                }

                await JS.InvokeVoidAsync("themeBuilder.applyTheme", savedTheme);
                SelectedBg = await JS.InvokeAsync<string>("loadSidebarBackground");
                await JS.InvokeVoidAsync("previewDarkMode", IsDarkMode);
                await JS.InvokeVoidAsync("applyLayout", LayoutMode, false);

                var savedFonts = await JS.InvokeAsync<ThemeSettingsViewModel>("fontStorage.loadFonts");
                if (savedFonts != null)
                {
                    if (!string.IsNullOrEmpty(savedFonts.MenuFont))
                        SelectedMenuFont = savedFonts.MenuFont;

                    if (!string.IsNullOrEmpty(savedFonts.HeadingFont))
                        SelectedHeadingFont = savedFonts.HeadingFont;

                    if (!string.IsNullOrEmpty(savedFonts.NumberFont))
                        SelectedNumberFont = savedFonts.NumberFont;

                    if (!string.IsNullOrEmpty(savedFonts.OtherFont))
                        SelectedOtherFont = savedFonts.OtherFont;

                    await JS.InvokeVoidAsync("document.documentElement.style.setProperty",
                        "--font-menu", SelectedMenuFont);
                    await JS.InvokeVoidAsync("document.documentElement.style.setProperty",
                        "--font-heading", SelectedHeadingFont);
                    await JS.InvokeVoidAsync("document.documentElement.style.setProperty",
                        "--font-number", SelectedNumberFont);
                    await JS.InvokeVoidAsync("document.documentElement.style.setProperty",
                        "--font-other", SelectedOtherFont);

                    await JS.InvokeVoidAsync("eval", @"
            const fs = localStorage.getItem('font-size-base');
            const fw = localStorage.getItem('font-weight-base');
            const lh = localStorage.getItem('line-height-base');
            if (fs) document.documentElement.style.setProperty('--font-size-base', fs + 'px');
            if (fw) document.documentElement.style.setProperty('--font-weight-base', fw);
            if (lh) document.documentElement.style.setProperty('--line-height-base', lh);
        ");
                    StateHasChanged();
                }

            }
            else
            {
                var stored = await JS.InvokeAsync<string>("localStorage.getItem", "layoutMode");
                LayoutMode = stored ?? "box";
                await JS.InvokeVoidAsync("applyLayout", LayoutMode, false);
                await JS.InvokeVoidAsync("setPreviewIconColor", IconColor);
                await JS.InvokeVoidAsync("setPreviewHeadingColor", HeadingColor);
                await JS.InvokeVoidAsync("setPreviewPrimaryButtonColor", PrimaryButton);
                await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--font-family", SelectedFont);
                await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--preview-font-family", SelectedFont);
                await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--textfont-size", SelectedFontSize);
                await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--secondary", SecondaryColor);
                await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--preview-secondary", SecondaryColor);
                await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--btn-radius", $"{buttonRadiusLevel}px");
                await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--radius", $"{buttonRadiusLevel}px");
                await JS.InvokeVoidAsync("previewDarkMode", IsDarkMode);

                var session = await JS.InvokeAsync<UserSession>("userSessionStorage.load");
                if (session != null && !string.IsNullOrEmpty(session.ProfilePhoto))
                {
                    SelectedProfilePhoto = session.ProfilePhoto;
                    await JS.InvokeVoidAsync("profilePreview.setActive", session.ProfilePhoto);
                }

                StateHasChanged();
            }
        }
    }

    // ── Validation ──────────────────────────────────
    private bool IsPrimaryButtonColorValid(out string errorMessage)
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(PrimaryButton) || string.IsNullOrWhiteSpace(SecondaryColor) ||
            string.IsNullOrWhiteSpace(HeadingColor) || string.IsNullOrWhiteSpace(IconColor))
        {
            errorMessage = "color cannot be empty.";
            return false;
        }

        if (!Regex.IsMatch(PrimaryButton, "^#([0-9A-Fa-f]{6})$") ||
            !Regex.IsMatch(SecondaryColor, "^#([0-9A-Fa-f]{6})$") ||
            !Regex.IsMatch(IconColor, "^#([0-9A-Fa-f]{6})$") ||
            !Regex.IsMatch(HeadingColor, "^#([0-9A-Fa-f]{6})$"))
        {
            errorMessage = "Invalid color format.";
            return false;
        }

        if (!IsDarkMode && (PrimaryButton.Equals("#ffffff", StringComparison.OrdinalIgnoreCase) ||
                            SecondaryColor.Equals("#ffffff", StringComparison.OrdinalIgnoreCase) ||
                            HeadingColor.Equals("#ffffff", StringComparison.OrdinalIgnoreCase) ||
                            IconColor.Equals("#ffffff", StringComparison.OrdinalIgnoreCase)))
        {
            errorMessage = "In light theme, white should not be used for the content color. Please change it to a suitable contrasting color..";
            return false;
        }

        if (IsDarkMode && (PrimaryButton.Equals("#000000", StringComparison.OrdinalIgnoreCase) ||
                           SecondaryColor.Equals("#000000", StringComparison.OrdinalIgnoreCase) ||
                           HeadingColor.Equals("#000000", StringComparison.OrdinalIgnoreCase) ||
                           IconColor.Equals("#000000", StringComparison.OrdinalIgnoreCase)))
        {
            errorMessage = "In dark mode, the heading color and icon color cannot be black. Please change them to a suitable color.";
            return false;
        }

        return true;
    }

    // ── Save Theme ──────────────────────────────────
    private async Task SaveTheme()
    {
        if (!IsPrimaryButtonColorValid(out var errorMessage))
        {
            await JS.InvokeVoidAsync("resetColorPicker", PrimaryButton);
            ToastService.ShowError(errorMessage, "Error");
            return;
        }
        Theme.CurrentSettings.IconColor = IconColor;
        Theme.CurrentSettings.HeadingColor = HeadingColor;
        Theme.CurrentSettings.PrimaryColor = PrimaryButton;
        Theme.CurrentSettings.IsDarkMode = IsDarkMode;
        Theme.CurrentSettings.FontFamily = SelectedFont;
        Theme.CurrentSettings.FontSize = SelectedFontSize;
        Theme.CurrentSettings.SecondaryColor = SecondaryColor;
        Theme.CurrentSettings.ShadowStrength = ShadowLevel;
        Theme.CurrentSettings.BorderRadius = borderRadiusLevel;
        Theme.CurrentSettings.ButtonRadius = buttonRadiusLevel;
        Theme.CurrentSettings.LayoutMode = LayoutMode;

        await Theme.ApplyThemeAsync();
        await JS.InvokeVoidAsync("themeBuilder.toggleDarkMode", IsDarkMode);
        await JS.InvokeVoidAsync("themeStorage.saveTheme", Theme.CurrentSettings);
        await JS.InvokeVoidAsync("themeBuilder.applyTheme", Theme.CurrentSettings);
        await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--font-family", SelectedFont);
        await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--preview-font-family", SelectedFont);
        await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--textfont-size", SelectedFontSize);
        await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--preview-font-size", SelectedFontSize);
        await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--secondary", SecondaryColor);
        await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--preview-secondary", SecondaryColor);
        await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--shadow-strength", (ShadowLevel / 100.0).ToString("0.00"));
        await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--btn-radius", $"{buttonRadiusLevel}px");
        await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--radius", $"{buttonRadiusLevel}px");
        await JS.InvokeVoidAsync("eval", $@"
    document.documentElement.style.setProperty('--line-height-base', '{SelectedLineHeight}');
    localStorage.setItem('line-height-base', '{SelectedLineHeight}');
");

        await JS.InvokeVoidAsync("eval", $@"
    document.documentElement.style.setProperty('--font-size-base', '{SelectedFontSize}px');
    localStorage.setItem('font-size-base', '{SelectedFontSize}');
");

        await JS.InvokeVoidAsync("eval", $@"
    document.documentElement.style.setProperty('--font-weight-base', '{SelectedFontWeight}');
    localStorage.setItem('font-weight-base', '{SelectedFontWeight}');
");

        // ---------- SideBar Background ----------
        await JS.InvokeVoidAsync("loadSidebarBackground1", SelectedBg);
        if (SelectedBg == null)
        {
            await JS.InvokeVoidAsync("clearSidebarBg");
        }
        else
        {
            await JS.InvokeVoidAsync("setSidebarBackgroundSave", SelectedBg);

        }

        // ---------- Horizontal Vertical Layout ----------
        await JS.InvokeVoidAsync("saveLayoutMode", LayoutMode);
        await JS.InvokeVoidAsync("applyLayout", LayoutMode, false);

        // ---------- Profile Photo ----------
        var session = AuthService.CurrentUser;
        if (session != null && !string.IsNullOrEmpty(SelectedProfilePhoto))
        {
            session.ProfilePhoto = SelectedProfilePhoto;
            await JS.InvokeVoidAsync("userSessionStorage.save", session);
            await AuthService.InitializeAsync();
        }
        if (!string.IsNullOrEmpty(SelectedProfilePhoto))
        {
            await AuthService.UpdateProfilePhotoAsync(SelectedProfilePhoto);
        }

        // ---------- Font Family ----------
        var settings = new
        {
            menuFont = SelectedMenuFont,
            headingFont = SelectedHeadingFont,
            numberFont = SelectedNumberFont,
            otherFont = SelectedOtherFont
        };

        await JS.InvokeVoidAsync("fontStorage.saveFonts", settings);
        await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--font-menu", SelectedMenuFont);
        await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--font-heading", SelectedHeadingFont);
        await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--font-number", SelectedNumberFont);
        await JS.InvokeVoidAsync("document.documentElement.style.setProperty", "--font-other", SelectedOtherFont);

        var fontSettings = new
        {
            menuFont = SelectedMenuFont,
            headingFont = SelectedHeadingFont,
            numberFont = SelectedNumberFont,
            otherFont = SelectedOtherFont
        };
        await JS.InvokeVoidAsync("fontStorage.saveFonts", fontSettings);

        // ---------- Primary ----------
        if (!DefaultPrimaryPresets.Contains(PrimaryButton) &&
            !PrimaryPresets.Contains(PrimaryButton))
        {
            PrimaryPresets.Add(PrimaryButton);

            var customColors = PrimaryPresets
                .Where(c => !DefaultPrimaryPresets.Contains(c))
                .ToList();

            await JS.InvokeVoidAsync("themeStorage.savePrimaryColors", customColors);
        }
        // ---------- SECONDARY ----------
        if (!DefaultSecondaryPresets.Contains(SecondaryColor) &&
            !SecondaryPresets.Contains(SecondaryColor))
        {
            SecondaryPresets.Add(SecondaryColor);

            var custom = SecondaryPresets
                .Where(c => !DefaultSecondaryPresets.Contains(c))
                .ToList();

            await JS.InvokeVoidAsync("themeStorage.saveSecondaryColors", custom);
        }

        // ---------- ICON ----------
        if (!DefaultIconPresets.Contains(IconColor) &&
            !IconPresets.Contains(IconColor))
        {
            IconPresets.Add(IconColor);

            var custom = IconPresets
                .Where(c => !DefaultIconPresets.Contains(c))
                .ToList();

            await JS.InvokeVoidAsync("themeStorage.saveIconColors", custom);
        }

        // ---------- HEADING ----------
        if (!DefaultHeadingPresets.Contains(HeadingColor) &&
            !HeadingPresets.Contains(HeadingColor))
        {
            HeadingPresets.Add(HeadingColor);

            var custom = HeadingPresets
                .Where(c => !DefaultHeadingPresets.Contains(c))
                .ToList();

            await JS.InvokeVoidAsync("themeStorage.saveHeadingColors", custom);
        }
        ToastService.ShowSuccess("Theme Applied Successfully", "Success");
    }

    // ── Reset Theme ──
    private async Task CancelTheme()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "theme-reset-redirect", Navigation.Uri);
        await JS.InvokeVoidAsync("localStorage.removeItem", "app-theme");
        await JS.InvokeVoidAsync("localStorage.removeItem", "sidebar-bg");
        await JS.InvokeVoidAsync("localStorage.removeItem", "layoutMode");
        await JS.InvokeVoidAsync("localStorage.removeItem", "app-fonts");
        await JS.InvokeVoidAsync("localStorage.removeItem", "custom-primary-colors");
        await JS.InvokeVoidAsync("localStorage.removeItem", "custom-secondary-colors");
        await JS.InvokeVoidAsync("localStorage.removeItem", "custom-icon-colors");
        await JS.InvokeVoidAsync("localStorage.removeItem", "custom-heading-colors");
        await JS.InvokeVoidAsync("location.reload");
    }
