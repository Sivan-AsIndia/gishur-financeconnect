@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="sidebar" id="sidebar">
    <!-- Logo -->
    <div class="sidebar-logo active horizontalLogo">
        <a class="logo logo-normal">
            <img src="assets/images/logo.png" alt="Gishur POS">
        </a>
        <a class="logo logo-white">
            <img src="assets/images/logo.png" alt="Gishur POS">
        </a>
        <a class="logo-small">
            <img src="assets/images/favicon.png" alt="Gishur POS">
        </a>
        <a id="toggle_btn" href="javascript:void(0);">
            <i data-feather="chevrons-left" class="feather-16"></i>
        </a>
    </div>
    <!-- /Logo -->

    <div class="modern-profile p-3 pb-0">
        <div class="text-center rounded bg-light p-3 mb-4 user-profile">
            <div class="avatar avatar-lg online mb-3">
                <img src="assets/images/customer15.jpg" alt="Img" class="img-fluid rounded-circle">
            </div>
            <h6 class="fs-14 fw-bold mb-1">@(AuthService.CurrentUser?.UserName ?? "Guest User")</h6>
            <p class="fs-12 mb-0">@(AuthService.CurrentUser?.Email ?? "Not logged in")</p>
        </div>

        <div class="sidebar-nav mb-3">
            <ul class="nav nav-tabs nav-tabs-solid nav-tabs-rounded nav-justified bg-transparent" role="tablist">
                <li class="nav-item"><a class="nav-link active border-0" href="#">Menu</a></li>
                <li class="nav-item"><a class="nav-link border-0">Chats</a></li>
                <li class="nav-item"><a class="nav-link border-0">Inbox</a></li>
            </ul>
        </div>
    </div>

    <div class="sidebar-header p-3 pb-0 pt-2">
        <div class="text-center rounded bg-light p-2 mb-4 sidebar-profile d-flex align-items-center">
            <div class="avatar avatar-md online">
                <img src="assets/images/customer15.jpg" alt="Img" class="img-fluid rounded-circle">
            </div>
            <div class="text-start sidebar-profile-info ms-2">
                <h6 class="fs-14 fw-bold mb-1">@(AuthService.CurrentUser?.UserName ?? "Guest")</h6>
                <p class="fs-12">User</p>
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-between menu-item mb-3">
            <div>
                <a class="btn btn-sm btn-icon bg-light">
                    <i class="ti ti-layout-grid-remove"></i>
                </a>
            </div>
            <div>
                <a class="btn btn-sm btn-icon bg-light">
                    <i class="ti ti-brand-hipchat"></i>
                </a>
            </div>
            <div>
                <a class="btn btn-sm btn-icon bg-light position-relative">
                    <i class="ti ti-message"></i>
                </a>
            </div>
            <div class="notification-item">
                <a class="btn btn-sm btn-icon bg-light position-relative">
                    <i class="ti ti-bell"></i>
                    <span class="notification-status-dot"></span>
                </a>
            </div>
            <div class="me-0">
                <a class="btn btn-sm btn-icon bg-light">
                    <i class="ti ti-settings"></i>
                </a>
            </div>
        </div>
    </div>
