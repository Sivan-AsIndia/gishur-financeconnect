@code {
    // Keep this if you still want manual menu tracking, but URL-based active is more reliable.
    // private string activeMenu = "Dashboard";
    // private void SetActive(string menu) => activeMenu = menu;

    protected override void OnInitialized()
    {
        // Re-render on navigation so active class updates even on route changes done elsewhere.
        Navigation.LocationChanged += (_, __) => InvokeAsync(StateHasChanged); // Pattern commonly used for active menu refresh. [web:7]
    }
    private async Task navScroll(string direction)
    {
        await JS.InvokeVoidAsync("navScroll", direction);
    }
    // private string GetActiveClass(string href)
    // {
    // 	Normalize: Navigation.Uri is absolute; compare with the absolute target.
    // 	var target = Navigation.ToAbsoluteUri(href).AbsoluteUri;
    // 	return Navigation.Uri.Equals(target, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    // }

    private string GetActiveClass(string href)
    {
        var currentPath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        var targetPath = href.TrimEnd('/');

        // Exact match
        if (currentPath.Equals(targetPath, StringComparison.OrdinalIgnoreCase))
            return "active";

        // Child route match
        if (currentPath.StartsWith(targetPath + "/", StringComparison.OrdinalIgnoreCase))
            return "active";

        return "";
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/Login");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {


            try
            {
                await JS.InvokeVoidAsync("eval", @"
                if (typeof window.initCompanyTour === 'function') {
                    window.initCompanyTour();
                }
            ");
                await JS.InvokeAsync<string>(
            "loadSidebarBackground");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Tour init error: {ex.Message}");
            }
        }
    }
}
