@typeparam TItem
@inject IJSRuntime JS

<select id="@_id"
        class="form-select @Class"
        disabled="@Disabled">
    <option value="">@Placeholder</option>

    @if (Items != null)
    {
        foreach (var item in Items)
        {
            <option value="@ValueSelector(item)">
                @TextSelector(item)
            </option>
        }
    }
</select>

@code {
    private string _id = "sd_" + Guid.NewGuid().ToString("N");
    private DotNetObjectReference<SearchDropdown<TItem>>? _ref;

    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    [Parameter] public Func<TItem, string> TextSelector { get; set; } = default!;
    [Parameter] public Func<TItem, Guid> ValueSelector { get; set; } = default!;
    [Parameter] public Guid Value { get; set; }
    [Parameter] public EventCallback<Guid> ValueChanged { get; set; }

    [Parameter] public string Placeholder { get; set; } = "-- Select --";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_ref == null)
            _ref = DotNetObjectReference.Create(this);

        await Task.Delay(1); 

        await JS.InvokeVoidAsync("reinitSelect2", _id, _ref, Placeholder);

        await JS.InvokeVoidAsync("setSelect2Value", _id, Value.ToString());
    }

    [JSInvokable]
    public async Task NotifyChange(string? val)
    {
        if (Guid.TryParse(val, out var guid))
        {
            await ValueChanged.InvokeAsync(guid);
        }
    }
}
