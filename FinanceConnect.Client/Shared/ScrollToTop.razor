@inject IJSRuntime JS

<div class="stt-wrap" id="sttBtn">
    <a href="javascript:void(0);" class="stt-btn">

        <span class="stt-outer-glow"></span>
        <span class="stt-glow-ring"></span>
        <span class="stt-spin-ring"></span>

        <svg class="stt-progress-ring" viewBox="0 0 62 62" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle class="stt-ring-track" cx="31" cy="31" r="26" />
            <circle class="stt-ring-fill" id="sttRingFill" cx="31" cy="31" r="26" />
        </svg>

        <span class="stt-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
        </span>

        <span class="stt-label">TOP</span>
        <span class="stt-pct" id="sttPct">0%</span>

    </a>
</div>

<!-- SVG gradient -->
<svg width="0" height="0" style="position:absolute">
    <defs>
        <linearGradient id="sttGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#4fc3f7" />
            <stop offset="50%" stop-color="#00e5ff" />
            <stop offset="100%" stop-color="#4fc3f7" />
        </linearGradient>
    </defs>
</svg>

<style>
    /* ── Wrapper ── */
    .stt-wrap {
        position: fixed;
        bottom: 11px;
        right: 38px;
        z-index: 9999;
        opacity: 0;
        transform: translateY(24px) scale(0.8);
        pointer-events: none;
        transition: opacity 0.45s cubic-bezier(0.34,1.2,0.64,1),
                    transform 0.45s cubic-bezier(0.34,1.56,0.64,1);
    }

    .stt-wrap.stt-visible {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
    }

    /* ── Button ── */
    .stt-btn {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        width: 44px;
        height: 44px;
        background: #00000029;
        border: none;
        border-radius: 50%;
        text-decoration: none;
        overflow: visible;
        cursor: pointer;
        transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1),
                    box-shadow 0.35s ease;
    }

    .stt-btn:hover {
        transform: translateY(-6px) scale(1.08);
        box-shadow: 0 0 32px #4fc3f722, 0 12px 36px #00000088;
    }

    .stt-btn:active {
        transform: translateY(-2px) scale(0.96);
    }

    /* Inner glass disc */
    .stt-btn::before {
        content: '';
        position: absolute;
        inset: 5px;
        border-radius: 50%;
        background: white;
        box-shadow: inset 0 1px 0 #ffffff08, inset 0 -1px 0 #00000040;
        z-index: 1;
        transition: background 0.3s ease;
    }

    .stt-btn:hover::before {
        background: linear-gradient(145deg, #0f2030 0%, #0a1020 100%);
    }

    /* ── Ambient glow ── */
    .stt-outer-glow {
        position: absolute;
        inset: -10px;
        border-radius: 50%;
        background: radial-gradient(circle, #4fc3f710 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
        animation: stt-ambient 4s ease-in-out infinite;
    }

    @@keyframes stt-ambient {
        0%, 100% { opacity: 0.4; transform: scale(1); }
        50%       { opacity: 1;   transform: scale(1.08); }
    }

    /* ── Idle pulse ring ── */
    .stt-glow-ring {
        position: absolute;
        inset: -8px;
        border-radius: 50%;
        border: 1.5px solid #4fc3f7;
        opacity: 0;
        pointer-events: none;
        z-index: 0;
        animation: stt-pulse 3.6s ease-in-out 1.5s infinite;
    }

    @@keyframes stt-pulse {
        0%   { opacity: 0;    transform: scale(1); }
        35%  { opacity: 0.45; transform: scale(1.12); }
        100% { opacity: 0;    transform: scale(1.3); }
    }

    /* ── Slow rotating dashed ring ── */
    .stt-spin-ring {
        position: absolute;
        inset: -3px;
        border-radius: 50%;
        border: 1px dashed #4fc3f715;
        z-index: 0;
        pointer-events: none;
        animation: stt-spin 12s linear infinite;
    }

    @@keyframes stt-spin {
        from { transform: rotate(0deg); }
        to   { transform: rotate(360deg); }
    }

    /* ── Progress ring SVG ── */
    .stt-progress-ring {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 2;
        transform: rotate(-90deg);
        pointer-events: none;
    }

    .stt-ring-track {
        stroke: #142030;
        stroke-width: 2.5px;
        fill: none;
    }

    .stt-ring-fill {
        stroke: url(#sttGradient);
        stroke-width: 2.5px;
        fill: none;
        stroke-linecap: round;
        stroke-dasharray: 163.4;
        stroke-dashoffset: 163.4;
        transition: stroke-dashoffset 0.12s linear;
        filter: drop-shadow(0 0 6px #4fc3f7aa);
    }

    /* ── Arrow icon ── */
    .stt-icon {
        position: relative;
        z-index: 3;
        width: 14px;
        height: 14px;
        color: #4fc3f7;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1),
                    color 0.3s ease,
                    filter 0.3s ease;
        margin-top: 2px;
    }

    .stt-icon svg { width: 100%; height: 100%; }

    .stt-btn:hover .stt-icon {
        color: #00e5ff;
        transform: translateY(-4px) scale(1.25);
        filter: drop-shadow(0 0 6px #00e5ff);
    }

    /* ── Label ── */
    .stt-label {
        position: relative;
        z-index: 3;
        font-family: 'Space Mono', 'Fira Code', monospace;
        font-size: 7px;
        font-weight: 700;
        letter-spacing: 0.22em;
        color: #2a5a7a;
        transition: color 0.3s ease, letter-spacing 0.3s ease;
        line-height: 1;
        margin-bottom: 6px;
    }

    .stt-btn:hover .stt-label {
        color: #4fc3f7;
        letter-spacing: 0.28em;
    }

    /* ── % badge ── */
    .stt-pct {
        position: absolute;
        top: -6px;
        right: -6px;
        z-index: 10;
        background: #0b1a2a;
        border: 1px solid #1a3a55;
        border-radius: 20px;
        padding: 2px 5px;
        font-family: 'Space Mono', 'Fira Code', monospace;
        font-size: 7px;
        font-weight: 700;
        color: #4fc3f7;
        letter-spacing: 0.05em;
        opacity: 0;
        transform: scale(0.7);
        transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
        pointer-events: none;
    }

    .stt-wrap.stt-visible .stt-pct {
        opacity: 1;
        transform: scale(1);
    }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initScrollTop");
        }
    }
}
