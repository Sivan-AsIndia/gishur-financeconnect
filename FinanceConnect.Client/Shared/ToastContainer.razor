@inject ToastService ToastService
@implements IDisposable

<style>

    .toast-container-custom {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: 400px;
    }

    /* ================= BASE CARD ================= */

    .toast-item {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        min-width: 320px;
        box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
        animation: slideIn 0.35s ease-out;
        border-left: 4px solid transparent;
    }

    /* ================= LEFT BORDER COLORS ================= */

    .toast-success {
        border-left-color: #22c55e;
    }

    .toast-error {
        border-left-color: #ef4444;
    }

    .toast-warning {
        border-left-color: #f59e0b;
    }

    .toast-info {
        border-left-color: #0ea5e9;
    }

    /* ================= CONTENT ================= */

    .toast-header {
        display: flex;
        align-items: center;
        padding: 10px 14px 6px 14px;
        font-weight: 600;
        color: #111; /* dark text now */
    }

    .toast-body {
        padding: 0 14px 12px 14px;
        color: #444;
    }

    /* ================= ICON ================= */

    .toast-icon {
        font-size: 20px;
        margin-right: 10px;
    }

    /* ================= TEXT ================= */

    /* ================= TEXT ================= */

    .toast-title {
        font-size: 14px;
    }

    .toast-message {
        font-size: 13px;
        line-height: 1.4;
        white-space: normal !important;
        word-wrap: break-word;
        overflow-wrap: break-word;
        max-width: 100%;
    }

    /* ================= CLOSE ================= */

    .toast-close {
        margin-left: auto;
        background: transparent;
        border: none;
        font-size: 18px;
        cursor: pointer;
        color: #777;
        opacity: .8;
    }

        .toast-close:hover {
            opacity: 1;
        }

    /* ================= ANIMATION ================= */

    @@keyframes slideIn {
        from {
            transform: translateX(120%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

</style>

<div class="toast-container-custom">

    @foreach (var toast in ToastService.Toasts)
    {
        <div class="toast-item toast-@toast.Type.ToString().ToLower()">

            <div class="toast-header">

                <span class="toast-icon">
                    @switch (toast.Type)
                    {
                        case ToastType.Success:
                            <i class="ti ti-circle-check text-success"></i>
                            break;

                        case ToastType.Error:
                            <i class="ti ti-circle-x text-danger"></i>
                            break;

                        case ToastType.Warning:
                            <i class="ti ti-alert-triangle text-warning"></i>
                            break;

                        case ToastType.Info:
                            <i class="ti ti-info-circle text-info"></i>
                            break;
                    }
                </span>

                <span class="toast-title">@toast.Title</span>

                <button class="toast-close"
                        @onclick="() => ToastService.Remove(toast.Id)">
                    ✕
                </button>

            </div>

            <div class="toast-body">
                <div class="toast-message">@toast.Message</div>
            </div>

        </div>
    }

</div>

@code {

    protected override void OnInitialized()
    {
        ToastService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ToastService.OnChange -= StateHasChanged;
    }
}


