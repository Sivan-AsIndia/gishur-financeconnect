# ============================================================
# Dockerfile.client - FinanceConnect Blazor WASM Client (.NET 9)
# Image: sivan67906/gishurfinance-client:v5.0.0
# ============================================================

# ── Stage 1: Build ───────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy csproj and restore (layer caching)
COPY FinanceConnect.Client/FinanceConnect.Client.csproj FinanceConnect.Client/
RUN dotnet restore FinanceConnect.Client/FinanceConnect.Client.csproj

# Copy full source
COPY FinanceConnect.Client/ FinanceConnect.Client/

# CRITICAL FIX: Remove the ApiSettings BaseAddress from appsettings.json
# so that Program.cs fallback (builder.HostEnvironment.BaseAddress) kicks in.
# This makes the Blazor app use the browser's current URL as the API base,
# which nginx then reverse-proxies to the API container.
# Using "/" causes file:/// protocol bug — removing it entirely is the correct fix.
RUN echo '{}' > FinanceConnect.Client/wwwroot/appsettings.json

# Publish the Blazor WASM app
RUN dotnet publish FinanceConnect.Client/FinanceConnect.Client.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

# ── Stage 2: Serve with Nginx ───────────────────────────────
FROM nginx:alpine AS runtime

# Install openssl for self-signed cert generation
RUN apk add --no-cache openssl

# Generate self-signed SSL certificate
RUN mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 365 \
    -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/server.key \
    -out /etc/nginx/ssl/server.crt \
    -subj "/C=IN/ST=TamilNadu/L=Chennai/O=GishurFinance/CN=localhost"

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Copy published Blazor WASM output to nginx html root
COPY --from=build /app/publish/wwwroot /usr/share/nginx/html

# Expose HTTPS and HTTP ports
EXPOSE 443 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -q --spider --no-check-certificate https://localhost:443/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
